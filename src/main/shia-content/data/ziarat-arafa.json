      "kind": "text",
      "ar": "اَللّٰهُمَّ وَهَاتَانِ الرَّكْعَتَانِ هَدِيَّةٌ مِنِّيْ اِلٰي مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "وَسَيِّدِيْ وَاِمَامِي الْحُسَيْنِ بْنِ عَلِيٍّ عَلَيْهِمَا اَلسَّلَامُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ وَتَقَبَّلْ ذٰلِكَ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْزِنِيْ عَلٰي ذٰلِكَ أَفْضَلَ أَمَلِيْ وَرَجَائِيْ"
    },
    {
      "kind": "text",
      "ar": "فِيْكَ وَفِيْ وَلِيِّكَ، يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ نَبِيِّ اللهِ"
    },
    {
