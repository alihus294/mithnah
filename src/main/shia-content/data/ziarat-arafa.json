    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ عَلِيٍّ الْمُرْتَضٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ فَاطِمَةَ الزَّهْرَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ خَدِيْجَةَ الْكُبْرٰي"
