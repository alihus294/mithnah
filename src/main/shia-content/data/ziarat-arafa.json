    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُحَمَّدِ بْنِ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي عَلِيِّ بْنِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
