    },
    {
      "kind": "text",
      "ar": "اللهُ أَكْبَرُ كَبِيْرًا، وَالْحَمْدُ لِلّٰهِ كَثِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ بُكْرَةً وَأَصِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ الَّذِيْ هَدَانَا لِهٰذَا"
    },
    {
      "kind": "text",
      "ar": "وَمَا كُنَّا لِنَهْتَدِيَ لَوْ لَا أَنْ هَدَانَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "لَقَدْ جَائَتْ رُسُلُ رَبِّنَا بِالْحَقِّ"
