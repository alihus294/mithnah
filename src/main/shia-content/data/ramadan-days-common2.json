    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ مِنْ فَضْلِكَ بِأَفْضَلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكُلُّ فَضْلِكَ فَاضِلٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِفَضْلِكَ كُلِّهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ مِنْ رِزْقِكَ بِأَعَمِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكُلُّ رِزْقِكَ عَامٌّ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِرِزْقِكَ كُلِّهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ مِنْ عَطَائِكَ بِأَهْنَئِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكُلُّ عَطَائِكَ هَنِيْءٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِعَطَائِكَ كُلِّهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ مِنْ خَيْرِكَ بِأَعْجَلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكُلُّ خَيْرِكَ عَاجِلٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِخَيْرِكَ كُلِّهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ مِنْ اِحْسَانِكَ بِأَحْسَنِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكُلُّ اِحْسَانِكَ حَسَنٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِاِحْسَانِكَ كُلِّهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِمَا تُجِيْبُنِيْ بِهٖ حِيْنَ أَسْأَلُكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَجِبْنِيْ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ عَبْدِكَ الْمُرْتَضٰي، وَرَسُوْلِكَ الْمُصْطَفٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَمِيْنِكَ وَنَجِيِّكَ دُوْنَ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَجِيْبِكَ مِنْ عِبَادِك"
    },
    {
      "kind": "text",
      "ar": "وَنَبِيِّكَ بِالصِّدْقِ وَحَبِيْبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي رَسُوْلِكَ وَخِيَرَتِكَ مِنَ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْبَشِيْرِ النَّذِيْرِ، السِّرَاجِ الْمُنِيْرِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَهْلِ بَيْتِهِ الْاَبْرَارِ الطّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَلَائِكَتِكَ الَّذِيْنَ اسْتَخْلَصْتَهُمْ لِنَفْسِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَجَبْتَهُمْ عَنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَنْبِيَائِكَ الَّذِيْنَ يُنْبِئُوْنَ عَنْكَ بِالصِّدْقِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي رُسُلِكَ الَّذِيْنَ خَصَصْتَهُمْ بِوَحْيِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفَضَّلْتَهُمْ عَلَي الْعَالَمِيْنَ بِرِسَالَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي عِبَادِكَ الصَّالِحِيْنَ الَّذِيْنَ أَدْخَلْتَهُمْ فِيْ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "الْاَئِمَّةِ الْمُهْتَدِيْنَ الرَّاشِدِيْنَ وَأَوْلِيَائِكَ الْمُطَهَّرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي جَبْرَائِيْلَ وَمِيْكَائِيْلَ"
    },
    {
      "kind": "text",
      "ar": "وَاِسْرَافِيْلَ وَمَلَكِ الْمَوْتِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي رِضْوَانَ خَازِنِ الْجِنَانِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَالِكٍ خَازِنِ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَرُوْحِ الْقُدُسِ، وَالرُّوْحِ الْاَمِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَحَمَلَةِ عَرْشِكَ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْمَلَكَيْنِ الْحَافِظَيْنِ عَلَيَّ بِالصَّلَاةِ الَّتِيْ تُحِبُّ"
    },
    {
      "kind": "text",
      "ar": "أَنْ يُصَلِّيَ بِهَا عَلَيْهِمْ أَهْلُ السَّمَاوَاتِ وَأَهْلُ الْاَرَضِيْنَ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً طَيِّبَةً كَثِيْرَةً مُبَارَكَةً زَاكِيَةً"
    },
    {
      "kind": "text",
      "ar": "نَامِيَةً ظَاهِرَةً بَاطِنَةً شَرِيْفَةً فَاضِلَةً"
    },
    {
      "kind": "text",
      "ar": "تُبَيِّنُ بِهَا فَضْلَهُمْ عَلَي الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعْطِ مُحَمَّدًا الْوَسِيْلَةَ وَالشَّرَفَ وَالْفَضِيْلَةَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْزِهٖ خَيْرَ مَا جَزَيْتَ نَبِيًّا عَنْ أُمَّتِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَعْطِ مُحَمَّدًا صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ مَعَ كُلِّ زُلْفَةٍ زُلْفَةً"
    },
    {
      "kind": "text",
      "ar": "وَمَعَ كُلِّ وَسِيْلَةٍ وَسِيْلَةً"
    },
    {
      "kind": "text",
      "ar": "وَمَعَ كُلِّ فَضِيْلَةٍ فَضِيْلَةً"
    },
    {
      "kind": "text",
      "ar": "وَمَعَ كُلِّ شَرَفٍ شَرَفًا"
    },
    {
      "kind": "text",
      "ar": "تُعْطِيْ مُحَمَّدًا وَاٰلَهٗ يَوْمَ الْقِيَامَةِ"
    },
    {
      "kind": "text",
      "ar": "أَفْضَلَ مَا أَعْطَيْتَ أَحَدًا مِنَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاجْعَلْ مُحَمَّدًا صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَدْنَي الْمُرْسَلِيْنَ مِنْكَ مَجْلِسًا"
    },
    {
      "kind": "text",
      "ar": "وَأَفْسَحَهُمْ فِي الْجَنَّةِ عِنْدَكَ مَنْزِلًا"
    },
    {
      "kind": "text",
      "ar": "وَأَقْرَبَهُمْ اِلَيْكَ وَسِيْلَةً"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ أَوَّلَ شَافِعٍ وَأَوَّلَ مُشَفَّعٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَوَّلَ قَائِلٍ وَأَنْجَحَ سَائِلٍ"
    },
    {
      "kind": "text",
      "ar": "وَابْعَثْهُ الْمَقَامَ الْمَحْمُوْدَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ يَغْبِطُهٗ بِهِ الْاَوَّلُوْنَ وَالْاٰخِرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَسْمَعَ صَوْتِيْ وَتُجِيْبَ دَعْوَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَتَجَاوَزَ عَنْ خَطِيْئَتِيْ، وَتَصْفَحَ عَنْ ظُلْمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُنْجِحَ طَلِبَتِيْ، وَتَقْضِيَ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُنْجِزَ لِيْ مَا وَعَدْتَنِيْ، وَتُقِيْلَ عَثْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَغْفِرَ ذُنُوْبِيْ، وَتَعْفُوَ عَنْ جُرْمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُقْبِلَ عَلَيَّ وَلَا تُعْرِضَ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَرْحَمَنِيْ وَلَا تُعَذِّبَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُعَافِيَنِيْ وَلَا تَبْتَلِيَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَرْزُقَنِيْ مِنَ الرِّزْقِ أَطْيَبَهٗ وَأَوْسَعَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَحْرِمَنِيْ يَا رَبِّ"
    },
    {
      "kind": "text",
      "ar": "وَاقْضِ عَنِّيْ دَيْنِيْ، وَضَعْ عَنِّيْ وِزْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُحَمِّلْنِيْ مَا لَا طَاقَةَ لِيْ بِهٖ يَا مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "وَأَدْخِلْنِيْ فِيْ كُلِّ خَيْرٍ أَدْخَلْتَ فِيْهِ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْرِجْنِيْ مِنْ كُلِّ سُوْءٍ أَخْرَجْتَ مِنْهُ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُكَ عَلَيْهِ وَعَلَيْهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْهِ وَعَلَيْهِمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَدْعُوْكَ كَمَا أَمَرْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاسْتَجِبْ لِيْ كَمَا وَعَدْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ قَلِيْلًا مِنْ كَثِيْرٍ"
    },
    {
      "kind": "text",
      "ar": "مَعَ حَاجَةٍ بِيْ اِلَيْهِ عَظِيْمَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَغِنَاكَ عَنْهُ قَدِيْمٌ، وَهُوَ عِنْدِيْ كَثِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَلَيْكَ سَهْلٌ يَسِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "فَامْنُنْ عَلَيَّ بِهٖ، اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "اٰمِيْنَ رَبَّ الْعَالَمِيْنَ"
    }
  ]
}