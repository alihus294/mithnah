{
  "id": "munajat-13-zakirin",
  "title": "المناجاة الثالثة عشرة — مناجاة الذاكرين",
  "subtitle": "من المناجاة الخمسة عشر للإمام السجاد عليه السلام",
  "source": "مفاتيح الجنان، المناجاة الخمس عشرة",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "مناجاة الذاكرين", "subtitle": "المناجاة الثالثة عشرة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "إِلٰهِي لَوْلا الواجِبُ مِنْ قَبُولِ أَمْرِكَ" },
    { "kind": "text", "ar": "لَنَزَّهْتُكَ عَنْ ذِكْرِي إِيَّاكَ" },
    { "kind": "text", "ar": "عَلَىٰ أَنَّ ذِكْرِي لَكَ بِقَدْرِي لا بِقَدْرِكَ" },
    { "kind": "text", "ar": "وَما عَسَىٰ أَنْ يَبْلُغَ مِقْدارِي" },
    { "kind": "text", "ar": "حَتَّىٰ أُجْعَلَ مَحَلّاً لِتَقْدِيسِكَ" },
    { "kind": "text", "ar": "وَمِنْ أَعْظَمِ النِّعَمِ عَلَيْنا جَرَيانُ ذِكْرِكَ عَلَىٰ أَلْسِنَتِنا" },
    { "kind": "text", "ar": "وَإِذْنُكَ لَنا بِدُعائِكَ وَتَنْزِيهِكَ وَتَسْبِيحِكَ" },
    { "kind": "text", "ar": "إِلٰهِي فَأَلْهِمْنا ذِكْرَكَ فِي الخَلاءِ وَالمَلاءِ" },
    { "kind": "text", "ar": "وَاللَّيْلِ وَالنَّهارِ، وَالإِعْلانِ وَالإِسْرارِ" },
    { "kind": "text", "ar": "وَفِي السَّرَّاءِ وَالضَّرَّاءِ" },
    { "kind": "text", "ar": "وَآنِسْنا بِالذِّكْرِ الخَفِيِّ" },
    { "kind": "text", "ar": "وَاسْتَعْمِلْنا بِالعَمَلِ الزَّكِيِّ وَالسَّعْيِ المَرْضِيِّ" },
    { "kind": "text", "ar": "وَجازِنا بِالمِيزانِ الوَفِيِّ" },
    { "kind": "text", "ar": "إِلٰهِي بِكَ هامَتِ القُلُوبُ الوالِهَةُ" },
    { "kind": "text", "ar": "وَعَلَىٰ مَعْرِفَتِكَ جُمِعَتِ العُقُولُ المُتَبايِنَةُ" },
    { "kind": "text", "ar": "فَلا تَطْمَئِنُّ القُلُوبُ إِلَّا بِذِكْراكَ" },
    { "kind": "text", "ar": "وَلا تَسْكُنُ النُّفُوسُ إِلَّا عِنْدَ رُؤْياكَ" },
    { "kind": "text", "ar": "أَنْتَ المُسَبَّحُ فِي كُلِّ مَكانٍ" },
    { "kind": "text", "ar": "وَالمَعْبُودُ فِي كُلِّ زَمانٍ" },
    { "kind": "text", "ar": "وَالمَوْجُودُ فِي كُلِّ أَوانٍ" },
    { "kind": "text", "ar": "وَالمَدْعُوُّ بِكُلِّ لِسانٍ" },
    { "kind": "text", "ar": "وَالمُعَظَّمُ فِي كُلِّ جَنانٍ" },
    { "kind": "text", "ar": "وَأَسْتَغْفِرُكَ مِنْ كُلِّ لَذَّةٍ بِغَيْرِ ذِكْرِكَ" },
    { "kind": "text", "ar": "وَمِنْ كُلِّ راحَةٍ بِغَيْرِ أُنْسِكَ" },
    { "kind": "text", "ar": "وَمِنْ كُلِّ سُرُورٍ بِغَيْرِ قُرْبِكَ" },
    { "kind": "text", "ar": "وَمِنْ كُلِّ شُغْلٍ بِغَيْرِ طاعَتِكَ" },
    { "kind": "text", "ar": "إِلٰهِي أَنْتَ قُلْتَ وَقَوْلُكَ الحَقُّ" },
    { "kind": "text", "ar": "فَأَمَرْتَنا بِذِكْرِكَ" },
    { "kind": "text", "ar": "وَوَعَدْتَنا عَلَيْهِ أَنْ تَذْكُرَنا" },
    { "kind": "text", "ar": "تَشْرِيفاً لَنا وَتَفْخِيماً وَإِعْظاماً" },
    { "kind": "text", "ar": "وَها نَحْنُ ذاكِرُوكَ كَما أَمَرْتَنا" },
    { "kind": "text", "ar": "فَأَنْجِزْ لَنا ما وَعَدْتَنا" },
    { "kind": "text", "ar": "يا ذاكِرَ الذَّاكِرِينَ، وَيا أَرْحَمَ الرَّاحِمِينَ" }
  ]
}
