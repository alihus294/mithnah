    {
      "kind": "text",
      "ar": "وَالْبَآئِتِ عَلٰي فِرَاشِهٖ وَالْمُوَاسِيْ لَهٗ بِنَفْسِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكَاشِفِ الْكَرْبِ عَنْ وَجْهِهٖ"
