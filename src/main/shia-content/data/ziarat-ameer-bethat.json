    {
      "kind": "text",
      "ar": "فَكَاكَ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَنِيْ مِمَّنْ يُسَارِعُ فِي الْخَيْرَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَيَدْعُوْكَ رَغَبًا وَرَهَبًا"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلَنِيْ لَكَ مِنَ الْخَاشِعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّكَ مَنَنْتَ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "بِزِيَارَةِ مَوْلَايَ عَلِيِّ بْنِ أَبِيْ طَالِبٍ وَوِلَايَتِهٖ وَمَعْرِفَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَاجْعَلْنِيْ مِمَّنْ يَنْصُرُهٗ وَيَنْتَصِرُ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمُنَّ عَلَيَّ بِنَصْرِكَ لِدِيْنِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاجْعَلْنِيْ مِنْ شِيْعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَفَّنِيْ عَلٰي دِيْنِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَوْجِبْ لِيْ مِنَ الرَّحْمَةِ وَالرِّضْوَانِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَغْفِرَةِ وَالْاِحْسَانِ وَالرِّزْقِ الْوَاسِعِ الْحَلَالِ الطَّيِّبِ"
    },
    {
      "kind": "text",
      "ar": "مَا أَنْتَ أَهْلُهٗ يَا أَرْحمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "رَحِمَكَ اللهُ يَا أَبَاالْحَسَنِ، كُنْتَ أَوَّلَ الْقَوْمِ اِسْلَامًا"
    },
    {
      "kind": "text",
      "ar": "وَأَخْلَصَهُمْ اِيْمَانًا، وَأَشَدَّهُمْ يَقِيْنًا، وَأَخْوَفَهُمْ لِلّٰهِ۔"
    }
  ]
}