    {
      "kind": "text",
      "ar": "أَمِيْرِ الْمُؤْمِنِيْنَ، وَيَعْسُوْبِ الْمُتَّقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَقُدْوَةِ الصِّدِّيْقِيْنَ، وَاِمَامِ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمَعْصُوْمِ مِنَ الزَّلَلِ، وَالْمَفْطُوْمِ مِنَ الْخَلَلِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُهَذَّبِ مِنَ الْعَيْبِ، وَالْمُطَهَّرِ مِنَ الرَّيْبِ"
    },
    {
      "kind": "text",
      "ar": "أَخِيْ نَبِيِّكَ وَوَصِيِّ رَسُوْلِكَ"
