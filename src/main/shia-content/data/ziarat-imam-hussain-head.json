{
  "id": "ziarat-imam-hussain-head",
  "title": "امام حسين كے سر كي زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام حسين كے سر كي زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الصِّدِّيْقَةِ الطَّاهِرَةِ سَيِّدةِ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ يَا أَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ أَقَمْتَ الصَّلَاةَ، وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ، وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَتَلَوْتَ الْكِتَابَ حَقَّ تِلَاوَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِي اللهِ حَقَّ جِهَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتَ عَلَي الْاَذٰي فِيْ جَنْبِهٖ مُحْتَسِبًا"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ الَّذِيْنَ خَالَفُوْكَ وَحَارَبُوْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ الَّذِيْنَ خَذَلُوْكَ، وَالَّذِيْنَ قَتَلُوْكَ"
    },
    {
      "kind": "text",
      "ar": "مَلْعُوْنُوْنَ عَلٰي لِسَانِ النَّبِيِّ الْأُمِّيِّ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ خَابَ مَنِ افْتَرٰي"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ الظَّالِمِيْنَ لَكُمْ مِنَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَضَاعَفَ عَلَيْهِمُ الْعَذَابَ الْاَلِيْمَ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ يَا مَوْلَايَ يَابْنَ رَسُوْلِ اللهِ زَائِرًا"
    },
    {
      "kind": "text",
      "ar": "عَارِفًا بِحَقِّكَ، مُوَالِيًا لِاَوْلِيَائِكَ، مُعَادِيًا لِاَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَبْصِرًا بِالْهُدَي الَّذِيْ أَنْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "عَارِفًا بِضَلَالَةِ مَنْ خَالَفَكَ"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ عِنْدَ رَبِّكَ۔"
    }
  ]
}