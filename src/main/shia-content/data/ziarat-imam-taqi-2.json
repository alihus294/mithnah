{
  "id": "ziarat-imam-taqi-2",
  "title": "امام محمد تقي  كي دوسري زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام محمد تقي  كي دوسري زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَبَا جَعْفَرٍ مُحَمَّدَ بْنَ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "الْبَرَّ التَّقِيَّ، الْاِمَامَ الْوَفِيَّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الرَّضِيُّ الزَّكِيُّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نَجِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا سَفِيْرَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا سِرَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا ضِيَاءَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا سَنَاءَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا كَلِمَةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَارَحْمَةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا النُّوْرُ السَّاطِعُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْبَدْرُ الطَّالِعُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الطَّيِّبُ مِنَ الطَّيِّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الطَّاهِرُ مِنَ الْمُطَهَّرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْاٰيَةُ الْعُظْمٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْحُجَّةُ الْكُبْرٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَاالْمُطَهَّرُ مِنَ الزَّلَّاتِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْمُنَزَّهُ عَنِ الْمُعْضِلَاتِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْعَلِيُّ عَنْ نَقْصِ الْاَوْصَافِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الرَّضِيُّ عِنْدَ الْاَشْرَافِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا عَمُوْدَ الدِّيْنِ۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ وَلِيُّ اللهِ وَحُجَّتُهٗ فِيْ أَرْضِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ جَنْبُ اللهِ وَخِيَرَةُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَمُسْتَوْدَعُ عِلْمِ اللهِ وَعِلْمِ الْاَنْبِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَرُكْنُ الْاِيْمَانِ، وَتَرْجُمَانُ الْقُرْاٰنِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ مَنِ اتَّبَعَكَ عَلَي الْحَقِّ وَالْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مَنْ أَنْكَرَكَ وَنَصَبَ لَكَ الْعَدَاوَةَ عَلَي الضَّلَالَةِ وَالرَّدٰي"
    },
    {
      "kind": "text",
      "ar": "أَبْرَأُ اِلَي اللهِ وَاِلَيْكَ مِنْهُمْ فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكَ مَا بَقِيْتُ وَبَقِيَ اللَّيْلُ وَالنَّهَارُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدِ بْنِ عَلِيٍّ الزَّكِيِّ التَّقِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَرِّ الْوَفِيِّ، وَالْمُهَذَّبِ النَّقِيِّ"
    },
    {
      "kind": "text",
      "ar": "هَادِي الْأُمَّةِ، وَوَارِثِ الْاَئِمَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَخَازِنِ الرَّحْمَةِ، وَيَنْبُوْعِ الْحِكْمَةِ، وَقَائِدِ الْبَرَكَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَدِيْلِ الْقُرْاٰنِ فِي الطَّاعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَوَاحِدِ الْاَوْصِيَاءِ فِي الْاِخْلَاصِ وَالْعِبَادَةِ"
    },
    {
      "kind": "text",
      "ar": "وَحُجَّتِكَ الْعُلْيَا، وَمَثَلِكَ الْاَعْلٰي، وَكَلِمَتِكَ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "الدَّاعِيْ اِلَيْكَ، وَالدَّالِّ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ نَصَبْتَهٗ عَلَمًا لِعِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُتَرْجِمًا لِكِتَابِكَ، وَصَادِعًا بِأَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَاصِرًا لِدِيْنِكَ، وَحُجَّةً عَلٰي خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنُوْرًا تَخْرُقُ بِهِ الظُّلَمَ"
    },
    {
      "kind": "text",
      "ar": "وَقُدْوَةً تُدْرَكُ بِهَا الْهِدَايَةُ"
    },
    {
      "kind": "text",
      "ar": "وَشَفِيْعًا تُنَالُ بِهِ الْجَنَّةُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَكَمَا أَخَذَ فِيْ خُشُوْعِهٖ لَكَ حَظَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَوْفٰي مِنْ خَشْيَتِكَ نَصِيْبَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِ أَضْعَافَ مَا صَلَّيْتَ عَلٰي وَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "ارْتَضَيْتَ طَاعَتَهٗ وَقَبِلْتَ خِدْمَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْهُ مِنَّا تَحِيَّةً وَسَلَامًا"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا فِيْ مُوَالَاتِهٖ مِنْ لَدُنْكَ فَضْلًا"
    },
    {
      "kind": "text",
      "ar": "وَاِحْسَانًا وَمَغْفِرَةً وَرِضْوَانًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ ذُوالْمَنِّ الْقَدِيْمِ، وَالصَّفْحِ الْجَمِيْلِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اَنْتَ الرَّبُّ وَاَنَا الْمَرْبُوْبُ ..... تا آخر"
    }
  ]
}