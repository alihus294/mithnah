{
  "id": "taweez-mouth-ache",
  "title": "منه كے درد كا تعويذ",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "منه كے درد كا تعويذ",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ الله الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ الله الَّذِيْ لَا يَضُرُّ مَعَ اسْمِهٖ دَاءٌ"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِكَلِمَاتِ الله الَّتِيْ لَا يَضُرُّ مَعَهَا شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "قُدُّوْسٌ قُدُّوْسٌ قُدُّوْسٌ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ يَارَبِّ بِاسْمِكَ الطَّاهِرِ الْمُقَدَّسِ الْمُبَارَكِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ مَنْ سَأَلَكَ بِهٖ أَعْطَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ دَعَاكَ بِهٖ أَجَبْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ يَا اللهُ يَا اللهُ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ النَّبِيِّ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تُعَافِيَنِيْ مِمَّا أَجِدُ فِيْ فَمِيْ وَفِيْ رَأْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ سَمْعِيْ وَفِيْ بَصَرِيْ وَفِيْ بَطْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ ظَهْرِيْ وَفِيْ يَدِيْ وَفِيْ رِجْلي"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ جَوَارِحِيْ كُلِّهَا۔"
    }
  ]
}