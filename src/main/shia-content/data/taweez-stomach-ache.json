{
  "id": "taweez-stomach-ache",
  "title": "پيٹ درد كا تعويذ",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "پيٹ درد كا تعويذ",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "يَا اَللّٰهُ يَا اَللّٰهُ يَا اَللّٰهُ يَا رَحْمٰنُ يَا رَحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "يَارَبَّ الْاَرْبَابِ يَا اِلٰهَ اَلْاٰلِهَةِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَلِكَ الْمُلُوْكِ، يَا سَيِّدَ السَّادَةِ"
    },
    {
      "kind": "text",
      "ar": "اشْفِنِيْ بِشِفَائِكَ مِنْ كُلِّ دَاءٍ وَسُقْمٍ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ عَبْدُكَ وَابْنُ عَبْدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "أَتَقَلَّبُ فِيْ قَبْضَتِكَ۔"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِعِزَّةِ اللهِ وَجَلَالِهٖ مِنْ شَرِّ مَا أَجِدُ۔"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ۔"
    }
  ]
}