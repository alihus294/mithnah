  "id": "ramadan-day16-dua",
  "title": "سولهويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سولهويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَفِّقْنِيْ فِيْهِ لِمُوَافَقَةِ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَجَنِّبْنِيْ فِيْهِ مُرَافَقَةَ الْاَشْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَاٰوِنِيْ فِيْهِ بِرَحْمَتِكَ اِلٰي دَارِ الْقَرَارِ"
    },
    {
      "kind": "text",
      "ar": "بِاِلٰهِيَّتِكَ يَا اِلٰهَ الْعَالَمِيْنَ۔"
    }
  ]
}