{
  "id": "munajat-1-taibeen",
  "title": "المناجاة الأولى — مناجاة التائبين",
  "subtitle": "من المناجاة الخمسة عشر للإمام السجاد عليه السلام",
  "source": "مفاتيح الجنان، المناجاة الخمس عشرة",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "مناجاة التائبين", "subtitle": "المناجاة الأولى — الإمام السجاد ع" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "إِلٰهِي أَلْبَسَتْنِي الخَطايا ثَوْبَ مَذَلَّتِي" },
    { "kind": "text", "ar": "وَجَلَّلَنِي التَّباعُدُ مِنْكَ لِباسَ مَسْكَنَتِي" },
    { "kind": "text", "ar": "وَأَماتَ قَلْبِي عَظِيمُ جِنايَتِي" },
    { "kind": "text", "ar": "فَأَحْيِهِ بِتَوْبَةٍ مِنْكَ" },
    { "kind": "text", "ar": "يا أَمَلِي وَبُغْيَتِي، وَيا سُؤْلِي وَمُنْيَتِي" },
    { "kind": "text", "ar": "فَوَعِزَّتِكَ ما أَجِدُ لِذُنُوبِي سِواكَ غافِراً" },
    { "kind": "text", "ar": "وَلا أَرَىٰ لِكَسْرِي غَيْرَكَ جابِراً" },
    { "kind": "text", "ar": "وَقَدْ خَضَعْتُ بِالإِنابَةِ إِلَيْكَ" },
    { "kind": "text", "ar": "وَعَنَوْتُ بِالاِسْتِكانَةِ لَدَيْكَ" },
    { "kind": "text", "ar": "فَإِنْ طَرَدْتَنِي مِنْ بابِكَ فَبِمَنْ أَلُوذُ" },
    { "kind": "text", "ar": "وَإِنْ رَدَدْتَنِي عَنْ جَنابِكَ فَبِمَنْ أَعُوذُ" },
    { "kind": "text", "ar": "فَوا أَسَفاهُ مِنْ خَجْلَتِي وَافْتِضاحِي" },
    { "kind": "text", "ar": "وَوا لَهْفاهُ مِنْ سُوءِ عَمَلِي وَاجْتِراحِي" },
    { "kind": "text", "ar": "أَسْأَلُكَ يا غافِرَ الذَّنْبِ الكَبِيرِ" },
    { "kind": "text", "ar": "وَيا جابِرَ العَظْمِ الكَسِيرِ" },
    { "kind": "text", "ar": "أَنْ تَهَبَ لِي مُوبِقاتِ الجَرائِرِ" },
    { "kind": "text", "ar": "وَتَسْتُرَ عَلَيَّ فاضِحاتِ السَّرائِرِ" },
    { "kind": "text", "ar": "وَلا تُخْلِنِي فِي مَشْهَدِ القِيامَةِ مِنْ بَرْدِ عَفْوِكَ وَغَفْرِكَ" },
    { "kind": "text", "ar": "وَلا تُعْرِنِي مِنْ جَمِيلِ صَفْحِكَ وَسَتْرِكَ" },
    { "kind": "text", "ar": "إِلٰهِي ظَلِّلْ عَلَىٰ ذُنُوبِي غَمامَ رَحْمَتِكَ" },
    { "kind": "text", "ar": "وَأَرْسِلْ عَلَىٰ عُيُوبِي سَحابَ رَأْفَتِكَ" },
    { "kind": "text", "ar": "إِلٰهِي هَلْ يَرْجِعُ العَبْدُ الآبِقُ إِلَّا إِلَىٰ مَوْلاهُ" },
    { "kind": "text", "ar": "أَمْ هَلْ يُجِيرُهُ مِنْ سَخَطِهِ أَحَدٌ سِواهُ" },
    { "kind": "text", "ar": "إِلٰهِي إِنْ كانَ النَّدَمُ عَلَىٰ الذَّنْبِ تَوْبَةً" },
    { "kind": "text", "ar": "فَإِنِّي وَعِزَّتِكَ مِنَ النَّادِمِينَ" },
    { "kind": "text", "ar": "وَإِنْ كانَ الاِسْتِغْفارُ مِنَ الخَطِيئَةِ حِطَّةً" },
    { "kind": "text", "ar": "فَإِنِّي لَكَ مِنَ المُسْتَغْفِرِينَ" },
    { "kind": "text", "ar": "لَكَ العُتْبَىٰ حَتَّىٰ تَرْضَىٰ" },
    { "kind": "text", "ar": "إِلٰهِي بِقُدْرَتِكَ عَلَيَّ تُبْ عَلَيَّ" },
    { "kind": "text", "ar": "وَبِحِلْمِكَ عَنِّي اعْفُ عَنِّي" },
    { "kind": "text", "ar": "وَبِعِلْمِكَ بِي ارْفَقْ بِي" },
    { "kind": "text", "ar": "إِلٰهِي أَنْتَ الَّذِي فَتَحْتَ لِعِبادِكَ باباً إِلَىٰ عَفْوِكَ" },
    { "kind": "text", "ar": "سَمَّيْتَهُ التَّوْبَةَ" },
    { "kind": "text", "ar": "فَقُلْتَ: ﴿تُوبُوا إِلَىٰ اللهِ تَوْبَةً نَصُوحاً﴾" },
    { "kind": "text", "ar": "فَما عُذْرُ مَنْ أَغْفَلَ دُخُولَ البابِ بَعْدَ فَتْحِهِ" },
    { "kind": "text", "ar": "إِلٰهِي إِنْ كانَ قَبُحَ الذَّنْبُ مِنْ عَبْدِكَ" },
    { "kind": "text", "ar": "فَلْيَحْسُنِ العَفْوُ مِنْ عِنْدِكَ" },
    { "kind": "text", "ar": "إِلٰهِي ما أَنا بِأَوَّلِ مَنْ عَصاكَ فَتُبْتَ عَلَيْهِ" },
    { "kind": "text", "ar": "وَتَعَرَّضَ لِمَعْرُوفِكَ فَجُدْتَ عَلَيْهِ" },
    { "kind": "text", "ar": "يا مُجِيبَ المُضْطَرِّ، يا كاشِفَ الضُّرِّ" },
    { "kind": "text", "ar": "يا عَظِيمَ البِرِّ، يا عَلِيماً بِما فِي السِّرِّ" },
    { "kind": "text", "ar": "يا جَمِيلَ السَّتْرِ" },
    { "kind": "text", "ar": "اسْتَشْفَعْتُ بِجُودِكَ وَكَرَمِكَ إِلَيْكَ" },
    { "kind": "text", "ar": "وَتَوَسَّلْتُ بِجَنابِكَ وَتَرَحُّمِكَ لَدَيْكَ" },
    { "kind": "text", "ar": "فَاسْتَجِبْ دُعائِي وَلا تُخَيِّبْ فِيكَ رَجائِي" },
    { "kind": "text", "ar": "وَتَقَبَّلْ تَوْبَتِي، وَكَفِّرْ خَطِيئَتِي" },
    { "kind": "text", "ar": "بِمَنِّكَ وَرَحْمَتِكَ يا أَرْحَمَ الرَّاحِمِينَ" }
  ]
}
