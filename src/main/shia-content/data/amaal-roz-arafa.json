{
  "id": "amaal-roz-arafa",
  "title": "روز عرفه كے اعمال",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "روز عرفه كے اعمال",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ فِي السَّمَاءِ عَرْشُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ فِي الْاَرْضِ حُكْمُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ فِي الْقُبُوْرِ قَضَاؤُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ فِي الْبَحْرِ سَبِيْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ فِي النَّارِ سُلْطَانُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ فِي الْجَنَّةِ رَحْمَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ فِي الْقِيَامَةِ عَدْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ رَفَعَ السَّمَاءَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ بَسَطَ الْاَرْضَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الَّذِيْ لَا مَلْجَأَ وَلَا مَنْجٰي مِنْهُ اِلَّا اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ وَالْحَمْدُ لِلّٰهِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا اِلٰهَ اِلَّا اللهُ وَاللهُ اَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ، لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ"
    },
    {
      "kind": "text",
      "ar": "يُحْيِيْ وَيُمِيْتُ وَيُمِيْتُ وَيُحْيِيْ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ حَيُّ لَا يَمُوْتُ، بِيَدِهِ الْخَيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَلٰي كُلِّ شَئْيٍ قَدِيْرُ"
    },
    {
      "kind": "text",
      "ar": "اَسْتَغْفِرُ اللهُ الَّذِيْ لَا اِلٰهَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "الْحَيُّ الْقَيُّوْمُ وَاَتَوُبُ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "يَا اَللّٰهُ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحْمٰنُ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "يَا بَدِيْعُ السَّمٰوَاتِ وَالْاَرْضِ، يَا ذَا الْجَلَالِ وَالْاِكْرَامِ"
    },
    {
      "kind": "text",
      "ar": "يَاحَيُّ يَا قَيُّوْمُ"
    },
    {
      "kind": "text",
      "ar": "يَا حَنَّانُ يَا مَنَّانُ"
    },
    {
      "kind": "text",
      "ar": "يَا لَا اِلٰهَ اِلَّا اَنْتَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنّيِ اَسْئَلُكَ يَا مَنْ هُوَ اَقْرَبُ اِلَيَّ مِنْ حَبْلِ الْوَرِيْد"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يَحُوْلُ بَيْنَ الْمَرْءِ وَقَلْبِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ هُوَ بِالْمَنْظَرِ الْاَعْلٰي وَبِالْاُفُقِ الْمُبِيْنِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ هُوَ الْرَّحْمٰنُ عَلَي الْعَرْشِ اسْتَوٰي"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَيْسَ كَمِثْلِهٖ شَيْءٌ وَهُوَ السَّمِيْعُ الْبَصِيْرُ"
    },
    {
      "kind": "text",
      "ar": "اَسْئَلُكَ اَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا أَجْوَدَ مَنْ أَعْطٰي"
    },
    {
      "kind": "text",
      "ar": "وَيَا خَيْرَ مَنْ سُئِلَ، وَيَا أَرْحَمَ مَنِ اسْتُرْحِمَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ فِي الْاَوَّلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ فِي الْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ فِي الْمَلَاِ الْاَعْلٰي"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ فِي الْمُرْسَلِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعْطِى مُحَمَّدًا وَاٰلَهُ الْوَسِيْلَةَ وَالْفَضِيْلَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالشَّرَفَ وَالرِّفْعَةَ وَالدَّرَجَةَ الْكَبِيْرَةَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ اٰمَنْتُ بِمُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَلَمْ أَرَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَحْرِمْنِيْ فِي الْقِيَامَةِ رُؤْيَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ صُحْبَتَهٗ، وَتَوَفَّنِيْ عَلٰي مِلَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْقِنِيْ مِنْ حَوْضِهٖ مَشْرَبًا رَوِيًّا"
    },
    {
      "kind": "text",
      "ar": "سَاِئغًا هَنِيْئًا لَا أَظْمَأُ بَعْدَهٗ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ اٰمَنْتُ بِمُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَلَمْ أَرَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَعَرِّفْنِيْ فِي الْجِنَانِ وَجْهَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بَلِّغْ مُحَمَّدًا صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "تَحِيَّةً كَثِيْرَةً وَسَلَامًا"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ قَبْلَ كُلِّ أَحَدٍ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ بَعْدَ كُلِّ أَحَدٍ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ مَعَ كُلِّ أَحَدٍ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ يَبْقٰي رَبُّنَا وَيَفْنٰي كُلُّ أَحَدٍ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ تَسْبِيْحًا"
    },
    {
      "kind": "text",
      "ar": "يَفْضُلُ تَسْبِيْحَ الْمُسَبِّحِيْنَ فَضْلًا كَثِيْرًا قَبْلَ كُلِّ أَحَدٍ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ تَسْبِيْحًا"
    },
    {
      "kind": "text",
      "ar": "يَفْضُلُ تَسْبِيْحَ الْمُسَبِّحِيْنَ فَضْلًا كَثِيْرًا بَعْدَ كُلِّ أَحَدٍ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ تَسْبِيْحًا"
    },
    {
      "kind": "text",
      "ar": "يَفْضُلُ تَسْبِيْحَ الْمُسَبِّحِيْنَ فَضْلًا كَثِيْرًا مَعَ كُلِّ أَحَدٍ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ تَسْبِيْحًا"
    },
    {
      "kind": "text",
      "ar": "يَفْضُلُ تَسْبِيْحَ الْمُسَبِّحِيْنَ فَضْلًا كَثِيْرًا"
    },
    {
      "kind": "text",
      "ar": "لِرَبِّنَا الْبَاقِيْ وَيَفْنٰي كُلُّ أَحَدٍ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ تَسْبِيْحًا لَا يُحْصٰي وَلَا يُدْرٰي"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُنْسٰي وَلَا يَبْلٰي وَلَا يَفْنٰي وَلَيْسَ لَهٗ مُنْتَهٰي"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ تَسبِيْحًا يَدُوْمُ بِدَوَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَيَبْقٰي بِبَقَائِهٖ فِيْ سِنِي الْعَالَمِيْنَ وَشُهُوْرِ الدُّهُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَيَّامِ الدُّنْيَا وَسَاعَاتِ اللَّيْلِ وَالنَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ أَبَدَ الْاَبَدِ وَمَعَ الْاَبَدِ مِمّا لَا يُحْصِيْهِ الْعَدَدُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُفْنِيْهِ الْاَمَدُ وَلَا يَقْطَعُهُ الْاَبَدُ"
    },
    {
      "kind": "text",
      "ar": "وَتَبَارَكَ اللهُ أَحْسَنُ الْخَالِقِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَنْ تَعَبَّأَ وَتَهَيَّأَ ... الخ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اَنْتَ اللهُ رَبُّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ اِنَّ ذُنُوْبِيْ لَا تَضُرُّكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّ مَغْفِرَتَكَ لِيْ لَا تَنْقُصُكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَعْطِنِيْ مَا لَا يَنْقُصُكَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لِيْ مَا لَا يَضُرُّكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَحْرِمْنِيْ خَيْرَ مَا عِنْدَكَ لِشَرِّ مَا عِنْدِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ أَنْتَ لَمْ تَرْحَمْنِيْ بِتَعَبِيْ وَنَصَبِيْ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَحْرِمْنِيْ أَجْرَ الْمُصَابِ عَلٰي مُصِيْبَتِهٖ۔"
    }
  ]
}