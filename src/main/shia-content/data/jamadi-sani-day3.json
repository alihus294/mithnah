{
  "id": "jamadi-sani-day3",
  "title": "تيسري جمادي الثاني كا دن",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تيسري جمادي الثاني كا دن",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا سَيِّدَةَ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا وَالِدَةَ الْحُجَجِ عَلَي النَّاسِ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الْمَظْلُوْمَةُ الْمَمْنُوْعَةُ حَقَّهَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي أَمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَابْنَةِ نَبِيِّكَ، وَزَوْجَةِ وَصِيِّ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً تُزْلِفُهَا فَوْقَ زُلْفٰي عِبَادِكَ الْمُكَرَّمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ أَهْلِ السَّمَاوَاتِ وَأَهْلِ الْاَرَضِيْنَ۔"
    }
  ]
}