{
  "id": "ramadan-days-common3",
  "title": "ديگر دعائيں اور اذكار",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ديگر دعائيں اور اذكار",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا ذَا الَّذِيْ كَانَ قَبْلَ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ خَلَقَ كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ يَبْقٰي وَيَفْنٰي كُلُّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "يَا ذَا الَّذِيْ لَيْسَ كَمِثْلِهٖ شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَيَا ذَا الَّذِيْ لَيْسَ فِي السَّمٰوَاتِ الْعُلٰي"
    },
    {
      "kind": "text",
      "ar": "وَلَا فِي الْاَرَضِيْنَ السُّفْلٰي"
    },
    {
      "kind": "text",
      "ar": "وَلَا فَوْقَهُنَّ وَلَا تَحْتَهُنَّ وَلَا بَيْنَهُنَّ اِلٰهٌ يُعْبَدُ غَيْرُهٗ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْحَمْدُ حَمْدًا لَا يَقْوٰي عَلٰي اِحْصَائِهٖ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً لَا يَقْوٰي عَلٰي اِحْصَائِهَا اِلَّا أَنْتَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّ شَهْرِ رَمَضَانَ الَّذِيْ أَنْزَلْتَ فِيْهِ الْقُرْاٰنَ"
    },
    {
      "kind": "text",
      "ar": "وَافْتَرَضْتَ عَلٰي عِبَادِكَ فِيْهِ الصِّيَامَ"
    },
    {
      "kind": "text",
      "ar": "ارْزُقْنِيْ حَجَّ بَيْتِكَ الْحَرَامِ"
    },
    {
      "kind": "text",
      "ar": "فِيْ هٰذَا الْعَامِ وَفِيْ كُلِّ عَامٍ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لِيَ الذُّنُوْبَ الْعِظَامَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ لَا يَغْفِرُهَا غَيْرُكَ يَا ذَا الْجَلَالِ وَالْاِكْرَامِ۔"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الضَّارِّ النَّافِعِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْقَاضِيْ بِالْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْعَلِيِّ الْاَعْلٰي"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَهٗ وَبِحَمْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَهٗ وَتَعَالٰي۔"
    }
  ]
}