{
  "id": "wuzu-miswak",
  "title": "آداب وضو ۔ فضيلت مسواك",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "آداب وضو ۔ فضيلت مسواك",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ جَعَلَ الْمَاءَ طَهُوْرًا وَلَمْ يَجْعَلْهُ نَجِسًا"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ الله وَبِاللّٰهِ اَللّٰهُمَّ اجْعَلْنِيْ مِنَ التَّوَّابِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنَ الْمُتَطَهِّرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَقِّنِيْ حُجَّتِيْ يَوْمَ أَلْقَاكَ، وَأَطْلِقْ لِسَانِيْ بِذِكْرِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تُحَرِّمْ عَلَيَّ رِيْحَ الْجَنَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِمَّنْ يَشَمُّ رِيْحَهَا وَرَوْحَهَا وَطِيْبَهَا۔"
    },
    {
      "kind": "text",
      "ar": ":اَللّٰهُمَّ بَيِّضْ وَجْهِيْ يَوْمَ تَسْوَدُّ الْوُجُوْهُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُسَوِّدْ وَجْهِيْ يَوْمَ تَبْيَضُّ الْوُجُوْهُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعْطِنِيْ كِتَابِيْ بِيَمِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْخُلْدَ فِي الْجِنَانِ بِيَسَارِيْ"
    },
    {
      "kind": "text",
      "ar": "وَحَاسِبْنِيْ حِسَابًا يَسِيْرًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تُعْطِنِيْ كِتَابِيْ بِشِمَالِيْ وَلَا مِنْ وَرَاءِ ظَهْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْهَا مَغْلُوْلَةً اِلٰي عُنُقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ مِنْ مُقَطَّعَاتِ النِّيْرَانِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ غَشِّنِيْ رَحْمَتَكَ وَبَرَكَاتِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ثَبِّتْنِيْ عَلَي الصِّرَاطِ يَوْمَ تَزِلُّ فِيْهِ الْاَقْدَامُ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ سَعْيِيْ فِيْمَا يُرْضِيْكَ عَنِّيْ يَا ذَاالْجَلَالِ وَالْاِكرَام"
    },
    {
      "kind": "text",
      "ar": "الّهُمَّ اِنِّيْ أَسْأَلُكَ تَمَامَ الْوُضُوْءِ"
    },
    {
      "kind": "text",
      "ar": "وَتَمَامَ الصَّلَاةِ وَتَمَامَ رِضْوَانِكَ وَالْجَنَّةَ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ۔"
    }
  ]
}