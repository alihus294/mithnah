{
  "id": "dua-rahba",
  "title": "دعاء رهبه (خوفِ خدا)",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء رهبه (خوفِ خدا)",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّكَ خَلَقْتَنِيْ سَوِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّيْتَنِيْ صَغِيْرًا وَرَزَقْتَنِيْ مَكْفِيًّا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ وَجَدْتُ فِيْمَا أَنْزَلْتَ مِنْ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَشَّرْتَ بِهٖ عِبَادَكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ قُلْتَ يَا عِبَادِيَ الَّذِيْنَ أَسْرَفُوْا عَلٰي أَنْفُسِهِمْ"
    },
    {
      "kind": "text",
      "ar": "لَا تَقْنَطُوْا مِنْ رَّحْمَةِ الله"
    },
    {
      "kind": "text",
      "ar": "اِنَّ الله يَغْفِرُ الذُّنُوْبَ جَمِيْعًا"
    },
    {
      "kind": "text",
      "ar": "وَتَقَدَّمَ مِنِّيْ مَا عَلِمْتَ"
    },
    {
      "kind": "text",
      "ar": "وَمَا أَنْتَ أَعْلَمُ بِهٖ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "فَيَاسَوْأَتَاهُ مِمَّا أَحْصَاهُ عَلَيَّ كِتَابُكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَوْلَا الْمَوَاقِفُ الَّتِيْ أُؤَمِّلُ مِنْ عَفْوِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ شَمِلَ كُلَّ شَيْءٍ، لَاَلْقَيْتُ بِيَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَوْ أَنَّ أَحَدًا اسْتَطَاعَ الْهَرَبَ مِنْ رَبِّهِ"
    },
    {
      "kind": "text",
      "ar": "لَكُنْتُ أَنَا أَحَقُّ بِالْهَرَبِ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ لَا تَخْفٰي عَلَيْكَ خَافِيَةٌ فِي الْاَرْضِ وَلَا فِي السَّمَاءِ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا أَتَيْتَ بِهَا وَكَفٰي بِكَ جَازِيًا وَكَفٰي بِكَ حَسِيْبًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّكَ طَالِبِيْ اِنْ أَنَا هَرَبْتُ"
    },
    {
      "kind": "text",
      "ar": "وَمُدْركِيْ اِنْ أَنَا فَرَرْتُ"
    },
    {
      "kind": "text",
      "ar": "فَهَا أَنَا ذَا بَيْنَ يَدَيْكَ خَاضِعٌ ذَلِيْلٌ رَاغِمٌ"
    },
    {
      "kind": "text",
      "ar": "اِنْ تُعَذِّبْنِيْ فَاِنِّيْ لِذٰلِكَ أَهْلٌ وَهُوَ يَا رَبِّ مِنْكَ عَدْلٌ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ تَعْفُ عَنِّيْ فَقَدِيْمًا شَمَلَنِيْ عَفْوُكَ وَأَلْبَسْتَنِيْ عَافِيَتَكَ"
    },
    {
      "kind": "text",
      "ar": "فأَسْأَلُكَ اَللّٰهُمَّ بِالْمَخْزُوْنِ مِنْ أَسْمَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَا وَارَتْهُ الْحُجُبُ مِنْ بَهَائِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا رَحِمْتَ هٰذِهِ النَّفْسَ الْجَزُوْعَةَ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذِهِ الرِّمَّةَ الْهَلُوْعَةَ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ لَا تَسْتَطِيْعُ حَرَّ شَمْسِكَ"
    },
    {
      "kind": "text",
      "ar": "فَكَيْفَ تَسْتَطِيْعُ حَرَّ نَارِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالَّتِيْ لَا تَسْتَطِيْعُ صَوْتَ رَعْدِكَ"
    },
    {
      "kind": "text",
      "ar": "فَكَيْفَ تَسْتَطِيْعُ صَوْتَ غَضَبِكَ"
    },
    {
      "kind": "text",
      "ar": "فَارْحَمْنِيْ اَللّٰهُمَّ فَاِنِّي امْرُءٌ حَقِيْرٌ وَخَطَرِيْ يَسِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَيْسَ عَذَابِيْ مِمَّا يَزِيْدُ فِيْ مُلْكِكَ مِثْقَالَ ذَرَّةٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَوْ أَنَّ عَذَابِيْ لَسَأَلْتُكَ الصَّبْرَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْبَبْتُ أَنْ يَكُوْنَ ذٰلِكَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلٰكِنْ سُلْطَانُكَ اَللّٰهُمَّ أَعْظَمُ"
    },
    {
      "kind": "text",
      "ar": "وَمُلْكُكَ أَدْوَمُ مِنْ أَنْ تَزِيْدَ فِيْهِ طَاعَةُ الْمُطِيْعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَوْ تَنْقُصَ مِنْهُ مَعْصِيَةُ الْمُذْنِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَارْحَمْنِيْ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَتَجَاوَزْ عَنِّيْ يَا ذَا الْجَلَالِ وَالْاِكْرَامِ"
    },
    {
      "kind": "text",
      "ar": "وَتُبْ عَلَيَّ اِنَّكَ أَنْتَ التَّوَّابُ الرَّحِيْمُ"
    }
  ]
}