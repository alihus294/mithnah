{
  "id": "namaz-imam-askari",
  "title": "نماز امام حسن عسكري",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز امام حسن عسكري",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِأَنَّ لَكَ الْحَمْدَ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ الْبَدِيْءُ قَبْلَ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْحَيُّ الْقَيُّوْمُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا اِلٰهَ اِلَّا أَنْتَ الَّذِيْ لَا يُذِلُّكَ شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ كُلَّ يَوْمٍ فِيْ شَأْنٍ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ خَالِقُ مَا يُرٰي وَمَا لَا يُرٰي"
    },
    {
      "kind": "text",
      "ar": "الْعَالِمُ بِكُلِّ شَيْءٍ بِغَيْرِ تَعْلِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِاٰلَآئِكَ وَنَعْمَائِكَ"
    },
    {
      "kind": "text",
      "ar": "بِأَنَّكَ اللهُ الرَّبُّ الْوَاحِدُ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ الرَّحْمٰنُ الرَّحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُكَ بِأَنَّكَ أَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ الْوِتْرُ الْفَرْدُ"
    },
    {
      "kind": "text",
      "ar": "الْاَحَدُ الصَّمَدُ الَّذِيْ لَمْ يَلِدْ وَلَمْ يُوْلَدْ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ كُفُوًا أَحَدٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُكَ بِأَنَّكَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ اللَّطِيْفُ الْخَبِيْرُ"
    },
    {
      "kind": "text",
      "ar": "الْقَائِمُ عَلٰي كُلِّ نَفْسٍ بِمَا كَسَبَتْ، الرَّقِيْبُ الْحَفِيْظُ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُكَ بِأَنَّكَ اللهُ الْاَوَّلُ قَبْلَ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْاٰخِرُ بَعْدَ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَاطِنُ دُوْنَ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "الضَّارُّ النَّافِعُ الْحَكِيْمُ الْعَلِيْمُ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُكَ بِأَنَّكَ أَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "الْحَيُّ الْقَيُّوْمُ الْبَاعِثُ الْوَارِثُ"
    },
    {
      "kind": "text",
      "ar": "الْحَنَّانُ الْمَنَّانُ بَدِيْعُ السَّمَاوَاتِ وَالْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "ذُوالْجَلَالِ وَالْاِكْرَامِ وَذُو الطَّوْلِ وَذُو الْعِزَّةِ وَذُو السُّلْطَانِ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ أَحَطْتَ بِكُلِّ شَيْءٍ عِلْمًا"
    },
    {
      "kind": "text",
      "ar": "وَأَحْصَيْتَ كُلَّ شَيْءٍ عَدَدًا"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    }
  ]
}