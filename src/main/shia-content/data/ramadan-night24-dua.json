{
  "id": "ramadan-night24-dua",
  "title": "چوبيسويں شب كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "چوبيسويں شب كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا فَالِقَ الْاِصْبَاحِ وَجَاعِلَ اللَّيْلِ سَكَنًا"
    },
    {
      "kind": "text",
      "ar": "وَالشَّمْسَ وَالْقَمَرَ حُسْبَانًا"
    },
    {
      "kind": "text",
      "ar": "يَا عَزِيْزُ يَا عَلِيْمُ، يَا ذَا الْمَنِّ وَالطَّوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَالْقُوَّةِ وَالْحَوْلِ وَالْفَضْلِ وَالْاِنْعَامِ"
    },
    {
      "kind": "text",
      "ar": "وَالْجَلَالِ وَالْاِكْرَامِ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا رَحْمٰنُ يَا اللهُ يَا فَرْدُ يَا وِتْرُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا ظَاهِرُ يَا بَاطِنُ"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْاَسْمَاءُ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْاَمْثَالُ الْعُلْيَا، وَالْكِبْرِيَاءُ وَالْاٰلَاءُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ اسْمِيْ فِيْ هٰذِهِ اللَّيْلَةِ فِي السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَرُوْحِيْ مَعَ الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاِحْسَانِيْ فِيْ عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِسَائَتِيْ مَغْفُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَهَبَ لِيْ يَقِيْنًا تُبَاشِرُ بِهٖ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِيْمَانًا يَذْهَبُ بِالشَّكِّ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَرِضًى بِمَا قَسَمْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا فِي الدُّنْيَا حَسَنَةً، وَفِي الْاٰخِرَةِ حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِنَا عَذَابَ النَّارِ الْحَرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ فِيْهَا ذِكْرَكَ وَشُكْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّغْبَةَ اِلَيْكَ وَالْاِنَابَةَ وَالتَّوْبَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّوْفِيْقَ لِمَا وَفَّقْتَ لَهٗ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُكَ عَلَيْهِ وَعَلَيْهِمْ۔"
    }
  ]
}