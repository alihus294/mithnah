{
  "id": "awal-mah",
  "title": "اولِ ماه كے اعمال",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "اولِ ماه كے اعمال",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَمَا مِنْ دَابَّةٍ فِي الْاَرْضِ اِلَّا عَلَي اللهِ رِزْقُهَا"
    },
    {
      "kind": "text",
      "ar": "وَيَعْلَمُ مُسْتَقَرَّهَا وَمُسْتَوْدَعَهَا"
    },
    {
      "kind": "text",
      "ar": "كُلٌّ فِيْ كِتَابٍ مُبِيْنٍ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ يَمْسَسْكَ اللهُ بِضُرٍّ"
    },
    {
      "kind": "text",
      "ar": "فَلَا كَاشِفَ لَهٗ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ يُرِدْكَ بِخَيْرٍ فَلَا رَادَّ لِفَضْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "يُصِيْبُ بِهٖ مَنْ يَشَاءُ مِنْ عِبَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ الْغَفُوْرُ الرَّحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "سَيَجْعَلُ اللهُ بَعْدَ عُسْرٍ يُسْرًا"
    },
    {
      "kind": "text",
      "ar": "مَا شَاءَ اللهُ، لَا قُوَّةَ اِلَّا بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "حَسْبُنَا اللهُ وَنِعْمَ الْوَكِيْلُ"
    },
    {
      "kind": "text",
      "ar": "وَأُفَوِّضُ أَمْرِيْ اِلَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ بَصِيْرٌ بِالْعِبَادِ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ سُبْحَانَكَ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ كُنْتُ مِنَ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "رَبِّ اِنِّيْ لِمَا أَنْزَلْتَ اِلَيَّ مِنْ خَيْرٍ فَقِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "رَبِّ لَا تَذَرْنِيْ فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِيْنَ۔"
    }
  ]
}