{
  "id": "dua-sahar-uddat",
  "title": "دعاء سحر يَا عُدَّتِيْ",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء سحر يَا عُدَّتِيْ",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا عُدَّتِيْ فِيْ كُرْبَتِيْ، وَيَا صَاحِبِيْ فِيْ شِدَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَيَا وَلِيِّيْ فِيْ نِعْمَتِيْ، وَيَا غَايَتِيْ فِيْ رَغْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ السّاتِرُ عَوْرَتِيْ، وَالْمُؤْمِنُ رَوْعَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُقِيْلُ عَثْرَتِيْ، فَاغْفِرْلِيْ خَطِيْئَتِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ خُشُوْعَ الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "قَبْلَ خُشُوْعِ الذُلِّ فِي النَّارِ"
    },
    {
      "kind": "text",
      "ar": "يَا وَاحِدُ يَا أَحَدُ يَا صَمَدُ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَمْ يَلِدْ وَلَمْ يُوْلَدْ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ كُفُوًا أَحَدٌ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يُعْطِيْ مَنْ سَأَلَهٗ تَحَنُّنًا مِنْهُ وَرَحْمَةً"
    },
    {
      "kind": "text",
      "ar": "وَيَبْتَدِئُ بِالْخَيْرِ مَنْ لَمْ يَسْأَلْهٗ تَفَضُّلًا مِنْهُ وَكَرَمًا"
    },
    {
      "kind": "text",
      "ar": "بِكَرَمِكَ الدَّائِمِ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيْ رَحْمَةً وَاسِعَةً جَامِعَةً"
    },
    {
      "kind": "text",
      "ar": "أَبْلُغُ بِهَا خَيْرَ الدُّنْيَا وَالْاٰخِرَةِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْتَغْفِرُكَ"
    },
    {
      "kind": "text",
      "ar": "لِمَا تُبْتُ اِلَيْكَ مِنْهُ ثُمَّ عُدْتُ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ لِكُلِّ خَيْرٍ أَرَدْتُ بِهٖ وَجْهَكَ"
    },
    {
      "kind": "text",
      "ar": "فَخَالَطَنِيْ فِيْهِ مَا لَيْسَ لَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاعْفُ عَنْ ظُلْمِيْ وَجُرْمِيْ بِحِلْمِكَ وَجُوْدِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا كَرِيْمُ، يَا مَنْ لَا يَخِيْبُ سَائِلُهٗ، وَلَا يَنْفَدُ نَائِلُهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ عَلَا فَلَا شَيْءَ فَوْقَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَدَنَا فَلَا شَيْءَ دُوْنَهٗ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْنِيْ يَا فَالِقَ الْبَحْرِ لِمُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "اللَّيْلَةَ اللَّيْلَةَ اللَّيْلَةَ"
    },
    {
      "kind": "text",
      "ar": "السَّاعَةَ السَّاعَةَ السَّاعَةَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ طَهِّرْ قَلْبِيْ مِنَ النِّفَاقِ"
    },
    {
      "kind": "text",
      "ar": "وَعَمَلِيْ مِنَ الرِّيَاءِ، وَلِسَانِيْ مِنَ الكَذِبِ"
    },
    {
      "kind": "text",
      "ar": "وَعَيْنِيْ مِنَ الْخِيَانَةِ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ تَعْلَمُ خَائِنَةَ الْاَعْيُنِ وَمَا تُخْفِي الصُّدُوْرُ،"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ هٰذَا مَقَامُ الْعَائِذِ بِكَ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْمُسْتَجِيْرِ بِكَ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْمُسْتَغِيْثِ بِكَ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْهَارِبِ اِلَيْكَ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ مَنْ يَبُوْءُ لَكَ بِخَطِيْئَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَيَعْتَرِفُ بِذَنْبِهٖ، وَيَتُوْبُ اِلٰي رَبِّهٖ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْبَائِسِ الْفَقِيْرِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْخَائِفِ الْمُسْتَجِيْرِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَام الْمَحْزُوْنِ الْمَكْرُوْبِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْمَغْمُوْمِ الْمَهْمُوْم"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْغَرِيْبِ الْغَرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْمُسْتَوْحِشِ الْفَرِقِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ مَنْ لَا يَجِدُ لِذَنْبِهٖ غَافِرًا غَيْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا لِضَعْفِهٖ مُقَوِيًّا اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا لِهَمِّهٖ مُفَرِّجًا سِوَاكَ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا كَرِيْمُ، لَا تُحْرِقْ وَجْهِيْ بِالنَّارِ"
    },
    {
      "kind": "text",
      "ar": "بَعْدَ سُجُوْدِيْ لَكَ وَتَعْفِيْرِيْ بِغَيرِ مَنٍّ مِنِّيْ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "بَلْ لَكَ الْحَمْدُ وَالْمَنُّ وَالتَّفَضُّلُ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "ارْحَمْ أَيْ رَبِّ، أَيْ رَبِّ، أَيْ رَبِّ، ......"
    },
    {
      "kind": "text",
      "ar": "ضَعْفِيْ، وَقِلَّةَ حِيْلَتِيْ، وَرِقَّةَ جِلْدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَبَدُّدَ أَوْصَالِيْ، وَتَنَاثُرَ لَحْمِيْ وَجِسْمِيْ وَجَسَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَوَحْدَتِيْ وَوَحْشَتِيْ فِيْ قَبْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَجَزَعِيْ مِنْ صَغِيْرِ الْبَلَاءِ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ يَا رَبِّ قُرَّةَ الْعَيْنِ وَالْاِغْتِبَاطَ"
    },
    {
      "kind": "text",
      "ar": "يَوْمَ الْحَسْرَةِ وَالنَّدَامَةِ"
    },
    {
      "kind": "text",
      "ar": "بَيِّضْ وَجْهِيْ يَا رَبِّ يَوْمَ تَسْوَدُّ الْوُجُوْهُ"
    },
    {
      "kind": "text",
      "ar": "اٰمِنِّيْ مِنَ الْفَزَعِ الْاَكْبَرِ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ الْبُشْرٰي يَوْمَ تُقَلَّبُ الْقُلُوْبُ وَالْاَبْصَارُ"
    },
    {
      "kind": "text",
      "ar": "وَالْبُشْرٰي عِنْدَ فِرَاقِ الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَرْجُوْهُ عَوْنًا لِيْ فِيْ حَيَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأُعِدُّهٗ ذُخْرًا لِيَوْمِ فَاقَتِيْ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَدْعُوْهُ وَلَا أَدْعُوْ غَيْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَوْ دَعَوْتُ غَيْرَهٗ لَخَيَّبَ دُعَائِيْ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَرْجُوْهُ وَلَا أَرْجُوْ غَيْرَهُ"
    },
    {
      "kind": "text",
      "ar": "وَلَوْ رَجَوْتُ غَيْرَهٗ لَاَخْلَفَ رَجَائِيْ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الْمُنْعِمِ الْمُحْسِنِ"
    },
    {
      "kind": "text",
      "ar": "الْمُجْمِلِ الْمُفْضِلِ ذِي الْجَلَالِ وَالْاِكْرَامِ"
    },
    {
      "kind": "text",
      "ar": "وَلِيُّ كُلِّ نِعْمَةٍ، وَصَاحِبُ كُلِّ حَسَنَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَمُنْتَهٰي كُلِّ رَغْبَةٍ، وَقَاضِيْ كُلِّ حَاجَةٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِي الْيَقِيْنَ وَحُسْنَ الظَّنِّ بِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَثْبِتْ رَجَائَكَ فِيْ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاقْطَعْ رَجَائِيْ عَمَّنْ سِوَاكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا أَرْجُوَ غَيْرَكَ وَلَا أَثِقَ اِلَّا بِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا لَطِيْفًا لِمَا تَشَاءُ"
    },
    {
      "kind": "text",
      "ar": "اُلْطُفْ لِيْ فِيْ جَمِيْعِ أَحْوَالِيْ بِمَا تُحِبُّ وَتَرْضٰي"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ اِنِّيْ ضَعِيْفٌ عَلَي النَّارِ فَلَا تُعَذِّبْنِيْ بِالنَّارِ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ ارْحَمْ دُعَائِيْ وَتَضَرُّعِيْ وَخَوْفِيْ"
    },
    {
      "kind": "text",
      "ar": "وَذُلِّيْ وَمَسْكَنَتِيْ وَتَعْوِيْذِيْ وَتَلْوِيْذِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ اِنِّيْ ضَعِيْفٌ عَنْ طَلَبِ الدُّنْيَا وَأَنْتَ وَاسِعٌ كَرِيْمٌ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ يَا رَبِّ بِقُوَّتِكَ عَلٰي ذٰلِكَ وَقُدْرَتِكَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَغِنَاكَ عَنْهُ، وَحَاجَتِيْ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَرْزُقَنِيْ فِيْ عَامِيْ هٰذَا، وَشَهْرِيْ هٰذَا"
    },
    {
      "kind": "text",
      "ar": "وَيَوْمِيْ هٰذَا، وَسَاعَتِيْ هٰذِهٖ"
    },
    {
      "kind": "text",
      "ar": "رِزْقًا تُغْنِيْنِيْ بِهٖ عَنْ تَكَلُّفِ مَا فِيْ أَيْدِي النّاسِ"
    },
    {
      "kind": "text",
      "ar": "مِنْ رِزْقِكَ الْحَلَالِ الطَّيِّبِ"
    },
    {
      "kind": "text",
      "ar": "أَيْ رَبِّ مِنْكَ أَطْلُبُ، وَاِلَيْكَ أَرْغَب"
    },
    {
      "kind": "text",
      "ar": "وَاِيَّاكَ أَرْجُوْ، وَأَنْتَ أَهْلُ ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "لَا أَرْجُوْ غَيْرَكَ وَلَا أَثِقُ اِلَّا بِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَيْ رَبِّ ظَلَمْتُ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاغْفِرْ لِيْ وَارْحَمْنِيْ وَعَافِنِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا سَامِعَ كُلِّ صَوْتٍ، وَيَا جَامِعَ كُلِّ فَوْتٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَا بَارِئَ النُّفُوْسِ بَعْدَ الْمَوْتِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا تَغْشَاهُ الظُّلُمَاتُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَشْتَبِهُ عَلَيْهِ الْاَصْوَاتُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَشْغَلُهٗ شَيْءٌ عَنْ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "أَعْطِ مُحَمَّدًا صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ أَفْضَلَ مَا سَأَلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْضَلَ مَا سُئِلْتَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْضَلَ مَا أَنْتَ مَسْؤُوْلٌ لَهٗ اِلٰي يَوْمِ الْقِيَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيَ الْعَافِيَةَ حَتّٰي تُهَنِّيَنِي الْمَعِيْشَةَ"
    },
    {
      "kind": "text",
      "ar": "وَاخْتِمْ لِيْ بِخَيْرٍ حَتّٰي لَا تَضُرَّنِي الذُّنُوْبُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَضِّنِيْ بِمَا قَسَمْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا أَسْأَلَ أَحَدًا شَيْئًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَافْتَحْ لِيْ خَزَائِنَ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْنِيْ رَحْمَةً لَا تُعَذِّبُنِيْ بَعْدَهَا"
    },
    {
      "kind": "text",
      "ar": "أَبَدًا فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ مِنْ فَضْلِكَ الْوَاسِعِ رِزْقًا حَلَالًا طَيِّبًا"
    },
    {
      "kind": "text",
      "ar": "لَا تُفْقِرُنِيْ اِلٰي أَحَدٍ بَعْدَهٗ سِوَاكَ"
    },
    {
      "kind": "text",
      "ar": "تَزِيْدُنِيْ بِذٰلِكَ شُكْرًا، وَاِلَيْكَ فَاقَةً وَفَقْرًا"
    },
    {
      "kind": "text",
      "ar": "وَبِكَ عَمَّنْ سِوَاكَ غِنًى وَتَعَفُّفًا"
    },
    {
      "kind": "text",
      "ar": "يَا مُحْسِنُ يَا مُجْمِلُ يَا مُنْعِمُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُفْضِلُ يَا مَلِيْكُ يَا مُقْتَدِرُ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِنِي الْمُهِمَّ كُلَّهٗ، وَاقْضِ لِيْ بِالْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ لِيْ فِيْ جَمِيْعِ أُمُوْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاقْضِ لِيْ جَمِيْعَ حَوَائِجِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَسِّرْ لِيْ مَا أَخَافُ تَعْسِيْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ تَيْسِيْرَ مَا أَخَافُ تَعْسِيْرَهٗ عَلَيْكَ سَهْلٌ يَسِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَسَهِّلْ لِيْ مَا أَخَافُ حُزُوْنَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَنَفِّسْ عَنِّيْ مَا أَخَافُ ضِيْقَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَكُفَّ عَنِّيْ مَا أَخَافُ هَمَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاصْرِفْ عَنِّيْ مَا أَخَافُ بَلِيَّتَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ امْلَأْ قَلْبِيْ حُبًّا لَكَ، وَخَشْيَةً مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَصْدِيْقًا لَكَ، وَاِيْمَانًا بِكَ، وَفَرَقًا مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَشَوْقًا اِلَيْكَ يَا ذَا الْجَلَالِ وَالْاِكْرَامِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ لَكَ حُقُوْقًا فَتَصَدَّقْ بِهَا عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَلِلنَّاسِ قِبَلِيْ تَبِعَاتٌ فَتَحَمَّلْهَا عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ أَوْجَبْتَ لِكُلِّ ضَيْفٍ قِرًى"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا ضَيْفُكَ فَاجْعَلْ قِرَايَ اللَّيْلَةَ الْجَنَّةَ"
    },
    {
      "kind": "text",
      "ar": "يَا وَهَّابَ الْجَنَّةِ، يَا وَهَّابَ الْمَغْفِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِكَ۔"
    }
  ]
}