{
  "id": "munajat-mutieen",
  "title": "۷۔ مناجات مطِيعِين لله",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۷۔ مناجات مطِيعِين لله",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَلْهِمْنَا طَاعَتَكَ، وَجَنِّبْنَا مَعْصِيَتَكَ"
    },
    {
      "kind": "text",
      "ar": "وَيَسِّرْ لَنَا بُلُوْغَ مَا نَتَمَنّٰي مِنِ ابْتِغَاءِ رِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْلِلْنَا بُحْبُوْحَةَ جِنَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاقْشَعْ عَنْ بَصَائِرِنَا سَحَابَ الْاِرْتِيَابِ"
    },
    {
      "kind": "text",
      "ar": "وَاكْشِفْ عَنْ قُلُوْبِنَا أَغْشِيَةَ الْمِرْيَةِ وَالْحِجَابِ"
    },
    {
      "kind": "text",
      "ar": "وَأَزْهِقِ الْبَاطِلَ عَنْ ضَمَائِرِنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَثْبِتِ الْحَقَّ فِيْ سَرَائرِنَا"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ الشُّكُوْكَ وَالظُّنُوْنَ لَوَاقِحُ الْفِتَنِ"
    },
    {
      "kind": "text",
      "ar": "وَمُكَدِّرَةٌ لِصَفْوِ الْمَنَائِحِ وَالْمِنَنِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ احْمِلْنَا فِيْ سُفُنِ نَجَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَتِّعْنَا بِلَذِيْذِ مُنَاجَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْرِدْنَا حِيَاضَ حُبِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَذِقْنَا حَلَاوَةَ وُدِّكَ وَقُرْبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ جِهَادَنَا فِيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَهَمَّنَا فِيْ طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْلِصْ نِيَّاتِنَا فِيْ مُعَامَلَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّا بِكَ وَلَكَ وَلَا وَسِيْلَةَ لَنَا اِلَيْكَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اجْعَلْنِيْ مِنَ الْمُصْطَفَيْنَ الْاَخْيَارِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْحِقْنِيْ بِالصَّالِحِيْنَ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "السَّابِقِيْنَ اِلَي الْمَكْرُمَاتِ، الْمُسَارِعِيْنَ اِلَي الْخَيْرَاتِ"
    },
    {
      "kind": "text",
      "ar": "الْعَامِلِيْنَ لِلْبَاقِيَاتِ الصَّالِحَاتِ"
    },
    {
      "kind": "text",
      "ar": "السَّاعِيْنَ اِلٰي رَفِيْعِ الدَّرَجَاتِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ، وَبِالْاِجَابَةِ جَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}