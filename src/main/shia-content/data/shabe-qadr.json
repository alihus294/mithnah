{
  "id": "shabe-qadr",
  "title": "شب هاء قدر كے مشتركه اعمال",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "شب هاء قدر كے مشتركه اعمال",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَسْتَغْفِرُ اللهَ وَاَتُوْبُ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِكِتَابِكَ الْمُنْزَلِ"
    },
    {
      "kind": "text",
      "ar": "وَمَا فِيْهِ وَفِيْهِ اسْمُكَ الْاَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْمَاؤُكَ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَمَا يُخَافُ وَيُرْجٰي"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَجْعَلَنِيْ مِنْ عُتَقَائِكَ مِنَ النّارِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِحَقِّ هٰذَا الْقُرْاٰنِ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَقِّ مَنْ أَرْسَلْتَهٗ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَقِّ كُلِّ مُؤْمِنٍ مَدَحْتَهٗ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَقِّكَ عَلَيْهِمْ"
    },
    {
      "kind": "text",
      "ar": "فَلَا أَحَدَ أَعْرَفُ بِحَقِّكَ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "بِكَ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "بِمُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "بِعَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "بِفَاطِمَةَ"
    },
    {
      "kind": "text",
      "ar": "بِالْحَسَنِ"
    },
    {
      "kind": "text",
      "ar": "بِالْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "بِعَلِيِّ بْنِ الْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "بِمُحَمَّدِ بْنِ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "بِجَعْفَرِ بْنِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "بِمُوْسَي بْنِ جَعْفَرٍ"
    },
    {
      "kind": "text",
      "ar": "بِعَلِيِّ بْنِ مُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "بِمُحَمَّدِ بْنِ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "بِعَلِيِّ بْنِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "بِالْحَسَنِ بْنِ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "بِالْحُجَّةِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَمْسَيْتُ لَكَ عَبْدًا دَاخِرًا"
    },
    {
      "kind": "text",
      "ar": "لَا أَمْلِكُ لِنَفْسِيْ نَفْعًا وَلَا ضَرًّا"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَصْرِفُ عَنْهَا سُوْٓءً"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ بِذٰلِكَ عَلٰي نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْتَرِفُ لَكَ بِضَعْفِ قُوَّتِيْ وَقِلَّةِ حِيْلَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْجِزْ لِيْ مَا وَعَدْتَنِيْ وَجَمِيْعَ الْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْمَغْفِرَةِ فِيْ هٰذِهِ اللَّيْلَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَتْمِمْ عَلَيَّ مَا اٰتَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ عَبْدُكَ الْمِسْكِيْنُ الْمُسْتَكِيْنُ"
    },
    {
      "kind": "text",
      "ar": "الضَّعِيْفُ الْفَقِيْرُ الْمَهِيْنُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَجْعَلْنِيْ نَاسِيًا لِذِكْرِكَ فِيْمَا أَوْلَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا غَافِلًا لِاِحْسَانِكَ فِيْمَا أَعْطَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا اٰيِسًا مِنْ اِجَابَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ أَبْطَأَتْ عَنِّيْ فِيْ سَرَّاءَ أَوْ ضَرَّاءَ"
    },
    {
      "kind": "text",
      "ar": "أَوْ شِدَّةٍ أَوْ رَخَاءٍ أَوْ عَافِيَةٍ أَوْ بَلَاءٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْ بُؤْسٍ أَوْ نَعْمَاءَ، اِنَّكَ سَمِيْعُ الدُّعَاءِ"
    }
  ]
}