{
  "id": "namaz-istikhara-riqaa",
  "title": "نماز استخاره ذات الرقاع",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز استخاره ذات الرقاع",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ الله الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "خِيْرَةٌ مِنَ اللهِ الْعَزِيْزِ الْحَكِيْمِ"
    },
    {
      "kind": "text",
      "ar": "لِفُلَانِ ابْنِ فُلَانَةُ اِفْعَلْ۔"
    },
    {
      "kind": "text",
      "ar": "أَسْتَخِيْرُ الله بِرَحْمَتِهٖ خِيْرَةً فِيْ عَافِيَةٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ خِرْ لِيْ وَاخْتَرْ لِيْ فِيْ جَمِيْعِ أُموْرِيْ فِيْ يُسْرٍ مِنْكَ وَعَافِيَةٍ"
    }
  ]
}