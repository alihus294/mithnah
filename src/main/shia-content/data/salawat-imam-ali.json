{
  "id": "salawat-imam-ali",
  "title": "اميرالمومنين پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "اميرالمومنين پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي أَمِيْرِ الْمُؤْمِنِيْنَ عَلِيِّ بْنِ أَبِيْ طَالِبٍ"
    },
    {
      "kind": "text",
      "ar": "أَخِيْ نَبِيِّكَ، وَوَلِيِّهٖ، وَصَفِيِّهٖ، وَوَزِيْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمُسْتَوْدَعِ عِلْمِهٖ، وَمَوْضِعِ سِرِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبَابِ حِكْمَتِهٖ، وَالنَّاطِقِ بِحُجَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالدَّاعِيْ اِلٰي شَرِيْعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَخَلِيْفَتِهٖ فِيْ أُمَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمُفَرِّجِ الْكُرَبِ عَنْ وَجْهِهٖ"
    },
    {
      "kind": "text",
      "ar": "قَاصِمِ الْكَفَرَةِ، وَمُرْغِمِ الْفَجَرَةِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ جَعَلْتَهٗ مِنْ نَبِيِّكَ بِمَنْزِلَةِ هَارُوْنَ مِنْ مُوْسٰي۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَالِ مَنْ وَالَاهُ، وَعَادِ مَنْ عَادَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْ مَنْ نَصَرَهٗ، وَاخْذُلْ مَنْ خَذَلَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَنْ مَنْ نَصَبَ لَهٗ مِنَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلَيْهِ أَفْضَلَ مَا صَلَّيْتَ عَلٰي أَحَدٍ مِنْ أَوْصِيَاءِ أَنْبِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبَّ الْعَالَمِيْنَ۔"
    }
  ]
}