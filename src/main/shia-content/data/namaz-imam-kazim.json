{
  "id": "namaz-imam-kazim",
  "title": "نماز حضرت امام موسٰي كاظم",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز حضرت امام موسٰي كاظم",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ خَشَعَتِ الْاَصْوَاتُ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَضَلَّتِ الْاَحْلَامُ فِيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَجِلَ كُلُّ شَيْءٍ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَهَرَبَ كُلُّ شَيْءٍ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَضَاقَتِ الْاَشْيَاءُ دُوْنَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَلَأُ كُلَّ شَيْءٍ نُوْرُكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَنْتَ الرَّفِيْعُ فِيْ جَلَالِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْبَهِيُّ فِيْ جَمَالِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْعَظِيْمُ فِيْ قُدْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الَّذِيْ لَا يَؤُوْدُكَ شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "يَا مُنْزِلَ نِعْمَتِيْ، يَا مُفَرِّجَ كُرْبَتِيْ، وَيَا قَاضِيَ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "أَعْطِنِيْ مَسْأَلَتِيْ بِلَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنْتُ بِكَ مُخْلِصًا لَكَ دِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "أَصْبَحْتُ عَلٰي عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ"
    },
    {
      "kind": "text",
      "ar": "أَبُوْءُ لَكَ بِالنِّعْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ مِنَ الذُّنُوْبِ الَّتِيْ لَا يَغْفِرُهَا غَيْرُكَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ هُوَ فِيْ عُلُوِّهٖ دَانٍ، وَفِيْ دُنُوِّهٖ عَالٍ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ اِشْرَاقِهٖ مُنِيْرٌ، وَفِيْ سُلْطَانِهٖ قَوِيٌّ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    }
  ]
}