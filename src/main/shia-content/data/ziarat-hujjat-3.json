{
  "id": "ziarat-hujjat-3",
  "title": "تيسري زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تيسري زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْحَقِّ الْجَدِيْدِ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَالِمِ الَّذِيْ عِلْمُهٗ لَا يَبِيْدُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُحْيِي الْمُؤْمِنِيْنَ، وَمُبِيْرِ الْكَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَهْدِيِّ الْأُمَمِ، وَجَامِعِ الْكَلِمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي خَلَفِ السَّلَفِ، وَصَاحِبِ الشَّرَفِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي حُجَّةِ الْمَعْبُوْدِ، وَكَلِمَةِ الْمَحْمُوْدِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُعِزِّ الْاَوْلِيَاءِ، وَمُذِلِّ الْاَعْدَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي وَارِثِ الْاَنْبِيَاءِ، وَخَاتِمِ الْاَوْصِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْقَائِمِ الْمُنْتَظَرِ، وَالْعَدْلِ الْمُشْتَهَرِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي السَّيْفِ الشَّاهِرِ"
    },
    {
      "kind": "text",
      "ar": "وَالْقَمَرِ الزَّاهِرِ، وَالنُّوْرِ الْبَاهِرِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي شَمْسِ الظَّلَامِ، وَبَدْرِ التَّمَامِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي رَبِيْعِ الْاَنَامِ، وَنَضْرَةِ الْاَيَّامِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَاحِبِ الصَّمْصَامِ، وَفَلَّاقِ الْهَامِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الدِّيْنِ الْمَأْثُوْرِ، وَالْكِتَابِ الْمَسْطُوْرِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي بَقِيَّةِ اللهِ فِيْ بِلَادِهٖ، وَحُجَّتِهٖ عَلٰي عِبَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْمُنْتَهٰي اِلَيْهِ مَوَارِيْثُ الْاَنْبِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَلَدَيْهِ مَوْجُوْدٌ اٰثَارُ الْاَصْفِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمُؤْتَمَنِ عَلَي السِّرِّ، وَالْوَلِيِّ لِلْاَمْرِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمَهْدِيِّ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ وَعَدَ اللهُ عَزَّوَجَلَّ بِهِ الْأُمَمَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ يَجْمَعَ بِهِ الْكَلِمَ، وَيَلُمَّ بِهِ الشَّعَثَ"
    },
    {
      "kind": "text",
      "ar": "وَيَمْلَأَ بِهِ الْاَرْضَ قِسْطًا وَعَدْلًا"
    },
    {
      "kind": "text",
      "ar": "وَيُمَكِّنَ لَهٗ، وَيُنْجِزَ بِهٖ وَعْدَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ يَا مَوْلَايَ أَنَّكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَئِمَّةَ مِنْ اٰبَائِكَ أَئِمَّتِيْ وَمَوَالِيَّ"
    },
    {
      "kind": "text",
      "ar": "فِي الْحَيَاةِ الدُّنْيَا وَيَوْمَ يَقُوْمُ الْاَشْهَادُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ يَا مَوْلَايَ أَنْ تَسْأَلَ اللهَ تَبَارَكَ وَتَعَالٰي"
    },
    {
      "kind": "text",
      "ar": "فِيْ صَلَاحِ شَأْنِيْ وَقَضَاءِ حَوَائِجِيْ"
    },
    {
      "kind": "text",
      "ar": "وَغُفْرَانِ ذُنُوْبِيْ وَالْاَخْذِ بِيَدِيْ"
    },
    {
      "kind": "text",
      "ar": "فِيْ دِيْنِيْ وَدُنْيَايَ وَاٰخِرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "لِيْ وَلِاِخْوَانِيْ وَأَخَوَاتِي الْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ كَافَّةً"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ غَفُوْرٌ رَحِيْمٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي حُجَّتِكَ فِيْ أَرْضِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَلِيْفَتِكَ فِيْ بِلَادِكَ، الدَّاعِيْ اِلٰي سَبِيْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْقَائِمِ بِقِسْطِكَ، وَالْفَائِزِ بِأَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلِيِّ الْمُؤْمِنِيْنَ، وَمُبِيْرِ الْكَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمُجَلِّي الظُّلْمَةِ، وَمُنِيْرِ الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "وَالصَّادِعِ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ وَالصِّدْقِ"
    },
    {
      "kind": "text",
      "ar": "وَكَلِمَتِكَ وَعَيْبَتِكَ وَعَيْنِكَ فِيْ أَرْضِكَ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَرَقِّبِ الْخَائِفِ، الْوَلِيِّ النَّاصِحِ"
    },
    {
      "kind": "text",
      "ar": "سَفِيْنَةِ النَّجَاةِ، وَعَلَمِ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَنُوْرِ أَبْصَارِ الْوَرٰي"
    },
    {
      "kind": "text",
      "ar": "وَخَيْرِ مَنْ تَقَمَّصَ وَارْتَدٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْوِتْرِ الْمَوْتُوْرِ، وَمُفَرِّجِ الْكَرْبِ"
    },
    {
      "kind": "text",
      "ar": "وَمُزِيْلِ الْهَمِّ، وَكَاشِفِ الْبَلْوٰي"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْهِ وَعَلٰي اٰبَائِهِ"
    },
    {
      "kind": "text",
      "ar": "الْاَئِمَّةِ الْهَادِيْنَ، وَالْقَادَةِ الْمَيَامِيْنِ"
    },
    {
      "kind": "text",
      "ar": "مَا طَلَعَتْ كَوَاكِبُ الْاَسْحَارِ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْرَقَتِ الْاَشْجَارُ، وَأَيْنَعَتِ الْاَثْمَارُ"
    },
    {
      "kind": "text",
      "ar": "وَاخْتَلَفَ اللَّيْلُ وَالنَّهَارُ، وَغَرَّدَتِ الْاَطْيَارُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ انْفَعْنَا بِحُبِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنَا فِيْ زُمْرَتِهٖ، وَتَحْتَ لِوَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهَ الْحَقِّ اٰمِيْنَ، يَا رَبَّ الْعَالَمِيْنَ۔"
    }
  ]
}