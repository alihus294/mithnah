{
  "id": "munajat-zakireen",
  "title": "۱۳۔ مناجات ذاكرين",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۳۔ مناجات ذاكرين",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ لَوْ لَا الْوَاجِبُ مِنْ قَبُوْلِ أَمْرِكَ لَنَزَّهْتُكَ عَنْ ذِكْرِيْ اِيَّاكَ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي أَنَّ ذِكْرِيْ لَكَ بِقَدْرِيْ لَا بِقَدْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَا عَسٰي أَنْ يَبْلُغَ مِقْدَارِيْ حَتّٰي أُجْعَلَ مَحَلًّا لِتَقْدِيْسِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ أَعْظَمِ النِّعَمِ عَلَيْنَا جَرَيَانُ ذِكْرِكَ عَلٰي أَلْسِنَتِنَا"
    },
    {
      "kind": "text",
      "ar": "وَاِذْنُكَ لَنَا بِدُعَائِكَ وَتَنْزِيْهِكَ وَتَسْبِيْحِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ فَأَلْهِمْنَا ذِكْرَكَ فِي الْخَلَاءِ وَالْمَلَاءِ وَاللَّيْلِ وَالنَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِعْلَانِ وَالْاِسْرَارِ وَفِي السَّرَّاءِ وَالضَّرَّاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاٰنِسْنَا بِالذِّكْرِ الْخَفِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَعْمِلْنَا بِالْعَمَلِ الزَّكِيِّ وَالسَّعْيِ الْمَرْضِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَجَازِنَا بِالْمِيْزَانِ الْوَفِيِّ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ بِكَ هَامَتِ الْقُلُوْبُ الْوَالِهَةُ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَعْرِفَتِكَ جُمِعَتِ الْعُقُوْلُ الْمُتَبَايِنَةُ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَطْمَئِنُّ الْقُلُوْبُ اِلَّا بِذِكْرَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَسْكُنُ النُّفُوْسُ اِلَّا عِنْدَ رُؤْيَاكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ الْمُسَبَّحُ فِيْ كُلِّ مَكَانٍ، وَالْمَعْبُوْدُ فِيْ كُلِّ زَمَانٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَوْجُوْدُ فِيْ كُلِّ أَوَانٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَدْعُوُّ بِكُلِّ لِسَانٍ، وَالْمُعَظَّمُ فِيْ كُلِّ جَنَانٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ مِنْ كُلِّ لَذَّةٍ بِغَيْرِ ذِكْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ رَاحَةٍ بِغَيْرِ أُنْسِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ سُرُوْرٍ بِغَيْرِ قُرْبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ شُغْلٍ الْحَقُّ بِغَيْرِ طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ أَنْتَ قُلْتَ وَقَوْلُكَ الْحَقُّ"
    },
    {
      "kind": "text",
      "ar": "يَا أَيُّهَا الَّذِيْنَ اٰمَنُوْا اذْكُرُوا اللهَ ذِكْرًا كَثِيْرًا وَسَبِّحُوْهُ بُكْرَةً وَأَصِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَقُلْتَ وَقَوْلُكَ الْحَقُّ فَاذْكُرُوْنِيْ أَذْكُرْكُمْ"
    },
    {
      "kind": "text",
      "ar": "فَأَمَرْتَنَا بِذِكْرِكَ وَوَعَدْتَنَا عَلَيْهِ أَنْ تَذْكُرَنَا"
    },
    {
      "kind": "text",
      "ar": "تَشْرِيْفًا لَنَا وَتَفْخِيْمًا وَاِعْظَامًا"
    },
    {
      "kind": "text",
      "ar": "وَهَا نَحْنُ ذَاكِرُوْكَ كَمَا أَمَرْتَنَا، فَأَنْجِزْ لَنَا مَا وَعَدْتَنَا"
    },
    {
      "kind": "text",
      "ar": "يَا ذَاكِرَ الذَّاكِرِيْنَ وَيَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}