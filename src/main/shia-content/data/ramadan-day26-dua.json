{
  "id": "ramadan-day26-dua",
  "title": "چهبيسويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "چهبيسويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ سَعْيِيْ فِيْهِ مَشْكُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَذنْبِيْ فِيْهِ مَغْفُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَعَمَلِيْ فِيْهِ مَقْبُوْلًا"
    },
    {
      "kind": "text",
      "ar": "وَعَيْبِيْ فِيْهِ مَسْتُوْرًا"
    },
    {
      "kind": "text",
      "ar": "يَا أَسْمَعَ السَّامِعِيْنَ۔"
    }
  ]
}