{
  "id": "munajat-shakeen",
  "title": "۲۔ مناجات شاكين",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۲۔ مناجات شاكين",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِلَيْكَ أَشْكُوْ نَفْسًا"
    },
    {
      "kind": "text",
      "ar": "بِالسُّوْءِ أَمَّارَةً، وَاِلَي الْخَطِيْئَةِ مُبَادِرَةً"
    },
    {
      "kind": "text",
      "ar": "وَبِمَعَاصِيْكَ مُوْلَعَةً، وَلِسَخَطِكَ مُتَعَرِّضَةً"
    },
    {
      "kind": "text",
      "ar": "تَسْلُكُ بِيْ مَسَالِكَ الْمَهَالِكِ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلُنِيْ عِنْدَكَ أَهْوَنَ هَالِكٍ"
    },
    {
      "kind": "text",
      "ar": "كَثِيْرَةَ الْعِلَلِ، طَوِيْلَةَ الْاَمَلِ"
    },
    {
      "kind": "text",
      "ar": "اِنْ مَسَّهَا الشَّرُّ تَجْزَعُ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ مَسَّهَا الْخَيْرُ تَمْنَعُ"
    },
    {
      "kind": "text",
      "ar": "مَيَّالَةً اِلَي اللَّعِبِ وَاللَّهْوِ"
    },
    {
      "kind": "text",
      "ar": "مَمْلُوْئَةً بِالْغَفْلَةِ وَالسَّهْوِ"
    },
    {
      "kind": "text",
      "ar": "تُسْرِعُ بِيْ اِلٰي الْحَوْبَةِ، وَتُسَوِّفُنِيْ بِالتَّوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ أَشْكُوْ اِلَيْكَ عَدُوًّا يُضِلُّنِيْ، وَشَيْطَانًا يُغْوِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "قَدْ مَلَاءَ بِالْوَسْوَاسِ صَدْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَحَاطَتْ هَوَاجِسُهٗ بِقَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "يُعَاضِدُ لِيَ الْهَوٰي، وَيُزَيِّنُ لِيْ حُبَّ الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "وَيَحُوْلُ بَيْنِيْ وَبَيْنَ الطَّاعَةِ وَالزُّلْفٰي"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِلَيْكَ أَشْكُوْ قَلْبًا قَاسِيًا مَعَ الْوَسْوَاسِ مُتَقَلِّبًا"
    },
    {
      "kind": "text",
      "ar": "وَبِالرَّيْنِ وَالطَّبْعِ مُتَلَبِّسًا"
    },
    {
      "kind": "text",
      "ar": "وَعَيْنًا عَنِ الْبُكَاءِ مِنْ خَوْفِكَ جَامِدَةً"
    },
    {
      "kind": "text",
      "ar": "وَاِلٰي مَا يَسُرُّهَا طَامِحَةً"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ لَا حَوْلَ لِيْ وَلَا قُوَّةَ اِلَّا بِقُدْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا نَجَاةَ لِيْ مِنْ مَكَارِهِ الدُّنْيَا اِلَّا بِعِصْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْأَلُكَ بِبَلَاغَةِ حِكْمَتِكَ، وَنَفَاذِ مَشِيْئَتِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ لَا تَجْعَلَنِيْ لِغَيْرِ جُوْدِكَ مُتَعَرِّضًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُصَيِّرَنِيْ لِلْفِتَنِ غَرَضًا"
    },
    {
      "kind": "text",
      "ar": "وَكُنْ لِيْ عَلَي الْأَعْدَاءِ نَاصِرًا"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْمَخَازِيْ وَالْعُيُوْبِ سَاتِرًا"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الْبَلَاءِ وَاقِيًا، وَعَنِ الْمَعَاصِيْ عَاصِمًا"
    },
    {
      "kind": "text",
      "ar": "بِرَأْفَتِكَ وَرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}