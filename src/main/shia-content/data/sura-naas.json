{
  "id": "sura-naas",
  "title": "سورۂ ناس",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ ناس",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "مَلِكِ النَّاسِۙ۝۲"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِ النَّاسِۙ۝۳"
    },
    {
      "kind": "text",
      "ar": "مِنْ شَرِّ الْوَسْوَاسِ١ۙ۬ الْخَنَّاسِ۪ۙ۝۴"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ۝۵"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْجِنَّةِ وَالنَّاسِ۠۝۶"
    }
  ]
}