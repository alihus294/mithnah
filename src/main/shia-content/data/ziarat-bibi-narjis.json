{
  "id": "ziarat-bibi-narjis",
  "title": "والدۂ امام مهدي كي زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "والدۂ امام مهدي كي زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي رَسُوْلِ اللهِ الصَّادِقِ الْاَمِيْنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَوْلَانَا أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْاَئِمَّةِ الطَّاهِرِيْنَ الْحُجَجِ الْمَيَامِيْنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي وَالِدَةِ الْاِمَامِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُوْدَعَةِ أَسْرَارَ الْمَلِكِ الْعَلَّامِ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَامِلَةِ لِاَشْرَفِ الْاَنَامِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الصِّدِّيْقَةُ الْمَرضِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا شَبِيْهَةَ أُمِّ مُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "وَابْنَةَ حَوَارِيِّ عِيْسٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا التَّقِيَّةُ النَّقِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الرَّضِيَّةُ الْمَرْضِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الْمَنْعُوْتَةُ فِي الْاِنْجِيْلِ"
    },
    {
      "kind": "text",
      "ar": "الْمَخْطُوْبَةُ مِنْ رُوْحِ اللهِ الْاَمِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ رَغِبَ فِيْ وُصْلَتِهَا مُحَمَّدٌ سَيِّدُ الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسْتَوْدَعَةُ أَسْرَارَ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ وَعَلٰي اٰبَائِكِ الْحَوَارِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ وَعَلٰي بَعْلِكِ وَوَلَدِكِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ وَعَلٰي رُوْحِكِ وَبَدَنِكِ الطَّاهِرِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكِ أَحْسَنْتِ الْكَفَالَةَ، وَأَدَّيْتِ الْاَمَانَةَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْتَهَدْتِ فِيْ مَرْضَاةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتِ فِيْ ذَاتِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَحَفِظْتِ سِرَّ اللهِ، وَحَمَلْتِ وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَبَالَغْتِ فِيْ حِفْظِ حُجَّةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَرَغِبْتِ فِيْ وُصْلَةِ أَبْنَاءِ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "عَارِفَةً بِحَقِّهِمْ، مُؤْمِنَةً بِصِدْقِهِمْ"
    },
    {
      "kind": "text",
      "ar": "مُعْتَرِفَةً بِمَنْزِلَتِهِمْ، مُسْتَبْصِرَةً بِأَمْرِهِمْ"
    },
    {
      "kind": "text",
      "ar": "مُشْفِقَةً عَلَيْهِمْ، مُؤْثِرَةً هَوَاهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكِ مَضَيْتِ عَلٰي بَصِيْرَةٍ مِنْ أَمْرِكِ"
    },
    {
      "kind": "text",
      "ar": "مُقْتَدِيَةً بِالصَّالِحِيْنَ، رَاضِيَةً مَرْضِيَّةً"
    },
    {
      "kind": "text",
      "ar": "تَقِيَّةً نَقِيَّةً زَكِيَّةً"
    },
    {
      "kind": "text",
      "ar": "فَرَضِيَ اللهُ عَنْكِ وَأَرْضَاكِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَ الْجَنَّةَ مَنْزِلَكِ وَمَأْوَاكِ"
    },
    {
      "kind": "text",
      "ar": "فَلَقَدْ أَوْلَاكِ مِنَ الْخَيْرَاتِ مَا أَوْلَاكِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطَاكِ مِنَ الشَّرَفِ مَا بِهٖ أَغْنَاكِ"
    },
    {
      "kind": "text",
      "ar": "فَهَنَّاكِ اللهُ بِمَا مَنَحَكِ مِنَ الْكَرَامَةِ وَأَمْرَاكِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِيَّاكَ اعْتَمَدْتُ، وَلِرِضَاكَ طَلَبْتُ"
    },
    {
      "kind": "text",
      "ar": "وَبِأَوْلِيَائِكَ اِلَيْكَ تَوَسَّلْتُ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي غُفْرَانِكَ وَحِلْمِكَ اتَّكَلْتُ"
    },
    {
      "kind": "text",
      "ar": "وَبِكَ اعْتَصَمْتُ، وَبِقَبْرِ أُمِّ وَلِيِّكَ لُذْتُ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَانْفَعْنِيْ بِزِيَارَتِهَا، وَثَبِّتْنِيْ عَلٰي مَحَبَّتِهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَحْرِمْنِيْ شَفَاعَتَهَا وَشَفَاعَةَ وَلَدِهَا"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ مُرَافَقَتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنِيْ مَعَهَا وَمَعَ وَلَدِهَا"
    },
    {
      "kind": "text",
      "ar": "كَمَا وَفَّقْتَنِيْ لِزِيَارَةِ وَلَدِهَا وَزِيَارَتِهَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَتَوَجَّهُ اِلَيْكَ بِالْاَئِمَّةِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَسَّلُ اِلَيْكَ بِالْحُجَجِ الْمَيَامِيْنِ مِنْ اٰلِ طٰهٰ وَيٰسٓ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ الطَّيِّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَنِيْ مِنَ الْمُطْمَئِنِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْفَائِزِيْنَ الْفَرِحِيْنَ الْمُسْتَبْشِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِمَّنْ قَبِلْتَ سَعْيَهٗ، وَيَسَّرْتَ أَمْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَكَشَفْتَ ضُرَّهٗ، وَاٰمَنْتَ خَوْفَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِحَقِّ مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْهُ اٰخِرَ الْعَهْدِ مِنْ زِيَارَتِيْ اِيَّاهَا"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِي الْعَوْدَ اِلَيْهَا أَبَدًا مَا أَبْقَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِذَا تَوَفَّيْتَنِيْ فَاحْشُرْنِيْ فِيْ زُمْرَتِهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَدْخِلْنِيْ فِيْ شَفَاعَةِ وَلَدِهَا وَشَفَاعَتِهَا"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لِيْ وَلِوَالِدَيَّ وَلِلْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْاٰخِرَةِ حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِنَا بِرَحْمَتِكَ عَذَابَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكُمْ يَا سَادَاتِيْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    }
  ]
}