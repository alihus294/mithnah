{
  "id": "hirz-imam-sajjad",
  "title": "حرز امام زين العابدين",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "حرز امام زين العابدين",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا أَسْمَعَ السَّامِعِيْنَ، يَا أَبْصَرَ النَّاظِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَسْرَعَ الْحَاسِبِيْنَ، يَا أَحْكَمَ الْحَاكِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا خَالِقَ الْمَخْلُوْقِيْنَ، يَا رَازِقَ الْمَرْزُوْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا نَاصِرَ الْمَنْصُوْرِيْنَ، يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا دَلِيْلَ الْمُتَحَيِّرِيْنَ، يَا غِيَاثَ الْمُسْتَغِيْثِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَغِثْنِيْ يَا مَالِكَ يَوْمِ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَعِيْنُ"
    },
    {
      "kind": "text",
      "ar": "يَا صَرِيْخَ الْمَكْرُوْبِيْنَ، يَا مُجِيْبَ دَعْوَةِ الْمُضْطَرِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ اللهُ رَبُّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "الْمَلِكُ الْحَقُّ الْمُبِيْنُ الْكِبْرِيَاءُ رِدَاؤُكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ الْمُصْطَفٰي"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي عَلِيٍّ الْمُرْتَضٰي وَفَاطِمَةَ الزَّهْرَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَخَدِيْجَةَ الْكُبْرٰي، وَالْحَسَنِ الْمُجْتَبٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْحُسَيْنِ الشَّهِيْدِ بِكَرْبَلَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيِّ بْنِ الْحُسَيْنِ زَيْنِ الْعَابِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمُحَمَّدِ بْنِ عَلِيٍّ الْبَاقِرِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعْفَرِ بْنِ مُحَمَّدٍ الصَّادِقِ"
    },
    {
      "kind": "text",
      "ar": "وَمُوْسَي بْنِ جَعْفَرٍ الْكَاظِمِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيِّ بْنِ مُوْسَي الرِّضَا"
    },
    {
      "kind": "text",
      "ar": "وَمُحَمَّدِ بْنِ عَلِيٍّ التَّقِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيِّ بْنِ مُحَمَّدٍ النَّقِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنِ الْعَسْكَرِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَالْحُجَّةِ الْقَائِمِ الْمَهْدِيِّ الْاِمَامِ المُنْتَظَرِ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْهِمْ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَالِ مَنْ وَالَاهُمْ، وَعَادِ مَنْ عَادَاهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْ مَنْ نَصَرَهُمْ، وَاخْذُلْ مَنْ خَذَلَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَنْ مَنْ ظَلَمَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَعَجِّلْ فَرَجَ اٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْ شِيْعَةَ اٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ رُؤْيَةَ قَائِمِ اٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ أَتْبَاعِهٖ وَأَشْيَاعِهٖ وَالرَّاضِيْنَ بِفِعْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}