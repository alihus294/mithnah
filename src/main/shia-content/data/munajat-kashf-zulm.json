{
  "id": "munajat-kashf-zulm",
  "title": "مناجات كشف ظلم",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مناجات كشف ظلم",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ ظُلْمَ عِبَادِكَ قَدْ تَمَكَّنَ فِيْ بِلَادِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَمَاتَ الْعَدْلَ وَقَطَعَ السُّبُلَ"
    },
    {
      "kind": "text",
      "ar": "وَمَحَقَ الْحَقَّ وَأَبْطَلَ الصِّدْقَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْفَي الْبِرَّ وَأَظْهَرَ الشَّرَّ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْمَدَ التَّقْوٰي وَأَزَالَ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَزَاحَ الْخَيْرَ وَأَثْبَتَ الضَّيْرَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْمَي الْفَسَادَ وَقَوَّي الْعِنَادَ"
    },
    {
      "kind": "text",
      "ar": "وَبَسَطَ الْجَوْرَ وَعَدَي الطَّوْرَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَارَبِّ لَا يَكْشِفُ ذٰلِكَ اِلَّا سُلْطَانُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُجِيْرُ مِنْهُ اِلَّا امْتِنَانُكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبِّ فَابْتُرِ الظُّلْمَ وَبُثَّ جِبَالَ الْغَشْمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْمِدْ سُوْقَ الْمُنْكَرِ وَأَعِزَّ مَنْ عَنْهُ يَنْزَجِرُ"
    },
    {
      "kind": "text",
      "ar": "وَاحْصُدْ شَأْفَةَ أَهْلِ الْجَوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْهُمُ الْحَوْرَ بَعْدَ الْكَوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَعَجِّلِ اَللّٰهُمَّ اِلَيْهِمُ الْبَيَاتَ وَأَنْزِلْ عَلَيْهِمُ الْمَثُلَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَأَمِتْ حَيَاةَ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "لِيُؤْمَنَ الْمَخُوْفُ وَيَسْكُنَ الْمَلْهُوْفُ"
    },
    {
      "kind": "text",
      "ar": "وَيَشْبَعَ الْجَائِعُ وَيُحْفَظَ الضَّائِعُ"
    },
    {
      "kind": "text",
      "ar": "وَيَأْوَي الطَّرِيْدُ وَيَعُوْدَ الشَّرِيْدُ"
    },
    {
      "kind": "text",
      "ar": "وَيُغْنَي الْفَقِيْرُ وَيُجَارَ الْمُسْتَجِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَيُوَقَّرَ الْكَبِيْرُ وَيُرْحَمَ الصَّغِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَيُعَزَّ الْمَظْلُوْمُ وَيُذَلَّ الظَّالِمُ وَيُفَرَّجَ الْمَغْمُوْمُ"
    },
    {
      "kind": "text",
      "ar": "وَتَنْفَرِجَ الْغَمَّاءُ وَتَسْكُنَ الدَّهْمَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَيَمُوْتَ الْاِخْتِلَافُ وَيَعْلُوَ الْعِلْمُ وَيَشْمُل السِّلْمُ"
    },
    {
      "kind": "text",
      "ar": "وَيُجْمَعَ الشَّتَاتُ وَيَقْوَي الْاِيْمَانُ وَيُتْلَي الْقُرْاٰنُ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الدَّيَّانُ الْمُنْعِمُ الْمَنَّانُ"
    }
  ]
}