{
  "id": "rajab-daily-duas",
  "title": "رجب ميں روزانه كي دعائيں",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "رجب ميں روزانه كي دعائيں",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يَمْلِكُ حَوَائِجَ السَّائِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَعْلَمُ ضَمِيْرَ الصَّامِتِيْنَ"
    },
    {
      "kind": "text",
      "ar": "لِكُلِّ مَسْأَلَةٍ مِنْكَ سَمْعٌ حَاضِرٌ وَجَوَابٌ عَتِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَمَوَاعِيْدُكَ الصَّادِقَةُ"
    },
    {
      "kind": "text",
      "ar": "وَأَيَادِيْكَ الْفَاضِلَةُ، وَرَحْمَتُكَ الْوَاسِعَةُ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَقْضِيَ حَوَائِجِيْ لِلدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "خَابَ الْوَافِدُوْنَ عَلٰي غَيْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَسِرَ الْمُتَعَرِّضُوْنَ اِلَّا لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَضَاعَ الْمُلِمُّوْنَ اِلَّا بِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْدَبَ الْمُنْتَجِعُوْنَ اِلَّا مَنِ انْتَجَعَ فَضْلَكَ"
    },
    {
      "kind": "text",
      "ar": "بَابُكَ مَفْتُوْحٌ لِلرَّاغِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَخَيْرُكَ مَبْذُوْلٌ لِلطَّالِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَفَضْلُكَ مُبَاحٌ لِلسَّائِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَنَيْلُكَ مُتَاحٌ لِلْاٰمِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَرِزْقُكَ مَبْسُوْطٌ لِمَنْ عَصَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَحِلْمُكَ مُعْتَرِضٌ لِمَنْ نَاوَاكَ"
    },
    {
      "kind": "text",
      "ar": "عَادَتُكَ الْاِحْسَانُ اِلَي الْمُسِيْئِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَسَبِيْلُكَ الْاِبْقَاءُ عَلَي الْمُعْتَدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاهْدِنِيْ هُدَي الْمُهْتَدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِي اجْتِهَادَ الْمُجْتَهِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْنِيْ مِنَ الْغَافِلِيْنَ الْمُبْعَدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لِيْ يَوْمَ الدِّيْنِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ صَبْرَ الشَّاكِرِيْنَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَمَلَ الْخَائِفِيْنَ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَيَقِيْنَ الْعَابِدِيْنَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الْعَلِيُّ الْعَظِيْمُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا عَبْدُكَ الْبَائِسُ الْفَقِيْرُ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ الْغَنِيُّ الْحَمِيْدُ، وَأَنَا الْعَبْدُ الذَّلِيْلُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَامْنُنْ بِغِنَاكَ عَلٰي فَقْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَبِحِلْمِكَ عَلٰي جَهْلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَبِقُوَّتِكَ عَلٰي ضَعْفِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا قَوِيُّ يَا عَزِيْزُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهِ الْاَوْصِيَاءِ الْمَرْضِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِنِيْ مَا أَهَمَّنِيْ مِنْ أَمْرِ الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا ذَا الْمِنَنِ السَّابِغَةِ، وَالْاٰلَاءِ الْوَازِعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّحْمَةِ الْوَاسِعَةِ، وَالْقُدْرَةِ الْجَامِعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالنِّعَمِ الْجَسِيْمَةِ، وَالْمَوَاهِبِ الْعَظِيْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَيَادِي الْجَمِيْلَةِ، وَالْعَطَايَا الْجَزِيْلَةِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يُنْعَتُ بِتَمْثِيْلٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُمَثَّلُ بِنَظِيْرٍ، وَلَا يُغْلَبُ بِظَهِيْرٍ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ خَلَقَ فَرَزَقَ، وَأَلْهَمَ فَأَنْطَقَ"
    },
    {
      "kind": "text",
      "ar": "وَابْتَدَعَ فَشَرَعَ، وَعَلَا فَارْتَفَعَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدَّرَ فَأَحْسَنَ، وَصَوَّرَ فَأَتْقَنَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْتَجَّ فَأَبْلَغَ، وَأَنْعَمَ فَأَسْبَغَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطٰي فَأَجْزَلَ، وَمَنَحَ فَأَفْضَلَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ سَمَا فِي الْعِزِّ فَفَاتَ نَوَاظِرَ الْاَبْصَارِ"
    },
    {
      "kind": "text",
      "ar": "وَدَنَا فِي اللُّطْفِ فَجَازَ هَوَاجِسَ الْاَفْكَارِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ تَوَحَّدَ بِالْمُلْكِ"
    },
    {
      "kind": "text",
      "ar": "فَلَا نِدَّ لَهٗ فِيْ مَلَكُوْتِ سُلْطَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتَفَرَّدَ بِالْاٰلَاءِ وَالْكِبْرِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "فَلَا ضِدَّ لَهٗ فِيْ جَبَرُوْتِ شَأْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ حَارَتْ فِيْ كِبْرِيَاءِ هَيْبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "دَقَائِقُ لَطَائِفِ الْاَوْهَامِ"
    },
    {
      "kind": "text",
      "ar": "وَانْحَسَرَتْ دُوْنَ اِدْرَاكِ عَظَمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "خَطَائِفُ أَبْصَارِ الْاَنَامِ۔"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ عَنَتِ الْوُجُوْهُ لِهَيْبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَخَضَعَتِ الرِّقَابُ لِعَظَمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَوَجِلَتِ الْقُلُوْبُ مِنْ خِيْفَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِهٰذِهِ الْمِدْحَةِ الَّتِيْ لَا تَنْبَغِيْ اِلَّا لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَا وَأَيْتَ بِهٖ عَلٰي نَفْسِكَ لِدَاعِيْكَ مِنَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَا ضَمِنْتَ الْاِجَابَةَ فِيْهِ عَلٰي نَفْسِكَ لِلدَّاعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَسْمَعَ السَّامِعِيْنَ، وَأَبْصَرَ النَّاظِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْرَعَ الْحَاسِبِيْنَ، يَا ذَا الْقُوَّةِ الْمَتِيْنَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ خَاتَمِ النَّبِيِّيْنَ وَعَلٰي أَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاقْسِمْ لِيْ فِيْ شَهْرِنَا هٰذَا خَيْرَ مَا قَسَمْتَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْتِمْ لِيْ فِيْ قَضَائِكَ خَيْرَ مَا حَتَمْتَ"
    },
    {
      "kind": "text",
      "ar": "وَاخْتِمْ لِيْ بِالسَّعَادَةِ فِيْمَنْ خَتَمْتَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْيِنِيْ مَا أَحْيَيْتَنِيْ مَوْفُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَمِتْنِيْ مَسْرُوْرًا وَمَغْفُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَتَوَلَّ أَنْتَ نَجَاتِيْ مِنْ مُسَائَلَةِ الْبَرْزَخِ"
    },
    {
      "kind": "text",
      "ar": "وَادْرَأْ عَنِّيْ مُنكَرًا وَنَكِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَرِ عَيْنِيْ مُبَشِّرًا وَبَشِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لِيْ اِلٰي رِضْوَانِكَ وَجِنَانِكَ مَصِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَعَيْشًا قَرِيْرًا، وَمُلْكًا كَبِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ كَثِيْرًا۔"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِمَعَانِيْ جَمِيْعِ"
    },
    {
      "kind": "text",
      "ar": "مَا يَدْعُوْكَ بِهٖ وُلَاةُ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "الْمَأْمُوْنُوْنَ عَلٰي سِرِّكَ، الْمُسْتَبْشِرُوْنَ بأَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "الْوَاصِفُوْنَ لِقُدْرَتِكَ، الْمُعْلِنُوْنَ لِعَظَمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِمَا نَطَقَ فِيْهِمْ مِنْ مَشِيْئَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَجَعَلْتَهُمْ مَعَادِنَ لِكَلِمَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْكَانًا لِتَوْحِيْدِكَ وَاٰيَاتِكَ وَمَقَامَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ لَا تَعْطِيْلَ لَهَا فِيْ كُلِّ مَكَانٍ"
    },
    {
      "kind": "text",
      "ar": "يَعْرِفُكَ بِهَا مَنْ عَرَفَكَ"
    },
    {
      "kind": "text",
      "ar": "لَا فَرْقَ بَيْنَكَ وَبَيْنَهَا"
    },
    {
      "kind": "text",
      "ar": "اِلَّا أَنَّهُمْ عِبَادُكَ وَخَلْقُكَ"
    },
    {
      "kind": "text",
      "ar": "فَتْقُهَا وَرَتْقُهَا بِيَدِكَ"
    },
    {
      "kind": "text",
      "ar": "بَدْؤُهَا مِنْكَ وَعَوْدُهَا اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "أَعْضَادٌ وَأَشْهَادٌ وَمُنَاةٌ وَأَذْوَادٌ وَحَفَظَةٌ وَرُوَّادٌ"
    },
    {
      "kind": "text",
      "ar": "فَبِهِمْ مَلَأَتَ سَمَائَكَ وَأَرْضَكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي ظَهَرَ أَنْ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "فَبِذٰلِكَ أَسْأَلُكَ وَبِمَوَاقِعِ الْعِزِّ مِنْ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَقَامَاتِكَ وَعَلَامَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَزِيْدَنِيْ اِيْمَانًا وَتَثْبِيْتًا"
    },
    {
      "kind": "text",
      "ar": "يَا بَاطِنًا فِيْ ظُهُوْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَظَاهِرًا فِيْ بُطُوْنِهٖ وَمَكْنُوْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا مُفَرِّقًا بَيْنَ النُّوْرِ وَالدَّيجُوْرِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْصُوْفًا بِغَيْرِ كُنْهٍ"
    },
    {
      "kind": "text",
      "ar": "وَمَعْرُوْفًا بِغَيْرِ شِبْهٍ"
    },
    {
      "kind": "text",
      "ar": "حَادَّ كُلِّ مَحْدُوْدٍ"
    },
    {
      "kind": "text",
      "ar": "وَشَاهِدَ كُلِّ مَشْهُوْدٍ"
    },
    {
      "kind": "text",
      "ar": "وَمُوْجِدَ كُلِّ مَوْجُوْدٍ"
    },
    {
      "kind": "text",
      "ar": "وَمُحْصِيَ كُلِّ مَعْدُوْدٍ"
    },
    {
      "kind": "text",
      "ar": "وَفَاقِدَ كُلِّ مَفْقُوْدٍ"
    },
    {
      "kind": "text",
      "ar": "لَيْسَ دُوْنَكَ مِنْ مَعْبُوْدٍ أَهْلَ الْكِبْرِيَاءِ وَالْجُوْدِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يُكَيَّفُ بِكَيْفٍ، وَلَا يُؤَيَّنُ بِأَيْنٍ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحْتَجِبًا عَنْ كُلِّ عَيْنٍ"
    },
    {
      "kind": "text",
      "ar": "يَا دَيْمُوْمُ يَا قَيُّوْمُ وَعَالِمَ كُلِّ مَعْلُوْمٍ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي عِبَادِكَ الْمُنْتَجَبِيْنَ، وَبَشَرِكَ الْمُحْتَجِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمَلَائِكَتِكَ الْمُقَرَّبِيْنَ، وَالْبُهْمِ الصَّافِّيْنَ الْحَافِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ لَنَا فِيْ شَهْرِنَا هٰذَا الْمُرَجَّبِ الْمُكَرَّمِ"
    },
    {
      "kind": "text",
      "ar": "وَمَا بَعْدَهٗ مِنَ الْاَشْهُرِ الْحُرُمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْبِغْ عَلَيْنَا فِيْهِ النِّعَمَ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْزِلْ لَنَا فِيْهِ الْقِسَمَ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْرِرْ لَنَا فِيْهِ الْقَسَمَ"
    },
    {
      "kind": "text",
      "ar": "بِاسْمِكَ الْاَعْظَمِ الْاَعْظَمِ الْاَجَلِّ الْاَكْرَمِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ وَضَعْتَهٗ عَلَي النَّهَارِ فَأَضَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي اللَّيْلِ فَأَظْلَمَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لَنَا مَا تَعْلَمُ مِنَّا وَمَا لَا نَعْلَمُ"
    },
    {
      "kind": "text",
      "ar": "وَاعْصِمْنَا مِنَ الذُّنُوْبِ خَيْرَ الْعِصَمِ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِنَا كَوَافِيَ قَدَرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَامْنُنْ عَلَيْنَا بِحُسْنِ نَظَرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَكِلْنَا اِلٰي غَيْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَمْنَعْنَا مِنْ خَيْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ لَنَا فِيْمَا كَتَبْتَهٗ لَنَا مِنْ أَعْمَارِنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَصْلِحْ لَنَا خَبِيْئَةَ أَسْرَارِنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنَا مِنْكَ الْاَمَانَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَعْمِلْنَا بِحُسْنِ الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْنَا شَهْرَ الصِّيَامِ"
    },
    {
      "kind": "text",
      "ar": "وَمَا بَعْدَهٗ مِنَ الْاَيَّامِ وَالْاَعْوَامِ"
    },
    {
      "kind": "text",
      "ar": "يَا ذَا الْجَلَالِ وَالْاِكْرَامِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِالْمَوْلُوْدَيْنِ فِيْ رَجَبٍ"
    },
    {
      "kind": "text",
      "ar": "مُحَمَّدِ بْنِ عَلِيٍّ الثَّانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَابْنِهٖ عَلِيِّ بْنِ مُحَمَّدٍ الْمُنْتَجَبِ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَقَرَّبُ بِهِمَا اِلَيْكَ خَيْرَ الْقُرَبِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ اِلَيْهِ الْمَعْرُوْفُ طُلِبَ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْمَا لَدَيْهِ رُغِبَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ سُؤَالَ مُقْتَرِفٍ مُذْنِبٍ"
    },
    {
      "kind": "text",
      "ar": "قَدْ أَوْبَقَتْهٗ ذُنُوْبُهٗ، وَأَوْثَقَتْهٗ عُيُوْبُهٗ"
    },
    {
      "kind": "text",
      "ar": "فَطَالَ عَلَي الْخَطَايَا دُؤُوْبُهٗ وَمِنَ الرَّزَايَا خُطُوْبُهٗ"
    },
    {
      "kind": "text",
      "ar": "يَسْأَلُكَ التَّوْبَةَ وَحُسْنَ الْاَوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالنُّزُوْعَ عَنِ الْحَوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ النَّارِ فَكَاكَ رَقَبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَفْوَ عَمَّا فِيْ رِبْقَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَأَنْتَ مَوْلَايَ أَعْظَمُ أَمَلِهٖ وَثِقَتِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَسْأَلُكَ بِمَسَائِلِكَ الشَّرِيْفَةِ"
    },
    {
      "kind": "text",
      "ar": "وَوَسَائِلِكَ الْمُنِيْفَةِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَتَغَمَّدَنِيْ فِيْ هٰذَا الشَّهْرِ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَةٍ مِنْكَ وَاسِعَةٍ وَنِعْمَةٍ وَازِعَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَنَفْسٍ بِمَا رَزَقْتَهَا قَانِعَةٍ"
    },
    {
      "kind": "text",
      "ar": "اِلٰي نُزُوْلِ الْحَافِرَةِ، وَمَحَلِّ الْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمَا هِيَ اِلَيْهِ صَائِرَةٌ۔"
    }
  ]
}