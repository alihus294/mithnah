{
  "id": "munajat-isteaza",
  "title": "مناجات استعاذه",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مناجات استعاذه",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَعُوْذُ بِكَ مِنْ مُلِمَّاتِ نَوَازِلِ الْبَلَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْوَالِ عَظَائِمِ الضَّرَّاءِ"
    },
    {
      "kind": "text",
      "ar": "فَأَعِذْنِيْ رَبِّ مِنْ صَرْعَةِ الْبَأْسَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاحْجُبْنِيْ مِنْ سَطَوَاتِ الْبَلَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَنَجِّنِيْ مِنْ مُفَاجَاةِ النِّقَمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَجِرْنِيْ مِنْ زَوَالِ النِّعَمِ وَمِنْ زَلَلِ الْقَدَمِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ اَللّٰهُمَّ فِيْ حِيَاطَةِ عِزِّكَ وَحِفَاظِ حِرْزِكَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ مُبَاغَتَةِ الدَّوَائِرِ وَمُعَاجَلَةِ الْبَوَادِرِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبِّ وَأَرْضَ الْبَلَاءِ فَاخْسِفْهَا"
    },
    {
      "kind": "text",
      "ar": "وَعَرْصَةَ الْمِحَنِ فَارْجُفْهَا"
    },
    {
      "kind": "text",
      "ar": "وَشَمْسَ النَّوَائِبِ فَاكْسِفْهَا"
    },
    {
      "kind": "text",
      "ar": "وَجِبَالَ السُّوْءِ فَانْسِفْهَا"
    },
    {
      "kind": "text",
      "ar": "وَكُرَبَ الدَّهْرِ فَاكْشِفْهَا"
    },
    {
      "kind": "text",
      "ar": "وَعَوَائِقَ الْاُمُوْرِ فَاصْرِفْهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَوْرِدْنِيْ حِيَاضَ السَّلَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاحْمِلْنِيْ عَلٰي مَطَايَا الْكَرَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاصْحَبْنِيْ بِاِقَالَةِ الْعَثْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاشْمَلْنِيْ بِسَتْرِ الْعَوْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَجُدْ عَلَيَّ يَارَبِّ بِاٰلَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَكَشْفِ بَلَائِكَ وَدَفْعِ ضَرَّائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَادْفَعْ عَنِّيْ كَلَاكِلَ عَذَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاصْرِفْ عَنِّيْ أَلِيْمَ عِقَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِذْنِيْ مِنْ بَوَائِقِ الدُّهُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْقِذْنِيْ مِنْ سُوْءِ عَوَاقِبِ الْاُمُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَاحْرُسْنِيْ مِنْ جَمِيْعِ الْمَحْذُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَاصْدَعْ صَفَاةَ الْبَلَاءِ عَنْ أَمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاشْلُلْ يَدَهُ عَنِّيْ مَدٰي عُمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ الرَّبُّ الْمَجِيْدُ، الْمُبْدِئُ الْمُعِيْدُ، الْفَعَّالُ لِمَا تُرِيْدُ"
    }
  ]
}