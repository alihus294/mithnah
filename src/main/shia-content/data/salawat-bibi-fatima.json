{
  "id": "salawat-bibi-fatima",
  "title": "حضرت فاطمه زهرا پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "حضرت فاطمه زهرا پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّهُمَّ صَلِّ عَلَي الصِّدِّيْقَةِ فَاطِمَةَ الزَّكِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "حَبِيْبَةِ حَبِيْبِكَ وَنَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَأُمِّ أَحِبَّائِكَ وَأَصْفِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّتِي انْتَجَبْتَهَا وَفَضَّلْتَهَا وَاخْتَرْتَهَا عَلٰي نِسَاءِ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ كُنِ الطَّالِبَ لَهَا مِمَّنْ ظَلَمَهَا وَاسْتَخَفَّ بِحَقِّهَا"
    },
    {
      "kind": "text",
      "ar": "وَكُنِ الثَّائِرَ اَللّٰهُمَّ بِدَمِ أَوْلَادِهَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَكَمَا جَعَلْتَهَا أُمَّ أَئِمَّةِ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَحَلِيْلَةَ صَاحِبِ الِلَّوَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَالْكَرِيْمَةَ عِنْدَ الْمَلَاِ الْاَعْلٰي"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهَا وَعَلٰي أُمِّهَا"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً تُكْرِمُ بِهَا وَجْهَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَتُقِرُّ بِهَا أَعْيُنَ ذُرِّيَّتِهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَبْلِغْهُمْ عَنِّيْ فِيْ هٰذِهِ السَّاعَةِ أَفْضَلَ التَّحِيَّةِ وَالسَّلَامِ۔"
    }
  ]
}