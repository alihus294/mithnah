{
  "id": "ziarat-hamza-uhud",
  "title": "زيارت حضرت حمزه احد ميں",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت حضرت حمزه احد ميں",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا عَمَّ رَسُوْلِ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا خَيْرَ الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَسَدَ اللهِ وَأَسَدَ رَسُوْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ جَاهَدْتَ فِي اللهِ عَزَّ وَجَلَّ"
    },
    {
      "kind": "text",
      "ar": "وَجُدْتَ بِنَفْسِكَ، وَنَصَحْتَ رَسُوْلَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَكُنْتَ فِيْمَا عِنْدَ اللهِ سُبْحَانَهٗ رَاغِبًا"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتَ وَأُمِّيْ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ مُتَقَرِّبًا اِلَي اللهِ عَزَّ وَجَلَّ بِزِيَارَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُتَقَرِّبًا اِلٰي رَسُوْلِ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ بِذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "رَاغِبًا اِلَيْكَ فِي الشَّفَاعَةِ"
    },
    {
      "kind": "text",
      "ar": "أَبْتَغِْيْ بِزِيَارَتِكَ خَلَاصَ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "مُتَعَوِّذًا بِكَ مِنْ نَارٍ اسْتَحَقَّهَا مِثْلِيْ"
    },
    {
      "kind": "text",
      "ar": "بِمَا جَنَيْتُ عَلٰي نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "هَارِبًا مِنْ ذُنُوْبِيَ الَّتِي احْتَطَبْتُهَا عَلٰي ظَهْرِيْ"
    },
    {
      "kind": "text",
      "ar": "فَزِعًا اِلَيْكَ رَجَاءَ رَحْمَةِ رَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ مِنْ شُقَّةٍ بَعِيْدَةٍ"
    },
    {
      "kind": "text",
      "ar": "طَالِبًا فَكَاكَ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ أَوْقَرَتْ ظَهْرِيْ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَيْتُ مَا أَسْخَطَ رَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ أَجِدْ أَحَدًا أَفْزَعُ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "خَيْرًا لِيْ مِنْكُمْ أَهْلَ بَيْتِ الرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "فَكُنْ لِيْ شَفِيْعًا يَوْمَ فَقْرِيْ وَحَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ سِرْتُ اِلَيْكَ مَحْزُوْنًا، وَأَتَيْتُكَ مَكْرُوْبًا"
    },
    {
      "kind": "text",
      "ar": "وَسَكَبْتُ عَبْرَتِيْ عِنْدَكَ بَاكِيًا"
    },
    {
      "kind": "text",
      "ar": "وَصِرْتُ اِلَيْكَ مُفْرَدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ مِمَّنْ أَمَرَنِيَ اللهُ بِصِلَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحَثَّنِيْ عَلٰي بِرِّهٖ، وَدَلَّنِيْ عَلٰي فَضْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَهَدَانِيْ لِحُبِّهٖ، وَرَغَّبَنِيْ فِي الْوِفَادَةِ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْهَمَنِيْ طَلَبَ الْحَوَائِجِ عِنْدَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَنْتُمْ أَهْلُ بَيْتٍ لَا يَشْقٰي مَنْ تَوَلَّاكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَخِيْبُ مَنْ أَتَاكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَخْسَرُ مَنْ يَهْوَاكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَسْعَدُ مَنْ عَادَاكُمْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ تَعَرَّضْتُ لِرَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "بِلُزُوْمِيْ لِقَبْرِ عَمِّ نَبِيِّكَ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "لِيُجِيْرَنِيْ مِنْ نِقْمَتِكَ وَسَخَطِكَ وَمَقْتِكَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ يَوْمٍ تَكْثُرُ فِيْهِ الْاَصْوَاتُ"
    },
    {
      "kind": "text",
      "ar": "وَتُشْغَلُ كُلُّ نَفْسٍ بِمَا قَدَّمَتْ"
    },
    {
      "kind": "text",
      "ar": "وَتُجَادِلُ عَنْ نَفْسِهَا"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ تَرْحَمْنِي الْيَوْمَ فَلَا خَوْفٌ عَلَيَّ وَلَا حُزْنٌ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ تُعَاقِبْ فَمَوْلًى لَهُ الْقُدْرَةُ عَلٰي عَبْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخَيِّبْنِيْ بَعْدَ الْيَوْمِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَصْرِفْنِيْ بِغَيْرِ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ لَصِقْتُ بِقَبْرِ عَمِّ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَقَرَّبْتُ بِهٖ اِلَيْكَ ابْتِغَاءَ مَرْضَاتِكَ، وَرَجَاءَ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَتَقَبَّلْ مِنِّيْ، وَعُدْ بِحِلْمِكَ عَلٰي جَهْلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَبِرَأْفَتِكَ عَلٰي جِنَايَةِ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ عَظُمْ جُرْمِيْ، وَمَا أَخَافُ أَنْ تَظْلِمَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلٰكِنْ أَخَافُ سُوْءَ الْحِسَابِ"
    },
    {
      "kind": "text",
      "ar": "فَانْظُرِ الْيَوْمَ تَقَلُّبِيْ عَلٰي قَبْرِ عَمِّ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "فَبِهِمَا فُكَّنِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخَيِّبْ سَعْيِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَهُوْنَنَّ عَلَيْكَ ابْتِهَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَحْجُبَنَّ عَنْكَ صَوْتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَقْلِبْنِيْ بِغَيْرِ حَوَائِجِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا غِيَاثَ كُلِّ مَكْرُوْبٍ وَمَحْزُوْنٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مُفَرِّجًا عَنِ الْمَلْهُوْفِ الْحَيْرَانِ الْغَرِيْقِ الْمُشْرِفِ عَلَي الْهَلَكَةِ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَانْظُرْ اِلَيَّ نَظْرَةً لَا أَشْقٰي بَعْدَهَا أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْ تَضَرُّعِيْ وَعَبْرَتِيْ وَانْفِرَادِيْ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ رَجَوْتُ رِضَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَحَرَّيْتُ الْخَيْرَ الَّذِيْ لَا يُعْطِيْهِ أَحَدٌ سِوَاكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَرُدَّ أَمَلِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنْ تُعَاقِبْ"
    },
    {
      "kind": "text",
      "ar": "فَمَوْلًى لَهُ الْقُدْرَةُ عَلٰي عَبْدِهٖ وَجَزَائِهٖ بِسُوْءِ فِعْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَلَا أَخِيْبَنَّ الْيَوْمَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَصْرِفْنِيْ بِغَيْرِ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخَيِّبَنَّ شُخُوْصِيْ وَوِفَادَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ أَنْفَدْتُ نَفَقَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَتْعَبْتُ بَدَنِيْ، وَقَطَعْتُ الْمَفَازَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَخَلَّفْتُ الْاَهْلَ وَالْمَالَ وَمَا خَوَّلْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاٰثَرْتُ مَا عِنْدَكَ عَلٰي نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلُذْتُ بِقَبْرِ عَمِّ نَبِيِّكَ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتَقَرَّبْتُ بِهِ ابْتِغَاءَ مَرْضَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَعُدْ بِحِلْمِكَ عَلٰي جَهْلِيْ، وَبِرَأْفَتِكَ عَلٰي ذَنْبِيْ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ عَظُمَ جُرْمِيْ، بِرَحْمَتِكَ يَا كَرِيْمُ يَا كَرِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "اِذَا مَاتَ يُوْمًا مَيِّتٌ قَلَّ ذِكْرُهٗ، وَذِكْرُ أَبِيْ مُذْ مَاتَ وَاللهِ اَكْثَرُ"
    }
  ]
}