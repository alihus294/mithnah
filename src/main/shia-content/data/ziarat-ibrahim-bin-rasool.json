{
  "id": "ziarat-ibrahim-bin-rasool",
  "title": "زيارت ابراهيم بن حضرت رسول الله",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت ابراهيم بن حضرت رسول الله",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي نَبِيِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي حَبِيْبِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَفِيِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي نَجِيِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُحَمَّدِ بْنِ عَبْدِ اللهِ سَيِّدِ الْاَنْبِيَاءِ وَخَاتَمِ الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَخِيَرَةِ اللهِ مِنْ خَلْقِهٖ فِيْ أَرْضِهٖ وَسَمَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي جَمِيْعِ أَنْبِيَائِهٖ وَرُسُلِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الشُّهَدَاءِ وَالسُّعَدَاءِ وَالصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْنَا وَعَلٰي عِبَادِ اللهِ الصَّالِحِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيكِ أَيَّتُهَا الرُّوْحُ الزَّاكِيَةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا النَّفْسُ الشَّرِيْفَةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا السُّلَالَةُ الطَّاهِرَةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا النَّسَمَةُ الزَّاكِيَةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ خَيْرِ الْوَرٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ النَّبِيِّ الْمُجْتَبٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الْمَبْعُوْثِ اِلٰي كَافَّةِ الْوَرٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الْبَشِيْرِ النَّذِيْرِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ السِّرَاجِ الْمُنِيْرِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الْمُؤَيَّدِ بِالْقُرْاٰنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الْمُرْسَلِ اِلَي الْاِنْسِ وَالْجَانِّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ صَاحِبِ الرَّايَةِ وَالْعَلَامَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الشَّفِيْعِ يَوْمَ الْقِيَامَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ مَنْ حَبَاهُ اللهُ بِالْكَرَامَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدِ اخْتَارَ اللهُ لَكَ دَارَ اِنْعَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "قَبْلَ أَنْ يَكْتُبَ عَلَيْكَ أَحْكَامَهٗ أَوْ يُكَلِّفَكَ حَلَالَهُ وَحَرَامَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَنَقَلَكَ اِلَيْهِ طَيِّبًا زَاكِيًا مَرْضِيًّا"
    },
    {
      "kind": "text",
      "ar": "طَاهِرًا مِنْ كُلِّ نَجَسٍ، مُقَدَّسًا مِنْ كُلِّ دَنَسٍ"
    },
    {
      "kind": "text",
      "ar": "وَبَوَّأَكَ جَنَّةَ الْمَأْوٰي"
    },
    {
      "kind": "text",
      "ar": "وَرَفَعَكَ اِلَي الدَّرَجَاتِ الْعُلٰي"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلَيْكَ صَلَاةً تَقَرُّبِهَا عَيْنُ رَسُوْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتُبَلِّغُهٌ أَكْبَرَ مَأْمُوْلِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ أَفْضَلَ صَلَوَاتِكَ وَأَزْكَاهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْمٰي بَرَكَاتِكَ وَأَوْفَاهَا"
    },
    {
      "kind": "text",
      "ar": "عَلٰي رَسُوْلِكَ وَنَبِيِّكَ وَخِيَرَتِكَ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "مُحَمَّدٍ خَاتَمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَنْ نَسَلَ مِنْ أَوْلَادِهِ الطَّيِّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَنْ خَلَّفَ مِنْ عِتْرَتِهِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِحَقِّ مُحَمَّدٍ صَفِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِبْرَاهِيْمَ نَجْلِ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَجْعَلَ سَعْيِيْ بِهِمْ مَشْكُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَذَنْبِيْ بِهِمْ مَغْفُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَحَيَاتِيْ بِهِمْ سَعِيْدَةً"
    },
    {
      "kind": "text",
      "ar": "وَعَاقِبَتِيْ بِهِمْ حَمِيْدَةً"
    },
    {
      "kind": "text",
      "ar": "وَحَوَائِجِيْ بِهِمْ مَقْضِيَّةً"
    },
    {
      "kind": "text",
      "ar": "وَأَفْعَالِيْ بِهِمْ مَرْضِيَّةً"
    },
    {
      "kind": "text",
      "ar": "وَأُمُوْرِيْ بِهِمْ مَسْعُوْدَةً"
    },
    {
      "kind": "text",
      "ar": "وَشُؤُوْنِيْ بِهِمْ مَحْمُوْدَةً۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَحْسِنْ لِيَ التَّوْفِيْقَ"
    },
    {
      "kind": "text",
      "ar": "وَنَفِّسْ عَنِّيْ كُلَّ هَمٍّ وَضِيْقٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ جَنِّبْنِيْ عِقَابَكَ، وَامْنَحْنِيْ ثَوَابَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْكِنِّيْ جِنَانَكَ، وَارْزُقْنِيْ رِضْوَانَكَ وَأَمَانَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْرِكْ لِيْ فِيْ صَالِحِ دُعَاِئي وَالِدَيَّ وَوُلْدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَجَمِيْعَ الْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ الْاَحْيَاءَ مِنْهُمْ وَالْاَمْوَاتِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ وَلِيُّ الْبَاقِيَاتِ الصَّالِحَاتِ"
    },
    {
      "kind": "text",
      "ar": "اٰمِيْنَ رَبَّ الْعَالَمِيْنَ۔"
    }
  ]
}