{
  "id": "ramadan-nights-common2",
  "title": "راتوں كي ديگر دعائيں",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "راتوں كي ديگر دعائيں",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِرَحْمَتِكَ فِي الصَّالِحِيْنَ فَأَدْخِلْنَا"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ عِلِّيِّيْنَ فَارْفَعْنَا"
    },
    {
      "kind": "text",
      "ar": "وَبِكَأْسٍ مِنْ مَعِيْنٍ مِنْ عَيْنٍ سَلْسَبِيْلٍ فَاسْقِنَا"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الْحُوْرِ الْعِيْنِ بِرَحْمَتِكَ فَزَوِّجْنَا"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الْوِلْدَانِ الْمُخَلَّدِيْنَ كَأَنَّهُمْ لُؤْلُؤٌ مَكْنُوْنٌ فَأَخْدِمْنَا"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ ثِمَارِ الْجَنَّةِ وَلُحُوْمِ الطَّيْرِ فَأَطْعِمْنَا"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ ثِيَابِ السُّنْدُسِ وَالْحَرِيْرِ وَالْاِسْتَبْرَقِ فَأَلْبِسْنَا"
    },
    {
      "kind": "text",
      "ar": "وَلَيْلَةَ الْقَدْرِ وَحَجَّ بَيْتِكَ الْحَرَامِ"
    },
    {
      "kind": "text",
      "ar": "وَقَتْلًا فِيْ سَبِيْلِكَ فَوَفِّقْ لَنَا"
    },
    {
      "kind": "text",
      "ar": "وَصَالِحَ الدُّعَاءِ وَالْمَسْأَلَةِ فَاسْتَجِبْ لَنَا"
    },
    {
      "kind": "text",
      "ar": "وَاِذَا جَمَعْتَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ يَوْمَ الْقِيَامَةِ فَارْحَمْنَا"
    },
    {
      "kind": "text",
      "ar": "وَبَرَائَةً مِنَ النَّارِ فَاكْتُبْ لَنَا"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ جَهَنَّمَ فَلَا تَغُلَّنَا"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ عَذَابِكَ وَهَوَانِكَ فَلَا تَبْتَلِنَا"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الزَّقُّوْمِ وَالضَّرِيْعِ فَلَا تُطْعِمْنَا"
    },
    {
      "kind": "text",
      "ar": "وَمَعَ الشَّيَاطِيْنِ فَلَا تَجْعَلْنَا"
    },
    {
      "kind": "text",
      "ar": "وَفِي النَّارِ عَلٰي وُجُوْهِنَا فَلَا تَكْبُبْنَا"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ ثِيَابِ النَّارِ وَسَرَابِيْلِ الْقَطِرَانِ فَلَا تُلْبِسْنَا"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ سُوْءٍ يَا لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "بِحَقِّ لَا اِلٰهَ اِلَّا أَنْتَ فَنَجِّنَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ أَنْ تَجْعَلَ فِيْمَا تَقْضِيْ وَتُقَدِّرُ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْاَمْرِ الْمَحْتُوْمِ فِي الْاَمْرِ الْحَكِيْمِ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْقَضَاءِ الَّذِيْ لَا يُرَدُّ وَلَا يُبَدَّلُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَكْتُبَنِيْ مِنْ حُجَّاجِ بَيْتِكَ الْحَرَامِ"
    },
    {
      "kind": "text",
      "ar": "الْمَبْرُوْرِ حَجُّهُمُ، الْمَشْكُوْرِ سَعْيُهُمُ"
    },
    {
      "kind": "text",
      "ar": "الْمَغْفُوْرِ ذُنُوْبُهُمُ، الْمُكَفَّرِ عَنْ سَيِّئَاتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ فِيْمَا تَقْضِيْ وَتُقَدِّرُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُطِيْلَ عُمْرِيْ فِيْ خَيْرٍ وَعَافِيَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَتُوَسِّعَ فِي رِزْقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلَنِيْ مِمَّنْ تَنْتَصِرُ بِهٖ لِدِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَسْتَبْدِلْ بِيْ غَيْرِيْ۔"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِجَلَالِ وَجْهِكَ الْكَرِيْمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ يَنْقَضِيَ عَنِّيْ شَهْرُ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "أَوْ يَطْلُعَ الْفَجْرُ مِنْ لَيْلَتِيْ هٰذِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ قِبَلِيْ تَبِعَةٌ أَوْ ذَنْبٌ تُعَذِّبُنِيْ عَلَيْهِ۔"
    }
  ]
}