{
  "id": "ramadan-day2-dua",
  "title": "دوسرے دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دوسرے دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ قَرِّبْنِيْ فِيْهِ اِلٰي مَرْضَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجَنِّبْنِيْ فِيْهِ مِنْ سَخَطِكَ وَنَقِمَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَفِّقْنِيْ فِيْهِ لِقِرَائَةِ اٰيَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}