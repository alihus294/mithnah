{
  "id": "dua-ziarat-imam-reza",
  "title": "دعا بعد از زيارت امام رضا",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعا بعد از زيارت امام رضا",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "الدَّائِمُ فِيْ مُلْكِهٖ، الْقَائِمُ فِيْ عِزِّهٖ"
    },
    {
      "kind": "text",
      "ar": "الْمُطَاعُ فِيْ سُلْطَانِهٖ، الْمُتَفَرِّدُ فِيْ كِبْرِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَوَحِّدُ فِيْ دَيْمُوْمِيَّةِ بَقَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْعَادِلُ فِيْ بَرِيَّتِهٖ، الْعَالِمُ فِيْ قَضِيَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْكَرِيْمُ فِيْ تَأْخِيْرِ عُقُوْبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ حَاجَاتِيْ مَصْرُوْفَةٌ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَاٰمَالِيْ مَوْقُوْفَةٌ لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَكُلَّمَا وَفَّقْتَنِيْ مِنْ خَيْرٍ"
    },
    {
      "kind": "text",
      "ar": "فَأَنْتَ دَلِيْلِيْ عَلَيْهِ وَطَرِيْقِيْ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "يَا قَدِيْرًا لَا تَؤُوْدُهُ الْمَطَالِبُ"
    },
    {
      "kind": "text",
      "ar": "يَا مَلِيًّا يَلْجَأُ اِلَيْهِ كُلُّ رَاغِبٍ"
    },
    {
      "kind": "text",
      "ar": "مَا زِلْتُ مَصْحُوْبًا مِنْكَ بِالنِّعَمِ"
    },
    {
      "kind": "text",
      "ar": "جَارِيًا عَلٰي عَادَاتِ الْاِحْسَانِ وَالْكَرَمِ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِالْقُدْرَةِ النَّافِذَةِ فِيْ جَمِيْعِ الْاَشْيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَقَضَائِكَ الْمُبْرَمِ الَّذِيْ تَحْجُبُهٗ بِأَيْسَرِ الدُّعَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَبِالنَّظْرَةِ الَّتِيْ نَظَرْتَ بِهَا اِلَي الْجِبَالِ فَتَشَامَخَتْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَي الْاَرَضِيْنَ فَتَسَطَّحَتْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَي السَّمٰوَاتِ فَارْتَفَعَتْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَي الْبِحَارِ فَتَفَجَّرَتْ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ جَلَّ عَنْ أَدَوَاتِ لَحَظَاتِ الْبَشَرِ"
    },
    {
      "kind": "text",
      "ar": "وَلَطُفَ عَنْ دَقَائِقِ خَطَرَاتِ الْفِكَرِ"
    },
    {
      "kind": "text",
      "ar": "لَا تُحْمَدُ يَا سَيِّدِيْ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا بِتَوْفِيْقٍ مِنْكَ يَقْتَضِيْ حَمْدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُشْكَرُ عَلٰي أَصْغَرِ مِنَّةٍ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا اسْتَوْجَبْتَ بِهَا شُكْرًا"
    },
    {
      "kind": "text",
      "ar": "فَمَتٰي تُحْصٰي نَعْمَاؤُكَ يَا اِلٰهِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُجَازٰي اٰلَاؤُكَ يَا مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "وَتُكَافَأُ صَنَائِعُكَ يَا سَيِّدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ نِعَمِكَ يَحْمَدُ الْحَامِدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شُكْرِكَ يَشْكُرُ الشَّاكِرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُعْتَمَدُ لِلذُّنُوْبِ فِيْ عَفْوِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّاشِرُ عَلَي الْخَاطِئِيْنَ جَنَاحَ سِتْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْكَاشِفُ لِلضُّرِّ بِيَدِكَ"
    },
    {
      "kind": "text",
      "ar": "فَكَمْ مِنْ سَيِّئَةٍ أَخْفَاهَا حِلْمُكَ حَتّٰي دَخِلَتْ"
    },
    {
      "kind": "text",
      "ar": "وَحَسَنَةٍ ضَاعَفَهَا فَضْلُكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي عَظُمَتْ عَلَيْهَا مُجَازَاتُكَ"
    },
    {
      "kind": "text",
      "ar": "جَلَلْتَ أَنْ يُخَافَ مِنْكَ اِلَّا الْعَدْلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ يُرْجٰي مِنْكَ اِلَّا الْاِحْسَانُ وَالْفَضْلُ"
    },
    {
      "kind": "text",
      "ar": "فَامْنُنْ عَلَيَّ بِمَاأَوْجَبَهٗ فَضْلُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَخْذُلْنِيْ بِمَا يَحْكُمُ بِهٖ عَدْلُكَ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدِيْ لَوْ عَلِمَتِ الْاَرْضُ بِذُنُوْبِيْ لَسَاخَتْ بِيْ"
    },
    {
      "kind": "text",
      "ar": "أَوِ الْجِبَالُ لَهَدَّتْنِيْ، أَوِ السَّمٰوَاتُ لَاخْتَطَفَتْنِيْ"
    },
    {
      "kind": "text",
      "ar": "أَوِ الْبِحَارُ لَاَغْرَقَتْنِيْ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدِيْ سَيِّدِيْ سَيِّدِيْ"
    },
    {
      "kind": "text",
      "ar": "مَوْلَايَ مَوْلَايَ مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "قَدْ تَكَرَّرَ وُقُوْفِيْ لِضِيَافَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَحْرِمْنِيْ مَا وَعَدْتَ الْمُتَعَرِّضِيْنَ لِمَسْأَلَتِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَعْرُوْفَ الْعَارِفِيْنَ، يَا مَعْبُوْدَ الْعَابِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَامَشْكُوْرَ الشَّاكِرِيْنَ، يَا جَلِيْسَ الذَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَحْمُوْدَ مَنْ حَمِدَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْجُوْدَ مَنْ طَلَبَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْصُوْفَ مَنْ وَحَّدَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا مَحْبُوْبَ مَنْ أَحَبَّهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا غَوْثَ مَنْ أَرَادَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا مَقْصُوْدَ مَنْ أَنَابَ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يَعْلَمُ الْغَيْبَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يَصْرِفُ السُّوْءَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يُدَبِّرُ الْاَمْرَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يَغْفِرُ الذَّنْبَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يَخْلُقُ الْخَلْقَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يُنَزِّلُ الْغَيْثَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لِيْ يَا خَيْرَ الْغَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "رَبِّ اِنِّيْ أَسْتَغْفِرُكَ اسْتِغْفَارَ حَيَاءٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ رَجَاءٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ اِنَابَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ رَغْبَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ رَهْبَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ طَاعَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ اِيْمَانٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ اِقْرَارٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ اِخْلَاصٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ تَقْوٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ تَوَكُّلٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ ذِلَّةٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ اسْتِغْفَارَ عَامِلٍ لَكَ هَارِبٍ مِنْكَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَتُبْ عَلَيَّ وَعَلٰي وَالِدَيَّ بِمَا تُبْتَ"
    },
    {
      "kind": "text",
      "ar": "وَتَتُوْبُ عَلٰي جَمِيْعِ خَلْقِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يُسَمّٰي بِالْغَفوُرِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يُسَمّٰي بِالْغَفُوْرِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يُسَمّٰي بِالْغَفُوْرِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاقْبَلْ تَوْبَتِيْ، وَزَكِّ عَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاشْكُرْ سَعْيِيْ، وَارْحَمْ ضَرَاعَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَحْجُبْ صَوْتِيْ، وَلَا تُخَيِّبْ مَسْأَلَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا غَوْثَ الْمُسْتَغِيْثِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْلِغْ أَئِمَّتِيْ سَلَامِيْ وَدُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَشَفِّعْهُمْ فِيْ جَمِيْعِ مَا سَأَلْتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْصِلْ هَدِيَّتِيْ اِلَيْهِمْ كَمَا يَنْبَغِيْ لَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وزِدْهُمْ مِنْ ذٰلِكَ مَا يَنْبَغِيْ لَكَ"
    },
    {
      "kind": "text",
      "ar": "بِأَضْعَافٍ لَا يُحْصِيْهَا غَيْرُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي أَطْيَبِ الْمُرْسَلِيْنَ مُحَمَّدٍ وَاٰلِهٖ الطَّاهِرِيْنَ۔"
    }
  ]
}