{
  "id": "sura-nasr",
  "title": "سورۂ نصر",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ نصر",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اِذَا جَآءَ نَصْرُ اللّٰهِ وَالْفَتْحُۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "وَرَاَيْتَ النَّاسَ يَدْخُلُوْنَ فِيْ دِيْنِ اللّٰهِ اَفْوَاجًاۙ۝۲"
    },
    {
      "kind": "text",
      "ar": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ١ؔؕ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ كَانَ تَوَّابًا۠۝۳"
    }
  ]
}