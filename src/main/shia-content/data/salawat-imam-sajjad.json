{
  "id": "salawat-imam-sajjad",
  "title": "امام زين العابدين پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام زين العابدين پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي عَلِيِّ بْنِ الْحُسَيْنِ سَيِّدِ الْعَابِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِي اسْتَخْلَصْتَهٗ لِنَفْسِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَ مِنْهُ أَئِمَّةَ الْهُدَي"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ يَهْدُوْنَ بِالْحَقِّ وَبِهٖ يَعْدِلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "اخْتَرْتَهٗ لِنَفْسِكَ وَطَهَّرْتَهٗ مِنَ الرِّجْسِ"
    },
    {
      "kind": "text",
      "ar": "وَاصْطَفَيْتَهٗ وَجَعَلْتَهٗ هَادِيًا مَهْدِيًّا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَصَلِّ عَلَيْهِ أَفْضَلَ مَا صَلَّيْتَ عَلٰي أَحَدٍ مِنْ ذُرِّيَّةِ أَنْبِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تَبْلُغَ بِهٖ مَا تَقَرُّ بِهٖ عَيْنُهٗ فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَزِيْزٌ حَكِيْمٌ۔"
    }
  ]
}