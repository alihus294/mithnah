{
  "id": "thursday-dua",
  "title": "جمعرات كے دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "جمعرات كے دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْم"
    },
    {
      "kind": "text",
      "ar": "اَلْحَمْدُ لِلّٰهِ الَّذِيْ أَذْهَبَ اللَّيْلَ مُظْلِمًا بِقُدْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَاءَ بِالنَّهَارِ مُبْصِرًا بِرَحْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكَسَانِيْ ضِيَائَهٗ وَأَنَا فِيْ نِعْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَكَمَا أَبْقَيْتَنِيْ لَهٗ فَأَبْقِنِيْ لِاَمْثَالِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلَي النَّبِيِّ مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَفْجَعْنِيْ فِيْهِ وَفِيْ غَيْرِهٖ مِنَ اللَّيَالِيْ وَالْاَيَّامِ"
    },
    {
      "kind": "text",
      "ar": "بِارْتِكَابِ الْمحَارِمِ وَاكْتِسَابِ الْمَاٰثِمِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ خَيْرَهٗ وَخَيْرَ مَا فِيْهِ وَخَيْرَ مَا بَعْدَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاصْرِف عَنِّيْ شَرَّهٗ وَشَرَّ مَا فِيْهِ وَشَرَّ مَا بَعْدَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ بِذِمَّةِ الْاِسْلَامِ أَتَوَسَّلُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِحُرْمَةِ الْقُرْاٰنِ أَعْتَمِدُ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِمُحَمَّدٍ الْمُصْطَفٰي صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ أَسْتَشْفِعُ لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَاعْرِفِ اَللّٰهُمَّ ذِمَّتِيَ الَّتِيْ رَجَوْتُ بِهَا قَضَاءَ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اقْضِ لِيْ فِي الْخَمِيْسِ خَمْسًا"
    },
    {
      "kind": "text",
      "ar": "لَا يَتَّسِعُ لَهَا اِلَّا كَرَمُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُطِيْقُهَا اِلَّا نِعَمُكَ"
    },
    {
      "kind": "text",
      "ar": "سَلَامَةً أَقْوٰي بِهَا عَلٰي طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعِبَادَةً أَسْتَحِقُّ بِهَا جَزِيْلَ مَثُوْبَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَسَعَةً فِي الْحَالِ مِنَ الرِّزْقِ الْحَلَالِ"
    },
    {
      "kind": "text",
      "ar": "وَأَن تُؤْمِنَنِيْ فِيْ مَوَاقِفِ الْخَوْفِ بِأَمْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلَنِيْ مِنْ طَوَارِقِ الْهُمُوْمِ وَالْغُمُوْمِ فِيْ حِصْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ تَوَسُّلِيْ بِهٖ شَافِعًا، يَوْمَ الْقِيَامَةِ نَافِعًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ أَرْحَمُ الرَّاحِمِيْنَ"
    }
  ]
}