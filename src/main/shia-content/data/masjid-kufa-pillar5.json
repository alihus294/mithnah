{
  "id": "masjid-kufa-pillar5",
  "title": "پانچويں ستون كے اعمال",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "پانچويں ستون كے اعمال",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِجَمِيْعِ أَسْمَائِكَ كُلِّهَا"
    },
    {
      "kind": "text",
      "ar": "مَا عَلِمْنَا مِنْهَا وَمَا لَا نَعْلَمُ"
    },
    {
      "kind": "text",
      "ar": "وأَسْئَلُكَ بِاسْمِكَ الْعَظِيْمِ الْاَعْظَمِ الْكَبِيْرِ الْاَكْبَرِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ مَنْ دَعَاكَ بِهٖ أَجَبْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ سَأَلَكَ بِهٖ أَعْطَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَنْصَرَكَ بِهٖ نَصَرْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَغْفَرَكَ بِهٖ غَفَرْتَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَعَانَكَ بِهٖ أَعَنْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَرْزَقَكَ بِهٖ رَزَقْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَغَاثَكَ بِهٖ أَغَثْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَرْحَمَكَ بِهٖ رَحِمْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَجَارَكَ بِهٖ أَجَرْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ تَوَكَّلَ عَلَيْكَ بِهٖ كَفَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَعْصَمَكَ بِهٖ عَصَمْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَنْقَذَكَ بِهٖ مِنَ النَّارِ أَنْقَذْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اسْتَعْطَفَكَ بِهٖ تَعَطَّفْتَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ أَمَّلَكَ بِهٖ أَعْطَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "الَّذِي اتَّخَذْتَ بِهٖ اٰدَمَ صَفِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَنُوْحًا نَجِيًّا، وَاِبْرَاهِيْمَ خَلِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَمُوْسٰي كَلِيْمًا، وَعِيْسٰي رُوْحًا"
    },
    {
      "kind": "text",
      "ar": "وَمُحَمَّدًا حَبِيْبًا، وَعَلِيًّا وَصِيًّا"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِمْ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَقْضِيَ لِيْ حَوَائِجِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَعْفُوَ عَمَّا سَلَفَ مِنْ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَتَفَضَّلَ عَلَيَّ بِمَا أَنْتَ أَهْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلِجَمِيْعِ الْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ لِلدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُفَرِّجَ هَمِّ الْمَهْمُوْمِيْنَ، وَيَا غِيَاثَ الْمَلْهُوْفِيْنَ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ سُبْحَانَكَ يَا رَبَّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلُامُ عَلٰي اَبِيْنَا اٰدَمَ وَاُمَّنَا حَوَّاءَ ۔۔۔۔۔ الخ"
    }
  ]
}