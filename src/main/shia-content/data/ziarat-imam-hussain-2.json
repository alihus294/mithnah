{
  "id": "ziarat-imam-hussain-2",
  "title": "دوسري زيارت مطلقه",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دوسري زيارت مطلقه",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ فِيْ أَرْضِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَشَاهِدَهٗ عَلٰي خَلْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ عَلِيٍّ الْمُرْتَضي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ فَاطِمَةَ الزَّهْرَاءِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ أَقَمْتَ الصَّلَاةَ، وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ، وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِيْ سَبِيْلِ اللهِ حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "فَصَلَّي اللهُ عَلَيْكَ حَيًّا وَمَيِّتًا"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ عَلٰي بَيِّنَةٍ مِنْ رَبِّكَ"
    },
    {
      "kind": "text",
      "ar": "جِيْتُ مُقِرًّا بِالذُّنُوْبِ"
    },
    {
      "kind": "text",
      "ar": "لِتَشْفَعَ لِيْ عِنْدَ رَبِّكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكُمْ حُجَجُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اكْتُبْ لِيْ عِنْدَكَ مِيْثَاقًا وَعَهْدًا"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ أَتَيْتُكَ مُجَدِّدًا الْمِيْثَاقَ"
    },
    {
      "kind": "text",
      "ar": "فَاشْهَدْ لِيْ عِنْدَ رَبِّكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الشَّاهِدُ"
    }
  ]
}