  "slides": [
    {
      "kind": "title",
      "ar": "نماز اعرابي",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ يَا قَيُّوْمُ يَا ذَا الْجَلَالِ وَالْاِكْرَامِ"
    },
    {
      "kind": "text",
      "ar": "يَا اِلٰهَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحْمٰنَ الدُّنْيَا وَالْاٰخِرَةِ وَرَحِيْمَهُمَا"
    },
    {
      "kind": "text",
      "ar": "يَارَبِّ يَارَبِّ يَارَبِّ يَارَبِّ"
    },
    {
      "kind": "text",
      "ar": "يَارَبِّ يَارَبِّ يَارَبِّ"
    },
    {
      "kind": "text",
      "ar": "يَا اَللّٰهُ يَا اَللّٰهُ يَا اَللّٰهُ يَا اَللّٰهُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا اللهُ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمّدٍ وَاغْفِرْ لِيْ۔"
    },
    {
      "kind": "text",
      "ar": "لَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ۔"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ رَبِّ الْعَرْشِ الْكَرِيْمِ۔"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ رَبِّ الْعَرْشِ الْكَرِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ۔"
    }
  ]
}