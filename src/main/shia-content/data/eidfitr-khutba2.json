{
  "id": "eidfitr-khutba2",
  "title": "عيد الفطر كا دوسرا خطبه",
  "subtitle": "ملحقات مفاتيح الجنان",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "عيد الفطر كا دوسرا خطبه",
      "subtitle": "ملحقات مفاتيح الجنان"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ نَحْمَدُهٗ وَنَسْتَعِيْنُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَنُؤْمِنُ بِهٖ وَنَتَوَكَّلُ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَنَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مُحَمَّدًا عَبْدُهٗ وَرَسُوْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ وَسَلَامُهٗ عَلَيْهِ وَاٰلِهٖ وَمَغْفِرَتُهٗ وَرِضْوَانُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ عَبْدِكَ وَرَسُوْلِكَ وَنَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً نَامِيَةً زَاكِيَةً"
    },
    {
      "kind": "text",
      "ar": "تَرْفَعُ بِهَا دَرَجَتَهٗ، وَتُبَيِّنُ بِهَا فَضْلَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "كَمَا صَلَّيْتَ وَبَارَكْتَ وَتَرَحَّمْتَ عَلٰي اِبْرَاهِيْمَ وَاٰلِ اِبْرَاهِيْمَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ حَمِيْدٌ مَجِيْدٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَذِّبْ كَفَرَةَ أَهْلِ الْكِتَابِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ يَصُدُّوْنَ عَنْ سَبِيْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَيَجْحَدُوْنَ اٰيَاتِكَ وَيُكَذِّبُوْنَ رُسُلَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ خَالِفْ بَيْنَ كَلِمَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْقِ الرُّعْبَ فِيْ قُلُوْبِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزِلْ عَلَيْهِمْ رِجْزَكَ وَنَقِْمَتَكَ وَبَأْسَكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَا تَرُدُّهٗ عَنِ الْقَوْمِ الْمُجْرِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ انْصُرْ جُيُوْشَ الْمُسْلِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَسَرَايَاهُمْ وَمُرَابِطِيْهِمْ فِيْ مَشَارِقِ الْاَرْضِ وَمَغَارِبِهَا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْ لِلْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ وَالْمُسْلِمِيْنَ وَالْمُسْلِمَاتِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلِ التَّقْوٰي زَادَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِيْمَانَ وَالْحِكْمَةَ فِيْ قُلُوْبِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْزِعْهُمْ أَنْ يَشْكُرُوْا نِعْمَتَكَ الَّتِيْ أَنْعَمْتَ عَلَيْهِم"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ يُوْفُوْا بِعَهْدِكَ الَّذِيْ عَاهَدْتَهُمْ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهَ الْحَقِّ وَخَالِقَ الْخَلْقِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْ لِمَنْ تُوَفِّيَ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ وَالْمُسْلِمِيْنَ وَالْمُسْلِمَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَلِمَنْ هُوَ لَاحِقٌ بِهِمْ مِنْ بَعْدِهِمْ مِنْهُمْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الْعَزِيْزُ الْحَكِيْمُ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ يَأْمُرُ بِالْعَدْلِ وَالْاِحْسَانِ وَاِيْتَاءِ ذِي الْقُرْبٰي"
    },
    {
      "kind": "text",
      "ar": "وَيَنْهٰي عَنِ الْفَحْشَاءِ وَالْمُنْكَرِ وَالْبَغْيِ"
    },
    {
      "kind": "text",
      "ar": "يَعِظُكُمْ لَعَلَّكُمْ تَذَكَّرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "اذْكُرُوا اللهَ يَذْكُرْكُمْ، فَاِنَّهٗ ذَاكِرٌ لِمَنْ ذَكَرَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاسْأَلُوا اللهَ مِنْ رَحْمَتِهٖ وَفَضْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ لَا يَخِيْبُ عَلَيْهِ دَاعٍ دَعَاهُ"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا اٰتِنَا فِي الدُّنْيَا حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَفِي الْاٰخِرَةِ حَسَنَةً، وَقِنَا عَذَابَ النَّارِ۔"
    }
  ]
}