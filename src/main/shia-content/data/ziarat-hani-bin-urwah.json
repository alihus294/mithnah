{
  "id": "ziarat-hani-bin-urwah",
  "title": "زيارت حضرت هانيؓ بن عروه",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت حضرت هانيؓ بن عروه",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "سَلَامُ اللهِ الْعَظِيْمِ وَصَلَوَاتُهٗ عَلَيْكَ يَا هَانِيَ بْنَ عُرْوَةَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْعَبْدُ الصَّالِحُ"
    },
    {
      "kind": "text",
      "ar": "النَّاصِحُ لِلّٰهِ وَلِرَسُوْلِهٖ وَلِاَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنِ وَالْحُسَيْنِ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قُتِلْتَ مَظْلُوْمًا"
    },
    {
      "kind": "text",
      "ar": "فَلَعَنَ اللهُ مَنْ قَتَلَكَ، وَاسْتَحَلَّ دَمَكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَشٰي قُبُوْرَهُمْ نَارًا۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ لَقِيْتَ اللهَ وَهُوَ رَاضٍ عَنْكَ"
    },
    {
      "kind": "text",
      "ar": "بِمَا فَعَلْتَ وَنَصَحْتَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ قَدْ بَلَغْتَ دَرَجَةَ الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَجُعِلَ رُوْحُكَ مَعَ أَرْوَاحِ السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "بِمَا نَصَحْتَ لِلّٰهِ وَلِرَسُوْلِهٖ مُجْتَهِدًا"
    },
    {
      "kind": "text",
      "ar": "وَبَذَلْتَ نَفْسَكَ فِيْ ذَاتِ اللهِ وَمَرْضَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَرَحِمَكَ اللهُ وَرَضِيَ عَنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَشَرَكَ مَعَ مُحَمَّدٍ وَاٰلِهِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَجَمَعَنَا وَاِيَّاكُمْ مَعَهُمْ فِيْ دَارِ النَّعِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَامٌ عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    }
  ]
}