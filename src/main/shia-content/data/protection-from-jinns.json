      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "حَسْبِيَ اللهُ وَكَفٰي"
    },
    {
      "kind": "text",
      "ar": "وَسَمِعَ اللهُ لِمَنْ دَعَا"
    },
    {
      "kind": "text",
      "ar": "لَيْسَ وَرَاءَ اللهِ مُنْتَهَي"
    },
    {
      "kind": "text",
      "ar": "أَفَغَيْرَ دِيْنِ اللهِ يَبْغُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَهٗ أَسْلَمَ مَنْ فِي السَّمٰوَاتِ وَالْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "طَوْعًا وَكَرْهًا وَاِلَيْهِ يُرْجَعُوْنَ۔"
    }
  ]
