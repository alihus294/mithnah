{
  "id": "taweez-eye-pain",
  "title": "آنكه كا درد",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "آنكه كا درد",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِحَقِّ مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ النُّوْرَ فِيْ بَصَرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَصِيْرَةَ فِيْ دِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْيَقِيْنَ فِيْ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِخْلَاصَ فِيْ عَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّلَامَةَ فِيْ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّعَةَ فِيْ رِزْقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالشُّكْرَ لَكَ أَبَدًا مَا أَبْقَيْتَنِيْ۔"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِعِزَّةِ اللهِ، وَأَعُوْذُ بِقُوَّةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِقُدْرَةِ اللهِ، وَأَعُوْذُ بِنُوْرِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِعَظَمَةِ الله، وَأَعُوْذُ بِجَلَالِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِجَمَالِ اللهِ، وَأَعُوْذُ بِبَهَاءِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِجَمْعِ الله۔"
    },
    {
      "kind": "text",
      "ar": "بِكُلِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِعَفْوِ اللهِ، وَأَعُوْذُ بِغُفْرَانِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِرَسُوْلِ اللهِ وَأَعُوْذُ بِالْاَئِمَّةِ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي مَا نَشَاءُ مِنْ شَرِّ مَا أَجِدُ اَللّٰهُمَّ رَبَّ الْمُطِيْعِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "أُعِيْذُ نُوْرَ بَصَرِيْ بِنُوْرِ اللهِ الَّذِيْ لَا يُطْفَأ"
    },
    {
      "kind": "text",
      "ar": "فَجَعَلْنَاهُ سَمِيْعًا بَصِيْرًا"
    }
  ]
}