{
  "id": "dua-ehed",
  "title": "دعاء عهد",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء عهد",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّ النُّوْرِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ الْكُرْسِيِّ الرَّفِيْعِ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ الْبَحْرِ الْمَسْجُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَمُنْزِلَ التَّوْرَاةِ وَالْاِنْجِيْلِ وَالزَّبُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ الظِّلِّ وَالْحَرُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَمُنْزِلَ الْقُرْاٰنِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ الْمَلَائِكَةِ الْمُقَرَّبِيْنَ وَالْاَنْبِيَاءِ وَالْمُرْسَلِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِوَجْهِكَ الْكَرِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَبِنُوْرِ وَجْهِكَ الْمُنِيْرِ وَمُلْكِكَ الْقَدِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ يَا قَيُّوْمُ، أَسْأَلُكَ بِاسْمِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ أَشْرَقَتْ بِهِ السَّمٰوَاتُ وَالْاَرَضُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِاسْمِكَ الَّذِيْ يَصْلَحُ بِهِ الْاَوَّلُوْنَ وَالْاٰخِرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا حَيًّا قَبْلَ كُلِّ حَيٍّ، وَيَا حَيًّا بَعْدَ كُلِّ حَيٍّ"
    },
    {
      "kind": "text",
      "ar": "وَيَا حَيًّا حِيْنَ لَا حَيَّ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحْيِيَ الْمَوْتٰي وَمُمِيْتَ الْاَحْيَاءِ"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ لَا اِلٰهَ اِلَّا أَنْتَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بَلِّغْ مَوْلَانَا الْاِمَامَ الْهَادِيَ الْمَهْدِيَّ"
    },
    {
      "kind": "text",
      "ar": "الْقَائِمَ بِأَمْرِكَ صَلَوَاتُ اللهِ عَلَيْهِ وَعَلٰي اٰبَائِهِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَنْ جَمِيْعِ الْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ"
    },
    {
      "kind": "text",
      "ar": "فِيْ مَشَارِقِ الْاَرْضِ وَمَغَارِبِهَا"
    },
    {
      "kind": "text",
      "ar": "سَهْلِهَا وَجَبَلِهَا وَبَرِّهَا وَبَحْرِهَا"
    },
    {
      "kind": "text",
      "ar": "وَعَنِّيْ وَعَنْ وَالِدَيَّ مِنَ الصَّلَوَاتِ"
    },
    {
      "kind": "text",
      "ar": "زِنَةَ عَرْشِ اللهِ وَمِدَادَ كَلِمَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمَا أَحْصَاهُ عِلْمُهٗ وَأَحَاطَ بِهٖ كِتَابُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أُجَدِّدُ لَهٗ فِيْ صَبِيْحَةِ يَوْمِيْ هٰذَا"
    },
    {
      "kind": "text",
      "ar": "وَمَا عِشْتُ مِنْ أَيَّامِيْ"
    },
    {
      "kind": "text",
      "ar": "عَهْدًا وَعَقْدًا وَبَيْعَةً لَهٗ فِيْ عُنُقِيْ"
    },
    {
      "kind": "text",
      "ar": "لَا أَحُوْلُ عَنْهَا وَلَا أَزُوْلُ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ مِنْ أَنْصَارِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْوَانِهٖ وَالذَّابِّيْنَ عَنْهُ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسَارِعِيْنَ اِلَيْهِ فِيْ قَضَاءِ حَوَائِجِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُمْتَثِلِيْنَ لِاَوَامِرِهٖ، وَالْمُحَامِيْنَ عَنْهُ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّابِقِيْنَ اِلٰي اِرَادَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسْتَشْهَدِيْنَ بَيْنَ يَدَيْهِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنْ حَالَ بَيْنِيْ وَبَيْنَهُ الْمَوْتُ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ جَعَلْتَهٗ عَلٰي عِبَادِكَ حَتْمًا مَقْضِيًّا"
    },
    {
      "kind": "text",
      "ar": "فَأَخْرِجْنِيْ مِنْ قَبْرِيْ مُؤْتَزِرًا كَفَنِيْ"
    },
    {
      "kind": "text",
      "ar": "شَاهِرًا سَيْفِيْ، مُجَرِّدًا قَنَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "مُلَبِّيًا دَعْوَةَ الدَّاعِيْ فِي الْحَاضِرِ وَالْبَادِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَرِنِي الطَّلْعَةَ الرَّشِيْدَةَ، وَالْغُرَّةَ الْحَمِيْدَةَ"
    },
    {
      "kind": "text",
      "ar": "وَاكْحُلْ نَاظِرِيْ بِنَظْرَةٍ مِنِّيْ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَعَجِّلْ فَرَجَهٗ، وَسَهِّلْ مَخْرَجَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْسِعْ مَنْهَجَهٗ، وَاسْلُكْ بِيْ مَحَجَّتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْفِذْ أَمْرَهٗ، وَاشْدُدْ أَزْرَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "وَاعْمُرِ اللّٰهُمَّ بِهٖ بِلَادَكَ، وَأَحْيِ بِهٖ عِبَادَكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ قُلْتَ وَقَوْلُكَ الْحَقُّ"
    },
    {
      "kind": "text",
      "ar": "ظَهَرَ الْفَسَادُ فِي الْبَرِّ وَالْبَحْرِ بِمَا كَسَبَتْ أَيْدِي النَّاسِ"
    },
    {
      "kind": "text",
      "ar": "فَأَظْهِرِ اللّٰهُمَّ لَنَا وَلِيَّكَ وَابْنَ بِنْتِ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "الْمُسَمّٰي بِاسْمِ رَسُوْلِكَ صَلَّي الله عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا يَظْفَرَ بِشَيْءٍ مِنَ الْبَاطِلِ اِلَّا مَزَّقَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَيُحِقَّ الْحَقَّ وَيُحَقِّقَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ اللّٰهُمَّ مَفْزَعًا لِمَظْلُوْمِ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَاصِرًا لِمَنْ لَا يَجِدُ لَهٗ نَاصِرًا غَيْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُجَدِّدًا لِمَا عُطِّلَ مِنْ أَحْكَامِ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُشَيِّدًا لِمَا وَرَدَ مِنْ أَعْلَامِ دِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَسُنَنِ نَبِيِّكَ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ اللّٰهُمَّ مِمَّنْ حَصَّنْتَهٗ مِنْ بَأْسِ الْمُعْتَدِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَسُرَّ نَبِيَّكَ مُحَمَّدًا صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ بِرُؤْيَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ تَبِعَهٗ عَلٰي دَعْوَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمِ اسْتِكَانَتَنَا بَعْدَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اكْشِفْ هٰذِهِ الْغُمَّةَ عَنْ هٰذِهِ الْأُمَّةِ بِحُضُوْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَجِّلْ لَنَا ظُهُوْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهُمْ يَرَوْنَهٗ بَعِيْدًا وَنَرَاهُ قَرِيْبًا"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "الْعَجَلَ الْعَجَلَ يَامَوْلَايَ يَا صَاحِبَ الزَّمَانِ۔"
    }
  ]
}