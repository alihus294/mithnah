{
  "id": "sura-tawhid",
  "title": "سورۂ توحيد",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ توحيد",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "قُلْ هُوَ اللّٰهُ اَحَدٌۚ۝۱"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ الصَّمَدُۚ۝۲"
    },
    {
      "kind": "text",
      "ar": "لَمْ يَلِدْ١ۙ۬ وَلَمْ يُوْلَدْۙ۝۳"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَّهٗ كُفُوًا اَحَدٌ۠۝۴"
    }
  ]
}