{
  "id": "yawm-arbiaa",
  "title": "دُعاءُ يَوْمِ الأَرْبِعاء",
  "subtitle": "من أدعية الأيام السبعة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "دُعاءُ يَوْمِ الأَرْبِعاء", "subtitle": "من أدعية الأيام السبعة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "الحَمْدُ للهِ الَّذِي جَعَلَ اللَّيْلَ لِباساً" },
    { "kind": "text", "ar": "وَالنَّوْمَ سُباتاً، وَجَعَلَ النَّهارَ نُشُوراً" },
    { "kind": "text", "ar": "لَكَ الحَمْدُ أَنْ بَعَثْتَنِي مِنْ مَرْقَدِي" },
    { "kind": "text", "ar": "وَلَوْ شِئْتَ جَعَلْتَهُ سَرْمَداً" },
    { "kind": "text", "ar": "حَمْداً دائِماً لا يَنْقَطِعُ أَبَداً" },
    { "kind": "text", "ar": "وَلا يُحْصِي لَهُ الخَلائِقُ عَدَداً" },
    { "kind": "text", "ar": "اللَّهُمَّ لَكَ الحَمْدُ" },
    { "kind": "text", "ar": "أَنْ خَلَقْتَ فَسَوَّيْتَ، وَقَدَّرْتَ وَقَضَيْتَ" },
    { "kind": "text", "ar": "وَأَمَتَّ وَأَحْيَيْتَ، وَأَمْرَضْتَ وَشَفَيْتَ" },
    { "kind": "text", "ar": "وَعافَيْتَ وَأَبْلَيْتَ" },
    { "kind": "text", "ar": "وَعَلَىٰ العَرْشِ اسْتَوَيْتَ" },
    { "kind": "text", "ar": "وَعَلَىٰ المُلْكِ احْتَوَيْتَ" },
    { "kind": "text", "ar": "أَدْعُوكَ دُعاءَ مَنْ ضَعُفَتْ وَسِيلَتُهُ" },
    { "kind": "text", "ar": "وَانْقَطَعَتْ حِيلَتُهُ" },
    { "kind": "text", "ar": "وَاقْتَرَبَ أَجَلُهُ" },
    { "kind": "text", "ar": "وَتَدانَىٰ فِي الدُّنْيَا أَمَلُهُ" },
    { "kind": "text", "ar": "وَاشْتَدَّتْ إِلَىٰ رَحْمَتِكَ فاقَتُهُ" },
    { "kind": "text", "ar": "وَعَظُمَتْ لِتَفْرِيطِهِ حَسْرَتُهُ" },
    { "kind": "text", "ar": "وَكَثُرَتْ زَلَّتُهُ وَعَثْرَتُهُ" },
    { "kind": "text", "ar": "وَخَلُصَتْ لِوَجْهِكَ تَوْبَتُهُ" },
    { "kind": "text", "ar": "فَصَلِّ عَلَىٰ مُحَمَّدٍ خاتَمِ النَّبِيِّينَ" },
    { "kind": "text", "ar": "وَعَلَىٰ أَهْلِ بَيْتِهِ الطَّيِّبِينَ الطَّاهِرِينَ" },
    { "kind": "text", "ar": "وَارْزُقْنِي شَفاعَةَ مُحَمَّدٍ صَلَّىٰ الله عَلَيْهِ وَآلِهِ" },
    { "kind": "text", "ar": "وَلا تَحْرِمْنِي صُحْبَتَهُ" },
    { "kind": "text", "ar": "إِنَّكَ أَنْتَ أَرحَمُ الرَّاحِمِينَ" },
    { "kind": "text", "ar": "اللَّهُمَّ اقْضِ لِي فِي الأَرْبِعاءِ أَرْبَعاً" },
    { "kind": "text", "ar": "اجْعَلْ قُوَّتِي فِي طاعَتِكَ" },
    { "kind": "text", "ar": "وَنَشاطِي فِي عِبادَتِكَ" },
    { "kind": "text", "ar": "وَرَغْبَتِي فِي ثَوابِكَ" },
    { "kind": "text", "ar": "وَزُهْدِي فِيما يُوجِبُ لِي أَلِيمَ عِقابِكَ" },
    { "kind": "text", "ar": "إِنَّكَ لَطِيفٌ لِما تَشاءُ" }
  ]
}
