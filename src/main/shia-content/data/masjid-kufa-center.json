{
  "id": "masjid-kufa-center",
  "title": "وسط مسجد كے اعمال",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "وسط مسجد كے اعمال",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ اَلسَّلَامُ، وَمِنْكَ اَلسَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ يَعُوْدُ اَلسَّلَامُ، وَدَارُكَ دَارُ السَّلَامِ"
    },
    {
      "kind": "text",
      "ar": "حَيِّنَا رَبَّنَا مِنْكَ بِالسَّلَامِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ صَلَّيْتُ هٰذِهِ الصَّلَاةَ ابْتِغَاءَ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَرِضْوَانِكَ وَمَغْفِرَتِكَ وَتَعْظِيْمًا لِمَسْجِدِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَارْفَعْهَا فِيْ عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَتَقَبَّلْهَا مِنِّيْ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}