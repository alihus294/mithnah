{
  "id": "rajab-night27",
  "title": "ستائيس رجب كي رات",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ستائيس رجب كي رات",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَمْ يَتَّخِذْ وَلَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ شَرِيْكٌ فِي الْمُلْكِ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ وَلِيٌّ مِنَ الذُّلِّ وَكَبِّرْهُ تَكْبِيْرًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُك بِمَعَاقِدِ عِزِّكَ عَلٰي أَرْكَانِ عَرْشِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُنْتَهَي الرَّحْمَةِ مِنْ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِاسْمِكَ الْاَعْظَمِ الْاَعْظَمِ الْاَعْظَمِ"
    },
    {
      "kind": "text",
      "ar": "وَذِكْرِكَ الْاَعْلَي الْاَعْلَي الْاَعْلٰي"
    },
    {
      "kind": "text",
      "ar": "وَبِكَلِمَاتِكَ التَّامَّاتِ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَفْعَلَ بِيْ مَا أَنْتَ أَهْلُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "وَمَا بَدَا مِنْ بَرَكَاتِ مَشْهَدِهٖ، فِيْ كُلِّ يَوْمٍ أَمْسُهٗ مِثْلُ غَدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكَشِفَا الْعَمٰي وَالْمَرْضٰي بِهٖ، اِجَابَةُ الدُّعَاءِ فِيْ أَعْتَابِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُك بِالتَّجَلِّي الْاَعْظَمِ"
    },
    {
      "kind": "text",
      "ar": "فِيْ هٰذِهِ اللَّيْلَةِ مِنَ الشَّهْرِ الْمُعَظَّمِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُرْسَلِ الْمُكَرَّمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَغْفِرَ لَنَا مَا أَنْتَ بِهٖ مِنَّا أَعْلَمُ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يَعْلَمُ وَلَا نَعْلَمُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بَارِكْ لَنَا فِيْ لَيْلَتِنَا هٰذِهِ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ بِشَرَفِ الرِّسَالَةِ فَضَّلْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَبِكَرَامَتِكَ أَجْلَلْتَهَا، وَبِالْمَحَلِّ الشَّرِيْفِ أَحْلَلْتَهَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاِنّا نَسْأَلُكَ بِالْمَبْعَثِ الشَّرِيْفِ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّيِّدِ اللَّطِيْفِ، وَالْعُنْصُرِ الْعَفِيْفِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ أَعْمَالَنَا فِيْ هٰذِهِ اللَّيْلَةِ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ سَاِئرِ اللَّيَالِيْ مَقْبُوْلَةً"
    },
    {
      "kind": "text",
      "ar": "وَذُنُوْبَنَا مَغْفُوْرَةً، وَحَسَنَاتِنَا مَشْكُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَسَيِّئَاتِنَا مَسْتُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَقُلُوْبَنَا بِحُسْنِ الْقَوْلِ مَسْرُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَرْزَاقَنَا مِنْ لَدُنْكَ بِالْيُسْرِ مَدْرُوْرَةً۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّكَ تَرٰي وَلَا تُرٰي وَأَنْتَ بِالْمَنْظَرِ الْاَعْلٰي"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّ اِلَيْكَ الرُّجْعٰي وَالْمُنْتَهٰي"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّ لَكَ الْمَمَاتَ وَالْمَحْيَا"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّ لَكَ الْاٰخِرَةَ وَالْاُوْلٰي"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نَعُوْذُ بِكَ أَنْ نَذِلَّ وَنَخْزٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ نَأْتِيَ مَا عَنْهُ تَنْهٰي"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نَسْأَلُكَ الْجَنَّةَ بِرَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَسْتَعِيْذُ بِكَ مِنَ النَّارِ فَأَعِذْنَا مِنْهَا بِقُدْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَسْأَلُكَ مِنَ الْحُوْرِ الْعِيْنِ فَارْزُقْنَا بِعِزَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ أَوْسَعَ أَرْزَاقِنَا عِنْدَ كِبَرِ سِنِّنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَحْسَنَ أَعْمَالِنَا عِنْدَ اقْتِرَابِ اٰجَالِنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَطِلْ فِيْ طَاعَتِكَ وَمَا يُقَرِّبُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَيُحْظِيْ عِنْدَكَ وَيُزْلِفُ لَدَيْكَ أَعْمَارَنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَحْسِنْ فِيْ جَمِيْعِ أَحْوَالِنَا وَأُمُوْرِنَا مَعْرِفَتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَكِلْنَا اِلٰي أَحَدٍ مِنْ خَلْقِكَ فَيَمُنَّ عَلَيْنَا"
    },
    {
      "kind": "text",
      "ar": "وَتَفَضَّلْ عَلَيْنَا بِجَمِيْعِ حَوَائِجِنَا لِلدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَابْدَأْ بِاٰبَائِنَا وَأَبْنَائِنَا وَجَمِيْعِ اِخْوَانِنَا الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ جَمِيْعِ مَا سَأَلْنَاكَ لِاَنْفُسِنَا، يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نَسْأَلُكَ بِاسْمِكَ الْعَظِيْمِ، وَمُلْكِكَ الْقَدِيْمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَغْفِرَ لَنَا الذَّنْبَ الْعَظِيْمَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ لَا يَغْفِرُ الْعَظِيْمَ اِلَّا الْعَظِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَهٰذَا رَجَبٌ الْمُكَرَّمُ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ أَكْرَمْتَنَا بِهٖ أَوَّلُ أَشْهُرِ الْحُرُمِ"
    },
    {
      "kind": "text",
      "ar": "أَكْرَمْتَنَا بِهٖ مِنْ بَيْنِ الْاُمَمِ"
    },
    {
      "kind": "text",
      "ar": "فَلَكَ الْحَمْدُ يَا ذَا الْجُوْدِ وَالْكَرَمِ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْأَلُكَ بِهٖ وَبِاسْمِكَ الْاَعْظَمِ الْاَعْظَمِ الْاَعْظَمِ"
    },
    {
      "kind": "text",
      "ar": "الْاَجَلِّ الْاَكْرَمِ الَّذِيْ خَلَقْتَهٗ فَاسْتَقَرَّ فِيْ ظِلِّكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَا يَخْرُجُ مِنْكَ اِلٰي غَيْرِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَنَا مِنَ الْعَامِلِيْنَ فِيْهِ بِطَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْاٰمِلِيْنَ فِيْهِ لِشَفَاعَتِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اهْدِنَا اِلٰي سَوَاءِ السَّبِيْلِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ مَقِيْلَنَا عِنْدَكَ خَيْرَ مَقِيْلٍ"
    },
    {
      "kind": "text",
      "ar": "فِيْ ظِلٍّ ظَلِيْلٍ، وَمُلْكٍ جَزِيْلٍ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ حَسْبُنَا وَنِعْمَ الْوَكِيْلُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اقْلِبْنَا مُفْلِحِيْنَ مُنْجِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "غَيْرَ مَغْضُوْبٍ عَلَيْنَا وَلَا ضَالِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُك بِعَزَائِمِ مَغْفِرَتِكَ، وَبِوَاجِبِ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "السَّلَامَةَ مِنْ كُلِّ اِثْمٍ، وَالْغَنِيْمَةَ مِنْ كُلِّ بِرٍّ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَوْزَ بِالْجَنَّةِ، وَالنَّجَاةَ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ دَعَاكَ الدَّاعُوْنَ وَدَعَوْتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَسَأَلَكَ السَّائِلُوْنَ وَسَأَلْتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَطَلَبَ اِلَيْكَ الطَّالِبُوْنَ وَطَلَبْتُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الثِّقَةُ وَالرَّجَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ مُنْتَهَي الرَّغْبَةِ فِي الدُّعَاءِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلِ الْيَقِيْنَ فِيْ قَلْبِيْ، وَالنُّوْرَ فِيْ بَصَرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّصِيْحَةَ فِيْ صَدْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَذِكْرَكَ بِاللَّيْلِ وَالنَّهَارِ عَلٰي لِسَانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَرِزْقًا وَاسِعًا غَيْرَ مَمْنُوْنٍ وَلَا مَحْظُوْرٍ فَارْزُقْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ لِيْ فِيْمَا رَزَقْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ غِنَايَ فِيْ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَرَغْبَتِيْ فِيْمَا عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلْحَمْدُ لِلّٰهِ الَّذِيْ هَدَانَا لِمَعْرِفَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَخَصَّنَا بِوِلَايَتِهٖ وَوَفَّقَنَا لِطَاعِتِهٖ"
    },
    {
      "kind": "text",
      "ar": "شُكْرًا شُكْرًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ قَصَدْتُكَ بِحَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاعْتَمَدْتُ عَلَيْكَ بِمَسْأَلَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَجَّهْتُ اِلَيْكَ بِأَئِمَّتِيْ وَسَادَتِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ انْفَعْنَا بِحُبِّهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْرِدْنَا مَوْرِدَهُمْ، وَارْزُقْنَا مُرَافَقَتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَدْخِلْنَا الْجَنَّةَ فِيْ زُمْرَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}