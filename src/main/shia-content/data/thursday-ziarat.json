{
  "id": "thursday-ziarat",
  "title": "زيارت امام عسكري روز جمعرات",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت امام عسكري روز جمعرات",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ وَخَالِصَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا اِمَامَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَوَارِثَ الْمُرْسَلِيْنَ، وَحُجَّةَ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْكَ وَعَلٰي اٰلِ بَيْتِكَ الطَّيِّبِيْنَ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ يَا أَبَا مُحَمَّدٍ الْحَسَنَ بْنَ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "أَنَا مَوْلًى لَكَ وَلِاٰلِ بَيْتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذَا يَوْمُكَ وَهُوَ يَوْمُ الْخَمِيْسِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا ضَيْفُكَ فِيْهِ وَمُسْتَجِيْرٌ بِكَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "فَأَحْسِنْ ضِيَافَتِيْ وَاِجَارَتِيْ"
    },
    {
      "kind": "text",
      "ar": "بِحَقِّ اٰلِ بَيْتِكَ الطَّيِّبِيْنَ الطَّاهِرِيْنَ"
    }
  ]
}