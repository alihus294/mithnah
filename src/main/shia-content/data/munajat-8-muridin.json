{
  "id": "munajat-8-muridin",
  "title": "المناجاة الثامنة — مناجاة المريدين",
  "subtitle": "من المناجاة الخمسة عشر للإمام السجاد عليه السلام",
  "source": "مفاتيح الجنان، المناجاة الخمس عشرة",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "مناجاة المريدين", "subtitle": "المناجاة الثامنة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "سُبْحانَكَ ما أَضْيَقَ الطُّرُقَ عَلَىٰ مَنْ لَمْ تَكُنْ دَلِيلَهُ" },
    { "kind": "text", "ar": "وَما أَوْضَحَ الحَقَّ عِنْدَ مَنْ هَدَيْتَهُ سَبِيلَهُ" },
    { "kind": "text", "ar": "إِلٰهِي فَاسْلُكْ بِنا سُبُلَ الوُصُولِ إِلَيْكَ" },
    { "kind": "text", "ar": "وَسَيِّرْنا فِي أَقْرَبِ الطُّرُقِ لِلْوُفُودِ عَلَيْكَ" },
    { "kind": "text", "ar": "قَرِّبْ عَلَيْنا البَعِيدَ" },
    { "kind": "text", "ar": "وَسَهِّلْ عَلَيْنا العَسِيرَ الشَّدِيدَ" },
    { "kind": "text", "ar": "وَأَلْحِقْنا بِعِبادِكَ الَّذِينَ هُمْ بِالبِدارِ إِلَيْكَ يُسارِعُونَ" },
    { "kind": "text", "ar": "وَبابَكَ عَلَىٰ الدَّوامِ يَطْرُقُونَ" },
    { "kind": "text", "ar": "وَإِيَّاكَ فِي اللَّيْلِ وَالنَّهارِ يَعْبُدُونَ" },
    { "kind": "text", "ar": "وَهُمْ مِنْ هَيْبَتِكَ مُشْفِقُونَ" },
    { "kind": "text", "ar": "الَّذِينَ صَفَّيْتَ لَهُمُ المَشارِبَ" },
    { "kind": "text", "ar": "وَبَلَّغْتَهُمُ الرَّغائِبَ، وَأَنْجَحْتَ لَهُمُ المَطالِبَ" },
    { "kind": "text", "ar": "وَقَضَيْتَ لَهُمْ مِنْ فَضْلِكَ المَآرِبَ" },
    { "kind": "text", "ar": "وَمَلَأْتَ لَهُمْ ضَمائِرَهُمْ مِنْ حُبِّكَ" },
    { "kind": "text", "ar": "وَرَوَّيْتَهُمْ مِنْ صافِي شِرْبِكَ" },
    { "kind": "text", "ar": "فَبِكَ إِلَىٰ لَذِيذِ مُناجاتِكَ وَصَلُوا" },
    { "kind": "text", "ar": "وَمِنْكَ أَقْصَىٰ مَقاصِدِهِمْ حَصَّلُوا" },
    { "kind": "text", "ar": "فَيا مَنْ هُوَ عَلَىٰ المُقْبِلِينَ عَلَيْهِ مُقْبِلٌ" },
    { "kind": "text", "ar": "وَبِالعَطْفِ عَلَيْهِمْ عائِدٌ مُفْضِلٌ" },
    { "kind": "text", "ar": "وَبِالغافِلِينَ عَنْ ذِكْرِهِ رَحِيمٌ رَؤُوفٌ" },
    { "kind": "text", "ar": "وَبِجَذْبِهِمْ إِلَىٰ بابِهِ وَدُودٌ عَطُوفٌ" },
    { "kind": "text", "ar": "أَسْأَلُكَ أَنْ تَجْعَلَنِي مِنْ أَوْفَرِهِمْ مِنْكَ حَظّاً" },
    { "kind": "text", "ar": "وَأَعْلاهُمْ عِنْدَكَ مَنْزِلاً" },
    { "kind": "text", "ar": "وَأَجْزَلِهِمْ مِنْ وُدِّكَ قِسْماً" },
    { "kind": "text", "ar": "وَأَفْضَلِهِمْ فِي مَعْرِفَتِكَ نَصِيباً" },
    { "kind": "text", "ar": "فَقَدِ انْقَطَعَتْ إِلَيْكَ هِمَّتِي" },
    { "kind": "text", "ar": "وَانْصَرَفَتْ نَحْوَكَ رَغْبَتِي" },
    { "kind": "text", "ar": "فَأَنْتَ لا غَيْرُكَ مُرادِي" },
    { "kind": "text", "ar": "وَلَكَ لا لِسِواكَ سَهَرِي وَسُهادِي" },
    { "kind": "text", "ar": "وَلِقاؤُكَ قُرَّةُ عَيْنِي، وَوَصْلُكَ مُنَىٰ نَفْسِي" },
    { "kind": "text", "ar": "وَإِلَيْكَ شَوْقِي، وَفِي مَحَبَّتِكَ وَلَهِي" },
    { "kind": "text", "ar": "وَإِلَىٰ هَواكَ صَبابَتِي، وَرِضاكَ بُغْيَتِي" },
    { "kind": "text", "ar": "وَرُؤْيَتُكَ حاجَتِي، وَجِوارُكَ طَلَبِي" },
    { "kind": "text", "ar": "وَقُرْبُكَ غايَةُ سُؤْلِي" },
    { "kind": "text", "ar": "وَفِي مُناجاتِكَ رَوْحِي وَراحَتِي" },
    { "kind": "text", "ar": "وَعِنْدَكَ دَواءُ عِلَّتِي، وَشِفاءُ غُلَّتِي" },
    { "kind": "text", "ar": "وَبَرْدُ لَوْعَتِي، وَكَشْفُ كُرْبَتِي" },
    { "kind": "text", "ar": "فَكُنْ أَنِيسِي فِي وَحْشَتِي" },
    { "kind": "text", "ar": "وَمُقِيلَ عَثْرَتِي، وَغافِرَ زَلَّتِي" },
    { "kind": "text", "ar": "وَقابِلَ تَوْبَتِي، وَمُجِيبَ دَعْوَتِي" },
    { "kind": "text", "ar": "وَوَلِيَّ عِصْمَتِي، وَمُغْنِيَ فاقَتِي" },
    { "kind": "text", "ar": "وَلا تَقْطَعْنِي عَنْكَ، وَلا تُبْعِدْنِي مِنْكَ" },
    { "kind": "text", "ar": "يا نَعِيمِي وَجَنَّتِي، وَيا دُنْيايَ وَآخِرَتِي" },
    { "kind": "text", "ar": "يا أَرْحَمَ الرَّاحِمِينَ" }
  ]
}
