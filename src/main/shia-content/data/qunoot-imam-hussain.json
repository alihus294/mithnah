{
  "id": "qunoot-imam-hussain",
  "title": "۱۱۔ قنوت امام حسين",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۱۔ قنوت امام حسين",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَنْ اٰوٰي اِلٰي مَأْوًي فَأَنْتَ مَأْوَايَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ لَجَا اِلٰي مَلْجًا فَأَنْتَ مَلْجَايَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاسْمَعْ نِدَائِيْ وَأَجِبْ دُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ مَاٰبِيْ عِنْدَكَ وَمَثْوَايَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْرُسْنِيْ فِيْ بَلْوَايَ"
    },
    {
      "kind": "text",
      "ar": "مِنِ افْتِنَانِ الْاِمْتِحَانِ وَلَمَّةِ الشَّيْطَانِ"
    },
    {
      "kind": "text",
      "ar": "بِعَظَمَتِكَ الَّتِيْ لَا يَشُوْبُهَا وَلَعُ نَفْسٍ بِتَفْتِيْنٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا وَارِدُ طَيْفٍ بِتَظْنِيْنٍ، وَلَا يَلُمُّ بِهَا فَرَحٌ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تَقْلِبَنِيْ اِلَيْكَ بِاِرَادَتِكَ"
    },
    {
      "kind": "text",
      "ar": "غَيْرَ ظَنِيْنٍ وَلَا مَظْنُوْنٍ وَلَا مُرَابٍ وَلَا مُرْتَاب"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَرْحَمُ الرَّاحِمِيْنَ"
    }
  ]
}