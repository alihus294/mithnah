{
  "id": "sura-kafiroon",
  "title": "سورۂ كافرون",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ كافرون",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "قُلْ يٰۤاَيُّهَا الْكٰفِرُوْنَۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "لَاۤ اَعْبُدُ مَا تَعْبُدُوْنَۙ۝۲"
    },
    {
      "kind": "text",
      "ar": "وَلَاۤ اَنْتُمْ عٰبِدُوْنَ مَاۤ اَعْبُدُۚ۝۳"
    },
    {
      "kind": "text",
      "ar": "وَلَاۤ اَنَا عَابِدٌ مَّا عَبَدْتُّمْۙ۝۴"
    },
    {
      "kind": "text",
      "ar": "وَلَاۤ اَنْتُمْ عٰبِدُوْنَ مَاۤ اَعْبُدُؕ۝۵"
    },
    {
      "kind": "text",
      "ar": "لَكُمْ دِيْنُكُمْ وَلِيَ دِيْنِ۠۝۶"
    }
  ]
}