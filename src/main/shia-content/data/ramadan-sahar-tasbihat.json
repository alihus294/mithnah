{
  "id": "ramadan-sahar-tasbihat",
  "title": "تسبيحات سحر",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تسبيحات سحر",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ يَعْلَمُ جَوَارِحَ الْقُلُوْبِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ يُحْصِيْ عَدَدَ الذُّنُوْبِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا يَخْفٰي عَلَيْهِ خَافِيَةٌ فِي السَّمَاوَاتِ وَالْاَرَضِيْنَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الرَّبِّ الْوَدُوْدِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْفَرْدِ الْوِتْرِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْعَظِيْمِ الْاَعْظَمِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا يَعْتَدِيْ عَلٰي أَهْلِ مَمْلَكَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا يُؤَاخِذُ أَهْلَ الْاَرْضِ بِأَلْوَانِ الْعَذَابِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْحَنَّانِ الْمَنَّانِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الرَّؤُوْفِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْجَبَّارِ الْجَوَادِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْكَرِيْمِ الْحَلِيْمِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْبَصِيْرِ الْعَلِيْمِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْبَصِيْرِ الْوَاسِعِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ عَلٰي اِقْبَالِ النَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ عَلٰي اِدْبَارِ النَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ عَلٰي اِدْبَارِ اللَّيْلِ وَاِقْبَالِ النَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "وَلَهُ الْحَمْدُ وَالْمَجْدُ وَالْعَظَمَةُ وَالْكِبْرِيَاءُ"
    },
    {
      "kind": "text",
      "ar": "مَعَ كُلِّ نَفَسٍ وَكُلِّ طَرْفَةِ عَيْنٍ"
    },
    {
      "kind": "text",
      "ar": "وَكُلِّ لَمْحَةٍ سَبَقَ فِيْ عِلْمِهٖ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ مِلْئَ مَا أَحْصٰي كِتَابُكَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ زِنَةَ عَرْشِكَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ سُبْحَانَكَ سُبْحَانَكَ"
    }
  ]
}