{
  "id": "ziarat-kazmain-common",
  "title": "ائمۂ كاظمين كي مشترك زيارات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ائمۂ كاظمين كي مشترك زيارات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نُوْرَ اللهِ فِيْ ظُلُمَاتِ الْاَرَضِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَنْ بَدَا لِلّٰهِ فِيْ شَأْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ زَائِرًا، عَارِفًا بِحَقِّكَ"
    },
    {
      "kind": "text",
      "ar": "مُعَادِيًا لِاَعْدَائِكَ، مُوَالِيًا لِاَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ عِنْدَ رَبِّكَ يَا مَوْلَايَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمَا يَا وَلِيَّيِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمَا يَا حُجَّتَيِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمَا يَا نُوْرَيِ اللهِ فِيْ ظُلُمَاتِ الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكُمَا قَدْ بَلَّغْتُمَا عَنِ اللهِ مَا حَمَّلَكُمَا"
    },
    {
      "kind": "text",
      "ar": "وَحَفِظْتُمَا مَا اسْتُوْدِعْتُمَا"
    },
    {
      "kind": "text",
      "ar": "وَحَلَّلْتُمَا حَلَالَ اللهِ، وَحَرَّمْتُمَا حَرَامَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَقَمْتُمَا حُدُوْدَ اللهِ، وَتَلَوْتُمَا كِتَابَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتُمَا عَلَي الْاَذٰي فِيْ جَنْبِ اللهِ مُحْتَسِبَيْنَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَتَاكُمَا الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "أَبْرَأُ اِلَي اللهِ مِنْ أَعْدَائِكُمَا"
    },
    {
      "kind": "text",
      "ar": "وَأَتَقَرَّبُ اِلَي اللهِ بِوِلَايَتِكُمَا"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكُمَا زَائِرًا، عَارِفًا بِحَقِّكُمَا"
    },
    {
      "kind": "text",
      "ar": "مُوَالِيًا لِاَوْلِيَائِكُمَا، مُعَادِيًا لِاَعْدَائِكُمَا"
    },
    {
      "kind": "text",
      "ar": "مُسْتَبْصِرًا بِالْهُدَي الَّذِيْ أَنْتُمَا عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "عَارِفًا بِضَلَالَةِ مَنْ خَالَفَكُمَا"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعَا لِيْ عِنْدَ رَبِّكُمَا"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ لَكُمَا عِنْدَ اللهِ جَاهًا عَظِيْمًا وَمَقَامًا مَحْمُوْدًا۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمَا يَا حُجَّتَيِ اللهِ فِيْ أَرْضِهٖ وَسَمَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "عَبْدُكُمَا وَوَلِيُّكُمَا زَائِرُكُمَا مُتَقَرِّبًا اِلَي اللهِ بِزِيَارَتِكُمَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ لِيْ لِسَانَ صِدْقٍ فِيْ أَوْلِيَائِكَ الْمُصْطَفَيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَحَبِّبْ اِلَيَّ مَشَاهِدَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مَعَهُمْ فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}