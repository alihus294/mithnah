{
  "id": "dua-namaz-imam3",
  "title": "نماز امام حسين كے بعد دعا",
  "subtitle": "ملحقات مفاتيح الجنان",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز امام حسين كے بعد دعا",
      "subtitle": "ملحقات مفاتيح الجنان"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الَّذِي اسْتَجَبْتَ لِاٰدَمَ وَحَوَّاءَ"
    },
    {
      "kind": "text",
      "ar": "اِذْ قَالَا رَبَّنَا ظَلَمْنَا أَنْفُسَنَا"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ لَمْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُوْنَنَّ مِنَ الْخَاسِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَنَادَاكَ نُوْحٌ فَاسْتَجَبْتَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَنَجَّيْتَهٗ وَأَهْلَهٗ مِنَ الْكَرْبِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَطْفَأْتَ نَارَ نُمْرُوْدَ عَنْ خَلِيْلِكَ اِبْرَاهِيْمَ"
    },
    {
      "kind": "text",
      "ar": "فَجَعَلْتَهَا بَرْدًا وَسَلَامًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الَّذِي اسْتَجَبْتَ لِاَيُّوْبَ اِذْ نَادٰي"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ مَسَّنِيَ الضُّرُّ وَأَنْتَ أَرْحَمُ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَكَشَفْتَ مَا بِهٖ مِنْ ضُرٍّ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتَيْتَهٗ أَهْلَهٗ وَمِثْلَهُمْ مَعَهُمْ رَحْمَةً مِنْ عِنْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَذِكْرٰي لِاُولِي الْاَلْبَابِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الَّذِي اسْتَجَبْتَ لِذِي النُّوْنِ حِيْنَ نَادَاكَ فِي الظُّلُمَاتِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ لَا اِلٰهَ اِلَّا أَنْتَ سُبْحَانَكَ، اِنِّيْ كُنْتُ مِنَ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَنَجَّيْتَهٗ مِنَ الْغَمِّ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الَّذِي اسْتَجَبْتَ لِمُوْسٰي وَهَارُوْنَ دَعْوَتَهُمَا"
    },
    {
      "kind": "text",
      "ar": "حِيْنَ قُلْتَ قَدْ أُجِيْبَتْ دَعْوَتُكُمَا فَاسْتَقِيْمَا"
    },
    {
      "kind": "text",
      "ar": "وَأَغْرَقْتَ فِرعَوْنَ وَقَوْمَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَغَفَرْتَ لِدَاوُوْدَ ذَنْبَهٗ وَتُبْتَ عَلَيْهِ رَحْمَةً مِنْكَ وَذِكْرٰي"
    },
    {
      "kind": "text",
      "ar": "وَفَدَيْتَ اِسْمَاعِيْلَ بِذِبْحٍ عَظِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "بَعْدَ مَا أَسْلَمَ وَتَلَّهٗ لِلْجَبِيْنِ"
    },
    {
      "kind": "text",
      "ar": "فَنَادَيْتَهٗ بِالْفَرَجِ وَالرَّوْحِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الَّذِيْ نَادَاكَ زَكَرِيَّا نِدَاءً خَفِيًّا"
    },
    {
      "kind": "text",
      "ar": "فَقَالَ رَبِّ اِنِّيْ وَهَنَ الْعَظْمُ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَاشْتَعَلَ الرَّأْسُ شَيْبًا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ أَكُنْ بِدُعَائِكَ رَبِّ شَقِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَقُلْتَ يَدْعُوْنَنَا رَغَبًا وَرَهَبًا وَكَانُوْا لَنَا خَاشِعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الَّذِي اسْتَجَبْتَ لِلَّذِيْنَ اٰمَنُوْا وَعَمِلُوا الصَّالِحَاتِ"
    },
    {
      "kind": "text",
      "ar": "لِتَزِيْدَهُمْ مِنْ فَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَجْعَلْنِيْ مِنْ أَهْوَنِ الدَّاعِيْنَ لَكَ وَالرَّاغِبِيْنَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَجِبْ لِيْ كَمَا اسْتَجَبْتَ لَهُمْ بِحَقِّهِمْ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَطَهِّرْنِيْ بِتَطْهِيْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَقَبَّلْ صَلَاتِيْ وَدُعَائِيْ بِقَبُوْلٍ حَسَنٍ"
    },
    {
      "kind": "text",
      "ar": "وَطَيِّبْ بَقِيَّةَ حَيَاتِيْ، وَطَيِّبْ وَفَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاخْلُفْنِيْ فِيْمَنْ أَخْلُفُ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْنِيْ يَارَبِّ بِدُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ ذُرِّيَّتِيْ ذُرِّيَّةً طَيِّبَةً، تَحُوْطُهَا بِحِيَاطَتِكَ"
    },
    {
      "kind": "text",
      "ar": "بِكُلِّ مَا حُطْتَ بِهٖ ذُرِّيَّةَ أَحَدٍ مِنْ أَوْلِيَائِكَ وَأَهْلِ طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ هُوَ عَلٰي كُلِّ شَيْءٍ رَقِيْبٌ"
    },
    {
      "kind": "text",
      "ar": "وَلِكُلِّ دَاعٍ مِنْ خَلْقِكَ مُجِيْبٌ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ سَائِلٍ قَرِيْبٌ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ يَا لَا اِلٰهَ اِلَّا أَنْتَ الْحَيُّ الْقَيُّوْمُ"
    },
    {
      "kind": "text",
      "ar": "الْاَحَدُ الصَّمَدُ الَّذِيْ لَمْ يَلِدْ وَلَمْ يُوْلَدْ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ كُفُوًا أَحَدٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِكُلِّ اسْمٍ رَفَعْتَ بِهٖ سَمَائَكَ، وَفَرَشْتَ بِهٖ أَرْضَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْسَيْتَ بِهِ الْجِبَالَ، وَأَجْرَيْتَ بِهِ الْمَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَسَخَّرْتَ بِهِ السَّحَابَ وَالشَّمْسَ وَالْقَمَرَ"
    },
    {
      "kind": "text",
      "ar": "وَالنُّجُوْمَ وَاللَّيْلَ وَالنَّهَارَ"
    },
    {
      "kind": "text",
      "ar": "وَخَلَقْتَ الْخَلَائِقَ كُلَّهَا"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِعَظَمَةِوَجْهِكَ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ أَشْرَقَتْ لَهُ السَّمٰوَاتُ وَالْاَرْضُ فَأَضَائَتْ بِهِ الظُّلُمَاتُ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا صَلَّيْتَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَكَفَيْتَنِيْ أَمْرَ مَعَاشِيْ وَمَعَادِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْلَحْتَ لِيْ شَأْنِيْ كُلَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ تَكِلْنِيْ اِلٰي نَفْسِيْ طَرْفَةَ عَيْنٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْلَحْتَ أَمْرِيْ وَأَمْرَ عِيَالِيْ، وَكَفَيْتَنِيْ هَمَّهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَغْنَيْتَنِيْ وَاِيَّاهُمْ مِنْ كَنْزِكَ وَخَزَائِنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَسَعَةِ فَضْلِكَ الَّذِيْ لَا يَنْفَدُ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَثْبِتْ فِيْ قَلْبِيْ يَنَابِيْعَ الْحِكْمَةِ الَّتِيْ تَنْفَعُنِيْ بِهَا"
    },
    {
      "kind": "text",
      "ar": "وَتَنْفَعُ بِهَا مَنِ ارْتَضَيْتَ مِنْ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لِيْ مِنَ الْمُتَّقِيْنَ فِيْ اٰخِرِ الزَّمَانِ اِمَامًا"
    },
    {
      "kind": "text",
      "ar": "كَمَا جَعَلْتَ اِبْرَاهِيْمَ الْخَلِيْلَ اِمَامًا"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ بِتَوْفِيْقِكَ يَفُوْزُ الْفَائِزُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَتُوْبُ التَّائِبُوْنَ، وَيَعْبُدُكَ الْعَابِدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِتَسْدِيْدِكَ يَصْلُحُ الصَّالِحُوْنَ الْمُحْسِنُوْنَ الْمُخْبِتُوْنَ"
    },
    {
      "kind": "text",
      "ar": "الْعَابِدُوْنَ لَكَ، الْخَائِفُوْنَ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِاِرْشَادِكَ نَجَي النَّاجُوْنَ مِنْ نَارِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْفَقَ مِنْهَا الْمُشْفِقُوْنَ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِخِذْلَانِكَ خَسِرَ الْمُبْطِلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَهَلَكَ الظَّالِمُوْنَ، وَغَفَلَ الْغَافِلُوْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اٰتِ نَفْسِيْ تَقْوَاهَا فَأَنْتَ وَلِيُّهَا وَمَوْلَاهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ خَيْرُ مَنْ زَكَّاهَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بَيِّنْ لَهَا هُدَاهَا، وَأَلْهِمْهَا تَقْوَاهَا"
    },
    {
      "kind": "text",
      "ar": "وَبَشِّرْهَا بِرَحْمَتِكَ حِيْنَ تَتَوَفَّاهَا"
    },
    {
      "kind": "text",
      "ar": "وَنَزِّلْهَا مِنَ الْجِنَانِ عُلْيَاهَا"
    },
    {
      "kind": "text",
      "ar": "وَطَيِّبْ وَفَاتَهَا وَمَحْيَاهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَكْرِمْ مُنْقَلَبَهَا وَمَثْوَاهَا وَمُسْتَقَرَّهَا وَمَأْوَاهَا"
    },
    {
      "kind": "text",
      "ar": "فَأَنْتَ وَلِيُّهَا وَمَوْلَاهَا۔"
    }
  ]
}