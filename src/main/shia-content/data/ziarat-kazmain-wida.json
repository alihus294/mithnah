{
  "id": "ziarat-kazmain-wida",
  "title": "زيارتِ وداعِ كاظمين",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارتِ وداعِ كاظمين",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ يَا أَبَا الْحَسَنِ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْدِعُكَ اللهَ وَأَقْرَأُ عَلَيْكَ السَّلَامَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنَّا بِاللّٰهِ وَبِالرَّسُوْلِ وَبِمَا جِئْتَ بِهٖ وَدَلَلْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اكْتُبْنَا مَعَ الشَّاهِدِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ يَابْنَ رَسُوْلِ الله وَرَحْمَةُ الله وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْدِعُكَ اللهَ وَأَقْرَأُ عَلَيْكَ السَّلَامَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنَّا بِاللّٰهِ وَبِرَسُوْلِهٖ وَبِمَا جِئْتَ بِهٖ وَدَلَلْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اكْتُبْنَا مَعَ الشَّاهِدِيْنَ۔"
    }
  ]
