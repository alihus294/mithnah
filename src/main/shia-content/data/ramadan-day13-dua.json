{
  "id": "ramadan-day13-dua",
  "title": "تيرهويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تيرهويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ طَهِّرْنِيْ فِيْهِ مِنَ الدَّنَسِ وَالْاَقْذَارِ"
    },
    {
      "kind": "text",
      "ar": "وَصَبِّرْنِيْ فِيْهِ عَلٰي كَائِنَاتِ الْاَقْدَارِ"
    },
    {
      "kind": "text",
      "ar": "وَوَفِّقْنِيْ فِيْهِ لِلتُّقٰي وَصُحْبَةِ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "بِعَوْ نِكَ يَا قُرَّةَ عَيْنِ الْمَسَاكِيْنِ۔"
    }
  ]
}