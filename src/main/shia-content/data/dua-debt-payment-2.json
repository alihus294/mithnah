{
  "id": "dua-debt-payment-2",
  "title": "۲۵۔ ادائيگئ قرض كي دعا",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۲۵۔ ادائيگئ قرض كي دعا",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا فَارِجَ الْهَمِّ وَمُنَفِّسَ الْغَمِّ"
    },
    {
      "kind": "text",
      "ar": "وَمُذْهِبَ الْاَحْزَانِ، وَمُجِيْبَ دَعْوَةِ الْمُضْطَرِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحْمٰنَ الدُّنْيَا وَالْاٰخِرَةِ وَرَحِيْمَهُمَا"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ رَحْمَانِيْ وَرَحْمٰنُ عَلٰي كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "فَارْحَمْنِيْ رَحْمَةً تُغْنِيْنِيْ بِهَا عَنْ رَحْمَةِ مَنْ سِوَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَقْضِيْ بِهَا عَنِّي الدَّيْنَ"
    }
  ]
}