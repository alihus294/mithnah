{
  "id": "ziarat-imam-askari",
  "title": "امام حسن عسكري كي زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام حسن عسكري كي زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ يَا أَبَا مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "الْحَسَنِ بْنَ عَلِيٍّ الْهَادِي الْمُهْتَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ وَابْنَ أَوْلِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ وَابْنَ حُجَجِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا صَفِيَّ اللهِ وَابْنَ أَصْفِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا خَلِيْفَةَ اللهِ وَابْنَ خُلَفَائِهٖ وَأَبَا خَلِيْفَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ خَاتَمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ سَيِّدِ الْوَصِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ سَيِّدَةِ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الْاَئِمَّةِ الْهَادِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الْاَوْصِيَاءِ الرَّاشِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا عِصْمَةَ الْمُتَّقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا اِمَامَ الْفَائِزِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا رُكْنَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا فَرَجَ الْمَلْهُوْفِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَارِثَ الْاَنْبِيَاءِ الْمُنْتَجَبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا خَازِنَ عِلْمِ وَصِيِّ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الدَّاعِيْ بِحُكْمِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا النَّاطِقُ بِكِتَابِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ الْحُجَجِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا هَادِيَ الْأُمَمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ النِّعَمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا عَيْبَةَ الْعِلْمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا سَفِيْنَةَ الْحِلْمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَبَا الْاِمَامِ الْمُنْتَظَرِ"
    },
    {
      "kind": "text",
      "ar": "الظَّاهِرَةِ لِلْعَاقِلِ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَالثَّابِتَةٖ فِي الْيَقِيْنِ مَعْرِفَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "الْمُحْتَجَبِ عَنْ أَعْيُنِ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُغَيَّبِ عَنْ دَوْلَةِ الْفَاسِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُعِيْدِ رَبُّنَا بِهِ الْاِسْلَامَ جَدِيْدًا بَعْدَ الْاِنْطِمَاسِ"
    },
    {
      "kind": "text",
      "ar": "وَالْقُرْاٰنَ غَضًّا بَعْدَ الْاِنْدِرَاسِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ يَامَوْلَايَ أَنَّكَ أَقَمْتَ الصَّلَاةَ، وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ، وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَوْتَ اِلٰي سَبِيْلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَبَدْتَ اللهَ مُخْلِصًا حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُ اللهَ بِالشَّأْنِ الَّذِيْ لَكُمْ عِنْدَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَنْ يَتَقَبَّلَ زِيَارَتِيْ لَكُمْ، وَيَشْكُرَ سَعْيِيْ اِلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَيَسْتَجِيْبَ دُعَائِيْ بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَيَجْعَلَنِيْ مِنْ أَنْصَارِ الْحَقِّ وَأَتْبَاعِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْيَاعِهٖ وَمَوَالِيْهِ وَمُحِبِّيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي سَيِّدِنَا مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلَي الْحَسَنِ بْنِ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "الْهَادِيْ اِلٰي دِيْنِكَ، وَالدَّاعِيْ اِلٰي سَبِيْلِكَ"
    },
    {
      "kind": "text",
      "ar": "عَلَمِ الْهُدٰي، وَمَنَارِ التُّقٰي"
    },
    {
      "kind": "text",
      "ar": "وَمَعْدِنِ الْحِجٰي، وَمأْوَي النُّهٰي"
    },
    {
      "kind": "text",
      "ar": "وَغَيْثِ الْوَرٰي، وَسَحَابِ الْحِكْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَبَحْرِ الْمَوْعِظَةِ، وَوَارِثِ الْاَئِمَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَالشَّهِيْدِ عَلَي الْأُمَّةِ"
    },
    {
      "kind": "text",
      "ar": "الْمَعْصُوْمِ الْمُهَذَّبِ، وَالْفَاضِلِ الْمُقَرَّبِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُطَهَّرِ مِنَ الرِّجْسِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ وَرَّثْتَهٗ عِلْمَ الْكِتَابِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْهَمْتَهٗ فَصْلَ الْخِطَابِ"
    },
    {
      "kind": "text",
      "ar": "وَنَصَبْتَهٗ عَلَمًا لِاَهْلِ قِبْلَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَرَنْتَ طَاعَتَهٗ بِطَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفَرَضْتَ مَوَدَّتَهٗ عَلٰي جَمِيْعِ خَلِيْقَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ فَكَمَا أَنَابَ بِحُسْنِ الْاِخْلَاصِ فِيْ تَوْحِيْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْدٰي مَنْ خَاضَ فِيْ تَشْبِيْهِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَامٰي عَنْ أَهْلِ الْاِيْمَانِ بِكَ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ يَا رَبَّ عَلَيْهِ صَلَاةً يَلْحَقُ بِهَا مَحَلَّ الْخَاشِعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَعْلُوْ فِي الْجَنَّةِ بِدَرَجَةِ جَدِّهٖ خَاتَمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْهُ مِنَّا تَحِيَّةً وَسَلَامًا"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا مِنْ لَدُنْكَ فِيْ مُوَالَاتِهٖ فَضْلًا وَاِحْسَانًا"
    },
    {
      "kind": "text",
      "ar": "وَمَغْفِرَةً وَرِضْوَانًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ ذُوْ فَضْلٍ عَظِيْمٍ وَمَنٍّ جَسِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "يَا دَائِمُ يَا دَيْمُوْمُ، يَا حَيُّ يَا قَيُّوْمُ"
    },
    {
      "kind": "text",
      "ar": "يَا كَاشِفَ الْكَرْبِ وَالْهَمِّ، وَيَا فَارِجَ الْغَمِّ"
    },
    {
      "kind": "text",
      "ar": "وَيَا بَاعِثَ الرُّسُلِ، وَيَا صَادِقَ الْوَعْدِ"
    },
    {
      "kind": "text",
      "ar": "وَيَا حَيُّ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "أَتَوَسَّلُ اِلَيْكَ بِحَبِيْبِكَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَوَصِيِّهٖ عَلِيٍّ، ابْنِ عَمِّهٖ وَصِهْرِهٖ عَلَي ابْنَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ خَتَمْتَ بِهِمَا الشَّرَائِعَ"
    },
    {
      "kind": "text",
      "ar": "وَفَتَحْتَ بِهِمَا التَّأْوِيْلَ وَالطَّلَائِعَ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِمَا صَلَاةً يَشْهَدُ بِهَا الْاَوَّلُوْنَ وَالْاٰخِرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَنْجُوْ بِهَا الْاَوْلِيَاءُ وَالصَّالِحُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَسَّلُ اِلَيْكَ بِفَاطِمَةَ الزَّهْرَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَالِدَةِ الْاَئِمَّةِ الْمَهْدِيِّيْنَ، وَسَيِّدَةِ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمُشَفَّعَةِ فِيْ شِيْعَةِ أَوْلَادِهَا الطَّيِّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهَا صَلَاةً دَائِمَةً أَبَدَ الْاٰبِدِيْنَ وَدَهْرَ الدَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَسَّلُ اِلَيْكَ بِالْحَسَنِ الرَّضِيِّ الطَّاهِرِ الزَّكِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَالْحُسَيْنِ الْمَظْلُوْمِ الْمَرْضِيِّ الْبَرِّ التَّقِيِّ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدَيْ شَبَابِ أَهْلِ الْجَنَّةِ"
    },
    {
      "kind": "text",
      "ar": "الْاِمَامَيْنِ الْخَيِّرَيْنِ الطَّيِّبَيْنِ"
    },
    {
      "kind": "text",
      "ar": "التَّقِيَّيْنِ النَّقِيَّيْنِ الطَّاهِرَيْنِ"
    },
    {
      "kind": "text",
      "ar": "الشَّهِيْدَيْنِ الْمَظْلُوْمَيْنِ الْمَقْتُوْلَيْنِ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِمَا مَا طَلَعَتْ شَمْسٌ وَمَا غَرَبَتْ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً مُتَوَالِيَةً مُتَتَالِيَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَسَّلُ اِلَيْكَ بِعَلِيِّ بْنِ الْحُسَيْنِ سَيِّدِ الْعَابِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمَحْجُوْبِ مِنْ خَوْفِ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِمُحَمَّدِ بْنِ عَلِيٍّ الْبَاقِرِ الطَّاهِرِ النُّوْرِ الزَّاهِرِ"
    },
    {
      "kind": "text",
      "ar": "الْاِمَامَيْنِ السَّيِّدَيْنِ"
    },
    {
      "kind": "text",
      "ar": "مِفْتَاحَيِ الْبَرَكَاتِ وَمِصْبَاحَيِ الظُّلُمَاتِ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِمَا مَا سَرٰي لَيْلٌ وَمَا أَضَاءَ نَهَارٌ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً تَغْدُوْ وَتَرُوْحُ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَسَّلُ اِلَيْكَ بِجَعْفَرِ بْنِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "الصَّادِقِ عَنِ اللهِ، وَالنَّاطِقِ فِيْ عِلْمِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَبِمُوْسَي بْنِ جَعْفَرٍ الْعَبْدِ الصَّالِحِ فِيْ نَفْسِهٖ وَالْوَصِيِّ النَّاصِحِ"
    },
    {
      "kind": "text",
      "ar": "الْاِمَامَيْنِ الْهَادِيَيْنِ الْمَهْدِيَّيْنِ الْوَافِيَيْنِ الْكَافِيَيْنِ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِمَا مَا سَبَّحَ لَكَ مَلَكٌ، وَتَحَرَّكَ لَكَ فَلَكٌ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً تُنْمٰي وَتَزِيْدُ، وَلَا تَفْنٰي وَلَا تَبِيْدُ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَسَّلُ اِلَيْكَ بِعَلِيِّ بْنِ مُوْسَي الرِّضَا"
    },
    {
      "kind": "text",
      "ar": "وَبِمُحَّمَدِ بْنِ عَلِيٍّ الْمُرْتَضَي"
    },
    {
      "kind": "text",
      "ar": "الْاِمَامَيْنِ الْمُطَهَّرَيْنِ الْمُنْتَجَبَيْنِ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِمَا مَا أَضَاءَ صُبْحٌ وَدَامَ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً تُرَقِّيْهِمَا اِلٰي رِضْوَانِكَ فِي الْعِلِّيِّيْنَ مِنْ جِنَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَسَّلُ اِلَيْكَ بِعَليِّ بْنِ مُحَمَّدٍ الرَّاشِدِ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنِ بْنِ عَلِيٍّ الْهَادِيْ"
    },
    {
      "kind": "text",
      "ar": "الْقَائِمَيْنِ بِأَمْرِ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "الْمُخْتَبَرَيْنِ بِالْمِحَنِ الْهَائِلَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالصَّابِرَيْنِ فِي الْاِحَنِ الْمَائِلَةِ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِمَا كِفَاءَ أَجْرِ الصَّابِرِيْنَ وَاِزَاءَ ثَوَابِ الْفَائِزِيْنَ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً تُمَهِّدُ لَهُمَا الرِّفْعَةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَسَّلُ اِلَيْكَ يَارَبَّ بِاِمَامِنَا وَمُحَقِّقِ زَمَانِنَا"
    },
    {
      "kind": "text",
      "ar": "الْيَوْمِ الْمَوْعُوْدِ وَالشَّاهِدِ الْمَشْهُوْدِ"
    },
    {
      "kind": "text",
      "ar": "وَالنُّوْرِ الْاَزْهَرِ وَالضِّيَاءِ الْاَنْوَرِ"
    },
    {
      "kind": "text",
      "ar": "الْمَنْصُوْرِ بِالرُّعْبِ وَالْمُظَفَّرِ بِالسَّعَادَةِ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِ عَدَدَ الثَّمَرِ، وَأَوْرَاقِ الشَّجَرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْزَاءِ الْمَدَرِ، وَعَدَدَ الشَّعْرِ وَالْوَبَرِ"
    },
    {
      "kind": "text",
      "ar": "وَعَدَدَ مَا أَحَاطَ بِهٖ عِلْمُكَ وَأَحْصَاهُ كِتَابُكَ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً يَغْبِطُهٗ بِهَا الْاَوَّلُوْنَ وَالْاٰخِرُوْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاحْشُرْنَا فِيْ زُمْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْنَا عَلٰي طَاعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْرُسْنَا بِدَوْلَتِهٖ، وَأَتْحِفْنَا بِوِلَايَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْنَا عَلٰي أَعْدَائِنَا بِعِزَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا يَارَبِّ مِنَ التَّوَابِيْنَ، يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاِنَّ اِبْلِيْسَ الْمُتَمَرِّدَ اللَّعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "قَدِ اسْتَنْظَرَكَ لِاِغْوَاءِ خَلْقِكَ  فَأَنْظَرْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَمْهَلَكَ لِاِضْلَالِ عَبِيْدِكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَمْهَلْتَهٗ بِسَابِقِ عِلْمِكَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ عَشَّشَ، وَكَثُرَتْ جُنُوْدُهٗ، وَازْدَحَمَتْ جُيُوْشُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَانْتَشَرَتْ دُعَاتُهٗ فِيْ أَقْطَارِ الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "فَأَضَلُّوْا عِبَادَكَ، وَأَفْسَدُوْا دِيْنَكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَرَّفُوا الْكَلِمَ عَنْ مَوَاضِعِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلُوْا عِبَادَكَ شِيَعًا مُتَفَرِّقِيْنَ وأَحْزَابًا مُتَمَرِّدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ وَعَدْتَ نَقْضَ بُنْيَانِهٖ وَتَمْزِيْقَ شَأْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَأَهْلِكْ أَوْلَادَهٗ وَجُيُوْشَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَطَهِّرْ بِلَادَكَ مِنِ اخْتِرَاعَاتِهٖ وَاخْتِلَافَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَرِحْ عِبَادَكَ مِنْ مَذَاهِبِهٖ وَقِيَاسَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ دَائِرَةَ السَّوْءِ عَلَيْهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَابْسُطْ عَدْلَكَ، وَأَظْهِرْ دِيْنَكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَوِّ أَوْلِيَائَكَ، وَأَوْهِنْ أَعْدَائَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْرِثْ دِيَارَ اِبْلِيْسَ وَدِيَارَ أَوْلِيَائِهٖ أَوْلِيَائَكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَلِّدْهُمْ فِي الْجَحِيْمِ، وَأَذِقْهُمْ مِنَ الْعَذَابِ الْاَلِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لَعَائِنَكَ الْمُسْتَوْدَعَةَ فِيْ مَنَاحِسِ الْخِلْقَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمَشَاوِيْهِ الْفِطْرَةِ دَائِرَةً عَلَيْهِمْ وَمُوَكَّلَةً بِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَجَارِيَةً فِيْهِمْ كُلَّ صَبَاحٍ وَمَسَاءٍ وَغُدُوٍّ وَرَوَاحٍ"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا اٰتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْاٰخِرَةِ حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِنَا بِرَحْمَتِكَ عَذَابَ النَّارِ، يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}