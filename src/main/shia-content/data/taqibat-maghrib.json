{
  "id": "taqibat-maghrib",
  "title": "نمازِ مغرب",
  "subtitle": "تعقيبات الصلاة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نمازِ مغرب",
      "subtitle": "تعقيبات الصلاة"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ وَمَلَائِكَتَهٗ يُصَلُّوْنَ عَلَي النَّبِيِّ"
    },
    {
      "kind": "text",
      "ar": "يَا أَيُّهَا الَّذِيْنَ اٰمَنُوْا صَلُّوْا عَلَيْهِ وَسَلِّمُوْا تَسْلِيْمًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ النَّبِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي ذُرِّيَّتِهٖ وَعَلٰي أَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللهِ الْعَلِيِّ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَلْحَمْدُ لِلّٰهِ الَّذِيْ يَفْعَلُ مَا يَشَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَفْعَلُ مَا يَشَاءُ غَيْرُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "اغْفِرْلِيْ ذُنُوْبِيْ كُلَّهَا جَمِيْعًا"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ لَا يَغْفِرُ الذُّنُوْبَ كُلَّهَا جَمِيْعًا اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِوَجْهِكَ الْكَرِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْمِكَ الْعَظِيْمِ، وَمُلْكِكَ الْقَدِيْمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيْ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَغْفِرَ لِيْ ذَنْبِيَ الْعَظِيْمَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ لَا يَغْفِرُ الْعَظِيْمَ اِلَّا الْعَظِيْمُ"
    },
    {
      "kind": "text",
      "ar": "مَا شَاءَ الله، لَا قُوَّةَ اِلَّا بِاللهِ، أَسْتَغْفِرُ اللهَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ مُوْجِبَاتِ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَزَائِمَ مَغْفِرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّجَاةَ مِنَ النَّارِ، وَمِنْ كُلِّ بَلِيَّةٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَوْزَ بِالْجَنَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَالرِّضْوَانَ فِيْ دَارِ السَّلَامِ"
    },
    {
      "kind": "text",
      "ar": "وَجَوَارِ نَبِيِّكَ مُحَمَّدٍ عَلَيْهِ وَاٰلِهِ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَا بِنَا مِنْ نِعْمَةٍ فَمِنْكَ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَغْفِرُكَ وَأَتُوْبُ اِلَيْكَ"
    }
  ]
}