{
  "id": "ziarat-arbaeen",
  "title": "زيارتِ روزِ اربعين",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارتِ روزِ اربعين",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي وَلِيِّ اللهِ وَحَبِيْبِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي خَلِيْلِ اللهِ وَنَجِيْبِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَفِيِّ اللهِ وَابْنِ صَفِيِّهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْحُسَيْنِ الْمَظْلُوْمِ الشَّهِيْدِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَسِيْرِ الْكُرُبَاتِ وَقَتِيْلِ الْعَبَرَاتِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَشْهَدُ أَنَّهٗ وَلِيُّكَ وَابْنُ وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَفِيُّكَ وَابْنُ صَفِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "الْفَائِزُ بِكَرَامَتِكَ"
    },
    {
      "kind": "text",
      "ar": "أَكْرَمْتَهٗ بِالشَّهَادَةِ، وَحَبَوْتَهٗ بِالسَّعَادَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْتَبَيْتَهٗ بِطِيْبِ الْوِلَادَةِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهٗ سَيِّدًا مِنَ السَّادَةِ"
    },
    {
      "kind": "text",
      "ar": "وَقَائِدًا مِنَ الْقَادَةِ، وَذَائِدًا مِنَ الذَّادَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطَيْتَهٗ مَوَارِيْثَ الْاَنْبِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهٗ حُجَّةً عَلٰي خَلْقِكَ مِنَ الْاَوْصِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "فَأَعْذَرَ فِي الدُّعَاءِ، وَمَنَحَ النُّصْحَ"
    },
    {
      "kind": "text",
      "ar": "وَبَذَلَ مُهْجَتَهٗ فِيْكَ"
    },
    {
      "kind": "text",
      "ar": "لِيَسْتَنْقِذَ عِبَادَكَ مِنَ الْجَهَالَةِ، وَحَيْرَةِ الضَّلَالَةِ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ تَوَازَرَ عَلَيْهِ مَنْ غَرَّتْهُ الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "وَبَاعَ حَظَّهٗ بِالْاَرْذَلِ الْاَدْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَشَرٰي اٰخِرَتَهٗ بِالثَّمَنِ الْاَوْكَسِ"
    },
    {
      "kind": "text",
      "ar": "وَتَغَطْرَسَ وَتَرَدّٰي فِيْ هَوَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْخَطَكَ وَأَسْخَطَ نَبِيَّكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَطَاعَ مِنْ عِبَادِكَ أَهْلَ الشِّقَاقِ وَالنِّفَاقِ"
    },
    {
      "kind": "text",
      "ar": "وَحَمَلَةَ الْاَوْزَارِ، الْمُسْتَوْجِبِيْنَ النَّارَ"
    },
    {
      "kind": "text",
      "ar": "فَجَاهَدَهُمْ فِيْكَ صَابِرًا مُحْتَسِبًا"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي سُفِكَ فِيْ طَاعَتِكَ دَمُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتُبِيْحَ حَرِيْمُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَالْعَنْهُمْ لَعْنًا وَبِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَعَذِّبْهُمْ عَذَابًا أَلِيْمًا۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ سَيِّدِ الْاَوْصِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ أَمِيْنُ اللهِ وَابْنُ أَمِيْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "عِشْتَ سَعِيْدًا، وَمَضَيْتَ حَمِيْدًا"
    },
    {
      "kind": "text",
      "ar": "وَمُتَّ فَقِيْدًا، مَظْلُوْمًا شَهِيْدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ اللهَ مُنْجِزٌ مَا وَعَدَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُهْلِكٌ مَنْ خَذَلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُعَذِّبٌ مَنْ قَتَلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ وَفَيْتَ بِعَهْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِيْ سَبِيْلِهٖ حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "فَلَعَنَ اللهُ مَنْ قَتَلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ ظَلَمَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ أُمَّةً سَمِعَتْ بِذٰلِكَ فَرَضِيَتْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أُشْهِدُكَ أَنِّيْ وَلِيٌّ لِمَنْ وَالَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَعَدُوٌّ لِمَنْ عَادَاهُ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتَ وَأُمِّيْ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ كُنْتَ نُوْرًا"
    },
    {
      "kind": "text",
      "ar": "فِي الْاَصْلَابِ الشَّامِخَةِ، وَالْاَرْحَامِ الْمُطَهَّرَةِ"
    },
    {
      "kind": "text",
      "ar": "لَمْ تُنَجِّسْكَ الْجَاهِلِيَّةُ بِأَنْجَاسِهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ تُلْبِسْكَ الْمُدْلَهِمَّاتُ مِنْ ثِيَابِهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ مِنْ دَعَائِمِ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْكَانِ الْمُسْلِمِيْنَ، وَمَعْقِلِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ الْاِمَامُ الْبَرُّ التَّقِيُّ"
    },
    {
      "kind": "text",
      "ar": "الرَّضِيُّ الزَّكِيُّ الْهَادِي الْمَهْدِيُّ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ الْاَئِمَّةَ مِنْ وُلْدِكَ كَلِمَةُ التَّقْوٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَعْلَامُ الْهُدٰي وَالْعُرْوَةُ الْوُثْقٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْحُجَّةُ عَلٰي أَهْلِ الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنِّيْ بِكُمْ مُؤْمِنٌ وَبِاِيَابِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُوْقِنٌ بِشَرَائِعِ دِيْنِيْ وَخَوَاتِيْمِ عَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَلْبِيْ لِقَلْبِكُمْ سِلْمٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَمْرِيْ لِاَمْرِكُمْ مُتَّبِعٌ"
    },
    {
      "kind": "text",
      "ar": "وَنُصْرَتِيْ لَكُمْ مُعَدَّةٌ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي يَأْذَنَ اللهُ لَكُمْ"
    },
    {
      "kind": "text",
      "ar": "فَمَعَكُمْ مَعَكُمْ، لَا مَعَ عَدُّوِكُمْ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَرْوَاحِكُمْ وَأَجْسَادِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَشَاهِدِكُمْ وَغَائِبِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَظَاهِرِكُمْ وَبَاطِنِكُمْ"
    },
    {
      "kind": "text",
      "ar": "اٰمِيْنَ رَبَّ الْعَالَمِيْنَ۔"
    }
  ]
}