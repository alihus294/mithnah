{
  "id": "salawat-ziarat-imam-kazim",
  "title": "صلوات براء امام موسيٰ كاظم",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "صلوات براء امام موسيٰ كاظم",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُوْسَي بْنِ جَعْفَرٍ وَصِيِّ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَاِمَامِ الْاَخْيَارِ، وَعَيْبَةِ الْاَنْوَارِ"
    },
    {
      "kind": "text",
      "ar": "وَوَارِثِ السَّكِيْنَةِ وَالْوَقَارِ وَالْحِكَمِ وَالْاَثَارِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ كَانَ يُحْيِي اللَّيْلَ"
    },
    {
      "kind": "text",
      "ar": "بِالسَّهَرِ اِلَي السَّحَرِ بِمُوَاصَلَةِ الْاِسْتِغْفَارِ"
    },
    {
      "kind": "text",
      "ar": "حَلِيْفِ السَّجْدَةِ الطَّوِيْلَةِ، وَالدُمُوْعِ الْغَزِيْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُنَاجَاةِ الْكَثِيْرَةِ، وَالضَّرَاعَاتِ الْمُتَّصِلَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمَقَرِّ النُّهٰي وَالْعَدْلِ"
    },
    {
      "kind": "text",
      "ar": "وَالْخَيْرِ وَالْفَضْلِ وَالنَّدٰي وَالْبَذْلِ"
    },
    {
      "kind": "text",
      "ar": "وَمَأْلَفِ الْبَلْوٰي وَالصَّبْرِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُضْطَهَدِ بِالظُّلْمِ، وَالْمَقْبُوْرِ بِالْجَوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُعَذَّبِ فِيْ قَعْرِ السُّجُوْنِ وَظُلَمِ الْمَطَامِيْرِ"
    },
    {
      "kind": "text",
      "ar": "ذِي السَّاقِ الْمَرْضُوْضِ بِحَلَقِ الْقُيُوْدِ"
    },
    {
      "kind": "text",
      "ar": "وَالْجَنَازَةِ الْمُنَادٰي عَلَيْهَا بِذُلِّ الْاِسْتِخْفَافِ"
    },
    {
      "kind": "text",
      "ar": "وَالْوَارِدِ عَلٰي جَدِّهِ الْمُصْطَفٰي وَأَبِيْهِ الْمُرْتَضٰي"
    },
    {
      "kind": "text",
      "ar": "وَأُمِّهٖ سَيِّدَةِ النِّسَاءِ بِاِرْثٍ مَغْصُوْبٍ"
    },
    {
      "kind": "text",
      "ar": "وَوَلَاءٍ مَسْلُوْبٍ، وَأَمْرٍ مَغْلُوْبٍ"
    },
    {
      "kind": "text",
      "ar": "وَدَمٍ مَطْلُوْبٍ، وَسَمٍّ مَشْرُوْبٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَكَمَا صَبَرَ عَلٰي غَلِيْظِ الْمِحَنِ"
    },
    {
      "kind": "text",
      "ar": "وَتَجَرَّعَ غُصَصَ الْكُرَبِ، وَاسْتَسْلَمَ لِرِضَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْلَصَ الطَّاعَةَ لَكَ، وَمَحَضَ الْخُشُوْعَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَشْعَرَ الْخُضُوْعَ، وَعَادَي الْبِدْعَةَ وَأَهْلَهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَلْحَقْهُ فِيْ شَيْءٍ مِنْ أَوَامِرِكَ وَنَوَاهِيْكَ لَوْمَةُ لَائِمٍ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلَيْهِ صَلَاةً نَامِيَةً مُنِيْفَةً زَاكِيَةً"
    },
    {
      "kind": "text",
      "ar": "تُوْجِبُ لَهٗ بِهَا شَفَاعَةَ أُمَمٍ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقُرُوْنٍ مِنْ بَرَايَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْهُ عَنَّا تَحِيَّةً وَسَلَامًا"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا مِنْ لَدُنْكَ فِيْ مُوَالَاتِهٖ فَضْلًا"
    },
    {
      "kind": "text",
      "ar": "وَاِحْسَانًا وَمَغْفِرَةً وَرِضْوَانًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ ذُوالْفَضْلِ الْعَمِيْمِ، وَالتَّجَاوُزِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}