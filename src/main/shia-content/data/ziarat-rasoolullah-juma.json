{
  "id": "ziarat-rasoolullah-juma",
  "title": "زيارت رسولِ خدا و معصومين روز جمعه",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت رسولِ خدا و معصومين روز جمعه",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ الْمُرْسَلُ"
    },
    {
      "kind": "text",
      "ar": "وَالْوَصِيُّ الْمُرْتَضٰي"
    },
    {
      "kind": "text",
      "ar": "وَالسَّيِّدَةُ الْكُبْرٰي، وَالسَّيِّدَةُ الزَّهْرَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَالسِّبْطَانِ الْمُنْتَجَبَانِ"
    },
    {
      "kind": "text",
      "ar": "وَالْأَوْلَادُ الْأَعْلَامُ وَالْأُمَنَاءُ الْمُنْتَجَبُوْنَ"
    },
    {
      "kind": "text",
      "ar": "جِيْتُ انْقِطَاعًا اِلَيْكُمْ وَاِلٰي اٰبَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَوَلَدِكُمُ الْخَلَفِ عَلٰي بَرَكَةِ الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "فَقَلْبِيْ لَكُمْ مُسَلِّمٌ، وَنُصْرَتِيْ لَكُمْ مُعَدَّةٌ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي يَحْكُمَ اللهُ بِدِيْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَمَعَكُمْ مَعَكُمْ لَا مَعَ عَدُوِّكُمْ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ لَمِنَ الْقَائِلِيْنَ بِفَضْلِكُمْ، مُقِرٌّ بِرَجْعَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "لَا أُنْكِرُ لِلّٰهِ قُدْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَزْعُمُ اِلَّا مَا شَاءَ اللهُ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ ذِي الْمُلْكِ وَالْمَلَكُوْتِ"
    },
    {
      "kind": "text",
      "ar": "يُسَبِّحُ اللهَ بِأَسْمَائِهٖ جَمِيْعُ خَلْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّلَامُ عَلٰي أَرْوَاحِكُمْ وَأَجْسَادِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَّاٰلِهٖ وَسَلَّمْ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْهِ السَّلَامُ"
    }
  ]
}