{
  "id": "shaban-last-night-dua",
  "title": "شعبان كي آخري شب كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "شعبان كي آخري شب كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ هٰذَا الشَّهْرَ الْمُبَارَكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ أُنْزِلَ فِيْهِ الْقُرْاٰنُ"
    },
    {
      "kind": "text",
      "ar": "وَجُعِلَ هُدًى لِلنَّاسِ"
    },
    {
      "kind": "text",
      "ar": "وَبَيِّنَاتٍ مِنَ الْهُدٰي وَالْفُرْقَانِ"
    },
    {
      "kind": "text",
      "ar": "قَدْ حَضَرَ فَسَلِّمْنَا فِيْهِ وَسَلِّمْهُ لَنَا"
    },
    {
      "kind": "text",
      "ar": "وَتَسَلَّمْهُ مِنّا فِيْ يُسْرٍ مِنْكَ وَعَافِيَةٍ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ أَخَذَ الْقَلِيْلَ وَشَكَرَ الْكَثِيْرَ"
    },
    {
      "kind": "text",
      "ar": "اقْبَلْ مِنِّي الْيَسِيْرَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ أَنْ تَجْعَلَ لِيْ اِلٰي كُلِّ خَيْرٍ سَبِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ مَا لَا تُحِبُّ مَانِعًا"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ عَفَا عَنِّيْ وَعَمَّا خَلَوْتُ بِهٖ مِنَ السَّيِّئَاتِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَمْ يُؤَاخِذْنِيْ بِارْتِكَابِ الْمَعَاصِيْ"
    },
    {
      "kind": "text",
      "ar": "عَفْوَكَ عَفْوَكَ عَفْوَكَ يَا كَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ وَعَظْتَنِيْ فَلَمْ أَتَّعِظْ"
    },
    {
      "kind": "text",
      "ar": "وَزَجَرْتَنِيْ عَنْ مَحَارِمِكَ فَلَمْ أَنْزَجِرْ"
    },
    {
      "kind": "text",
      "ar": "فَمَا عُذْرِيْ فَاعْفُ عَنِّيْ يَا كَرِيْمُ، عَفْوَكَ عَفْوَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ الرَّاحَةَ عِنْدَ الْمَوْتِ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَفْوَ عِنْدَ الْحِسَابِ"
    },
    {
      "kind": "text",
      "ar": "عَظُمَ الذَّنْبُ مِنْ عَبْدِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلْيَحْسُنِ التَّجَاوُزُ مِنْ عِنْدِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَهْلَ التَّقْوٰي وَيَا أَهْلَ الْمَغْفِرَةِ، عَفْوَكَ عَفْوَكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ عَبْدُكَ بْنُ عَبْدِكَ بْنُ أَمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "ضَعِيْفٌ فَقِيْرٌ اِلٰي رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ مُنْزِلُ الْغِنٰي وَالْبَرَكَةِ عَلَي الْعِبَادِ قَاهِرٌ مُقْتَدِرٌ"
    },
    {
      "kind": "text",
      "ar": "أَحْصَيْتَ أَعْمَالَهُمْ، وَقَسَمْتَ أَرْزَاقَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهُمْ مُخْتَلِفَةً أَلْسِنَتُهُمْ وَأَلْوَانُهُمْ"
    },
    {
      "kind": "text",
      "ar": "خَلْقًا مِنْ بَعْدِ خَلْقٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَعْلَمُ الْعِبَادُ عِلْمَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَقْدِرُ الْعِبَادُ قَدْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَكُلُّنَا فَقِيْرٌ اِلٰي رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَصْرِفْ عَنِّيْ وَجْهَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ صَالِحِيْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "فِي الْعَمَلِ وَالْاَمَلِ وَالْقَضَاءِ وَالْقَدَرِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَبْقِنِيْ خَيْرَ الْبَقَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْنِنِيْ خَيْرَ الْفَنَاءِ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي مُوَالَاةِ أَوْلِيَائِكَ، وَمُعَادَاةِ أَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّغْبَةِ اِلَيْكَ، وَالرَّهْبَةِ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْخُشُوْعِ وَالْوَفَاءِ وَالتَّسْلِيْمِ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّصْدِيْقِ بِكِتَابِكَ، وَاتِّبَاعِ سُنَّةِ رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَا كَانَ فِيْ قَلْبِيْ مِنْ شَكٍّ أَوْ رِيْبَةٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْ جُحُوْدٍ أَوْ قُنُوْطٍ أَوْ فَرَحٍ أَوْ بَذَخٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْبَطَرٍ أَوْ خُيَلَاءَ أَوْ رِيَاءٍ أَوْ سُمْعَةٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْ شِقَاقٍ أَوْ نِفَاقٍ أَوْ كُفْرٍ أَوْ فُسُوْقٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْ عِصْيَانٍ أَوْ عَظَمَةٍ أَوْ شَيْءٍ لَا تُحِبُّ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْأَلُكَ يَا رَبِّ أَنْ تُبَدِّلَنِيْ مَكَانَهٗ"
    },
    {
      "kind": "text",
      "ar": "اِيْمَانًا بِوَعْدِكَ، وَوَفَاءً بِعَهْدِكَ، وَرِضًا بِقَضَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَزُهْدًا فِي الدُّنْيَا، وَرَغْبَةً فِيْمَا عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَثَرَةً وَطُمَأْنِيْنَةً، وَتَوْبَةً نَصُوْحًا"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ ذٰلِكَ يَا رَبَّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ أَنْتَ مِنْ حِلْمِكَ تُعْصٰي"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كَرَمِكَ وَجُوْدِكَ تُطَاعُ فَكَأَنَّكَ لَمْ تُعْصَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا وَمَنْ لَمْ يَعْصِكَ سُكَّانُ أَرْضِكَ"
    },
    {
      "kind": "text",
      "ar": "فَكُنْ عَلَيْنَا بِالْفَضْلِ جَوَادًا"
    },
    {
      "kind": "text",
      "ar": "وَبِالْخَيْرِ عَوَّادًا، يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً دَائِمَةً لَا تُحْصٰي وَلَا تُعَدُّ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَقْدِرُ قَدْرَهَا غَيْرُكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}