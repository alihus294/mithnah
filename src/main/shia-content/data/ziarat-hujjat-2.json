{
  "id": "ziarat-hujjat-2",
  "title": "دوسري زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دوسري زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا خَلِيْفَةَ اللهِ وَخَلِيْفَةَ اٰبَائِهِ الْمَهْدِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَصِيَّ الْاَوْصِيَاءِ الْمَاضِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حَافِظَ أَسْرَارِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا بَقِيَّةَ اللهِ مِنَ الصَّفْوَةِ الْمُنْتَجَبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الْاَنْوَارِ الزَّاهِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الْاَعْلَامِ الْبَاهِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الْعِتْرَةِ الطَّاهِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَعْدِنَ الْعُلُوْمِ النَّبَوِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا بَابَ اللهِ الَّذِيْ لَا يُؤْتٰي اِلَّا مِنْهُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا سَبِيْلَ اللهِ الَّذِيْ مَنْ سَلَكَ غَيْرَهٗ هَلَكَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نَاظِرَ شَجَرَةِ طُوْبٰي وَسِدْرَةِ الْمُنْتَهٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نُوْرَ اللهِ الَّذِيْ لَا يُطْفَأُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ الَّتِيْ لَا تَخْفٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ عَلٰي مَنْ فِي الْاَرْضِ وَالسَّمَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ سَلَامَ مَنْ عَرَفَكَ بِمَا عَرَّفَكَ بِهِ اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَنَعَتَكَ بِبَعْضِ نُعُوْتِكَ الَّتِيْ أَنْتَ أَهْلُهَا وَفَوْقَهَا"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ الْحُجَّةُ عَلٰي مَنْ مَضٰي وَمَنْ بَقِيَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ حِزْبَكَ هُمُ الْغَالِبُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْلِيَائَكَ هُمُ الْفَائِزُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْدَائَكَ هُمُ الْخَاسِرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ خَازِنُ كُلِّ عِلْمٍ، وَفَاتِقُ كُلِّ رَتْقٍ"
    },
    {
      "kind": "text",
      "ar": "وَمُحَقِّقُ كُلِّ حَقٍّ، وَمُبْطِلُ كُلِّ بَاطِلٍ"
    },
    {
      "kind": "text",
      "ar": "رَضِيْتُكَ يَا مَوْلَايَ اِمَامًا وَهَادِيًا وَوَلِيًّا وَمُرْشِدًا"
    },
    {
      "kind": "text",
      "ar": "لَا أَبْتَغِيْ بِكَ بَدَلًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَتَّخِذُ مِنْ دُوْنِكَ وَلِيًّا"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ الْحَقُّ الثَّابِتُ الَّذِيْ لَا عَيْبَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ وَعْدَ اللهِ فِيْكَ حَقُّ"
    },
    {
      "kind": "text",
      "ar": "لَا أَرْتَابُ لِطُوْلِ الْغَيْبَةِ وَبُعْدِ الْاَمَدِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَتَحَيَّرُ مَعَ مَنْ جَهِلَكَ وَجَهِلَ بِكَ"
    },
    {
      "kind": "text",
      "ar": "مُنْتَظِرٌ مُتَوَقِّعٌ لِاَيَّامِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الشَّافِعُ الَّذِيْ لَا تُنَازَعُ"
    },
    {
      "kind": "text",
      "ar": "وَالْوَلِيُّ الَّذِيْ لَا تُدَافَعُ"
    },
    {
      "kind": "text",
      "ar": "ذَخَرَكَ اللهُ لِنُصْرَةِ الدِّيْنِ، وَاِعْزَازِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِنْتِقَامِ مِنَ الْجَاحِدِيْنَ الْمَارِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّ بِوِلَايَتِكَ تُقْبَلُ الْاَعْمَالُ، وَتُزَكَّي الْاَفْعَالُ"
    },
    {
      "kind": "text",
      "ar": "وَتُضَاعَفُ الْحَسَنَاتُ، وَتُمْحَي السَّيِّئَاتُ"
    },
    {
      "kind": "text",
      "ar": "فَمَنْ جَاءَ بِوِلَايَتِكَ وَاعْتَرَفَ بِاِمَامَتِكَ"
    },
    {
      "kind": "text",
      "ar": "قُبِلَتْ أَعْمَالُهٗ، وَصُدِّقَتْ أَقْوَالُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَتَضَاعَفَتْ حَسَنَاتُهٗ، وَمُحِيَتْ سَيِّئَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ عَدَلَ عَنْ وِلَايَتِكَ، وَجَهِلَ مَعْرِفَتَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَبْدَلَ بِكَ غَيْرَكَ"
    },
    {
      "kind": "text",
      "ar": "كَبَّهُ اللهُ عَلٰي مَنْخَرِهٖ فِي النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَقْبَلِ اللهُ لَهٗ عَمَلًا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يُقِمْ لَهٗ يَوْمَ الْقِيَامَةِ وَزْنًا"
    },
    {
      "kind": "text",
      "ar": "أُشْهِدُ اللهَ وَأُشْهِدُ مَلَائِكَتَهٗ وَأُشْهِدُكَ يَا مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "بِهٰذَا ظَاهِرُهٗ كَبَاطِنِهٖ وَسِرُّهٗ كَعَلَانِيَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الشَّاهِدُ عَلٰي ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَهْدِيْ اِلَيْكَ وَمِيْثَاقِيْ لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "اِذْ أَنْتَ نِظَامُ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَيَعْسُوْبُ الْمُتَّقِيْنَ، وَعِزُّ الْمُوَحِّدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِذٰلِكَ أَمَرَنِيْ رَبُّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَلَوْ تَطَاوَلَتِ الدُّهُوْرُ وَتَمَادَتِ الْاَعْمَارُ"
    },
    {
      "kind": "text",
      "ar": "لَمْ أَزْدَدْ فِيْكَ اِلَّا يَقِيْنًا وَلَكَ اِلَّا حُبًّا"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ اِلَّا مُتَّكَلًا وَمُعْتَمَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلِظُهُوْرِكَ اِلَّا مُتَوَقَّعًا وَمُنْتَظَرًا"
    },
    {
      "kind": "text",
      "ar": "وَلِجِهَادِيْ بَيْنَ يَدَيْكَ مُتَرَقَّبًا"
    },
    {
      "kind": "text",
      "ar": "فَأَبْذُلْ نَفْسِيْ، وَمَالِيْ، وَوَلَدِيْ، وَأَهْلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَجَمِيْعَ مَا خَوَّلَنِيْ رَبِّيْ بَيْنَ يَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّصَرُّفَ بَيْنَ أَمْرِكَ وَنَهْيِكَ"
    },
    {
      "kind": "text",
      "ar": "مَوْلَايَ فَاِنْ أَدْرَكْتُ أَيَّامَكَ الزَّاهِرَةَ وَأَعْلَامَكَ الْبَاهِرَةَ"
    },
    {
      "kind": "text",
      "ar": "فَهَا أَنَا ذَا عَبْدُكَ، الْمُتَصَرِّفُ بَيْنَ أَمْرِكَ وَنَهْيِكَ"
    },
    {
      "kind": "text",
      "ar": "أَرْجُوْ بِهِ الشَّهَادَةَ بَيْنَ يَدَيْكَ وَالْفَوْزَ لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "مَوْلَايَ فَاِنْ أَدْرَكَنِي الْمَوْتُ قَبْلَ ظُهُوْرِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ أَتَوَسَّلُ بِكَ وَبِاٰبَائِكَ الطَّاهِرِيْنَ اِلَي اللهِ تَعَالٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُهٗ أَنْ يُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ يَجْعَلَ لِيْ كَرَّةً فِيْ ظُهُوْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَرَجْعَةً فِيْ أَيَّامِكَ"
    },
    {
      "kind": "text",
      "ar": "لِاَبْلُغَ مِنْ طَاعَتِكَ مُرَادِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْفِيَ مِنْ أَعْدَائِكَ فُؤَادِيْ"
    },
    {
      "kind": "text",
      "ar": "مَوْلَايَ وَقَفْتُ فِيْ زِيَارَتِكَ مَوْقِفَ الْخَاطِئِيْنَ النَّادِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْخَائِفِيْنَ مِنْ عِقَابِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدِ اتَّكَلْتُ عَلٰي شَفَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَرَجَوْتُ بِمُوَالَاتِكَ وَشَفَاعَتِكَ مَحْوَ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَسَتْرَ عُيُوْبِيْ، وَمَغْفِرَةَ زَلَلِيْ"
    },
    {
      "kind": "text",
      "ar": "فَكُنْ لِوَلِيِّكَ يَا مَوْلَايَ عِنْدَ تَحْقِيْقِ أَمَلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْأَلِ اللهَ غُفْرَانَ زَلَلِـهٖ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ تَعَلَّقَ بِحَبْلِكَ، وَتَمَسَّكَ بِوِلَايَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَبَرَّأَ مِنْ أَعْدَائِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْجِزْ لِوَلِيِّكَ مَا وَعَدْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَظْهِرْ كَلِمَتَهٗ، وَأَعْلِ دَعْوَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْهُ عَلٰي عَدُوِّهٖ وَعَدُوِّكَ، يَا رَبَّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَظْهِرْ كَلِمَتَكَ التَّامَّةَ"
    },
    {
      "kind": "text",
      "ar": "وَمُغَيَّبَكَ فِيْ أَرْضِكَ، الْخَائِفَ الْمُتَرَقِّبَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ انْصُرْهُ نَصْرًا عَزِيْزًا"
    },
    {
      "kind": "text",
      "ar": "وَافْتَحْ لَهٗ فَتْحًا يَسِيْرًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَعِزَّ بِهِ الدِّيْنَ بَعْدَ الْخُمُوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَأَطْلِعْ بِهِ الْحَقَّ بَعْدَ الْأُفُوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْلِ بِهِ الظُّلْمَةَ، وَاكْشِفْ بِهِ الْغُمَّةَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاٰمِنْ بِهِ الْبِلَادَ، وَاهْدِ بِهِ الْعِبَادَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ امْلَأْ بِهِ الْاَرْضَ عَدْلًا وَقِسْطًا"
    },
    {
      "kind": "text",
      "ar": "كَمَا مُلِئَتْ ظُلْمًا وَجَوْرًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ سَمِيْعٌ مُجِيْبٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "ائْذَنْ لِوَلِيِّكَ فِي الدُّخُوْلِ اِلٰي حَرَمِكَ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْكَ وَعَلٰي اٰبَائِكَ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اللهُ أَكْبَرُ، اللهُ أَكْبَرُ، اللهُ أَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ، وَاللهُ أَكْبَرُ وَلِلّٰهِ الْحَمْدُ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ هَدَانَا لِهٰذَا"
    },
    {
      "kind": "text",
      "ar": "وَعَرَّفَنَا أَوْلِيَائَهٗ وَأَعْدَآئَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَوَفَّقَنَا لِزِيَارَةِ أَئِمَّتِنَا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَجْعَلْنَا مِنَ الْمُعَانِدِيْنَ النَّاصِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مِنَ الْغُلَاةِ الْمُفَوِّضِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مِنَ الْمُرْتَابِيْنَ الْمُقَصِّرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي وَلِيِّ اللهِ وَابْنِ أَوْلِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمُدَّخَرِ لِكَرَامَةِ أَوْلِيَاءِ اللهِ وَبَوَارِ أَعْدَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي النُّوْرِ الَّذِيْ أَرَادَ أَهْلُ الْكُفْرِ اِطْفَائَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَأَبَي اللهُ اِلَّا أَنْ يُتِمَّ نُوْرَهٗ بِكُرْهِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَيَّدَهٗ بِالْحَيَاةِ حَتّٰي يُظْهِرَ عَلٰي يَدِهِ الْحَقَّ بِرَغْمِهِمْ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّ اللهَ اصْطَفَاكَ صَغِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَكْمَلَ لَكَ عُلُوْمَهٗ كَبِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ حَيٌّ لَا تَمُوْتُ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تُبْطِلَ الْجِبْتَ وَالطَّاغُوْتَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَيْهِ وَعَلٰي خُدَّامِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْوَانِهٖ عَلٰي غَيْبَتِهٖ وَنَأْيِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتُرْهُ سَتْرًا عَزِيْزًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لَهٗ مَعْقِلًا حَرِيْزًا"
    },
    {
      "kind": "text",
      "ar": "وَاشْدُدِ اللّٰهُمَّ وَطْأَتَكَ عَلٰي مُعَانِدِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَاحْرُسْ مَوَالِيْهِ وَزَائِرِيْهِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ كَمَا جَعَلْتَ قَلْبِيْ بِذِكْرِهٖ مَعْمُوْرًا"
    },
    {
      "kind": "text",
      "ar": "فَاجْعَلْ سِلَاحِيْ بِنُصْرَتِهٖ مَشْهُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ حَالَ بَيْنِيْ وَبَيْنَ لِقَائِهِ الْمَوْتُ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ جَعَلْتَهٗ عَلٰي عِبَادِكَ حَتْمًا"
    },
    {
      "kind": "text",
      "ar": "وَأَقْدَرْتَ بِهٖ عَلٰي خَلِيْقَتِكَ رَغْمًا"
    },
    {
      "kind": "text",
      "ar": "فَابْعَثْنِيْ عِنْدَ خُرُوْجِهٖ ظَاهِرًا مِنْ حُفْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "مُؤْتَزِرًا كَفَنِيْ حَتّٰي أُجَاهِدَ بَيْنَ يَدَيْهِ فِي الصَّفِّ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ أَثْنَيْتَ عَلٰي أَهْلِهٖ فِيْ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "فَقُلْتَ كَأَنَّهُمْ بُنْيَانٌ مَرْصُوْصٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ طَالَ الْاِنْتِظَارُ، وَشَمِتَ بِنَا الْفُجَّارُ"
    },
    {
      "kind": "text",
      "ar": "وَصَعُبَ عَلَيْنَا الْاِنْتِصَارُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَرِنَا وَجْهَ وَلِيِّكَ الْمَيْمُوْن"
    },
    {
      "kind": "text",
      "ar": "فِيْ حَيَاتِنَا وَبَعْدَ الْمَنُوْنِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَدِيْنُ لَكَ بِالرَّجْعَةِ"
    },
    {
      "kind": "text",
      "ar": "بَيْنَ يَدَيْ صَاحِبِ هٰذِهِ الْبُقْعَةِ"
    },
    {
      "kind": "text",
      "ar": "الْغَوْثَ، الْغَوْثَ، الْغَوْثَ، يَا صَاحِبَ الزَّمَانِ"
    },
    {
      "kind": "text",
      "ar": "قَطَعْتُ فِيْ وُصْلَتِكَ الْخُلَّانَ"
    },
    {
      "kind": "text",
      "ar": "وَهَجَرْتُ لِزِيَارَتِكَ الْاَوْطَانَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْفَيْتُ أَمْرِيْ عَنْ أَهْلِ الْبُلْدَانِ"
    },
    {
      "kind": "text",
      "ar": "لِتَكُوْنَ شَفِيْعًا عِنْدَ رَبِّكَ وَرَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلٰي اٰبَائِكَ وَمَوَالِيَّ فِيْ حُسْنِ التَّوْفِيْقِ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِسْبَاغِ النِّعْمَةِ عَلَيَّ، وَسَوْقِ الْاِحْسَانِ اِلَيَّ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "أَصْحَابِ الْحَقِّ، وَقَادَةِ الْخَلْقِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَجِبْ مِنِّيْ مَا دَعَوْتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنِيْ مَا لَمْ أَنْطِقْ بِهٖ فِيْ دُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "مِنْ صَلَاحِ دِيْنِيْ وَدُنْيَايَ، اِنَّكَ حَمِيْدٌ مَجِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِهٖ الطَّاهِرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَبْدُكَ الزَّائِرُ فِيْ فِنَاءِ وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "الْمَزُوْرِ الَّذِيْ فَرَضْتَ طَاعَتَهٗ عَلَي الْعَبِيْدِ وَالْاَحْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْقَذْتَ بِهٖ أَوْلِيَائَكَ مِنْ عَذَابِ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْهَا زِيَارَةً مَقْبُوْلَةً ذَاتَ دُعَاءٍ مُسْتَجَابٍ"
    },
    {
      "kind": "text",
      "ar": "مِنْ مُصَدِّقٍ بِوَلِيِّكَ غَيْرِ مُرْتَابٍ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَجْعَلْهُ اٰخِرَ الْعَهْدِ بِهٖ وَلَا بِزِيَارَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَقْطَعْ أَثَرِيْ مِنْ مَشْهَدِهٖ وَزِيَارَةِ أَبِيْهِ وَجَدِّهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَخْلِفْ عَلَيَّ نَفَقَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَانْفَعْنِيْ بِمَا رَزَقْتَنِيْ فِيْ دُنْيَايَ وَاٰخِرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "لِيْ وَلِاِخْوَانِيْ وَأَبَوَيَّ وَجَمِيْعِ عِتْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْدِعُكَ اللهَ أَيُّهَا الْاِمَامُ الَّذِيْ يَفُوْزُ بِهِ الْمُؤْمِنُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَهْلِكُ عَلٰي يَدَيْهِ الْكَافِرُوْنَ الْمُكَذِّبُوْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ يَابْنَ الْحَسَنِ بْنِ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "جِئْتُكَ زَائِرًا لَكَ وَلِاَبِيْكَ وَجَدِّكَ"
    },
    {
      "kind": "text",
      "ar": "مُتَيَقِّنًا الْفَوْزَ بِكُمْ، مُعْتَقِدًا اِمَامَتَكُمْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اكْتُبْ هٰذِهِ الشَّهَادَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالزِّيَارَةَ لِيْ عِنْدَكَ فِيْ عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْنِيْ بَلَاغَ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَانْفَعْنِيْ بِحُبِّهِمْ يَارَبَّ الْعَالَمِيْنَ۔"
    }
  ]
}