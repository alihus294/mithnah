{
  "id": "ramadan-night23",
  "title": "تئيسويں رمضان كي رات",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تئيسويں رمضان كي رات",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ امْدُدْ لِيْ فِيْ عُمْرِيْ، وَأَوْسِعْ لِيْ فِيْ رِزْقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَصِحَّ لِيْ جِسْمِيْ، وَبَلِّغْنِيْ أَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ كُنْتُ مِنَ الْاَشْقِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "فَامْحُنِيْ مِنَ الْاَشْقِيَاءِ وَاكْتُبْنِيْ مِنَ السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ قُلْتَ فِيْ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "الْمُنْزَلِ عَلٰي نَبِيِّكَ الْمُرْسَلِ صَلَوَاتُكَ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَمْحُوا اللهُ مَايَشَاءُ وَيُثْبِتُ وَعِنْدَهٗ أُمُّ الْكِتَابِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ فِيْمَا تَقْضِيْ وَفِيْمَا تُقَدِّرُ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْاَمْرِ الْمَحْتُوْمِ وَفِيْمَا تَفْرُقُ مِنَ الْاَمْرِ الْحَكِيْمِ"
    },
    {
      "kind": "text",
      "ar": "فِيْ لَيْلَةِ الْقَدْرِ مِنَ الْقَضَاءِ الَّذِيْ لَا يُرَدُّ وَلَا يُبَدَّلُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَكْتُبَنِيْ مِنْ حُجَّاجِ بَيْتِكَ الْحَرَامِ فِيْ عَامِيْ هٰذَا"
    },
    {
      "kind": "text",
      "ar": "الْمَبْرُوْرِ حَجُّهُمُ، الْمَشْكُوْرِ سَعْيُهُمُ"
    },
    {
      "kind": "text",
      "ar": "الْمَغْفُوْرِ ذُنُوْبُهُمُ، الْمُكَفَّرِ عَنْهُمْ سَيِّئَاتُهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ فِيْمَا تِقْضِيْ وَتُقَدِّرُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُطِيْلَ عُمْرِيْ، وَتُوَسِّعَ لِيْ فِيْ رِزْقِيْ۔"
    },
    {
      "kind": "text",
      "ar": "يَا بَاطِنًا فِيْ ظُهُوْرِهٖ، ويَا ظَاهِرًا فِيْ بُطُوْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَيَا بَاطِنًا لَيْسَ يَخْفٰي، وَيَا ظَاهِرًا لَيْسَ يُرٰي"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْصُوْفًا لَا يَبْلُغُ بِكَيْنُوْنَتِهٖ مَوْصُوْفٌ وَلَا حَدٌّ مَحْدُوْدٌ"
    },
    {
      "kind": "text",
      "ar": "وَيَا غَائِبًا غَيْرَ مَفْقُوْدٍ، وَيَا شَاهِدًا غَيْرَ مَشْهُوْدٍ"
    },
    {
      "kind": "text",
      "ar": "يُطْلَبُ فَيُصَابُ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَخْلُ مِنْهُ السَّمَاوَاتُ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَرْضُ وَمَا بَيْنَهُمَا طَرْفَةَ عَيْنٍ"
    },
    {
      "kind": "text",
      "ar": "لَا يُدْرَكُ بِكَيْفٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُؤَيَّنُ بِأَيْنٍ وَلَا بِحَيْثٍ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ نُوْرُ النُّوْرِ، وَرَبُّ الْاَرْبَابِ"
    },
    {
      "kind": "text",
      "ar": "أَحَطْتَ بِجَمِيْعِ الْاُمورِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَيْسَ كَمِثْلِهٖ شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ السَّمِيْعُ الْبَصِيْرُ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ هُوَ هٰكَذَا وَلَا هٰكَذَا غَيْرُهٗ"
    }
  ]
}