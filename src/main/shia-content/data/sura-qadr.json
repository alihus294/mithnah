{
  "id": "sura-qadr",
  "title": "سورۂ قدر",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ قدر",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّاۤ اَنْزَلْنٰهُ فِيْ لَيْلَةِ الْقَدْرِۚۖ۝۱"
    },
    {
      "kind": "text",
      "ar": "وَمَاۤ اَدْرٰىكَ مَا لَيْلَةُ الْقَدْرِؕ۝۲"
    },
    {
      "kind": "text",
      "ar": "لَيْلَةُ الْقَدْرِ١ۙ۬ خَيْرٌ مِّنْ اَلْفِ شَهْرٍؕؔ۝۳"
    },
    {
      "kind": "text",
      "ar": "تَنَزَّلُ الْمَلٰٓىِٕكَةُ وَالرُّوْحُ فِيْهَا بِاِذْنِ رَبِّهِمْ١ۚ مِنْ كُلِّ اَمْرٍۙۛ۝۴"
    },
    {
      "kind": "text",
      "ar": "سَلٰمٌ١ۛ۫ هِيَ حَتّٰى مَطْلَعِ الْفَجْرِ۠۝۵"
    }
  ]
}