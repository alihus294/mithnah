{
  "id": "dua-in-ghaibat-hujjat",
  "title": "غيبت امام العصر ميں دعا",
  "subtitle": "ملحقات مفاتيح الجنان",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "غيبت امام العصر ميں دعا",
      "subtitle": "ملحقات مفاتيح الجنان"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَرِّفْنِيْ نَفْسَكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ اِنْ لَمْ تُعَرِّفْنِيْ نَفْسَكَ"
    },
    {
      "kind": "text",
      "ar": "لَمْ أَعْرِفْ رَسُوْلَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَرِّفْنِيْ رَسُوْلَكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ اِنْ لَمْ تُعَرِّفْنِيْ رَسُوْلَكَ"
    },
    {
      "kind": "text",
      "ar": "لَمْ أَعْرِفْ حُجَّتَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَرِّفْنِيْ حُجَّتَكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ اِنْ لَمْ تُعَرِّفْنِيْ حُجَّتَكَ"
    },
    {
      "kind": "text",
      "ar": "ضَلَلْتُ عَنْ دِيْنِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تُمِتْنِيْ مِيْتَةً جَاهِلِيَّةً"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُزِغْ قَلْبِيْ بَعْدَ اِذْ هَدَيْتَنِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَكَمَا هَدَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "لِوِلَايَةِ مَنْ فَرَضْتَ عَلَيَّ طَاعَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "مِنْ وِلَايَةِ وُلَاةِ أَمْرِك بَعْدَ رَسُوْلِكَ صَلَوَاتُكَ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي وَالَيْتُ وُلَاةَ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "أَمِيْرَ الْمُؤْمِنِيْنَ عَلِيَّ بْنَ أَبِيْ طَالِبٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنَ وَالْحُسَيْنَ وَعَلِيًّا وَمُحَمَّدًا"
    },
    {
      "kind": "text",
      "ar": "وَجَعْفَرًا وَمُوْسٰي وَعَلِيًّا وَمُحَمَّدًا"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيًّا وَالْحَسَنَ وَالْحُجَّةَ الْقَائِمَ الْمَهْدِيَّ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُكَ عَلَيْهِمْ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَثَبِّتْنِيْ عَلٰي دِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَعْمِلْنِيْ بِطَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَيِّنْ قَلْبِيْ لِوَلِيِّ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَافِنِيْ مِمَّا امْتَحَنْتَ بِهٖ خَلْقَكَ"
    },
    {
      "kind": "text",
      "ar": "وَثَبِّتْنِيْ عَلٰي طَاعَةِ وَلِيِّ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ سَتَرْتَهٗ عَنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِاِذْنِكَ غَابَ عَنْ بَرِيَّتِكَ وَأَمْرَكَ يَنْتَظِرُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْعَالِمُ غَيْرُ الْمُعَلَّمِ بِالْوَقْتِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ فِيْهِ صَلَاحُ أَمْرِ وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "فِي الْاِذْنِ لَهٗ بِاِظْهَارِ أَمْرِهٖ وَكَشْفِ سِتْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَصَبِّرْنِيْ عَلٰي ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا أُحِبَّ تَعْجِيْلَ مَا أَخَّرْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَأْخِيْرَ مَا عَجَّلْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَاكَشْفَ مَا سَتَرْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا الْبَحْثَ عَمَّا كَتَمْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أُنَازِعَكَ فِيْ تَدْبِيْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَقُوْلَ لِمَ وَكَيْفَ"
    },
    {
      "kind": "text",
      "ar": "وَمَا بَالُ وَلِيِّ الْاَمْرِ لَا يَظْهَرُ"
    },
    {
      "kind": "text",
      "ar": "وَقَدِ امْتَلَأْتِ الْاَرْضُ مِنَ الْجَوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأُفَوِّضُ أُمُوْرِيْ كُلَّهَا اِلَيْكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ أَنْ تُرِيَنِيْ وَلِيَّ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "ظَاهِرًا نَافِذَ الْاَمْرِ مَعَ عِلْمِيْ"
    },
    {
      "kind": "text",
      "ar": "بِأَنَّ لَكَ السُّلْطَانَ وَالْقُدْرَةَ وَالْبُرْهَانَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحُجَّةَ وَالْمَشِيَّةَ وَالْحَوْلَ وَالْقُوَّةَ"
    },
    {
      "kind": "text",
      "ar": "فَافْعَلْ ذٰلِكَ بِيْ وَبِجَمِيْعِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي نَنْظُرَ اِلٰي وَلِيِّ أَمْرِكَ صَلَوَاتُكَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "ظَاهِرَ الْمَقَالَةِ وَاضِحَ الدَّلَالَةِ"
    },
    {
      "kind": "text",
      "ar": "هَادِيًا مِنَ الضَّلَالَةِ شَافِيًا مِنَ الْجَهَالَةِ"
    },
    {
      "kind": "text",
      "ar": "أَبْرِزْ يَارَبِّ مُشَاهَدَتَهٗ وَثَبِّتْ قَوَاعِدَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا مِمَّنْ تَقِرُّ عَيْنُهٗ بِرُؤْيَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَقِمْنَا بِخِدْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَفَّنَا عَلٰي مِلَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنَا فِيْ زُمْرَتِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعِذْهُ مِنْ شَرِّ جَمِيْعِ مَا خَلَقْتَ"
    },
    {
      "kind": "text",
      "ar": "وَذَرَأْتَ وَبَرَأْتَ وَأَنْشَأْتَ وَصَوَّرْتَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْهُ مِنْ بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَنْ يَمِيْنِهٖ وَعَنْ شِمَالِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ فَوْقِهٖ وَمِنْ تَحْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "بِحِفْظِكَ الَّذِيْ لَا يَضِيْعُ مَنْ حَفِظْتَهٗ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْ فِيْهِ رَسُوْلَكَ وَوَصِيَّ رَسُوْلِكَ عَلَيْهِ وَاٰلِهِ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَمُدَّ فِيْ عُمْرِهٖ، وَزِدْ فِيْ أَجَلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِنْهٗ عَلٰي مَا وَلَّيْتَهٗ وَاسْتَرْعَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَزِدْ فِيْ كَرَامَتِكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهُ الْهَادِي الْمَهْدِيُّ، وَالْقَائِمُ الْمُهْتَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالطَّاهِرُ التَّقِيُّ، الزَّكِيُّ النَّقِيُّ"
    },
    {
      "kind": "text",
      "ar": "الرَّضِيُّ الْمَرْضِيُّ"
    },
    {
      "kind": "text",
      "ar": "الصَّابِرُ الشَّكُوْرُ الْمُجْتَهِدُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَلَا تَسْلُبْنَا الْيَقِيْنَ لِطُوْلِ الْاَمَدِ فِيْ غَيْبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَانْقِطَاعِ خَبَرِهٖ عَنَّا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُنْسِنَا ذِكْرَهٗ وَانْتِظَارَهٗ وَالْاِيْمَانَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَقُوَّةَ الْيَقِيْنِ فِيْ ظُهُوْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالدُّعَاءَ لَهٗ وَالصَّلَاةَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا يُقَنِّطَنَا طُوْلُ غَيْبَتِهٖ مِنْ قِيَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَيَكُوْنَ يَقِيْنُنَا فِيْ ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "كَيَقِيْنِنَا فِيْ قِيَامِ رَسُوْلِكَ صَلَوَاتُكَ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمَا جَاءَ بِهٖ مِنْ وَحْيِكَ وَتَنْزِيْلِكَ"
    },
    {
      "kind": "text",
      "ar": "فَقَوِّ قُلُوْبَنَا عَلَي الْاِيْمَانِ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تَسْلُكَ بِنَا عَلٰي يَدَيْهِ مِنْهَاجَ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْمَحَجَّةَالْعُظْمٰي، وَالطَّرِيْقَةَ الْوُسْطٰي"
    },
    {
      "kind": "text",
      "ar": "وَقَوِّنَا عَلٰي طَاعَتِهٖ، وَثَبِّتْنَا عَلٰي مُتَابَعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا فِيْ حِزْبِهٖ وَأَعْوَانِهٖ وَأَنْصَارِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّاضِيْنَ بِفِعْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَسْلُبْنَا ذٰلِكَ فِيْ حَيَاتِنَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا عِنْدَ وَفَاتِنَا حَتّٰي تَتَوَفَّانَا"
    },
    {
      "kind": "text",
      "ar": "وَنَحْنُ عَلٰي ذٰلِكَ لَا شَاكِّيْنَ وَلَا نَاكِثِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُرْتَابِيْنَ وَلَا مُكَذِّبِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَجِّلْ فَرَجَهُ وَأَيِّدْهُ بِالنَّصْرِ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْ نَاصِرِيْهِ وَاخْذُلْ خَاذِلِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَدَمْدِمْ عَلٰي مَنْ نَصَبَ لَهٗ وَكَذَّبَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَظْهِرْ بِهِ الْحَقَّ وَأَمِتْ بِهِ الْجَوْرَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَنْقِذْ بِهٖ عِبَادَكَ الْمُؤْمِنِيْنَ مِنَ الذُّلِّ"
    },
    {
      "kind": "text",
      "ar": "وَانْعَشْ بِهِ الْبِلَادَ"
    },
    {
      "kind": "text",
      "ar": "وَاقْتُلْ بِهٖ جَبَابِرَةَ الْكُفْرِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْصِمْ بِهٖ رُؤُوْسَ الضَّلَالَةِ"
    },
    {
      "kind": "text",
      "ar": "وَذَلِّلْ بِهِ الْجَبَّارِيْنَ وَالْكَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَبِرْ بِهِ الْمُنَافِقِيْنَ وَالنَّاكِثِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَجَمِيْعَ الُمخَالِفِيْنَ وَالْمُلْحِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ مَشَارِقِ الْاَرْضِ وَمَغَارِبِهَا"
    },
    {
      "kind": "text",
      "ar": "وَبَرِّهَا وَبَحْرِهَا وَسَهْلِهَا وَجَبَلِهَا"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا تَدَعَ مِنْهُمْ دَيَّارًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُبْقِيَ لَهُمْ اٰثَارًا"
    },
    {
      "kind": "text",
      "ar": "طَهِّرْ مِنْهُمْ بِلَادَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاشْفِ مِنْهُمْ صُدُوْرَ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجَدِّدْ بِهٖ مَا امْتَحي مِنْ دِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْلِحْ بِهٖ مَا بُدِّلَ مِنْ حُكْمِكَ وَغُيِّرَ مِنْ سُنَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي يَعُوْدَ دِيْنُكَ بِهٖ وَعَلٰي يَدَيْهِ"
    },
    {
      "kind": "text",
      "ar": "غَضًّا جَدِيْدًا صَحِيْحًا"
    },
    {
      "kind": "text",
      "ar": "لَا عِوَجَ فِيْهِ وَلَا بِدْعَةَ مَعَهٗ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تُطْفِيَ بِعَدْلِهٖ نِيْرَانَ الْكَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ عَبْدُكَ الَّذِي اسْتَخْلَصْتَهٗ لِنَفْسِكَ"
    },
    {
      "kind": "text",
      "ar": "وَارْتَضَيْتَهٗ لِنَصْرِ دِيْنِكَ، وَاصْطَفَيْتَهٗ بِعِلْمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَصَمْتَهٗ مِنَ الذُّنُوْبِ، وَبَرَّأْتَهٗ مِنَ الْعُيُوْبِ"
    },
    {
      "kind": "text",
      "ar": "وَأَطْلَعْتَهٗ عَلَي الْغُيُوْبِ، وَأَنْعَمْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَطَهَّرْتَهٗ مِنَ الرِّجْسِ، وَنَقَّيْتَهٗ مِنَ الدَّنَسِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَصَلِّ عَلَيْهِ وَعَلٰي اٰبَائِهِ الْاَئِمَّةِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي شِيْعَتِهِ الْمُنْتَجَبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْهُمْ مِنْ اٰمَالِهِمْ مَا يَأْمُلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ ذٰلِكَ مِنَّا خَالِصًا مِنْ كُلِّ شَكٍّ وَشُبْهَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَرِيَاءٍ وَسُمْعَةٍ حَتّٰي لَا نُرِيْدَ بِهٖ غَيْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا نَطْلُبَ بِهٖ اِلَّا وَجْهَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نَشْكُوْ اِلَيْكَ فَقْدَ نَبِيِّنَا"
    },
    {
      "kind": "text",
      "ar": "وَغَيْبَةَ اِمَامِنَا وَشِدَّةَ الزَّمَانِ عَلَيْنَا"
    },
    {
      "kind": "text",
      "ar": "وَوُقُوْعَ الْفِتَنِ بِنَا وَتَظَاهُرَ الْاَعْدَاءِ عَلَيْنَا"
    },
    {
      "kind": "text",
      "ar": "وَكَثْرَةَ عَدُوِّنَا وَقِلَّةَ عَدَدِنَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَافْرُجْ ذٰلِكَ عَنَّا بِفَتْحٍ مِنْكَ تُعَجِّلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَنَصْرٍ مِنْكَ تُعِزُّهٗ، وَاِمَامِ عَدْلٍ تُظْهِرُهٗ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهَ الْحَقِّ اٰمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نَسْأَلُكَ أَنْ تَأْذَنَ لِوَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ اِظْهَارِ عَدْلِكَ فِيْ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَتْلِ أَعْدَائِكَ فِيْ بِلَادِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا تَدَعَ لِلْجَوْرِ يَا رَبِّ دِعَامَةً اِلَّا قَصَمْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا بَقِيَّةً اِلَّا أَفْنَيْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا قُوَّةً اِلَّا أَوْهَنْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا رُكْنًا اِلَّا هَدَمْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَدًّا اِلَّا فَلَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا سِلَاحًا اِلَّا أَكْلَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا رَايَةً اِلَّا نَكَّسْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا شُجَاعًا اِلَّا قَتَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا جَيْشًا اِلَّا خَذَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَارْمِهِمْ يَا رَبِّ بِحَجَرِكَ الدَّامِغِ"
    },
    {
      "kind": "text",
      "ar": "وَاضْرِبْهُمْ بِسَيْفِكَ الْقَاطِعِ"
    },
    {
      "kind": "text",
      "ar": "وَبَأْسِكَ الَّذِيْ لَا تَرُدُّهٗ عَنِ الْقَوْمِ الْمُجْرِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَذِّبْ أَعْدَائَكَ وَأَعْدَاءَ وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْدَاءَ رَسُوْلِكَ صَلَوَاتُكَ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "بِيَدِ وَلِيِّكَ وَأَيْدِيْ عِبَادِكَ الْمُؤْمِنِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اكْفِ وَلِيَّكَ وَحُجَّتَكَ فِيْ أَرْضِكَ"
    },
    {
      "kind": "text",
      "ar": "هَوْلَ عَدُوِّهِ وَكَيْدَ مَنْ أَرَادَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَامْكُرْ بِمَنْ مَكَرَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ دَائِرَةَ السَّوْءِ عَلٰي مَنْ أَرَادَ بِهٖ سُوْئًا"
    },
    {
      "kind": "text",
      "ar": "وَاقْطَعْ عَنْهُ مَادَّتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْعِبْ لَهٗ قُلُوْبَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَزَلْزِلْ أَقْدَامَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَخُذْهُمْ جَهْرَةً وَبَغْتَةً"
    },
    {
      "kind": "text",
      "ar": "وَشَدِّدْ عَلَيْهِمْ عَذَابَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْزِهِمْ فِيْ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَنْهُمْ فِيْ بِلَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْكِنْهُمْ أَسْفَلَ نَارِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحِطْ بِهِمْ أَشَدَّ عَذَابِكَ، وَأَصْلِهِمْ نَارًا"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُ قُبُوْرَ مَوْتَاهُمْ نَارًا وَأَصْلِهِمْ حَرَّ نَارِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهُمْ أَضَاعُوْا الصَّلَاةَ وَاتَّبَعُوْا الشَّهَوَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَأَضَلُّوْا عِبَادَكَ وَأَخْرَبُوْا بِلَادَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَحْيِ بِوَلِيِّكَ الْقُرْاٰنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرِنَا نُوْرَهٗ سَرْمَدًا لَا لَيْلَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْيِ بِهِ الْقُلُوْبَ الْمَيِّتَةَ"
    },
    {
      "kind": "text",
      "ar": "وَاشْفِ بِهِ الصُّدُوْرَ الْوَغِرَةَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْمَعْ بِهِ الْاَهْوَاءَ الْمُخْتَلِفَةَ عَلَي الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "وَأَقِمْ بِهِ الْحُدُوْدَ الْمُعَطَّلَةَ وَالْاَحْكَامَ الْمُهْمَلَةَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا يَبْقي حَقٌّ اِلَّا ظَهَرَ وَلَا عَدْلٌ اِلَّا زَهَرَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا يَا رَبِّ مِنْ أَعْوَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمُقَوِّيَةِ سُلْطَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُؤْتَمِرِيْنَ لِاَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّاضِيْنَ بِفِعْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسَلِّمِيْنَ لِاَحْكَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمِمَّنْ لَا حَاجَةَ بِهٖ اِلَي التَّقِيَّةِ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ يَا رَبِّ الَّذِيْ تَكْشِفُ الضُّرَّ"
    },
    {
      "kind": "text",
      "ar": "وَتُجِيْبُ الْمُضْطَرَّ اِذَا دَعَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَتُنْجِيْ مِنَ الْكَرْبِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "فَاكْشِفْ الضُّرَّ عَنْ وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ خَلِيْفَةً فِيْ أَرْضِكَ كَمَا ضَمِنْتَ لَهُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَجْعَلْنِيْ مِنْ خُصَمَاءِ اٰلِ مُحَمَّدٍ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْنِيْ مِنْ أَعْدَاءِ اٰلِ مُحَمَّدٍ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجَعَلْنِيْ مِنْ أَهْلِ الْحَنَقِ وَالْغَيْظِ عَلٰي اٰلِ مُحَمَّدٍ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ أَعُوْذُ بِكَ مِنْ ذٰلِكَ فَأَعِذْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَجِيْرُ بِكَ فَأَجِرْنِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ بِهِمْ فَائِزًا عِنْدَكَ فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الْمُقَرَّبِيْنَ اٰمِيْنَ رَبَّ الْعَالَمِيْنَ۔"
    }
  ]
}