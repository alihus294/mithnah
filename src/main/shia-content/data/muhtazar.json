{
  "id": "muhtazar",
  "title": "آداب محتضر",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "آداب محتضر",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ الْحَلِيْمُ الْكَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ الْعَلِيُّ الْعَظِيْمُ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ رَبِّ السَّمٰوَاتِ السَّبْعِ وَرَبِّ الْاَرَضِيْنَ السَّبْعِ"
    },
    {
      "kind": "text",
      "ar": "وَمَا فِيْهِنَّ وَمَا بَيْنَهُنَّ وَمَا تَحْتَهُنَّ"
    },
    {
      "kind": "text",
      "ar": "وَرَبِّ الْعَرْشِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالصَّلَاةُ عَلٰي مُحَمَّدٍ وَاٰلِهِ الطَّيِّبِيْنَ"
    }
  ]
}