{
  "id": "namaz-jafar-tayyar",
  "title": "نماز حضرت جعفر طيار",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز حضرت جعفر طيار",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ وَالْحَمْدُ لِلّٰهِ وَلَا اِلٰهَ اِلَّا اللهُ وَاللهُ اَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَبِسَ الْعِزَّ وَالْوَقَارَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ تَعَطَّفَ بِالْمَجْدِ وَتَكَرَّمَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا يَنْبَغِي التَّسْبِيْحُ اِلَّا لَهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ أَحْصٰي كُلَّ شَيْءٍ عِلْمُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ ذِي الْمَنِّ وَالنِّعَمِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ ذِي الْقُدْرَةِ وَالْكَرَمِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِمَعَاقِدِ الْعِزِّ مِنْ عَرْشِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُنْتَهَي الرَّحْمَةِ مِنْ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْمِكَ الْاَعْظَمِ وَكَلِمَاتِكَ التَّامَّةِ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ تَمَّتْ صِدْقًا وَعَدْلًا"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَافْعَلْ بِيْ كَذَا وَكَذَا"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ يَا رَبّ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبَّاهُ يَا رَبَّاهُ"
    },
    {
      "kind": "text",
      "ar": "رَبِّ رَبِّ"
    },
    {
      "kind": "text",
      "ar": "يَا اَللّٰهُ يَا اَللّٰهُ"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ يَا حَيُّ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحِيْمُ يَا رَحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحْمٰنُ يَا رَحْمٰنُ"
    },
    {
      "kind": "text",
      "ar": "يَا اَرْحَمُ الرَّاحِمِيْنِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَفْتَتِحُ الْقَوْلَ بِحَمْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْطِقُ بِالثَّنَاءِ عَلَيْكَ وَاُمَجِّدُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا غَايَةَ لِمَدْحِكَ، وَأُثْنِيْ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ يَبْلُغُ غَايَةَ ثَنَائِكَ وَأَمَدَ مَجْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنّٰي لِخَلِيْقَتِكَ كُنْهُ مَعْرِفَةِ مَجْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَيُّ زَمَنٍ لَمْ تَكُنْ مَمْدُوْحًا بِفَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "مَوْصُوْفًا بِمَجْدِكَ"
    },
    {
      "kind": "text",
      "ar": "عَوَّادًا عَلَي الْمُذْنِبِيْنَ بِحِلْمِكَ"
    },
    {
      "kind": "text",
      "ar": "تَخَلَّفَ سُكَّانُ أَرْضِكَ عَنْ طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَكُنْتَ عَلَيْهِمْ عَطُوْفًا بِجُوْدِكَ"
    },
    {
      "kind": "text",
      "ar": "جَوَادًا بِفَضْلِكَ، عَوَّادًا بِكَرَمِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا لَا اِلٰهَ اِلَّا أَنْتَ الْمَنَّانُ ذُوالْجَلَالِ وَالْاِكْرَامِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ أَظْهَرَ الْجَمِيْلَ وَسَتَرَ الْقَبِيْحَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَمْ يُؤَاخِذْ بِالْجَرِيْرَةِ، وَلَمْ يَهْتِكِ السِّتْرَ"
    },
    {
      "kind": "text",
      "ar": "يَا عَظِيْمَ الْعَفْوِ، يَا حَسَنَ التَّجَاوُزِ"
    },
    {
      "kind": "text",
      "ar": "يَا وَاسِعَ الْمَغْفِرَةِ، يَا بَاسِطَ الْيَدَيْنِ بِالرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "يَا صَاحِبَ كُلِّ نَجْوٰي، وَمُنْتَهٰي كُلِّ شَكْوٰي"
    },
    {
      "kind": "text",
      "ar": "يَا مُقِيْلَ الْعَثَرَاتِ، يَا كَرِيْمَ الصَّفْحِ"
    },
    {
      "kind": "text",
      "ar": "يَا عَظِيْمَ الْمَنِّ، يَا مُبْتَدِئًا بِالنِّعَمِ قَبْلَ اسْتِحْقَاقِهَا"
    },
    {
      "kind": "text",
      "ar": "يَا رَبَّاهُ يَا رَبَّاهُ يَا رَبَّاهُ"
    },
    {
      "kind": "text",
      "ar": "يَا اَللّٰهُ يَا اَللّٰهُ يَا اَللّٰهُ"
    },
    {
      "kind": "text",
      "ar": "يَا سَيِّدَاهُ يَا سَيِّدَاهُ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَاهُ يَا مَوْلَايَاهُ"
    },
    {
      "kind": "text",
      "ar": "يَا رَجَآءَاهُ"
    },
    {
      "kind": "text",
      "ar": "يَا غِيَاثَاهُ"
    },
    {
      "kind": "text",
      "ar": "يَا غَايَةَ رَغْبَتَاهُ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحْمٰنُ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُعْطِيَ الْخَيْرَات"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ كَثِيْرًا طَيِّبًا"
    },
    {
      "kind": "text",
      "ar": "كَاَفْضَلِ مَا صَلَّيْتَ عَلٰي اَحدٍ مِنْ خَلْقِكَ"
    }
  ]
}