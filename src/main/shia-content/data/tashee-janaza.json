{
  "id": "tashee-janaza",
  "title": "تشيع جنازه",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تشيع جنازه",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "الله أَكْبَرُ هٰذَا مَا وَعَدَنَا اللهُ وَرَسُوْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَصَدَقَ اللهُ وَرَسُوْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ زِدْنَا اِيْمَانًا وَتَسْلِيْمًا"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ تَعَزَّزَ بِالْقُدْرَةِ وَقَهَرَ الْعِبَادَ بِالْمَوْت"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ الله وَبِاللّٰهِ اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لِلْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَمْ يَجْعَلَنِيْ مِنَ السَّوَادِ الْمُخْتَرَمِ"
    }
  ]
}