{
  "id": "ziarat-imams-samara",
  "title": "امام علي نقي و امام حسن عسكري كي زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام علي نقي و امام حسن عسكري كي زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمَا يَا وَلِيَّيِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمَا يَا حُجَّتَيِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمَا يَا نُوْرَيِ اللهِ فِيْ ظُلُمَاتِ الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمَا يَا مَنْ بَدَا لِلّٰهِ فِيْ شَأْنِكُمَا"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكُمَا زَائِرًا، عَارِفًا بِحَقِّكُمَا"
    },
    {
      "kind": "text",
      "ar": "مُعَادِيًا لِاَعْدَائِكُمَا، مُوَالِيًا لِاَوْلِيَائِكُمَا"
    },
    {
      "kind": "text",
      "ar": "مُؤْمِنًا بِمَا اٰمَنْتُمَا بِهٖ، كَافِرًا بِمَا كَفَرْتُمَا بِهٖ"
    },
    {
      "kind": "text",
      "ar": "مُحَقِّقًا لِمَا حَقَّقْتُمَا، مُبْطِلًا لِمَا أَبْطَلْتُمَا"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُ اللهَ رَبِّيْ وَرَبَّكُمَا"
    },
    {
      "kind": "text",
      "ar": "أَنْ يَجْعَلَ حَظِّيْ مِنْ زِيَارَتِكُمَا"
    },
    {
      "kind": "text",
      "ar": "الصَّلَاةَ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ يَرْزُقَنِيْ مُرَافَقَتَكُمَا فِي الْجِنَانِ"
    },
    {
      "kind": "text",
      "ar": "مَعَ اٰبَائِكُمَا الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُهٗ أَنْ يُعْتِقَ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَيَرْزُقَنِيْ شَفَاعَتَكُمَا وَمُصَاحَبَتَكُمَا"
    },
    {
      "kind": "text",
      "ar": "وَيُعَرِّفَ بَيْنِيْ وَبَيْنَكُمَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَسْلُبَنِيْ حُبَّكُمَا وَحُبَّ اٰبَائِكُمَا الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ لَا يَجْعَلَهُ اٰخِرَ الْعَهْدِ مِنْ زِيَارَتِكُمَا"
    },
    {
      "kind": "text",
      "ar": "وَيَحْشُرَنِيْ مَعَكُمَا فِي الْجَنَّةِ بِرَحْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنِيْ حُبَّهُمَا وَتَوَفَّنِيْ عَلٰي مِلَّتِهِمَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ الْعَنْ ظَالِمِيْ اٰلِ مُحَمَّدٍ حَقَّهُمْ، وَانْتَقِمْ مِنْهُمْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ الْعَنِ الْاَوَّلِيْنَ مِنْهُمْ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَضَاعِفْ عَلَيْهِمُ الْعَذَابَ"
    },
    {
      "kind": "text",
      "ar": "وَابْلُغْ بِهِمْ وَبِأَشْيَاعِهِمْ وَمُحِبِّيْهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَمُتَّبِعِيْهِمْ أَسْفَلَ دَرَكٍ مِنَ الْجَحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَجِّلْ فَرَجَ وَلِيِّكَ وَابْنِ وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ فَرَجَنَا مَعَ فَرَجِهٖ، يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}