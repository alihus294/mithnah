{
  "id": "shaban-night15",
  "title": "شبِ نيمۂ شعبان",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "شبِ نيمۂ شعبان",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا اَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِحَقِّ لَيْلَتِنَا هٰذِهٖ وَمَوْلُوْدِهَا"
    },
    {
      "kind": "text",
      "ar": "وَحُجَّتِكَ وَمَوْعُوْدِهَا"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ قَرَنْتَ اِلٰي فَضْلِهَا فَضْلًا"
    },
    {
      "kind": "text",
      "ar": "فَتَمَّتْ كَلِمَتُكَ صِدْقًا وَعَدْلًا"
    },
    {
      "kind": "text",
      "ar": "لَا مُبَدِّلَ لِكَلِمَاتِكَ وَلَا مُعَقِّبَ لِاٰيَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "نُوْرُكَ الْمُتَأَلِّقُ، وَضِيَاؤُكَ الْمُشْرِقُ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَلَمُ النُّوْرُ فِيْ طَخْيَاءِ الدَّيْجُوْرِ الْغَائِبُ الْمَسْتُوْرُ"
    },
    {
      "kind": "text",
      "ar": "جَلَّ مَوْلِدُهٗ، وَكَرُمَ مَحْتِدُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَلَائِكَةُ شُهَّدُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاللهُ نَاصِرُهٗ وَمُؤَيِّدُهٗ"
    },
    {
      "kind": "text",
      "ar": "اِذَا اٰنَ مِيْعَادُهٗ وَالْمَلَائِكَةُ أَمْدَادُهٗ"
    },
    {
      "kind": "text",
      "ar": "سَيْفُ اللهِ الَّذِيْ لَا يَنْبُوْ"
    },
    {
      "kind": "text",
      "ar": "وَنُوْرُهُ الَّذِيْ لَا يَخْبُوْ"
    },
    {
      "kind": "text",
      "ar": "وَذُو الْحِلْمِ الَّذِيْ لَا يَصْبُوْ"
    },
    {
      "kind": "text",
      "ar": "مَدَارُ الدَّهْرِ"
    },
    {
      "kind": "text",
      "ar": "وَنَوَامِيْسُ الْعَصْرِ، وَوُلَاةُ الْاَمْرِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُنَزَّلُ عَلَيْهِمْ مَا يَتَنَزَّلُ فِيْ لَيْلَةِ الْقَدْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْحَابُ الْحَشْرِ وَالنَّشْرِ"
    },
    {
      "kind": "text",
      "ar": "تَرَاجِمَةُ وَحْيِهٖ، وَوُلَاةُ أَمْرِهٖ وَنَهْيِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَصَلِّ عَلٰي خَاتِمِهِمْ وَقَائِمِهِمُ"
    },
    {
      "kind": "text",
      "ar": "الْمَسْتُوْرِ عَنْ عَوَالِمِهِمْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَدْرِكْ بِنَا أَيَّامَهٗ وَظُهُوْرَهٗ وَقِيَامَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا مِنْ أَنْصَارِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاقْرِنْ ثَأْرَنَا بِثَأْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاكْتُبْنَا فِيْ أَعْوَانِهٖ وَخُلَصَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْيِنَا فِيْ دَوْلَتِهٖ نَاعِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِصُحْبَتِهٖ غَانِمِيْنَ، وَبِحَقِّهٖ قَائِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ السُّوْءِ سَالِمِيْنَ، يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَوَاتُهٗ عَلٰي سَيِّدِنَا مُحَمَّدٍ خَاتَمِ النَّبِيِّيْنَ وَالْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَهْلِ بَيْتِهِ الصَّادِقِيْنَ، وَعِتْرَتِهِ النَّاطِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَنْ جَمِيْعَ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْكُمْ بَيْنَنَا وَبَيْنَهُمْ يَا أَحْكَمَ الْحَاكِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الْحَيُّ الْقَيُّوْمُ"
    },
    {
      "kind": "text",
      "ar": "الْعَلِيُّ الْعَظِيْمُ الْخَالِقُ الرَّازِقُ"
    },
    {
      "kind": "text",
      "ar": "الْمُحْيِي الْمُمِيْتُ الْبَدِيْءُ الْبَدِيْعُ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْجَلَالُ وَلَكَ الْفَضْلُ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ الْحَمْدُ وَلَكَ الْمَنُّ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ الْجُوْدُ وَلَكَ الْكَرَمُ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ الْاَمْرُ وَلَكَ الْمَجْدُ وَلَكَ الشُّكْرُ"
    },
    {
      "kind": "text",
      "ar": "وَحْدَكَ لَا شَرِيْكَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "يَا وَاحِدُ يَا أَحَدُ يَا صَمَدُ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَمْ يَلِدْ وَلَمْ يُوْلَدْ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ كُفُوًا أَحَدٌ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لِيْ وَارْحَمْنِيْ وَاكْفِنِيْ مَا أَهَمَّنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاقْضِ دَيْنِيْ، وَوَسِّعْ عَلَيَّ فِيْ رِزْقِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ فِيْ هٰذِهِ اللَّيْلَةِ كُلَّ أَمْرٍ حَكِيْمٍ تَفْرُقُ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ تَشَاءُ مِنْ خَلْقِكَ تَرْزُقُ"
    },
    {
      "kind": "text",
      "ar": "فَارْزُقْنِيْ وَأَنْتَ خَيْرُ الرَّازِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ قُلْتَ وَأَنْتَ خَيْرُ الْقَائِلِيْنَ النَّاطِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْأَلُوا اللهَ مِنْ فَضْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَمِنْ فَضْلِكَ أَسْأَلُ، وَاِيَّاكَ قَصَدْتُ"
    },
    {
      "kind": "text",
      "ar": "وَابْنَ نَبِيِّكَ اعْتَمَدْتُ، وَلَكَ رَجَوْتُ"
    },
    {
      "kind": "text",
      "ar": "فَارْحَمْنِيْ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اقْسِمْ لَنَا مِنْ خَشْيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "مَا يَحُوْلُ بَيْنَنَا وَبَيْنَ مَعْصِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ طَاعَتِكَ مَا تُبَلِّغُنَا بِهٖ رِضْوَانَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الْيَقِيْنِ مَا يَهُوْنُ عَلَيْنَا بِهٖ مُصِيْبَاتُ الدُّنْيَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَمْتِعْنَا بِأَسْمَاعِنَا وَأَبْصَارِنَا وَقُوَّتِنَا مَا أَحْيَيْتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ الْوَارِثَ مِنَّا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ ثَأْرَنَا عَلٰي مَنْ ظَلَمَنَا"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْنَا عَلٰي مَنْ عَادَانَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْ مُصِيْبَتَنَا فِيْ دِيْنِنَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلِ الدُّنْيَا أَكْبَرَ هَمِّنَا وَلَا مَبْلَغَ عِلْمِنَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُسَلِّطْ عَلَيْنَا مَنْ لَا يَرْحَمُنَا"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ وَالْحَمْدُ لِلّٰهِ وَاللهُ اَكْبَرُ وَلَا اِلٰهَ اِلَّا الله"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ اِلَيْهِ مَلْجَأُ الْعِبَادِ فِي الْمُهِمَّاتِ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْهِ يَفْزَعُ الْخَلْقُ فِي الْمُلِمّاتِ"
    },
    {
      "kind": "text",
      "ar": "يَا عَالِمَ الْجَهْرِ وَالْخَفِيّاتِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا تَخْفٰي عَلَيْهِ خَوَاطِرُ الْاَوْهَامِ وَتَصَرُّفُ الْخَطَرَاتِ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبَّ الْخَلَائِقِ وَالْبَرِيَّاتِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ بِيَدِهٖ مَلَكُوْتُ الْاَرَضِيْنَ وَالسَّمَاوَاتِ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "أَمُتُّ اِلَيْكَ بِلَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "فَيَا لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "اجْعَلْنِيْ فِيْ هٰذِهِ اللَّيْلَةِ"
    },
    {
      "kind": "text",
      "ar": "مِمَّنْ نَظَرْتَ اِلَيْهِ فَرَحِمْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَسَمِعْتَ دُعَائَهٗ فَأَجَبْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِمْتَ اسْتِقَالَتَهٗ فَأَقَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَتَجَاوَزْتَ عَنْ سَالِفِ خَطِيْئَتِهٖ وَعَظِيْمِ جَرِيْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَقَدِ اسْتَجَرْتُ بِكَ مِنْ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَجَأْتُ اِلَيْكَ فِيْ سَتْرِ عُيُوْبِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَجُدْ عَلَيَّ بِكَرَمِكَ وَفَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْطُطْ خَطَايَايَ بِحِلْمِكَ وَعَفْوِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَغَمَّدْنِيْ فِيْ هٰذِهِ اللَّيْلَةِ بِسَابِغِ كَرَامَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ فِيْهَا مِنْ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ اجْتَبَيْتَهُمْ لِطَاعَتِكَ، وَاخْتَرْتَهُمْ لِعِبَادَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهُمْ خَالِصَتَكَ وَصِفْوَتَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ مِمَّنْ سَعَدَ جَدُّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَفَّرَ مِنَ الْخَيْرَاتِ حَظُّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِمَّنْ سَلِمَ فَنَعِمَ، وَفَازَ فَغَنِمَ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِنِيْ شَرَّ مَا أَسْلَفْتُ"
    },
    {
      "kind": "text",
      "ar": "وَاعْصِمْنِيْ مِنَ الْاِزْدِيَادِ فِيْ مَعْصِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَبِّبْ اِلَيَّ طَاعَتَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَا يُقَرِّبُنِيْ مِنْكَ وَيُزْلِفُنِيْ عِنْدَكَ۔"
    },
    {
      "kind": "text",
      "ar": "سَيِّدِيْ اِلَيْكَ يَلْجَأُ الْهَارِبُ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْكَ يَلْتَمِسُ الطَّالِبُ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي كَرَمِكَ يُعَوِّلُ الْمُسْتَقِيْلُ التَّائِبُ"
    },
    {
      "kind": "text",
      "ar": "أَدَّبْتَ عِبَادَكَ بِالتَّكَرُّمِ، وَأَنْتَ أَكْرَمُ الْاَكْرَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْعَفْوِ عِبَادَكَ وَأَنْتَ الْغَفُوْرُ الرَّحِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَلَا تَحْرِمْنِيْ مَا رَجَوْتُ مِنْ كَرَمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُؤْيِسْنِيْ مِنْ سَابِغِ نِعَمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخَيِّبْنِيْ مِنْ جَزِيْلِ قِسَمِكَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ هٰذِهِ اللَّيْلَةِ لِاَهْلِ طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ فِيْ جُنَّةٍ مِنْ شِرَارِ بَرِيَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "رَبِّ اِنْ لَمْ أَكُنْ مِنْ أَهْلِ ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَنْتَ أَهْلُ الْكَرَمِ وَالْعَفْوِ وَالْمَغْفِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَجُدْ عَلَيَّ بِمَا أَنْتَ أَهْلُهٗ لَا بِمَا أَسْتَحِقُّهٗ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ حَسُنَ ظَنِّيْ بِكَ، وَتَحَقَّقَ رَجَائِيْ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِقَتْ نَفْسِيْ بِكَرَمِكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَنْتَ أَرْحَمُ الرَّاحِمِيْنَ وَأَكْرَمُ الْاَكْرَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاخْصُصْنِيْ مِنْ كَرَمِكَ بِجَزِيْلِ قِسَمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِعَفْوِكَ مِنْ عُقُوْبَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذَّنْبَ الَّذِيْ يَحْبِسُ عَلَيَّ الْخُلُقَ"
    },
    {
      "kind": "text",
      "ar": "وَيُضَيِّقُ عَلَيَّ الرِّزْقَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَقُوْمَ بِصَالِحِ رِضَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْعَمَ بِجَزِيْلِ عَطَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْعَدَ بِسَابِغِ نَعْمَائِكَ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ لُذْتُ بِحَرَمِكَ وَتَعَرَّضْتُ لِكَرَمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَعَذْتُ بِعَفْوِكَ مِنْ عُقُوْبَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِحِلْمِكَ مِنْ غَضَبِكَ"
    },
    {
      "kind": "text",
      "ar": "فَجُدْ بِمَا سَأَلْتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنِلْ مَا الْتَمَسْتُ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِكَ لَا بِشَيْءٍ هُوَ أَعْظَمُ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ"
    },
    {
      "kind": "text",
      "ar": "يَا اَللّٰه"
    },
    {
      "kind": "text",
      "ar": "لَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "مَا شَاءَ الله"
    },
    {
      "kind": "text",
      "ar": "لَا قُوَّةَ اِلَّا بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ تَعَرَّضَ لَكَ فِيْ هٰذَا اللَّيْلِ الْمُتَعَرِّضُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَقَصَدَكَ الْقَاصِدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَّلَ فَضْلَكَ وَمَعْرُوْفَكَ الطّالِبُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ فِيْ هٰذَا اللَّيْلِ نَفَحَاتٌ"
    },
    {
      "kind": "text",
      "ar": "وَجَوَائِزُ وَعَطَايَا وَمَوَاهِبُ"
    },
    {
      "kind": "text",
      "ar": "تَمُنُّ بِهَا عَلٰي مَنْ تَشَاءُ مِنْ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَمْنَعُهَا مَنْ لَمْ تَسْبِقْ لَهُ الْعِنَايَةُ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَهَا أَنَا ذَا عُبَيْدُكَ الْفَقِيْرُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "الْمُؤَمِّلُ فَضْلَكَ وَمَعْرُوْفَكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ كُنْتَ يَا مَوْلَايَ تَفَضَّلْتَ فِيْ هٰذِهِ اللَّيْلَةِ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي أَحَدٍ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعُدْتَ عَلَيْهِ بِعَائِدَةٍ مِنْ عَطْفِكَ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "الطَّيِّبِيْنَ الطَّاهِرِيْنَ الْخَيِّرِيْنَ الْفَاضِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَجُدْ عَلَيَّ بِطَوْلِكَ وَمَعْرُوْفِكَ يَا رَبَّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ خَاتَمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاٰلِهِ الطَّاهِرِيْنَ وَسَلَّمَ تَسْلِيْمًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ حَمِيْدٌ مَجِيْدٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَدْعُوْكَ كَمَا أَمَرْتَ"
    },
    {
      "kind": "text",
      "ar": "فَاسْتَجِبْ لِيْ كَمَا وَعَدْتَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ لَا تُخْلِفُ الْمِيْعَادَ۔"
    },
    {
      "kind": "text",
      "ar": "سَجَدَ لَكَ سَوَادِيْ وَخَيَالِيْ، وَاٰمَنَ بِكَ فُؤَادِيْ"
    },
    {
      "kind": "text",
      "ar": "هٰذِهِ يَدَايَ وَمَا جَنَيْتُهٗ عَلٰي نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا عَظِيْمُ تُرْجٰي لِكُلِّ عَظِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "اغْفِرْ لِيَ الْعَظِيْمَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ لَا يَغْفِرُ الذَّنْبَ الْعَظِيْمَ اِلَّا الرَّبُّ الْعَظِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِنُوْرِ وَجْهِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ أَضَائَتْ لَهُ السَّمَاوَاتُ وَالْاَرَضُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَانْكَشَفَتْ لَهُ الظُّلُمَاتُ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَحَ عَلَيْهِ أَمْرُ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ فُجْأَةِ نَقِمَتِكَ، وَمِنْ تَحْوِيْلِ عَافِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ زَوَالِ نِعْمَتِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنِيْ قَلْبًا تَقِيًّا نَقِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الشِّرْكِ بَرِيْئًا لَا كَافِرًا وَلَا شَقِيًّا"
    },
    {
      "kind": "text",
      "ar": "عَفَّرْتُ وَجْهِيْ فِيْ التُّرَابِ"
    },
    {
      "kind": "text",
      "ar": "وَحُقَّ لِّيْٓ اَنْ اَسْجُدَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ اِلَيْكَ فَقِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ عَذَابِكَ خَائِفٌ مُسْتَجِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تُبَدِّلِ اسْمِيْ، وَلَا تُغَيِّرْ جِسْمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْهَدْ بَلَائِيْ، وَلَا تُشْمِتْ بِيْ أَعْدَائِيْ"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِعَفْوِكَ مِنْ عِقَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِرَحْمَتِكَ مِنْ عَذَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِرِضَاكَ مِنْ سَخَطِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "جَلَّ ثَنَاؤُكَ أَنْتَ كَمَا أَثْنَيْتَ عَلٰي نَفْسِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفَوْقَ مَا يَقُوْلُ الْقَائِلُوْنَ۔"
    }
  ]
}