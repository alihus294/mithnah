{
  "id": "namaz-asr-adaab",
  "title": "نماز عصر كے آداب",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز عصر كے آداب",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ دَعَوْتَنِيْ فَأَجَبْتُ دَعْوَتَكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّيْتُ مَكْتُوْبَتَك"
    },
    {
      "kind": "text",
      "ar": "وَانْتَشَرْتُ فِيْ أَرْضِكَ كَمَا أَمَرْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْأَلُكَ مِنْ فَضْلِكَ الْعَمَلَ بِطَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْتِنَابَ مَعْصِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْكَفَافَ مِنَ الرِّزْقِ بِرَحْمَتِكَ"
    }
  ]
}