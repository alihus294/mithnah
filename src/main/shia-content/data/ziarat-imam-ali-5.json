{
  "id": "ziarat-imam-ali-5",
  "title": "پانچويں زيارت مطلقه",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "پانچويں زيارت مطلقه",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ أَوَّلُ مَظْلُوْمٍ، وَأَوَّلُ مَنْ غُصِبَ حَقُّهٗ"
    },
    {
      "kind": "text",
      "ar": "صَبَرْتَ وَاحْتَسَبْتَ حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "فَأَشْهَدُ أَنَّكَ لَقِيْتَ اللهَ وَأَنْتَ شَهِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "عَذَّبَ اللهُ قَاتِلَكَ بِأَنْوَاعِ الْعَذَابِ"
    },
    {
      "kind": "text",
      "ar": "وَجَدَّدَ عَلَيْهِ الْعَذَابَ"
    },
    {
      "kind": "text",
      "ar": "جِئْتُكَ عَارِفًا بِحَقِّكَ، مُسْتَبْصِرًا بِشَأْنِكَ"
    },
    {
      "kind": "text",
      "ar": "مُعَادِيًا لِاَعْدَائِكَ وَمَنْ ظَلَمَكَ"
    },
    {
      "kind": "text",
      "ar": "أَلْقٰي عَلٰي ذٰلِكَ رَبِّيْ اِنْ شَاءَ اللهُ"
    },
    {
      "kind": "text",
      "ar": "يَا وَلِيَّ اللهِ، اِنَّ لِيْ ذُنُوْبًا كَثِيْرَةً"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ اِلٰي رَبِّكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ لَكَ عِنْدَ اللهِ مَقَامًا مَعْلُوْمًا"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّ لَكَ عِنْدَ اللهِ جَاهًا وَشَفَاعَةً"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ قَالَ اللهُ تَعَالٰي وَلَا يَشْفَعُوْنَ اِلَّا لِمَنِ ارْتَضٰي۔"
    }
  ]
}