{
  "id": "dua-amn",
  "title": "دعاء امن از بلا وغيره",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء امن از بلا وغيره",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ تُحَلُّ بِهٖ عُقَدُ الْمَكَارِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مَنْ يُفْثَأُ بِهٖ حَدُّ الشَّدَائِدِ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مَنْ يُلْتَمَسُ مِنْهُ الْمَخْرَجُ اِلٰي رَوْحِ الْفَرَجِ"
    },
    {
      "kind": "text",
      "ar": "ذَلَّتْ لِقُدْرَتِكَ الصِّعَابُ"
    },
    {
      "kind": "text",
      "ar": "وَتَسَبَّبَتْ بِلُطْفِكَ الْأَسْبَابُ"
    },
    {
      "kind": "text",
      "ar": "وَجَرٰي بِقُدْرَتِكَ الْقَضَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَمَضَتْ عَلٰي اِرَادَتِكَ الْأَشْيَاءُ"
    },
    {
      "kind": "text",
      "ar": "فَهِيَ بِمَشِيْئَتِكَ دُوْنَ قَوْلِكَ مُؤْتَمِرَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِاِرَادَتِكَ دُوْنَ نَهْيِكَ مُنْزَجِرَةٌ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ الْمَدْعُوُّ لِلْمُهِمَّاتِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمَفْزَعُ فِي الْمُلِمَّاتِ"
    },
    {
      "kind": "text",
      "ar": "لَا يَنْدَفِعُ مِنْهَا اِلَّا مَا دَفَعْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَنْكَشِفُ مِنْهَا اِلَّا مَا كَشَفْتَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ نَزَلَ بِيْ يَا رَبِّ مَا قَدْ تَكَأَّدَنِيْ ثِقْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَلَمَّ بِيْ مَا قَدْ بَهَظَنِيْ حَمْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَبِقُدْرَتِكَ أَوْرَدْتَهٗ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَبِسُلْطَانِكَ وَجَّهْتَهٗ اِلَيَّ"
    },
    {
      "kind": "text",
      "ar": "فَلَا مُصْدِرَ لِمَا أَوْرَدْتَ، وَلَا صَارِفَ لِمَا وَجَّهْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا فَاتِحَ لِمَا أَغْلَقْتَ، وَلَا مُغْلِقَ لِمَا فَتَحْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُيَسِّرَ لِمَا عَسَّرْتَ، وَلَا نَاصِرَ لِمَنْ خَذَلْتَ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَافْتَحْ لِيْ يَا رَبِّ بَابَ الْفَرَجِ بِطَوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاكْسِرْ عَنِّيْ سُلْطَانَ الْهَمِّ بِحَوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنِلْنِيْ حُسْنَ النَّظَرِ فِيْمَا شَكَوْتُ"
    },
    {
      "kind": "text",
      "ar": "وَأَذِقْنِيْ حَلَاوَةَ الصُّنْعِ فِيْمَا سَأَلْتُ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيْ مِنْ لَدُنْكَ رَحْمَةً وَفَرَجًا هَنِيْئًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لِيْ مِنْ عِنْدِكَ مَخْرَجًا وَحِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَشْغَلْنِيْ بِالْاِهْتِمَامِ"
    },
    {
      "kind": "text",
      "ar": "عَنْ تَعَاهُدِ فُرُوْضِكَ وَاسْتِعْمَالِ سُنَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ ضِقْتُ لِمَا نَزَلَ بِيْ يَا رَبِّ ذَرْعًا"
    },
    {
      "kind": "text",
      "ar": "وَامْتَلْأَتُ بِحَمْلِ مَا حَدَثَ عَلَيَّ هَمًّا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْقَادِرُ عَلٰي كَشْفِ مَا مُنِيْتُ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَدَفْعِ مَا وَقَعْتُ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "فَافْعَلْ بِيْ ذٰلِكَ وَاِنْ لَمْ أَسْتَوْجِبْهُ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "يَا ذَا الْعَرْشِ الْعَظِيْمِ، وَذَا الْمَنِّ الْكَرِيْمِ"
    },
    {
      "kind": "text",
      "ar": "فَأَنْتَ قَادِرٌ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اٰمِيْنَ رَبَّ الْعَالَمِيْنَ"
    }
  ]
}