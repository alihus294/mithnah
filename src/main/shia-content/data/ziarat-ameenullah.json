{
  "id": "ziarat-ameenullah",
  "title": "زيارت امين الله",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت امين الله",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَمِيْنَ اللهِ فِيْ أَرْضِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحُجَّتَهٗ عَلٰي عِبَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَمِيْرَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ جَاهَدْتَ فِي اللهِ حَقَّ جِهَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَمِلْتَ بِكِتَابِهٖ وَاتَّبَعْتَ سُنَنَ نَبِيِّهٖ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي دَعَاكَ اللهُ اِلٰي جِوَارِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَقَبَضَكَ اِلَيْهِ بِاخْتِيَارِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْزَمَ أَعْدَائَكَ الْحُجَّةَ مَعَ مَا لَكَ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْحُجَجِ الْبَالِغَةِ عَلٰي جَمِيْعِ خَلْقِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاجْعَلْ نَفْسِيْ مُطْمَئِنَّةً بِقَدَرِكَ"
    },
    {
      "kind": "text",
      "ar": "رَاضِيَةً بِقَضَائِكَ، مُوْلَعَةً بِذِكْرِكَ وَدُعَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مُحِبَّةً لِصَفْوَةِ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مَحْبُوْبَةً فِيْ أَرْضِكَ وَسَمَائِكَ"
    },
    {
      "kind": "text",
      "ar": "صَابِرَةً عَلٰي نُزُوْلِ بَلَائِكَ"
    },
    {
      "kind": "text",
      "ar": "شَاكِرَةً لِفَوَاضِلِ نَعْمَائِكَ"
    },
    {
      "kind": "text",
      "ar": "ذَاكِرَةً لِسَوَابِغِ اٰلَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مُشْتَاقَةً اِلٰي فَرْحَةِ لِقَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مُتَزَوِّدَةً التَّقْوٰي لِيَوْمِ جَزَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَنَّةً بِسُنَنِ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مُفَارِقَةً لِاَخْلَاقِ أَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مَشْغُوْلَةً عَنِ الدُّنْيَا بِحَمْدِكَ وَثَنَائِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ قُلُوْبَ الْمُخْبِتِيْنَ اِلَيْكَ وَالِهَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَسُبُلَ الرَّاغِبِيْنَ اِلَيْكَ شَارِعَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْلَامَ الْقَاصِدِيْنَ اِلَيْكَ وَاضِحَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْئِدَةَ الْعَارِفِيْنَ مِنْكَ فَازِعَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْوَاتَ الدَّاعِيْنَ اِلَيْكَ صَاعِدَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْوَابَ الْاِجَابَةِ لَهُمْ مُفَتَّحَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَدَعْوَةَ مَنْ نَاجَاكَ مُسْتَجَابَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَتَوْبَةَ مَنْ أَنَابَ اِلَيْكَ مَقْبُوْلَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَعَبْرَةَ مَنْ بَكٰي مِنْ خَوْفِكَ مَرْحُوْمَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِغَاثَةَ لِمَنِ اسْتَغَاثَ بِكَ مَوْجُوْدَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِعَانَةَ لِمَنِ اسْتَعَانَ بِكَ مَبْذُوْلَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَعِدَاتِكَ لِعِبَادِكَ مُنْجَزَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَزَلَلَ مَنِ اسْتَقَالَكَ مُقَالَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْمَالَ الْعَامِلِيْنَ لَدَيْكَ مَحْفُوْظَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْزَاقَكَ اِلَي الْخَلَائِقِ مِنْ لَدُنْكَ نَازِلَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَعَوَائِدَ الْمَزِيْدِ اِلَيْهِمْ وَاصِلَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَذُنُوْبَ الْمُسْتَغْفِرِيْنَ مَغْفُوْرَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَحَوَائِجَ خَلْقِكَ عِنْدَكَ مَقْضِيَّةٌ"
    },
    {
      "kind": "text",
      "ar": "وَجَوَائِزَ السَّائِلِيْنَ عِنْدَكَ مُوَفَّرَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَعَوَائِدَ الْمَزِيْدِ مُتَوَاتِرَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَمَوَائِدَ الْمُسْتَطْعِمِيْنَ مُعَدَّةٌ"
    },
    {
      "kind": "text",
      "ar": "وَمَنَاهِلَ الظِّمَاءِ مُتْرَعَةٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاسْتَجِبْ دُعَائِيْ، وَاقْبَلْ ثَنَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْمَعْ بَيْنِيْ وَبَيْنَ أَوْلِيَائِيْ"
    },
    {
      "kind": "text",
      "ar": "بِحَقِّ مُحَمَّدٍ وَعَلِيٍّ وَفَاطِمَةَ وَالْحَسَنِ وَالْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ وَلِيُّ نَعْمَائِيْ، وَمُنْتَهٰي مُنَايَ"
    },
    {
      "kind": "text",
      "ar": "وَغَايَةُ رَجَائِيْ فِيْ مُنْقَلَبِيْ وَمَثْوَايَ۔"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ اِلٰهِيْ وَسَيِّدِيْ وَمَوْلَايَ، اغْفِرْ لِاَوْلِيَائِنَا"
    },
    {
      "kind": "text",
      "ar": "وَكُفَّ عَنَّا أَعْدَائَنَا، وَاشْغَلْهُمْ عَنْ أَذَانَا"
    },
    {
      "kind": "text",
      "ar": "وَأَظْهِرْ كَلِمَةَ الْحَقِّ وَاجْعَلْهَا الْعُلْيَا"
    },
    {
      "kind": "text",
      "ar": "وَأَدْحِضْ كَلِمَةَ الْبَاطِلِ وَاجْعَلْهَا السُّفْلي"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ۔"
    }
  ]
}