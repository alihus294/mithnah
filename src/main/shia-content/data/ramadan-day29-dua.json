{
  "id": "ramadan-day29-dua",
  "title": "انتيسويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "انتيسويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ غَشِّنِيْ فِيْهِ بِالرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ فِيْهِ التَّوْفِيْقَ وَالْعِصْمَةَ"
    },
    {
      "kind": "text",
      "ar": "وَطَهِّرْ قَلْبِيْ مِنْ غَيَاهِبِ التُّهَمَةِ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحِيْمًا بِعِبَادِهِ الْمُؤْمِنِيْنَ۔"
    }
  ]
}