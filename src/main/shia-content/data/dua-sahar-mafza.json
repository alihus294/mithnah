{
  "id": "dua-sahar-mafza",
  "title": "دعاء سحر يَا مَفْزَعِي",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء سحر يَا مَفْزَعِي",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا مَفْزَعِيْ عِنْدَ كُرْبَتِيْ، وَيَا غَوْثِيْ عِنْدَ شِدَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "اِلَيْكَ فَزِعْتُ، وَبِكَ اسْتَغَثْتُ"
    },
    {
      "kind": "text",
      "ar": "وَبِكَ لُذْتُ لَا أَلُوْذُ بِسِوَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَطْلُبُ الْفَرَجَ اِلَّا مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَغِثْنِيْ وَفَرِّجْ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يَقْبَلُ الْيَسِيْرَ، وَيَعْفُوْ عَنِ الْكَثِيْرِ"
    },
    {
      "kind": "text",
      "ar": "اقْبَلْ مِنِّي الْيَسِيْرَ، وَاعْفُ عَنِّي الْكَثِيْرَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الْغَفُوْرُ الرَّحِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ اِيْمَانًا تُبَاشِرُ بِهٖ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَيَقِيْنًا حَتّٰي أَعْلَمَ أَنَّهٗ لَنْ يُصِيْبَنِيْ اِلَّا مَا كَتَبْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَرَضِّنِيْ مِنَ الْعَيْشِ بِمَا قَسَمْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا عُدَّتِيْ فِيْ كُرْبَتِيْ، وَيَا صَاحِبِيْ فِيْ شِدَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَيَا وَلِيِّيْ فِيْ نِعْمَتِيْ، وَيَا غَايَتِيْ فِيْ رَغْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ السَّاتِرُ عَوْرَتِيْ، وَالْاٰمِنُ رَوْعَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُقِيْلُ عَثْرَتِيْ، فَاغْفِرْلِيْ خَطِيْئَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}