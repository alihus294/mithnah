{
  "id": "shaban-day3",
  "title": "تيسري شعبان كا دن",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تيسري شعبان كا دن",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِحَقِّ الْمَوْلُوْدِ فِيْ هٰذَا الْيَوْمِ"
    },
    {
      "kind": "text",
      "ar": "الْمَوْعُوْدِ بِشَهَادَتِهٖ قَبْلَ اسْتِهْلَالِهٖ وَوِلَادَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "بَكَتْهُ السَّمَاءُ وَمَنْ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "وَالْاَرْضُ وَمَنْ عَلَيْهَا وَلَمَّا يَطَأْ لَابَتَيْهَا"
    },
    {
      "kind": "text",
      "ar": "قَتِيْلِ الْعَبْرَةِ، وَسَيِّدِ الْاُسْرَةِ"
    },
    {
      "kind": "text",
      "ar": "الْمَمْدُوْدِ بِالنُّصْرَةِ يَوْمَ الْكَرَّةِ"
    },
    {
      "kind": "text",
      "ar": "الْمُعَوَّضِ مِنْ قَتْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَنَّ الْاَئِمَّةَ مِنْ نَسْلِهٖ، وَالشِّفَاءَ فِيْ تُرْبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَوْزَ مَعَهٗ فِيْ أَوْبَتِهٖ وَالْاَوْصِيَاءَ مِنْ عِتْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "بَعْدَ قَائِمِهِمْ وَغَيْبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي يُدْرِكُوا الْاَوْتَارَ، وَيَثْأَرُوا الثَّارَ"
    },
    {
      "kind": "text",
      "ar": "وَيُرْضُوا الْجَبَّارَ، وَيَكُوْنُوْا خَيْرَ أَنْصَارٍ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِمْ مَعَ اخْتِلَافِ اللَّيْلِ وَالنَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَبِحَقِّهِمْ اِلَيْكَ أَتَوَسَّلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُ سُؤَالَ مُقْتَرِفٍ مُعْتَرِفٍ"
    },
    {
      "kind": "text",
      "ar": "مُسِيْءٍ اِلٰي نَفْسِهٖ مِمَّا فَرَّطَ فِيْ يَوْمِهٖ وَأَمْسِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَسْأَلُكَ الْعِصْمَةَ اِلٰي مَحَلِّ رَمْسِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَصَلِّ عَلٰي مُحَمَّدٍ وَعِتْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنَا فِيْ زُمْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبَوِّئْنَا مَعَهٗ دَارَ الْكَرَامَةِ، وَمَحَلَّ الْاِقَامَةِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَكَمَا أَكْرَمْتَنَا بِمَعْرِفَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَأَكْرِمْنَا بِزُلْفَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنَا مُرَافَقَتَهٗ وَسَابِقَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا مِمَّنْ يُسَلِّمُ لِاَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَيُكْثِرُ الصَّلَاةَ عَلَيْهِ عِنْدَ ذِكْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي جَمِيْعِ أَوْصِيَائِهٖ وَأَهْلِ أَصْفِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْمَمْدُوْدِيْنَ مِنْكَ بِالْعَدَدِ الِْاثْنَيْ عَشَرَ"
    },
    {
      "kind": "text",
      "ar": "النُّجُوْمِ الزُّهَرِ، وَالْحُجَجِ عَلٰي جَمِيْعِ الْبَشَرِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَهَبْ لَنَا فِيْ هٰذَا الْيَوْمِ خَيْرَ مَوْهِبَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْجِحْ لَنَا فِيْهِ كُلَّ طَلِبَةٍ"
    },
    {
      "kind": "text",
      "ar": "كَمَا وَهَبْتَ الْحُسَيْنَ لِمُحَمَّدٍ جَدِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَاذَ فُطْرُسُ بِمَهْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَنَحْنُ عَائِذُوْنَ بِقَبْرِهٖ مِنْ بَعْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "نَشْهَدُ تُرْبَتَهٗ وَنَنْتَظِرُ أَوْبَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "اٰمِيْنَ رَبَّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ مُتَعَالِي الْمَكَانِ"
    },
    {
      "kind": "text",
      "ar": "عَظِيْمُ الْجَبَرُوْتِ، شَدِيْدُ الْمِحَالِ"
    },
    {
      "kind": "text",
      "ar": "غَنِيٌّ عَنِ الْخَلَائِقِ، عَرِيْضُ الْكِبْرِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "قَادِرٌ عَلٰي مَا تَشَاءُ، قَرِيْبُ الرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "صَادِقُ الْوَعْدِ، سَابِغُ النِّعْمَةِ"
    },
    {
      "kind": "text",
      "ar": "حَسَنُ الْبَلَاءِ، قَرِيْبٌ اِذَا دُعِيْتَ"
    },
    {
      "kind": "text",
      "ar": "مُحِيْطٌ بِمَا خَلَقْتَ"
    },
    {
      "kind": "text",
      "ar": "قَابِلُ التَّوْبَةِ لِمَنْ تَابَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "قَادِرٌ عَلٰي مَا أَرَدْت"
    },
    {
      "kind": "text",
      "ar": "وَمُدْرِكٌ مَا طَلَبْتَ"
    },
    {
      "kind": "text",
      "ar": "وَشَكُوْرٌ اِذَا شُكِرْتَ"
    },
    {
      "kind": "text",
      "ar": "وَذَكُوْرٌ اِذَا ذُكِرْتَ"
    },
    {
      "kind": "text",
      "ar": "أَدْعُوْكَ مُحْتَاجًا، وَأَرْغَبُ اِلَيْكَ فَقِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَفْزَعُ اِلَيْكَ خَائِفًا، وَأَبْكِيْ اِلَيْكَ مَكْرُوْبًا"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَعِيْنُ بِكَ ضَعِيْفًا"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَكَّلُ عَلَيْكَ كَافِيًا"
    },
    {
      "kind": "text",
      "ar": "احْكُمْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِالْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهُمْ غَرُّوْنَا وَخَدَعُوْنَا"
    },
    {
      "kind": "text",
      "ar": "وَخَذَلُوْنَا وَغَدَرُوْا بِنَا وَقَتَلُوْنَا"
    },
    {
      "kind": "text",
      "ar": "وَنَحْنُ عِتْرَةُ نَبِيِّكَ وَوَلَدُ حَبِيْبِكَ مُحَمَّدِ بْنِ عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِي اصْطَفَيْتَهٗ بِالرِّسَالَةِ، وَائْتَمَنْتَهٗ عَلٰي وَحْيِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاجْعَلْ لَنَا مِنْ أَمْرِنَا فَرَجًا وَمَخْرَجًا"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}