{
  "id": "dua-adeela",
  "title": "دعاء عديله",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء عديله",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "شَهِدَ اللهُ أَنَّهٗ لَا اِلٰهَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَلَائِكَةُ وَأُولُوا الْعِلْمِ قَائِمًا بِالْقِسْطِ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا هُوَ الْعَزِيْزُ الْحَكِيْمُ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ الدِّيْنَ عِنْدَ اللهِ الْاِسْلَامُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا الْعَبْدُ الضَّعِيْفُ الْمُذْنِبُ"
    },
    {
      "kind": "text",
      "ar": "الْعَاصِي الْمُحْتَاجُ الْحَقِيْرُ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ لِمُنْعِمِيْ وَخَالِقِيْ وَرَازِقِيْ وَمُكْرِمِيْ"
    },
    {
      "kind": "text",
      "ar": "كَمَا شَهِدَ لِذَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَشَهِدَتْ لَهُ الْمَلَائِكَةُ وَأُولُوا الْعِلْمِ مِنْ عِبَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "بِأَنَّهٗ لَا اِلٰهَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "ذُو النِّعَمِ وَالْاِحْسَانِ، وَالْكَرَمِ وَالْاِمْتِنَانِ"
    },
    {
      "kind": "text",
      "ar": "قَادِرٌ أَزَلِيٌّ، عَالِمٌ أَبَدِيٌّ، حَيٌّ أَحَدِيٌّ"
    },
    {
      "kind": "text",
      "ar": "مَوْجُوْدٌ سَرْمَدِيٌّ، سَمِيْعٌ بَصِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "مُرِيْدٌ كَارِهٌ، مُدْرِكٌ صَمَدِيٌّ"
    },
    {
      "kind": "text",
      "ar": "يَسْتَحِقُّ هٰذِهِ الصِّفَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَلٰي مَا هُوَ عَلَيْهِ فِيْ عِزِّ صِفَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "كَانَ قَوِيًّا قَبْلَ وُجُوْدِ الْقُدْرَةِ وَالْقُوَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَكَانَ عَلِيْمًا قَبْلَ اِيْجَادِ الْعِلْمِ وَالْعِلَّةِ"
    },
    {
      "kind": "text",
      "ar": "لَمْ يَزَلْ سُلْطَانًا اِذْ لَا مَمْلَكَةَ وَلَا مَالَ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَزَلْ سُبْحَانًا عَلٰي جَمِيْعِ الْاَحْوَالِ"
    },
    {
      "kind": "text",
      "ar": "وُجُوْدُهٗ قَبْلَ الْقَبْلِ فِيْ أَزَلِ الْاَزَالِ"
    },
    {
      "kind": "text",
      "ar": "وَبَقَاؤُهٗ بَعْدَ الْبَعْدِ مِنْ غَيْرِ انْتِقَالٍ وَلَا زَوَالٍ"
    },
    {
      "kind": "text",
      "ar": "غَنِيٌّ فِي الْاَوَّلِ وَالْاٰخِرِ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَغْنٍ فِي الْبَاطِنِ وَالظَّاهِرِ"
    },
    {
      "kind": "text",
      "ar": "لَا جَوْرَ فِيْ قَضِيَّتِهٖ، ولَا مَيْلَ فِيْ مَشِيْئَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا ظُلْمَ فِيْ تَقْدِيْرِهٖ، وَلَا مَهْرَبَ مِنْ حُكُوْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مَلْجَأَ مِنْ سَطَوَاتِهٖ، وَلَا مَنْجٰى مِنْ نَقِمَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "سَبَقَتْ رَحْمَتُهٗ غَضَبَهٗ، وَلَا يَفُوْتُهٗ أَحَدٌ اِذَا طَلَبَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَزَاحَ الْعِلَلَ فِي التَّكْلِيْفِ"
    },
    {
      "kind": "text",
      "ar": "وَسَوَّي التَّوْفِيْقَ بَيْنَ الضَّعِيْفِ وَالشَّرِيْفِ"
    },
    {
      "kind": "text",
      "ar": "مَكَّنَ أَدَاءَ الْمَأْمُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَسَهَّلَ سَبِيْلَ اجْتِنَابِ الْمَحْظُوْرِ"
    },
    {
      "kind": "text",
      "ar": "لَمْ يُكَلِّفِ الطَّاعَةَ اِلَّا دُوْنَ الْوُسْعِ وَالطَّاقَةِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَهٗ مَا أَبْيَنَ كَرَمَهٗ وَأَعْلٰي شَأْنَهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَهٗ مَا أَجَلَّ نَيْلَهٗ وَأَعْظَمَ اِحْسَانَهٗ"
    },
    {
      "kind": "text",
      "ar": "بَعَثَ الْاَنْبِيَاءَ لِيُبَيِّنَ عَدْلَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَنَصَبَ الْاَوْصِيَاءَ لِيُظْهِرَ طَوْلَهٗ وَفَضْلَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَنَا مِنْ أُمَّةِ سَيِّدِ الْاَنْبِيَاءِ وَخَيْرِ الْاَوْلِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْضَلِ الْاَصْفِيَاءِ وَأَعْلَي الْاَزْكِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "مُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَسَلَّمَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنَّا بِهٖ وَبِمَا دَعَانَا اِلَيْهِ، وَبِالْقُرْاٰنِ الَّذِيْ أَنْزَلَهٗ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَبِوَصِيِّهِ الَّذِيْ نَصَبَهٗ يَوْمَ الْغَدِيْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشَارَ بِقَوْلِهٖ هٰذَا عَلِيٌّ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ الْاَئِمَّةَ الْاَبْرَارَ"
    },
    {
      "kind": "text",
      "ar": "وَالْخُلَفَاءَ الْاَخْيَارَ بَعْدَ الرَّسُوْلِ الْمُخْتَارِ"
    },
    {
      "kind": "text",
      "ar": "عَلِيٌّ قَامِعُ الْكُفّارِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ بَعْدِهٖ سَيِّدُ أَوْلَادِهِ الْحَسَنُ بْنُ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ أَخُوْهُ السِّبْطُ التَّابِعُ لِمَرْضَاةِ اللهِ الْحُسَيْنُ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ الْعَابِدُ عَلِيٌّ، ثُمَّ الْبَاقِرُ مُحَمَّدٌ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ الصّادِقُ جَعْفَرٌ، ثُمَّ الْكَاظِمُ مُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ الرِّضَا عَلِيٌّ، ثُمَّ التَّقِيُّ مُحَمَّدٌ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ النَّقِيُّ عَلِيٌّ، ثُمَّ الزَّكِيُّ الْعَسْكَرِيُّ الْحَسَنُ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ الْحُجَّةُ الْخَلَفُ الْقَائِمُ الْمُنْتَظَرُ الْمَهْدِيُّ الْمُرْجَي"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ بِبَقَائِهٖ بَقِيَتِ الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "وَبِيُمْنِهٖ رُزِقَ الْوَرٰي"
    },
    {
      "kind": "text",
      "ar": "وَبِوُجُوْدِهٖ ثَبَتَتِ الْاَرْضُ وَالسَّمَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَبِهٖ يَمْلَاءُ اللهُ الْاَرْضَ قِسْطًا وَعَدْلًا"
    },
    {
      "kind": "text",
      "ar": "بَعْدَ مَا مُلِئَتْ ظُلْمًا وَجَوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ أَقْوَالَهُمْ حُجَّةٌ، وَامْتِثَالَهُمْ فَرِيْضَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَطَاعَتَهُمْ مَفْرُوْضَةٌ، وَمَوَدَّتَهُمْ لَازِمَةٌ مَقْضِيَّةٌ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِقْتِدَاءَ بِهِمْ مُنْجِيَةٌ وَمُخَالَفَتَهُمْ مُرْدِيَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَهُمْ سَادَاتُ أَهْلِ الْجَنَّةِ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَشُفَعَاءُ يَوْمِ الدِّيْنِ، وَأَئِمَّةُ أَهْلِ الْاَرْضِ عَلَي الْيَقِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْضَلُ الْاَوْصِيَاءِ الْمَرْضِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ الْمَوْتَ حَقٌّ، وَمُسَائَلَةَ الْقَبْرِ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَعْثَ حَقٌّ، وَالنُّشُوْرَ حَقٌّ، وَالصِّرَاطَ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَالْمِيْزَانَ حَقٌّ، وَالْحِسَابَ حَقٌّ، وَالْكِتَابَ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَالْجَنَّةَ حَقٌّ، وَالنَّارَ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ السَّاعَةَ اٰتِيَةٌ لَا رَيْبَ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ اللهَ يَبْعَثُ مَنْ فِي الْقُبُوْرِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَضْلُكَ رَجَائِيْ، وَكَرَمُكَ وَرَحْمَتُكَ أَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "لَا عَمَلَ لِيْ أَسْتَحِقُّ بِهِ الْجَنَّةَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا طَاعَةَ لِيْ أَسْتَوْجِبُ بِهَا الرِّضْوَانَ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا أَنِّي اعْتَقَدْتُ تَوْحِيْدَكَ وَعَدْلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَارْتَجَيْتُ اِحْسَانَكَ وَفَضْلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَشَفَّعْتُ اِلَيْكَ بِالنَّبِيِّ وَاٰلِهٖ مِنْ أَحِبَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ أَكْرَمُ الْاَكْرَمِيْنَ وَأَرْحَمُ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي نَبِيِّنَا مُحَمَّدٍ وَاٰلِهٖ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الطَّيِّبِيْنَ الطَّاهِرِيْنَ وَسَلَّمَ تَسْلِيْمًا كَثِيْرًا كَثِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِااللهِ الْعَلِيِّ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ أَوْدَعْتُكَ يَقِيْنِيْ هٰذَا وَثَبَاتَ دِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ خَيْرُ مُسْتَوْدَعٍ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ أَمَرْتَنَا بِحِفْظِ الْوَدَائِعِ"
    },
    {
      "kind": "text",
      "ar": "فَرُدَّهٗ عَلَيَّ وَقْتَ حُضُوْرِ مَوْتِيْ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلَّهُمَّ اِنِّيْ اَعُوْذُبِكَ مِنَ الْعَدِيْلَةِ عِنْدَ الْمَوْتِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ قَدْ أَوْدَعْتُكَ يَقِيْنِيْ هٰذَا وَثَبَاتَ دِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ خَيْرُ مُسْتَوْدَعٍ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ أَمَرْتَنَا بِحِفْظِ الْوَدَائِعِ"
    },
    {
      "kind": "text",
      "ar": "فَرُدَّهٗ عَلَيَّ وَقْتَ حُضُوْرِ مَوْتِيْ"
    },
    {
      "kind": "text",
      "ar": "رَضِيْتُ بِااللهِ رَبًّا"
    },
    {
      "kind": "text",
      "ar": "وَبِمُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ نَبِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَبِالْاِسْلَامِ دِيْنًا، وَبِالْقُرْاٰنِ كِتَابًا"
    },
    {
      "kind": "text",
      "ar": "وَبِالْكَعْبَةِ قِبْلَةً، وَبِعَلِيٍّ وَلِيًّا وَاِمَامًا"
    },
    {
      "kind": "text",
      "ar": "وَبِالْحَسَنِ وَالْحُسَيْنِ، وَعَلِيِّ بْنِ الْحُسَيْنِ"
    },
    {
      "kind": "text",
