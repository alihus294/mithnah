{
  "id": "munajat-taaibeen",
  "title": "۱۔ مناجات تائبين",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۔ مناجات تائبين",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ أَلْبَسَتْنِي الْخَطَايَا ثَوْبَ مَذَلَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَجَلَّلَنِي التَّبَاعُدُ مِنْكَ لِبَاسَ مَسْكَنَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَاتَ قَلْبِيْ عَظِيْمُ جِنَايَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَأَحْيِهٖ بِتَوْبَةٍ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَمَلِيْ وَبُغْيَتِيْ، وَيَا سُؤْلِيْ وَمُنْيَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَوَعِزَّتِكَ مَا أَجِدُ لِذُنُوْبِيْ سِوَاكَ غَافِرًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَرٰي لِكَسْرِيْ غَيْرَكَ جَابِرًا"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ خَضَعْتُ بِالْاِنَابَةِ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَنَوْتُ بِالْاِسْتِكَانَةِ لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ طَرَدْتَنِيْ مِنْ بَابِكَ فَبِمَنْ أَلُوْذُ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ رَدَدْتَنِيْ عَنْ جَنَابِكَ فَبِمَنْ أَعُوْذُ"
    },
    {
      "kind": "text",
      "ar": "فَوَا أَسَفَاهُ مِنْ خَجْلَتِيْ وَافْتِضَاحِيْ"
    },
    {
      "kind": "text",
      "ar": "وَوَا لَهْفَاهُ مِنْ سُوْءِ عَمَلِيْ وَاجْتِرَاحِيْ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ يَا غَافِرَ الذَّنْبِ الْكَبِيْرِ، وَيَا جَابِرَ الْعَظْمِ الْكَسِيْرِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَهَبَ لِيْ مُوْبِقَاتِ الْجَرَائِرِ"
    },
    {
      "kind": "text",
      "ar": "وَتَسْتُرَ عَلَيَّ فَاضِحَاتِ السَّرَائِرِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخْلِنِيْ فِيْ مَشْهَدِ الْقِيَامَةِ مِنْ بَرْدِ عَفْوِكَ وَغَفْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُعْرِنِيْ مِنْ جَمِيْلِ صَفْحِكَ وَسَتْرِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ ظَلِّلْ عَلٰي ذُنُوْبِيْ غَمَامَ رَحْمَتِكَ،"
    },
    {
      "kind": "text",
      "ar": "وَأَرْسِلْ عَلٰي عُيُوْبِيْ سَحَابَ رَأْفَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ هَلْ يَرْجِعُ الْعَبْدُ الْاٰبِقُ اِلَّا اِلٰي مَوْلَاهُ"
    },
    {
      "kind": "text",
      "ar": "أَمْ هَلْ يُجِيْرُهٗ مِنْ سَخَطِهٖ أَحَدٌ سِوَاهُ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِنْ كَانَ النَّدَمُ عَلَي الذَّنْبِ تَوْبَةً"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ وَعِزَّتِكَ مِنَ النَّادِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ كَانَ الْاِسْتِغْفَارُ مِنَ الْخَطِيْئَةِ حِطَّةً"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ لَكَ مِنَ الْمُسْتَغْفِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْعُتْبٰي حَتّٰي تَرْضٰي"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ بِقُدْرَتِكَ عَلَيَّ تُبْ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَبِحِلْمِكَ عَنِّي اعْفُ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَبِعِلْمِكَ بِي ارْفَقْ بِيْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ أَنْتَ الَّذِيْ فَتَحْتَ لِعِبَادِكَ بَابًا اِلٰي عَفْوِكَ"
    },
    {
      "kind": "text",
      "ar": "سَمَّيْتَهُ التَّوْبَةَ"
    },
    {
      "kind": "text",
      "ar": "فَقُلْتَ تُوْبُوْا اِلَي اللهِ تَوْبَةً نَصُوْحًا"
    },
    {
      "kind": "text",
      "ar": "فَمَا عُذْرُ مَنْ أَغْفَلَ دُخُوْلَ الْبَابِ بَعْدَ فَتْحِهٖ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِنْ كَانَ قَبُحَ الذَّنْبُ مِنْ عَبْدِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلْيَحْسُنِ الْعَفْوُ مِنْ عِنْدِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ مَا أَنَا بِأَوَّلِ مَنْ عَصَاكَ فَتُبْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَتَعَرَّضَ لِمَعْرُوْفِكَ فَجُدْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُجِيْبَ الْمُضْطَرِّ، يَا كَاشِفَ الضُّرِّ، يَا عَظِيْمَ الْبِرِّ"
    },
    {
      "kind": "text",
      "ar": "يَا عَلِيْمًا بِمَا فِي السِّرِّ، يَا جَمِيْلَ السِّتْرِ"
    },
    {
      "kind": "text",
      "ar": "اسْتَشْفَعْتُ بِجُوْدِكَ وَكَرَمِكَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَسَّلْتُ بِجَنَابِكَ وَتَرَحُّمِكَ لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَاسْتَجِبْ دُعَائِيْ وَلَا تُخَيِّبْ فِيْكَ رَجَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَقَبَّلْ تَوْبَتِيْ، وَكَفِّرْ خَطِيْئَتِيْ"
    },
    {
      "kind": "text",
      "ar": "بِمَنِّكَ وَرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}