{
  "id": "dua-rizq",
  "title": "۲۱۔ رزق كي دعا",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۲۱۔ رزق كي دعا",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ ذُنُوْبِيْ لَمْ يَبْقَ لَهَا اِلَّا رَجَاءُ عَفْوِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ قَدَّمْتُ اٰلَةَ الْحِرْمَانِ بَيْنَ يَدَيَّ"
    },
    {
      "kind": "text",
      "ar": "فَأَنَا أَسْأَلُكَ مَا لَا أَسْتَحِقُّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَدْعُوْكَ مَا لَا أَسْتَوْجِبُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَضَرَّعُ اِلَيْكَ بِمَا لَا أَسْتَأْهِلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَخْفَ عَلَيْكَ حَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ خَفِيَ عَلَي النَّاسِ كُنْهُ مَعْرِفَةِ أَمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنْ كَانَ رِزْقِيْ فِي السَّمَاءِ فَأَهْبِطْهُ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ كَانَ فِي الْاَرْضِ فَأَظْهِرْهُ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ كَانَ بَعِيْدًا فَقَرِّبْهُ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ كَانَ قَرِيْبًا فَيَسِّرْهُ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ كَانَ قَلِيْلًا فَكَثِّرْهُ وَبَارِكْ لِيْ فِيْهِ"
    }
  ]
}