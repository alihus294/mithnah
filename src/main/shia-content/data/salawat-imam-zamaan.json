{
  "id": "salawat-imam-zamaan",
  "title": "صلوات براء امام آخر الزمان",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "صلوات براء امام آخر الزمان",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي وَلِيِّ الْحَسَنِ وَوَصِيِّهٖ وَوَارِثِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْقَائِمِ بِأَمْرِكَ وَالْغَائِبِ فِيْ خَلْقِكَ وَالْمُنْتَظِرِ لِاِذْنِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَيْهِ وَقَرِّبْ بُعْدَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْجِزْ وَعْدَهٗ وَأَوْفِ عَهْدَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاكْشِفْ عَنْ بَأْسِهٖ حِجَابَ الْغَيْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَظْهِرْ بِظُهُوْرِهٖ صَحَائِفَ الْمِحْنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَقَدِّمْ أَمَامَهُ الرُّعْبَ، وَثَبِّتْ بِهِ الْقَلْبَ، وَأَقِمْ بِهِ الْحَرْبَ"
    },
    {
      "kind": "text",
      "ar": "وَأَيِّدْهُ بِجُنْدٍ مِنَ الْمَلَائِكَةِ مُسَوِّمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَسَلِّطْهٗ عَلٰي أَعْدَاءِ دِيْنِكَ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْهِمْهٗ أَنْ لَا يَدَعَ مِنْهُمْ رُكْنًا اِلَّا هَدَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا هَامًا اِلَّا قَدَّهٗ، وَلَا كَيْدًا اِلَّا رَدَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا فَاسِقًا اِلَّا حَدَّهٗ، وَلَا فِرْعَوْنًا اِلَّا أَهْلَكَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا سِتْرًا اِلَّا هَتَكَهٗ، وَلَا عَلَمًا اِلَّا نَكَّسَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا سُلْطَانًا اِلَّا كَسَبَهٗ، وَلَا رُمْحًا اِلَّا قَصَفَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مِطْرَدًا اِلَّا خَرَقَهٗ، وَلَا جُنْدًا اِلَّا فَرَّقَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مِنْبَرًا اِلَّا أَحْرَقَهٗ، وَلَا سَيْفًا اِلَّا كَسَرَهُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا صَنَمًا اِلَّا رَضَّهٗ، وَلَا دَمًا اِلَّا أَرَاقَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا جَوْرًا اِلَّا أَبَادَهٗ، وَلَا حِصْنًا اِلَّا هَدَمَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بَابًا اِلَّا رَدَمَهٗ، وَلَا قَصْرًا اِلَّا خَرَّبَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مَسْكَنًا اِلَّا فَتَّشَهٗ، وَلَا سَهْلًا اِلَّا أَوْطَأَهُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا جَبَلًا اِلَّا صَعِدَهٗ، وَلَا كَنْزًا اِلَّا أَخْرَجَهٗ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَاأَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَظُمَ الْبَلَاءُ، وَبَرِحَ الْخَفَاءُ، وَانْكَشَفَ الْغِطَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَضَاقَتِ الْاَرْضُ، وَمَنَعَتِ السَّمَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ يَارَبَّ الْمُشْتَكٰي"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ الْمُعَوَّلُ فِي الشِّدَّةِ وَالرَّخَاءِ-"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ فَرَضْتَ عَلَيْنَا طَاعَتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "فَعَرَّفْتَنَا بِذٰلِكَ مَنْزِلَتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "فَرِّجْ عَنَّا بِحَقِّهِمْ فَرَجًا عَاجِلًا"
    },
    {
      "kind": "text",
      "ar": "كَلَمْحِ الْبَصَرِ أَوْ هُوَ أَقْرَبُ مِنْ ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحَمَّدُ يَا عَلِيُّ، يَا عَلِيُّ يَا مُحَمَّدُ"
    },
    {
      "kind": "text",
      "ar": "انْصُرَانِيْ فَاِنَّكُمَا نَاصِرَايَ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِيَانِيْ فَاِنَّكُمَا كَافِيَايَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ يَا صَاحِبَ الزَّمَانِ"
    },
    {
      "kind": "text",
      "ar": "الْغَوْثَ الْغَوْثَ الْغَوْثَ"
    },
    {
      "kind": "text",
      "ar": "أَدْرِكْنِيْ أَدْرِكْنِيْ أَدْرِكْنِيْ۔"
    }
  ]
}