{
  "id": "dua-rasool",
  "title": "دعاء حضرت رسول",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء حضرت رسول",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّكَ تَرٰي وَلَا تُرٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ بِالْمَنْظَرِ الْأَعْلٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ اِلَيْكَ الْمُنْتَهٰي وَالرُّجْعٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ لَكَ الْأٰخِرَةَ وَالْاُوْلٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ لَكَ الْمَمَاتَ وَالْمَحْيَا"
    },
    {
      "kind": "text",
      "ar": "وَرَبِّ أَعُوْذُ بِكَ أَنْ أُذَلَّ أَوْ أُخْزٰي"
    }
  ]
}