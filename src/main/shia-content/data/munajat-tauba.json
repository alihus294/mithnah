{
  "id": "munajat-tauba",
  "title": "مناجات طلب توبه",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مناجات طلب توبه",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ قَصَدْتُ اِلَيْكَ بِاِخْلَاصِ تَوْبَة نَصُوْحٍ"
    },
    {
      "kind": "text",
      "ar": "وَتَثْبِيْتِ عَقْدٍ صَحِيْحٍ"
    },
    {
      "kind": "text",
      "ar": "وَدُعَاءِ قَلْبٍ قَرِيْحٍ"
    },
    {
      "kind": "text",
      "ar": "وَاِعْلَانِ قَوْلٍ صَرِيْحٍ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَتَقَبَّلْ مِنِّيْ مُخْلَصَ التَّوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاِقْبَالَ سَرِيْعِ الْاَوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمَصَارِعَ تَخَشُّعِ الْحَوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَقَابِلْ رَبِّ تَوْبَتِيْ بِجَزِيْلِ الثَّوَابِ وَكَرِيْمِ الْمَاٰبِ"
    },
    {
      "kind": "text",
      "ar": "وَحَطِّ الْعِقَابِ وَصَرْفِ الْعَذَابِ"
    },
    {
      "kind": "text",
      "ar": "وَغُنْمِ الْاِيَابِ وَسِتْرِ الْحِجَابِ"
    },
    {
      "kind": "text",
      "ar": "وَامْحُ اَللّٰهُمَّ مَا ثَبَتَ مِنْ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاغْسِلْ بِقَبُوْلِهَا جَمِيْعَ عُيُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهَا جَالِيَةً لِقَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "شَاخِصَةً لِبَصِيْرَةِ لُبِّيْ"
    },
    {
      "kind": "text",
      "ar": "غَاسِلَةً لِدَرَنِيْ مُطَهِّرَةً لِنَجَاسَةِ بَدَنِيْ"
    },
    {
      "kind": "text",
      "ar": "مُصَحِّحَةً فِيْهَا ضَمِيْرِيْ"
    },
    {
      "kind": "text",
      "ar": "عَاجِلَةً اِلَي الْوَفَاءِ بِهَا بَصِيْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاقْبَلْ يَارَبِّ تَوْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهَا تَصْدُرُ مِنْ اِخْلَاصِ نِيَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمَحْضٍ مِنْ تَصْحِيْحِ بَصِيْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاحْتِفَالًا فِيْ طَوِيَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْتِهَادًا فِيْ نَقَاءِ سَرِيْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَثْبِيْتًا لِاِنَابَتِيْ وَمُسَارِعَةً اِلٰي أَمْرِكَ بِطَاعَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْلُ اَللّٰهُمَّ بِالتَّوْبَةِ عَنِّيْ ظُلْمَةَ الْاِصْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَامْحُ بِهَا مَا قَدَّمْتُهُ مِنَ الْاَوْزَارِ"
    },
    {
      "kind": "text",
      "ar": "وَاكْسُنِيْ لِبَاسَ التَّقْوٰي وَجَلَابِيْبَ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ خَلَعْتُ رِبْقَ الْمَعَاصِيْ عَنْ جَلَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَنَزَعْتُ سِرْبَالَ الذُّنُوْبِ عَنْ جَسَدِيْ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَمْسِكًا رَبِّ بِقُدْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَعِيْنًا عَلٰي نَفْسِيْ بِعِزَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَوْدِعًا تَوْبَتِيْ مِنَ النَّكْثِ بِخَفْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "مُعْتَصِمًا مِنَ الْخِذْلَانِ بِعِصْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "مُقَارِنًا بِهٖ لَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِكَ"
    }
  ]
}