{
  "id": "baqiyat-preface",
  "title": "مقدمه",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مقدمه",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحْيمِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ اللهِ الَّذِيْ سَمَكَ السَّمَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَنَدَبَ عِبَادَهٗ اِلَي الدُّعَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَالصَّلَاةُ وَاَلسَّلَامُ عَلٰي مَنْ قَدَّمَهٗ فِي الْاِصْطِفَاءِ"
    },
    {
      "kind": "text",
      "ar": "مُحَمَّدٍ خَاتَمِ الْاِنبِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي اٰلِهِ الطَّاهِرِيْنَ مَصَابِيْحِ الدُّجٰي"
    },
    {
      "kind": "text",
      "ar": "سِيَّمَا عَلٰي قَائِمِهِمْ خَاتَمِ الْاَوْصِيَاءِ-"
    },
    {
      "kind": "text",
      "ar": "وَالْبَاقِيَاتُ الصَّالِحَاتُ خَيْرٌ عِنْدَ رَبِّكَ ثَوَابًا وَخَيْرٌ أَمَلًا"
    }
  ]
}