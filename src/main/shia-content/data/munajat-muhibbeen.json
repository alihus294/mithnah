{
  "id": "munajat-muhibbeen",
  "title": "۹۔ مناجات محبين",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۹۔ مناجات محبين",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ مَنْ ذَا الَّذِيْ ذَاقَ حَلَاوَةَ مَحَبَّتِكَ فَرَامَ مِنْكَ بَدَلًا"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ ذَا الَّذِيْ أَنِسَ بِقُرْبِكَ فَابْتَغٰي عَنْكَ حِوَلًا ؟"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ فَاجْعَلْنَا مِمَّنِ اصْطَفَيْتَهٗ لِقُرْبِكَ وَوِلَايَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْلَصْتَهٗ لِوُدِّكَ وَمَحَبَّتِكَ، وَشَوَّقْتَهٗ اِلٰي لِقَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَرَضَّيْتَهٗ بِقَضَائِكَ، وَمَنَحْتَهٗ بِالنَّظَرِ اِلٰي وَجْهِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَبَوْتَهٗ بِرِضَاكَ، وَأَعَذْتَهٗ مِنْ هَجْرِكَ وَقِلَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَوَّأْتَهٗ مَقْعَدَ الصِّدْقِ فِيْ جِوَارِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَصَصْتَهٗ بِمَعْرِفَتِكَ، وَأَهَّلْتَهٗ لِعِبَادَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَهَيَّمْتَ قَلْبَهٗ لِاِرَادَتِكَ، وَاجْتَبَيْتَهٗ لِمُشَاهَدَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْلَيْتَ وَجْهَهٗ لَكَ، وَفَرَّغْتَ فُؤَادَهٗ لِحُبِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَرَغَّبْتَهٗ فِيْمَا عِنْدَكَ، وَأَلْهَمْتَهٗ ذِكْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْزَعْتَهٗ شُكْرَكَ، وَشَغَلْتَهٗ بِطَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَيَّرْتَهٗ مِنْ صَالِحِيْ بَرِيَّتِكَ، وَاخْتَرْتَهٗ لِمُنَاجَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَطَعْتَ عَنْهُ كُلَّ شَيْءٍ يَقْطَعُهٗ عَنْكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنَا مِمَّنْ دَابُهُمُ الْاِرْتِيَاحُ اِلَيْكَ وَالْحَنِيْنُ"
    },
    {
      "kind": "text",
      "ar": "وَدَهْرُهُمُ الزَّفْرَةُ وَالْاَنِيْنُ"
    },
    {
      "kind": "text",
      "ar": "جِبَاهُهُمْ سَاجِدَةٌ لِعَظَمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعُيُوْنُهُمْ سَاهِرَةٌ فِيْ خِدْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَدُمُوْعُهُمْ سَائِلَةٌ مِنْ خَشْيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقُلُوْبُهُمْ مُتَعَلِّقَةٌ بِمَحَبَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْئِدَتُهُمْ مُنْخَلِعَةٌ مِنْ مَهَابَتِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ أَنْوَارُ قُدْسِهٖ لِاَبْصَارِ مُحِبِّيْهِ رَائِقَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَسُبُحَاتُ وَجْهِهٖ لِقُلُوْبِ عَارِفِيْهِ شَائِفَةٌ"
    },
    {
      "kind": "text",
      "ar": "يَا مُنٰي قُلُوْبِ الْمُشْتَاقِيْنَ، وَيَا غَايَةَ اٰمَالِ الْمُحِبِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ حُبَّكَ، وَحُبَّ مَنْ يُحِبُّكَ"
    },
    {
      "kind": "text",
      "ar": "وَحُبَّ كُلِّ عَمَلٍ يُوْصِلُنِيْ اِلٰي قُرْبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَكَ أَحَبَّ اِلَيَّ مِمَّا سِوَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ حُبِّيْ اِيَّاكَ قَائِدًا اِلٰي رِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَشَوْقِيْ اِلَيْكَ ذَائِدًا عَنْ عِصْيَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَامْنُنْ بِالنَّظَرِ اِلَيْكَ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَانْظُرْ بِعَيْنِ الْوُدِّ وَالْعَطْفِ اِلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَصْرِفْ عَنِّيْ وَجْهَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ أَهْلِ الْاِسْعَادِ وَالْحَظْوَةِ عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "يَا مُجِيْبُ، يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}