{
  "id": "hirz-bibi-fatima",
  "title": "۲۔ حرز حضرت فاطمة الزهرا",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۲۔ حرز حضرت فاطمة الزهرا",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ يَا قَيُّوْمُ بِرَحْمَتِكَ أَسْتَغِيْثُ فَأَغِثْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَكِلْنِيْ اِلٰي نَفْسِيْ طَرْفَةَ عَيْنٍ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَصْلِحْ لِيْ شَأْنِيْ كُلَّهُ"
    }
  ]
}