{
  "id": "tuesday-dua",
  "title": "منگل كے دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "منگل كے دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْم"
    },
    {
      "kind": "text",
      "ar": "اَلْحَمْدُ لِلّٰهِ وَالْحَمْدُ حَقُّهٗ كَمَا يَسْتَحِقُّهٗ حَمْدًا كَثِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِهٖ مِنْ شَرِّ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ النَّفْسَ لَاَمَّارَةٌ بِالسُّوْءِ اِلَّا مَا رَحِمَ رَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِهٖ مِنْ شَرِّ الشَّيْطَانِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ يَزِيْدُنِيْ ذَنْبًا اِلٰي ذَنْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْتَرِزُ بِهٖ مِنْ كُلِّ جَبَّارٍ فَاجِرٍ"
    },
    {
      "kind": "text",
      "ar": "وَسُلْطَانٍ جَائِرٍ، وَعَدُوٍّ قَاهِرٍ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ مِنْ جُنْدِكَ، فَاِنَّ جُنْدَكَ هُمُ الْغَالِبُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ حِزْبِكَ، فَاِنَّ حِزْبَكَ هُمُ الْمُفْلِحُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ أَوْلِيَائَكَ لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُوْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَصْلِحْ لِيْ دِيْنِيْ، فَاِنَّهٗ عِصْمَةُ أَمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْلِحْ لِيْ اٰخِرَتِيْ فَاِنَّهَا دَارُ مَقَرِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْهَا مِنْ مُجَاوَرَةِ اللِّئَامِ مَفَرِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلِ الْحَيَاةَ زِيَادَةً لِيْ فِيْ كُلِّ خَيْرٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْوَفَاةَ رَاحَةً لِيْ مِنْ كُلِّ شَرٍّ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ خَاتَمِ النَّبِيِّيْنَ وَتَمَامِ عِدَّةِ الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي اٰلِهِ الطَّيِّبِيْنَ الطَّاهِرِيْنَ، وَأَصْحَابِهِ الْمُنْتَجَبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيْ فِي الثُّلَاثَاءِ ثَلَاثًا"
    },
    {
      "kind": "text",
      "ar": "لَا تَدَعْ لِيْ ذنْبًا اِلَّا غَفَرْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا غَمًّا اِلَّا أَذْهَبْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا عَدُوًّا اِلَّا دَفَعْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "بِبِسْمِ اللهِ خَيْرِ الْاَسْمَاءِ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ رَبِّ الْاَرْضِ وَالسَّمَاءِ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَدْفِعُ كُلَّ مَكْرُوْهٍ أَوَّلُهٗ سَخَطُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَجْلِبُ كُلَّ مَحْبُوْبٍ أَوَّلُهٗ رِضَاهُ"
    },
    {
      "kind": "text",
      "ar": "فَاخْتِمْ لِيْ مِنْكَ بِالْغُفْرَانِ، يَا وَلِيَّ الْاِحْسَانِ"
    }
  ]
}