{
  "id": "ziarat-imam-kazim-2",
  "title": "امام موسٰي كاظم  كي ايك اور زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام موسٰي كاظم  كي ايك اور زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ وَفِيْ سَبِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مِلَّةِ رَسُوْلِ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلٰي أَوْلِيَاءِ اللهِ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نُوْرَ اللهِ فِيْ ظُلُمَاتِ الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا بَابَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ أَقَمْتَ الصَّلَاةَ، وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ، وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَتَلَوْتَ الْكِتَابَ حَقَّ تِلَاوَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِي اللهِ حَقَّ جِهَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتَ عَلَي الْاَذٰي فِيْ جَنْبِهٖ مُحْتَسِبًا"
    },
    {
      "kind": "text",
      "ar": "وَعَبَدْتَهٗ مُخْلِصًا حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ أَوْلٰي بِاللّٰهِ وَبِرَسُوْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ ابْنُ رَسُوْلِ اللهِ حَقًّا"
    },
    {
      "kind": "text",
      "ar": "أَبْرَأُ اِلَي اللهِ مِنْ أَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَقَرَّبُ اِلَي اللهِ بِمُوَالَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ يَا مَوْلَايَ عَارِفًا بِحَقِّكَ"
    },
    {
      "kind": "text",
      "ar": "مُوَالِيًا لِاَوْلِيَائِكَ، مُعَادِيًا لِاَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ عِنْدَ رَبِّكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ صَادِقٌ، أَدَّيْتَ نَاصِحًا"
    },
    {
      "kind": "text",
      "ar": "وَقُلْتَ أَمِيْنًا، وَمَضَيْتَ شَهِيْدًا"
    },
    {
      "kind": "text",
      "ar": "لَمْ تُؤْثِرْ عَمًى عَلَي الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ تَمِلْ مِنْ حَقٍّ اِلٰي بَاطِلٍ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْكَ وَعَلٰي اٰبَائِكَ وَأَبْنَائِكَ الطَّاهِرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِلَيْكَ اعْتَمَدْتُ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ قَصَدْتُ، وَبِفَضْلِكَ رَجَوْتُ"
    },
    {
      "kind": "text",
      "ar": "وَقَبْرَ اِمَامِيَ الَّذِيْ أَوْجَبْتَ عَلَيَّ طَاعَتَهٗ زُرْتُ"
    },
    {
      "kind": "text",
      "ar": "وَبِهٖ اِلَيْكَ تَوَسَّلْتُ"
    },
    {
      "kind": "text",
      "ar": "فَبِحَقِّهِمُ الَّذِيْ أَوْجَبْتَ عَلٰي نَفْسِكَ"
    },
    {
      "kind": "text",
      "ar": "اغْفِرْ لِيْ وَلِوَالِدَيَّ وَلِلْمُؤْمِنِيْنَ يَا كَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ قَدْ عَلِمْتَ حَوَائِجِيْ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ وَاقْضِهَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ قَدْ أَحْصَيْتَ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "فَبِحَقِّ مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْهَا وَتَصَدَّقْ عَلَيَّ بِمَا أَنْتَ أَهْلُهٗ۔"
    }
  ]
}