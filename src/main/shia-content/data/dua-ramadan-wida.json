{
  "id": "dua-ramadan-wida",
  "title": "دعاء وداع رمضان",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء وداع رمضان",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّكَ قُلْتَ فِيْ كِتَابِكَ الْمُنْزَلِ"
    },
    {
      "kind": "text",
      "ar": "شَهْرُ رَمَضَانَ الَّذِيْ أُنْزِلَ فِيْهِ الْقُرْاٰنُ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذَا شَهْرُ رَمَضَانَ وَقَدْ تَصَرَّمَ"
    },
    {
      "kind": "text",
      "ar": "فأَسْأَلُكَ بِوَجْهِكَ الْكَرِيْمِ وَكَلِمَاتِكَ التَّامَّةِ"
    },
    {
      "kind": "text",
      "ar": "اِنْ كَانَ بَقِيَ عَلَيَّ ذَنْبٌ لَمْ تَغْفِرْهُ لِيْ"
    },
    {
      "kind": "text",
      "ar": "أَوْ تُرِيْدُ أَنْ تُعَذِّبَنِيْ عَلَيْهِ أَوْ تُقَايِسَنِيْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَنْ لَا يَطْلُعَ فَجْرُ هٰذِهِ اللَّيْلَةِ"
    },
    {
      "kind": "text",
      "ar": "أَوْ يَتَصَرَّمَ هٰذَا الشَّهْرُ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا وَقَدْ غَفَرْتَهٗ لِيْ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَكَ الْحَمْدُ بِمَحَامِدِكَ كُلِّهَا أَوَّلِهَا وَاٰخِرِهَا"
    },
    {
      "kind": "text",
      "ar": "مَا قُلْتَ لِنَفْسِكَ مِنْهَا"
    },
    {
      "kind": "text",
      "ar": "وَمَا قَالَ الْخَلَائِقُ الْحَامِدُوْنَ الْمُجْتَهِدُوْنَ الْمَعْدُوْدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمُوَفِّرُوْنَ ذِكْرَكَ وَالشُّكْرَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ أَعَنْتَهُمْ عَلٰي أَدَاءِ حَقِّكَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ أَصْنَافِ خَلْقِكَ مِنَ الْمَلَائِكَةِ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّبِيِّيْنَ وَالْمُرْسَلِيْنَ وَأَصْنَافِ النَّاطِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسَبِّحِيْنَ لَكَ مِنْ جَمِيْعِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي أَنَّكَ بَلَّغْتَنَا شَهْرَ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْنَا مِنْ نِعَمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعِنْدَنَا مِنْ قِسَمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِحْسَانِكَ وَتَظَاهُرِ امْتِنَانِكَ"
    },
    {
      "kind": "text",
      "ar": "فَبِذٰلِكَ لَكَ مُنْتَهَي الْحَمْدِ الْخَالِدِ"
    },
    {
      "kind": "text",
      "ar": "الدَّائِمِ الرَّاكِدِ، الْمُخَلَّدِ السَّرْمَدِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَا يَنْفَدُ طُوْلَ الْاَبَدِ"
    },
    {
      "kind": "text",
      "ar": "جَلَّ ثَنَاؤُكَ أَعَنْتَنَا عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي قَضَيْتَ عَنَّا صِيَامَهٗ وَقِيَامَهٗ مِنْ صَلَاةٍ"
    },
    {
      "kind": "text",
      "ar": "وَمَا كَانَ مِنَّا فِيْهِ مِنْ بِرٍّ أَوْ شُكْرٍ أَوْ ذِكْرٍ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَتَقَبَّلْهُ مِنَّا بِأَحْسَنِ قَبُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَجَاوُزِكَ وَعَفْوِكَ وَصَفْحِكَ"
    },
    {
      "kind": "text",
      "ar": "وَغُفْرَانِكَ، وَحَقِيْقَةِ رِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تُظَفِّرَنَا فِيْهِ بِكُلِّ خَيْرٍ مَطْلُوْبٍ"
    },
    {
      "kind": "text",
      "ar": "وَجَزِيْلِ عَطَاءٍ مَوْهُوْبٍ"
    },
    {
      "kind": "text",
      "ar": "وَتُوْقِيَنَا فِيْهِ مِنْ كُلِّ مَرْهُوْبٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْ بَلَاءٍ مَجْلُوْبٍ أَوْ ذَنْبٍ مَكْسُوْبٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "مَا سَأَلَكَ بِهٖ أَحَدٌ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ كَرِيْمِ أَسْمَائِكَ وَجَمِيْلِ ثَنَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَاصَّةِ دُعَائِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ شَهْرَنَا هٰذَا أَعْظَمَ شَهْرِ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "مَرَّ عَلَيْنَا مُنْذُ أَنْزَلْتَنَا اِلَي الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "بَرَكَةً فِيْ عِصْمَةِ دِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَخَلَاصِ نَفْسِيْ، وَقَضَاءِ حَوَائِجِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُشَفِّعَنِيْ فِيْ مَسَائِلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَمَامِ النِّعْمَةِ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَصَرْفِ السُّوْءِ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَلِبَاسِ الْعَافِيَةِ لِيْ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَنِيْ بِرَحْمَتِكَ مِمَّنْ خِرْتَ لَهٗ لَيْلَةَ الْقَدْرِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهَا لَهٗ خَيْرًا مِنْ أَلْفِ شَهْرٍ فِيْ أَعْظَمِ الْاَجْرِ"
    },
    {
      "kind": "text",
      "ar": "وَكَرَائِمِ الذُّخْرِ، وَحُسْنِ الشُّكْرِ"
    },
    {
      "kind": "text",
      "ar": "وَطُوْلِ الْعُمْرِ، وَدَوَامِ الْيُسْرِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وأَسْأَلُكَ بِرَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَطَوْلِكَ، وَعَفْوِكَ، وَنَعْمَائِكَ، وَجَلَالِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدِيْمِ اِحْسَانِكَ وَامْتِنَانِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ لَا تَجْعَلَهٗ اٰخِرَ الْعَهْدِ مِنَّا لِشَهْرِ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تُبَلِّغَنَاهُ مِنْ قَابِلٍ عَلٰي أَحْسَنِ حَالٍ"
    },
    {
      "kind": "text",
      "ar": "وَتُعَرِّفَنِيْ هِلَالَهٗ مَعَ النَّاظِرِيْنَ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُعْتَرِفِيْنَ لَهٗ فِيْ أَعْفٰي عَافِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْعَمِ نِعْمَتِكَ وَأَوْسَعِ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْزَلِ قِسَمِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّيَ الَّذِيْ لَيْسَ لِيْ رَبٌّ غَيْرُهٗ"
    },
    {
      "kind": "text",
      "ar": "لَا يَكُوْنُ هٰذَا الْوَدَاعُ مِنِّيْ لَهٗ وَدَاعَ فَنَاءٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا اٰخِرَ الْعَهْدِ مِنِّيْ لِلِقَاءٍ"
    },
    {
      "kind": "text",
      "ar": "حَتّي تُرِيَنِيْهِ مِنْ قَابِلٍ فِيْ أَوْسَعِ النِّعَمِ وَأَفْضَلِ الرَّجَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا لَكَ عَلٰي أَحْسَنِ الْوَفَاءِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ سَمِيْعُ الدُّعَاءِ-"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اسْمَعْ دُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْ تَضَرُّعِيْ وَتَذَلُّلِيْ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتِكَانَتِيْ وَتَوَكُّلِيْ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا لَكَ مُسَلِّمٌ"
    },
    {
      "kind": "text",
      "ar": "لَا أَرْجُوْ نَجَاحًا وَلَا مُعَافَاةً، وَلَا تَشْرِيْفًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَبْلِيْغًا اِلَّا بِكَ وَمِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَامْنُنْ عَلَيَّ جَلَّ ثَنَاؤُكَ وَتَقَدَّسَتْ أَسْمَاؤُكَ"
    },
    {
      "kind": "text",
      "ar": "بِتَبْلِيْغِيْ شَهْرَ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا مُعَافًى مِنْ كُلِّ مَكْرُوْهٍ وَمَحْذُوْرٍ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ جَمِيْعِ الْبَوَائِقِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَعَانَنَا عَلٰي صِيَامِ هٰذَا الشَّهْرِ وَقِيَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي بَلَّغَنِيْ اٰخِرَ لَيْلَةٍ مِنْهُ۔"
    }
  ]
}