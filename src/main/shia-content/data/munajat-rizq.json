{
  "id": "munajat-rizq",
  "title": "مناجات طلب رزق",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مناجات طلب رزق",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَرْسِلْ عَلَيَّ سِجَالَ رِزْقِكَ مِدْرَارًا"
    },
    {
      "kind": "text",
      "ar": "وَأَمْطِرْ عَلَيَّ سَحَائِبَ اِفْضَالِكَ غِزَارًا"
    },
    {
      "kind": "text",
      "ar": "وَأَدِمْ غَيْثَ نَيْلِكَ اِلَيَّ سِجَالًا"
    },
    {
      "kind": "text",
      "ar": "وَأَسْبِلْ مَزِيْدَ نِعَمِكَ عَلٰي خَلَّتِيْ اِسْبَالًا"
    },
    {
      "kind": "text",
      "ar": "وَأَفْقِرْنِيْ بِجُوْدِكَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَغْنِنِيْ عَمَّنْ يَطْلُبُ مَا لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَدَاوِ دَاءَ فَقْرِيْ بِدَوَاءِ فَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَانْعَشْ صَرْعَةَ عَيْلَتِيْ بِطَوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَصَدَّقْ عَلٰي اِقْلَالِيْ بِكَثْرَةِ عَطَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي اخْتِلَالِيْ بِكَرِيْمِ حِبَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَسَهِّلْ رَبِّ سَبِيْلَ الرِّزْقِ اِلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَثَبِّتْ قَوَاعِدَهٗ لَدَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَبَجِّسْ لِيْ عُيُوْنَ سَعَتِهٖ بِرَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفَجِّرْ أَنْهَارَ رَغَدِ الْعَيْشِ قِبَلِيْ بِرَأْفَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْدِبْ أَرْضَ فَقْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْصِبْ جَدْبَ ضُرِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَاصْرِفْ عَنِّيْ فِي الرِّزْقِ الْعَوَائِقَ"
    },
    {
      "kind": "text",
      "ar": "وَاقْطَعْ عَنِّيْ مِنَ الضِّيْقِ الْعَلَائِقَ"
    },
    {
      "kind": "text",
      "ar": "وَارْمِنِيْ مِنْ سَعَةِ الرِّزْقِ اَللّٰهُمَّ بِأَخْصَبِ سِهَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْبُنِيْ مِنْ رَغَدِ الْعَيْشِ بِأَكْثَرِ دَوَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاكْسُنِيْ اَللّٰهُمَّ سَرَابِيْلَ السَّعَةِ وَجَلَابِيْبَ الدَّعَةِ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ يَارَبِّ مُنْتَظِرٌ لِاِنْعَامِكَ بِحَذْفِ المَضِيْقِ"
    },
    {
      "kind": "text",
      "ar": "وَلِتَطَوُّلِكَ بِقَطْعِ التَّعْوِيْقِ"
    },
    {
      "kind": "text",
      "ar": "وَلِتَفَضُّلِكَ بِاِزَالَةِ التَّقْتِيْرِ"
    },
    {
      "kind": "text",
      "ar": "لِوُصُوْلِ حَبْلِيْ بِكَرَمِكَ بِالتَّيْسِيْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَمْطِرِ اَللّٰهُمَّ عَلَيَّ سَمَاءَ رِزْقِكَ بِسِجَالِ الدِّيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَغْنِنِيْ عَنْ خَلْقِكَ بِعَوَائِدِ النِّعَمِ"
    },
    {
      "kind": "text",
      "ar": "وَارْمِ مَقَاتِلَ الْاِقْتَارِ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَاحْمِلْ كَشْفَ الضُّرِّ عَنِّيْ عَلٰي مَطَايَا الْاِعْجَالِ"
    },
    {
      "kind": "text",
      "ar": "وَاضْرِبْ عَنِّي الضِّيْقَ بِسَيْفِ الْاِسْتِئْصَالِ"
    },
    {
      "kind": "text",
      "ar": "وَأَتْحِفْنِيْ رَبِّ مِنْكَ بِسَعَةِ الْاِفْضَالِ"
    },
    {
      "kind": "text",
      "ar": "وَامْدُدْنِيْ بِنُمُوِّ الْاَمْوَالِ"
    },
    {
      "kind": "text",
      "ar": "وَاحْرُسْنِيْ مِنْ ضِيْقِ الْاِقْلَالِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْبِضْ عَنِّيْ سُوْءَ الْجَدْبِ"
    },
    {
      "kind": "text",
      "ar": "وَابْسُطْ لِيْ بِسَاطَ الْخِصْبِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْقِنِيْ مِنْ مَاءِ رِزْقِكَ غَدَقًا"
    },
    {
      "kind": "text",
      "ar": "وَانْهَجْ لِيْ مِنْ عَمِيْمِ بَذْلِكَ طُرُقًا"
    },
    {
      "kind": "text",
      "ar": "وَفَاجِئْنِيْ بِالثَّرْوَةِ وَالْمَال"
    },
    {
      "kind": "text",
      "ar": "وَانْعَشْنِيْ بِهٖ مِن الْاِقْلَالِ"
    },
    {
      "kind": "text",
      "ar": "وَصَبِّحْنِيْ بِالْاِسْتِظْهَارِ"
    },
    {
      "kind": "text",
      "ar": "وَمَسِّنِيْ بِالتَّمَكُّنِ مِنَ الْيَسَارِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ ذُوالطَّوْلِ الْعَظِيْمِ وَالْفَضْلِ الْعَمِيْمِ وَالْمَنِّ الْجَسِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْجَوَادُ الْكَرِيْمُ"
    }
  ]
}