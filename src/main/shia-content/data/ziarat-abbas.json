{
  "id": "ziarat-abbas",
  "title": "زيارت حضرت عباس بن اميرالمومنين",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت حضرت عباس بن اميرالمومنين",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "سَلَامُ اللهِ وَسَلَامُ مَلَائِكَتِهِ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْبِيَائِهِ الْمُرْسَلِيْنَ، وَعِبَادِهِ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَجَمِيْعِ الشُّهَدَاءِ وَالصِّدِّيْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالزَّاكِيَاتُ الطَّيِّبَاتُ فِيْمَا تَغْتَدِيْ وَتَرُوْحُ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ لَكَ بِالتَّسْلِيْمِ وَالتَّصْدِيْقِ وَالْوَفَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّصِيْحَةِ لِخَلَفِ النَّبِيِّ الْمُرْسَلِ"
    },
    {
      "kind": "text",
      "ar": "وَالسِّبْطِ الْمُنْتَجَبِ وَالدَّلِيْلِ الْعَالِمِ"
    },
    {
      "kind": "text",
      "ar": "وَالْوَصِيِّ الْمُبَلِّغِ وَالْمَظْلُوْمِ الْمُهْتَضَمِ"
    },
    {
      "kind": "text",
      "ar": "فَجَزَاكَ اللهُ عَنْ رَسُوْلِهٖ وَعَنْ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَنِ الْحَسَنِ وَالْحُسَيْنِ صَلَوَاتُ اللهِ عَلَيْهِمْ"
    },
    {
      "kind": "text",
      "ar": "أَفْضَلَ الْجَزَاءِ بِمَا صَبَرْتَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْتَسَبْتَ وَأَعَنْتَ"
    },
    {
      "kind": "text",
      "ar": "فَنِعْمَ عُقْبَي الدَّارِ"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ مَنْ قَتَلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ الله مَنْ جَهِلَ حَقَّكَ وَاسْتَخَفَّ بِحُرْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ حَالَ بَيْنَكَ وَبَيْنَ مَاءِ الْفُرَاتِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قُتِلْتَ مَظْلُوْمًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ اللهَ مُنْجِزٌ لَكُمْ مَا وَعَدَكُمْ"
    },
    {
      "kind": "text",
      "ar": "جِئْتُكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَافِدًا اِلَيْكُمْ وَقَلْبِيْ مُسَلِّمٌ لَكُمْ وَتَابِعٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا لَكُمْ تَابِعٌ، وَنُصْرَتِيْ لَكُمْ مُعَدَّةٌ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي يَحْكُمَ اللهُ وَهُوَ خَيْرُ الْحَاكِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَمَعَكُمْ مَعَكُمْ لَا مَعَ عَدُوِّكُمْ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ بِكُمْ وَبِاِيَابِكُمْ مِنَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَنْ خَالَفَكُمْ وَقَتَلَكُمْ مِنَ الْكَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "قَتَلَ اللهُ أُمَّةً قَتَلَتْكُمْ بِالْاَيْدِيْ وَالْاَلْسُنِ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْعَبْدُ الصَّالِحُ"
    },
    {
      "kind": "text",
      "ar": "الْمُطِيْعُ لِلّٰهِ وَلِرَسُوْلِهٖ وَلِاَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنِ وَالْحُسَيْنِ صَلَّي اللهُ عَلَيْهِمْ وَسَلَّمَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَغْفِرَتُهٗ وَرِضْوَانُهٗ وَعَلٰي رُوْحِكَ وَبَدَنِكَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ وَأُشْهِدُ اللهَ"
    },
    {
      "kind": "text",
      "ar": "أَنَّكَ مَضَيْتَ عَلٰي مَا مَضٰي بِهِ الْبَدْرِيُّوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُجَاهِدُوْنَ فِيْ سَبِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "الْمُنَاصِحُوْنَ لَهٗ فِيْ جِهَادِ أَعْدَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْمُبَالِغُوْنَ فِيْ نُصْرَةِ أَوْلِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "الذَّابُّوْنَ عَنْ أَحِبَّائِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَجَزَاكَ اللهُ أَفْضَلَ الْجَزَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَكْثَرَ الْجَزَاءِ، وَأَوْفَرَ الْجَزَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْفٰي جَزَاءِ أَحَدٍ مِمَّنْ وَفٰي بِبَيْعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَجَابَ لَهٗ دَعْوَتَهٗ، وَأَطَاعَ وُلَاةَ أَمْرِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ بَالَغْتَ فِي النَّصِيْحَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطَيْتَ غَايَةَ الْمَجْهُوْدِ"
    },
    {
      "kind": "text",
      "ar": "فَبَعَثَكَ اللهُ فِي الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَ رُوْحَكَ مَعَ أَرْوَاحِ السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطَاكَ مِنْ جِنَانِهٖ أَفْسَحَهَا مَنْزِلًا وَأَفْضَلَهَا غُرَفًا"
    },
    {
      "kind": "text",
      "ar": "وَرَفَعَ ذِكْرَكَ فِيْ عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَحَشَرَكَ مَعَ النَّبِيِّيْنَ وَالصِّدِّيْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالشُّهَدَاءِ وَالصَّالِحِيْنَ وَحَسُنَ أُولٰئِكَ رَفِيْقًا۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ لَمْ تَهِنْ وَلَمْ تَنْكُلْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ مَضَيْتَ عَلٰي بَصِيْرَةٍ مِنْ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "مُقْتَدِيًا بِالصَّالِحِيْنَ وَمُتَّبِعًا لِلنَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَجَمَعَ اللهُ بَيْنَنَا وَبَيْنَكَ وَبَيْنَ رَسُوْلِهٖ وَأَوْلِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "فِيْ مَنَازِلِ الْمُخْبِتِيْنَ، فَاِنَّهٗ أَرْحَمُ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَدَعْ لِيْ فِيْ هٰذَا الْمَكَانِ الْمُكَرَّمِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَشْهَدِ الْمُعَظَّمِ ذَنْبًا اِلَّا غَفَرْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا هَمًّا اِلَّا فَرَّجْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مَرَضًا اِلَّا شَفَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا عَيْبًا اِلَّا سَتَرْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا رِزْقًا اِلَّا بَسَطْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا خَوْفًا اِلَّا اٰمَنْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا شَمْلًا اِلَّا جَمَعْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا غَائِبًا اِلَّا حَفِظْتَهٗ وَأَدْنَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَاجَةً مِنْ حَوَائِجِ الدُّنْيَا وَالْاٰخِرَة ِ"
    },
    {
      "kind": "text",
      "ar": "لَكَ فِيْهَا رِضًى وَلِيَ فِيْهَا صَلَاحٌ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا قَضَيْتَهَا يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَبَاالْفَضْلِ الْعَبَّاسَ ابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ سَيِّدِ الْوَصِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ أَوَّل الْقَوْمِ اِسْلَامًا"
    },
    {
      "kind": "text",
      "ar": "وَأَقْدَمِهِمْ اِيْمَانًا، وَأَقْوَمِهِمْ بِدِيْنِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْوَطِهِمْ عَلَي الْاِسْلَامِ۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ لَقَدْ نَصَحْتَ لِلّٰهِ وَلِرَسُوْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلِاَخِيْكَ، فَنِعْمَ الْاَخُ الْمُوَاسِيْ"
    },
    {
      "kind": "text",
      "ar": "فَلَعَنَ اللهُ أُمَّةً قَتَلَتْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ أُمَّةً ظَلَمَتْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ أُمَّةً اسْتَحَلَّتْ مِنْكَ الْمَحَارِمَ"
    },
    {
      "kind": "text",
      "ar": "وَانْتَهَكَتْ حُرْمَةَ الْاِسْلَامِ"
    },
    {
      "kind": "text",
      "ar": "فَنِعْمَ الصَّابِرُ الْمُجَاهِدُ الْمُحَامِي النَّاصِرُ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَخُ الدَّافِعُ عَنْ أَخِيْهِ"
    },
    {
      "kind": "text",
      "ar": "الْمُجِيْبُ اِلٰي طَاعَةِ رَبِّهٖ"
    },
    {
      "kind": "text",
      "ar": "الرَّاغِبُ فِيْمَا زَهِدَ فِيْهِ  غَيْرُهٗ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الثَّوَابِ الْجَزِيْلِ، وَالثَّنَاءِ الْجَمِيْلِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْحَقَكَ اللهُ بِدَرَجَةِ اٰبَائِكَ فِيْ جَنَّاتِ النَّعِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ تَعَرَّضْتُ لِزِيَارَةِ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "رَغْبَةً فِيْ ثَوَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَرَجَاءً لِمَغْفِرَتِكَ وَجَزِيْلِ اِحْسَانِكَ"
    },
    {
      "kind": "text",
      "ar": "فأَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِهِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ رِزْقِيْ بِهِمْ دَارًّا، وَعَيْشِيْ بِهِمْ قَارًّا"
    },
    {
      "kind": "text",
      "ar": "وَزِيَارَتِيْ بِهِمْ مَقْبُوْلَةً، وَحَيَاتِيْ بِهِمْ طَيِّبَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَدْرِجْنِيْ اِدْرَاجَ الْمُكْرَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِمَّنْ يَنْقَلِبُ"
    },
    {
      "kind": "text",
      "ar": "مِنْ زِيَارَةِ مَشَاهِدِ أَحِبَّائِكَ مُفْلِحًا مُنْجِحًا"
    },
    {
      "kind": "text",
      "ar": "قَدِ اسْتَوْجَبَ غُفْرَانَ الذُّنُوْبِ"
    },
    {
      "kind": "text",
      "ar": "وَسَتْرَ الْعُيُوْبِ وَكَشْفَ الْكُرُوْبِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَهْلُ التَّقْوٰي وَأَهْلُ الْمَغْفِرَةِ۔"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْدِعُكَ اللهَ وَأَسْتَرْعِيْكَ وَأَقْرَأُ عَلَيْكَ السَّلَامَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنَّا بِاللّٰهِ وَبِرَسُوْلِهٖ وَبِكِتَابِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَا جَاءَ بِهٖ مِنْ عِنْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاكْتُبْنَا مَعَ الشَّاهِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَجْعَلْهُ اٰخِرَ الْعَهْدِ مِنْ زِيَارَتِيْ"
    },
    {
      "kind": "text",
      "ar": "قَبْرَ ابْنِ أَخِيْ رَسُوْلِكَ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ زِيَارَتَهٗ أَبَدًا مَا أَبْقَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنِيْ مَعَهٗ وَمَعَ اٰبَائِهٖ فِي الْجِنَانِ"
    },
    {
      "kind": "text",
      "ar": "وَعَرِّفْ بَيْنِيْ وَبَيْنَهٗ وَبَيْنَ رَسُوْلِكَ وَأَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَفَّنِيْ عَلَي الْاِيْمَانِ بِكَ وَالتَّصْدِيْقِ بِرَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْوِلَايَةِ لِعَلِيِّ بْنِ أَبِيْ طَالِبٍ وَالْاَئِمَّةِ مِنْ وُلْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَرَائَةِ مِنْ عَدُوِّهِمْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ قَدْ رَضِيْتُ يَا رَبِّيْ بِذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ۔"
    }
  ]
}