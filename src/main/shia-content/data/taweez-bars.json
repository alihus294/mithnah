{
  "id": "taweez-bars",
  "title": "برص كے لء دعا",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "برص كے لء دعا",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا رَحْمنُ يَا رَحِيْمُ، يَا سَمِيْعَ الدَّعَوَاتِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُعْطِيَ الدُّنْيَا وَخَيْرَ الْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَقِنِيْ شَرَّ الدُّنْيَا وَشَرَّ الْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَذْهِبْ عَنِّيْ مَا أَجِدُ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ غَاظَنِي الْاَمْرُ وَأَحْزَنَنِيْ۔"
    },
    {
      "kind": "text",
      "ar": "يَا عَلِيُّ يَا عَظِيْمُ، يَا رَحْمٰنُ يَا رَحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "يَا سَامِعَ الدَّعَوَات يَا مُعْطِيَ الْخَيْرَاتِ"
    },
    {
      "kind": "text",
      "ar": "صِلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنِيْ مِنْ خَيْرِ الدُّنْيَا وَالْاٰخِرَةِ مَا أَنْتَ أَهْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاصْرِفْ عَنِّيْ مِنْ شَر الدُّنْيَا وَالْاٰخِرَةِ مَا أَنْت أَهْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَذْهِبْ عَنِّيْ هٰذَا الْوَجَعَ فَاِنَّهٗ قَدْ غَاظَنِيْ وَأَحْزَنَنِيْ۔"
    }
  ]
}