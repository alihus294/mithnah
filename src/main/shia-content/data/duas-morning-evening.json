{
  "id": "duas-morning-evening",
  "title": "۱۔ صبح اور شام كے وقت",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۔ صبح اور شام كے وقت",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَبْتَدِئُ يَوْمِيْ هٰذَا بَيْنَ يَدَيْ نِسْيَانِيْ وَعَجَلَتِيْ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ مَا شَآءَ اللهُ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْدِعُ اللهَ الْعَلِيِّ الْاَعْلَي الْجَلِيْلَ الْعَظِيْمَ"
    },
    {
      "kind": "text",
      "ar": "نَفْسِيْ وَمَنْ يَعْنِيْنِيْ أَمْرُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْدِعُ اللهَ نَفْسِيْ الْمَرْهُوْبَ الْمَخُوْفَ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَضَعْضِعَ لِعَظَمَتِهٖ كُلُّ شَيْءٍ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اِنِّيْ أَسْأَلُكَ عِنْدَ اِقْبَالِ لَيْلِكَ وَاِدْبَارِ نَهَارِك"
    },
    {
      "kind": "text",
      "ar": "وَحُضُوْرِ صَلَوَاتِكَ وَأَصْوَاتِ دُعَائِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ صَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ وَاِلَي اللهِ وَفِيْ سَبِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مِلَّةِ رَسُوْلِ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِلَيْكَ اَسْلَمْتُ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ فَوَّضْتُ اَمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ تَوَكَّلْتُ يَا رَبَّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ احْفَظْنِيْ بِحِفْظِ الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "مِنْ بَيْنِ يَدَيَّ وَمِنْ خَلْفِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَنْ يَمِيْنِيْ وَعَنْ شِمَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ فَوْقِيْ وَمِنْ تَحْتِيْ وَمِنْ قِبَلِيْ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ، لَا حَوْلَ و لَا قُوَّةَ اِلَّا بِا اللهِ"
    },
    {
      "kind": "text",
      "ar": "نَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ كُلِّ سُوْءٍ وَشَرٍّ فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اِنِّيْ أَعُوْذُ بِكَ مِنَ عَذَابِ الْقَبْرِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ ضَغْطَةِ الْقَبْرِ، وَمِنْ ضِيْقِ الْقَبْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ مِنْ سَطَوَاتِ اللَّيْلِ وَالنَّهَارِ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ رَبَّ الْمَشْعَرِ الْحَرَامِ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ الْبَلَدِ الْحَرَامِ، وَرَبَّ الْحِلِّ وَالْاِحْرَامِ"
    },
    {
      "kind": "text",
      "ar": "أَبْلِغْ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ عَنِّي السَّلَامَ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اِنِّيْ أَعُوْذُ بِدِرْعِكَ الْحَصِيْنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِجَمْعِكَ أَنْ تُمِيْتَنِيْ غَرَقًا، أَوْ حَرَقًا"
    },
    {
      "kind": "text",
      "ar": "أَوْ شَرَقًا، أَوْ قَوَدًا، أَوْصَبْرًا، أَوْ مُسَمًّا"
    },
    {
      "kind": "text",
      "ar": "أَوْ تَرَدِّيًا فِيْ بِيْرٍ أَوْ أَكِيْلَ السَّبُعِ"
    },
    {
      "kind": "text",
      "ar": "أَوْ مَوْتَ الْفُجَائَةِ، أَوْ بِشَيْءٍ مِنْ مِيْتَاتِ السَّوء"
    },
    {
      "kind": "text",
      "ar": "وَلٰكِنْ أَمِتْنِيْ عَلٰي فِرَاشِيْ فِيْ طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَطَاعَةِ رَسُوْلِكَ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "مُصِيْبًا لِلْحَقِّ غَيْرَ مُخْطِئٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْ فِي الصَّفِّ الَّذِيْنَ نَعَتَّهُمْ فِيْ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "”كَأَنَّهُمْ بُنْيَانٌ مَرْصُوْصٌ“"
    },
    {
      "kind": "text",
      "ar": "أُعِيْذُ نَفْسِيْ وَوَلَدِيْ وَمَا رَزَقَنِيْ رَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "بِقُلْ أَعُوْذُ بِرَبِّ الْفَلَقِ .......... تا آخر سوره"
    },
    {
      "kind": "text",
      "ar": "وَأُعِيْذُ نَفْسِيْ وَوَلَدِيْ وَمَا رَزَقَنِيْ رَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "بِقُلْ أَعُوْذُ بِرَبِّ النَّاس .......... تا آخر سوره"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ عَدَدَ مَا خَلَقَ اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ مِثْلَ مَا خَلَقَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ مِلْئَ مَا خَلَق"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ مِدَادَ كَلِمَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ زِنَةَ عَرْشِهِ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ رِضَا نَفْسِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا اِلٰهَ اِلَّا اللهُ الْحَلِيْمُ الْكَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا اِلٰهَ اِلَّا اللهُ الْعَلِيُّ الْعَظِيْمُ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ رَبِّ السَّمٰوَات ِوَالْاَرَضِيْن"
    },
    {
      "kind": "text",
      "ar": "وَمَا بَيْنَهُمَا، وَرَبِّ الْعَرْش الْعَظِيْمِ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اِنِّيْ أَعُوْذُ بِكَ مِنْ دَرَكِ الشَّقَاءِ وَمِنْ شَمَاتَةِ الْاَعْدَاء"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ مِنَ الْفَقْرِ َالْوَقْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ مِنْ سُوْءِ الْمَنْظَرِ فِي الْاَهْلِ وَالْمَالِ وَالْوَلَدِ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "لَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِرَبِّ الصَّبَاحِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِفَالِقِ الْاِصْبَاحِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَذْهَبَ اللَّيْلَ بِقُدْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَاءَ بِالنَّهَارِ بِرَحْمَتِهٖ، وَنَحْنُ فِيْ عَافِيَة۔"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَامٌ عَلَي الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَسُبْحَانَ اللهِ حِيْنَ تُمْسُوْن وَحِيْنَ تُصْبِحُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَهُ الْحَمْدُ فِي السَّمٰوَات ِوَالْاَرْضِ وَعَشِيًّا وَحِيْنَ تُظْهِرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَيُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ"
    },
    {
      "kind": "text",
      "ar": "وَيُحْيِي الْاَرْضَ بَعْدَ مَوْتِهَا وَكَذٰلِكَ تُخْرَجُوْنَ"
    },
    {
      "kind": "text",
      "ar": "سُبُّوْحٌ قُدُّوْسٌ رَبُّنَا وَرَبُّ الْمَلَائِكَةِ وَالرُّوْحِ"
    },
    {
      "kind": "text",
      "ar": "سَبَقَتْ رَحْمَتُكَ غَضَبَكَ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ سُبْحَانَكَ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ ظَلَمْتُ نَفْسِيْ فَاغْفِرْ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْنِيْ وَتُبْ عَلَيَّ اِنَّكَ أَنْتَ التَّوَّاب الرَّحِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ لَكَ الْحَمْدُ أَحْمَدُكَ وَأَسْتَعِيْنُكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ رَبِّيْ وَأَنَا عَبْدُكَ"
    },
    {
      "kind": "text",
      "ar": "أَصْبَحْتُ عَلٰي عَهْدِكَ وَوَعْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأُوْمِنُ بِوَعْدِكَ وَأُوْفِيْ بِعَهْدِكَ مَا اسْتَطَعْتُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهٗ وَرَسُوْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَصْبَحْتُ عَلٰي فِطْرَةِ الْاِسْلَامِ وَكَلِمَةِ الْاِخْلَاص"
    },
    {
      "kind": "text",
      "ar": "وَمِلَّةِ اِبْرَاهِيْمَ وَدِيْنِ مُحَمَّد"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْهِمَا وَاٰلِهِمَا"
    },
    {
      "kind": "text",
      "ar": "عَلٰي ذٰلِك أَحْيِيْ وَأَمُوْتُ اِنْ شَاءَ اللهُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَحْيِنِيْ مَا أَحْيَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَمِتْنِيْ اِذَا أَمَتَّنِيْ عَلٰي ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَابْعَثْنِيْ اِذَا بَعَثْتَنِيْ عَلٰي ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "أَبْتَغِيْ بِذٰلِكَ رِضْوَانَكَ وَاتِّبَاعَ سَبِيْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ أَلْجَأْتُ ظَهْرِيْ وَاِلَيْكَ فَوَّضْتُ أَمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "اٰلُ مُحَمَّدٍ أَئِمَّتِيْ لَيْسَ لِيْ أَئِمَّةٌ غَيْرُهُمْ"
    },
    {
      "kind": "text",
      "ar": "بِهِمْ وَاِيَّاهُمْ أَتَوَلّٰي وَبِهِمْ أَقْتَدِيْ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اجْعَلْهُمْ أَوْلِيَائِيْ فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ أُوَالِيْ أَوْلِيَائَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأُعَادِيْ أَعْدَائَهُمْ فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْحِقْنِيْ بِالصَّالِحِيْنَ وَاٰبَائِيْ مَعَهُمْ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اِنِّيْ أَصْبَحْتُ أَسْتَغْفِرُكَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ هٰذَا الصَّبَاحِ هٰذَا الْيَوْمِ لِاَجْلِ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْرَأُ اِلَيْك مِنْ أَهْلِ لَعْنَتِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اِنِّيْ أَصْبَحْتُ أَبْرَأُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ هٰذَا الْيَوْمِ وَفِيْ هٰذَا الصَّبَاحِ"
    },
    {
      "kind": "text",
      "ar": "مِمَّنْ نَحْنُ بَيْنَ ظَهْرَانِيْهِمْ مِنَ الْمُشْرِكِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمِمَّا كَانُوْا يَعْبُدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهُمْ كَانُوْا قَوْمَ سَوْءٍ فَاسِقِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اجْعَلْ مَا أَنْزَلْتَ مِنَ السَّمَاءِ اِلَي الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "فِيْ هٰذَا الصَّبَاحِ وَفِيْ هٰذَا الْيَوْمِ"
    },
    {
      "kind": "text",
      "ar": "بَرَكَةً عَلٰي أَوْلِيَائِكَ وَعِقَابًا عَلٰي أَعْدَائِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ وَالِ مَنْ مَنْ وَالَاكَ وَعَادِ مَنْ عَادَاكَ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اخْتِمْ لِيْ بِالْاَمْنِ وَالْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "كُلَّمَا طَلَعَتْ شَمْسٌ أَوْ غَرَبَتْ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اغْفِرْ لِيْ وَلِوَالِدَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْهُمَا كَمَا رَبَّيَانِيْ صَغِيْرًا۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اغْفِرْ لِلْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسْلِمِيْنَ وَالْمُسْلِمَاتِ الْاَحْيَاءِ مِنْهُمْ وَالْاَمْوَاتِ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اِنَّكَ تَعْلَمُ مُنْقَلَبَهُمْ وَمَثْوَاهُمْ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ احْفَظْ اِمَامَ الْمُسْلِمِيْنَ بِحِفْظِ الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْهُ نَصْرًا عَزِيْزًا"
    },
    {
      "kind": "text",
      "ar": "وَافْتَحْ لَهٗ فَتْحًا يَسِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لَهٗ وَلَنَا مِنْ لَدُنْكَ سُلْطَانًا نَصِيْرًا۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ الْعَن فُلَانًا وَفُلَانًا وَالْفِرَقَ الْمخْتَلِفَةَ عَلٰي رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَوُلَاةِ الْاَمْرِ بَعْدَ رَسُوْلِكَ وَالْاَئِمَّةِ مِنْ بَعْدِهٖ وَشِيْعَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وأَسْأَلُكَ الزِّيَادَةَ مِنْ فَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِقْرَارَ بِمَا جَاءَ بِهٖ مِنْ عِنْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّسْلِيْمَ لِاَمْرِكَ وَالْمُحَافَظَةَ عَلٰي مَا أَمَرْتَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "لَا أَبْتَغِيْ بِهٖ بَدَلًا وَلَا أَشْتَرِيْ بِهٖ ثَمَنًا قَلِيْلًا۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اهْدِنِيْ فِيْمَنْ هَدَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَقِنِيْ شَرَّ مَا قَضَيْتَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ تَقْضِيْ وَلَا يُقْضٰي عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُذِلُّ مَنْ وَالَيْتَ"
    },
    {
      "kind": "text",
      "ar": "تَبَارَكْتَ وَتَعَالَيْتَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ رَبَّ الْبَيْتِ"
    },
    {
      "kind": "text",
      "ar": "تَقَبَّلْ مِنِّيْ دُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمَا تَقَرَّبْتُ بِهٖ اِلَيْكَ مِنْ خَيْرٍ"
    },
    {
      "kind": "text",
      "ar": "فَضَاعِفْهُ لِيْ أَضْعَافًا كَثِيْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا مِنْ لَدُنْكَ أَجْرًا عَظِيْمًا"
    },
    {
      "kind": "text",
      "ar": "رَبِّ مَا أَحْسَنَ مَا أَبْلَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْظَمَ مَا أَعْطَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَطْوَلَ مَا عَافَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَكْثَرَ مَا سَتَرْتَ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "فَلَكَ الْحَمْدُ يَا اِلٰهِيْ كَثِيْرًا طَيِّبًا مُبَارَكًا"
    },
    {
      "kind": "text",
      "ar": "عَلَيْهِ مِلْئَ السَّمٰوَاتِ وَمِلْئَ الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "وَمِلْئَ مَا شَاءَ رَبِّيْ وَرَضِيَ"
    },
    {
      "kind": "text",
      "ar": "وَكَمَا يَنْبَغِيْ لِوَجْهِ رَبِّيْ ذِالْجَلَالِ وَالْاِكْرَامِ۔"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ، يُحْيِيْ وَيُمِيْتُ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ حَيٌّ لَا يَمُوْتُ، بِيَدِهِ الْخَيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "اللهُ اللهُ اللهُ رَبِّيَ الرَّحْمٰنُ الرَّحيٰمُ لَا اُشْرِكُ بهٖ شَيْئًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ فِيْ دِرْعِكَ الْحَصِيْنَةِ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ تَجْعَلُ فِيْهَا مَنْ تُرِيْدُ"
    }
  ]
}