{
  "id": "ramadan-day11-dua",
  "title": "گيارهويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "گيارهويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ حَبِّبْ اِلَيَّ فِيْهِ الْاِحْسَانَ"
    },
    {
      "kind": "text",
      "ar": "وَكَرِّهْ اِلَيَّ فِيْهِ الْفُسُوْقَ وَالْعِصْيَانَ"
    },
    {
      "kind": "text",
      "ar": "وَحَرِّمْ عَلَيَّ فِيْهِ السَّخَطَ وَالنِّيْرَانَ"
    },
    {
      "kind": "text",
      "ar": "بِعَوْنِكَ يَا غِيَاثَ الْمُسْتَغِيْثِيْنَ"
    }
  ]
}