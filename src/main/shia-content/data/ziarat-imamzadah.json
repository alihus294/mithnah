{
  "id": "ziarat-imamzadah",
  "title": "زيارت براء امام زادگان",
  "subtitle": "ملحقات مفاتيح الجنان",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت براء امام زادگان",
      "subtitle": "ملحقات مفاتيح الجنان"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا السَّيِّدُ الزَّكِيُّ"
    },
    {
      "kind": "text",
      "ar": "الطَّاهِرُ الْوَلِيُّ، وَالدَّاعِي الْحَفِيُّ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قُلْتَ حَقًّا"
    },
    {
      "kind": "text",
      "ar": "وَنَطَقْتَ حَقًّا وَصِدْقًا"
    },
    {
      "kind": "text",
      "ar": "وَدَعَوْتَ اِلٰي مَوْلَايَ وَمَوْلَاكَ عَلَانِيَةً وَسِرًّا"
    },
    {
      "kind": "text",
      "ar": "فَازَ مُتَّبِعُكَ وَنَجٰي مُصَدِّقُكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَابَ وَخَسِرَ مُكَذِّبُكَ وَالْمُتَخَلِّفُ عَنْكَ"
    },
    {
      "kind": "text",
      "ar": "اِشْهَدْ لِيْ بِهٰذِهِ الشَّهَادَةِ لِأَكُوْنَ مِنَ الْفَائِزِيْنَ"
    },
    {
      "kind": "text",
      "ar": "بِمَعْرِفَتِكَ وَطَاعَتِكَ وَتَصْدِيْقِكَ وَاتِّبَاعِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكَ يَا سَيِّدِيْ وَابْنَ سَيِّدِيْ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ بَابُ اللهُ الْمُؤْتٰي مِنْهُ وَالْمَأْخُوْذُ عَنْهُ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ زَائِرًا، وَحَاجَاتِيْ لَكَ مُسْتَوْدِعًا"
    },
    {
      "kind": "text",
      "ar": "وَهَا أَنَا ذَا أَسْتَوْدِعُكَ دِيْنِيْ وَأَمَانَتِيْ وَخَوَاتِيْمَ عَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَجَوَامِعَ أَمَلِيْ اِلٰي مُنْتَهٰي أَجَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي جَدِّكَ الْمُصْطَفٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَبِيْكَ الْمُرْتَضَي الرِّضَا"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي السَّيِّدَيْنِ الْحَسَنِ وَالْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي خَدِيْجَةَ أُمِّ سَيِّدَةِ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي فَاطِمَةَ أُمِّ الْاَئِمَّةِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي النُّفُوْسِ الْفَاخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "بُحُوْرِ الْعُلُوْمِ الزَّاخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "شُفَعَائِيْ فِي الْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْلِيَائِيْ عِنْدَ عَوْدِ الرُّوْحِ اِلَي الْعِظَامِ النَّاخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "أَئِمَّةِ الْخَلْقِ، وَوُلَاةِ الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَليْكَ أَيُّهَا الشَّخْصُ الشَّرِيْفُ الطَّاهِرُ الْكَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مُحَمَّدًا عَبْدُهٗ وَمُصْطَفَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ عَلِيًّا وَلِيُّهٗ وَمُجْتَبَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ الْاِمَامَةَ فِيْ وُلْدِهِ اِلٰي يَوْمِ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "نَعْلَمُ ذٰلِكَ عِلْمَ الْيَقِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَنَحْنُ لِذٰلِكَ مُعْتَقِدُوْنَ، وَفِيْ نَصْرِهِمْ مُجْتَهِدُوْنَ۔"
    }
  ]
}