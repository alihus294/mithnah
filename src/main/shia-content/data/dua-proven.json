{
  "id": "dua-proven",
  "title": "۱۳۔ دعاء مجرب",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۳۔ دعاء مجرب",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ خَيْرِ الْاَسْمَاءِ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ رَبِّ الْاَرْضِ وَالسَّمَاءِ"
    },
    {
      "kind": "text",
      "ar": "بِسمِ اللهِ الَّذِيْ لَا يَضُرُّ مَعَ اسْمِهٖ سَمٌّ وَلَا دَاءٌ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ أَصْبَحْتُ وَعَلَي اللهِ تَوَكَّلْتُ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ عَلٰي قَلْبِيْ وَنَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ عَلٰي دِيْنِيْ وَعَقْلِيْ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ عَلٰي أَهْلِيْ وَمَالِيْ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ عَلٰي مَا أَعْطَانِيْ رَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الَّذِيْ لَا يَضُرُّ مَعَ اسْمِهٖ شَيْءٌ فِي الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيْعُ الْعَلِيْمُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ اَللّٰهُ رَبِّيْ لَا أُشْرِكُ بِهٖ شَيْئًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ أَكْبَرُ اَللّٰهُ أَكْبَرُ وَأَعَزُّ وَأَجَلُّ مِمَّا أَخَافُ وَأَحْذَرُ"
    },
    {
      "kind": "text",
      "ar": "عَزَّ جَارُكَ وَجَلَّ ثَنَاؤُكَ وَلَا اِلٰهَ غَيْرُكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَعُوْذُ بِكَ مِنْ شَرِّ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ كُلِّ سُلْطَانٍ شَدِيْدٍ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ كُلِّ شَيْطَانٍ مَرِيْدٍ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ كُلِّ جَبَّارٍ عَنِيْدٍ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ قَضَاءِ السُّوْءِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ دَابَّةٍ أَنْتَ اٰخِذٌ بِنَاصِيَتِهَا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي صِرَاطٍ مُسْتَقِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ عَلٰي كُلِّ شَيْءٍ حَفِيْظٌ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ وَلِيِّيَ اللهُ الَّذِيْ نَزَّلَ الْكِتَابَ وَهُوَ يَتَوَلَّي الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللهُ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ رَبُّ الْعَرْشِ الْعَظِيْمِ"
    }
  ]
}