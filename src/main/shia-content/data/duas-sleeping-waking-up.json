{
  "id": "duas-sleeping-waking-up",
  "title": "۲۔ سونے اور جاگنے كے وقت",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۲۔ سونے اور جاگنے كے وقت",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ عَلَا فَقَهَرَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ الَّذِيْ بَطَنَ فَخَبَر"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ الَّذِيْ مَلَكَ فَقَدَرَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ الَّذِيْ يُحْيِي الْمَوْتٰي وَيُمِيْتُ الْاَحْيَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَلٰي كُلِّ شَيْءٍ قَدِيْر"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ اٰمَنْتُ بِاللّٰهِ وَكَفَرْتُ بِالطَّاغُوْتِ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ احْفَظْنِيْ فِيْ مَنَامِيْ وَفِيْ يَقَظَتِيْ"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِعِزَّةِ اللهِ وَأَعُوْذُ بِقُدْرَةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِجَلَالِ اللهِ، وَأَعُوْذُ بِسُلْطَانِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِجَمَالِ اللهِ، وَأَعُوْذُ بِدَفْع اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِمَنْعِ اللهِ، وَأَعُوْذُ بِجَمْعِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِمُلْكِ اللهِ، وَأَعُوْذُ بِوَجْهِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِرَسُوْلِ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهِ"
    },
    {
      "kind": "text",
      "ar": "مِنْ شَرِّ مَا خَلَقَ وَبَرَأَ وَذَرَأَ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ لَا تُؤْمِنِّيْ مَكْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُنْسِنِيْ ذِكْرَكَ، وَلَا تَجْعَلْنِيْ مِنَ الْغَافِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَقُوْمُ سَاعَةً كَذَا وَكَذَا"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الله رَبِّ النَّبِيِّيْن الْمُرْسَلِيْن وَرَبِّ الْمُسْتَضْعَفِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ الَّذِيْ يُحْيِي الْمَوْتٰي"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ أَعِنِّيْ عَلٰي هَوْلِ الْمُطَّلَعِ"
    },
    {
      "kind": "text",
      "ar": "وَوَسِّعْ عَلَيَّ ضِيْقَ الْمَضْجَعِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ خَيْرَ مَا قَبْلَ الْمَوْتِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ خَيْرَ مَا بَعْدَ الْمَوْتِ"
    }
  ]
}