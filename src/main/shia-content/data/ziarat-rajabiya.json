{
  "id": "ziarat-rajabiya",
  "title": "زيارت رجبيه",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت رجبيه",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَشْهَدَنَا مَشْهَدَ أَوْ لِيَائِهٖ فِيْ رَجَبٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْجَبَ عَلَيْنَا مِنْ حَقِّهِمْ مَا قَدْ وَجَبَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ الْمُنْتَجَبِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَوْصِيَائِهِ الْحُجُبِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَكَمَا أَشْهَدْتَنَا مَشْهَدَهُمْ"
    },
    {
      "kind": "text",
      "ar": "فَأَنْجِزْلَنَا مَوْعِدَهُمْ، وَأَوْرِدْنَا مَوْرِدَهُمْ"
    },
    {
      "kind": "text",
      "ar": "غَيْرَ مُحَلَّئيِنَ عَنْ وِرْدٍ فِيْ دَارِ الْمُقَامَةِ وَالْخُلْدِ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ قَدْ قَصَدْتُكُمْ وَاعْتَمَدْتُكُمْ بِمَسْأَلَتِيْ وَحَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَهِيَ فَكَاكُ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَقَرُّ مَعَكُمْ فِيْ دَارِ الْقَرَارِ مَعَ شِيْعَتِكُمُ الْاَ بْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكُمْ بِمَا صَبَرْتُمْ فَنِعْمَ عُقْبَي الدَّارِ"
    },
    {
      "kind": "text",
      "ar": "أَنَا سَائِلُكُمْ وَاٰمِلُكُمْ"
    },
    {
      "kind": "text",
      "ar": "فِيْمَا اِلَيْكُمُ التَّفْوِيْضُ وَعَلَيْكُمُ التَّعْوِيْضُ"
    },
    {
      "kind": "text",
      "ar": "فَبِكُمْ يُجْبَرُ الْمَهِيْضُ، وَيُشْفَي الْمَرِيْضُ"
    },
    {
      "kind": "text",
      "ar": "وَمَا تَزْدَادُ الْاَرْحَامُ وَمَا تَغِيْضُ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ بِسِرِّكُمْ مُؤْمِنٌ، وَلِقَوْ لِكُمْ مُسَلِّمٌ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي اللهِ بِكُمْ مُقْسِمٌ فِيْ رَجْعِيْ"
    },
    {
      "kind": "text",
      "ar": "بِحَوَائِجِيْ وَقَضَائِهَا وَاِمْضَائِهَا وَاِنْجَاحِهَا وَاِبْرَاحِهَا"
    },
    {
      "kind": "text",
      "ar": "وَبِشُؤُوْنِيْ لَدَيْكُمْ وَصَلَاحِهَا"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكُمْ سَلَامَ مُوَدِّعٍ وَلَكُمْ حَوَائِجَهٗ مُوْدِعٌ"
    },
    {
      "kind": "text",
      "ar": "يَسْأَلُ اللهَ اِلَيْكُمُ الْمَرْجِعَ"
    },
    {
      "kind": "text",
      "ar": "وَسَعْيُهٗ اِلَيْكُمْ غَيْرَ مُنْقَطِعٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ يَرْجِعَنِيْ مِنْ حَضْرَتِكُمْ خَيْرَ مَرْجِعٍ"
    },
    {
      "kind": "text",
      "ar": "اِلٰي جَنَابٍ مُمْرِعٍ وَخَفْضٍ مُوَسَّعٍ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَةٍ وَمَهَلٍ اِلٰي حِيْنِ الْاَجَلِ"
    },
    {
      "kind": "text",
      "ar": "وَخَيْرِ مَصِيْرٍ وَمَحَلٍّ فِي النَّعِيْمِ الْاَزَلِ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَيْشِ الْمُقْتَبَلِ، وَدَوَامِ الْاُكُلِ"
    },
    {
      "kind": "text",
      "ar": "وَشُرْبِ الرَّحِيْقِ وَالسَّلْسَلِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٍّ وَنَهَلٍ لَا سَأَمَ مِنْهُ وَلَا مَلَلَ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ وَتَحِيَّاتُهٗ عَلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "حَتَّي الْعَوْدِ اِلٰي حَضْرَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَوْزِ فِيْ كَرَّتِكُمْ، وَالْحَشْرِ فِيْ زُمْرَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ عَلَيْكُمْ وَصَلَوَاتُهٗ وَتَحِيَّاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ حَسْبُنَا وَنِعْمَ الْوَكِيْلُ۔"
    }
  ]
}