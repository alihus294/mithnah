{
  "id": "rajab-day27",
  "title": "ستائيس رجب كا دن",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ستائيس رجب كا دن",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ وَاللهُ أَكْبَرُ۔"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ وَالْحَمْدُ لِلّٰهِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ اَللّٰهُ رَبِّيْ لَا اُشْرِكُ بِهٖ شَيْئًا"
    },
    {
      "kind": "text",
      "ar": "لَا اُشْرِكُ بِرَبِّيْ اَحَدًا"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَمْ يَتَّخِذْ وَلَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ شَرِيْكٌ فِي الْمُلْكِ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ وَلِيٌّ مِنَ الذُّلِّ، وَكَبِّرْهُ تَكْبِيْرًا۔"
    },
    {
      "kind": "text",
      "ar": "يَا عُدَّتِيْ فِيْ مُدَّتِيْ، يَا صَاحِبِيْ فِيْ شِدَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا وَلِيِّيْ فِيْ نِعْمَتِيْ، يَا غِيَاثِيْ فِيْ رَغْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا نَجَاحِيْ فِيْ حَاجَتِيْ، يَا حَافِظِيْ فِيْ غَيْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا كَافِيَّ فِيْ وَحْدَتِيْ، يَا أُنْسِيْ فِيْ وَحْشَتِيْ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ السَّاتِرُ عَوْرَتِيْ، فَلَكَ الْحَمْدُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُقِيْلُ عَثْرَتِيْ، فَلَكَ الْحَمْدُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُنْعِشُ صَرْعَتِيْ، فَلَكَ الْحَمْدُ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ وَاسْتُرْ عَوْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاٰمِنْ رَوْعَتِيْ، وَأَقِلْنِيْ عَثْرَتِيْ، وَاصْفَحْ عَنْ جُرْمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَجَاوَزْ عَنْ سَيِّئَاتِيْ فِيْ أَصْحَابِ الْجَنَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَعْدَ الصِّدْقِ الَّذِيْ كَانُوْا يُوْعَدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ وَاللهُ أَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ الله وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ اَللّٰهُ رَبِّيْ لَا اُشْرِكُ بِهٖ شَيْئًا"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ أَمَرَ بِالْعَفْوِ وَالتَّجَاوُزِ"
    },
    {
      "kind": "text",
      "ar": "وَضَمَّنَ نَفْسَهُ الْعَفْوَ وَالتَّجَاوُزَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ عَفَا وَتَجَاوَزَ"
    },
    {
      "kind": "text",
      "ar": "اعْفُ عَنِّيْ وَتَجَاوَزْ يَا كَرِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَقَدْ أَكْدَي الطَّلَبُ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْيَتِ الْحِيْلَةُ وَالْمَذْهَبُ"
    },
    {
      "kind": "text",
      "ar": "وَدَرَسَتِ الْاٰمَالُ، وَانْقَطَعَ الرَّجَاءُ اِلَّا مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَحْدَكَ لَا شَرِيْكَ لَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَجِدُ سُبُلَ الْمَطَالِبِ اِلَيْكَ مُشْرَعَةً"
    },
    {
      "kind": "text",
      "ar": "وَمَنَاهِلَ الرَّجَاءِ لَدَيْكَ مُتْرَعَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَبْوَابَ الدُّعَاءِ لِمَنْ دَعَاكَ مُفَتَّحَةً"
    },
    {
      "kind": "text",
      "ar": "وَالْاِسْتِعَانَةَ لِمَنِ اسْتَعَانَ بِكَ مُبَاحَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَعْلَمُ أَنَّكَ لِدَاعِيْكَ بِمَوْضِعِ اِجَابَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَلِلصَّارِخِ اِلَيْكَ بِمَرْصَدِ اِغَاثَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ فِي اللَّهْفِ اِلٰي جُوْدِكَ  وَالضَّمَانِ"
    },
    {
      "kind": "text",
      "ar": "بِعِدَتِكَ عِوَضًا مِنْ مَنْعِ الْبَاخِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْدُوْحَةً عَمَّا فِيْ أَيْدِي الْمُسْتَأْثِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ لَا تَحْتَجِبُ عَنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا أَنْ تَحْجُبَهُمُ الْاَعْمَالُ دُوْنَكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ عَلِمْتُ أَنَّ أَفْضَلَ زَادِ الرَّاحِلِ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "عَزْمُ اِرَادَةٍ يَخْتَارُكَ بِهَا"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ نَاجَاكَ بِعَزْمِ الْاِرَادَةِ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُك بِكُلِّ دَعْوَةٍ دَعَاكَ بِهَا رَاجٍ بَلَّغْتَهٗ أَمَلَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَوْ صَارِخٌ اِلَيْكَ أَغَثْتَ صَرْخَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَوْ مَلْهُوْفٌ مَكْرُوْبٌ فَرَّجْتَ كَرْبَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَوْ مُذْنِبٌ خَاطِيٌَ غَفَرْتَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَوْ مُعَافًى أَتْمَمْتَ نِعْمَتَكَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "أَوْ فَقِيْرٌ أَهْدَيْتَ غِنَاكَ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَلِتِلْكَ الدَّعْوَةِ عَلَيْكَ حَقٌّ وَعِنْدَكَ مَنْزِلَةٌ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا صَلَّيْتَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَقَضَيْتَ حَوَائِجِيْ حَوَائِجَ الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذَا رَجَبٌ الْمُرَجَّبُ الْمُكَرَّمُ الَّذِيْ أَكْرَمْتَنَا بِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَوَّلُ أَشْهُرِ الْحُرُمِ"
    },
    {
      "kind": "text",
      "ar": "أَكْرَمْتَنَا بِهٖ مِنْ بَيْنِ الْاُمَمِ يَا ذَا الْجُوْدِ وَالْكَرَمِ"
    },
    {
      "kind": "text",
      "ar": "فَنَسْأَلُكَ بِهٖ وَبِاسْمِكَ الْاَعْظَمِ الْاَعْظَمِ الْاَعْظَمِ"
    },
    {
      "kind": "text",
      "ar": "الْاَجَلِّ الْاَكْرَمِ الَّذِيْ خَلَقْتَهٗ فَاسْتَقَرَّ فِيْ ظِلِّكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَا يَخْرُجُ مِنْكَ اِلٰي غَيْرِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلَنَا مِنَ الْعَامِلِيْنَ فِيْهِ بِطَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْاٰمِلِيْنَ فِيْهِ بِشَفَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاهْدِنَا اِلٰي سَوَاءِ السَّبِيْلِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ مَقِيْلَنَا عِنْدَكَ خَيْرَ مَقِيْلٍ فِيْ ظِلٍّ ظَلِيْلٍ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ حَسْبُنَا وَنِعْمَ الْوَكِيْلُ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلٰي عِبَادِهِ الْمُصْطَفَيْنَ وَصَلَوَاتُهٗ عَلَيْهِمْ أَجْمَعِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَبَارِكْ لَنَا فِيْ يَوْمِنَا هٰذَا الَّذِيْ فَضَّلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَبِكَرَامَتِكَ جَلَّلْتَهٗ، وَبِالْمَنْزِلِ الْعَظِيْمِ الْاَعْلٰي أَنْزَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مَنْ فِيْهِ اِلٰي عِبَادِكَ أَرْسَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَبِالْمَحَلِّ الْكَرِيْمِ أَحْلَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَيْهِ صَلَاةً دَائِمَةً"
    },
    {
      "kind": "text",
      "ar": "تَكُوْنُ لَكَ شُكْرًا وَلَنَا ذُخْرًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لَنَا مِنْ أَمْرِنَا يُسْرًا"
    },
    {
      "kind": "text",
      "ar": "وَاخْتِمْ لَنَا بِالسَّعَادَةِ اِلٰي مُنْتَهي اٰجَالِنَا"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ قَبِلْتَ الْيَسِيْرَ مِنْ أَعْمَالِنَا"
    },
    {
      "kind": "text",
      "ar": "وَبَلَّغْتَنَا بِرَحْمَتِكَ أَفْضَلَ اٰمَالِنَا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِهٖ وَسَلَّمَ"
    }
  ]
}