{
  "id": "namaz-ghufaila",
  "title": "نماز غفيله",
  "subtitle": "تعقيبات الصلاة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز غفيله",
      "subtitle": "تعقيبات الصلاة"
    },
    {
      "kind": "text",
      "ar": "وَذَا النُّوْنِ اِذْ ذَهَبَ مُغَاضِبًا فَظَنَّ أَنْ لَنْ نَقْدِرَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "فَنَادٰي فِي الظُّلُمَاتِ أَنْ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ اِنِّيْ كُنْتُ مِنَ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَاسْتَجَبْنَا لَهٗ وَنَجَّيْنَاهُ مِنَ الْغَمِّ"
    },
    {
      "kind": "text",
      "ar": "وَكَذٰلِكَ نُنْجِي الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعِنْدَهٗ مَفَاتِحُ الْغَيْبِ لَا يَعْلَمُهَا اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "وَيَعْلَمُ مَا فِي الْبَرِّ وَالْبَحْرِ"
    },
    {
      "kind": "text",
      "ar": "وَمَا تَسْقُطُ مِنْ وَرَقَةٍ اِلَّا يَعْلَمُهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَبَّةٍ فِيْ ظُلُمَاتِ الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا رَطْبٍ وَلَا يَابِسٍ اِلَّا فِيْ كِتَابٍ مُبِيْنٍ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِمَفَاتِحِ الْغَيْبِ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ لَا يَعْلَمُهَا اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَفْعَلَ بِيْ كَذَا وَكَذَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ وَلِيُّ نِعْمَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْقَادِرُ عَلٰي طَلِبَتِيْ، تَعْلَمُ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْأَلُكَ بِحَقِّ مُحَمَّدٍ وَاٰلِهٖ عَلَيْهِ وَعَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "لَمَّا قَضَيْتَهَا لِيْ"
    }
  ]
}