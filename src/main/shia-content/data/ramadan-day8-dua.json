  "title": "آٹهويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "آٹهويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنِيْ فِيْهِ رَحْمَةَ الْاَيْتَامِ"
    },
    {
      "kind": "text",
      "ar": "وَاِطْعَامَ الطَّعَامِ وَاِفْشَاءَ السَّلَامِ"
    },
    {
      "kind": "text",
      "ar": "وَصُحْبَةَ الْكِرَامِ"
    },
    {
      "kind": "text",
      "ar": "بِطَوْ لِكَ يَا مَلْجَأَ الْاٰمِلِيْنَ"
    }
  ]
}