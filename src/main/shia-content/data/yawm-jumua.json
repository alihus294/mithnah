{
  "id": "yawm-jumua",
  "title": "دُعاءُ يَوْمِ الجُمْعَة",
  "subtitle": "من أدعية الأيام السبعة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "دُعاءُ يَوْمِ الجُمْعَة", "subtitle": "من أدعية الأيام السبعة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "الحَمْدُ للهِ الأَولِ قَبْلَ الإِنْشاءِ وَالإِحْياءِ" },
    { "kind": "text", "ar": "وَالآخِرِ بَعْدَ فَناءِ الأَشْياءِ" },
    { "kind": "text", "ar": "العَلِيمِ الَّذِي لا يَنْسَىٰ مَنْ ذَكَرَهُ" },
    { "kind": "text", "ar": "وَلا يَنْقُصُ مَنْ شَكَرَهُ" },
    { "kind": "text", "ar": "وَلا يَخِيبُ مَنْ دَعاهُ" },
    { "kind": "text", "ar": "وَلا يَقْطَعُ رَجاءَ مَنْ رَجاهُ" },
    { "kind": "text", "ar": "اللَّهُمَّ إِنِّي أُشْهِدُكَ، وَكَفَىٰ بِكَ شَهِيداً" },
    { "kind": "text", "ar": "وَأُشْهِدُ جَمِيعَ مَلائِكَتِكَ" },
    { "kind": "text", "ar": "وَسُكَّانَ سَماواتِكَ، وَحَمَلَةَ عَرْشِكَ" },
    { "kind": "text", "ar": "وَمَنْ بَعَثْتَ مِنْ أَنْبِيائِكَ وَرُسُلِكَ" },
    { "kind": "text", "ar": "وَأَنْشَأتَ مِنْ أَصْنافِ خَلْقِكَ" },
    { "kind": "text", "ar": "أَنِّي أَشْهَدُ أَنَّكَ أَنْتَ اللهُ، لا إِلهَ إِلاَّ أَنْتَ" },
    { "kind": "text", "ar": "وَحْدَكَ لا شَرِيكَ لَكَ وَلا عَدِيلَ" },
    { "kind": "text", "ar": "وَلا خُلْفَ لِقَوْلِكَ وَلا تَبْدِيلَ" },
    { "kind": "text", "ar": "وَأَنَّ مُحَمَّداً صَلَّىٰ اللهُ عَلَيْهِ وَآلِهِ" },
    { "kind": "text", "ar": "عَبْدُكَ وَرَسُولُكَ" },
    { "kind": "text", "ar": "أَدَّىٰ ما حَمَّلْتَهُ إِلَىٰ العِبادِ" },
    { "kind": "text", "ar": "وَجاهَدَ فِي اللهِ عَزَّ وَجلَّ حَقَّ الجِهادِ" },
    { "kind": "text", "ar": "وَأَنَّهُ بَشَّرَ بِما هُوَ حَقٌ مِنَ الثَّوابِ" },
    { "kind": "text", "ar": "وَأَنْذَرَ بِما هُوَ صِدْقٌ مِنَ العِقابِ" },
    { "kind": "text", "ar": "اللَّهُمَّ ثَبِّتْنِي عَلَىٰ دِينِكَ ما أَحْيَيْتَنِي" },
    { "kind": "text", "ar": "وَلا تُزِغْ قَلْبِي بَعْدَ إِذْ هَدَيْتَنِي" },
    { "kind": "text", "ar": "وَهَبْ لِي مِنْ لَدُنْكَ رَحْمَةً" },
    { "kind": "text", "ar": "إِنَّكَ أَنْتَ الوَهَّابُ" },
    { "kind": "text", "ar": "صَلِّ عَلَىٰ مُحَمَّدٍ وَعَلَىٰ آل مُحَمَّدٍ" },
    { "kind": "text", "ar": "وَاجْعَلْنِي مِنْ أَتْباعِهِ وَشِيعَتِهِ" },
    { "kind": "text", "ar": "وَاحْشُرْنِي فِي زُمْرَتِهِ" },
    { "kind": "text", "ar": "وَوَفِّقْنِي لأَداءِ فَرْضِ الجُمُعاتِ" },
    { "kind": "text", "ar": "وَما أَوْجَبْتَ عَلَيَّ فِيها مِنْ الطَّاعاتِ" },
    { "kind": "text", "ar": "وَقَسَمْتَ لأَهْلِها مِنَ العَطاءِ فِي يَوْمِ الجَزاءِ" },
    { "kind": "text", "ar": "إِنَّكَ أَنْتَ العَزِيزُ الحَكِيمُ" }
  ]
}
