{
  "id": "dua-kumail",
  "title": "دعاء كميل بن زيادؒ",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء كميل بن زيادؒ",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِرَحْمَتِكَ الَّتِيْ وَسِعَتْ كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِقُوَّتِكَ الَّتِيْ قَهَرْتَ بِهَا كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَخَضَعَ لَهَا كُلُّ شَيْءٍ، وَذَلَّ لَهَا كُلُّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِجَبَرُوْتِكَ الَّتِيْ غَلَبْتَ بِهَا كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِعِزَّتِكَ الَّتِيْ لَا يَقُوْمُ لَهَا شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِعَظَمَتِكَ الَّتِيْ مَلَأَتْ كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِسُلْطَانِكَ الَّذِيْ عَلَا كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِوَجْهِكَ الْبَاقِيْ بَعْدَ فَنَاءِ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِأَسْمَائِكَ الَّتِيْ مَلَأَتْ أَرْكَانَ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِعِلْمِكَ الَّذِيْ أَحَاطَ بِكُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِنُوْرِ وَجْهِكَ الَّذِيْ أَضَاءَ لَهٗ كُلُّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "يَا نُوْرُ يَا قُدُّوْسُ"
    },
    {
      "kind": "text",
      "ar": "يَا أَوَّلَ الْاَوَّلِيْنَ ، وَيَا اٰخِرَ الْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تَهْتِكُ الْعِصَمَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تُنْزِلُ النِّقَمَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تُغَيِّرُ النِّعَمَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تَحْبِسُ الدُّعَاءَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تُنْزِلُ الْبَلَاءَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْلِيْ كُلَّ ذَنْبٍ أَذْنَبْتُةٗ"
    },
    {
      "kind": "text",
      "ar": "وَكُلَّ خَطِيْئَةٍ أَخْطَأْتُهَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَتَقَرَّبُ اِلَيْكَ بِذِكْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَشْفِعُ بِكَ اِلٰي نَفْسِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُكَ بِجُوْدِكَ أَنْ تُدْنِيَنِيْ مِنْ قُرْبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تُوْزِعَنِيْ شُكْرَكَ وَأَنْ تُلْهِمَنِيْ ذِكْرَكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ سُؤَالَ خَاضِعٍ مُتَذَلِّلٍ خَاشِعٍ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُسَامِحَنِيْ وَتَرْحَمَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلَنِيْ بِقِسْمِكَ رَاضِيًا قَانِعًا"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ جَمِيْعِ الْاَحْوَالِ مُتَوَاضِعًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَسْأَلُكَ سُؤَالَ مَنِ اشْتَدَّتْ فَاقَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزَلَ بِكَ عِنْدَ الشَّدَائِدِ حَاجَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَعَظُمَ فِيْمَا عِنْدَكَ رَغْبَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَظُمَ سُلْطَانُكَ وَعَلَا مَكَانُكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَفِيَ مَكْرُكَ، وَظَهَرَ أَمْرُكَ"
    },
    {
      "kind": "text",
      "ar": "وَغَلَبَ قَهْرُكَ وَجَرَتْ قُدْرَتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُمْكِنُ الْفِرَارُ مِنْ حُكُوْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا أَجِدُ لِذُنُوْبِيْ غَافِرًا، وَلَا لِقَبَائِحِيْ سَاتِرًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا لِشَيْءٍ مِنْ عَمَلِيَ الْقَبِيْحِ بِالْحَسَنِ مُبَدِّلًا غَيْرَكَ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ سُبْحَانَكَ وَبِحَمْدِكَ"
    },
    {
      "kind": "text",
      "ar": "ظَلَمْتُ نَفْسِيْ، وَتَجَرَّأْتُ بِجَهْلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَسَكَنْتُ اِلٰي قَدِيْمِ ذِكْرِكَ لِيْ وَمَنِّكَ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَوْلَايَ كَمْ مِنْ قَبِيْحٍ سَتَرْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَكَمْ مِنْ فَادِحٍ مِنَ الْبَلَاءِ أَقَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَكَمْ مِنْ عِثَارٍ وَقَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَكَمْ مِنْ مَكْرُوْهٍ دَفَعْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَكَمْ مِنْ ثَنَاءٍ جَمِيْلٍ لَسْتُ أَهْلًا لَهٗ نَشَرْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَظُمَ بَلَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْرَطَ بِيْ سُوْءُ حَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَصُرَتْ بِيْ أَعْمَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَعَدَتْ بِيْ أَغْلَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَحَبَسَنِيْ عَنْ نَفْعِيْ بُعْدُ اٰمَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَخَدَعَتْنِي الدُّنْيَا بِغُرُوْرِهَا"
    },
    {
      "kind": "text",
      "ar": "وَنَفْسِيْ بِجِنَايَتِهَا، وَمِطَالِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا سَيِّدِيْ فَأَسْأَلُكَ بِعِزَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ لَا يَحْجُبَ عَنْكَ دُعَائِيْ سُوْءُ عَمَلِيْ وَفِعَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَفْضَحْنِيْ بِخَفِيِّ مَا اطَّلَعْتَ عَلَيْهِ مِنْ سِرِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُعَاجِلْنِيْ بِالْعُقُوْبَةِ عَلٰي مَا عَمِلْتُهٗ فِيْ خَلَوَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "مِنْ سُوْءِ فِعْلِيْ وَاِسَائَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَدَوَامِ تَفْرِيْطِيْ وَجَهَالَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَكَثْرَ ةِ شَهَوَاتِيْ وَغَفْلَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَكُنِ اَللّٰهُمَّ بِعِزَّتِكَ لِيْ فِيْ كُلِّ الْاَحْوَالِ رَؤُوْفًا"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيَّ فِيْ جَمِيْعِ الْاُمُوْرِ عَطُوْفًا"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ وَرَبِّيْ مَنْ لِيْ غَيْرُكَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُهٗ كَشْفَ ضُرِّيْ، وَالنَّظَرَ فِيْ أَمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ وَمَوْلَايَ أَجْرَيْتَ عَلَيَّ حُكْمًا"
    },
    {
      "kind": "text",
      "ar": "اتَّبَعْتُ فِيْهِ هَوٰي نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ أَحْتَرِسْ فِيْهِ مِنْ تَزْيِيْنِ عَدُوِّيْ"
    },
    {
      "kind": "text",
      "ar": "فَغَرَّنِيْ بِمَا أَهْوٰي وَأَسْعَدَهٗ عَلٰي ذٰلِكَ الْقَضَاءُ"
    },
    {
      "kind": "text",
      "ar": "فَتَجَاوَزْتُ بِمَا جَرٰي عَلَيَّ مِنْ ذٰلِكَ بَعْضَ حُدُوْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَالَفْتُ بَعْضَ أَوَامِرِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَكَ الْحَمْدُ عَلَيَّ فِيْ جَمِيْعِ ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حُجَّةَ لِيْ فِيْمَا جَرٰي عَلَيَّ فِيْهِ قَضَاؤُكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْزَمَنِيْ حُكْمُكَ وَبَلَاؤُكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ أَتَيْتُكَ يَا اِلٰهِيْ بَعْدَ تَقْصِيْرِيْ وَاِسْرَافِيْ عَلٰي نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "مُعْتَذِرًا نَادِمًا مُنْكَسِرًا مُسْتَقِيْلًا"
    },
    {
      "kind": "text",
      "ar": "مُسْتَغْفِرًا مُنِيْبًا مُقِرًّا مُذْعِنًا مُعْتَرِفًا"
    },
    {
      "kind": "text",
      "ar": "لَا أَجِدُ مَفَرًّا مِمَّا كَانَ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مَفْزَعًا أَتَوَجَّهُ اِلَيْهِ فِيْ أَمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "غَيْرَ قَبُوْلِكَ عُذْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِدْخَالِكَ اِيَّايَ فِيْ سَعَةٍ مِنْ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاقْبَلْ عُذْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْ شِدَّةَ ضُرِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَفُكَّنِيْ مِنْ شَدِّ وَثَاقِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ ارْحَمْ ضَعْفَ بَدَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَرِقَّةَ جِلْدِيْ وَدِقَّةَ عَظْمِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ بَدَأَ خَلْقِيْ وَذِكْرِيْ وَتَرْبِيَتِيْ وَبِرِّيْ وَتَغْذِيَتِيْ"
    },
    {
      "kind": "text",
      "ar": "هَبْنِيْ لِابْتِدَاءِ كَرَمِكَ وَسَالِفِ بِرِّكَ بِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا اِلٰهِيْ وَسَيِّدِيْ وَرَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "أَتُرَاكَ مُعَذِّبِيْ بِنَارِكَ بَعْدَ تَوْحِيْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَعْدَ مَا انْطَوٰي عَلَيْهِ قَلْبِيْ مِنْ مَعْرِفَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَهِجَ بِهٖ لِسَانِيْ مِنْ ذِكْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاعْتَقَدَهٗ ضَمِيْرِيْ مِنْ حُبِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَعْدَ صِدْقِ اعْتِرَافِيْ وَدُعَائِيْ خَاضِعًا لِرُبُوْبِيَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "هَيْهَاتَ أَنْتَ أَكْرَمُ مِنْ أَنْ تُضَيِّعَ مَنْ رَبَّيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَوْ تُبَعِّدَ مَنْ أَدْنَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَوْ تُشَرِّدَ مَنْ اٰوَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَوْ تُسَلِّمَ اِلَي الْبَلَاءِ مَنْ كَفَيْتَهٗ وَرَحِمْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَيْتَ شِعْرِيْ يَا سَيِّدِيْ وَاِلٰهِيْ وَمَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "أَتُسَلِّطُ النَّارَ عَلٰي وُجُوْهٍ خَرَّتْ لِعَظَمَتِكَ سَاجِدَةً"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَلْسُنٍ نَطَقَتْ بِتَوْحِيْدِكَ صَادِقَةً"
    },
    {
      "kind": "text",
      "ar": "وَبِشُكْرِكَ مَادِحَةً"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي قُلُوْبٍ اعْتَرَفَتْ بِاِلٰهِيَّتِكَ مُحَقِّقَةً"
