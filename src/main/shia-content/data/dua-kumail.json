    {
      "kind": "text",
      "ar": "حَتّٰي تَكُوْنَ أَعْمَالِيْ وَأَوْرَادِيْ كُلُّهَا وِرْدًا وَاحِدًا"
    },
    {
      "kind": "text",
      "ar": "وَحَالِيْ فِيْ خِدْمَتِكَ سَرْمَدًا"
    },
    {
      "kind": "text",
      "ar": "يَا سَيِّدِيْ يَا مَنْ عَلَيْهِ مُعَوَّلِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ اِلَيْهِ شَكَوْتُ أَحْوَالِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ يَا رَبِّ يَا رَبِّ"
    },
    {
      "kind": "text",
      "ar": "قَوِّ عَلٰي خِدْمَتِكَ جَوَارِحِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاشْدُدْ عَلَي الْعَزِيْمَةِ جَوَانِحِيْ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيَ الْجِدَّ فِيْ خَشْيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالدَّوَامَ فِي الْاِتِّصَالِ بِخِدْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَسْرَحَ اِلَيْكَ فِيْ مَيَادِيْنِ السَّابِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأُسْرِعَ اِلَيْكَ فِي الْبَارِزِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْتَاقَ اِلٰي قُرْبِكَ فِي الْمُشْتَاقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَدْنُوَ مِنْكَ دُنُوَّ الْمُخْلِصِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخَافَكَ مَخَافَةَ الْمُوْقِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْتَمِعَ فِيْ جِوَارِكَ مَعَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَمَنْ أَرَادَنِيْ بِسُوْءٍ فَأَرِدْهُ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ كَادَنِيْ فَكِدْهُ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ أَحْسَنِ عَبِيْدِكَ نَصِيْبًا عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَقْرَبِهِمْ مَنْزِلَةً مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخَصِّهِمْ زُلْفَةً لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ لَا يُنَالُ ذٰلِكَ اِلَّا بِفَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجُدْ لِيْ بِجُوْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاعْطِفْ عَلَيَّ بِمَجْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْنِيْ بِرَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لِسَانِيْ بِذِكْرِكَ لَهِجًا"
    },
    {
      "kind": "text",
      "ar": "وَقَلْبِيْ بِحُبِّكَ مُتَيَّمًا"
    },
    {
      "kind": "text",
      "ar": "وَمُنَّ عَلَيَّ بِحُسْنِ اِجَابَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَقِلْنِيْ عَثْرَتِيْ وَاغْفِرْ زَلَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ قَضَيْتَ عَلٰي عِبَادِكَ بِعِبَادَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَهُمْ بِدُعَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَضَمِنْتَ لَهُمُ الْاِجَابَةَ"
    },
    {
      "kind": "text",
      "ar": "فَاِلَيْكَ يَارَبِّ نَصَبْتُ وَجْهِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ يَا رَبِّ مَدَدْتُ يَدِيْ"
    },
    {
      "kind": "text",
      "ar": "فَبِعِزَّتِكَ اسْتَجِبْ لِيْ دُعَائِيْ، وَبَلِّغْنِيْ مُنَايَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَقْطَعْ مِنْ فَضْلِكَ رَجَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِنِيْ شَرَّ الْجِنِّ وَالْاِنْسِ مِنْ أَعْدَائِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا سَرِيْعَ الرِّضَا"
    },
    {
      "kind": "text",
      "ar": "اغْفِرْ لِمَنْ لَا يَمْلِكُ اِلَّا الدُّعَاءَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ فَعَّالٌ لِمَا تَشَاءُ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنِ اسْمُهٗ دَوَاءٌ"
    },
    {
      "kind": "text",
      "ar": "وَذِكْرُهٗ شِفَاءٌ، وَطَاعَتُهٗ غِنًى"
    },
    {
      "kind": "text",
      "ar": "اِرْحَمْ مَنْ رَأْسُ مَالِهِ الرَّجَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَسِلَاحُهُ الْبُكَاءُ"
    },
    {
      "kind": "text",
      "ar": "يَا سَابِغَ النِّعَمِ، يَا دَافِعَ النِّقَمِ"
    },
    {
      "kind": "text",
      "ar": "يَا نُوْرَ الْمُسْتَوْحِشِيْنَ فِي الظُّلَمِ"
    },
    {
      "kind": "text",
      "ar": "يَا عَالِمًا لَا يُعَلَّمُ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَافْعَلْ بِيْ مَا أَنْتَ أَهْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي رَسُوْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَئِمَّةِ الْمَيَامِيْنَ مِنْ اٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَّمَ تَسْلِيْمًا كَثِيْرًا"
    }
  ]
}