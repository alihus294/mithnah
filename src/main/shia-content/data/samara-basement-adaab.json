{
  "id": "samara-basement-adaab",
  "title": "(سامره ميں) سرداب كے آداب",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "(سامره ميں) سرداب كے آداب",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "لَا لِاَمْرِهٖ تَعْقِلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مِنْ أَوْلِيَائِهٖ تَقْبَلُوْنَ حِكْمَةٌ بَالِغَةٌ"
    },
    {
      "kind": "text",
      "ar": "فَمَا تُغْنِي النُّذُرُ عَنْ قَوْمٍ لَا يُؤْمِنُوْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْنَا وَعَلٰي عِبَادِ اللهِ الصَّالِحِيْنَ۔"
    }
  ]
}