{
  "id": "toilet-adaab",
  "title": "آداب بيت الخلا",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "آداب بيت الخلا",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ الله وَبِاللّٰهِ أَعُوْذُ بِاللّٰهِ مِنَ الرِّجْسِ النَّجِسِ"
    },
    {
      "kind": "text",
      "ar": "الْخَبِيْثِ الْمُخْبِث الشَّيْطَانِ الرَّجِيْمِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَطْعِمْنِيْ طَيِّبًا فِيْ عَافِيَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْرِجْهُ مِنِّيْ خَبِيْثًا فِيْ عَافِيَةٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنِي الْحَلَالَ وَجَنِّبْنِي الْحَرَامَ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ جَعَلَ الْمَاءَ طَهُوْرًا وَلَمْ يَجْعَلْهُ نَجِسًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ حَصِّنْ فَرْجِيْ وَأَعِفَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتُرْ عَوْرَتِيْ وَحَرِّمْنِيْ عَلَي النَّارِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَمَاطَ عَنِّي الْاَذٰي"
    },
    {
      "kind": "text",
      "ar": "وَهَنَّأَنِيْ طَعَامِيْ وَشَرَابِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَافَانِيْ مِنَ الْبَلْوٰي۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ عَرَّفَنِيْ لَذَّتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْقٰي فِيْ جَسَدِيْ قُوَّتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْرَجَ عَنِّيْ أَذَاهُ"
    },
    {
      "kind": "text",
      "ar": "يَا لَهَا نِعْمَةً، يَا لَهَا نِعْمَةً يَا لَهَا نِعْمَةً"
    },
    {
      "kind": "text",
      "ar": "لَا يُقَدِّرُ الْقَادِرُوْنَ قَدْرَهَا۔"
    }
  ]
}