{
  "id": "ziarat-imam-hussain-4",
  "title": "چوتهي زيارت مطلقه",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "چوتهي زيارت مطلقه",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْكَ يَا أَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "رَحِمَكَ اللهُ يَا أَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ مَنْ قَتَلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ شَرِكَ فِيْ دَمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ بَلَغَهٗ ذٰلِكَ فَرَضِيَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَنَا اِلَي اللهِ مِنْ ذٰلِكَ بَرِيْءٌ۔"
    }
  ]
}