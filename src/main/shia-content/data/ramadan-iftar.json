{
  "id": "ramadan-iftar",
  "title": "وقتِ افطار كے اعمال",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "وقتِ افطار كے اعمال",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَكَ صُمْتُ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي رِزْقِكَ اَفْطَرْتُ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ تَوَكَّلْتُ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ الله اَللّٰهُمَّ لَكَ صُمْنَا"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي رِزْقِكَ اَفْطَرْنَا"
    },
    {
      "kind": "text",
      "ar": "فَتَقَبَّلْ مِنَّا اِنَّكَ اَنْتَ السَّمِيْعُ الْعَلِيْمُ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ الله الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا وَاسِعَ الْمَغْفِرَةِ، اِغْفِرْ لِيْ"
    }
  ]
}