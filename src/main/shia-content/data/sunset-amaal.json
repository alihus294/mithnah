{
  "id": "sunset-amaal",
  "title": "وقتِ غروب آفتاب كے اعمال",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "وقتِ غروب آفتاب كے اعمال",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "أَمْسٰي ظُلْمِيْ مُسْتَجِيْرًا بِعَفْوِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمْسَتْ ذُنُوْبِيْ مُسْتَجِيْرًا بِمَغْفِرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمْسٰي خَوْفِيْ مُسْتَجِيْرًا بِأَمَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمْسٰي ذُلِّيْ مُسْتَجِيْرًا بِعِزِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمْسٰي فَقْرِيْ مُسْتَجِيْرًا بِغِنَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمْسٰي وَجْهِيَ الْبَالِيْ مُسْتَجِيْرًا بِوَجْهِكَ الدَّائِمِ الْبَاقِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَلْبِسْنِيْ عَافِيَتَكَ"
    },
    {
      "kind": "text",
      "ar": "وَغَشِّنِيْ بِرَحْمَتِكَ وَجَلِّلْنِيْ كَرَامَتَكَ"
    },
    {
      "kind": "text",
      "ar": "وَقِنِيْ شَرَّ خَلْقِكَ مِنَ الْجِنِّ وَالْاِنْسِ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا رَحْمنُ يَا رَحِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوْعِ الشَّمْسِ وَقَبْلَ الْغُرُوْبِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ خَتَمَ النُّبُوَّةَ بِمُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "اخْتِمْ لِيْ فِيْ يَوْمِيْ هٰذَا بِخَيْرٍ"
    },
    {
      "kind": "text",
      "ar": "وَشَهْرِيْ بِخَيْرٍ وَسَنَتِيْ بِخَيْرٍ وَعُمْرِيْ بِخَيْرٍ۔"
    },
    {
      "kind": "text",
      "ar": "أَحَطْتُ عَلٰي نَفْسِيْ وَأَهْلِيْ وَمَالِيْ وَوَلَدِيْ"
    },
    {
      "kind": "text",
      "ar": "مِنْ غَائِبٍ وَشَاهِدٍ بِاللّٰهِ الَّذِيْ لَا اِلٰهَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الرَّحْمٰنُ الرَّحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "الْحَيُّ الْقَيُّوْمُ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ..... تا آخر"
    }
  ]
}