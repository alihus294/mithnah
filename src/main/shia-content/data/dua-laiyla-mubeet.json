{
  "id": "dua-laiyla-mubeet",
  "title": "دعاء ليلة المبيت",
  "subtitle": "تعقيبات الصلاة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء ليلة المبيت",
      "subtitle": "تعقيبات الصلاة"
    },
    {
      "kind": "text",
      "ar": "أَصْبَحْتُ اَللّٰهُمَّ مُعْتَصِمًا بِذِمَامِكَ الْمَنِيْعِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَا يُطَاوَلُ وَلَا يُحَاوَلُ"
    },
    {
      "kind": "text",
      "ar": "مِنْ شَرِّ كُلِّ غَاشِمٍ وَطَارِقٍ"
    },
    {
      "kind": "text",
      "ar": "مِنْ سَائِرِ مَنْ خَلَقْتَ وَمَا خَلَقْتَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ خَلْقِكَ الصَّامِتِ وَالنَّاطِقِ"
    },
    {
      "kind": "text",
      "ar": "فِيْ جُنَّةٍ مِنْ كُلِّ مَخُوْفٍ"
    },
    {
      "kind": "text",
      "ar": "بِلِبَاسٍ سَابِغَةٍ وَلَاءِ أَهْلِ بَيْتِ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "مُحْتَجِبًا مِنْ كُلِّ قَاصِدٍ لِيْ اِلٰي أَذِيَّةٍ بِجِدَارٍ حَصِيْنِ الْاِخْلَاصِ"
    },
    {
      "kind": "text",
      "ar": "فِي الْاِعْتِرَافِ بِحَقِّهِمْ وَالتَّمَسُّكِ بِحَبْلِهِمْ"
    },
    {
      "kind": "text",
      "ar": "مُوْقِنًا أَنَّ الْحَقَّ لَهُمْ وَمَعَهُمْ وَفِيْهِمْ وَبِهِمْ"
    },
    {
      "kind": "text",
      "ar": "أُوَالِيْ مَنْ وَالَوْا، وَأُجَانِبُ مَنْ جَانَبُوْا"
    },
    {
      "kind": "text",
      "ar": "فَأَعِذْنِيْ اَللّٰهُمَّ بِهِمْ مِنْ شَرِّ كُلِّ مَا أَتَّقِيْهِ"
    },
    {
      "kind": "text",
      "ar": "يَا عَظِيْمُ حَجَزْتُ الْاَعَادِيَ عَنِّيْ بِبَدِيْعِ السَّمٰوَاتِ وَالْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّا جَعَلْنَا مِنْ بَيْنِ أَيْدِيْهِمْ سَدًّا وَمِنْ خَلْفِهِمْ سَدًّا"
    },
    {
      "kind": "text",
      "ar": "فَأَغْشَيْنَاهُمْ فَهُمْ لَا يُبْصِرُوْنَ"
    }
  ]
}