{
  "id": "wednesday-dua",
  "title": "بده كے دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "بده كے دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْم"
    },
    {
      "kind": "text",
      "ar": "اَلْحَمْدُ لِلّٰهِ الَّذِيْ جَعَلَ اللَّيْلَ لِبَاسًا"
    },
    {
      "kind": "text",
      "ar": "وَالنَّوْمَ سُبَاتًا، وَجَعَلَ النَّهَارَ نُشُوْرًا"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْحَمْدُ أَنْ بَعَثْتَنِيْ مِنْ مَرْقَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَوْ شِئْتَ جَعَلْتَهٗ سَرْمَدًا"
    },
    {
      "kind": "text",
      "ar": "حَمْدًا دَائِمًا لَا يَنْقَطِعُ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُحْصِيْ لَهُ الْخَلَائِقُ عَدَدًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَكَ الْحَمْدُ أَنْ خَلَقْتَ فَسَوَّيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدَّرْتَ وَقَضَيْتَ، وَأَمَتَّ وَأَحْيَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمْرَضْتَ وَشَفَيْتَ، وَعَافَيْتَ وَأَبْلَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْعَرْشِ اسْتَوَيْتَ، وَعَلَي الْمُلْكِ احْتَوَيْتَ"
    },
    {
      "kind": "text",
      "ar": "أَدْعُوْكَ دُعَاءَ مَنْ ضَعُفَتْ وَسِيْلَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَانْقَطَعَتْ حِيْلَتُهٗ، وَاقْتَرَبَ أَجَلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَتَدَانٰي فِي الدُّنْيَا أَمَلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاشْتَدَّتْ اِلٰي رَحْمَتِكَ فَاقَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَعَظُمَتْ لِتَفْرِيْطِهٖ حَسْرَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَكَثُرَتْ زَلَّتُهٗ وَعَثْرَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَخَلُصَتْ لِوَجْهِكَ تَوْبَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ خَاتَمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَهْلِ بَيْتِهِ الطَّيِّبِيْنَ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ شَفَاعَةَ مُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَحْرِمْنِيْ صُحْبَتَهٗ، اِنَّكَ أَنْتَ أَرْحَمُ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اقْضِ لِيْ فِي الْاَرْبَعَاءِ أَرْبَعًا"
    },
    {
      "kind": "text",
      "ar": "اجْعَلْ قُوَّتِيْ فِيْ طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَشَاطِيْ فِيْ عِبَادَتِك"
    },
    {
      "kind": "text",
      "ar": "وَرَغْبَتِيْ فِيْ ثَوَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَزُهْدِيْ فِيَمَا يُوْجِبُ لِيْ أَلِيْمَ عِقَابِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ لَطِيْفٌ لِمَا تَشَاءُ"
    }
  ]
}