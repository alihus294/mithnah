{
  "id": "salawat-imam-naqi",
  "title": "امام علي نقي پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام علي نقي پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي عَلِيِّ بْنِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَصِيِّ الْاَوْصِيَاءِ، وَاِمَامِ الْاَتْقِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَخَلَفِ أَئِمَّةِ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَالْحُجَّةِ عَلَي الْخَلَائِقِ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ كَمَا جَعَلْتَهٗ نُوْرًا يَسْتَضِيْءُ بِهِ الْمُؤْمِنُوْنَ"
    },
    {
      "kind": "text",
      "ar": "فَبَشَّرَ بِالْجَزِيْلِ مِنْ ثَوَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْذَرَ بِالْاَلِيْمِ مِنْ عِقَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَذَّرَ بَأْسَكَ، وَذَكَّرَ بِاٰيَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحَلَّ حَلَالَكَ، وَحَرَّمَ حَرَامَكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَيَّنَ شَرَايِعَكَ وَفَرَائِضَكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَضَّ عَلٰي عِبَادَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرَ بِطَاعَتِكَ، وَنَهٰي عَنْ مَعْصِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِ أَفْضَلَ مَا صَلَّيْتَ عَلٰي أَحَدٍ مِنْ أَوْلِيَائِكَ وَذُرِّيَّةِ أَنْبِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا اِلٰهَ الْعَالَمِيْنَ۔"
    }
  ]
}