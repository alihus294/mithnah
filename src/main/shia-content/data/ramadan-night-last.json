{
  "id": "ramadan-night-last",
  "title": "ماه رمضان كي آخري رات",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ماه رمضان كي آخري رات",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَسْتَغْفِرُ اللهَ وَاَتُوْبُ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ هٰذَا شَهْرُ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ أَنْزَلْتَ فِيْهِ الْقُرْاٰنَ ، وَقَدْ تَصَرَّمَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِوَجْهِكَ الْكَرِيْمِ يَا رَبِّ"
    },
    {
      "kind": "text",
      "ar": "أَنْ يَطْلُعَ الْفَجْرُ مِنْ لَيْلَتِيْ هٰذِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَوْ يَتَصَرَّمَ شَهْرُ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ قِبَلِيْ تَبِعَةٌ أَوْ ذَنْبٌ"
    },
    {
      "kind": "text",
      "ar": "تُرِيْدُ أَنْ تُعَذِّبَنِيْ بِهٖ يَوْمَ أَلْقَاكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَجْعَلْهُ اٰخِرَ الْعَهْدِ"
    },
    {
      "kind": "text",
      "ar": "من صِيَامِيْ لِشَهْرِ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ أَنْ يَطْلُعَ فَجْرُ هٰذِهِ اللَّيْلَةِ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا وَقَدْ غَفَرْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ وَالْحَمْدُ اللهِ وَلَا اِلٰهَ اِلَّا الله وَالله اَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ يَا قَيُّوْمُ، يَا ذَا الجَلَالِ وَالْاِكرَامِ"
    },
    {
      "kind": "text",
      "ar": "يَارَحْمَانَ الدُّنيَا وَالْاٰخِرَةِ وَرَحِيْمَهُمَا"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ، يَا اِلٰهَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اغْفِرْ لَنَا ذُنُوْبَنَا، وَتَقَبَّلْ مِنَّا صَلَاتَنَا وَصِيَامَنَا وَقِيَامَنَا۔"
    },
    {
      "kind": "text",
      "ar": "اغْفِرْ لِيْ ذُنُوْبِيْ، وتَقَبَّلْ صَوْمِيْ وَصَلَاتِيْ وَقِيَامِيْ"
    }
  ]
}