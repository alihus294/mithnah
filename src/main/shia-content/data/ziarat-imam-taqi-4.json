{
  "id": "ziarat-imam-taqi-4",
  "title": "امام محمد تقي كي ايك اور زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام محمد تقي كي ايك اور زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْبَابِ الْاَقْصَدِ"
    },
    {
      "kind": "text",
      "ar": "وَالطَّرِيْقِ الْاَرْشَدِ، وَالْعَالِمِ الْمُؤَيَّدِ"
    },
    {
      "kind": "text",
      "ar": "يَنْبُوْعِ الْحِكَمِ، وَمِصْبَاحِ الظُّلَمِ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدِ الْعَرَبِ وَالْعَجَمِ"
    },
    {
      "kind": "text",
      "ar": "الْهَادِيْ اِلَي الرَّشَادِ"
    },
    {
      "kind": "text",
      "ar": "أَلْمُوَفَّقِ بِالتَّأْئِيْدِ وَالسَّدَادِ"
    },
    {
      "kind": "text",
      "ar": "مَوْلَايَ أَبِيْ جَعْفَرٍ مُحَمَّدِ بْنِ عَلِيٍّ الْجَوَادِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ يَا وَلِيَّ الله أَنَّكَ أَقَمْتَ الصَّلَاةَ وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِيْ سَبِيْلِ الله حَقَّ جِهَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَبَدْتَ اللهَ مُخْلِصًا حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "فَعِشْتَ سَعِيْدًا، وَمَضَيْتَ شَهِيْدًا"
    },
    {
      "kind": "text",
      "ar": "يَا لَيْتَنِيْ كُنْتُ مَعَكُمْ فَأَفُوْزَ فَوْزًا عَظِيْمًا"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ الله وَبَرَكَاتُهٗ۔"
    }
  ]
}