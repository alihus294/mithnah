{
  "id": "taqibat-dua-alwiya",
  "title": "صحيفۂ علويه سے دعا",
  "subtitle": "تعقيبات الصلاة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "صحيفۂ علويه سے دعا",
      "subtitle": "تعقيبات الصلاة"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يَشْغَلُهٗ سَمْعٌ عَنْ سَمْعٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مَنْ لَا يُغَلِّطُهُ السَّائِلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مَنْ لَا يُبْرِمُهٗ اِلْحَاحُ الْمُلِحِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَذِقْنِيْ بَرْدَ عَفْوِكَ وَحَلَاوَةَ رَحْمَتِكَ وَمَغْفِرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ هٰذِهٖ صَلَاتِيْ صَلَّيْتُهَا"
    },
    {
      "kind": "text",
      "ar": "لَا لِحَاجَةٍ مِنْكَ اِلَيْهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا رَغْبَةٍ مِنْكَ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "اِلَّا تَعْظِيْمًا وَطَاعَةً"
    },
    {
      "kind": "text",
      "ar": "وَاِجَابَةً لَكَ اِلٰي مَا أَمَرْتَنِيْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِنْ كَانَ فِيْهَا خَلَلٌ أَوْ نَقْصٌ"
    },
    {
      "kind": "text",
      "ar": "مِنْ رُكُوْعِهَا أَوْ سُجُوْدِهَا، فَلَا تُؤَاخِذْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَفَضَّلْ عَلَيَّ بِالْقَبُوْلِ وَالْغُفْرَانِ"
    }
  ]
}