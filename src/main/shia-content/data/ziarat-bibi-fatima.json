{
  "id": "ziarat-bibi-fatima",
  "title": "كيفيت زيارت حضرت فاطمة الزهرا",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "كيفيت زيارت حضرت فاطمة الزهرا",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "يَا مُمْتَحَنَةُ امْتَحَنَكِ اللهُ الَّذِيْ خَلَقَكِ قَبْلَ أَنْ يَخْلُقَكِ"
    },
    {
      "kind": "text",
      "ar": "فَوَجَدَكِ لِمَا امْتَحَنَكِ صَابِرَةً"
    },
    {
      "kind": "text",
      "ar": "وَزَعَمْنَا أَنَّا لَكِ أَوْلِيَاءٌ وَمُصَدِّقُوْنَ وَصَابِرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "لِكُلِّ مَا أَتَانَا بِهٖ أَبُوْكِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَأَتٰي بِهٖ وَصِيُّهٗ"
    },
    {
      "kind": "text",
      "ar": "فَاِنّا نَسْأَلُكِ اِنْ كُنَّا صَدَّقْنَاكِ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا أَلْحَقْتِنَا بِتَصْدِيْقِنَا لَهُمَا"
    },
    {
      "kind": "text",
      "ar": "لِنُبَشِّرَ أَنْفُسَنَا بِأَنَّا قَدْ طَهُرْنَا بِوِلَايَتِكِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا بِنْتَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا بِنْتَ نَبِيِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا بِنْتَ حَبِيْبِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا بِنْتَ خَلِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا بِنْتَ صَفِيِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا بِنْتَ أَمِيْنِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا بِنْتَ خَيْرِ خَلْقِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا بِنْتَ أَفْضَلِ أَنْبِيَاءِ اللهِ وَرُسُلِهٖ وَمَلَائِكَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا بِنْتَ خَيْرِ الْبَرِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا سَيِّدَةَ نِسَاءِ الْعَالَمِيْنَ مِنَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا زَوْجَةَ وَلِيِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَخَيْرِ الْخَلْقِ بَعْدَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا أُمَّ الْحَسَنِ وَالْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدَيْ شَبَابِ أَهْلِ الْجَنَّةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الصِّدِّيْقَةُ الشَّهِيْدَةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الرَّضِيَّةُ الْمَرْضِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الْفَاضِلَةُ الزَّكِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الْحَوْرَاءُ الْاِنْسِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا التَّقِيَّةُ النَّقِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الْمُحَدَّثَةُ الْعَلِيْمَةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الْمَظْلُوْمَةُ الْمَغْصُوْبَةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الْمُضْطَهَدَةُ الْمَقْهُوْرَةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا فَاطِمَةُ بِنْتَ رَسُوْلِ اللهِ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْكِ وَعَلٰي رُوْحِكِ وَبَدَنِكِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكِ مَضَيْتِ عَلٰي بَيِّنَةٍ مِنْ رَبِّكِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مَنْ سَرَّكِ فَقَدْ سَرَّ رَسُوْلَ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ جَفَاكِ فَقَدْ جَفَا رَسُوْلَ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ اٰذَاكِ فَقَدْ اٰذٰي رَسُوْلَ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ وَصَلَكِ فَقَدْ وَصَلَ رَسُوْلَ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ قَطَعَكِ فَقَدْ قَطَعَ رَسُوْلَ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "لِاَنَّكِ بِضْعَةٌ مِنْهُ وَرُوْحُهُ الَّذِيْ بَيْنَ جَنْبَيْهِ"
    },
    {
      "kind": "text",
      "ar": "أُشْهِدُ اللهَ وَرُسُلَهٗ وَمَلَائِكَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَنِّيْ رَاضٍ عَمَّنْ رَضِيْتِ عَنْهُ"
    },
    {
      "kind": "text",
      "ar": "سَاخِطٌ عَلٰي مَنْ سَخِطْتِ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "مَتَبَرِّئٌ مِمَّنْ تَبَرَّأْتِ مِنْهُ"
    },
    {
      "kind": "text",
      "ar": "مُوَالٍ لِمَنْ وَالَيْتِ، مُعَادٍ لِمَنْ عَادَيْتِ"
    },
    {
      "kind": "text",
      "ar": "مُبْغِضٌ لِمَنْ أَبْغَضْتِ، مُحِبٌّ لِمَنْ أَحْبَبْتِ"
    },
    {
      "kind": "text",
      "ar": "وَكَفٰي بِاللّٰهِ شَهِيْدًا وَحَسِيْبًا وَجَازِيًا وَمُثِيْبًا۔"
    },
    {
      "kind": "text",
      "ar": "أُشْهِدُ اللهَ وَمَلَائِكَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَنِّيْ وَلِيٌّ لِمَنْ وَالَاكِ"
    },
    {
      "kind": "text",
      "ar": "وَعَدُوٌّ لِمَنْ عَادَاكِ"
    },
    {
      "kind": "text",
      "ar": "وَحَرْبٌ لِمَنْ حَارَبَكِ"
    },
    {
      "kind": "text",
      "ar": "أَنَا يَا مَوْلَاتِيْ بِكِ وَبِأَبِيْكِ وَبَعْلِكِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَئِمَّةِ مِنْ وُلْدِكِ مُوْقِنٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِوِلَايَتِهِمْ مُؤْمِنٌ، وَلِطَاعَتِهِمْ مُلْتَزِمٌ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّ الدِّيْنَ دِيْنُهُمْ وَالْحُكْمَ حُكْمُهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَهُمْ قَدْ بَلَّغُوْا عَنِ اللهِ عَزَّ وَجَلَّ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَوْا اِلٰي سَبِيْلِ اللهِ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ"
    },
    {
      "kind": "text",
      "ar": "لَا تَأْخُذُهُمْ فِي اللهِ لَوْمَةُ لَائِمٍ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَوَاتُ اللهِ عَلَيْكِ وَعَلٰي أَبِيْكِ"
    },
    {
      "kind": "text",
      "ar": "وَبَعْلِكِ وَذُرِّيَّتِكِ الْاَئِمَّةِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلَي الْبَتُوْلِ الطَّاهِرَةِ الصِّدِّيْقَةِ"
    },
    {
      "kind": "text",
      "ar": "الْمَعْصُوْمَةِ التَّقِيَّةِ النَّقِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "الرَّضِيَّةِ الْمَرْضِيَّةِ الزَّكِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "الرَّشِيْدَةِ الْمَظْلُوْمَةِ الْمَقْهُوْرَةِ"
    },
    {
      "kind": "text",
      "ar": "الْمَغْصُوْبَةِ حَقُّهَا، الْمَمْنُوْعَةِ اِرْثُهَا"
    },
    {
      "kind": "text",
      "ar": "الْمَكْسُوْرَةِ ضِلْعُهَا"
    },
    {
      "kind": "text",
      "ar": "الْمَظْلُوْمِ بَعْلُهَا، الْمَقْتُوْلِ وَلَدُهَا"
    },
    {
      "kind": "text",
      "ar": "فَاطِمَةَ بِنْتِ رَسُوْلِكَ وَبَضْعَةِ لَحْمِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَمِيْمِ قَلْبِهٖ، وَفِلْذَةِ كَبِدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالنُّخْبَةِ مِنْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَالتُّحْفَةِ خَصَصْتَ بِهَا وَصِيَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَحَبِيْبَةِ الْمُصْطَفٰي وَقَرِيْنَةِ الْمُرْتَضٰي"
    },
    {
      "kind": "text",
      "ar": "وَسَيِّدَةِ النِّسَاءِ وَمُبَشِّرَةِ الْاَوْلِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "حَلِيْفَةِ الْوَرَعِ وَالزُّهْدِ"
    },
    {
