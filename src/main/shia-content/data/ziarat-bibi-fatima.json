    {
      "kind": "text",
      "ar": "وَأَرْخَيْتَ دُوْنَهَا حِجَابَ النُّبُوَّةِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَيْهَا صَلَاةً تَزِيْدُ فِيْ مَحَلِّهَا عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "وَشَرَفِهَا لَدَيْكَ، وَمَنْزِلَتِهَا مِنْ رِضَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْهَا مِنَّا تَحِيَّةً وَسَلَامًا"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا مِنْ لَدُنْكَ فِيْ حُبِّهَا فَضْلًا وَاِحْسَانًا"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةً وَغُفْرَانًا، اِنَّكَ ذُو الْعَفْوِ الْكَرِيْمِ۔"
    }
  ]
}