{
  "id": "haram-najaf-after-namaz",
  "title": "حرم امير المومنين ميں هر نماز كے بعد كي دعا",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "حرم امير المومنين ميں هر نماز كے بعد كي دعا",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا بُدَّ مِنْ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بُدَّ مِنْ قَدَرِكَ، وَلَا بُدَّ مِنْ قَضَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَمَا قَضَيْتَ عَلَيْنَا مِنْ قَضَاءٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْ قَدَّرْتَ عَلَيْنَا مِنْ قَدَرٍ"
    },
    {
      "kind": "text",
      "ar": "فَأَعْطِنَا مَعَهٗ صَبْرًا يَقْهَرُهٗ وَيَدْمَغُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ لَنَا صَاعِدًا فِيْ رِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "يُنْمِيْ فِيْ حَسَنَاتِنَا وَتَفْضِيْلِنَا"
    },
    {
      "kind": "text",
      "ar": "وَسُؤْدَدِنَا وَشَرَفِنَا وَمَجْدِنَا"
    },
    {
      "kind": "text",
      "ar": "وَنَعْمَائِنَا وَكَرَامَتِنَا فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَنْقُصْ مِنْ حَسَنَاتِنَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَمَا أَعْطَيْتَنَا مِنْ عَطَاءٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْ فَضَّلْتَنَا بِهٖ مِنْ فَضِيْلَةٍ، أَوْ أَكْرَمْتَنَا بِهٖ مِنْ كَرَامَةٍ"
    },
    {
      "kind": "text",
      "ar": "فَأَعْطِنَا مَعَهٗ شُكْرًا يَقْهَرُهٗ وَيَدْمَغُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ لَنَا صَاعِدًا فِيْ رِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ حَسَنَاتِنَا وَسُؤْدَدِنَا وَشَرَفِنَا"
    },
    {
      "kind": "text",
      "ar": "وَنَعْمَائِنَا وَكَرَامَتِنَا فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْهُ لَنَا أَشَرًا وَلَا بَطَرًا  وَلَا فِتْنَةً"
    },
    {
      "kind": "text",
      "ar": "وَلَا مَقْتًا وَلَا عَذَابًا وَلَا خِزْيًا فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نَعُوْذُ بِكَ مِنْ عَثْرَةِ اللِّسَانِ"
    },
    {
      "kind": "text",
      "ar": "وَسُوْءِ الْمَقَامِ، وَخِفَّةِ الْمِيْزَانِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَقِّنَا حَسَنَاتِنَا فِي الْمَمَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُرِنَا أَعْمَالَنَا حَسَرَاتٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخْزِنَا عِنْدَ قَضَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَفْضَحْنَا بِسَيِّئَاتِنَا يَوْمَ نَلْقَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ قُلُوْبَنَا تَذْكُرُكَ وَلَا تَنْسَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَخْشَاكَ كَأَنَّهَا تَرَاكَ حَتّٰي تَلْقَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَبَدِّلْ سَيِّئَاتِنَا حَسَنَاتٍ، وَاجْعَلْ حَسَنَاتِنَا دَرَجَاتٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ دَرَجَاتِنَا غُرُفَاتٍ، وَاجْعَلْ غُرُفَاتِنَا عَالِيَاتٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَوْسِعْ لِفَقِيْرِنَا مِنْ سَعَةِ"
    },
    {
      "kind": "text",
      "ar": "مَا قَضَيْتَ عَلٰي نَفْسِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَمُنَّ عَلَيْنَا بِالْهُدٰي مَا أَبْقيْتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَالْكَرَامَةِ مَا أَحْيَيْتَنَا، وَالْكَرَامَةِ اِذَا تَوَفَّيْتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَالْحِفْظِ فِيْمَا بَقِيَ مِنْ عُمْرِنَا"
    },
    {
      "kind": "text",
      "ar": "وَالْبَرَكَةِ فِيْمَا رَزَقْتَنَا، وَالْعَوْنِ عَلٰي مَا حَمَّلْتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَالثَّبَاتِ عَلٰي مَا طَوَّقْتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُؤَاخِذْنَا بِظُلْمِنَا، وَلَا تُقَايِسْنَا بِجَهْلِنَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَسْتَدْرِجْنَا بِخَطَايَانَا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ أَحْسَنَ مَا نَقُوْلُ ثَابِتًا فِيْ قُلُوْبِنَا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا عُظَمَاءَ عِنْدَكَ، وَأَذِلَّةً فِيْ أَنْفُسِنَا"
    },
    {
      "kind": "text",
      "ar": "وَانْفَعْنَا بِمَا عَلَّمْتَنَا، وَزِدْنَا عِلْمًا نَافِعًا"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ مِنْ قَلْبٍ لَا يَخْشَعُ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ عَيْنٍ لَا تَدْمَعُ، وَمِنْ صَلَاةٍ لَا تُقْبَلُ"
    },
    {
      "kind": "text",
      "ar": "أَجِرْنَا مِنْ سُوْءِ الْفِتَنِ"
    },
    {
      "kind": "text",
      "ar": "يَا وَلِيَّ الدُّنْيَا وَالْاٰخِرَةِ۔"
    },
    {
      "kind": "text",
      "ar": "يَا اَللّٰهُ يَا اَللّٰهُ يَا اَللّٰهُ يَا مُجِيْبَ دَعْوَةِ الْمُضْطَرِّيْنَ .... الخ"
    }
  ]
}