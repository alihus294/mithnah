{
  "id": "ramadan-day19-dua",
  "title": "انيسويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "انيسويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَفِّرْ فِيْهِ حَظِّيْ مِنْ بَرَكَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَهِّلْ سَبِيْلِيْ اِلٰي خَيْرَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَحْرِمْنِيْ قَبُوْلَ حَسَنَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا هَادِيًا اِلَي الْحَقِّ الْمُبِيْنِ۔"
    }
  ]
}