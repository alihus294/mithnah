{
  "id": "sura-aala",
  "title": "سورۂ اعليٰ",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ اعليٰ",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "سَبِّحِ اسْمَ رَبِّكَ الْاَعْلَىۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ خَلَقَ فَسَوّٰى۪ۙ۝۲"
    },
    {
      "kind": "text",
      "ar": "وَالَّذِيْ قَدَّرَ فَهَدٰى۪ۙ۝۳"
    },
    {
      "kind": "text",
      "ar": "وَالَّذِيْۤ اَخْرَجَ الْمَرْعٰى۪ۙ۝۴"
    },
    {
      "kind": "text",
      "ar": "فَجَعَلَهٗ غُثَآءً اَحْوٰىؕ۝۵"
    },
    {
      "kind": "text",
      "ar": "سَنُقْرِئُكَ فَلَا تَنْسٰۤىۙ۝۶"
    },
    {
      "kind": "text",
      "ar": "اِلَّا مَا شَآءَ اللّٰهُ١ؕ اِنَّهٗ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰىؕ۝۷"
    },
    {
      "kind": "text",
      "ar": "وَنُيَسِّرُكَ لِلْيُسْرٰىۚۖ۝۸"
    },
    {
      "kind": "text",
      "ar": "فَذَكِّرْ اِنْ نَّفَعَتِ الذِّكْرٰىؕ۝۹"
    },
    {
      "kind": "text",
      "ar": "سَيَذَّكَّرُ مَنْ يَّخْشٰىۙ۝۱۰"
    },
    {
      "kind": "text",
      "ar": "وَيَتَجَنَّبُهَا الْاَشْقَىۙ۝۱۱"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ يَصْلَى النَّارَ الْكُبْرٰىۚ۝۱۲"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ لَا يَمُوْتُ فِيْهَا وَلَا يَحْيٰىؕ۝۱۳"
    },
    {
      "kind": "text",
      "ar": "قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ۝۱۴"
    },
    {
      "kind": "text",
      "ar": "وَذَكَرَ اسْمَ رَبِّهٖ فَصَلّٰىؕ۝۱۵"
    },
    {
      "kind": "text",
      "ar": "بَلْ تُؤْثِرُوْنَ الْحَيٰوةَ الدُّنْيَا٘ۖ۝۱۶"
    },
    {
      "kind": "text",
      "ar": "وَالْاٰخِرَةُ خَيْرٌ وَّاَبْقٰىؕ۝۱۷"
    },
    {
      "kind": "text",
      "ar": "اِنَّ هٰذَا لَفِي الصُّحُفِ الْاُوْلٰىۙ۝۱۸"
    },
    {
      "kind": "text",
      "ar": "صُحُفِ اِبْرٰهِيْمَ وَمُوْسٰى۠۝۱۹"
    }
  ]
}