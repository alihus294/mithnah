{
  "id": "ziarat-najaf-wida",
  "title": "ذكر وداع اميرالمؤمنين",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ذكر وداع اميرالمؤمنين",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْدِعُكَ اللهَ وَأَسْتَرْعِيْكَ وَأَقْرَأُ عَلَيْكَ السَّلَامَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنّا بِاللّٰهِ وَبِالرُّسُلِ وَبِمَا جَائَتْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَتْ اِلَيْهِ، وَدَلَّتْ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "فَاكْتُبْنَا مَعَ الشَّاهِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَجْعَلْهُ اٰخِرَ الْعَهْدِ مِنْ زِيَارَتِيْ اِيَّاهُ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ تَوَفَّيْتَنِيْ قَبْلَ ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ أَشْهَدُ فِيْ مَمَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي مَا شَهِدْتُ عَلَيْهِ فِيْ حَيَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّ أَمِيْرَ الْمُؤْمِنِيْنَ عَلِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنَ وَالْحُسَيْنَ وَعَلِيَّ بْنَ الْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَمُحَمَّدَ بْنَ عَلِيٍّ وَجَعْفَرَ بْنَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَمُوْسَي بْنَ جَعْفَرٍ وَعَلِيَّ بْنَ مُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "وَمُحَمَّدَ بْنَ عَلِيٍّ وَعَلِيَّ بْنَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنَ بْنَ عَلِيٍّ، وَالْحُجَّةَ بنَ الْحَسَنِ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُكَ عَلَيْهِمْ أَجْمَعِيْنَ أَئِمَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ مَنْ قَتَلَهُمْ وَحَارَبَهُمْ مُشْرِكُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ رَدَّ عَلَيْهِمْ فِيْ أَسْفَلِ دَرَكٍ مِنَ الْجَحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ مَنْ حَارَبَهُمْ"
    },
    {
      "kind": "text",
      "ar": "لَنَا أَعْدَاءٌ وَنَحْنُ مِنْهُمْ بُرَاءُ وَأَنَّهُمْ حِزْبُ الشَّيْطَانِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَنْ قَتَلَهُمْ لَعْنَةُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ شَرِكَ فِيْهِمْ وَمَنْ سَرَّهُ قَتْلُهُمْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بَعْدَ الصَّلَاةِ وَالتَّسْلِيْمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَعَلِيٍّ وَفَاطِمَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنِ وَالْحُسَيْنِ وَعَلِيٍّ وَمُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَجَعْفَرٍ وَمُوْسٰي وَعَلِيٍّ وَمُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيٍّ وَالْحَسَنِ وَالْحُجَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْهُ اٰخِرَ الْعَهْدِ مِنْ زِيَارَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ جَعَلْتَهٗ فَاحْشُرْنِيْ مَعَ هٰؤُلَاءِ الْمُسَمَّيْنَ الْاَئِمَّةِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَذَلِّلْ قُلُوْبَنَا لَهُمْ بِالطَّاعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُنَاصَحَةِ وَالْمَحَبَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَحُسْنِ الْمُؤَازَرَةِ وَالتَّسْلِيْمِ۔"
    }
  ]
}