  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ رحمٰن",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "لَا بِشَيْءٍ مِنْ اٰلَائِكَ رَبِّ اُكَذِّبُ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَلرَّحْمٰنُۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "عَلَّمَ الْقُرْاٰنَؕ۝۲"
    },
    {
      "kind": "text",
      "ar": "خَلَقَ الْاِنْسَانَۙ۝۳"
    },
    {
      "kind": "text",
      "ar": "عَلَّمَهُ الْبَيَانَ۝۴"
    },
    {
      "kind": "text",
      "ar": "اَلشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍ۪۝۵"
    },
    {
      "kind": "text",
      "ar": "وَّالنَّجْمُ وَالشَّجَرُ يَسْجُدٰنِ۝۶"
    },
    {
      "kind": "text",
      "ar": "وَالسَّمَآءَ رَفَعَهَا وَوَضَعَ الْمِيْزَانَۙ۝۷"
    },
    {
      "kind": "text",
      "ar": "اَلَّا تَطْغَوْا فِي الْمِيْزَانِ۝۸"
    },
    {
      "kind": "text",
      "ar": "وَاَقِيْمُوا الْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُوا الْمِيْزَانَ۝۹"
    },
    {
      "kind": "text",
      "ar": "وَالْاَرْضَ وَضَعَهَا لِلْاَنَامِۙ۝۱۰"
    },
    {
      "kind": "text",
      "ar": "فِيْهَا فَاكِهَةٌ١۪ۙ وَّالنَّخْلُ ذَاتُ الْاَكْمَامِۖ۝۱۱"
    },
    {
      "kind": "text",
      "ar": "وَالْحَبُّ ذُو الْعَصْفِ وَالرَّيْحَانُۚ۝۱۲"
    },
    {
      "kind": "text",
      "ar": "فَبِاَيِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ۝۱۳"
    },
    {
      "kind": "text",
      "ar": "خَلَقَ الْاِنْسَانَ مِنْ صَلْصَالٍ كَالْفَخَّارِۙ۝۱۴"
    },
    {
      "kind": "text",
      "ar": "وَخَلَقَ الْجَآنَّ مِنْ مَّارِجٍ مِّنْ نَّارٍۚ۝۱۵"
    },
    {
      "kind": "text",
      "ar": "فَبِاَيِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ۝۱۶"
    },
    {
      "kind": "text",
      "ar": "رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِۚ۝۱۷"
    },
    {
      "kind": "text",
      "ar": "فَبِاَيِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ۝۱۸"
    },
    {
      "kind": "text",
      "ar": "مَرَجَ الْبَحْرَيْنِ يَلْتَقِيٰنِۙ۝۱۹"
    },
    {
      "kind": "text",
      "ar": "بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيٰنِۚ۝۲۰"
    },
    {
      "kind": "text",
      "ar": "فَبِاَيِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ۝۲۱"
    },
    {
      "kind": "text",
      "ar": "يَخْرُجُ مِنْهُمَا اللُّؤْلُؤُ وَالْمَرْجَانُۚ۝۲۲"
    },
    {
      "kind": "text",
      "ar": "فَبِاَيِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ۝۲۳"
    },
    {
      "kind": "text",
      "ar": "وَلَهُ الْجَوَارِ الْمُنْشَـٰٔتُ فِي الْبَحْرِ كَالْاَعْلَامِۚ۝۲۴"
    },
    {
      "kind": "text",
      "ar": "فَبِاَيِّ اٰلَآءِ رَبِّكُمَا تُكَذِّبٰنِ۠۝۲۵"
    },
    {
      "kind": "text",
