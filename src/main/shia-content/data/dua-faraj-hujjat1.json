{
  "id": "dua-faraj-hujjat1",
  "title": "دعاء فرج۔ الٰهي عظم البلاء",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء فرج۔ الٰهي عظم البلاء",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ عَظُمَ الْبَلَاءُ، وَبَرِحَ الْخَفَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَانْكَشَفَ الْغِطَاءُ، وَانْقَطَعَ الرَّجَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَضَاقَتِ الْاَرْضُ وَمُنِعَتِ السَّمَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُسْتَعَانُ، وَاِلَيْكَ الْمُشْتَكٰي"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ الْمُعَوَّلُ فِي الشِّدَّةِ وَالرَّخَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "أُولِي الْأَمْرِ الَّذِيْنَ فَرَضْتَ عَلَيْنَا طَاعَتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَعَرَّفْتَنَا بِذٰلِكَ مَنْزِلَتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "فَفَرِّجْ عَنّا بِحَقِّهِمْ، فَرَجًا عَاجِلًا قَرِيْبًا"
    },
    {
      "kind": "text",
      "ar": "كَلَمْحِ الْبَصَرِ أَوْ هُوَ أَقْرَبُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحَمَّدُ يَا عَلِيُّ يَا عَلِيُّ يَا مُحَمَّدُ"
    },
    {
      "kind": "text",
      "ar": "اِكْفِيَانِيْ فَاِنَّكُمَا كَافِيَانِ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرَانِيْ فَاِنَّكُمَا نَاصِرَانِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَانَا يَا صَاحِبَ الزَّمَانِ"
    },
    {
      "kind": "text",
      "ar": "الْغَوْثَ الْغَوْثَ الْغَوْثَ"
    },
    {
      "kind": "text",
      "ar": "أَدْرِكْنِيْ أَدْرِكْنِيْ أَدْرِكْنِيْ"
    },
    {
      "kind": "text",
      "ar": "السَّاعَةَ السَّاعَةَ السّاعَةَ"
    },
    {
      "kind": "text",
      "ar": "الْعَجَلَ الْعَجَلَ الْعَجَلَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "بِحَقِّ مُحَمَّدٍ وَاٰلِهِ الطَّاهِرِيْنَ"
    }
  ]
}