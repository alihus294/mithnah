{
  "id": "ziarat-imam-ali-4",
  "title": "چوتهي زيارت مطلقه",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "چوتهي زيارت مطلقه",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَبِي الْاَئِمَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَخَلِيْلِ النُّبُوَّةِ وَالْمَخْصُوْصِ بِالْأُخُوَّةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي يَعْسُوْبِ الْأِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَمِيْزَانِ الْأَعْمَالِ وَسَيْفِ ذِي الْجَلَالِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَالِحِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَوَارِثِ عِلْمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْحَاكِمِ فِيْ يَوْمِ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي شَجَرَةِ التَّقْوٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي حُجَّةِ اللهِ الْبَالِغَةِ"
    },
    {
      "kind": "text",
      "ar": "وَنِعْمَتِهِ السَّابِغَةِ وَنِقْمَتِهِ الدَّامِغَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الصِّرَاطِ الْوَاضِحِ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّجْمِ اللَّائِحِ وَالْاِمَامِ النَّاصِحِ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ وَسِيْلَتِيْ اِلَي اللهِ وَذَرِيْعَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلِيْ حَقُّ مُوَالَاتِيْ وَتَأْمِيْلِيْ"
    },
    {
      "kind": "text",
      "ar": "فَكُنْ شَفِيْعِيْ اِلَي اللهِ عَزَّوَجَلَّ فِي الْوُقُوْفِ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي قَضَاءِ حَاجَتِيْ وَهِيَ فَكَاكُ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَاصْرِفْنِيْ فِيْ مَوْقِفِيْ هٰذَا بِالنُّجْحِ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَا سَأَلْتُهٗ كُلَّهٗ بِرَحْمَتِهٖ وَقُدْرَتِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنِيْ عَقْلًا كَامِلًا، وَلُبًّا رَاجِحًا"
    },
    {
      "kind": "text",
      "ar": "وَقَلْبًا زَكِيًّا، وَعَمَلًا كَثِيْرًا، وَأَدَبًا بَارِعًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ ذٰلِكَ كُلَّهٗ لِيْ، وَلَا تَجْعَلْهُ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}