    {
      "kind": "text",
      "ar": "أَنْ تَكْتُبَنِيْ مِنْ حُجَّاجِ بَيْتِكَ الْحَرَامِ"
    },
    {
      "kind": "text",
      "ar": "الْمَبْرُوْرِ حَجُّهُمُ الْمَشْكُوْرِ سَعْيُهُمُ"
    },
    {
      "kind": "text",
      "ar": "الْمَغْفُوْرِ ذُنُوْبُهُمُ الْمُكَفَّرِ عَنْهُمْ سَيِّئَاتُهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ فِيْمَا تَقْضِيْ وَتُقَدِّرُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُطِيْلَ عُمْرِيْ، وَتُوَسِّعَ رِزْقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُؤَدِّيَ عَنِّيْ أَمَانَتِيْ وَدَيْنِيْ، اٰمِيْنَ رَبَّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ لِيْ مِنْ أَمْرِيَ فَرَجًا وَمَخْرَجًا"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ مِنْ حَيْثُ أَحْتَسِبُ وَمِنْ حَيْثُ لَا أَحْتَسِبُ"
    },
    {
      "kind": "text",
      "ar": "وَاحْرُسْنِيْ مِنْ حَيْثُ أَحْتَرِسُ وَمِنْ حَيْثُ لَا أَحْتَرِسُ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ وَسَلِّمْ كَثِيْرًا۔"
    }
  ]
}