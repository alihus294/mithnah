{
  "id": "namaz-imam-ali",
  "title": "نماز حضرت اميرالمؤمنين",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز حضرت اميرالمؤمنين",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا تَبِيْدُ مَعَالِمُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا تَنْقُصُ خَزَائِنُهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا اضْمِحْلَالَ لِفَخْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا يَنْفَدُ مَا عِنْدَهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا انْقِطَاعَ لِمُدَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا يُشَارِكُ أَحَدًا فِيْ أَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا اِلٰهَ غَيْرُهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ عَفَا عَنِ السَّيِّئَاتِ وَلَمْ يُجَازِ بِهَا"
    },
    {
      "kind": "text",
      "ar": "ارْحَمْ عَبْدَكَ يَا اَللّٰهُ، نَفْسِيْ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "أَنَا عَبْدُكَ يَا سَيِّدَاه، أَنَا عَبْدُكَ بَيْنَ يَدَيْكَ يَا رَبَّاهُ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ بِكَيْنُوْنَتِكَ يَا أَمَلَاهُ يَا رَحْمَانَاهُ يَا غِيَاثَاهُ"
    },
    {
      "kind": "text",
      "ar": "عَبْدُكَ عَبْدُكَ، لَا حِيْلَةَ لَهٗ يَا مُنْتَهٰي رَغْبَتَاهُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُجْرِيَ الدَّمِ فِيْ عُرُوْقِ"
    },
    {
      "kind": "text",
      "ar": "يَا سَيِّدَاهُ يَا مَالِكَاهُ أَيَا هُوَ أَيَا هُوَ يَا رَبَّاهُ"
    },
    {
      "kind": "text",
      "ar": "عَبْدُكَ عَبْدُكَ، لَا حِيْلَةَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا غِنًى بِيْ عَنْ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَسْتَطِيْعُ لَهَا ضَرًّا وَلَا نَفْعًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَجِدُ مَنْ أُصَانِعُهٗ"
    },
    {
      "kind": "text",
      "ar": "تَقَطَّعَتْ أَسْبَابُ الْخَدَائِعِ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَاضْمَحَلَّ كُلُّ مَظْنُوْنٍ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "أَفْرَدَنِي الدَّهْرُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَقُمْتُ بَيْنَ يَدَيْكَ هٰذَا الْمَقَامَ"
    },
    {
      "kind": "text",
      "ar": "يَا اِلٰهِيْ بِعِلْمِكَ كَانَ هٰذَا كُلُّهٗ"
    },
    {
      "kind": "text",
      "ar": "فَكَيْفَ أَنْتَ صَانِعٌ بِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَيْتَ شِعْرِيْ كَيْفَ تَقُوْلُ لِدُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "أَتَقُوْلُ نَعَمْ أَمْ تَقُوْلُ لَا"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ قُلْتَ لَا فَيَا وَيْلِيْ يَا وَيْلِيْ يَا وَيْلِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا عَوْلِيْ يَا عَوْلِيْ يَا عَوْلِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا شِقْوَتِيْ يَا شِقْوَتِيْ يَا شِقْوَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا ذُلِّيْ يَا ذُلِّيْ يَا ذُلِّيْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰي مَنْ وَمِمَّنْ أَوْ عِنْدَ مَنْ أَوْ كَيْفَ"
    },
    {
      "kind": "text",
      "ar": "أَوْ مَاذَا أَوْ اِلٰي أَيِّ شَيْءٍ أَلْجَأُ وَمَنْ أَرْجُوْ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ يَجُوْدُ عَلَيَّ بِفَضْلِهٖ حِيْنَ تَرْفُضُنِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا وَاسِعَ الْمَغْفِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ قُلْتَ نَعَمْ، كَمَا هُوَ الظَّنُّ بِكَ وَالرَّجَاءُ لَكَ"
    },
    {
      "kind": "text",
      "ar": "فَطُوْبٰي لِيْ أَنَا السَّعِيْدُ وَأَنَا الْمَسْعُوْدُ"
    },
    {
      "kind": "text",
      "ar": "فَطُوْبٰي لِيْ وَأَنَا الْمَرْحُوْمُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُتَرَحِّمُ يَا مُتَرَئِّفُ يَا مُتَعَطِّفُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُتَجَبِّرُ يَا مُتَمَلِّكُ يَا مُقْسِطُ"
    },
    {
      "kind": "text",
      "ar": "لَا عَمَلَ لِيْ أَبْلُغُ بِهٖ نَجَاحَ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِاسْمِكَ الَّذِيْ جَعَلْتَهٗ فِيْ مَكْنُوْنِ غَيْبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَقَرَّ عِنْدَكَ فَلَا يَخْرُجُ مِنْكَ اِلٰي شَيْءٍ سِوَاكَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِهٖ وَبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِهٖ فَاِنَّهٗ أَجَلُّ وَأَشْرَفُ أَسْمَائِكَ"
    },
    {
      "kind": "text",
      "ar": "لَا شَيْءَ لِيْ غَيْرُ هٰذَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَحَدَ أَعْوَدُ عَلَيَّ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "يَا كَيْنُوْنُ يَا مُكَوِّنُ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ عَرَّفَنِيْ نَفْسَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ أَمَرَنِيْ بِطَاعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ نَهَانِيْ عَنْ مَعْصِيَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مَدْعُوُّ يَا مَسْؤُوْلُ، يَا مَطْلُوْبًا اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "رَفَضْتُ وَصِيَّتَكَ الَّتِيْ أَوْصَيْتَنِيْ، وَلَمْ أُطِعْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَوْ أَطَعْتُكَ فِيَمَا أَمَرْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "لَكَفَيْتَنِيْ مَا قُمْتُ اِلَيْكَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا مَعَ مَعْصِيَتِيْ لَكَ رَاجٍ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَحُلْ بَيْنِيْ وَبَيْنَ مَا رَجَوْتُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُتَرَحِّمًا لِيْ، أَعِذْنِيْ مِنْ بَيْنِ يَدَيَّ وَمِنْ خَلْفِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ فَوْقِيْ وَمِنْ تَحْتِيْ، وَمِنْ كُلِّ جِهَاتِ الْاِحَاطَةِ بِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِمُحَمَّدٍ سَيِّدِيْ، وَبِعَلِيٍّ وَلِيِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَبِالْاَئِمَّةِ الرَّاشِدِيْنَ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "اجْعَلْ عَلَيْنَا صَلَاتَكَ وَرَأْفَتَكَ وَرَحْمَتَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْسِعْ عَلَيْنَا مِنْ رِزْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاقْضِ عَنَّا الدَّيْنَم وَجَمِيْعَ حَوَائِجِنَا"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا اللهُ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَي النَّبِيِ الْعَرَبِيِّ وَاٰلِهٖ"
    }
  ]
}