    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا ابْنَ فَاطِمَةَ الزَّهْرَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حَبِيْبَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا صِفْوَةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَمِيْنَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نُوْرَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا صِرَاطَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا بَيَانَ حُكْمِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نَاصِرَ دِيْنِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا السَّيِّدُ الزَّكِيُّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْبَرُّ الْوَفِيُّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْقَائِمُ الْاَمِيْنُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْعَالِمُ بِالتَّأْوِيْلِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْهَادِي الْمَهْدِيُّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الطَّاهِرُ الزَّكِيُّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا التَّقِيُّ النَّقِيُّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْحَقُّ الْحَقِيْقُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الشَّهِيْدُ الصِّدِّيْقُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَبَا مُحَمَّدٍ الْحَسَنَ بْنَ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا ابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا ابْنَ أَمِيْرِالْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا ابْنَ سَيِّدَةِ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ أَقَمْتَ الصَّلَاةَ، وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ، وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَعَبَدْتَ اللهَ مُخْلِصًا"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِي اللهِ حَقَّ جِهَادِهٖ حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "فَعَلَيْكَ السَّلَامُ مِنِّيْ مَا بَقِيْتُ وَبَقِيَ اللَّيْلُ وَالنَّهَارُ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي اٰلِ بَيْتِكَ الطَّيِّبِيْنَ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَنَا يَا مَوْلَايَ مَوْلًى لَكَ وَلِاٰلِ بَيْتِكَ"
    },
    {
      "kind": "text",
      "ar": "سِلْمٌ لِمَنْ سَالَمَكُمْ وَحَرْبٌ لِمَنْ حَارَبَكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُوْمِنٌ بِسِرِّكُمْ وَجَهْرِكُمْ وَظَاهِرِكُمْ وَبَاطِنِكُمْ"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ أَعْدَائَكُمْ مِنَ الْاَوَّلِيْنَ وَالْأٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا أَبْرَأُ اِلَي اللهِ تَعَالٰي مِنْهُمْ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ يَا أَبَا مُحَمَّدٍ، يَا مَوْلَايَ يَا أَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا يَوْمُ الِْاثْنَيْنِ وَهُوَ يَوْمُكُمَا وَبِاسْمِكُمَا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا فِيْهِ ضَيْفُكُمَا، فَأَضِيْفَانِيْ وَأَحْسِنَا ضِيَافَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَنِعْمَ مَنِ اسْتُضِيْفَ بِهٖ أَنْتُمَا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا فِيْهِ مِنْ جِوَارِكُمَا فَأَجِيْرَانِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكُمَا مَأمُوْرَانِ بِالضِّيَافَةِ وَالْاِجَارَةِ"
    },
    {
      "kind": "text",
      "ar": "فَصَلَّي اللهُ عَلَيْكُمَا وَاٰلِكُمَا الطَّيِّبِيْنَ"
    }
  ]
}