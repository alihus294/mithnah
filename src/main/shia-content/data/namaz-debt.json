    },
    {
      "kind": "text",
      "ar": "يَا مُحَمَّدَ بْنَ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "يَا جَعْفَرَ بْنَ مُحَمَّدٍ"
    },
    {
