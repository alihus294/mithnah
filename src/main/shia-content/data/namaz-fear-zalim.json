{
  "id": "namaz-fear-zalim",
  "title": "نماز خوف از ظالم",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز خوف از ظالم",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ يَا قَيُّوْمُ يَا حَيًّا لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ أَسْتَغِيْثُ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَغِثْنِي السَّاعَةَ السَّاعَةَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ اَللّٰهُمَّ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّد"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَلْطُفَ لِيْ، وَأَنْ تَغْلِبَ لِيْ، وَأَنْ تَمْكُرَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَخْدَعَ لِيْ ، وَأَنْ تَكِيْدَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَكْفِيَنِيْ مَؤونَةَ فلان ابن فلان"
    }
  ]
}