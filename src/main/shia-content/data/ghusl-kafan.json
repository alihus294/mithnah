    {
      "kind": "text",
      "ar": "فَلَانَ يَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مُحَمَّدًا رَسُوْلُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ عَلِيًّا أَمِيْرُ الْمُؤْمِنِيْنَ وَالْاَئِمَّةَ مِنْ وُلْدِهٖ"
    },
    {
      "kind": "text",
      "ar": ".........."
    },
    {
      "kind": "text",
      "ar": "أَئِمَّتُهٗ أَئِمَّةُ الْهُدَي الْاَبْرَارُ"
    }
  ]
}