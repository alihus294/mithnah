{
  "id": "salawat-imam-zaman",
  "title": "الصلوات على إمام العصر عجّل الله فرجه",
  "subtitle": "صلوات قَوِيَّة لتعجيل الفرج",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "الصلوات على إمام العصر", "subtitle": "عجّل الله تعالى فرجه الشريف" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَأَهْلِ بَيْتِهِ" },
    { "kind": "text", "ar": "وَصَلِّ عَلَىٰ وَلِيِّ الحَسَنِ وَوَصِيِّهِ وَوارِثِهِ" },
    { "kind": "text", "ar": "القائِمِ بِأَمْرِكَ، وَالغائِبِ فِي خَلْقِكَ" },
    { "kind": "text", "ar": "وَالمُنْتَظِرِ لإِذْنِكَ" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَيْهِ، وَقَرِّبْ بُعْدَهُ" },
    { "kind": "text", "ar": "وَأَنْجِزْ وَعْدَهُ، وَأَوْفِ عَهْدَهُ" },
    { "kind": "text", "ar": "وَاكْشِفْ عَنْ بَأْسِهِ حِجابَ الغَيْبَةِ" },
    { "kind": "text", "ar": "وَأَظْهِرْ بِظُهُورِهِ صَحائِفَ المِحْنَةِ" },
    { "kind": "text", "ar": "وَقَدِّمْ أَمامَهُ الرُّعْبَ، وَثَبِّتْ بِهِ القَلْبَ" },
    { "kind": "text", "ar": "وَأَقِمْ بِهِ الحَرْبَ" },
    { "kind": "text", "ar": "وَأَيِّدْهُ بِجُنْدٍ مِنَ المَلائِكَةِ مُسَوِّمِينَ" },
    { "kind": "text", "ar": "وَسَلِّطْهُ عَلَىٰ أَعْداءِ دِينِكَ أَجْمَعِينَ" },
    { "kind": "text", "ar": "وَأَلْهِمْهُ أَنْ لا يَدَعَ مِنْهُمْ رُكْناً إِلَّا هَدَّهُ" },
    { "kind": "text", "ar": "وَلا هاماً إِلَّا قَدَّهُ" },
    { "kind": "text", "ar": "وَلا كَيْداً إِلَّا رَدَّهُ" },
    { "kind": "text", "ar": "وَلا فاسِقاً إِلَّا حَدَّهُ" },
    { "kind": "text", "ar": "وَلا فِرْعَوْناً إِلَّا أَهْلَكَهُ" },
    { "kind": "text", "ar": "وَلا سِتْراً إِلَّا هَتَكَهُ" },
    { "kind": "text", "ar": "وَلا عَلَماً إِلَّا نَكَّسَهُ" },
    { "kind": "text", "ar": "وَلا سُلْطاناً إِلَّا كَسَبَهُ" },
    { "kind": "text", "ar": "وَلا رُمْحاً إِلَّا قَصَفَهُ" },
    { "kind": "text", "ar": "وَلا مِطْرَداً إِلَّا خَرَقَهُ" },
    { "kind": "text", "ar": "وَلا جُنْداً إِلَّا فَرَّقَهُ" },
    { "kind": "text", "ar": "وَلا مِنْبَراً إِلَّا أَحْرَقَهُ" },
    { "kind": "text", "ar": "وَلا سَيْفاً إِلَّا كَسَرَهُ" },
    { "kind": "text", "ar": "وَلا صَنَماً إِلَّا رَضَّهُ" },
    { "kind": "text", "ar": "وَلا دَماً إِلَّا أَراقَهُ" },
    { "kind": "text", "ar": "وَلا جَوْراً إِلَّا أَبادَهُ" },
    { "kind": "text", "ar": "وَلا حِصْناً إِلَّا هَدَمَهُ" },
    { "kind": "text", "ar": "وَلا باباً إِلَّا رَدَمَهُ" },
    { "kind": "text", "ar": "وَلا قَصْراً إِلَّا خَرَّبَهُ" },
    { "kind": "text", "ar": "وَلا مَسْكَناً إِلَّا فَتَّشَهُ" },
    { "kind": "text", "ar": "وَلا سَهْلاً إِلَّا أَوْطَأَهُ" },
    { "kind": "text", "ar": "وَلا جَبَلاً إِلَّا صَعِدَهُ" },
    { "kind": "text", "ar": "وَلا كَنْزاً إِلَّا أَخْرَجَهُ" },
    { "kind": "text", "ar": "بِرَحْمَتِكَ يا أَرْحَمَ الرَّاحِمِينَ" }
  ]
}
