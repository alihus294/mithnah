    {
      "kind": "text",
      "ar": "عَلٰي مِنْبَرِ الْكُوْفَةِ بِلِسَانِ الْفُصَحَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُخَاطِبِ الذِّئْبِ"
    },
    {
      "kind": "text",
      "ar": "وَمُكَلِّمِ الْجُمْجُمَةِ بِالنَّهْرَوَانِ وَقَدْ نَخِرَتِ الْعِظَامُ بِالْبِلَا"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَاحِبِ الشَّفَاعَةِ فِيْ يَوْمِ الْوَرٰي"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْاِمَامِ الزَّكِيِّ حَلِيْفِ الْمِحْرَابِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَاحِبِ الْمُعْجِزِ الْبَاهِرِ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّاطِقِ بِالْحِكْمَةِ وَالصَّوَابِ"
