{
  "id": "ziarat-imam-ali-7",
  "title": "ساتويں زيارت مطلقه",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ساتويں زيارت مطلقه",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "سَلَامُ اللهِ وَسَلَامُ مَلَائِكَتِهِ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْبِيَائِهِ الْمُرْسَلِيْنَ، وَعِبَادِهِ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَجَمِيْعِ الشُّهَدَاءِ وَالصِّدِّيْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْكَ يَا أَمِيْرَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي اٰدَمَ صَفْوَةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي نُوْحٍ نَبِيِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي اِبْرَاهِيْمَ خَلِيْلِ اللهِ"
