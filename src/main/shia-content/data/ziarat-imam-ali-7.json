    {
      "kind": "text",
      "ar": "زِيَارَةَ مَنْ هَجَرَ فِيْكَ صَحْبَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَكَ بَعْدَ اللهِ حَسْبَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ الطُّوْرُ وَالْكِتَاب الْمَسْطُوْرُ"
    },
    {
      "kind": "text",
      "ar": "وَالرِّقُّ الْمَنْشُوْرُ، وَبَحْرُ الْعِلْمِ الْمَسْجُوْرُ"
    },
    {
      "kind": "text",
      "ar": "يَا وَلِيَّ اللهِ اِنَّ لِكُلِّ مَزُوْرٍ عِنَايَةً"
    },
    {
      "kind": "text",
      "ar": "فِيْ مَنْ زَارَهٗ وَقَصَدَهٗ وَأَتَاهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا وَلِيُّكَ وَقَدْ حَطَطْتُ رَحْلِيْ بِفِنَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَجَأْتُ اِلٰي حَرَمِكَ، وَلُذْتُ بِضَرِيْحِكَ"
    },
    {
      "kind": "text",
      "ar": "لِعِلْمِيْ بِعَظِيْمِ مَنْزِلَتِكَ وَشَرَفِ حَضْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ أَثْقَلَتِ الذُّنُوْبُ ظَهْرِيْ وَمَنَعَتْنِيْ رُقَادِيْ"
    },
    {
      "kind": "text",
      "ar": "فَمَا أَجِدُ حِرْزًا وَلَا مَعْقِلًا وَلَا مَلْجَأً أَلْجَأُ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا اللهُ تَعَالٰي وَتَوَسُّلِيْ بِكَ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتِشْفَاعِيْ بِكَ لَدَيْهِ"
    },
    {
      "kind": "text",
      "ar": "فَهَا أَنَا نَازِلٌ بِفِنَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ عِنْدَ اللهِ جَاهٌ عَظِيْمٌ، وَمَقَامٌ كَرِيْمٌ"
