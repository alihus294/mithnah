    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ عِنْدَ اللهِ رَبِّكَ يَا مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَتَقَرَّبُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَسْمَعَ السَّامِعِيْنَ وَيَا أَبْصَرَ النَّاظِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَا أَسْرَعَ الْحَاسِبِيْنَ وَيَا أَجْوَدَ الْاَجْوَدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "بِمُحَمَّدٍ خَاتَمِ النَّبِيِّيْنَ رَسُوْلِكَ اِلَي الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِأَخِيْهِ وَابْنِ عَمِّهِ الْاَنْزَعِ الْبَطِيْنِ"
    },
    {
      "kind": "text",
      "ar": "الْعَالِمِ الْمُبِيْنِ عَلِيٍّ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنَ وَالْحُسَيْنِ الْاِمَامَيْنِ الشَّهِيْدَيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَبِعَلِيِّ بْنِ الْحُسَيْنِ زَيْنِ الْعَابِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِمُحَمَّدِ بْنِ عَلِيٍّ بَاقِرِ عِلْمِ الْاَوَّلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِجَعْفَرِ بْنِ مُحَمَّدٍ زَكِيِّ الصِّدِّيْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِمُوْسَي بْنِ جَعْفَرٍ الْكَاظِمِ الْمُبِيْنِ وَحَبِيْسِ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِعَلِيِّ بْنِ مُوْسَي الرِّضَا الْاَمِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَبِمُحَمَّدِ بْنِ عَلِيٍّ الْجَوَادِ عَلَمِ الْمُهْتَدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِعَلِيِّ بْنِ مُحَمَّدٍ الْبَرِّ الصَّادِقِ سَيِّدِ الْعَابِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِالْحَسَنِ بْنِ عَلِيٍّ الْعَسْكَرِيِّ وَلِيِّ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِالْخَلَفِ الْحُجَّةِ صَاحِبِ الْاَمْرِ مُظْهِرِ الْبَرَاهِيْنِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَكْشِفَ مَا بِيْ مِنَ الْهُمُوْمِ"
    },
    {
      "kind": "text",
      "ar": "وَتَكْفِيَنِيْ شَرَّ الْبَلَاءِ الْمَحْتُوْمِ"
    },
    {
      "kind": "text",
      "ar": "وَتُجِيْرَنِيْ مِنَ النَّارِ ذَاتِ السَّمُوْمِ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِنْ كَانَ قَدْ عَصَيْتُكَ فَاِنِّيْ قَدْ اَطَعْتُكَ فِيْ أَحَبِّ الْأَشْيَاءِ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي اِسْمِ اللهِ الرَّضِيَّ وَنُوْرِ وَجْهِهِ الْمُضِيٓءِ....."
    }
  ]
}