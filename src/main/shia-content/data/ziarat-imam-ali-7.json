    {
      "kind": "text",
      "ar": "يَا أَمِيْنَ اللهِ يَا حُجَّةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "يَا وَلِيَّ اللهِ يَا صِرَاطَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "زَارَكَ عَبْدُكَ وَوَلِيُّكَ اللَّائِذُ بِقَبْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُنِيْخُ رَحْلَهٗ بِفِنَائِكَ"
