    {
      "kind": "text",
      "ar": "وَاِنَّهٗ فِيْ أُمِّ الْكِتَابِ لَدَيْنَا لَعَلِيٌّ حَكِيْمٌ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صِرَاطِ اللهِ الْمُسْتَقِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمَنْعُوْتِ فِي التَّوْرَاةِ"
