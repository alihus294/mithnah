    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ عِنْدَهٗ تَأْوِيْلُ الْمُحْكَمِ وَالْمُتَشَابِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعِنْدَهٗ أُمُّ الْكِتَابِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ رُدَّتْ عَلَيْهِ الشَّمْسُ حِيْنَ تَوَارَتْ بِالْحِجَابِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُحْيِي اللَّيْلِ الْبَهِيْمِ بِالتَّهَجُّدِ وَالْاِكْتِيَابِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ خَاطَبَهٗ جَبْرَئِيْلُ بِاِمْرَةِ الْمُؤْمِنِيْنَ بِغَيْرِ ارْتِيَابٍ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي سَيِّدِ السَّادَاتِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَاحِبِ الْمُعْجِزَاتِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ عَجِبَ مِنْ حَمَلَاتِهٖ فِي الْحُرُوْبِ مَلَائِكَةُ سَبْعِ سَمٰوَاتٍ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ نَاجَي الرَّسُوْلَ"
    },
    {
      "kind": "text",
      "ar": "فَقَدَّمَ بَيْنَ يَدَيْ نَجْوَاهُ صَدَقَاتٍ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَمِيْرِ الْجُيُوْشِ وَصَاحِبِ الْغَزَوَاتِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُخَاطِبِ ذِئْبِ الْفَلَوَاتِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي نُوْرِ اللهِ فِي الظُّلُمَاتِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ رُدَّتْ لَهُ الشَّمْسُ"
    },
    {
      "kind": "text",
      "ar": "فَقَضٰي مَا فَاتَهٗ مِنَ الصَّلَاةِ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُه۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي سَيِّدِ الْوَصِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي اِمَامِ الْمُتَّقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي وَارِثِ عِلْمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي يَعْسُوْبِ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي عِصْمَةِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي قُدْوَةِ الصَّادِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي حُجَّةِ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَبِي الْاَئِمَّةِ الْاَطْهَارِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمَخْصُوْصِ بِذِي الْفَقَارِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي سَاقِيْ أَوْلِيَائِهٖ مِنْ حَوْضِ النَّبِيِّ الْمُخْتَارِ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ مَا اطَّرَدَ اللَّيْلُ وَالنَّهَارُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي النَّبَأَ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ أَنْزَلَ اللهُ فِيْهِ"
