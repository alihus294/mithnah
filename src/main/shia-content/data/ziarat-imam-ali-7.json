    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُوْسٰي كَلِيْمِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي عِيْسٰي رُوْحِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُحَمَّدٍ حَبِيْبِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي اسْمِ اللهِ الرَّضِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَوَجْهِهِ الْعَلِيِّ، وَصِرَاطِهِ السَّوِيِّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمُهَذَّبِ الصَّفِيِّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَبِي الْحَسَنِ عَلِيِّ بْنِ أَبِيْ طَالِبٍ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي خَالِصِ الْاَخِلَّاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمَخْصُوْصِ بِسَيِّدَةِ النِّسَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمَوْلُوْدِ فِي الْكَعْبَةِ، الْمُزَوَّجِ فِي السَّمَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَسَدِ اللهِ فِي الْوَغٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ شُرِّفَتْ بِهٖ مَكَّةُ وَمِنٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَاحِبِ الْحَوْضِ وَحَامِلِ اللِّوَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي خَامِسِ أَهْلِ الْعَبَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْبَائِتِ عَلٰي فِرَاشِ النَّبِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَمُفْدِيْهِ بِنَفْسِهٖ مِنَ الْاَعْدَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي قَالِعِ بَابِ خَيْبَرَ وَالدَّاحِيْ بِهٖ فِي الْفَضَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُكَلِّمِ الْفِتْيَةِ فِيْ كَهْفِهِمْ بِلِسَانِ الْاَنْبِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُنْبِعِ الْقَلِيْبِ فِي الْفَلَا"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي قَالِعِ الصَّخْرَةِ وَقَدْ عَجَزَ عَنْهَا الرِّجَالُ الْاَشِدَّاءُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُخَاطِبِ الثُّعْبَانِ"
