{
  "id": "ayat-kursi",
  "title": "آيت الكرسي",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "آيت الكرسي",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ لَاۤ اِلٰهَ اِلَّا هُوَ١ۚ اَلْحَيُّ الْقَيُّوْمُ١ۚ۬"
    },
    {
      "kind": "text",
      "ar": "لَا تَاْخُذُهٗ سِنَةٌ وَّلَا نَوْمٌ١ؕ"
    },
    {
      "kind": "text",
      "ar": "لَهٗ مَا فِي السَّمٰوٰتِ وَمَا فِي الْاَرْضِ١ؕ"
    },
    {
      "kind": "text",
      "ar": "مَنْ ذَا الَّذِيْ يَشْفَعُ عِنْدَهٗۤ اِلَّا بِاِذْنِهٖ١ؕ"
    },
    {
      "kind": "text",
      "ar": "يَعْلَمُ مَا بَيْنَ اَيْدِيْهِمْ وَمَا خَلْفَهُمْ١ۚ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُحِيْطُوْنَ بِشَيْءٍ مِّنْ عِلْمِهٖۤ اِلَّا بِمَا شَآءَ١ۚ"
    },
    {
      "kind": "text",
      "ar": "وَسِعَ كُرْسِيُّهُ السَّمٰوٰتِ وَالْاَرْضَ١ۚ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَـُٔوْدُهٗ حِفْظُهُمَا١ۚ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ الْعَلِيُّ الْعَظِيْمُ۝۲۵۵"
    },
    {
      "kind": "text",
      "ar": "لَاۤ اِكْرَاهَ فِي الدِّيْنِ١ۙ۫"
    },
    {
      "kind": "text",
      "ar": "قَدْ تَّبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ١ۚ"
    },
    {
      "kind": "text",
      "ar": "فَمَنْ يَّكْفُرْ بِالطَّاغُوْتِ وَيُؤْمِنْۢ بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقٰى١ۗ لَا انْفِصَامَ لَهَا١ؕ"
    },
    {
      "kind": "text",
      "ar": "وَاللّٰهُ سَمِيْعٌ عَلِيْمٌ۝۲۵۶"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ وَلِيُّ الَّذِيْنَ اٰمَنُوْا١ۙ"
    },
    {
      "kind": "text",
      "ar": "يُخْرِجُهُمْ مِّنَ الظُّلُمٰتِ اِلَى النُّوْرِ١ؕ۬"
    },
    {
      "kind": "text",
      "ar": "وَالَّذِيْنَ كَفَرُوْۤا اَوْلِيٰٓـُٔهُمُ الطَّاغُوْتُ١ۙ"
    },
    {
      "kind": "text",
      "ar": "يُخْرِجُوْنَهُمْ مِّنَ النُّوْرِ اِلَى الظُّلُمٰتِ١ؕ"
    },
    {
      "kind": "text",
      "ar": "اُولٰٓىِٕكَ اَصْحٰبُ النَّارِ١ۚ هُمْ فِيْهَا خٰلِدُوْنَ۝۲۵۷"
    }
  ]
}