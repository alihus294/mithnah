{
  "id": "ramadan-day22-dua",
  "title": "بائيسويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "بائيسويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ افْتَحْ لِيْ فِيْهِ أَبْوَابَ فَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزِلْ عَلَيَّ فِيْهِ بَرَكَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَفِّقْنِيْ فِيْهِ لِمُوْجِبَاتِ مَرْضَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْكِنِّيْ فِيْهِ بُحْبُوْحَاتِ جَنَّاتِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا مُجِيْبَ دَعْوَةِ الْمُضْطَرِّيْنَ۔"
    }
  ]
}