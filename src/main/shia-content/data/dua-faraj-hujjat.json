{
  "id": "dua-faraj-hujjat",
  "title": "دعاء الفرج (إلهي عظم البلاء)",
  "subtitle": "للتوسل بإمام العصر عجّل الله فرجه عند الشدائد",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "دعاء الفرج", "subtitle": "إلهي عظم البلاء..." },
    { "kind": "text", "ar": "إِلٰهِي عَظُمَ البَلاءُ، وَبَرِحَ الخَفاءُ" },
    { "kind": "text", "ar": "وَانْكَشَفَ الغِطاءُ، وَانْقَطَعَ الرَّجاءُ" },
    { "kind": "text", "ar": "وَضاقَتِ الأَرْضُ وَمُنِعَتِ السَّماءُ" },
    { "kind": "text", "ar": "وَأَنْتَ المُسْتَعانُ، وَإِلَيْكَ المُشْتَكَىٰ" },
    { "kind": "text", "ar": "وَعَلَيْكَ المُعَوَّلُ فِي الشِّدَّةِ وَالرَّخاءِ" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ" },
    { "kind": "text", "ar": "أُولِي الأَمْرِ الَّذِينَ فَرَضْتَ عَلَيْنا طاعَتَهُمْ" },
    { "kind": "text", "ar": "وَعَرَّفْتَنا بِذٰلِكَ مَنْزِلَتَهُمْ" },
    { "kind": "text", "ar": "فَفَرِّجْ عَنَّا بِحَقِّهِمْ، فَرَجاً عاجِلاً قَرِيباً" },
    { "kind": "text", "ar": "كَلَمْحِ البَصَرِ أَوْ هُوَ أَقْرَبُ" },
    { "kind": "text", "ar": "يا مُحَمَّدُ يا عَلِيُّ، يا عَلِيُّ يا مُحَمَّدُ" },
    { "kind": "text", "ar": "اكْفِيانِي فَإِنَّكُما كافِيانِ" },
    { "kind": "text", "ar": "وَانْصُرانِي فَإِنَّكُما ناصِرانِ" },
    { "kind": "text", "ar": "يا مَوْلانا يا صاحِبَ الزَّمانِ" },
    { "kind": "text", "ar": "الغَوْثَ الغَوْثَ الغَوْثَ" },
    { "kind": "text", "ar": "أَدْرِكْنِي أَدْرِكْنِي أَدْرِكْنِي" },
    { "kind": "text", "ar": "السَّاعَةَ السَّاعَةَ السَّاعَةَ" },
    { "kind": "text", "ar": "العَجَلَ العَجَلَ العَجَلَ" },
    { "kind": "text", "ar": "يا أَرْحَمَ الرَّاحِمِينَ" },
    { "kind": "text", "ar": "بِحَقِّ مُحَمَّدٍ وَآلِهِ الطَّاهِرِينَ" }
  ]
}
