{
  "id": "taqibat-dua-maghfira",
  "title": "دعا۔ اللهم ان مغفرتك ارجي",
  "subtitle": "تعقيبات الصلاة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعا۔ اللهم ان مغفرتك ارجي",
      "subtitle": "تعقيبات الصلاة"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ مَغْفِرَتَكَ أَرْجٰي مِنْ عَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّ رَحْمَتَكَ أَوْسَعُ مِنْ ذَنْبِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنْ كَانَ ذَنْبِيْ عِنْدَكَ عَظِيْمًا"
    },
    {
      "kind": "text",
      "ar": "فعَفْوُكَ أَعْظَمُ مِنْ ذَنْبِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنْ لَمْ أَكُنْ أَهْلًا أَنْ أَبْلُغَ رَحْمَتَكَ"
    },
    {
      "kind": "text",
      "ar": "فَرَحْمَتُكَ أَهْلٌ أَنْ تَبْلُغَنِيْ وَتَسَعَنِيْ"
    },
    {
      "kind": "text",
      "ar": "لِاَنَّهَا وَسِعَتْ كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}