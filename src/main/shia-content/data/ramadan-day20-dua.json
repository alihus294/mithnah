{
  "id": "ramadan-day20-dua",
  "title": "بيسويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "بيسويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ افْتَحْ لِيْ فِيْهِ أَبْوَابَ الْجِنَانِ"
    },
    {
      "kind": "text",
      "ar": "وَأَغْلِقْ عَنِّيْ فِيْهِ أَبْوَابَ النِّيْرَانِ"
    },
    {
      "kind": "text",
      "ar": "وَوَفِّقْنِيْ فِيْهِ لِتِلَاوَةِ الْقُرْاٰنِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُنْزِلَ السَّكِيْنَةِ فِيْ قُلُوْبِ الْمُؤْمِنِيْنَ۔"
    }
  ]
}