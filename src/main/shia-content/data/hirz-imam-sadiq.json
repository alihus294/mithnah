{
  "id": "hirz-imam-sadiq",
  "title": "۴۔ حرز امام جعفر صادق",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۴۔ حرز امام جعفر صادق",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا خَالِقَ الْخَلْقِ وَيَا بَاسِطَ الرِّزْقِ"
    },
    {
      "kind": "text",
      "ar": "وَيَا فَالِقَ الْحَبِّ وَيَا بَارِئَ النَّسَمِ"
    },
    {
      "kind": "text",
      "ar": "وَمُحْيِيَ الْمَوْتٰي وَمُمِيْتَ الْاَحْيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَدَائِمَ الثَّبَاتِ وَمُخْرِجَ النَّبَاتِ"
    },
    {
      "kind": "text",
      "ar": "افْعَلْ بِيْ مَا أَنْتَ أَهْلُهُ وَلَا تَفْعَلْ بِيْ مَا أَنَا أَهْلُهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ أَهْلُ التَّقْوٰي وَأَهْلُ الْمَغْفِرَةِ"
    }
  ]
}