{
  "id": "ramadan-night21-dua",
  "title": "اكيسويں شب كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "اكيسويں شب كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا مُوْلِجَ اللَّيْلِ فِي النَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "وَمُوْلِجَ النَّهَارِ فِي اللَّيْلِ"
    },
    {
      "kind": "text",
      "ar": "وَمُخْرِجَ الْحَيِّ مِنَ الْمَيِّتِ"
    },
    {
      "kind": "text",
      "ar": "وَمُخْرِجَ الْمَيِّتِ مِنَ الْحَيِّ"
    },
    {
      "kind": "text",
      "ar": "يَا رَازِقَ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا رَحْمٰنُ، يَا اللهُ يَا رَحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا اللهُ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْاَسْمَاءُ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْاَمْثَالُ الْعُلْيَا وَالْكِبْرِيَاءُ وَالْاٰلَاءُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ اسْمِيْ فِيْ هٰذِهِ اللَّيْلَةِ فِي السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَرُوْحِيْ مَعَ الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاِحْسَانِيْ فِيْ عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِسَائَتِيْ مَغْفُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَهَبَ لِيْ يَقِيْنًا تُبَاشِرُ بِهٖ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِيْمَانًا يُذْهِبُ الشَّكَّ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُرْضِيَنِيْ بِمَا قَسَمْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْاٰخِرَةِ حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِنَا عَذَابَ النَّارِ الْحَرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ فِيْهَا ذِكْرَكَ وَشُكْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّغْبَةَ اِلَيْكَ وَالْاِنَابَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّوْفِيْقَ لِمَا وَفَّقْتَ لَهٗ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْهِ وَعَلَيْهِمُ السَّلَامُ۔"
    }
  ]
}