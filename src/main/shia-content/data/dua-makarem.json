{
  "id": "dua-makarem",
  "title": "دعاء مكارم الاخلاق",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء مكارم الاخلاق",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْ بِاِيْمَانِيْ أَكْمَلَ الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ يَقِيْنِيْ أَفْضَلَ الْيَقِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَانْتَهِ بِنِيَّتِيْ اِلٰي أَحْسَنِ النِّيَّاتِ"
    },
    {
      "kind": "text",
      "ar": "وَبِعَمَلِيْ اِلٰي أَحْسَنِ الْاَعْمَالِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَفِّرْ بِلُطْفِكَ نِيَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَصَحِّحْ بِمَا عِنْدَكَ يَقِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَصْلِحْ بِقُدْرَتِكَ مَا فَسَدَ مِنِّيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِنِيْ مَا يَشْغَلُنِي الْاِهْتِمَامُ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَعْمِلْنِيْ بِمَا تَسْأَلُنِيْ غَدًا عَنْهُ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَفْرِغْ أَيَّامِيْ فِيْمَا خَلَقْتَنِيْ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَغْنِنِيْ وَأَوْسِعْ عَلَيَّ فِيْ رِزْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَفْتِنِّيْ بِالنَّظَرِ وَأَعِزَّنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَبْتَلِيَنِّيْ بِالْكِبْرِ، وَعَبِّدْنِيْ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُفْسِدْ عِبَادَتِيْ بِالْعُجْبِ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْرِ لِلنَّاسِ عَلٰي يَدَيَّ الْخَيْرَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَمْحَقْهُ بِالْمَنِّ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيْ مَعَالِيَ الْاَخْلَاقِ"
    },
    {
      "kind": "text",
      "ar": "وَاعْصِمْنِيْ مِنَ الْفَخْرِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَرْفَعْنِيْ فِي النَّاسِ دَرَجَةً"
    },
    {
      "kind": "text",
      "ar": "اِلَّا حَطَطْتَنِيْ عِنْدَ نَفْسِيْ مِثْلَهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُحْدِثْ لِيْ عِزًّا ظَاهِرًا"
    },
    {
      "kind": "text",
      "ar": "اِلَّا أَحْدَثْتَ لِيْ ذِلَّةً بَاطِنَةً عِنْدَ نَفْسِيْ بِقَدَرِهَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَمَتِّعْنِيْ بِهُدًى صَالِحٍ لَا أَسْتَبْدِلُ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَطَرِيْقَةِ حَقٍّ لَا أَزِيْغُ عَنْهَا"
    },
    {
      "kind": "text",
      "ar": "وَنِيَّةِ رُشْدٍ لَا أَشُكُّ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "وَعَمِّرْنِيْ مَا كَانَ عُمْرِيْ بِذْلَةً فِيْ طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِذَا كَانَ عُمْرِيْ مَرْتَعًا لِلشَّيْطَانِ"
    },
    {
      "kind": "text",
      "ar": "فَاقْبِضْنِيْ اِلَيْكَ قَبْلَ أَنْ يَسْبِقَ مَقْتُكَ اِلَيَّ"
    },
    {
      "kind": "text",
      "ar": "أَوْ يَسْتَحْكِمَ غَضَبُكَ عَلَيَّ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَدَعْ خَصْلَةً تُعَابُ مِنِّيْ اِلَّا أَصْلَحْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا عَايِبَةً أُؤَنَّبُ بِهَا اِلَّا حَسَّنْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا أُكْرُوْمَةً فِيَّ نَاقِصَةً اِلَّا أَتْمَمْتَهَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْدِلْنِيْ مِنْ بُغْضَةِ أَهْلِ الشَّنَانِ الْمَحَبَّةَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ حَسَدِ أَهْلِ الْبَغْيِ الْمَوَدَّةَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ ظِنَّةِ أَهْلِ الصَّلَاحِ الثِّقَةَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ عَدَاوَةِ الْاَدْنَيْنَ الْوَلَايَةَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ عُقُوْقِ ذَوِي الْاَرْحَامِ الْمَبَرَّةَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ خِذْلَانِ الْاَقْرَبِيْنَ النُّصْرَةَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ حُبِّ الْمُدَارِيْنَ تَصْحِيْحَ الْمِقَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ رَدِّ الْمُلَابِسِيْنَ كَرَمَ الْعِشْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ مَرَارَةِ خَوْفِ الظَّالِمِيْنَ حَلَاوَةَ الْاَمَنَةِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لِيْ يَدًا عَلٰي مَنْ ظَلَمَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلِسَانًا عَلٰي مَنْ خَاصَمَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَظَفَرًا بِمَنْ عَانَدَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيْ مَكْرًا عَلٰي مَنْ كَايَدَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقُدْرَةً عَلٰي مَنِ اضْطَهَدَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَكْذِيْبًا لِمَنْ قَصَبَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَامَةً مِمَّنْ تَوَعَّدَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَوَفِّقْنِيْ لِطَاعَةِ مَنْ سَدَّدَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمُتَابَعَةِ مَنْ أَرْشَدَنِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَدِّدْنِيْ لِأَنْ أُعَارِضَ مَنْ غَشَّنِيْ بِالنُّصْحِ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْزِيَ مَنْ هَجَرَنِيْ بِالْبِرِّ"
    },
    {
      "kind": "text",
      "ar": "وَأُثِيْبَ مَنْ حَرَمَنِيْ بِالْبَذْلِ"
    },
    {
      "kind": "text",
      "ar": "وَأُكَافِئَ مَنْ قَطَعَنِيْ بِالصِّلَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأُخَالِفَ مَنِ اغْتَابَنِيْ اِلٰي حُسْنِ الذِّكْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ أَشْكُرَ الْحَسَنَةَ وَأُغْضِيَ عَنِ السَّيِّئَةِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحَلِّنِيْ بِحِلْيَةِ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْنِيْ زِيْنَةَ الْمُتَّقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ بَسْطِ الْعَدْلِ، وَكَظْمِ الْغَيْظِ"
    },
    {
      "kind": "text",
      "ar": "وَاِطْفَاءِ النَّائِرَةِ، وَضَمِّ أَهْلِ الْفُرْقَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاِصْلَاحِ ذَاتِ الْبَيْنِ، وَاِفْشَاءِ الْعَارِفَةِ"
    },
    {
      "kind": "text",
      "ar": "وَسِتْرِ الْعَائِبَةِ، وَلِيْنِ الْعَرِيْكَةِ"
    },
    {
      "kind": "text",
      "ar": "وَخَفْضِ الْجَنَاحِ، وَحُسْنِ السِّيْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَسُكُوْنِ الرِّيْحِ، وَطِيْبِ الْمُخَالَقَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّبْقِ اِلَي الْفَضِيْلَةِ، وَاِيْثَارِ التَّفَضُّلِ"
    },
    {
      "kind": "text",
      "ar": "وَتَرْكِ التَّعْيِيْرِ، وَالْاِفْضَالِ عَلٰي غَيْرِ الْمُسْتَحِقِّ"
    },
    {
      "kind": "text",
      "ar": "وَالْقَوْلِ بِالْحَقِّ وَاِنْ عَزَّ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتِقْلَالِ الْخَيْرِ  وَاِنْ كَثُرَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ قَوْلِيْ وَفِعْلِيْ وَأَكْمِلْ ذٰلِكَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "بِدَوَامِ الطَّاعَةِ وَلُزُوْمِ الْجَمَاعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَرَفْضِ أَهْلِ الْبِدَعِ"
    },
    {
      "kind": "text",
      "ar": "وَمُسْتَعْمِلِي الرَّأْيِ الْمُخْتَرَعِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ أَوْسَعَ رِزْقِكَ عَلَيَّ اِذَا كَبِرْتُ"
    },
    {
      "kind": "text",
      "ar": "وَأَقْوٰي قُوَّتِكَ فِيَّ اِذَا نَصِبْتُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَبْتَلِيَنِّيْ بِالْكَسَلِ عَنْ عِبَادَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا الْعَمٰي عَنْ سَبِيْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بِالتَّعَرُّضِ لِخِلَافِ مَحَبَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُجَامَعَةِ مَنْ تَفَرَّقَ عَنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُفَارَقَةِ مَنِ اجْتَمَعَ اِلَيْكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ أَصُوْلُ بِكَ عِنْدَ الضَّرُوْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وأَسْأَلُكَ عِنْدَ الْحَاجَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَضَرَّعُ اِلَيْكَ عِنْدَ الْمَسْكَنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَفْتِنِّيْ بِالْاِسْتِعَانَةِ بِغَيْرِكَ اِذَا اضْطُرِرْتُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بِالْخُضُوْعِ بِسُؤَالِ غَيْرِكَ اِذَا افْتَقَرْتُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بِالتَّضَرُّعِ اِلٰي مَنْ دُوْنَكَ اِذَا رَهِبْتُ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْتَحِقَّ بِذٰلِكَ خِذْلَانَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْعَكَ وَاِعْرَاضَكَ، يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ مَا يُلْقِي الشَّيْطَانُ فِيْ رُوْعِيْ"
    },
    {
      "kind": "text",
      "ar": "مِنَ التَّمَنِّيْ وَالتَّظَنِّيْ وَالْحَسَدِ"
    },
    {
      "kind": "text",
      "ar": "ذِكْرًا لِعَظَمَتِكَ وَتَفَكُّرًا فِيْ قُدْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَدْبِيْرًا عَلٰي عَدُوِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَا أَجْرٰي عَلٰي لِسَانِيْ مِنْ لَفْظَةِ فُحْشٍ"
    },
    {
      "kind": "text",
      "ar": "أَوْ هَجْرٍ أَوْ شَتْمِ عِرْضٍ أَوْ شَهَادَةِ بَاطِلٍ"
    },
    {
      "kind": "text",
      "ar": "أَوِ اغْتِيَابِ مُؤْمِنٍ غَائِبٍ أَوْ سَبِّ حَاضِرٍ"
    },
    {
      "kind": "text",
      "ar": "وَمَا أَشْبَهَ ذٰلِكَ نُطْقًا بِالْحَمْدِ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِغْرَاقًا فِي الثَّنَاءِ عَلَيْكَ"
    },
    {
      "kind": "text",
