{
  "id": "taweez-qolanj",
  "title": "درد قولنج كا تعويذ",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "درد قولنج كا تعويذ",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِوَجْهِ اللهِ الْعَظِيْم وَبِعِزَّتِهِ الَّتِيْ لَا تُرَامُ"
    },
    {
      "kind": "text",
      "ar": "وَبِقُدْرَتِهِ الَّتِيْ لَا يَمْتَنِعُ مِنْهَا شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "مِنْ شَرِّ هٰذَا الْوَجَعِ وَمِنْ شَرِّ مَا فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ مَا أَجِدُ مِنْهُ"
    },
    {
      "kind": "text",
      "ar": "صَدَقَ اللهُ وَكَذَبَ بَطْنُ اَخِيْكَ۔"
    }
  ]
}