      "kind": "text",
      "ar": "وَشَاهِدِكَ وَنَبِيِّكَ وَنَذِيْرِكَ وَأَمِيْنِكَ وَمَكِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَجِيِّكَ وَنَجِيْبِكَ وَحَبِيْبِكَ وَخَلِيْلِكَ وَصَفِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَفْوَتِكَ وَخَاصَّتِكَ وَخَالِصَتِكَ وَرَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَيْرِ خِيَرَتِكَ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "نَبِيِّ الرَّحْمَةِ، وَخَازِنِ الْمَغْفِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَقَائِدِ الْخَيْرِ وَالْبَرَكَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمُنْقِذِ الْعِبَادِ مِنَ الْهَلَكَةِ بِاِذْنِكَ"
