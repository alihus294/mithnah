{
  "id": "munajat-istikhara",
  "title": "مناجات استخاره",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مناجات استخاره",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ خِيَرَتَكَ فِيَمَا اسْتَخَرْتُكَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "تُنِيْلُ الرَّغَائِبَ وَتُجْزِلُ الْمَوَاهِبَ"
    },
    {
      "kind": "text",
      "ar": "وَتُغْنِمُ الْمَطَالِبَ وَتُطَيِّبُ الْمَكَاسِبَ"
    },
    {
      "kind": "text",
      "ar": "وَتَهْدِيْ اِلٰي أَجْمَلِ الْمَذَاهِبِ"
    },
    {
      "kind": "text",
      "ar": "وَتَسُوْقُ اِلٰي أَحْمَدِ الْعَوَاقِبِ"
    },
    {
      "kind": "text",
      "ar": "وَتَقِيْ مَخُوْفَ النَّوَائِبِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْتَخِيْرُكَ فِيْمَا عَزَمَ رَأْيِيْ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَقَادَنِيْ عَقْلِيْ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَسَهِّلِ اَللّٰهُمَّ فِيْهِ مَا تَوَعَّرَ"
    },
    {
      "kind": "text",
      "ar": "وَيَسِّرْ مِنْهُ مَا تَعَسَّرَ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِنِيْ فِيْهِ الْمُهِمَّ وَادْفَعْ بِهٖ عَنِّيْ كُلَّ مُلِمٍّ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ يَا رَبِّ عَوَاقِبَهٗ غُنْمًا وَمَخُوْفَهٗ سِلْمًا"
    },
    {
      "kind": "text",
      "ar": "وَبُعْدَهٗ قُرْبًا وَجَدْبَهٗ خِصْبًا"
    },
    {
      "kind": "text",
      "ar": "وَأَرْسِلْ اَللّٰهُمَّ اِجَابَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْجِحْ طَلِبَتِيْ وَاقْضِ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاقْطَعْ عَنِّيْ عَوَائِقَهَا وَامْنَعْ عَنِّيْ بَوَائِقَهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنِيْ اَللّٰهُمَّ لِوَاءَ الظَّفَرِ"
    },
    {
      "kind": "text",
      "ar": "وَالْخِيَرَةَ فِيْمَا اسْتَخَرْتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَوُفُوْرَ الْمُغْنِمَ فِيْمَا دَعَوْتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَوَائِدَ الْاِفْضَالِ فِيْمَا رَجَوْتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَاقْرِنْهُ اَللّٰهُمَّ بِالنَّجَاح وَخُصَّهُ بِالصَّلَاح"
    },
    {
      "kind": "text",
      "ar": "وَأَرِنِيْ أَسْبَابَ الْخِيَرَةِ فِيْهِ وَاضِحَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَعْلَامَ غُنْمِهَا لَائِحَةً"
    },
    {
      "kind": "text",
      "ar": "وَاشْدُدْ خِنَاقَ تَعْسِيْرِهَا وَانْعَشْ صَرِيْعَ تَيْسِيْرِهَا"
    },
    {
      "kind": "text",
      "ar": "وَبَيِّنِ اَللّٰهُمَّ مُلْتَبَسَهَا وَأَطْلِقْ مُحْتَبَسَهَا"
    },
    {
      "kind": "text",
      "ar": "وَمَكِّنْ أُسَّهَا حَتّٰي تَكُوْنَ خِيَرَةً مُقْبِلَةً بِالْغُنْمِ"
    },
    {
      "kind": "text",
      "ar": "مُزِيْلَةً لِلْغُرْمِ عَاجِلَةً لِلنَّفْعِ بَاقِيَةَ الصُّنْع"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ مَلِيْءٌ بِالْمَزِيْدِ مُبْتَدِئٌ بِالْجُوْدِ"
    }
  ]
}