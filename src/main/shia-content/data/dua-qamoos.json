{
  "id": "dua-qamoos",
  "title": "دعاء سيفي صغير",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء سيفي صغير",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "رَبِّ أَدْخِلْنِيْ فِيْ لُجَّةِ بَحْرِ أَحَدِيَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَطَمْطَامِ يَمِّ وَحْدَانِيَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَوِّنِيْ بِقُوَّةِ سَطْوَةِ سُلْطَانِ فَرْدَانِيَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَخْرُجَ اِلٰي فَضَاءِ سَعَةِ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ وَجْهِيْ لَمَعَاتُ بَرْقِ الْقُرْبِ مِنْ اٰثَارِ حِمَايَتِكَ"
    },
    {
      "kind": "text",
      "ar": "مَهِيْبًا بِهَيْبَتِكَ، عَزِيْزًا بِعِنَايَتِكَ"
    },
    {
      "kind": "text",
      "ar": "مُتَجَلِّلًا مُكَرَّمًا بِتَعْلِيْمِكَ وَتَزْكِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْنِيْ خِلَعَ الْعِزَّةِ وَالْقَبُوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَسَهِّلْ لِيْ مَنَاهِجَ الْوُصْلَةِ وَالْوُصُوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَتَوِّجْنِيْ بِتَاجِ الْكَرَامَةِ وَالْوَقَارِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلِّفْ بَيْنِيْ وَبَيْنَ أَحِبَّائِكَ فِيْ دَارِ الدُّنْيَا وَدَارِ الْقَرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ مِنْ نُوْرِ اسْمِكَ هَيْبَةً وَسَطْوَةً"
    },
    {
      "kind": "text",
      "ar": "تَنْقَادُ لِيَ الْقُلُوْبُ وَالْاَرْوَاحُ"
    },
    {
      "kind": "text",
      "ar": "وَتَخْضَعُ لَدَيَّ النُّفُوْسُ وَالْاَشْبَاحُ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ ذَلَّتْ لَهٗ رِقَابُ الْجَبَابِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَخَضَعَتْ لَدَيْهِ أَعْنَاقُ الْاَكَاسِرَةِ"
    },
    {
      "kind": "text",
      "ar": "لَا مَلْجَأَ وَلَا مَنْجٰى مِنْكَ اِلَّا اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا اِعَانَةَ اِلَّا بِكَ، وَلَا اتِّكَاءَ اِلَّا عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "اِدْفَعْ عَنِّيْ كَيْدَ الْحَاسِدِيْنَ، وَظُلُمَاتِ شَرِّ الْمُعَانِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْنِيْ تَحْتَ سُرَادِقَاتِ عَرْشِكَ يَا أَكْرَمَ الْاَكْرَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَيِّدْ ظَاهِرِيْ فِيْ تَحْصِيْلِ مَرَاضِيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَوِّرْ قَلْبِيْ وَسِرِّيْ بِالْاِطِّلَاعِ عَلٰي مَنَاهِجِ مَسَاعِيْكَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ كَيْفَ أَصْدُرُ عَنْ بَابِكَ بِخَيْبَةٍ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ وَرَدْتُهٗ عَلٰي ثِقَةٍ بِكَ"
    },
    {
      "kind": "text",
      "ar": "وَكَيْفَ تُؤْيِسُنِيْ مِنْ عَطَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ أَمَرْتَنِيْ بِدُعَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَهَا أَنَا مُقْبِلٌ عَلَيْكَ، مُلْتَجِيٌ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "بَاعِدْ بَيْنِيْ وَبَيْنَ أَعْدَائِيْ"
    },
    {
      "kind": "text",
      "ar": "كَمَا بَاعَدْتَ بَيْنَ أَعْدَائِيْ"
    },
    {
      "kind": "text",
      "ar": "اخْتَطِفْ أَبْصَارَهُمْ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "بِنُوْرِ قُدْسِكَ وَجَلَالِ مَجْدِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ اللهُ الْمُعْطِيْ جَلَائِلَ النِّعَمِ الْمُكَرَّمَةِ"
    },
    {
      "kind": "text",
      "ar": "لِمَنْ نَاجَاكَ بِلَطَائِفِ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ يَا قَيُّوْمُ يَا ذَا الْجَلَالِ وَالْاِكْرَامِ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي سَيِّدِنَا وَنَبِيِّنَا مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاٰلِهٖ أَجْمَعِيْنَ الطَّيِّبِيْنَ الطَّاهِرِيْنَ"
    }
  ]
}