{
  "id": "taqibat-dua-misbah",
  "title": "مصباح ميں هر نماز كے بعد كي دعا",
  "subtitle": "تعقيبات الصلاة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مصباح ميں هر نماز كے بعد كي دعا",
      "subtitle": "تعقيبات الصلاة"
    },
    {
      "kind": "text",
      "ar": "أُعِيْذُ نَفْسِيْ وَدِيْنِيْ وَأَهْلِيْ وَمَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَوَلَدِيْ وَاِخْوَانِيْ فِيْ دِيْنِيْ وَمَا رَزَقَنِيْ رَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَخَوَاتيمَ عَمَلِيْ، وَمَنْ يَعْنِيْنِيْ أَمْرُهٗ"
    },
    {
      "kind": "text",
      "ar": "بِاللّٰهِ الْوَاحِدِ الْاَحَدِ الصَّمَدِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَمْ يَلِدْ وَلَمْ يُوْلَدْ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ كُفُوًا أَحَدٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِرَبِّ الْفَلَقِ مِنْ شَرِّ مَا خَلَقَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شرِّ غَاسِقٍ اِذَا وَقَبَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ"
    },
    {
      "kind": "text",
      "ar": "وَبِرَبِّ النَّاسِ، مَلِكِ النَّاسِ، اِلٰهِ النَّاسِ"
    },
    {
      "kind": "text",
      "ar": "مِنْ شَرِّ الْوَسْوَاسِ الخَنَّاسِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْجِنَّةِ وَالنَّاسِ"
    }
  ]
}