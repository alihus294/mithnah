  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ستائيسويں رمضان كي رات",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ ارْزُقْنِي التَّجَافِيَ عَنْ دَارِ الْغُرُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِنَابَةَ اِلٰي دَارِ الْخُلُوْدِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِسْتِعْدَادَ لِلْمَوْتِ قَبْلَ حُلُوْلِ الْفَوتِ۔"
    }
  ]
}