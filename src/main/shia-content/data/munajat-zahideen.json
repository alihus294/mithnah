{
  "id": "munajat-zahideen",
  "title": "۱۵۔ مناجات زاهدين",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۵۔ مناجات زاهدين",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ أَسْكَنْتَنَا دَارًا حَفَرَتْ لَنَا حُفَرَ مَكْرِهَا"
    },
    {
      "kind": "text",
      "ar": "وَعَلَّقَتْنَا بِأَيْدِي الْمَنَايَا فِيْ حَبَائِلِ غَدْرِهَا"
    },
    {
      "kind": "text",
      "ar": "فَاِلَيْكَ نَلْتَجِيُ مِنْ مَكَائِدِ خُدَعِهَا"
    },
    {
      "kind": "text",
      "ar": "وَبِكَ نَعْتَصِمُ مِنَ الْاِغْتِرَارِ بِزَخَارِفِ زِيْنَتِهَا"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهَا الْمُهْلِكَةُ طُلَّابَهَا، الْمُتْلِفَةُ حُلَّالَهَا"
    },
    {
      "kind": "text",
      "ar": "الْمَحْشُوَّةُ بِالْاٰفَاتِ، الْمَشْحُوْنَةُ بِالنَّكَبَاتِ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ فَزَهِّدْنَا فِيْهَا، وَسَلِّمْنَا مِنْهَا بِتَوْفِيْقِكَ وَعِصْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَانْزَعْ عَنَّا جَلَابِيْبَ مُخَالَفَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَلَّ أُمُوْرَنَا بِحُسْنِ كِفَايَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْفِرْ مَزِيْدَنَا مِنْ سَعَةِ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْمِلْ صِلَاتِنَا مِنْ فَيْضِ مَوَاهِبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْرِسْ فِيْ أَفْئِدَتِنَا أَشْجَارَ مَحَبَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَتْمِمْ لَنَا أَنْوَارَ مَعْرِفَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَذِقْنَا حَلَاوَةَ عَفْوِكَ وَلَذَّةَ مَغْفِرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَقْرِرْ أَعْيُنَنَا يَوْمَ لِقَائِكَ بِرُؤْيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَخْرِجْ حُبَّ الدُّنْيَا مِنْ قُلُوْبِنَا"
    },
    {
      "kind": "text",
      "ar": "كَمَا فَعَلْتَ بِالصَّالِحِيْنَ مِنْ صَفْوَتِكَ وَالْاَبْرَارِ مِنْ خَاصَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ، وَيَا أَكْرَمَ الْاَ كْرَمِيْنَ"
    }
  ]
}