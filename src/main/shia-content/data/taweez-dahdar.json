  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دهدر كا تعويذ",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "وَيَسْأَلُوْنَكَ عَنِ الْجِبَالِ"
    },
    {
      "kind": "text",
      "ar": "فَقُلْ يَنْسِفُهَا رَبِّيْ نَسْفًا فَيَذَرُهَا قَاعًا صَفْصَفًا"
    },
    {
      "kind": "text",
      "ar": "لَا تَرٰي فِيْهَا عِوَجًا وَلَا أَمْتًا۔"
    }
  ]
