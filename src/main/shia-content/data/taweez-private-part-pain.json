  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "شرمگاه كے درد كي دعا",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ، بَلٰي مَنْ أَسْلَمَ وَجْهَهٗ لِلّٰهِ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ مُحْسِنٌ فَلَهٗ أَجْرُهٗ عِنْدَ رَبِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُوْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ اِنِّيْ أَسْلَمْتُ وَجْهِيْ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَفَوَّضْتُ أَمْرِيْ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "لَا مَلْجَأَ وَلَا مَنْجٰي مِنْكَ اِلَّا اِلَيْكَ۔"
    }
  ]
}