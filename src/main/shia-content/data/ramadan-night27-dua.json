{
  "id": "ramadan-night27-dua",
  "title": "ستائيسويں شب كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ستائيسويں شب كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا مَادَّ الظِّلِّ وَلَوْ شِئْتَ لَجَعَلْتَهٗ سَاكِنًا"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَ الشَّمْسَ عَلَيْهِ دَلِيْلًا"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ قَبَضْتَهٗ اِلَيْكَ قَبْضًا يَسِيْرًا"
    },
    {
      "kind": "text",
      "ar": "يَا ذَا الْجُوْدِ وَالطَّوْلِ وَالْكِبْرِيَاءِ وَالْاٰلَاءِ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الرَّحْمٰنُ الرَّحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ يَا قُدُّوْسُ يَا سَلَامُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُؤْمِنُ يَا مُهَيْمِنُ يَا عَزِيْزُ يَا جَبَّارُ يَا مُتَكَبِّرُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا خَالِقُ يَا بَارِئُ يَا مُصَوِّرُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا اللهُ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْاَسْمَاءُ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْاَمْثَالُ الْعُلْيَا، وَالْكِبْرِيَاءُ وَالْاٰلَاءُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ اسْمِيْ فِيْ هٰذِهِ اللَّيْلَةِ فِي السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَرُوْحِيْ مَعَ الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاِحْسَانِيْ فِيْ عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِسَائَتِيْ مَغْفُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَهَبَ لِيْ يَقِيْنًا تُبَاشِرُ بِهٖ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِيْمَانًا يُذْهِبُ الشَّكَّ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُرْضِيَنِيْ بِمَا قَسَمْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْاٰخِرَةِ حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِنَا عَذَابَ النَّارِ الْحَرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ فِيْهَا ذِكْرَكَ وَشُكْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّغْبَةَ اِلَيْكَ وَالْاِنَابَةَ وَالتَّوْبَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّوْفِيْقَ لِمَا وَفَّقْتَ لَهٗ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِ وَعَلَيْهِمْ۔"
    }
  ]
}