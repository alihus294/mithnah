      "ar": "وَاجْعَلْهُ الْقَائِمَ بِأَمْرِكَ وَالْمُنْتَصِرَ لِدِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرِهٖ مَا يُحِبُّ وَمَا تَقَرُّ بِهٖ عَيْنُهٗ فِيْ نَفْسِهٖ وَذُرِّيَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ أَهْلِهٖ وَمَالِهٖ وَفِيْ شِيْعَتِهٖ وَفِيْ عَدُوِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَرِهِمْ مِنْهُ مَا يَحْذَرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرِهٖ فِيْهِمْ مَا يُحِبُّ وَتُقِرُّ بِهٖ عَيْنَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاشْفِ بِهٖ صُدُوْرَنَا وَصُدُوْرَ قَوْمٍ مُؤْمِنِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْ لِيْ مَا قَدَّمْتُ وَمَا أَخَّرْتُ"
    },
    {
      "kind": "text",
      "ar": "وَمَا أَسْرَرْتُ وَمَا أَعْلَنْتُ"
    },
    {
      "kind": "text",
      "ar": "وَاِسْرَافِيْ عَلٰي نَفْسِيْ وَمَا أَنْتَ أَعْلَمُ بِهٖ مِنِّيْ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ أَنْتَ الْمُقَدِّمُ وَالْمُؤَخِّرُ، لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "بِعِلْمِكَ الْغَيْب وَبِقُدْرَتِكَ عَلَي الْخَلْقِ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مَا عَلِمْتَ الْحَيَاةَ خَيْرًا لِيْ فَأَحْيِنِيْ"
