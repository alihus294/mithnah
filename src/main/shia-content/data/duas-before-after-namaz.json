    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الْغَنِيُّ عَنِّيْ وَبِيَ الْفَاقَةُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ الْغَنِيُّ وَأَنَا الْفَقِيْرُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "أَقَلْتَنِيْ عَثْرَتِيْ وَسَتَرْتَ عَلَيَّ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاقْضِ الْيَوْمَ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُعَذِّبْنِيْ بِقَبِيْحِ مَا تَعْلَمُ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "بَلْ عَفْوُكَ وَجُوْدُكَ يَسَعُنِيْ۔"
