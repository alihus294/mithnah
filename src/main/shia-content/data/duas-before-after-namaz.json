    {
      "kind": "text",
      "ar": "وَأُجِيْرُ نَفْسِيْ وَمَالِيْ وَوَلَدِيْ وَكُلَّ مَا هُوَ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "بِرَبِّ النَّاسِ مَلِكِ النَّاسِ ...... تا آخر سوره"
    },
    {
      "kind": "text",
      "ar": "وَأُجِيْرُ نَفْسِيْ وَمَالِيْ وَوَلَدِيْ وَكُلَّ مَا هُوَ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "بِاللّٰه لَا اِلٰهَ اِلَّا هُوَ الْحَيُّ الْقَيُّوْمُ"
    },
    {
      "kind": "text",
      "ar": "لَا تَأْخُذُهٗ سِنَةٌ وَلَا نَوْمٌ ...... تا آخر آية الكرسي"
