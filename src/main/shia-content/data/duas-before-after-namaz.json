    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَتَوَجَّهُ اِلَيْكَ بِمُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأُقَدِّمُهُمْ بَيْنَ يَدَيْ صَلَوَاتِيْ وَأَتَقَرَّبُ بِهِمْ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَاجْعَلْنِيْ بِهِمْ وَجِيْهًا فِي الدُّنْيَا وَالْاٰخِرَةِ وَمِنَ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مَنَنْتَ عَلَيَّ بِمَعْرِفَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "فَاخْتِم لِيْ بِطَاعَتِهِمْ وَمَعْرِفَتِهِمْ وَوِلَايَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهَا السَّعَادَةُ وَاخْتِمْ لِيْ بِهَا"
