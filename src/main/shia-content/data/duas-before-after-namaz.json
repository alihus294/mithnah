      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ مَعَ مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "فِيْ كُلِّ عَافِيَةٍ وَبَلَاءٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مَعَ مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "فِيْ كُلِّ مَثْوًي وَمُنْقَلَبٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ مَحْيَايَ مَحْيَاهُمْ وَمَمَاتِيْ مَمَاتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مَعَهُمْ فِي الْمَوَاطِنِ كُلِّهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُفَرِّقْ بَيْنِيْ وَبَيْنَهُمْ"
