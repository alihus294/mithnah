{
  "id": "hijab-imam-kazim",
  "title": "۱۸۔ حجاب امام موسيٰ كاظم",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۸۔ حجاب امام موسيٰ كاظم",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "تَوَكَّلْتُ عَلَي الْحَيِّ الَّذِيْ لَا يَمُوْتُ"
    },
    {
      "kind": "text",
      "ar": "وَتَحَصَّنْتُ بِذِي الْعِزَّةِ وَالْجَبَرُوْتِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَعَنْت بِذِي الْكِبْرِيَاءِ وَالْمَلَكُوْتِ"
    },
    {
      "kind": "text",
      "ar": "مَوْلَايَ اسْتَسْلَمْتُ اِلَيْكَ فَلَا تُسْلِمْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَكَّلْتُ عَلَيْك فَلَا تَخْذُلْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَجَأْتُ اِلٰي ظِلِّكَ الْبَسِيْطِ فَلَا تَطْرَحْنِيْ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ الْمَطْلَبُ وَاِلَيْكَ الْمَهْرَبُ"
    },
    {
      "kind": "text",
      "ar": "تَعْلَمُ مَا أُخْفِيْ وَمَا أُعْلِنُ"
    },
    {
      "kind": "text",
      "ar": "وَتَعْلَمُ خَائِنَةَ الْاَعْيُنِ وَمَا تُخْفِي الصُّدُوْرُ"
    },
    {
      "kind": "text",
      "ar": "فَأَمْسِكْ عَنِّيْ اَللّٰهُمَّ أَيْدِي الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْجِنِّ وَالْاِنْسِ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاشْفِنِيْ وَعَافِنِيْ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}