{
  "id": "duas-illness",
  "title": "۸۔ بيماريوں كے ليے",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۸۔ بيماريوں كے ليے",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ كَمْ مِنْ نِعْمَةٍ لِلّٰهِ"
    },
    {
      "kind": "text",
      "ar": "فِيْ عِرْقٍ سَاكِنٍ وَغَيْرِ سَاكِنٍ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي عَبْدٍ شَاكِرٍ وَغَيْرِ شَاكِرٍ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَرِّجْ عَنِّيْ كُرْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَجِّلْ عَافِيَتِيْ وَاكْشِفْ ضُرِّيْ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ وَمُحَمَّدٌ رَسُوْلُ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰه"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ امْسَحْ عنِّيْ مَا أَجِدُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ تَعْجِيْلَ عَافِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَبْرًا عَلٰي بَلِيَّتِكَ وَخُرُوْجًا اِلٰي رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُك بِحَقِّ الْقُرْاٰنِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ نَزَلَ بِهِ الرُّوْحُ الْاَمِيْنُ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عِنْدَكَ فِيْ أُمِّ الْكِتَابِ عَلِيٌّ حَكِيْمٌ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَشْفِيَنِيْ بِشِفَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتُدَاوِيَنِيْ بِدَوَائِكَ، وَتُعَافِيَنِيْ مِنْ بَلَائِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَجْوَدَ مَنْ أَعْطٰي، وَيَا خَيْرَ مَنْ سُئِلَ، وَيَا أَرْحَمَ مَنِ اسْتُرْحِمَ"
    },
    {
      "kind": "text",
      "ar": "اِرْحَمْ ضَعْفِيْ وَقِلَّةَ حِيْلَتِيْ، وَاعْفِنِيْ مِنْ وَجَعِيْ"
    }
  ]
}