{
  "id": "ism-azam",
  "title": "اسم اعظم",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "اسم اعظم",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "﴿۱﴾ اللهُ لَا اِلٰهَ اِلَّا هُوَ الْحَيُّ الْقَيُّوْمُ"
    },
    {
      "kind": "text",
      "ar": "﴿۲﴾ اللهُ لَا اِلٰهَ اِلَّا هُوَ الْحَيُّ الْقَيُّوْمُ"
    },
    {
      "kind": "text",
      "ar": "نَزَّل عَلَيْكَ الْكِتَابَ بِالْحَقِّ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزَلَ التَّوْرَاةَ وَالْاِنْجِيْلَ مِنْ قَبْلُ هُدًى لِلنَّاسِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزَلَ الْفُرْقَانَ۔"
    },
    {
      "kind": "text",
      "ar": "﴿۳﴾ اللهُ لَا اِلٰهَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "لَيَجْمَعَنَّكُمْ اِلٰي يَوْمِ الْقِيَامَةِ لَا رَيْبَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ أَصْدَقُ مِنَ اللهِ حَدِيْثًا"
    },
    {
      "kind": "text",
      "ar": "﴿۴﴾ اللهُ لَا اِلٰهَ اِلَّا هُوَ لَهُ الْاَسْمَاءُ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "﴿۵﴾ اللهُ لَا اِلٰهَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي اللهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُوْنَ۔"
    }
  ]
}