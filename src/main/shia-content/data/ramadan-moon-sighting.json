{
  "id": "ramadan-moon-sighting",
  "title": "رويتِ هلال كے وقت كي دعائيں",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "رويتِ هلال كے وقت كي دعائيں",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "رَبِّيْ وَرَبُّكَ اللهُ رَبُّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَهِلَّهٗ عَلَيْنَا بِالْاَمْنِ وَالْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّلَامَةِ وَالْاِسْلَامِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسَارَعَةِ اِلٰي مَا تُحِبُّ وَتَرْضٰي۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بَارِكْ لَنَا فِيْ شَهْرِنَا هٰذَا"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنَا خَيْرَهٗ وَعَوْنَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاصْرِفْ عَنَّا ضُرَّهٗ وَشَرَّهٗ وَبَلَائَهٗ وَفِتْنَتَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَهِلَّهٗ عَلَيْنَا بِالْاَمْنِ وَالْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّلَامَةِ وَالْاِسْلَامِ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَافِيَةِ الْمُجَلَّلَةِ وَدِفَاعِ الْاَسْقَامِ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَوْنِ عَلَي الصَّلَاةِ وَالصِّيَامِ"
    },
    {
      "kind": "text",
      "ar": "وَالْقِيَامِ وَتِلَاوَةِ الْقُرْاٰنِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ سَلِّمْنَا لِشَهْرِ رَمَضَانَ، وَتَسَلَّمْهُ مِنّا"
    },
    {
      "kind": "text",
      "ar": "وَسَلِّمْنَا فِيْهِ حَتّٰي يَنْقَضِيَ عَنَّا شَهْرُ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ عَفَوْتَ عَنَّا وَغَفَرْتَ لَنَا وَرَحِمْتَنَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ قَدْ حَضَرَ شَهْرُ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدِ افْتَرضْتَ عَلَيْنَا صِيَامَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزَلْتَ فِيْهِ الْقُرْاٰنَ هُدًى لِلنّاسِ"
    },
    {
      "kind": "text",
      "ar": "وَبَيِّنَاتٍ مِنَ الْهُدٰي وَالْفُرْقَانِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعِنَّا عَلٰي صِيَامِهٖ، وَتَقَبَّلْهُ مِنّا"
    },
    {
      "kind": "text",
      "ar": "وَسَلِّمْنَا فِيْهِ، وَسَلِّمْنَا مِنْهُ"
    },
    {
      "kind": "text",
      "ar": "وَسَلِّمْهُ لَنَا فِيْ يُسْرٍ مِنْكَ وَعَافِيَةٍ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ، يَا رَحْمٰنُ يَا رَحِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "أَيُّهَا الْخَلْقُ الْمُطِيْعُ، الدَّائِبُ السَّرِيْعُ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَرَدِّدُ فِيْ مَنَازِلِ التَّقْدِيْرِ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَصَرِّفُ فِيْ فَلَكِ التَّدْبِيْرِ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنْتُ بِمَنْ نَوَّرَ بِكَ الظُّلَمَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْضَحَ بِكَ الْبُهَمَ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَكَ اٰيَةً مِنْ اٰيَاتِ مُلْكِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَامَةً مِنْ عَلَامَاتِ سُلْطَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَحَدَّ بِكَ الزَّمَانَ وَامْتَهَنَكَ بِالْكَمَالِ وَالنُّقْصَانِ"
    },
    {
      "kind": "text",
      "ar": "وَالطُّلُوْعِ وَالْاُفُوْلِ وَالْاِنَارَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالْكُسُوْفِ فِيْ كُلِّ ذٰلِكَ أَنْتَ لَهٗ مُطِيْعٌ"
    },
    {
      "kind": "text",
      "ar": "وَاِلٰي اِرَادَتِهٖ سَرِيْعٌ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَهٗ مَا أَعْجَبَ مَا دَبَّرَ مِنْ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْطَفَ مَا صَنَعَ فِيْ شَأْنِكَ"
    },
    {
      "kind": "text",
      "ar": "جَعَلَكَ مِفْتَاحَ شَهْرٍ حَادِثٍ لِاَمْرٍ حَادِثٍ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْأَلُ اللهَ رَبِّيْ وَرَبَّكَ، وَخَالِقِيْ وَخَالِقَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُقَدِّرِيْ وَمُقَدِّرَكَ، وَمُصَوِّرِيْ وَمُصَوِّرَكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ يُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ يَجْعَلَكَ هِلَالَ بَرَكَةٍ لَا تَمْحَقُهَا الْاَيَّامُ"
    },
    {
      "kind": "text",
      "ar": "وَطَهَارَةٍ لَا تُدَنِّسُهَا الْاٰثَامُ"
    },
    {
      "kind": "text",
      "ar": "هِلَالَ أَمْنٍ مِنَ الْاٰفَاتِ، وَسَلَامَةٍ مِنَ السَّيِّئَاتِ"
    },
    {
      "kind": "text",
      "ar": "هِلَالَ سَعْدٍ لَا نَحْسَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَيُمْنٍ لَا نَكَدَ مَعَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَيُسْرٍ لَا يُمَازِجُهٗ عُسْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَخيْرٍ لَا يَشُوْبُهٗ شَرٌّ"
    },
    {
      "kind": "text",
      "ar": "هِلَالَ أَمْنٍ وَاِيْمَانٍ وَنِعْمَةٍ وَاِحْسَانٍ وَسَلَامَةٍ وَاِسْلَامٍ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا مِنْ أَرْضٰي مَنْ طَلَعَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَزْكٰي مَنْ نَظَرَ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْعَدَ مَنْ تَعَبَّدَ لَكَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَوَفِّقْنَا اَللّٰهُمَّ فِيْهِ لِلطَّاعَةِ وَالتَّوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاعْصِمْنَا فِيْهِ مِنَ الْاٰثَامِ وَالْحَوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْزِعْنَا فِيْهِ شُكْرَ النِّعْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْنَا فِيْهِ جُنَنَ الْعَافِيَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَتْمِمْ عَلَيْنَا بِاسْتِكْمَالِ طَاعَتِكَ فِيْهِ الْمِنَّةَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الْمَنّانُ الْحَمِيْدُ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِهِ الطَّيِّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لَنَا فِيْهِ عَوْنًا مِنْكَ عَلٰي مَا نَدَبْتَنَا اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "مِنْ مُفْتَرَضِ طَاعَتِكَ وَتَقَبَّلْهَا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ الْاَكْرَمُ مِنْ كُلِّ كَرِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَرْحَمُ مِنْ كُلِّ رَحِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "اٰمِيْنَ اٰمِيْنَ رَبَّ الْعَالَمِيْنَ۔"
    }
  ]
}