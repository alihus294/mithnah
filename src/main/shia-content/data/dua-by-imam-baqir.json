{
  "id": "dua-by-imam-baqir",
  "title": "۱۵۔ امام محمد باقر كي دعا",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۵۔ امام محمد باقر كي دعا",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ الله الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "حَسْبِيَ اللهُ تَوَكَّلْتُ عَلَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ خَيْرَ أُمُوْرِيْ كُلِّهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ مِنْ خِزْيِ الدُّنْيَا وَعَذَابِ الْاٰخِرَةِ"
    }
  ]
}