{
  "id": "munajat-raghibeen",
  "title": "۵۔ مناجات راغبين",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۵۔ مناجات راغبين",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِنْ كَانَ قَلَّ زَادِيْ فِي الْمَسِيْرِ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَقَدْ حَسُنَ ظَنِّيْ بِالتَّوَكُّلِ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ كَانَ جُرْمِيْ قَدْ أَخَافَنِيْ مِنْ عُقُوْبَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ رَجَائِيْ قَدْ أَشْعَرَنِيْ بِالْاَمْنِ مِنْ نِقْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ كَانَ ذَنْبِيْ قَدْ عَرَّضَنِيْ لِعِقَابِكَ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ اٰذَنَنِيْ حُسْنُ ثِقَتِيْ بِثَوَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ أَنَامَتْنِي الْغَفْلَةُ عَنِ الْاِسْتِعْدَادِ لِلِقَائِكَ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ نَبَّهَتْنِي الْمَعْرِفَةُ بِكَرَمِكَ وَاٰلَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ أَوْحَشَ مَا بَيْنِيْ وَبَيْنَكَ فَرْطُ الْعِصْيَانِ وَالطُّغْيَانِ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ اٰنَسَنِيْ بُشْرَي الْغُفْرَانِ وَالرِّضْوَانِ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِسُبُحَاتِ وَجْهِكَ وَبِأَنْوَارِ قُدْسِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْتَهِلُ اِلَيْكَ بِعَوَاطِفِ رَحْمَتِكَ، وَلَطَائِفِ بِرِّكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُحَقِّقَ ظَنِّيْ بِمَا أُؤَمِّلُهٗ"
    },
    {
      "kind": "text",
      "ar": "مِنْ جَزِيْلِ اِكْرَامِكَ، وَجَمِيْلِ اِنْعَامِكَ"
    },
    {
      "kind": "text",
      "ar": "فِي الْقُرْبٰي مِنْكَ، وَالزُّلْفٰي لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّمَتُّعِ بِالنَّظَرِ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَهَا أَنَا مُتَعَرِّضٌ لِنَفَحَاتِ رَوْحِكَ وَعَطْفِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُنْتَجِعٌ غَيْثَ جُوْدِكَ وَلُطْفِكَ"
    },
    {
      "kind": "text",
      "ar": "فَارٌّ مِنْ سَخَطِكَ اِلٰي رِضَاكَ"
    },
    {
      "kind": "text",
      "ar": "هَارِبٌ مِنْكَ اِلَيْكَ، رَاجٍ أَحْسَنَ مَا لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "مُعَوِّلٌ عَلٰي مَوَاهِبِكَ، مُفْتَقِرٌ اِلٰي رِعَايَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ مَا بَدَأْتَ بِهٖ مِنْ فَضْلِكَ فَتَمِّمْهُ"
    },
    {
      "kind": "text",
      "ar": "وَمَا وَهَبْتَ لِيْ مِنْ كَرَمِكَ فَلَا تَسْلُبْهُ"
    },
    {
      "kind": "text",
      "ar": "وَمَا سَتَرْتَهٗ عَلَيَّ بِحِلْمِكَ فَلَا تَهْتِكْهُ"
    },
    {
      "kind": "text",
      "ar": "وَمَا عَلِمْتَهٗ مِنْ قَبِيْحِ فِعْلِيْ فَاغْفِرْهُ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اسْتَشْفَعْتُ بِكَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَجَرْتُ بِكَ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ طَامِعًا فِيْ اِحْسَانِكَ"
    },
    {
      "kind": "text",
      "ar": "رَاغِبًا فِي امْتِنَانِكَ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَسْقِيًا وَابِلَ طَوْلِكَ، مُسْتَمْطِرًا غَمَامَ فَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "طَالِبًا مَرْضَاتَكَ، قَاصِدًا جَنَابَكَ"
    },
    {
      "kind": "text",
      "ar": "وَارِدًا شَرِيْعَةَ رِفْدِك"
    },
    {
      "kind": "text",
      "ar": "مُلْتَمِسًا سَنِيَّ الْخَيْرَاتِ مِنْ عِنْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَافِدًا اِلٰي حَضْرَةِ جَمَالِكَ، مُرِيْدًا وَجْهَكَ"
    },
    {
      "kind": "text",
      "ar": "طَارِقًا بَابَكَ، مُسْتَكِيْنًا لِعَظَمَتِكَ وَجَلَالِكَ"
    },
    {
      "kind": "text",
      "ar": "فَافْعَلْ بِيْ مَا أَنْتَ أَهْلُهٗ مِنَ الْمَغْفِرَةِ وَالرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَفْعَلْ بِيْ مَا أَنَا أَهْلُهٗ مِنَ الْعَذَابِ وَالنِّقْمَةِ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}