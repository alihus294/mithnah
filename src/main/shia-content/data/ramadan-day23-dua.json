{
  "id": "ramadan-day23-dua",
  "title": "تئيسويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تئيسويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْسِلْنِيْ فِيْهِ مِنَ الذُّنُوْبِ"
    },
    {
      "kind": "text",
      "ar": "وَطَهِّرْنِيْ فِيْهِ مِنَ الْعُيُوْبِ"
    },
    {
      "kind": "text",
      "ar": "وَامْتَحِنْ قَلْبِيْ فِيْهِ بِتَقْوَي الْقُلُوْبِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُقِيْلَ عَثَرَاتِ الْمُذْنِبِيْنَ۔"
    }
  ]
}