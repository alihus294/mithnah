{
  "id": "ziarat-hujjat-friday",
  "title": "زيارت امام العصر روز جمعه",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت امام العصر روز جمعه",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ فِيْ أَرْضِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا عَيْنَ اللهِ فِيْ خَلْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نُوْرَ اللهِ الَّذِيْ يَهْتَدِيْ بِهِ الْمُهْتَدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيُفَرَّجُ بِهٖ عَنِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْمُهَذَّبُ الْخَائِفُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْوَلِيُّ النَّاصِحُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا سَفِيْنَةَ النَّجَاةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا عَيْنَ الْحَيَاةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ، صَلَّي اللهُ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي اٰلِ بَيْتِكَ الطَّيِّبِيْنَ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ عَجَّلَ اللهُ لَكَ مَا وَعَدَكَ مِنَ النَّصْرِ وَظُهُوْرِ الْاَمْرِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "أَنَا مَوْلَاكَ عَارِفٌ بِأُوْلَاكَ وَأُخْرَاكَ"
    },
    {
      "kind": "text",
      "ar": "أَتَقَرَّبُ اِلَي اللهِ تَعَالٰي بِكَ وَبِاٰلِ بَيْتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَظِرُ ظُهُوْرَكَ وَظُهُوْرَ الْحَقِّ عَلٰي يَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُ اللهَ أَنْ يُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ يَجْعَلَنِيْ مِنَ الْمُنْتَظِرِيْنَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّابِعِيْنَ وَالنَّاصِرِيْنَ لَكَ عَلٰي أَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسْتَشْهَدِيْنَ بَيْنَ يَدَيْكَ فِيْ جُمْلَةِ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ يَا صَاحِبَ الزَّمَانِ،"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْكَ وَعَلٰي اٰلِ بَيْتِكَ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا يَوْمُ الْجُمُعَةِ وَهُوَ يَوْمُكَ الْمُتَوَقَّعُ فِيْهِ ظُهُوْرُكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَرَجُ فِيْهِ لِلْمُؤْمِنِيْنَ عَلٰي يَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَتْلُ الْكَافِرِيْنَ بِسَيْفِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا يَا مَوْلَايَ فِيْهِ ضَيْفُكَ وَجَارُكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ يَا مَوْلَايَ كَرِيْمٌ مِنْ أَوْلَادِ الْكِرَامِ"
    },
    {
      "kind": "text",
      "ar": "وَمَأْمُوْرٌ بِالضِّيَافَةِ وَالْاِجَارَةِ"
    },
    {
      "kind": "text",
      "ar": "فَأَضِفْنِيْ وَأَجِرْنِيْ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْكَ وَعَلٰي أَهْلِ بَيْتِكَ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "نزيلك حيث ما اتحهت ركابي وضيفك حيث كنت من البلاد"
    }
  ]
}