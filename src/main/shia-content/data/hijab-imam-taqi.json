{
  "id": "hijab-imam-taqi",
  "title": "۱۹۔ حجاب امام محمد تقي",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۹۔ حجاب امام محمد تقي",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "الْخَالِقُ أَعْظَمُ مِنَ الْمَخْلُوْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّازِقُ أَبْسَطُ يَدًا مِنَ الْمَرْزُوْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَنَارُ اللهِ الْمُؤْصَدَةُ فِيْ عَمَدٍ مُمَدَّدَةٍ"
    },
    {
      "kind": "text",
      "ar": "تَكِيْدُ أَفْئِدَةَ الْمَرَدَةِ"
    },
    {
      "kind": "text",
      "ar": "وَتَرُدُّ كَيْدَ الْحَسَدَةِ بِالْاَقْسَامِ بِالْاَحْكَامِ"
    },
    {
      "kind": "text",
      "ar": "بِاللَّوْحِ الْمَحْفُوْظِ وَالْحِجَابِ الْمَضْرُوْبِ"
    },
    {
      "kind": "text",
      "ar": "بِعَرْشِ رَبِّنَا الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "احْتَجَبْتُ وَاسْتَتَرْتُ وَاسْتَجَرْتُ وَاعْتَصَمْتُ"
    },
    {
      "kind": "text",
      "ar": "وَتَحَصَّنْتُ بِالٓم وَبِكٓهٰيٰعٓصٓ وَبِطٰهٰ وَبِطٰسٓمٓ"
    },
    {
      "kind": "text",
      "ar": "وَبِحٰمٓ وَبِحٰمٓعٓسٓقٓ وَنُوْٓن وَبِطٰسِيْن وَبِقٓ"
    },
    {
      "kind": "text",
      "ar": "وَالْقُرْاٰنِ الْمَجِيْدِ وَاِنَّهٗ لَقَسَمٌ لَوْ تَعْلَمُوْنَ عَظِيْمٌ"
    },
    {
      "kind": "text",
      "ar": "وَاللهُ وَلِيِّيْ وَنِعْمَ الْوَكِيْلُ"
    }
  ]
}