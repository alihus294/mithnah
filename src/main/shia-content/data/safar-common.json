{
  "id": "safar-common",
  "title": "ماه صفر كے مشتركه اعمال",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ماه صفر كے مشتركه اعمال",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا شَدِيْدَ الْقُوٰي وَيَا شَدِيْدَ الْمِحَالِ"
    },
    {
      "kind": "text",
      "ar": "يَا عَزِيْزُ يَا عَزِيْزُ يَا عَزِيْزُ"
    },
    {
      "kind": "text",
      "ar": "ذَلَّتْ بِعَظَمَتِكَ جَمِيْعُ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاكْفِنِيْ شَرَّ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحْسِنُ يَا مُجْمِلُ يَا مُنْعِمُ يَا مُفْضِلُ"
    },
    {
      "kind": "text",
      "ar": "يَا لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ اِنِّيْ كُنْتُ مِنَ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَاسْتَجَبْنَا لَهٗ وَنَجَّيْنَاهُ مِنَ الْغَمِّ"
    },
    {
      "kind": "text",
      "ar": "وَكَذٰلِكَ نُنْجِي الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِهِ الطَّيِّبِيْنَ الطَّاهِرِيْنَ"
    }
  ]
}