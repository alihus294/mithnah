{
  "id": "dua-sabaah",
  "title": "دعاء صباح",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء صباح",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا مَنْ دَلَعَ لِسَانَ الصَّبَاحِ بِنُطْقِ تَبَلُّجِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَرَّحَ قِطَعَ اللَّيْلِ الْمُظْلِمِ بِغَيَاهِبِ تَلَجْلُجِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَتْقَنَ صُنْعَ الْفَلَكِ الدَّوَّارِ فِيْ مَقَادِيْرِ تَبَرُّجِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَشَعْشَعَ ضِيَاءَ الشَّمْسِ بِنُوْرِ تَأَجُّجِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ دَلَّ عَلٰي ذَاتِهٖ بِذَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتَنَزَّهَ عَنْ مُجَانَسَةِ مَخْلُوْقَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَلَّ عَنْ مُلَائَمَةِ كَيْفِيَّاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ قَرُبَ مِنْ خَطَرَاتِ الظُّنُوْنِ"
    },
    {
      "kind": "text",
      "ar": "وَبَعُدَ عَنْ لَحَظَاتِ الْعُيُوْنِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِمَ بِمَا كَانَ قَبْلَ أَنْ يَكُوْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ أَرْقَدَنِيْ فِيْ مِهَادِ أَمْنِهٖ وَأَمَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَيْقَظَنِيْ اِلٰي مَا مَنَحَنِيْ بِهٖ مِنْ مِنَنِهٖ وَاِحْسَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكَفَّ أَكُفَّ السُّوْءِ عَنِّيْ بِيَدِهٖ وَسُلْطَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ اللّٰهُمَّ عَلَي الدَّلِيْلِ اِلَيْكَ فِي اللَّيْلِ الْأَلْيَلِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَاسِكِ مِنْ أَسْبَابِكَ بِحَبْلِ الشَّرَفِ الْاَطْوَلِ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّاصِعِ الْحَسَبِ فِيْ ذِرْوَةِ الْكَاهِلِ الْاَعْبَلِ"
    },
    {
      "kind": "text",
      "ar": "وَالثَّابِتِ الْقَدَمِ عَلٰي زَحَالِفِهَا فِي الزَّمَنِ الْاَوَّلِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي اٰلِهِ الْاَخْيَارِ الْمُصْطَفَيْنَ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَافْتَحِ اللّٰهُمَّ لَنَا مَصَارِيْعَ الصَّبَاحِ"
    },
    {
      "kind": "text",
      "ar": "بِمَفَاتِيْحِ الرَّحْمَةِ وَالْفَلَاحِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْنِي اللّٰهُمَّ مِنْ أَفْضَلِ خِلَعِ الْهِدَايَةِ وَالصَّلَاحِ"
    },
    {
      "kind": "text",
      "ar": "وَأَغْرِسِ اللّٰهُمَّ بِعَظَمَتِكَ فِيْ شِرْبِ جَنَانِيْ يَنَابِيْعَ الْخُشُوْعِ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْرِ اللّٰهُمَّ لِهَيْبَتِكَ مِنْ اٰمَاقِيْ زَفَرَاتِ الدُّمُوْعِ"
    },
    {
      "kind": "text",
      "ar": "وَأَدِّبِ اللّٰهُمَّ نَزَقَ الْخُرْقِ مِنِّيْ بِأَزِمَّةِ الْقُنُوْعِ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِنْ لَمْ تَبْتَدِئْنِي الرَّحْمَةُ مِنْكَ بِحُسْنِ التَّوْفِيْقِ"
    },
    {
      "kind": "text",
      "ar": "فَمَنِ السَّالِكُ بِيْ اِلَيْكَ فِيْ وَاضِحِ الطَّرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ أَسْلَمَتْنِيْ أَنَاتُكَ لِقَائِدِ الْاَمَلِ وَالْمُنٰي"
    },
    {
      "kind": "text",
      "ar": "فَمَنِ الْمُقِيْلُ عَثَرَاتِيْ مِنْ كَبَوَاتِ الْهَوٰي"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ خَذَلَنِيْ نَصْرُكَ"
    },
    {
      "kind": "text",
      "ar": "عِنْدَ مُحَارَبَةِ النَّفْسِ وَالشَّيْطَانِ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ وَكَلَنِيْ خِذْلَانُكَ اِلٰي حَيْثُ النَّصَبِ وَالْحِرْمَانِ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ أَتَرَانِيْ مَآ أَتَيْتُكَ اِلَّا مِنْ حَيْثُ الْاٰمَالِ"
    },
    {
      "kind": "text",
      "ar": "أَمْ عَلِقْتُ بِأَطْرَافِ حِبَالِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا حِيْنَ بَاعَدَتْنِيْ ذُنُوْبِيْ عَنْ دَارِ الْوِصَالِ"
    },
    {
      "kind": "text",
      "ar": "فَبِئْسَ الْمَطِيَّةُ الَّتِي امْتَطَتْ نَفْسِيْ مِنْ هَوَاهَا"
    },
    {
      "kind": "text",
      "ar": "فَوَاهًا لَهَا لِمَا سَوَّلَتْ لَهَا ظُنُوْنُهَا وَمُنَاهَا"
    },
    {
      "kind": "text",
      "ar": "وَتَبًّا لَهَا لِجُرْأَتِهَا عَلٰي سَيِّدِهَا وَمَوْلَاهَآ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ قَرَعْتُ بَابَ رَحْمَتِكَ بِيَدِ رَجَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَهَرَبْتُ اِلَيْكَ لَاجِئًا مِنْ فَرْطِ أَهْوَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَّقْتُ بِأَطْرَافِ حِبَالِكَ أَنَامِلَ وَلَائِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاصْفَحِ اللّٰهُمَّ عَمَّا كُنْتُ أَجْرَمْتُهٗ مِنْ زَلَلِيْ وَخَطَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَقِلْنِيْ مِنْ صَرْعَةِ رِدَائِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ سَيِّدِيْ وَمَوْلَايَ وَمُعْتَمَدِيْ وَرَجَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ غَايَةُ مَطْلُوْبِيْ وَمُنَايَ فِيْ مُنْقَلَبِيْ وَمَثْوَايَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ كَيْفَ تَطْرُدُ مِسْكِيْنًا"
    },
    {
      "kind": "text",
      "ar": "الْتَجَأَ اِلَيْكَ مِنَ الذُّنُوْبِ هَارِبًا"
    },
    {
      "kind": "text",
      "ar": "أَمْ كَيْفَ تُخَيِّبُ مُسْتَرْشِدًا"
    },
    {
      "kind": "text",
      "ar": "قَصَدَ اِلٰي جَنَابِكَ سَاعِيًا"
    },
    {
      "kind": "text",
      "ar": "أَمْ كَيْفَ تَرُدُّ ظَمْاٰنَ"
    },
    {
      "kind": "text",
      "ar": "وَرَدَ اِلٰي حِيَاضِكَ شَارِبًا"
    },
    {
      "kind": "text",
      "ar": "كَلَّا وَحِيَاضُكَ مُتْرَعَةٌ فِيْ ضَنْكِ الْمُحُوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَبَابُكَ مَفْتُوْحٌ لِّلطَّلَبِ وَالْوُغُوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ غَايَةُ الْمَسْؤُوْلِ وَنِهَايَةُ الْمَأْمُوْلِ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ هٰذِهٖ أَزِمَّةُ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "عَقَلْتُهَا بِعِقَالِ مَشِيَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذِهٖ أَعْبَاءُ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "دَرَأْتُهَا بِعَفْوِكَ وَرَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذِهٖ أَهْوَائِيَ الْمُضِلَّةُ"
    },
    {
      "kind": "text",
      "ar": "وَكَلْتُهَا اِلٰي جَنَابِ لُطْفِكَ وَرَأْفَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاجْعَلِ اللّٰهُمَّ صَبَاحِيْ هٰذَا نَازِلًا عَلَيَّ بِضِيَآءِ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَبِالسَّلَامَةِ فِي الدِّيْنِ وَالدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "وَمَسَائِيْ جُنَّةً مِّنْ كَيْدِ الْعِدٰي"
    },
    {
      "kind": "text",
      "ar": "وَوِقَايَةً مِنْ مُّرْدِيَاتِ الْهَوٰي"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ قَادِرٌ عَلٰي مَا تَشَآءُ"
    },
    {
      "kind": "text",
      "ar": "تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ، وَتَنْزِعُ الْمُلْكَ مِمَّنْ تَشَآءُ"
    },
    {
      "kind": "text",
      "ar": "وَتُعِزُّ مَنْ تَشَآءُ، وَتُذِلُّ مَنْ تَشَآءُ"
    },
    {
      "kind": "text",
      "ar": "بِيَدِكَ الْخَيْرُ، اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "تُوْلِجُ اللَّيْلَ فِي النَّهَارِ، وَتُوْلِجُ النَّهَارَ فِي اللَّيْلِ"
    },
    {
      "kind": "text",
      "ar": "وَتُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ، وَتُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ"
    },
    {
      "kind": "text",
      "ar": "وَتَرْزُقُ مَنْ تَشَاءُ بِغَيْرِ حِسَابٍ"
    },
    {
      "kind": "text",
      "ar": "لَآ اِلٰهَ اِلَّا أَنْتَ سُبْحَانَكَ اللّٰهُمَّ وَبِحَمْدِكَ"
    },
    {
      "kind": "text",
      "ar": "مَنْ ذَا يَعْرِفُ قَدْرَكَ فَلَا يَخَافُكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ ذَا يَعْلَمُ مَآ أَنْتَ فَلَا يَهَابُكَ"
    },
    {
      "kind": "text",
      "ar": "أَلَّفْتَ بِقُدْرَتِكَ الْفِرَقَ"
    },
    {
      "kind": "text",
      "ar": "وَفَلَقْتَ بِلُطْفِكَ الْفَلَقَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَرْتَ بِكَرَمِكَ دَيَاجِيَ الْغَسَقِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْهَرْتَ الْمِيَاهَ مِنَ الصُّمِّ الصَّيَاخِيْدِ عَذْبًا وَّأُجَاجًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزَلْتَ مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَ الشَّمْسَ وَالْقَمَرَ لِلْبَرِيَّةِ سِرَاجًا وَّهَّاجًا"
    },
    {
      "kind": "text",
      "ar": "مِنْ غَيْرِ أَنْ تُمَارِسَ فِيَمَا ابْتَدَأْتَ بِهٖ لُغُوْبًا وَّلَا عِلَاجًا"
    },
    {
      "kind": "text",
      "ar": "فَيَا مَنْ تَوَحَّدَ بِالْعِزِّ وَالْبَقَآءِ"
    },
    {
      "kind": "text",
      "ar": "وَقَهَرَ عِبَادَهٗ بِالْمَوْتِ وَالْفَنَآءِ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَّاٰلِهِ الْاَتْقِيَآءِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْمَعْ نِدَائِيْ وَاسْتَجِبْ دُعَآئِيْ"
    },
    {
      "kind": "text",
      "ar": "وَحَقِّقْ بِفَضْلِكَ أَمَلِيْ وَرَجَائِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا خَيْرَ مَنْ دُعِيَ لِكَشْفِ الضُّرِّ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَأْمُوْلِ لِكُلِّ عُسْرٍ وَّيُسْرٍ"
    },
    {
      "kind": "text",
      "ar": "بِكَ أَنْزَلْتُ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَرُدَّنِيْ مِنْ سَنِيِّ مَوَاهِبِكَ خَائِبًا"
    },
    {
      "kind": "text",
      "ar": "يَا كَرِيْمُ يَا كَرِيْمُ يَا كَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي خَيْرِ خَلْقِهٖ مُحَمَّدٍ وَاٰلِهٖ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ قَلْبِيْ مَحْجُوْبٌ وَّنَفْسِيْ مَعْيُوْبٌ"
    },
    {
      "kind": "text",
      "ar": "وَعَقْلِيْ مَغْلُوْبٌ وَهَوَائِيْ غَالِبٌ"
    },
    {
      "kind": "text",
      "ar": "وَطَاعَتِيْ قَلِيْلٌ، وَمَعْصِيَتِيْ كَثِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَلِسَانِيْ مُقِرٌّ بِالذُّنُوْبِ"
    },
    {
      "kind": "text",
      "ar": "فَكَيْفَ حِيْلَتِيْ يَا سَتَّارَ الْعُيُوْبِ"
    },
    {
      "kind": "text",
