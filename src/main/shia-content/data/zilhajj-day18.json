{
  "id": "zilhajj-day18",
  "title": "روز عيد غدير",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "روز عيد غدير",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِأَنَّ لَكَ الْحَمْدَ"
    },
    {
      "kind": "text",
      "ar": "وَحْدَكَ لَا شَرِيْكَ لَكَ، وَأَنَّكَ وَاحِدٌ أَحَدٌ صَمَدٌ"
    },
    {
      "kind": "text",
      "ar": "لَمْ تَلِدْ وَلَمْ تُوْلَدْ وَلَمْ يَكُنْ لَكَ كُفُوًا أَحَدٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مُحَمَّدًا عَبْدُكَ وَرَسُوْلُكَ صَلَوَاتُكَ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ هُوَ كُلَّ يَوْمٍ فِيْ شَأْنٍ كَمَا كَانَ مِنْ شَأْنِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَفَضَّلْتَ عَلَيَّ بِأَنْ جَعَلْتَنِيْ مِنْ أَهْلِ اِجَابَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْلِ دِيْنِكَ وَأَهْلِ دَعْوَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَفَّقْتَنِيْ لِذٰلِكَ فِيْ مُبْتَدَءِ خَلْقِيْ"
    },
    {
      "kind": "text",
      "ar": "تَفَضُّلًا مِنْكَ وَكَرَمًا وَجُوْدًا"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ أَرْدَفْتَ الْفَضْلَ فَضْلًا وَالْجُوْدَ جُوْدًا"
    },
    {
      "kind": "text",
      "ar": "وَالْكَرَمَ كَرَمًا رَأْفَةً مِنْكَ وَرَحْمَةً"
    },
    {
      "kind": "text",
      "ar": "اِلٰي أَنْ جَدَّدْتَ ذٰلِكَ الْعَهْدَ لِيْ تَجْدِيْدًا"
    },
    {
      "kind": "text",
      "ar": "بَعْدَ تَجْدِيْدِكَ خَلْقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَكُنْتُ نَسْيًا مَنْسِيًّا نَاسِيًا سَاهِيًا غَافِلًا"
    },
    {
      "kind": "text",
      "ar": "فَأَتْمَمْتَ نِعْمَتَكَ بِأَنْ ذَكَّرْتَنِيْ ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنَنْتَ بِهٖ عَلَيَّ وَهَدَيْتَنِيْ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَلْيَكُنْ مِنْ شَأْنِكَ يَا اِلٰهِيْ وَسَيِّدِيْ وَمَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُتِمَّ لِيْ ذٰلِكَ وَلَا تَسْلُبْنِيْهِ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تَتَوَفَّانِيْ عَلٰي ذٰلِكَ وَأَنْتَ عَنِّيْ رَاضٍ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ أَحَقُّ الْمُنْعِمِيْنَ أَنْ تُتِمَّ نِعْمَتَكَ عَلَيَّ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ سَمِعْنَا وَأَطَعْنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَجَبْنَا دَاعِيَكَ بِمَنِّكَ، فَلَكَ الْحَمْدُ"
    },
    {
      "kind": "text",
      "ar": "غُفْرَانَكَ رَبَّنَا وَاِلَيْكَ الْمَصِيْرُ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنّا بِاللّٰهِ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَبِرَسُوْلِهٖ مُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَدَّقْنَا وَأَجَبْنَا دَاعِيَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَاتَّبَعْنَا الرَّسُوْلَ فِيْ مُوَالَاةِ مَوْلَانَا"
    },
    {
      "kind": "text",
      "ar": "وَمَوْلَي الْمُؤْمِنِيْنَ أَمِيْرِ الْمُؤْمِنِيْنَ عَلِيِّ بْنِ أَبِيْ طَالِبٍ"
    },
    {
      "kind": "text",
      "ar": "عَبْدِ اللهِ، وَأَخِيْ رَسُوْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالصِّدِّيْقِ الْاَكْبَرِ، وَالْحُجَّةِ عَلٰي بَرِيَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْمُؤَيِّدِ بِهٖ نَبِيَّهٗ وَدِيْنَهُ الْحَقَّ الْمُبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَلَمًا لِدِيْنِ اللهِ، وَخَازِنًا لِعِلْمِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَيْبَةَ غَيْبِ اللهِ، وَمَوْضِعَ سِرِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَمِيْنَ اللهِ عَلٰي خَلْقِهٖ، وَشَاهِدَهٗ فِيْ بَرِيَّتِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّنَا اِنَّنَا سَمِعْنَا مُنَادِيًا"
    },
    {
      "kind": "text",
      "ar": "يُنَادِيْ لِلْاِيْمَانِ أَنْ اٰمِنُوْا بِرَبِّكُمْ فَاٰمَنَّا"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا فَاغْفِرْ لَنَا ذُنُوْبَنَا"
    },
    {
      "kind": "text",
      "ar": "وَكَفِّرْ عَنَّا سَيِّئَاتِنَا وَتَوَفَّنَا مَعَ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا وَاٰتِنَا مَا وَعَدْتَنَا عَلٰي رُسُلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخْزِنَا يَوْمَ الْقِيَامَةِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ لَا تُخْلِفُ الْمِيْعَادَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّا يَا رَبَّنَا بِمَنِّكَ وَلُطْفِكَ أَجَبْنَا دَاعِيَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاتَّبَعْنَا الرَّسُوْلَ وَصَدَّقْنَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَصَدَّقْنَا مَوْلَي الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَكَفَرْنَا بِالْجِبْتِ وَالطَّاغُوْتِ"
    },
    {
      "kind": "text",
      "ar": "فَوَلِّنَا مَا تَوَلَّيْنَا، وَاحْشُرْنَا مَعَ أَئِمَّتِنَا"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّا بِهِمْ مُؤْمِنُوْنَ مُوْقِنُوْنَ، وَلَهُمْ مُسَلِّمُوْنَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنَّا بِسِرِّهِمْ وَعَلَانِيَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَشَاهِدِهِمْ وَغَائِبِهِمْ وَحَيِّهِمْ وَمَيِّتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَرَضِيْنَا بِهِمْ أَئِمَّةً وَقَادَةً وَسَادَةً"
    },
    {
      "kind": "text",
      "ar": "وَحَسْبُنَا بِهِمْ بَيْنَنَا وَبَيْنَ اللهِ دُوْنَ خَلْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "لَا نَبْتَغِيْ بِهِمْ بَدَلًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا نَتَّخِذُ مِنْ دُوْنِهِمْ وَلِيْجَةً"
    },
    {
      "kind": "text",
      "ar": "وَبَرِئْنَا اِلَي اللهِ مِنْ كُلِّ مَنْ نَصَبَ لَهُمْ حَرْبًا"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْجِنِّ وَالْاِنْسِ مِنَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَكَفَرْنَا بِالْجِبْتِ وَالطَّاغُوْتِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَوْثَانِ الْاَرْبَعَةِ وَأَشْيَاعِهِمْ وَأَتْبَاعِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَكُلِّ مَنْ وَالَاهُمْ مِنَ الْجِنِّ وَالْاِنْسِ"
    },
    {
      "kind": "text",
      "ar": "مِنْ أَوَّلِ الدَّهْرِ اِلٰي اٰخِرِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نُشْهِدُكَ أَنَّا نَدِيْنُ"
    },
    {
      "kind": "text",
      "ar": "بِمَا دَانَ بِهٖ مُحَمَّدٌ وَاٰلُ مُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَعَلَيْهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَقَوْلُنَا مَا قَالُوْا، وَدِيْنُنَا مَا دَانُوْا بِهٖ"
    },
    {
      "kind": "text",
      "ar": "مَا قَالُوْا بِهٖ قُلْنَا، وَمَا دَانُوْا بِهٖ دِنَّا"
    },
    {
      "kind": "text",
      "ar": "وَمَا أَنْكَرُوْا أَنْكَرْنَا، وَمَنْ وَالَوْا وَالَيْنَا"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ عَادَوْا عَادَيْنَا، وَمَنْ لَعَنُوْا لَعَنَّا"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ تَبَرَّأُوْا مِنْهُ تَبَرَّأْنَا مِنْهُ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ تَرَحَّمُوْا عَلَيْهِ تَرَحَّمْنَا عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنَّا وَسَلَّمْنَا وَرَضِيْنَا"
    },
    {
      "kind": "text",
      "ar": "وَاتَّبَعْنَا مَوَالِيَنَا صَلَوَاتُ اللهِ عَلَيْهِمْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَتَمِّمْ لَنَا ذٰلِكَ وَلَا تَسْلُبْنَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ مُسْتَقِرًّا ثَابِتًا عِنْدَنَا، وَلَا تَجْعَلْهُ مُسْتَعَارًا"
    },
    {
      "kind": "text",
      "ar": "وَأَحْيِنَا مَا أَحْيَيْتَنَا عَلَيْهِ، وَأَمِتْنَا اِذَا أَمَتَّنَا عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اٰلُ مُحَمَّدٍ أَئِمَّتُنَا فَبِهِمْ نَأْتَمُّ"
    },
    {
      "kind": "text",
      "ar": "وَاِيَّاهُمْ نُوَالِيْ، وَعَدُوَّهُمْ عَدُوَّ اللهِ نُعَادِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاجْعَلْنَا مَعَهُمْ فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الْمُقَرَّبِيْنَ، فَاِنَّا بِذٰلِكَ رَاضُوْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِحَقِّ مُحَمَّدٍ نَبِيِّكَ وَعَلِيٍّ وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَالشَّأْنِ وَالْقَدْرِ الَّذِيْ خَصَصْتَهُمَا بِهٖ دُوْنَ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَعَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَبْدَأَ بِهِمَا فِيْ كُلِّ خَيْرٍ عَاجِلٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "الْاَئِمَّةِ الْقَادَةِ، وَالدُّعَاةِ السَّادَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالنُّجُوْمِ الزَّاهِرَةِ، وَالْأَعْلَامِ الْبَاهِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَسَاسَةِ الْعِبَادِ، وَأَرْكَانِ الْبِلَادِ، وَالنَّاقَةِ الْمُرْسَلَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّفِيْنَةِ النَّاجِيَةِ الْجَارِيَةِ فِي اللُّجَجِ الْغَامِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ خُزَّانِ عِلْمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْكَانِ تَوْحِيْدِكَ، وَدَعَائِمِ دِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَعَادِنِ كَرَامَتِكَ، وَصَفْوَتِكَ مِنْ بَرِيَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخِيَرَتِكَ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "الْاَتْقِيَاءِ الْاَنْقِيَاءِ النُّجَبَاءِ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَابِ الْمُبْتَلٰي بِهِ النَّاسُ"
    },
    {
      "kind": "text",
      "ar": "مَنْ أَتَاهُ نَجَا، وَمَنْ أَبَاهُ هَوٰي"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "أَهْلِ الذِّكْرِ الَّذِيْنَ أَمَرْتَ بِمَسْأَلَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَذَوِي الْقُرْبَي الَّذِيْنَ أَمَرْتَ بِمَوَدَّتِهِمْ وَفَرَضْتَ حَقَّهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَ الْجَنَّةَ مَعَادَ مَنِ اقْتَصَّ اٰثَارَهُمْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "كَمَا أَمَرُوْا بِطَاعَتِكَ وَنَهَوْا عَنْ مَعْصِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَدَلُّوْا عِبَادَكَ عَلٰي وَحْدَانِيَّتِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِحَقِّ مُحَمَّدٍ نَبِيِّكَ وَنَجِيْبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَفْوَتِكَ وَأَمِيْنِكَ، وَرَسُوْلِكَ اِلٰي خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَقِّ أَمِيْرِ الْمُؤْمِنِيْنَ وَيَعْسُوْبِ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَقَائِدِ الْغُرِّ الْمُحَجَّلِيْنَ، الْوَصِيِّ الْوَفِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَالصِّدِّيْقِ الْاَكْبَرِ، وَالْفَارُوْقِ بَيْنَ الْحَقِّ وَالْبَاطِلِ"
    },
    {
      "kind": "text",
      "ar": "وَالشَّاهِدِ لَكَ، وَالدَّالِّ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالصَّادِعِ بِأَمْرِكَ، وَالْمُجَاهِدِ فِيْ سَبِيْلِكَ"
    },
    {
      "kind": "text",
      "ar": "لَمْ تَأْخُذْهُ فِيْكَ لَوْمَةُ لَائِمٍ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَنِيْ فِيْ هٰذَا الْيَوْمِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ عَقَدْتَ فِيْهِ لِوَلِيِّكَ الْعَهْدَ فِيْ أَعْنَاقِ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَكْمَلْتَ لَهُمُ الدِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْعَارِفِيْنَ بِحُرْمَتِهٖ وَالْمُقِرِّيْنَ بِفَضْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "مِن عُتَقَائِكَ وَطُلَقَائِكَ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُشْمِتْ بِيْ حَاسِدِي النِّعَمِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَكَمَا جَعَلْتَهٗ عِيْدَكَ الْاَكْبَرَ"
    },
    {
      "kind": "text",
      "ar": "وَسَمَّيْتَهٗ فِي السَّمَاءِ يَوْمَ الْعَهْدِ الْمَعْهُوْدِ"
    },
    {
      "kind": "text",
      "ar": "وَفِي الْاَرْضِ يَوْمَ الْمِيْثَاقِ الْمَأْخُوْذِ وَالْجَمْعِ الْمَسْؤُوْلِ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَقْرِرْ بِهٖ عُيُوْنَنَا، وَاجْمَعْ بِهٖ شَمْلَنَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُضِلَّنَا بَعْدَ اِذْ هَدَيْتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا لِاَنْعُمِكَ مِنَ الشَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ عَرَّفَنَا فَضْلَ هٰذَا الْيَوْمِ"
    },
    {
      "kind": "text",
      "ar": "وَبَصَّرَنَا حُرْمَتَهٗ، وَكَرَّمَنَا بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَشَرَّفَنَا بِمَعْرِفَتِهٖ، وَهَدَانَا بِنُوْرِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "يَا رَسُوْلَ اللهِ، يَا أَمِيْرَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْكُمَا وَعَلٰي عِتْرَتِكُمَا وَعَلٰي مُحِبِّيْكُمَا"
    },
    {
      "kind": "text",
      "ar": "مِنِّيْ أَفْضَلُ السَّلَامِ مَا بَقِيَ اللَّيْلُ وَالنَّهَارُ"
    },
    {
      "kind": "text",
      "ar": "وَبِكُمَا أَتَوَجَّهُ اِلَي اللهِ رَبِّيْ وَرَبِّكُمَا"
    },
    {
      "kind": "text",
      "ar": "فِيْ نَجَاحِ طَلِبَتِيْ، وَقَضَاءِ حَوَائِجِيْ، وَتَيْسِيْرِ أُمُوْرِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِحَقِّ مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَلْعَنَ مَنْ جَحَدَ حَقَّ هٰذَا الْيَوْمِ وَأَنْكَرَ حُرْمَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَصَدَّ عَنْ سَبِيْلِكَ لِاِطْفَاءِ نُوْرِكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَبَي اللهُ اِلَّا أَنْ يُتِمَّ نُوْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَرِّجْ عَنْ أَهْلِ بَيْتِ مُحَمَّدٍ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَاكْشِفْ عَنْهُمْ وَبِهِمْ عَنِ الْمُؤْمِنِيْنَ الْكُرُبَاتِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ امْلَأَ الْاَرْضَ بِهِمْ عَدْلًا"
    },
    {
      "kind": "text",
      "ar": "كَمَا مُلِئَتْ ظُلْمًا وَجَوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْجِزْ لَهُمْ مَا وَعَدْتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ لَا تُخْلِفُ الْمِيْعَادَ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ جَعَلَنَا مِنَ الْمُتَمَسِّكينَ"
    },
    {
      "kind": "text",
      "ar": "بِوِلَايَةِ أَمِيْرِ الْمُؤْمِنِيْنَ وَالْاَئِمَّة عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَكْرَمَنَا بِهٰذَا الْيَوْمِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَنَا مِنَ الْمُوْفِيْنَ بِعَهْدِهٖ اِلَيْنَا"
    },
    {
      "kind": "text",
      "ar": "وَمِيْثَاقِهِ الَّذِيْ وَاثَقَنَا بِهٖ"
    },
    {
      "kind": "text",
      "ar": "مِنْ وِلَايَةِ وُلَاةِ أَمْرِهٖ وَالْقُوَّامِ بِقِسْطِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَجْعَلْنَا مِنَ الْجَاحِدِيْنَ وَالْمُكَذِّبِيْنَ بِيَوْمِ الدِّيْنِ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ جَعَلَ كَمَالَ دِيْنِهٖ وَتَمَامَ نِعْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "بِوِلَايَةِ أَمِيْرِ الْمُؤْمِنِيْنَ عَلِيِّ بْنِ أَبِيْ طَالِبٍ عَلَيْهِ اَلسَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "وَاخَيْتُكَ فِي اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَصَافَيْتُكَ فِي اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَصَافَحْتُكَ فِي اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَعَاهَدْتُ اللهَ وَمَلَائِكَتَهٗ وَكُتُبَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَرُسُلَهٗ وَأَنْبِيَائَهٗ وَالْاَئِمَّةَ الْمَعْصُوْمِيْنَ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي أَنِّيْ اِنْ كُنْتُ مِنْ أَهْلِ الْجَنَّةِ وَالشَّفَاعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأُذِنَ لِيْ بِأَنْ أَدْخُلَ الْجَنَّةَ"
    },
    {
      "kind": "text",
      "ar": "لَا أَدْخُلُهَا اِلَّا وَأَنْتَ مَعِيْ"
    },
    {
      "kind": "text",
      "ar": "قَبِلْتُ"
    },
    {
      "kind": "text",
      "ar": "أَسْقَطْتُ عَنْكَ جَمِيْعَ حُقُوْقِ الْأُخُوَّةِ"
    },
    {
      "kind": "text",
      "ar": "مَا خَلَا الشَّفَاعَةَ وَالدُّعَاءَ وَالزِّيَارَةَ۔"
    }
  ]
}