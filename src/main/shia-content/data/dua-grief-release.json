{
  "id": "dua-grief-release",
  "title": "انتيسواں امر۔ مصيبت ميں كلمات",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "انتيسواں امر۔ مصيبت ميں كلمات",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "يَا عِمَادَ مَنْ لَا عِمَادَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَيَا ذُخْرَ مَنْ لَا ذُخْرَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَيَا سَنَدَ مَنْ لَا سَنَدَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَيَا حِرْزَ مَنْ لَا حِرْزَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَيَا غِيَاثَ مَنْ لَا غِيَاثَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَيَا كَرِيْمَ الْعَفْوِ وَيَا حَسَنَ الْبَلَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَيَا عَظِيْمَ الرَّجَاءِ وَيَا عِزَّ الضُّعَفَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مُنْقِذَ الْغَرْقٰي وَيَا مُنْجِيَ الْهَلْكٰي"
    },
    {
      "kind": "text",
      "ar": "يَا مُحْسِنُ يَا مُجْمِلُ يَا مُنْعِمُ يَا مُفْضِلُ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ الَّذِيْ سَجَدَ لَكَ سَوَادُ اللَّيْلِ وَنُوْرُ النَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "وَضَوْءُ الْقَمَرِ وَشُعَاعُ الشَّمْسِ"
    },
    {
      "kind": "text",
      "ar": "وَدَوِيُّ الْمَاءِ وَحَفِيْفُ الشَّجَرِ"
    },
    {
      "kind": "text",
      "ar": "يَااللهُ يَا اللهُ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ وَحْدَكَ لَا شَرِيْكَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ افْعَلْ بِيْ كَذَا وَكَذَا"
    }
  ]
}