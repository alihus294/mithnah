{
  "id": "tahajjud",
  "title": "نيند سے بيداري اور نماز تهجد",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نيند سے بيداري اور نماز تهجد",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَحْيَانِيْ بَعْدَ مَا أَمَاتَنِيْ وَاِلَيْهِ النُّشُوْرُ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ رَدَّ عَلَيَّ رُوْحِيَ لِاَحْمَدَهٗ وَأَعْبُدَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعِنِّيْ عَلٰي هَوْلِ الْمُطَّلَعِ"
    },
    {
      "kind": "text",
      "ar": "وَوَسِّعْ عَلَيَّ الْمَضْجَعَ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ خَيْرَ مَا بَعْدَ الْمَوْتِ۔"
    },
    {
      "kind": "text",
      "ar": "سُبُّوْحٌ قُدُّوْسٌ رَبُّ الْمَلَائِكَةِ وَالرُّوْحِ"
    },
    {
      "kind": "text",
      "ar": "سَبَقَتْ رَحْمَتُكَ غَضَبَكَ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ، عَمِلْتُ سُوْئًا"
    },
    {
      "kind": "text",
      "ar": "وَظَلَمْتُ نَفْسِيْ فَاغْفِرْ لِيْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ لَا يَغْفِرُ الذُّنُوْبَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "فَتُبْ عَلَيَّ اِنَّكَ أَنْتَ التَّوَّابُ الرَّحِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّهٗ لَا يُوَارِيْ مِنْكَ لَيْلٌ سَاجٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا سَمَاءٌ ذَاتُ أَبْرَاجٍ، وَلَا أَرْضٌ ذَاتُ مِهَادٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بَحْرٌ لُجِّيٌّ"
    },
    {
      "kind": "text",
      "ar": "تُدْلِجُ بَيْنَ يَدَيِ الْمُدْلِجِ مِنْ خَلْقِكَ تُدْلِجُ"
    },
    {
      "kind": "text",
      "ar": "الرَّحْمَةَ عَلٰي مَنْ تَشَاءُ مِنْ خَلْقِك"
    },
    {
      "kind": "text",
      "ar": "تَعْلَمُ خَائِنَةَ الْاَعْيُنِ وَمَا تُخْفِي الصُّدُوْرُ"
    },
    {
      "kind": "text",
      "ar": "غَارَتِ النُّجُوْمُ وَنَامَتِ الْعُيُوْنُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْحَيُّ الْقَيُّوْمُ، لَا تَأْخُذُكَ سِنَةٌ وَلَا نَوْمٌ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ رَبِّ الْعَالَمِيْنَ وَاِلٰهِ الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اِنَّ فِيْ خَلْقِ السَّمٰوَاتِ وَالْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ لَاٰيَاتٍ لِّاُولِي الْاَلْبَابِ۔"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ يَذْكُرُوْنَ اللهَ قِيَامًا وَقُعُوْدًا وَعَلٰي جُنُوْبِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَيَتَفَكَّرُوْنَ فِيْ خَلْقِ السَّمٰوَاتِ وَالْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا مَا خَلَقْتَ هٰذَا بَاطِلًا"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ فَقِنَا عَذَابَ النَّارِ۔"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا اِنَّكَ مَنْ تُدْخِلِ النَّارَ فَقَدْ أَخْزَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَا لِلظَّالِمِيْنَ مِنْ أَنْصَارٍ۔"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا اِنَّنَا سَمِعْنَا مُنَادِيًا يُنَادِيْ لِلْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ اٰمِنُوْا بِرَبِّكُمْ فَاٰمَنَّا"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا فَاغْفِرْ لَنَا ذُنُوْبَنَا وَكَفِّرْ عَنَّا سَيِّئَاتِنَا"
    },
    {
      "kind": "text",
      "ar": "وَتَوَفَّنَا مَعَ الْاَبْرَارِ۔"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا وَاٰتِنَا مَا وَعَدْتَّنَا عَلٰي رُسُلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخْزِنَا يَوْمَ الْقِيَامَةِ اِنَّكَ لَا تُخْلِفُ الْمِيْعَادَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْ لَنَا، وَارْحَمْنَا، وَعَافِنَا"
    },
    {
      "kind": "text",
      "ar": "وَاعْفُ عَنَّا فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "رَبِّ اغْفِرْ وَارْحَمْ، وَتَجَاوَزْ عَمَّا تَعْلَمُ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الْاَعَزُّ الْاَجَلُّ الْاَكْرَمُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّك خَلَقْتَنِيْ سَوِيًّا ...."
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ تَعَرَّضَ لَكَ فِيْ هٰذَا اللَّيْلِ الْمُتَعَرِّضُوْنَ....."
    },
    {
      "kind": "text",
      "ar": "اَلَّهُمَّ اهْدِنِيْ فِيْمَنْ هَدَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَعَافِنِيْ فِيْمَنْ عَافَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَلَّنِيْ فِيْمَن تَوَلَّيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ لِيْ فِيْمَا أَعْطَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَقِنِيْ شَرَّ مَا قَضَيْتَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ تَقْضِيْ وَلَا يُقْضٰي عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ رَبَّ الْبَيْتِ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَغْفِرُكَ وَأَتُوْبُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأُوْمِنُ بِكَ وَأَتَوَكَّلُ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِكَ يَا رَحِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "أَسْتَغْفِرُ الله رَبِّيْ وَأَتُوْبُ اِلَيْهِ۔"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْعَائِذِ بِكَ مِنَ النَّارِ۔"
    },
    {
      "kind": "text",
      "ar": "الْعَفْوَ الْعَفْوَ۔"
    },
    {
      "kind": "text",
      "ar": "رَبِّ اغْفِرْ لِيْ وَارْحَمْنِيْ وَتُبْ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ التَّوَّابُ الْغَفُوْرُ لرَّحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ مَنْ حَسَنَاتُهٗ نِعْمَةٌ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَشُكْرُهٗ ضَعِيْفٌ وَذَنْبُهٗ عَظِيْمٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَيْسَ لِذٰلِكَ اِلَّا رِفْقُكَ وَرَحْمَتُكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ قُلْتَ فِيْ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "الْمُنْزَلِ عَلٰي نَبِيِّكَ الْمُرْسَلِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "كَانُوْا قَلِيْلًا مِنَ اللَّيْلِ مَا يَهْجَعُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِالْاَسْحَارِ هُمْ يسْتَغْفِرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "طَالَ هُجُوْعِيْ وَقَلَّ قِيَامِيْ وَهٰذَا السَّحَرُ"
    },
    {
      "kind": "text",
      "ar": "وأَنَا أَسْتَغْفِرُكَ لِذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "اسْتِغْفَارَ مَنْ لَا يَجِدُ لِنَفْسِهٖ ضَرًّا وَلَا نَفْعًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا مَوْتًا وَلَا حَيَاةً وَلَا نُشُوْرًا۔"
    },
    {
      "kind": "text",
      "ar": "اَلْحَمْدُ لِرَبِّ الصَّبَاحِ، الْحَمْدُ لِفَالِقِ الْاِصْبَاحِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ رَبِّيَ الْمَلِكِ الْقُدُّوْس الْعَزِيْزِ الْحَكِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا حَيُّ يَا قَيُّوْمُ، يَا بَرُّ يَا رَحِيْمُ، يَا غَنِيُّ يَا كَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "ارْزُقْنِيْ مِنَ التِّجَارَةِ اَعْظَمُهَا فَضْلًا"
    },
    {
      "kind": "text",
      "ar": "وَأَوْسَعَهَا رِزْقًا وَخَيْرَهَا لِيْ عَاقِبَةً"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ لَا خَيْرَ فِيْمَا لَا عَاقِبَةَ لَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "سُبُّوْح قُدُّوْسٌ رَبُّ الْمَلَائِكَة وَالرُّوْح"
    },
    {
      "kind": "text",
      "ar": "اسْتَمْسَكْتُ بِعُرْوَةِ اللهِ الْوُثْقَي الَّتِيْ لَا انْفِصَامَ لَهَا"
    },
    {
      "kind": "text",
      "ar": "وَاعْتَصَمْتُ بِحَبْلِ اللهِ الْمَتِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِاللّٰهِ مِنْ شَرِّ فَسَقَةِ الْعَرَبِ وَالْعَجَمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِاللّٰهِ مِنْ شَرِّ فَسَقَةِ الْجِنِّ وَالْاِنْسِ۔"
    },
    {
      "kind": "text",
      "ar": "سُبْحَاَنَ رَبِّ الصَّبَاحِ فَاَلِق الْاِصْبَاحِ۔"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ رَبِّيَ الْعَظِيْمِ وَبِحَمْدِهٖٓ"
    },
    {
      "kind": "text",
      "ar": "اَسْتَغْفِرُ اللهَ رَبِّيْ وَاَتُوْبُ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا ذَا الْمُلْكِ الْمُتَأَبِّدِ بِالْخُلُوْدِ ....."
    }
  ]
}