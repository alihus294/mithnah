      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الْاَوَّلُ فَلَيْسَ قَبْلَكَ شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْاٰخِرُ فَلَيْسَ بَعْدَكَ شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الظَّاهِرُ فَلَيْسَ فَوْقَكَ شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْبَاطِنُ فَلَيْسَ دُوْنَكَ شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْعَزِيْزُ الْحَكِيْمُ"
    }
  ]
}