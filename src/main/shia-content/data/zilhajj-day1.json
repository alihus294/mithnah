{
  "id": "zilhajj-day1",
  "title": "ذي الحجه كا پهلا دن",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ذي الحجه كا پهلا دن",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ ذِي الْعِزِّ الشَّامِخِ الْمُنِيْفِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ ذِي الْجَلَالِ الْبَاذِخِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ ذِي الْمُلْكِ الْفَاخِرِ الْقَدِيْمِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ يَرٰي أَثَرَ النَّمْلَةِ فِي الصَّفَا"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ يَرٰي وَقْعَ الطَّيْرِ فِي الْهَوَاءِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ هُوَ هٰكَذَا وَلَا هٰكَذَا غَيْرُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "حَسْبِيْ حَسْبِيْ حَسْبِيْ مِنْ سُؤَالِيْ عِلْمُكَ بِحَالِيْ"
    }
  ]
}