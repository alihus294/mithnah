{
  "id": "taweez-kharish",
  "title": "بادي وخوني خارش اور پهوڑوں كا تعويذ",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "بادي وخوني خارش اور پهوڑوں كا تعويذ",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَمَثَلُ كَلِمَةٍ خَبِيْثَةٍ كَشَجَرَة خَبِيْثَةٍ"
    },
    {
      "kind": "text",
      "ar": "اجْتُثَّتْ مِنْ فَوْقِ الْاَرْض مَالَهَا مِنْ قَرَارٍ"
    },
    {
      "kind": "text",
      "ar": "مِنْهَا خَلَقْنَاكُمْ وَفِيْهَا نُعِيْدُكُم"
    },
    {
      "kind": "text",
      "ar": "وَمِنْهَا نُخْرِجُكُمْ تَارَةً أُخْرٰي"
    },
    {
      "kind": "text",
      "ar": "اللهُ أَكْبَرُ وَأَنْتَ لَا تُكَبَّرُ"
    },
    {
      "kind": "text",
      "ar": "اللهُ يَبْقٰي وَأَنْتَ لَا تَبْقٰي"
    },
    {
      "kind": "text",
      "ar": "وَاللهُ عَلٰي كُلِّ شَيْءٍ قدِيْرٌ۔"
    }
  ]
}