    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِاسْمِكَ الَّذِيْ اِذَا دُعِيْتَ بِهٖ أَجَبْتَ"
    },
    {
      "kind": "text",
      "ar": "وَاِذَا سُئِلْتَ بِهٖ أَعْطَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وأَسْأَلُكَ بِحَقِّكَ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَقِّهِمُ الَّذِيْ أَوْجَبْتَهٗ عَلٰي نَفْسِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَقْضِيَ لِيْ حَاجَتِيْ، السَّاعَةَ السَّاعَةَ"
