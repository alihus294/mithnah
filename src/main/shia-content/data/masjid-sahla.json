    {
      "kind": "text",
      "ar": "وَلَكَ الْحَمْدُ عَلٰي كُلِّ بَلَاءٍ حَسَنٍ ابْتَلَيْتَنِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ تَقَبَّلْ صَلَاتِيْ وَدُعَائِيْ، وَطَهِّرْ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاشْرَحْ لِيْ صَدْرِيْ، وَتُبْ عَلَيَّ"
