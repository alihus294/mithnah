{
  "id": "masjid-sahla",
  "title": "مسجد سهله",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مسجد سهله",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ، وَبِاللّٰهِ، وَمِنَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَي اللهِ، وَمَا شَاءَ اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَخَيْرُ الْاَسْمَاءِ لِلّٰهِ، تَوَكَّلْتُ عَلَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ مِنْ عُمّارِ مَسَاجِدِكَ وَبُيُوْتِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَتَوَجَّهُ اِلَيْكَ بِمُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأُقَدِّمُهُمْ بَيْنَ يَدَيْ حَوَائِجِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاجْعَلْنِيْ اَللّٰهُمَّ بِهِمْ عِنْدَكَ وَجِيْهًا"
    },
    {
      "kind": "text",
      "ar": "فِي الدُّنْيَا وَالْاٰخِرَةِ وَمِنَ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ صَلَاتِيْ بِهِمْ مَقْبُوْلَهً"
    },
    {
      "kind": "text",
      "ar": "وَذَنْبِيْ بِهِمْ مَغْفُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَرِزْقِيْ بِهِمْ مَبْسُوْطًا"
    },
    {
      "kind": "text",
      "ar": "وَدُعَائِيْ بِهِمْ مُسْتَجَابًا"
    },
    {
      "kind": "text",
      "ar": "وَحَوَائِجِيْ بِهِمْ مَقْضِيَّةً"
    },
    {
      "kind": "text",
      "ar": "وَانْظُرْ اِلَيَّ بِوَجْهِكَ الْكَرِيْمِ نَظْرَةً رَحِيْمَةً"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْجِبُ بِهَا الْكَرَامَةَ عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ لَا تَصْرِفْهُ عَنِّيْ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "يَا مُقَلِّبَ الْقُلُوْبِ وَالْاَ بْصَارِ"
    },
    {
      "kind": "text",
      "ar": "ثَبِّتْ قَلْبِيْ عَلٰي دِيْنِكَ وَدِيْنِ نَبِيِّكَ وَوَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُزِغْ قَلْبِيْ بَعْدَ اِذْ هَدَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيْ مِنْ لَدُنْكَ رَحْمَةً، اِنَّكَ أَنْتَ الْوَهَّابُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِلَيْكَ تَوَجَّهْتُ، وَمَرْضَاتَكَ طَلَبْتُ"
    },
    {
      "kind": "text",
      "ar": "وَثَوَابَكَ ابْتَغَيْتُ، وَبِكَ اٰمَنْتُ، وَعَلَيْكَ تَوَكَّلْتُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَأَقْبِلْ بِوَجْهِكَ اِلَيَّ، وَأَقْبِلْ بِوَجْهِيْ اِلَيْكَ۔"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "واللهُ أَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَكَ الْحَمْدُ عَلٰي مَا هَدَيْتَنِيْ"
