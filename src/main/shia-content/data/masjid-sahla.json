    {
      "kind": "text",
      "ar": "وَتُقْبِلَ بِوَجْهِيْ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخَيِّبْنِيْ حِيْنَ أَدْعُوْكَ"
