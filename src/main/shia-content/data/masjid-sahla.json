    {
      "kind": "text",
      "ar": "وَلَا تَحْرِمْنِيْ حِيْنَ أَرْجُوْكَ، يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِاسْمِكَ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ خَيْرَ عُمْرِيْ اٰخِرَهٗ"
