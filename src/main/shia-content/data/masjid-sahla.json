    {
      "kind": "text",
      "ar": "وَخَيْرَ أَعْمَالِيْ خَوَاتِيْمَهَا"
    },
    {
      "kind": "text",
      "ar": "وَخَيْرَ أَيَّامِيْ يَوْمَ أَلْقَاكَ فِيْهِ"
