    {
      "kind": "text",
      "ar": "يَا سَامِعَ الدُّعَاءِ، يَا سَيِّدَاهُ يَا مَوْلَاهُ يَا غِيَاثَاهُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِكُلِّ اسْمٍ سَمَّيْتَ بِهٖ نَفْسَكَ"
    },
    {
      "kind": "text",
      "ar": "أَوِ اسْتَأْثَرْتَ بِهٖ فِيْ عِلْمِ الْغَيْبِ عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تُعَجِّلَ فَرَجَنَا السَّاعَةَ"
    },
    {
      "kind": "text",
      "ar": "يَا مُقَلِّبَ الْقُلُوْبِ وَالْاَبْصَارِ، يَا سَمِيْعَ الدُّعَاءِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِحَقِّ هٰذِهِ الْبُقْعَةِ الشَّرِيْفَةِ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَقِّ مَنْ تَعَبَّدَ لَكَ فِيْهَا"
