    {
      "kind": "text",
      "ar": "مُبْدِئُ الْخَلْقِ وَمُعِيْدُهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "خَالِقُ الْخَلْقِ وَرَازِقُهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ الْقَابِضُ الْبَاسِطُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "مُدَبِّرُ الْأُمُوْرِ وَبَاعِثُ مَنْ فِي الْقُبُوْرِ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ وَارِثُ الْاَرْضِ وَمَنْ عَلَيْهَا"
