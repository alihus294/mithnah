    {
      "kind": "text",
      "ar": "يَا مَنْ يَحُوْلُ بَيْنَ الْمَرْءِ وَقَلْبِهٖ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحُلْ بَيْنَنَا وَبَيْنَ مَنْ يُؤْذِيْنَا بِحَوْلِكَ وَقُوَّتِكَ"
    },
    {
      "kind": "text",
