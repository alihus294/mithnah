{
  "id": "sura-adiyat",
  "title": "سورۂ عاديات",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ عاديات",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَالْعٰدِيٰتِ ضَبْحًاۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "فَالْمُوْرِيٰتِ قَدْحًاۙ۝۲"
    },
    {
      "kind": "text",
      "ar": "فَالْمُغِيْرٰتِ صُبْحًاۙ۝۳"
    },
    {
      "kind": "text",
      "ar": "فَاَثَرْنَ بِهٖ نَقْعًاۙ۝۴"
    },
    {
      "kind": "text",
      "ar": "فَوَسَطْنَ بِهٖ جَمْعًاۙ۝۵"
    },
    {
      "kind": "text",
      "ar": "اِنَّ الْاِنْسَانَ لِرَبِّهٖ لَكَنُوْدٌۚ۝۶"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّهٗ عَلٰى ذٰلِكَ لَشَهِيْدٌۚ۝۷"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّهٗ لِحُبِّ الْخَيْرِ لَشَدِيْدٌؕ۝۸"
    },
    {
      "kind": "text",
      "ar": "اَفَلَا يَعْلَمُ اِذَا بُعْثِرَ مَا فِي الْقُبُوْرِۙ۝۹"
    },
    {
      "kind": "text",
      "ar": "وَحُصِّلَ مَا فِي الصُّدُوْرِۙ۝۱۰"
    },
    {
      "kind": "text",
      "ar": "اِنَّ رَبَّهُمْ بِهِمْ يَوْمَىِٕذٍ لَّخَبِيْرٌ۠۝۱۱"
    }
  ]
}