{
  "id": "salawat-hasnain",
  "title": "امام حسن و حسين پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام حسن و حسين پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّهُمَّ صَلِّ عَلَي الْحَسَنِ وَالْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "عَبْدَيْكَ وَوَلِيَّيْكَ وَابْنَيْ رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَسِبْطَيِ الرَّحْمَةِ، وَسَيِّدَيْ شَبَابِ أَهْلِ الْجَنَّةِ"
    },
    {
      "kind": "text",
      "ar": "أَفْضَلَ مَا صَلَّيْتَ عَلٰي أَحَدٍ مِنْ أَوْلَادِ النَّبِيِّيْنَ وَالْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَي الْحَسَنِ بْنِ سَيِّدِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَوَصِيِّ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ سَيِّدِ الْوَصِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَمِيْنُ اللهِ وَابْنُ أَمِيْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "عِشْتَ مَظْلُوْمًا وَمَضَيْتَ شَهِيْدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ الْاِمَامُ الزَّكِيُّ الْهَادِي الْمَهْدِيُّ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَيْهِ وَبَلِّغْ رُوْحَهٗ وَجَسَدَهٗ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "فِيْ هٰذِهِ السَّاعَةِ أَفْضَلَ التَّحِيَّةِ وَالسَّلَامِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَي الْحُسَيْنِ بْنِ عَلِيٍّ الْمَظْلُوْمِ الشَّهِيْدِ"
    },
    {
      "kind": "text",
      "ar": "قَتِيْلِ الْكَفَرَةِ، وَطَرِيْحِ الْفَجَرَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ مُوْقِنًا أَنَّكَ أَمِيْنُ اللهِ وَابْنُ أَمِيْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "قُتِلْتَ مَظْلُوْمًا، وَمَضَيْتَ شَهِيْدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ اللهَ تَعَالَي الطَّالِبُ بِثَارِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُنْجِزٌ مَا وَعَدَكَ مِنَ النَّصْرِ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّأْيِيْدِ فِيْ هَلَاكِ عَدُوِّكَ وَاِظْهَارِ دَعْوَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ وَفَيْتَ بِعَهْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِيْ سَبِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَعَبَدْتَ اللهَ مُخْلِصًا حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ أُمَّةً قَتَلَتْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ أُمَّةً خَذَلَتْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ أُمَّةً أَلَّبَتْ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْرَأُ اِلَي اللهِ تَعَالٰي مِمَّنْ أَكْذَبَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَخَفَّ بِحَقِّكَ، وَاسْتَحَلَّ دَمَكَ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتَ وَأُمِّيْ يَاأَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ قَاتِلَكَ، وَلَعَنَ اللهُ خَاذِلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ سَمِعَ وَاعِيَتَكَ فَلَمْ يُجِبْكَ وَلَمْ يَنْصُرْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ سَبٰي نِسَائَكَ"
    },
    {
      "kind": "text",
      "ar": "أَنَا اِلَي اللهِ مِنْهُمْ بَرِيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَمِمَّنْ وَالَاهُمْ وَمَالَاهُمْ وَأَعَانَهُمْ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ وَالْاَئِمَّةَ مِنْ وُلْدِكَ"
    },
    {
      "kind": "text",
      "ar": "كَلِمَةُ التَّقْوٰي، وَبَابُ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْعُرْوَةُ الْوُثْقٰي، وَالْحُجَّةُ عَلٰي أَهْلِ الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنِّيْ بِكُمْ مُؤْمِنٌ، وَبِمَنْزِلَتِكُمْ مُوْقِنٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَكُمْ تَابِعٌ بِذَاتِ نَفْسِيْ، وَشَرَايِعِ دِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَخَوَاتِيْمِ عَمَلِيْ، وَمُنْقَلَبِيْ فِيْ دُنْيَايَ وَاٰخِرَتِيْ۔"
    }
  ]
}