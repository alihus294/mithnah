{
  "id": "ziarat-aaleyasin",
  "title": "زيارت آل يٰس",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت آل يٰس",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "سَلَامٌ عَلٰي اٰلِ يٰسٓ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا دَاعِيَ اللهِ وَرَبَّانِيَّ اٰيَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا بَابَ اللهِ وَدَيَّانَ دِيْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا خَلِيْفَةَ اللهِ وَنَاصِرَ حَقِّهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ وَدَلِيْلَ اِرَادَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا تَالِيَ كِتَابِ اللهِ وَتَرْجُمَانَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ فِيْ اٰنَاءِ لَيْلِكَ وَأَطْرَافِ نَهَارِكَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا بَقِيَّةَ اللهِ فِيْ أَرْضِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مِيْثَاقَ اللهِ الَّذِيْ أَخَذَهٗ وَوَكَّدَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَعْدَ اللهِ الَّذِيْ ضَمِنَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْعَلَمُ الْمَنْصُوْبُ"
    },
    {
      "kind": "text",
      "ar": "وَالْعِلْمُ الْمَصْبُوْبُ، وَالْغَوْثُ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّحْمَةُ الْوَاسِعَةُ، وَعْدًا غَيْرَ مَكْذُوْبٍ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيكَ حِيْنَ تَقُوْمُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ حِيْنَ تَقْعُدُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ حِيْنَ تَقْرَأُ وَتُبَيِّنُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ حِيْنَ تُصَلِّيْ وَتَقْنُتُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ حِيْنَ تَرْكَعُ وَتَسْجُدُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ حِيْنَ تُهَلِّلُ وَتُكَبِّرُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ حِيْنَ تَحْمَدُ وَتَسْتَغْفِرُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ حِيْنَ تُصْبِحُ وَتُمْسِيْ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ فِي اللَّيْلِ اِذَا يَغْشٰي"
    },
    {
      "kind": "text",
      "ar": "وَالنَّهَارِ اِذَا تَجَلّٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْاِمَامُ الْمَأْمُوْنُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْمُقَدَّمُ الْمَأْمُوْلُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ بِجَوَامِعِ السَّلَامِ"
    },
    {
      "kind": "text",
      "ar": "أُشْهِدُكَ يَا مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "أَنِّيْ أَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مُحَمَّدًا عَبْدُهٗ وَرَسُوْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "لَا حَبِيْبَ اِلَّا هُوَ وَأَهْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأُشْهِدُكَ يَا مَوْلَايَ أَنَّ عَلِيًّا أَمِيْرَ الْمُؤْمِنِيْنَ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنَ حُجَّتُهٗ وَالْحُسَيْنَ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيَّ بْنَ الْحُسَيْنِ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمُحَمَّدَ بْنَ عَلِيٍّ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَجَعْفَرَ بْنَ مُحَمَّدٍ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمُوْسَي بْنَ جَعْفَرٍ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيَّ بْنَ مُوْسٰي حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمُحَمَّدَ بْنَ عَلِيٍّ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيَّ بْنَ مُحَمَّدٍ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنَ بْنَ عَلِيٍّ حُجَّتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ حُجَّةُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَنْتُمُ الْاَوَّلُ وَالْاٰخِرُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ رَجْعَتَكُمْ حَقٌّ لَا رَيْبَ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "يَوْمَ لَا يَنْفَعُ نَفْسًا اِيْمَانُهَا"
    },
    {
      "kind": "text",
      "ar": "لَمْ تَكُنْ اٰمَنَتْ مِنْ قَبْلُ أَوْ كَسَبَتْ فِيْ اِيْمَانِهَا خَيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ الْمَوْتَ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ نَاكِرًا وَنَكِيْرًا حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ النَّشْرَ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَعْثَ حَقٌّ، وَأَنَّ الصِّرَاطَ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَالْمِرْصَادَ حَقٌّ، وَالْمِيْزَانَ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَشْرَ حَقٌّ، وَالْحِسَابَ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَالْجَنَّةَ وَالنَّارَ حَقٌّ"
    },
    {
      "kind": "text",
      "ar": "وَالْوَعْدَ وَالْوَعِيْدَ بِهِمَا حَقٌّ۔"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ شَقِيَ مَنْ خَالَفَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَسَعِدَ مَنْ أَطَاعَكُمْ"
    },
    {
      "kind": "text",
      "ar": "فَاشْهَدْ عَلٰي مَا أَشْهَدْتُكَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا وَلِيٌّ لَكَ، بَرِيْءٌ مِنْ عَدُوِّكَ"
    },
    {
      "kind": "text",
      "ar": "فَالْحَقُّ مَا رَضِيْتُمُوْهُ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَاطِلُ مَا أَسْخَطْتُمُوْهُ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَعْرُوْفُ مَا أَمَرْتُمْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُنْكَرُ مَا نَهَيْتُمْ عَنْهُ"
    },
    {
      "kind": "text",
      "ar": "فَنَفْسِيْ مُؤْمِنَةٌ بِاللّٰهِ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَبِرَسُوْلِهٖ وَبِأَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِكُمْ يَامَوْلَايَ أَوَّلِكُمْ وَاٰخِرِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَنُصْرَتِيْ مُعَدَّةٌ لَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمَوَدَّتِيْ خَالِصَةٌ لَكُمْ اٰمِيْنَ اٰمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "نَبِيِّ رَحْمَتِكَ وَكَلِمَةِ نُوْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَمْلَأَ قَلْبِيْ نُوْرَ الْيَقِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَصَدْرِيْ نُوْرَ الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَفِكْرِيْ نُوْرَ النِّيَّاتِ"
    },
    {
      "kind": "text",
      "ar": "وَعَزْمِيْ نُوْرَ الْعِلْمِ"
    },
    {
      "kind": "text",
      "ar": "وَقُوَّتِيْ نُوْرَ الْعَمَلِ"
    },
    {
      "kind": "text",
      "ar": "وَلِسَانِيْ نُوْرَ الصِّدْقِ"
    },
    {
      "kind": "text",
      "ar": "وَدِيْنِيْ نُوْرَ الْبَصَائِرِ مِنْ عِنْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَصَرِيْ نُوْرَ الضِّيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَسَمْعِيْ نُوْرَ الْحِكْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمَوَدَّتِيْ نُوْرَ الْمُوَالَاةِ لِمُحَمَّدٍ وَاٰلِهٖ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَلْقَاكَ، وَقَدْ وَفَيْتُ بِعَهْدِكَ وَمِيْثَاقِكَ"
    },
    {
      "kind": "text",
      "ar": "فَتُغَشِّيْنِيْ رَحْمَتَكَ يَا وَلِيُّ يَا حَمِيْدُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ حُجَّتِكَ فِيْ أَرْضِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَلِيْفَتِكَ فِيْ بِلَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالدَّاعِيْ اِلٰي سَبِيْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْقَائِمِ بِقِسْطِكَ، وَالثَّائِرِ بِأَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلِيِّ الْمُؤْمِنِيْنَ، وَبَوَارِ الْكَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمُجَلِّي الظُّلْمَةِ، وَمُنِيْرِ الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّاطِقِ بِالْحِكْمَةِ وَالصِّدْقِ"
    },
    {
      "kind": "text",
      "ar": "وَكَلِمَتِكَ التَّآمَّةِ فِيْ أَرْضِكَ"
    },
    {
      "kind": "text",
      "ar": "الْمُرْتَقِبِ الْخَائِفِ، وَالْوَلِيِّ النَّاصِحِ"
    },
    {
      "kind": "text",
      "ar": "سَفِيْنَةِ النَّجَاةِ، وَعَلَمِ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَنُوْرِ أَبْصَارِ الْوَرٰي"
    },
    {
      "kind": "text",
      "ar": "وَخَيْرِ مَنْ تَقَمَّصَ وَارْتَدٰي، وَمُجَلِّي الْعَمٰي"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ يَمْلَاُ الْاَرْضَ عَدْلًا وَقِسْطًا"
    },
    {
      "kind": "text",
      "ar": "كَمَا مُلِئَتْ ظُلْمًا وَجَوْرًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي وَلِيِّكَ وَابْنِ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ فَرَضْتَ طَاعَتَهُمْ وَأَوْجَبْتَ حَقَّهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَذْهَبْتَ عَنْهُمُ الرِّجْسَ وَطَهَّرْتَهُمْ تَطْهِيْرًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ انْصُرْهُ وَانْتَصِرْ بِهٖ لِدِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْ بِهٖ أَوْلِيَائَكَ وَأَوْلِيَائَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَشِيْعَتَهٗ وَأَنْصَارَهٗ، وَاجْعَلْنَا مِنْهُمْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعِذْهُ مِنْ شَرِّ كُلِّ بَاغٍ وَطَاغٍ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ جَمِيْعِ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْهُ مِنْ بَيْنِ يَدَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ خَلْفِهٖ وَعَنْ يَمِيْنِهٖ وَعَنْ شِمَالِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْرُسْهُ وَامْنَعْهُ مِنْ أَنْ يُوْصَلَ اِلَيْهِ بِسُوْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْ فِيْهِ رَسُوْلَكَ وَاٰلَ رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَظْهِرْ بِهِ الْعَدْلَ"
    },
    {
      "kind": "text",
      "ar": "وَأَيِّدْهُ بِالنَّصْرِ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْ نَاصِرِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَاخْذُلْ خَاذِلِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْصِمْ قَاصِمِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْصِمْ بِهٖ جَبَابِرَةَ الْكُفْرِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْتُلْ بِهِ الْكُفَّارَ وَالْمُنَافِقِيْنَ وَجَمِيْعَ الْمُلْحِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "حَيْثُ كَانُوْا مِنْ مَشَارِقِ الْاَرْضِ وَمَغَارِبِهَا"
    },
    {
      "kind": "text",
      "ar": "بَرِّهَا وَبَحْرِهَا"
    },
    {
      "kind": "text",
      "ar": "وَامْلَأْ بِهِ الْاَرْضَ عَدْلًا"
    },
    {
      "kind": "text",
      "ar": "وَأَظْهِرْ بِهٖ دِيْنَ نَبِيِّكَ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَسَلَّمْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ اللّٰهُمَّ مِنْ أَنْصَارِهٖ وَأَعْوَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَتْبَاعِهٖ وَشِيْعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَرِنِيْ فِيْ اٰلِ مُحَمَّدٍ عَلَيْهِمُ السَّلَامُ مَا يَأْمُلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ عَدُوِّهِمْ مَا يَحْذَرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهَ الْحَقِّ اٰمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا ذَا الْجَلَالِ وَالْاِكْرَامِ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}