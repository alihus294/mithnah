{
  "id": "ramadan-day17-dua",
  "title": "سترهويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سترهويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اهْدِنِيْ فِيْهِ لِصَالِحِ الْاَعْمَالِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْضِ لِيْ فِيْهِ الْحَوَائِجَ وَالْاٰمَالَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يَحْتَاجُ اِلَي التَّفْسِيْرِ وَالسُّؤَالِ"
    },
    {
      "kind": "text",
      "ar": "يَا عَالِمًا بِمَا فِيْ صُدُوْرِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ الطَّاهِرِيْنَ۔"
    }
  ]
}