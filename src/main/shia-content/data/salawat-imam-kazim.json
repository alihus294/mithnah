{
  "id": "salawat-imam-kazim",
  "title": "امام موسيٰ كاظم پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام موسيٰ كاظم پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَي الْاَمِيْنِ الْمُؤْتَمَنِ مُوْسَي بْنِ جَعْفَرٍ"
    },
    {
      "kind": "text",
      "ar": "الْبَرِّ الْوَفِيِّ، الطَّاهِرِ الزَّكِيِّ"
    },
    {
      "kind": "text",
      "ar": "النُّوْرِ الْمُبِيْنِ، الْمُجْتَهِدِ الْمُحْتَسِبِ"
    },
    {
      "kind": "text",
      "ar": "الصَّابِرِ عَلَي الْاَذٰي فِيْكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَكَمَا بَلَّغَ عَنْ اٰبَائِهٖ مَا اسْتُوْدِعَ مِنْ أَمْرِكَ وَنَهْيِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَمَلَ عَلَي الْمَحَجَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَكَابَدَ أَهْلَ الْعِزَّةِ وَالشِّدَّةِ"
    },
    {
      "kind": "text",
      "ar": "فِيْمَا كَانَ يَلْقٰي مِنْ جُهَّالِ قَوْمِهٖ"
    },
    {
      "kind": "text",
      "ar": "رَبِّ فَصَلِّ عَلَيْهِ أَفْضَلَ وَأَكْمَلَ"
    },
    {
      "kind": "text",
      "ar": "مَا صَلَّيْتَ عَلٰي أَحَدٍ مِمَّنْ أَطَاعَكَ وَنَصَحَ لِعِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ غَفُوْرٌ رَحِيْمٌ۔"
    }
  ]
}