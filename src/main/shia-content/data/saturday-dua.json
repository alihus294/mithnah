{
  "id": "saturday-dua",
  "title": "هفتے كے دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "هفتے كے دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ كَلِمَةِ الْمُعْتَصِمِيْنَ، وَمَقَالَةِ الْمُتَحَرِّزِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِاللهِ تَعَالٰي مِنْ جَوْرِالْجَائِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَكَيْدِ الْحَاسِدِيْنَ، وَبَغيِ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْمَدُهٗ فَوْقَ حَمْدِ الْحَامِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الْوَاحِدُ بِلَا شَرِيْكٍ، وَالْمَلِكُ بِلَا تَمْلِيْكٍ"
    },
    {
      "kind": "text",
      "ar": "لَا تُضَادُّ فِيْ حُكْمِكَ، وَلَا تُنَازَعُ فِيْ مُلْكِكَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ عَبْدِكَ وَرَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تُوْزِعَنِيْ مِنْ شُكْرِ نُعْمَاكَ"
    },
    {
      "kind": "text",
      "ar": "مَا تَبْلُغُ بِيْ غَايَةَ رِضَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تُعِيْنَنِيْ عَلٰي طَاعَتِكَ وَلُزُوْمِ عِبَادَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتِحْقَاقِ مَثُوْبَتِكَ بِلُطْفِ عِنَايَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَرْحَمَنِيْ بِصَدِّيْ عَنْ مَعَاصِيْكَ مَا أَحْيَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُوَفِّقَنِيْ لِمَا يَنْفَعُنِيْ مَا أَبْقَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَشْرَحَ بِكِتَابِكَ صَدْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَحُطَّ بِتِلَاوَتِهٖ وِزْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَمْنَحَنِي السَّلَامَةَ فِيْ دِيْنِيْ وَنَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُوْحِشَ بِيْ أَهْلَ أُنْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُتِمَّ اِحْسَانَكَ فِيَمَا بَقِيَ مِنْ عُمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "كَمَا أَحْسَنْتَ فِيَمَا مَضٰي مِنْهُ، يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}