{
  "id": "sura-waqia",
  "title": "سورۂ واقعه",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ واقعه",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اِذَا وَقَعَتِ الْوَاقِعَةُۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌۘ۝۲"
    },
    {
      "kind": "text",
      "ar": "خَافِضَةٌ رَّافِعَةٌۙ۝۳"
    },
    {
      "kind": "text",
      "ar": "اِذَا رُجَّتِ الْاَرْضُ رَجًّاۙ۝۴"
    },
    {
      "kind": "text",
      "ar": "وَّبُسَّتِ الْجِبَالُ بَسًّاۙ۝۵"
    },
    {
      "kind": "text",
      "ar": "فَكَانَتْ هَبَآءً مُّنْۢبَثًّاۙ۝۶"
    },
    {
      "kind": "text",
      "ar": "وَّكُنْتُمْ اَزْوَاجًا ثَلٰثَةًؕ۝۷"
    },
    {
      "kind": "text",
      "ar": "فَاَصْحٰبُ الْمَيْمَنَةِ١ۙ۬ مَاۤ اَصْحٰبُ الْمَيْمَنَةِؕ۝۸"
    },
    {
      "kind": "text",
      "ar": "وَاَصْحٰبُ الْمَشْـَٔمَةِ١ۙ۬ مَاۤ اَصْحٰبُ الْمَشْـَٔمَةِؕ۝۹"
    },
    {
      "kind": "text",
      "ar": "وَالسّٰبِقُوْنَ السّٰبِقُوْنَۚۙ۝۱۰"
    },
    {
      "kind": "text",
      "ar": "اُولٰٓىِٕكَ الْمُقَرَّبُوْنَۚ۝۱۱"
    },
    {
      "kind": "text",
      "ar": "فِيْ جَنّٰتِ النَّعِيْمِ۝۱۲"
    },
    {
      "kind": "text",
      "ar": "ثُلَّةٌ مِّنَ الْاَوَّلِيْنَۙ۝۱۳"
    },
    {
      "kind": "text",
      "ar": "وَقَلِيْلٌ مِّنَ الْاٰخِرِيْنَؕ۝۱۴"
    },
    {
      "kind": "text",
      "ar": "عَلٰى سُرُرٍ مَّوْضُوْنَةٍۙ۝۱۵"
    },
    {
      "kind": "text",
      "ar": "مُّتَّكِـِٕيْنَ عَلَيْهَا مُتَقٰبِلِيْنَ۝۱۶"
    },
    {
      "kind": "text",
      "ar": "يَطُوْفُ عَلَيْهِمْ وِلْدَانٌ مُّخَلَّدُوْنَۙ۝۱۷"
    },
    {
      "kind": "text",
      "ar": "بِاَكْوَابٍ وَّاَبَارِيْقَ١ۙ۬ وَكَاْسٍ مِّنْ مَّعِيْنٍۙ۝۱۸"
    },
    {
      "kind": "text",
      "ar": "لَّا يُصَدَّعُوْنَ عَنْهَا وَلَا يُنْزِفُوْنَۙ۝۱۹"
    },
    {
      "kind": "text",
      "ar": "وَفَاكِهَةٍ مِّمَّا يَتَخَيَّرُوْنَۙ۝۲۰"
    },
    {
      "kind": "text",
      "ar": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُوْنَؕ۝۲۱"
    },
    {
      "kind": "text",
      "ar": "وَحُوْرٌ عِيْنٌۙ۝۲۲"
    },
    {
      "kind": "text",
      "ar": "كَاَمْثَالِ اللُّؤْلُؤِ الْمَكْنُوْنِۚ۝۲۳"
    },
    {
      "kind": "text",
      "ar": "جَزَآءًۢ بِمَا كَانُوْا يَعْمَلُوْنَ۝۲۴"
    },
    {
      "kind": "text",
      "ar": "لَا يَسْمَعُوْنَ فِيْهَا لَغْوًا وَّلَا تَاْثِيْمًاۙ۝۲۵"
    },
    {
      "kind": "text",
      "ar": "اِلَّا قِيْلًا سَلٰمًا سَلٰمًا۝۲۶"
    },
    {
      "kind": "text",
      "ar": "وَاَصْحٰبُ الْيَمِيْنِ١ۙ۬ مَاۤ اَصْحٰبُ الْيَمِيْنِؕ۝۲۷"
    },
    {
      "kind": "text",
      "ar": "فِيْ سِدْرٍ مَّخْضُوْدٍۙ۝۲۸"
    },
    {
      "kind": "text",
      "ar": "وَّطَلْحٍ مَّنْضُوْدٍۙ۝۲۹"
    },
    {
      "kind": "text",
      "ar": "وَّظِلٍّ مَّمْدُوْدٍۙ۝۳۰"
    },
    {
      "kind": "text",
      "ar": "وَّمَآءٍ مَّسْكُوْبٍۙ۝۳۱"
    },
    {
      "kind": "text",
      "ar": "وَّفَاكِهَةٍ كَثِيْرَةٍۙ۝۳۲"
    },
    {
      "kind": "text",
      "ar": "لَّا مَقْطُوْعَةٍ وَّلَا مَمْنُوْعَةٍۙ۝۳۳"
    },
    {
      "kind": "text",
      "ar": "وَّفُرُشٍ مَّرْفُوْعَةٍؕ۝۳۴"
    },
    {
      "kind": "text",
      "ar": "اِنَّاۤ اَنْشَاْنٰهُنَّ اِنْشَآءًۙ۝۳۵"
    },
    {
      "kind": "text",
      "ar": "فَجَعَلْنٰهُنَّ اَبْكَارًاۙ۝۳۶"
    },
    {
      "kind": "text",
      "ar": "عُرُبًا اَتْرَابًاۙ۝۳۷"
    },
    {
      "kind": "text",
      "ar": "لِّاَصْحٰبِ الْيَمِيْنِ٢ؕ۠۝۳۸"
    },
    {
      "kind": "text",
      "ar": "ثُلَّةٌ مِّنَ الْاَوَّلِيْنَۙ۝۳۹"
    },
    {
      "kind": "text",
      "ar": "وَثُلَّةٌ مِّنَ الْاٰخِرِيْنَؕ۝۴۰"
    },
    {
      "kind": "text",
      "ar": "وَاَصْحٰبُ الشِّمَالِ١ۙ۬ مَاۤ اَصْحٰبُ الشِّمَالِؕ۝۴۱"
    },
    {
      "kind": "text",
      "ar": "فِيْ سَمُوْمٍ وَّحَمِيْمٍۙ۝۴۲"
    },
    {
      "kind": "text",
      "ar": "وَّظِلٍّ مِّنْ يَّحْمُوْمٍۙ۝۴۳"
    },
    {
      "kind": "text",
      "ar": "لَّا بَارِدٍ وَّلَا كَرِيْمٍ۝۴۴"
    },
    {
      "kind": "text",
      "ar": "اِنَّهُمْ كَانُوْا قَبْلَ ذٰلِكَ مُتْرَفِيْنَۚۖ۝۴۵"
    },
    {
      "kind": "text",
      "ar": "وَكَانُوْا يُصِرُّوْنَ عَلَى الْحِنْثِ الْعَظِيْمِۚ۝۴۶"
    },
    {
      "kind": "text",
      "ar": "وَكَانُوْا يَقُوْلُوْنَ١ۙ۬ اَىِٕذَا مِتْنَا"
    },
    {
      "kind": "text",
      "ar": "وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبْعُوْثُوْنَۙ۝۴۷"
    },
    {
      "kind": "text",
      "ar": "اَوَ اٰبَآؤُنَا الْاَوَّلُوْنَ۝۴۸"
    },
    {
      "kind": "text",
      "ar": "قُلْ اِنَّ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَۙ۝۴۹"
    },
    {
      "kind": "text",
      "ar": "لَمَجْمُوْعُوْنَ١ۙ۬ اِلٰى مِيْقَاتِ يَوْمٍ مَّعْلُوْمٍ۝۵۰"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ اِنَّكُمْ اَيُّهَا الضَّآلُّوْنَ الْمُكَذِّبُوْنَۙ۝۵۱"
    },
    {
      "kind": "text",
      "ar": "لَاٰكِلُوْنَ مِنْ شَجَرٍ مِّنْ زَقُّوْمٍۙ۝۵۲"
    },
    {
      "kind": "text",
      "ar": "فَمَالِـُٔوْنَ مِنْهَا الْبُطُوْنَۚ۝۵۳"
    },
    {
      "kind": "text",
      "ar": "فَشٰرِبُوْنَ عَلَيْهِ مِنَ الْحَمِيْمِۚ۝۵۴"
    },
    {
      "kind": "text",
      "ar": "فَشٰرِبُوْنَ شُرْبَ الْهِيْمِؕ۝۵۵"
    },
    {
      "kind": "text",
      "ar": "هٰذَا نُزُلُهُمْ يَوْمَ الدِّيْنِؕ۝۵۶"
    },
    {
      "kind": "text",
      "ar": "نَحْنُ خَلَقْنٰكُمْ فَلَوْ لَا تُصَدِّقُوْنَ۝۵۷"
    },
    {
      "kind": "text",
      "ar": "اَفَرَءَيْتُمْ مَّا تُمْنُوْنَؕ۝۵۸"
    },
    {
      "kind": "text",
      "ar": "ءَاَنْتُمْ تَخْلُقُوْنَهٗۤ اَمْ نَحْنُ الْخٰلِقُوْنَ۝۵۹"
    },
    {
      "kind": "text",
      "ar": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوْقِيْنَۙ۝۶۰"
    },
    {
      "kind": "text",
      "ar": "عَلٰۤى اَنْ نُّبَدِّلَ اَمْثَالَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَنُنْشِئَكُمْ فِيْ مَا لَا تَعْلَمُوْنَ۝۶۱"
    },
    {
      "kind": "text",
      "ar": "وَلَقَدْ عَلِمْتُمُ النَّشْاَةَ الْاُوْلٰى فَلَوْ لَا تَذَكَّرُوْنَ۝۶۲"
    },
    {
      "kind": "text",
      "ar": "اَفَرَءَيْتُمْ مَّا تَحْرُثُوْنَؕ۝۶۳"
    },
    {
      "kind": "text",
      "ar": "ءَاَنْتُمْ تَزْرَعُوْنَهٗۤ اَمْ نَحْنُ الزّٰرِعُوْنَ۝۶۴"
    },
    {
      "kind": "text",
      "ar": "لَوْ نَشَآءُ لَجَعَلْنٰهُ حُطَامًا فَظَلْتُمْ تَفَكَّهُوْنَ۝۶۵"
    },
    {
      "kind": "text",
      "ar": "اِنَّا لَمُغْرَمُوْنَۙ۝۶۶"
    },
    {
      "kind": "text",
      "ar": "بَلْ نَحْنُ مَحْرُوْمُوْنَ۝۶۷"
    },
    {
      "kind": "text",
      "ar": "اَفَرَءَيْتُمُ الْمَآءَ الَّذِيْ تَشْرَبُوْنَؕ۝۶۸"
    },
    {
      "kind": "text",
      "ar": "ءَاَنْتُمْ اَنْزَلْتُمُوْهُ مِنَ الْمُزْنِ اَمْ نَحْنُ الْمُنْزِلُوْنَ۝۶۹"
    },
    {
      "kind": "text",
      "ar": "لَوْ نَشَآءُ جَعَلْنٰهُ اُجَاجًا فَلَوْ لَا تَشْكُرُوْنَ۝۷۰"
    },
    {
      "kind": "text",
      "ar": "اَفَرَءَيْتُمُ النَّارَ الَّتِيْ تُوْرُوْنَؕ۝۷۱"
    },
    {
      "kind": "text",
      "ar": "ءَاَنْتُمْ اَنْشَاْتُمْ شَجَرَتَهَاۤ اَمْ نَحْنُ الْمُنْشِـُٔوْنَ۝۷۲"
    },
    {
      "kind": "text",
      "ar": "نَحْنُ جَعَلْنٰهَا تَذْكِرَةً وَّمَتَاعًا لِّلْمُقْوِيْنَۚ۝۷۳"
    },
    {
      "kind": "text",
      "ar": "فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيْمِ۠۝۷۴"
    },
    {
      "kind": "text",
      "ar": "فَلَاۤ اُقْسِمُ بِمَوٰقِعِ النُّجُوْمِۙ۝۷۵"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّهٗ لَقَسَمٌ لَّوْ تَعْلَمُوْنَ عَظِيْمٌۙ۝۷۶"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ لَقُرْاٰنٌ كَرِيْمٌۙ۝۷۷"
    },
    {
      "kind": "text",
      "ar": "فِيْ كِتٰبٍ مَّكْنُوْنٍۙ۝۷۸"
    },
    {
      "kind": "text",
      "ar": "لَّا يَمَسُّهٗۤ اِلَّا الْمُطَهَّرُوْنَؕ۝۷۹"
    },
    {
      "kind": "text",
      "ar": "تَنْزِيْلٌ مِّنْ رَّبِّ الْعٰلَمِيْنَ۝۸۰"
    },
    {
      "kind": "text",
      "ar": "اَفَبِهٰذَا الْحَدِيْثِ اَنْتُمْ مُّدْهِنُوْنَۙ۝۸۱"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلُوْنَ رِزْقَكُمْ اَنَّكُمْ تُكَذِّبُوْنَ۝۸۲"
    },
    {
      "kind": "text",
      "ar": "فَلَوْ لَاۤ اِذَا بَلَغَتِ الْحُلْقُوْمَۙ۝۸۳"
    },
    {
      "kind": "text",
      "ar": "وَاَنْتُمْ حِيْنَىِٕذٍ تَنْظُرُوْنَۙ۝۸۴"
    },
    {
      "kind": "text",
      "ar": "وَنَحْنُ اَقْرَبُ اِلَيْهِ مِنْكُمْ وَلٰكِنْ لَّا تُبْصِرُوْنَ۝۸۵"
    },
    {
      "kind": "text",
      "ar": "فَلَوْ لَاۤ اِنْ كُنْتُمْ غَيْرَ مَدِيْنِيْنَۙ۝۸۶"
    },
    {
      "kind": "text",
      "ar": "تَرْجِعُوْنَهَاۤ اِنْ كُنْتُمْ صٰدِقِيْنَ۝۸۷"
    },
    {
      "kind": "text",
      "ar": "فَاَمَّاۤ اِنْ كَانَ مِنَ الْمُقَرَّبِيْنَۙ۝۸۸"
    },
    {
      "kind": "text",
      "ar": "فَرَوْحٌ وَّرَيْحَانٌ١ۙ۬ وَّجَنَّتُ نَعِيْمٍ۝۸۹"
    },
    {
      "kind": "text",
      "ar": "وَاَمَّاۤ اِنْ كَانَ مِنْ اَصْحٰبِ الْيَمِيْنِۙ۝۹۰"
    },
    {
      "kind": "text",
      "ar": "فَسَلٰمٌ لَّكَ مِنْ اَصْحٰبِ الْيَمِيْنِؕ۝۹۱"
    },
    {
      "kind": "text",
      "ar": "وَاَمَّاۤ اِنْ كَانَ مِنَ الْمُكَذِّبِيْنَ الضَّآلِّيْنَۙ۝۹۲"
    },
    {
      "kind": "text",
      "ar": "فَنُزُلٌ مِّنْ حَمِيْمٍۙ۝۹۳"
    },
    {
      "kind": "text",
      "ar": "وَّتَصْلِيَةُ جَحِيْمٍ۝۹۴"
    },
    {
      "kind": "text",
      "ar": "اِنَّ هٰذَا لَهُوَ حَقُّ الْيَقِيْنِۚ۝۹۵"
    },
    {
      "kind": "text",
      "ar": "فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيْمِ۠۝۹۶"
    }
  ]
}