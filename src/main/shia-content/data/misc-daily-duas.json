    },
    {
      "kind": "text",
      "ar": "أَسْأَلُ الله الْجَنَّةَ وَأَعُوْذُ بِاللّٰهِ مِنَ النَّارِ۔"
    },
    {
      "kind": "text",
      "ar": "أَسْتَغْفِرُ الله الَّذِيْ لَا اِلٰهَ اِلَّا هُوَ الْحَيُّ الْقَيُّوْمُ"
    },
    {
      "kind": "text",
      "ar": "بَدِيْعُ السَّمٰوَاتِ وَالْاَرْضِ ذُوالْجَلَالِ وَالْاِكْرَامِ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُهٗ أَنْ يَتُوْبَ عَلَيَّ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ عَلٰي كُلِّ نِعْمَةٍ كَانَتْ أَوْ هِيَ كَائِنَةٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْ لِلْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ وَالْمُسْلِمِيْنَ وَالْمُسْلِمَاتِ۔"
    },
    {
      "kind": "text",
      "ar": "لَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ۔"
    },
    {
      "kind": "text",
      "ar": "أسْتَغْفِرُ اللهَ۔"
    },
    {
      "kind": "text",
      "ar": "أَتُوْبُ اِلَي اللهِ۔"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ الْمَلِكُ الْحَقُّ الْمُبِيْنُ۔"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الله كَمَا يَنْبَغِيْ لِلّٰهِ"
