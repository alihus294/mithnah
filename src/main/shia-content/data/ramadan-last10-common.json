{
  "id": "ramadan-last10-common",
  "title": "آخري دس راتوں كي مشتركه دعائيں",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "آخري دس راتوں كي مشتركه دعائيں",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِجَلَالِ وَجْهِكَ الْكَرِيْمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ يَنْقَضِيْ عَنِّيْ شَهْرُ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "أَوْ يَطْلُعَ الْفَجْرُ مِنْ لَيْلَتِيْ هٰذِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ قِبَلِيْ ذَنْبٌ أَوْ تَبِعَةٌ تُعَذِّبُنِيْ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَدِّ عَنَّا حَقَّ مَا مَضٰي مِنْ شَهْرِ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لَنَا تَقْصِيْرَنَا فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَتَسَلَّمْهُ مِنَّا مَقْبُوْلًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُؤَاخِذْنَا بِاِسْرَافِنَا عَلٰي أَنْفُسِنَا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا مِنَ الْمَرْحُوْمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْنَا مِنَ الْمَحْرُوْمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّكَ قُلْتَ فِيْ كِتَابِكَ الْمُنْزَلِ"
    },
    {
      "kind": "text",
      "ar": "شَهْرُ رَمَضَانَ الَّذِيْ أُنْزِلَ فِيْهِ الْقُرْاٰنُ"
    },
    {
      "kind": "text",
      "ar": "هُدًى لِلنَّاسِ وَبَيِّنَاتٍ مِنَ الْهُدٰي وَالْفُرْقَانِ"
    },
    {
      "kind": "text",
      "ar": "فَعَظَّمْتَ حُرْمَةَ شَهْرِ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "بِمَا أَنْزَلْتَ فِيْهِ مِنَ الْقُرْاٰنِ"
    },
    {
      "kind": "text",
      "ar": "وَخَصَصْتَهٗ بِلَيْلَةِ الْقَدْرِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهَا خَيْرًا مِنْ أَلْفِ شَهْرٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَهٰذِهٖ أَيَّامُ شَهْرِ رَمَضَانَ قَدِ انْقَضَتْ"
    },
    {
      "kind": "text",
      "ar": "وَلَيَالِيْهِ قَدْ تَصَرَّمَتْ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ صِرْتُ يَا اِلٰهِيْ مِنْهُ اِلٰي مَا أَنْتَ أَعْلَمُ بِهٖ مِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْصٰي لِعَدَدِهٖ مِنَ الْخَلْقِ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْأَلُكَ بِمَا سَأَلَكَ بِهٖ مَلَائِكَتُكَ الْمُقَرَّبُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْبِيَاؤُكَ الْمُرْسَلُوْنَ، وَعِبَادُكَ الصَّالِحُوْنَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَفُكَّ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَتُدْخِلَنِي الْجَنَّةَ برَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَتَفَضَّلَ عَلَيَّ بِعَفْوِكَ وَكَرَمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَتَقَبَّلَ تَقَرُّبِيْ، وَتَسْتَجِيْبَ دُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَمُنَّ عَلَيَّ بِالْاَمْنِ يَوْمَ الْخَوْفِ"
    },
    {
      "kind": "text",
      "ar": "مِنْ كُلِّ هَوْلٍ أَعْدَدْتَهٗ لِيَوْمِ الْقِيَامَةِ۔"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ وَأَعُوْذُ بِوَجْهِكَ الْكَرِيْمِ وَبِجَلَالِكَ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَنْقَضِيَ أَيَّامُ شَهْرِ رَمَضَانَ وَلَيَالِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ قِبَلِيْ تَبِعَةٌ أَوْ ذَنْبٌ تُؤَاخِذُنِيْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَوْ خَطِيْئَةٌ تُرِيْدُ أَنْ تَقْتَصَّهَا مِنِّيْ لَمْ تَغْفِرْهَا لِيْ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدِيْ سَيِّدِيْ سَيِّدِيْ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ يَا لَا اِلٰهَ اِلَّا أَنْتَ اِذْ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "اِنْ كُنْتَ رَضِيْتَ عَنِّيْ فِيْ هٰذَا الشَّهْرِ"
    },
    {
      "kind": "text",
      "ar": "فَازْدَدْ عَنِّيْ رِضًى"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ لَمْ تَكُنْ رَضِيْتَ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "فَمِنَ الْاٰنَ فَارْضَ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا أَحَدُ يَا صَمَدُ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَمْ يَلِدْ وَلَمْ يُوْلَدْ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ كُفُوًا أَحَدٌ"
    },
    {
      "kind": "text",
      "ar": "يَا مُلَيِّنَ الْحَدِيْدِ لِدَاوُوْدَ عَلَيْهِ اَلسَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "يَا كَاشِفَ الضُّرِّ وَالْكُرَبِ الْعِظَامِ عَنْ أَيُّوْبَ"
    },
    {
      "kind": "text",
      "ar": "أَيْ مُفَرِّجَ هَمِّ يَعْقُوْبَ"
    },
    {
      "kind": "text",
      "ar": "أَيْ مُنَفِّسَ غَمِّ يُوْسُفَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ كَمَا أَنْتَ أَهْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلَيْهِمْ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَافْعَلْ بِيْ مَا أَنْتَ أَهْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَفْعَلْ بِيْ مَا أَنَا أَهْلُهٗ۔"
    }
  ]
}