{
  "id": "ramadan-night26-dua",
  "title": "چهبيسويں شب كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "چهبيسويں شب كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا جَاعِلَ اللَّيْلِ وَالنَّهَارِ اٰيَتَيْنِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ مَحَا اٰيَةَ اللَّيْلِ وَجَعَلَ اٰيَةَ النَّهَارِ مُبْصِرَةً"
    },
    {
      "kind": "text",
      "ar": "لِتَبْتَغُوْا فَضْلًا مِنْهُ وَرِضْوَانًا"
    },
    {
      "kind": "text",
      "ar": "يَا مُفَصِّلَ كُلِّ شَيْءٍ تَفْصِيْلًا"
    },
    {
      "kind": "text",
      "ar": "يَا مَاجِدُ يَا وَهَّابُ يَا اللهُ يَا جَوَادُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا اللهُ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْاَسْمَاءُ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْاَمْثَالُ الْعُلْيَا، وَالْكِبْرِيَاءُ وَالْاٰلَاءُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ اسْمِيْ فِيْ هٰذِهِ اللَّيْلَةِ فِي السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَرُوْحِيْ مَعَ الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاِحْسَانِيْ فِيْ عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِسَائَتِيْ مَغْفُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَهَبَ لِيْ يَقِيْنًا تُبَاشِرُ بِهٖ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِيْمَانًا يُذْهِبُ الشَّكَّ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُرْضِيَنِيْ بِمَا قَسَمْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا فِي الدُّنْيَا حَسَنَةً، وَفِي الْاٰخِرَةِ حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِنَا عَذَابَ النّارِ الْحَرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ فِيْهَا ذِكْرَكَ وَشُكْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّغْبَةَ اِلَيْكَ وَالْاِنَابَةَ وَالتَّوْبَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّوْفِيْقَ لِمَا وَفَّقْتَ لَهٗ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِ وَعَلَيْهِمْ۔"
    }
  ]
}