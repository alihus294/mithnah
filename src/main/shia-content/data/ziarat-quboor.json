{
  "id": "ziarat-quboor",
  "title": "زيارت قبور مومنين",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت قبور مومنين",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَهْلِ الدِّيَارِ مِنَ الْمُؤْمِنِيْنَ وَالْمُسْلِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَنْتُمْ لَنَا فَرَطٌ وَنَحْنُ اِنْ شَاءَ اللهُ بِكُمْ لَاحِقُوْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّ هٰذِهِ الْاَرْوَاحِ الْفَانِيَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَجْسَادِ الْبَالِيَةِ، وَالْعِظَامِ النَّخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ خَرَجَتْ مِنَ الدُّنْيَا وَهِيَ بِكَ مُؤْمِنَةٌ"
    },
    {
      "kind": "text",
      "ar": "أَدْخِلْ عَلَيْهِمْ رَوْحًا مِنْكَ وَسَلَامًا مِنِّيْ۔"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَهْلِ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "مِنْ أَهْلِ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "يَا أَهْلَ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "بِحَقِّ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "كَيْفَ وَجَدْتُمْ قَوْلَ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "مِنْ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "يَا لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "بِحَقِّ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "اغْفِرْ لِمَنْ قَالَ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنَا فِيْ زُمْرَةِ مَنْ قَالَ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ، مُحَمَّدٌ رَسُوْلُ اللهِ، عَلِيٌّ وَلِيُّ اللهِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَلِّهُمْ مَا تَوَّلُوْا"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْهُمْ مَعْ مَنْ اَحَبُّوْا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْحَمْ غُرْبَتَهٗ، وَصِلْ وَحْدَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاٰنِسْ وَحْشَتَهٗ، وَاٰمِنْ رَوْعَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْكِنْ اِلَيْهِ مِنْ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "رَحْمَةً يَسْتَغْنِيْ بِهَا عَنْ رَحْمَةِ مَنْ سِوَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْحِقْهُ بِمَنْ كَانَ يَتَوَلَّاهُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ جَافِ الْاَرْضَ عَنْ جُنُوْبِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَصَاعِدْ اِلَيْكَ أَرْوَاحَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَلَقِّهِمْ مِنْكَ رِضْوَانًا"
    },
    {
      "kind": "text",
      "ar": "وَأَسْكِنْ اِلَيْهِمْ مِنْ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "مَا تَصِلُ بِهٖ وَحْدَتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَتُؤْنِسُ بِهٖ وَحْشَتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ اَسْئَلُكَ بِحَقِّ مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "اَنْ لَا تُعَذِّبَ هٰذَا الْمَيِّتَ۔"
    }
  ]
}