{
  "id": "ziarat-imam-hussain-6",
  "title": "چهٹي زيارت مطلقه",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "چهٹي زيارت مطلقه",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَبَا عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا سَيِّدَ شَبَابِ أَهْلِ الْجَنَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَنْ رِضَاهُ مِنْ رِضَي الرَّحْمٰنِ"
    },
    {
      "kind": "text",
      "ar": "وَسَخَطُهٗ مِنْ سَخَطِ الرَّحْمٰنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَمِيْنَ اللهِ، وَحُجَّةَ اللهِ، وَبَابَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَالدَّلِيْلَ عَلَي اللهِ، وَالدَّاعِيَ اِلَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ حَلَّلْتَ حَلَالَ اللهِ، وَحَرَّمْتَ حَرَامَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَقَمْتَ الصَّلَاةَ، وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ، وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَوْتَ اِلٰي سَبِيْلِ رَبِّكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ وَمَنْ قُتِلَ مَعَكَ شُهَدَاءُ"
    },
    {
      "kind": "text",
      "ar": "أَحْيَاءٌ عِنْدَ رَبِّكُمْ تُرْزَقُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ قَاتِلَكَ فِي النَّارِ"
    },
    {
      "kind": "text",
      "ar": "أَدِيْنُ اللهَ بِالْبَرَائَةِ مِمَّنْ قَتَلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِمَّنْ قَاتَلَكَ، وَشَايَعَ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِمَّنْ جَمَعَ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِمَّنْ سَمِعَ صَوْتَكَ وَلَمْ يُعِنْكَ"
    },
    {
      "kind": "text",
      "ar": "يَا لَيْتَنِيْ كُنْتُ مَعَكُمْ فَأَفُوْزَ فَوْزًا عَظِيْمًا۔"
    }
  ]
}