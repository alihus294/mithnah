{
  "id": "nowroz",
  "title": "اعمال عيد نوروز",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "اعمال عيد نوروز",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ الْاَوصِيَاءِ الْمَرْضِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي جَمِيْعِ أَنْبِيَائِكَ وَرُسُلِكَ بِأَفْضَلِ صَلَوَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ عَلَيْهِمْ بِأَفْضَلِ بَرَكَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي أَرْوَاحِهِمْ وَأَجْسَادِهِمْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بَارِكْ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ لَنَا فِيْ يَوْمِنَا هٰذَا الَّذِيْ فَضَّلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَكَرَّمْتَهٗ وَشَرَّفْتَهٗ وَعَظَّمْتَ خَطَرَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بَارِكْ لِيْ فِيْمَا أَنْعَمْتَ بِهٖ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا أَشْكُرَ أَحَدًا غَيْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَسِّعْ عَلَيَّ فِيْ رِزْقِيْ، يَا ذَا الْجَلَالِ وَالْاِكْرَامِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَا غَابَ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "فَلَا يَغِيْبَنَّ عَنِّيْ عَوْنُكَ وَحِفْظُكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَا فَقَدْتُ مِنْ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تُفْقِدْنِيْ عَوْنَكَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا أَتَكَلَّفَ مَا لَا أَحْتَاجُ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "يَا ذَا الْجَلَالِ وَالْاِكْرَامِ (حاشيه ۱)"
    },
    {
      "kind": "text",
      "ar": "يَا ذَالْجَلَالِ وَالْاِكْرَمِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحَوِّلَ الْحَوْلِ وَالْاَحْوَالِ"
    },
    {
      "kind": "text",
      "ar": "حَوِّلْ حَاَلَنَا اِلٰي اَحْسَنِ الْحَالِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُقَلِّبَ الْقُلُوْبِ وَالْاَبْصَارِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُدَبِّرَ الْلَيْلِ وَالنَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحَوِّلَ...  الي آخر"
    }
  ]
}