{
  "id": "munajat-safar",
  "title": "مناجات سفر",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مناجات سفر",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أُرِيْدُ سَفَرًا فَخِرْ لِيْ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْضِحْ لِيْ فِيْهِ سَبِيْلَ الرَّأْيِ وَفَهِّمْنِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَافْتَحْ لِيْ عَزْمِيْ بِالْاِسْتِقَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاشْمُلْنِيْ فِيْ سَفَرِيْ بِالسَّلَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَفِدْنِيْ جَزِيْلَ الْحَظِّ وَالْكَرَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاكْلَاْنِيْ بِحُسْنِ الْحِفْظِ الْحِرَاسَةِ"
    },
    {
      "kind": "text",
      "ar": "وَجَنِّبْنِيْ اَللّٰهُمَّ وَعْثَاءَ الْاَسْفَارِ"
    },
    {
      "kind": "text",
      "ar": "وَسَهِّلْ لِيْ حُزُوْنَةَ الْاَوْعَارِ"
    },
    {
      "kind": "text",
      "ar": "وَاطْوِ لِيْ بِسَاطَ الْمَرَاحِلِ"
    },
    {
      "kind": "text",
      "ar": "وَقَرِّبْ مِنِّيْ بُعْدَ نَأْيِ الْمَنَاهِلِ"
    },
    {
      "kind": "text",
      "ar": "وَبَاعِدْ فِي الْمَسِيْرِ بَيْنَ خُطَي الرَّوَاحِلِ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تُقَرِّبَ نِيَاطَ الْبَعِيْدِ"
    },
    {
      "kind": "text",
      "ar": "وَتُسَهِّلَ وُعُوْرَ الشَّدِيْدِ"
    },
    {
      "kind": "text",
      "ar": "وَلَقِّنِيْ اَللّٰهُمَّ فِيْ سَفَرِيْ نُجْحَ طَائِرِ الْوَاقِيَةِ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْنِيْ فِيْهِ غُنْمَ الْعَافِيَةِ"
    },
    {
      "kind": "text",
      "ar": "وَخَفِيْرَ الْاِسْتِقْلَالِ وَدَلِيْلَ مُجَاوَزَةِ الْاَهْوَالِ"
    },
    {
      "kind": "text",
      "ar": "وَبَاعِثَ وُفُوْرِ الْكِفَايَةِ وَسَانِحَ خَفِيْرِ الْوِلَايَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ اَللّٰهُمَّ سَبَبَ عَظِيْمِ السِّلْمِ حَاصِلَ الْغُنْمِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلِ اللَّيْلَ عَلَيَّ سِتْرًا مِنَ الْاٰفَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّهَارَ مَانِعًا مِنَ الْهَلَكَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْطَعْ عَنِّيْ قِطَعَ لُصُوْصِهٖ بِقُدْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْرُسْنِيْ مِنْ وُحُوْشِهٖ بِقُوَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تَكُوْنَ السَّلَامَةُ فِيْهِ مُصَاحِبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَافِيَةُ فِيْهِ مُقَارِنَتِيْ وَالْيُمْنُ سَائِقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْيُسْرُ مُعَانِقِيْ وَالْعُسْرُ مُفَارِقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَوْزُ مُوَافِقِيْ وَالْاَمْنُ مُرَافِقِيْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ ذُوالطَّوْلِ وَالْمَنِّ وَالْقُوَّةِ وَالْحَوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ وَبِعِبَادِكَ بَصِيْرٌ خَبِيْرٌ"
    }
  ]
}