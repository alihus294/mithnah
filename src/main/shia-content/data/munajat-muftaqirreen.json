{
  "id": "munajat-muftaqirreen",
  "title": "۱۱۔ مناجات مفتقرين",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۱۱۔ مناجات مفتقرين",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ كَسْرِيْ لَا يَجْبُرُهٗ اِلَّا لُطْفُكَ وَحَنَانُكَ"
    },
    {
      "kind": "text",
      "ar": "وَفَقْرِيْ لَا يُغْنِيْهِ اِلَّا عَطْفُكَ وَاِحْسَانُكَ"
    },
    {
      "kind": "text",
      "ar": "وَرَوْعَتِيْ لَا يُسَكِّنُهَا اِلَّا أَمَانُكَ"
    },
    {
      "kind": "text",
      "ar": "وَذِلَّتِيْ لَا يُعِزُّهَا اِلَّا سُلْطَانُكَ"
    },
    {
      "kind": "text",
      "ar": "وَأُمْنِيَّتِيْ لَا يُبَلِّغُنِيْهَا اِلَّا فَضْلُكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَلَّتِيْ لَا يَسُدُّهَا اِلَّا طَوْلُكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَاجَتِيْ لَا يَقْضِيْهَا غَيْرُكَ"
    },
    {
      "kind": "text",
      "ar": "وَكَرْبِيْ لَا يُفَرِّجُهٗ سِوٰي رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَضُرِّيْ لَا يَكْشِفُهٗ غَيْرُ رَأْفَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَغُلَّتِيْ لَا يُبَرِّدُهَا اِلَّا وَصْلُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَوْعَتِيْ لَا يُطْفِيْهَا اِلَّا لِقَاؤُكَ"
    },
    {
      "kind": "text",
      "ar": "وَشَوْقِيْ اِلَيْكَ لَا يَبُلُّهٗ اِلَّا النَّظَرُ اِلٰي وَجْهِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَرَارِيْ لَا يَقِرُّ دُوْنَ دُنُوِّيْ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَهْفَتِيْ لَا يَرُدُّهَا اِلَّا رَوْحُكَ"
    },
    {
      "kind": "text",
      "ar": "وَسُقْمِيْ لَا يَشْفِيْهِ اِلَّا طِبُّكَ"
    },
    {
      "kind": "text",
      "ar": "وَغَمِّيْ لَا يُزِيْلُهٗ اِلَّا قُرْبُكَ"
    },
    {
      "kind": "text",
      "ar": "وَجُرْحِيْ لَا يُبْرِئُهٗ اِلَّا صَفْحُكَ"
    },
    {
      "kind": "text",
      "ar": "وَرَيْنُ قَلْبِيْ لَا يَجْلُوْهُ اِلَّا عَفْوُكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَسْوَاسُ صَدْرِيْ لَا يُزِيْحُهٗ اِلَّا أَمْرُكَ"
    },
    {
      "kind": "text",
      "ar": "فَيَا مُنْتَهٰي أَمَلِ الْاٰمِلِيْنَ، وَيَا غَايَةَ سُؤْلِ السَّائِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَا أَقْصٰي طَلِبَةِ الطَّالِبِيْنَ، وَيَا أَعْلٰي رَغْبَةِ الرَّاغِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَا وَلِيَّ الصَّالِحِيْنَ، وَيَا أَمَانَ الْخَائِفِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مُجِيْبَ دَعْوَةِ الْمُضْطَرِّيْنَ، وَيَا ذُخْرَ الْمُعْدِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَا كَنْزَ الْبَائِسِيْنَ، وَيَا غِيَاثَ الْمُسْتَغِيْثِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَا قَاضِيَ حَوَائِجِ الْفُقَرَاءِ وَالْمَسَاكِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَيَا أَكْرَمَ الْاَكْرَمِيْنَ، وَيَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "لَكَ تَخَضُّعِيْ وَسُؤَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ تَضَرُّعِيْ وَابْتِهَالِيْ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُنِيْلَنِيْ مِنْ رَوْحِ رِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتُدِيْمَ عَلَيَّ نِعَمَ امْتِنَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَهَا أَنَا بِبَابِ كَرَمِكَ وَاقِفٌ، وَلِنَفَحَاتِ بِرِّكَ مُتَعَرِّضٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَبْلِكَ الشَّدِيْدِ مُعْتَصِمٌ، وَبِعُرْوَتِكَ الْوُثْقٰي مُتَمَسِّكٌ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ ارْحَمْ عَبْدَكَ الذَّلِيْلَ ذَا اللِّسَانِ الْكَلِيْلِ وَالْعَمَلِ الْقَلِيْلِ"
    },
    {
      "kind": "text",
      "ar": "وَامْنُنْ عَلَيْهِ بِطَوْ لِكَ الْجَزِيْلِ"
    },
    {
      "kind": "text",
      "ar": "وَاكْنُفْهُ تَحْتَ ظِلِّكَ الظَّلِيْلِ"
    },
    {
      "kind": "text",
      "ar": "يَا كَرِيْمُ يَا جَمِيْلُ، يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}