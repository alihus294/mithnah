{
  "id": "yawm-ithnayn",
  "title": "دُعاءُ يَوْمِ الاثْنَيْن",
  "subtitle": "من أدعية الأيام السبعة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "دُعاءُ يَوْمِ الاثْنَيْن", "subtitle": "من أدعية الأيام السبعة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "الحَمْدُ للهِ الَّذِي لَمْ يُشْهِدْ أَحَداً" },
    { "kind": "text", "ar": "حِينَ فَطَرَ السَّماواتِ وَالأَرْضَ" },
    { "kind": "text", "ar": "وَلا اتَّخَذَ مُعِيناً حِينَ بَرَأَ النَّسَماتِ" },
    { "kind": "text", "ar": "لَمْ يُشارَكْ فِي الإِلهِيَّةِ" },
    { "kind": "text", "ar": "وَلَمْ يُظاهَرْ فِي الوَحْدانِيَّةِ" },
    { "kind": "text", "ar": "كَلَّتِ الأَلْسُنُ عَنْ غايَةِ صِفَتِهِ" },
    { "kind": "text", "ar": "وَالعُقُولُ عَنْ كُنْهِ مَعْرِفَتِهِ" },
    { "kind": "text", "ar": "وَتَواضَعَتِ الجَبابِرَةُ لِهَيْبَتِهِ" },
    { "kind": "text", "ar": "وَعَنَتِ الوُجُوهُ لِخَشْيَتِهِ" },
    { "kind": "text", "ar": "وَانْقادَ كُلُّ عَظِيمٍ لِعَظَمَتِهِ" },
    { "kind": "text", "ar": "فَلَكَ الحَمْدُ مُتَواتِراً مُتَّسِقاً" },
    { "kind": "text", "ar": "ومُتَوالِياً مُسْتَوْسِقاً" },
    { "kind": "text", "ar": "وَصَلَواتُهُ عَلَىٰ رَسُولِهِ أَبَداً" },
    { "kind": "text", "ar": "وَسَلامُهُ دائِماً سَرْمَداً" },
    { "kind": "text", "ar": "اللَّهُمَّ اجْعَلْ أَوَّلَ يَوْمِي هذا صَلاحاً" },
    { "kind": "text", "ar": "وَأَوْسَطَهُ فَلاحاً، وَآخِرَهُ نَجاحاً" },
    { "kind": "text", "ar": "وَأَعُوذُ بِكَ مِنْ يَوْمٍ أَوَّلَهُ فَزَعٌ" },
    { "kind": "text", "ar": "وَأَوْسَطُهُ جَزَعٌ، وَآخِرُهُ وَجَعٌ" },
    { "kind": "text", "ar": "اللَّهُمَّ إِنِّي أَسْتَغْفِرُكَ لِكُلِّ نَذْرٍ نَذَرْتُهُ" },
    { "kind": "text", "ar": "وَكُلِّ وَعْدٍ وَعَدْتُهُ" },
    { "kind": "text", "ar": "وَكُلِّ عَهْدٍ عاهَدْتُهُ ثُمَّ لَمْ أَفِ بِهِ" },
    { "kind": "text", "ar": "وَأَسأَلُكَ فِي مَظالِمِ عِبادِكَ عِنْدِي" },
    { "kind": "text", "ar": "فَأَيُّما عَبْدٍ مِنْ عَبِيدِكَ" },
    { "kind": "text", "ar": "أَو أَمَةٍ مِنْ إِمائِكَ كانَتْ لَهُ قِبَلِي مَظْلَمَةٌ" },
    { "kind": "text", "ar": "ظَلَمْتُها إِيَّاهُ، فِي نَفْسِهِ أَوْ فِي عِرْضِهِ" },
    { "kind": "text", "ar": "أَوْ فِي مالِهِ أَوْ فِي أَهْلِهِ وَوَلَدِهِ" },
    { "kind": "text", "ar": "أَوْ غيْبَةٌ اغْتَبْتُهُ بِها" },
    { "kind": "text", "ar": "أَوْ تَحامُلٌ عَلَيْهِ بِمَيْلٍ أَوْ هَوَىً" },
    { "kind": "text", "ar": "أَوْ أَنَفَةٍ أَوْ حَمِيَّةٍ" },
    { "kind": "text", "ar": "أَوْ رِياءٍ أَوْ عَصَبِيَّةٍ" },
    { "kind": "text", "ar": "غائِباً كانَ أَوْ شاهِداً، وَحَيّاً كانَ أَوْ مَيِّتاً" },
    { "kind": "text", "ar": "فَقَصُرَتْ يَدِي، وَضاقَ وُسْعِي عَنْ رَدِّها إِلَيْهِ" },
    { "kind": "text", "ar": "والتَحَلُّلِ مِنْهُ" },
    { "kind": "text", "ar": "فَأَسْأَلُكَ يا مَنْ يَمْلِكُ الحاجاتِ" },
    { "kind": "text", "ar": "وَهِي مُسْتَجِيبَةٌ لِمَشِيئَتِهِ" },
    { "kind": "text", "ar": "وَمُسْرِعَةٌ إِلَىٰ إِرادَتِهِ" },
    { "kind": "text", "ar": "أَنْ تُصَلِّيَّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ" },
    { "kind": "text", "ar": "وَأَنْ تُرْضِيَهُ عَنِّي بِما شِئْتَ" },
    { "kind": "text", "ar": "وَتَهَبَ لِي مِنْ عِنْدِكَ رَحْمَةً" },
    { "kind": "text", "ar": "إِنَّهُ لا تَنْقُصُكَ المَغْفِرَةُ" },
    { "kind": "text", "ar": "ولا تَضُرُّكَ المَوْهِبَةُ" },
    { "kind": "text", "ar": "يا أَرْحَمَ الرَّاحِمِينَ" },
    { "kind": "text", "ar": "اللَّهُمَّ أَوْلِنِي فِي كُلِّ يَوْمِ اثْنِينِ نِعْمَتَيْنِ مِنْكَ اثنْتَيْنِ" },
    { "kind": "text", "ar": "سَعادَةً فِي أَوَّلِهِ بِطاعَتِكَ" },
    { "kind": "text", "ar": "وَنِعْمَةً فِي آخِرِهِ بِمَغْفِرَتِكَ" },
    { "kind": "text", "ar": "يا مَنْ هُوَ الإلهُ، وَلا يَغْفِرُ الذُّنُوبَ سِواهُ" }
  ]
}
