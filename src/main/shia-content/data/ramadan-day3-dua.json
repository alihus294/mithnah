{
  "id": "ramadan-day3-dua",
  "title": "تيسرے دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تيسرے دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنِيْ فِيْهِ الذِّهْنَ وَالتَّنْبِيْهَ"
    },
    {
      "kind": "text",
      "ar": "وَبَاعِدْنِيْ فِيْهِ مِنَ السَّفَاهَةِ وَالتَّمْوِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لِيْ نَصِيْبًا مِنْ كُلِّ خَيْرٍ تُنْزِلُ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "بِجُوْدِكَ يَا أَجْوَدَ الْاَجْوَدِيْن"
    }
  ]
}