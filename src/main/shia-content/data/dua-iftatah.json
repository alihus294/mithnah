{
  "id": "dua-iftatah",
  "title": "دعاء افتتاح",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء افتتاح",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَفْتَتِحُ الثَّنَاءَ بِحَمْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ مُسَدِّدٌ لِلصَّوَابِ بِمَنِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَيْقَنْتُ أَنَّكَ أَنْتَ أَرْحَمُ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ مَوْضِعِ الْعَفْوِ وَالرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشَدُّ الْمُعَاقِبِيْنَ فِيْ مَوْضِعِ النَّكَالِ وَالنَّقِمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْظَمُ الْمُتَجَبِّرِيْنَ فِيْ مَوْضِعِ الْكِبْرِيَاءِ وَالْعَظَمَةِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَذِنْتَ لِيْ فِيْ دُعَائِكَ وَمَسْأَلَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاسْمَعْ يَا سَمِيْعُ مِدْحَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَجِبْ يَا رَحِيْمُ دَعْوَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَقِلْ يَا غَفُوْرُ عَثْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَكَمْ يَا اِلٰهِيْ مِنْ كُرْبَةٍ قَدْ فَرَّجْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَهُمُوْمٍ قَدْ كَشَفْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَعَثْرَةٍ قَدْ أَقَلْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةٍ قَدْ نَشَرْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَحَلْقَةِ بَلَاءٍ قَدْ فَكَكْتَهَا"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَمْ يَتَّخِذْ صَاحِبَةً وَلَا وَلَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ شَرِيْكٌ فِي الْمُلْكِ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَكُنْ لَهٗ وَلِيٌّ مِنَ الذُّلِّ"
    },
    {
      "kind": "text",
      "ar": "وَكَبِّرْهُ تَكْبِيْرًا"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ بِجَمِيْعِ مَحَامِدِهٖ كُلِّهَا"
    },
    {
      "kind": "text",
      "ar": "عَلٰي جَمِيْعِ نِعَمِهٖ كُلِّهَا"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَا مُضَادَّ لَهٗ فِيْ مُلْكِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُنَازِعَ لَهٗ فِيْ أَمْرِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَا شَرِيْكَ لَهٗ فِيْ خَلْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا شَبِيْهَ لَهٗ فِيْ عَظَمَتِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الْفَاشِيْ فِي الْخَلْقِ أَمْرُهٗ وَحَمْدُهٗ"
    },
    {
      "kind": "text",
      "ar": "الظَّاهِرِ بِالْكَرَمِ مَجْدُهٗ"
    },
    {
      "kind": "text",
      "ar": "الْبَاسِطِ بِالْجُوْدِ يَدَهٗ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَا تَنْقُصُ خَزَائِنُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَزِيْدُهٗ كَثْرَةُ الْعَطَاءِ اِلَّا جُوْدًا وَكَرَمًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ هُوَ الْعَزِيْزُ الْوَهَّابُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ قَلِيْلًا مِنْ كَثِيْرٍ"
    },
    {
      "kind": "text",
      "ar": "مَعَ حَاجَةٍ بِيْ اِلَيْهِ عَظِيْمَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَغِنَاكَ عَنْهُ قَدِيْمٌ، وَهُوَ عِنْدِيْ كَثِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَلَيْكَ سَهْلٌ يَسِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ عَفْوَكَ عَنْ ذَنْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَجَاوُزَكَ عَنْ خَطِيْئَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَصَفْحَكَ عَنْ ظُلْمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَسَتْرَكَ عَلٰي قَبِيْحِ عَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَحِلْمَكَ عَنْ كَثِيْرِ جُرْمِيْ"
    },
    {
      "kind": "text",
      "ar": "عِنْدَ مَا كَانَ مِنْ خَطَاِيْ وَعَمْدِيْ"
    },
    {
      "kind": "text",
      "ar": "أَطْمَعَنِيْ فِيْ أَنْ أَسْأَلَكَ مَا لَا أَسْتَوْجِبُهٗ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ رَزَقْتَنِيْ مِنْ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرَيْتَنِيْ مِنْ قُدْرَتِكَ، وَعَرَّفْتَنِيْ مِنْ اِجَابَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَصِرْتُ أَدْعُوْكَ اٰمِنًا"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُكَ مُسْتَأْنِسًا لَا خَائِفًا وَلَا وَجِلًا"
    },
    {
      "kind": "text",
      "ar": "مُدِلًّا عَلَيْكَ فِيْمَا قَصَدْتُ فِيْهِ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ أَبْطَأَ عَنِّيْ عَتَبْتُ بِجَهْلِيْ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَلَّ الَّذِيْ أَبْطَأَ عَنِّيْ هُوَ خَيْرٌ لِيْ"
    },
    {
      "kind": "text",
      "ar": "لِعِلْمِكَ بِعَاقِبَةِ الْاُمُوْرِ"
    },
    {
      "kind": "text",
      "ar": "فَلَمْ أَرَ مَوْلًى كَرِيْمًا"
    },
    {
      "kind": "text",
      "ar": "أَصْبَرَ عَلٰي عَبْدٍ لَئِيْمٍ مِنْكَ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبِّ، اِنَّكَ تَدْعُوْنِيْ فَأُوَلِّيْ عَنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَتَحَبَّبُ اِلَيَّ فأَتَبَغَّضُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَتَوَدَّدُ اِلَيَّ فَلَا أَقْبَلُ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "كَأَنَّ لِيَ التَّطَوُّلَ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَمْ يَمْنَعْكَ ذٰلِكَ مِنَ الرَّحْمَةِ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِحْسَانِ اِلَيَّ، وَالتَّفَضُّلِ عَلَيَّ بِجُوْدِكَ وَكَرَمِكَ"
    },
    {
      "kind": "text",
      "ar": "فَارْحَمْ عَبْدَكَ الْجَاهِلَ"
    },
    {
      "kind": "text",
      "ar": "وَجُدْ عَلَيْهِ بِفَضْلِ اِحْسَانِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ جَوَادٌ كَرِيْمٌ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ مَالِكِ الْمُلْكِ، مُجْرِي الْفُلْكِ"
    },
    {
      "kind": "text",
      "ar": "مُسَخِّرِ الرِّيَاحِ، فَالِقِ الْاِصْبَاحِ"
    },
    {
      "kind": "text",
      "ar": "دَيَّانِ الدِّيْنِ، رَبِّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ عَلٰي حِلْمِهٖ بَعْدَ عِلْمِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ عَلٰي عَفْوِهٖ بَعْدَ قُدْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ عَلٰي طُوْلِ أَنَاتِهٖ فِيْ غَضَبِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ قَادِرٌ عَلٰي مَا يُرِيْدُ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ خَالِقِ الْخَلْقِ"
    },
    {
      "kind": "text",
      "ar": "بَاسِطِ الرِّزْقِ، فَالِقِ الْاِصْبَاحِ"
    },
    {
      "kind": "text",
      "ar": "ذِي الْجَلَالِ وَالْاِكْرَامِ وَالْفَضْلِ وَالْاِنْعَامِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ بَعُدَ فَلَا يُرٰي"
    },
    {
      "kind": "text",
      "ar": "وَقَرُبَ فَشَهِدَ النَّجْوٰي"
    },
    {
      "kind": "text",
      "ar": "تَبَارَكَ وَتَعَالٰي"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَيْسَ لَهٗ مُنَازِعٌ يُعَادِلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا شَبِيْهٌ يُشَاكِلُهٗ، وَلَا ظَهِيْرٌ يُعَاضِدُهٗ"
    },
    {
      "kind": "text",
      "ar": "قَهَرَ بِعِزَّتِهِ الْاَعِزَّاءَ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَاضَعَ لِعَظَمَتِهِ الْعُظَمَاءُ"
    },
    {
      "kind": "text",
      "ar": "فَبَلَغَ بِقُدْرَتِهٖ مَا يَشَاءُ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ يُجِيْبُنِيْ حِيْنَ أُنَادِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَيَسْتُرُ عَلَيَّ كُلَّ عَوْرَةٍ وَأَنَا أَعْصِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَيُعَظِّمُ النِّعْمَةَ عَلَيَّ فَلَا أُجَازِيْهِ"
    },
    {
      "kind": "text",
      "ar": "فَكَمْ مِنْ مَوْهِبَةٍ هَنِيْئَةٍ قَدْ أَعْطَانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَظِيْمَةٍ مَخُوْفَةٍ قَدْ كَفَانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَبَهْجَةٍ مُوْنِقَةٍ قَدْ أَرَانِيْ"
    },
    {
      "kind": "text",
      "ar": "فَأُثْنِيْ عَلَيْهِ حَامِدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَذْكُرُهٗ مُسَبِّحًا۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَا يُهْتَكُ حِجَابُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُغْلَقُ بَابُهٗ، وَلَا يُرَدُّ سَائِلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُخَيَّبُ اٰمِلُهٗ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ يُؤْمِنُ الْخَائِفِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيُنَجِّي الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَرْفَعُ الْمُسْتَضْعَفِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَضَعُ الْمُسْتَكْبِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيُهْلِكُ مُلُوْكًا وَيَسْتَخْلِفُ اٰخَرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ قَاصِمِ الْجَبَّارِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مُبِيْرِ الظَّالِمِيْنَ، مُدْرِكِ الْهَارِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "نَكَالِ الظَّالِمِيْنَ، صَرِيْخِ الْمُسْتَصْرِخِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مَوْضِعِ حَاجَاتِ الطَّالِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مُعْتَمَدِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ مِنْ خَشْيَتِهٖ تَرْعَدُ السَّمَاءُ وَسُكَّانُهَا"
    },
    {
      "kind": "text",
      "ar": "وَتَرْجُفُ الْاَرْضُ وَعُمَّارُهَا"
    },
    {
      "kind": "text",
      "ar": "وَتَمُوْجُ الْبِحَارُ وَمَنْ يَسْبَحُ فِيْ غَمَرَاتِهَا"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ هَدَانَا لِهٰذَا"
    },
    {
      "kind": "text",
      "ar": "وَمَا كُنَّا لِنَهْتَدِيَ لَوْ لَا أَنْ هَدَانَا اللهُ۔"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ يَخْلُقُ وَلَمْ يُخْلَقْ"
    },
    {
      "kind": "text",
      "ar": "وَيَرْزُقُ وَلَا يُرْزَقُ"
    },
    {
      "kind": "text",
      "ar": "وَيُطْعِمُ وَلَا يُطْعَمُ"
    },
    {
      "kind": "text",
      "ar": "وَيُمِيْتُ الْاَحْيَاءَ وَيُحْيِي الْمَوْتٰي"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ حَيٌّ لَا يَمُوْتُ، بِيَدِهِ الْخَيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ عَبْدِكَ وَرَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمِيْنِكَ وَصَفِيِّكَ وَحَبِيْبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخِيَرَتِكَ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَافِظِ سِرِّكَ، وَمُبَلِّغِ رِسَالَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "أَفْضَلَ وَأَحْسَنَ وَأَجْمَلَ وَأَكْمَلَ"
    },
    {
      "kind": "text",
      "ar": "وَأَزْكٰي وَأَنْمٰي وَأَطْيَبَ وَأَطْهَرَ وَأَسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَكْثَرَ مَا صَلَّيْتَ وَبَارَكْتَ وَتَرَحَّمْتَ وَتَحَنَّنْتَ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَّمْتَ عَلٰي أَحَدٍ مِنْ عِبَادِكَ وَأَنْبِيَائِكَ وَرُسُلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَصِفْوَتِكَ وَأَهْلِ الْكَرَامَةِ عَلَيْكَ مِنْ خَلْقِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَصَلِّ عَلٰي عَلِيٍّ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَوَصِيِّ رَسُوْلِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَبْدِكَ وَوَلِيِّكَ وَأَخِيْ رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحُجَّتِكَ عَلٰي خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاٰيَتِكَ الْكُبْرٰي، وَالنَّبَاِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلَي الصِّدِّيْقَةِ الطَّاهِرَةِ فَاطِمَةَ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدَةِ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي سِبْطَيِ الرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاِمَامَيِ الْهُدٰي الْحَسَنِ وَالْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدَيْ شَبَابِ أَهْلِ الْجَنَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي أَئِمَّةِ الْمُسْلِمِيْنِ"
    },
    {
      "kind": "text",
      "ar": "عَلِيِّ بْنِ الْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَمُحَمَّدِ بْنِ عَلِيٍّ، وَجَعْفَرِ بْنِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَمُوْسَي بْنِ جَعْفَرٍ، وَعَلِيِّ بْنِ مُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "وَمُحَمَّدِ بْنِ عَلِيٍّ، وَعَلِيِّ بْنِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنِ بْنِ عَلِيٍّ، وَالْخَلَفِ الْهَادِي الْمَهْدِيِّ"
    },
    {
      "kind": "text",
      "ar": "حُجَجِكَ عَلٰي عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأُمَنَائِكَ فِيْ بِلَادِكَ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً كَثِيْرَةً دَائِمَةً۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَصَلِّ عَلٰي وَليِّ أَمْرِكَ الْقَائِمِ"
    },
    {
      "kind": "text",
      "ar": "الْمُؤَمَّلِ، وَالْعَدْلِ الْمُنْتَظَرِ"
    },
    {
      "kind": "text",
      "ar": "وَحُفَّهٗ بِمَلَائِكَتِكَ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَيِّدْهُ بِرُوْحِ الْقُدُسِ يَا رَبَّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْهُ الدَّاعِيَ اِلٰي كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْقَائِمَ بِدِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "اسْتَخْلِفْهُ فِي الْاَرْضِ كَمَا اسْتَخْلَفْتَ الَّذِيْنَ مِنْ قَبْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "مَكِّنْ لَهٗ دِيْنَهُ الَّذِي ارْتَضَيْتَهٗ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَبْدِلْهُ مِنْ بَعْدِ خَوْفِهٖ أَمْنًا"
    },
    {
      "kind": "text",
      "ar": "يَعْبُدُكَ لَا يُشْرِكُ بِكَ شَيْئًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعِزَّهٗ وَأَعْزِزْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْهُ وَانْتَصِرْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْهُ نَصْرًا عَزِيْزًا"
    },
    {
      "kind": "text",
      "ar": "وَافْتَحْ لَهٗ فَتْحًا يَسِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لَهٗ مِنْ لَدُنْكَ سُلْطَانًا نَصِيْرًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَظْهِرْ بِهٖ دِيْنَكَ وَسُنَّةَ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا يَسْتَخْفِيَ بِشَيْءٍ مِنَ الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "مَخَافَةَ أَحَدٍ مِنَ الْخَلْقِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نَرْغَبُ اِلَيْكَ فِيْ دَوْلَةٍ كَرِيْمَةٍ"
    },
    {
      "kind": "text",
      "ar": "تُعِزُّ بِهَا الْاِسْلَامَ وَأَهْلَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَتُذِلُّ بِهَا النِّفَاقَ وَأَهْلَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلُنَا فِيْهَا مِنَ الدُّعَاةِ اِلٰي طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْقَادَةِ اِلٰي سَبِيْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَرْزُقُنَا بِهَا كَرَامَةَ الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَا عَرَّفْتَنَا مِنَ الْحَقِّ فَحَمِّلْنَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَمَا قَصُرْنَا عَنْهُ فَبَلِّغْنَاهُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ الْمُمْ بِهٖ شَعَثَنَا"
    },
    {
      "kind": "text",
      "ar": "وَاشْعَبْ بِهٖ صَدْعَنَا"
    },
    {
      "kind": "text",
      "ar": "وَارْتُقْ بِهٖ فَتْقَنَا"
    },
    {
      "kind": "text",
      "ar": "وَكَثِّرْ بِهٖ قِلَّتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَعْزِزْ بِهٖ ذِلَّتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَغْنِ بِهٖ عَائِلَنَا"
    },
    {
      "kind": "text",
      "ar": "وَاقْضِ بِهٖ عَنْ مُغْرَمِنَا"
    },
    {
      "kind": "text",
      "ar": "وَاجْبُرْ بِهٖ فَقْرَنَا"
    },
    {
      "kind": "text",
      "ar": "وَسُدَّ بِهٖ خَلَّتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَيَسِّرْ بِهٖ عُسْرَنَا"
    },
    {
      "kind": "text",
      "ar": "وَبَيِّضْ بِهٖ وُجُوْهَنَا"
    },
    {
      "kind": "text",
      "ar": "وَفُكَّ بِهٖ أَسْرَنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْجِحْ بِهٖ طَلِبَتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْجِزْ بِهٖ مَوَاعِيْدَنَا"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَجِبْ بِهٖ دَعْوَتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنَا بِهٖ سُؤْلَنَا"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْنَا بِهٖ مِنَ الدُّنْيَا وَالْاٰخِرَةِ اٰمَالَنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنَا بِهٖ فَوْقَ رَغْبَتِنَا"
    },
    {
      "kind": "text",
      "ar": "يَا خَيْرَ الْمَسْؤُوْلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْسَعَ الْمُعْطِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اشْفِ بِهٖ صُدُوْرَنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَذْهِبْ بِهٖ غَيْظَ قُلُوْبِنَا"
    },
    {
      "kind": "text",
      "ar": "وَاهْدِنَا بِهٖ لِمَا اخْتُلِفَ فِيْهِ مِنَ الْحَقِّ بِاِذْنِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ تَهْدِيْ مَنْ تَشَاءُ اِلٰي صِرَاطٍ مُسْتَقِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْنَا بِهٖ عَلٰي عَدُوِّكَ وَعَدُوِّنَا"
    },
    {
      "kind": "text",
      "ar": "اِلٰهَ الْحَقِّ اٰمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نَشْكُوْ اِلَيْكَ فَقْدَ نَبِيِّنَا صَلَوَاتُكَ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَغَيْبَةَ وَلِيِّنَا، وَكَثْرَةَ عَدُوِّنَا"
    },
    {
      "kind": "text",
      "ar": "وَقِلَّةَ عَدَدِنَا، وَشِدَّةَ الْفِتَنِ بِنَا"
    },
    {
      "kind": "text",
      "ar": "وَتَظَاهُرَ الزَّمَانِ عَلَيْنَا"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ وَأَعِنَّا عَلٰي ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "بِفَتْحٍ مِنْكَ تُعَجِّلُهٗ، وَبِضُرٍّ تَكْشِفُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَنَصْرٍ تُعِزُّهٗ، وَسُلْطَانِ حَقٍّ تُظْهِرُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةٍ مِنْكَ تُجَلِّلُنَاهَا"
    },
    {
      "kind": "text",
      "ar": "وَعَافِيَةٍ مِنْكَ تُلْبِسُنَاهَا"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}