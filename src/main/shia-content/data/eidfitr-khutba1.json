{
  "id": "eidfitr-khutba1",
  "title": "عيد الفطر كا پهلا خطبه",
  "subtitle": "ملحقات مفاتيح الجنان",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "عيد الفطر كا پهلا خطبه",
      "subtitle": "ملحقات مفاتيح الجنان"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ خَلَقَ السَّمٰوَاتِ وَالْاَرْضَ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَ الظُّلُمَاتِ وَالنُّوْرَ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ الَّذِيْنَ كَفَرُوْا بِرَبِّهِمْ يَعْدِلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "لَا نُشْرِكُ بِاللّٰهِ شَيْئًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا نَتَّخِذُ مِنْ دُوْنِهٖ وَلِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ الَّذِيْ لَهٗ مَا فِي السَّمٰوَاتِ وَمَا فِي الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "وَلَهُ الْحَمْدُ فِي الْاٰخِرَةِ وَهُوَ الْحَكِيْمُ الْخَبِيْرُ"
    },
    {
      "kind": "text",
      "ar": "يَعْلَمُ مَا يَلِجُ فِي الْاَرْضِ وَمَا يَخْرُجُ مِنْهَا"
    },
    {
      "kind": "text",
      "ar": "وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ الرَّحِيْمُ الْغَفُوْرُ"
    },
    {
      "kind": "text",
      "ar": "كَذٰلِكَ اللهُ لَا اِلٰهَ اِلَّا هُوَ، اِلَيْهِ الْمَصِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ الَّذِيْ يُمْسِكُ السَّمَاءَ أَنْ تَقَعَ عَلَي الْاَرْضِ اِلَّا بِاِذْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ بِالنَّاسِ لَرَؤُوْفٌ رَحِيْمٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْحَمْنَا بِرَحْمَتِكَ، وَاعْمُمْنَا بِمَغْفِرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الْعَلِيُّ الْكَبِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ الَّذِيْ لَا مَقْنُوْطٌ مِنْ رَحْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مَخْلُوٌّ مِنْ نِعْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُؤْيَسٌ مِنْ رَوْحِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُسْتَنْكَفٌ عَنْ عِبَادَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "بِكَلِمَتِهٖ قَامَتِ السَّمٰوَاتُ السَّبْعُ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَقَرَّتِ الْاَرْضُ الْمِهَادُ"
    },
    {
      "kind": "text",
      "ar": "وَثَبَتَتِ الْجِبَالُ الرَّوَاسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَجَرَتِ الرِّيَاحُ اللَّوَاقِحُ"
    },
    {
      "kind": "text",
      "ar": "وَسَارَ فِيْ جَوِّ السَّمَاءِ السَّحَاب"
    },
    {
      "kind": "text",
      "ar": "ُ وَقَامَتْ عَلٰي حُدُوْدِهَا الْبِحَارُ، وَهُوَ اِلٰهٌ لَهَا"
    },
    {
      "kind": "text",
      "ar": "وَقَاهِرٌ يَذِلُّ لَهُ الْمُتَعَزِّزُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَتَضَائَلُ لَهُ الْمُتَكَبِّرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَدِيْنُ لَهٗ طَوْعًا وَكَرْهًا الْعَالَمُوْنَ"
    },
    {
      "kind": "text",
      "ar": "نَحْمَدُهٗ كَمَا حَمِدَ نَفْسَهٗ وَكَمَا هُوَ أَهْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَنَسْتَعِيْنُهٗ وَنَسْتَغْفِرُهٗ وَنَسْتَهْدِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَنَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ، لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَعْلَمُ مَا تُخْفِي النُّفُوْسُ وَمَا تُجِنُّ الْبِحَارُ"
    },
    {
      "kind": "text",
      "ar": "وَمَا تُوَارٰي مِنْهُ ظُلْمَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَغِيْبُ عَنْهُ غَائِبَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَمَا تَسْقُطُ مِنْ وَرَقَةٍ مِنْ شَجَرَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَبَّةٍ فِيْ ظُلْمَةٍ اِلَّا يَعْلَمُهَا"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا رَطْبٍ وَلَا يَابِسٍ اِلَّا فِيْ كِتَابٍ مُبِيْنٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَعْلَمُ مَا يَعْمَلُ الْعَامِلُوْنَ، وَأَيَّ مَجْرًى يَجْرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِلٰي أَيِّ مُنْقَلَبٍ يَنْقَلِبُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَنَسْتَهْدِيْ اللهَ بِالْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَنَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهٗ وَنَبِيُّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَرَسُوْلُهٗ اِلٰي خَلْقِهٖ، وَأَمِيْنُهٗ عَلٰي وَحْيِهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّهٗ قَدْ بَلَّغَ رِسَالَاتِ رَبِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدَ فِي اللهِ الْحَائِدِيْنَ عَنْهُ الْعَادِلِيْنَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَبَدَ اللهَ حَتّٰي أَتَاهُ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَسَلَّمَ"
    },
    {
      "kind": "text",
      "ar": "أُوْصِيْكُمْ بِتَقْوَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَا تَبْرَحُ مِنْهُ نِعْمَةٌ، وَلَا تَنْفَدُ مِنْهُ رَحْمَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَسْتَغْنِي الْعِبَادُ عَنْهُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَجْزِيْ أَنْعُمَهُ الْاَعْمَالُ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ رَغَّبَ فِي التَّقْوٰي"
    },
    {
      "kind": "text",
      "ar": "وَزَهَّدَ فِي الدُّنْيَا، وَحَذَّرَ الْمَعَاصِيَ"
    },
    {
      "kind": "text",
      "ar": "وَتَعَزَّزَ بِالْبَقَاءِ، وَذَلَّلَ خَلْقَهٗ بِالْمَوْتِ وَالْفَنَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَوْتُ غَايَةُ الْمَخْلُوْقِيْنَ، وَسَبِيْلُ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمَعْقُوْدٌ بِنَوَاصِي الْبَاقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "لَا يُعْجِزُهٗ اِبَاقُ الْهَارِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعِنْدَ حُلُوْلِهٖ يَأْسِرُ أَهْلَ الْهَوٰي"
    },
    {
      "kind": "text",
      "ar": "يَهْدِمُ كُلَّ لَذَّةٍ، وَيُزِيْلُ كُلَّ نِعْمَةٍ، وَيَقْطَعُ كُلَّ بَهْجَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَالدُّنْيَا دَارٌ كَتَبَ اللهُ لَهَا الْفَنَاءَ، وَلِاَهْلِهَا مِنْهَا الْجَلَاءَ"
    },
    {
      "kind": "text",
      "ar": "فَأَكْثَرُهُمْ يَنْوِيْ بَقَائَهَا وَيُعَظِّمُ بِنَائَهَا"
    },
    {
      "kind": "text",
      "ar": "وَهِيَ حُلْوَةٌ خَضِرَةٌ قَدْ عُجِّلَتْ لِلطَّالِبِ"
    },
    {
      "kind": "text",
      "ar": "وَالْتَبَسَتْ بِقَلْبِ النَّاظِرِ"
    },
    {
      "kind": "text",
      "ar": "وَيُضْنِيْ ذُو الثَّرْوَةِ الضَّعِيْفَ"
    },
    {
      "kind": "text",
      "ar": "وَيَحْتَوِيْهَا الْخَائِفُ الْوَجِلُ"
    },
    {
      "kind": "text",
      "ar": "فَارْتَحِلُوْا مِنْهَا، يَرْحَمُكُمُ اللهُ بِأَحْسَنِ مَا بِحَضْرَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَطْلُبُوْا مِنْهَا أَكْثَرَ مِنَ الْقَلِيْلِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَسْأَلُوْا مِنْهَا فَوْقَ الْكَفَافِ"
    },
    {
      "kind": "text",
      "ar": "وَارْضَوْا مِنْهَا بِالْيَسِيْرِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَمُدُّنَّ أَعْيُنَكُمْ مِنْهَا اِلٰي مَا مُتِّعَ الْمُتْرَفُوْنَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَهِيْنُوْا بِهَا وَلَا تُوَطِّنُوْهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَضِرُّوْا بِأَنْفُسِكُمْ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "وَاِيَّاكُمْ وَالتَّنَعُّمَ وَالتَّلَهِّيَ وَالْفَاكِهَاتِ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ فِيْ ذٰلِكَ غَفْلَةً وَاغْتِرَارًا"
    },
    {
      "kind": "text",
      "ar": "أَلَا اِنَّ الدُّنْيَا قَدْ تَنَكَّرَتْ وَأَدْبَرَتْ"
    },
    {
      "kind": "text",
      "ar": "وَاحْلَوْلَتْ وَاٰذَنَتْ بِوَدَاعٍ"
    },
    {
      "kind": "text",
      "ar": "أَلَا وَاِنَّ الْاٰخِرَةَ قَدْ رَحَلَتْ"
    },
    {
      "kind": "text",
      "ar": "فَأَقْبَلَتْ وَأَشْرَفَتْ وَاٰذَنَتْ بِاطِّلَاعٍ"
    },
    {
      "kind": "text",
      "ar": "أَلَا وَاِنَّ الْمِضْمَارَ الْيَوْمَ وَالسِّبَاقَ غَدًا"
    },
    {
      "kind": "text",
      "ar": "أَلَا وَاِنَّ السُّبْقَةَ الْجَنَّةُ وَالْغَايَةَ النَّارُ"
    },
    {
      "kind": "text",
      "ar": "أَلَا أَفَلَا تَائِبٌ مِنْ خَطِيْئَتِهٖ قَبْلَ يَوْمِ مَنِيَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَلَا عَامِلٌ لِنَفْسِهٖ قَبْلَ يَوْمِ بُؤْسِهٖ وَفَقْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "جَعَلَنَا اللهُ وَاِيَّاكُمْ مِمَّنْ يَخَافُهٗ وَيَرْجُوْ ثَوَابَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَلَا اِنَّ هٰذَا الْيَوْمَ يَوْمٌ جَعَلَهُ اللهُ لَكُمْ عِيْدًا"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَكُمْ لَهٗ أَهْلًا"
    },
    {
      "kind": "text",
      "ar": "فَاذْكُرُوا اللهَ يَذْكُرْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَادْعُوْهُ يَسْتَجِبْ لَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَدُّوْا فِطْرَتَكُمْ فَاِنَّهَا سُنَّةُ نَبِيِّكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَفَرِيْضَةٌ وَاجِبَةٌ مِنْ رَبِّكُمْ"
    },
    {
      "kind": "text",
      "ar": "فَلْيُؤَدِّ هِكُلُّ امْرِءٍ مِنْكُمْ عَنْ نَفْسِهٖ وَعَنْ عِيَالِهٖ كُلِّهِمْ"
    },
    {
      "kind": "text",
      "ar": "ذَكَرِهِمْ وَأُنْثَاهُمْ، وَصَغِيْرِهِمْ وَكَبِيْرِهِمْ، وَحُرِّهِمْ وَمَمْلُوْكِهِمْ"
    },
    {
      "kind": "text",
      "ar": "عَنْ كُلِّ اِنْسَانٍ مِنْهُمْ صَاعًا مِنْ بُرٍّ"
    },
    {
      "kind": "text",
      "ar": "أَوْ صَاعًا مِنْ تَمْرٍ أَوْ صَاعًا مِنْ شَعِيْرٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَطِيْعُوا اللهَ فِيْمَا فَرَضَ عَلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرَكُمْ بِهٖ مِنْ اِقَامِ الصَّلَاةِ، وَاِيْتَآءِ الزَّكَاةِ"
    },
    {
      "kind": "text",
      "ar": "وَحِجِّ الْبَيْتِ، وَصَوْمِ شَهْرِ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَمْرِ بِالْمَعْرُوْفِ، وَالنَّهْيِ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِحْسَانِ اِلٰي نِسَائِكُمْ وَمَا مَلَكَتْ أَيْمَانُكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَطِيْعُوا اللهَ فِيْمَا نَهَاكُمْ عَنْهُ مِنْ قَذْفِ الْمُحْصَنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاِتْيَانِ الْفَاحِشَةِ، وَشُرْبِ الْخَمْرِ"
    },
    {
