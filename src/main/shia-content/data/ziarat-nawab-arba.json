{
  "id": "ziarat-nawab-arba",
  "title": "نوابِ اربعه كي زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نوابِ اربعه كي زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "السَّلَامُ عَلَيْكَ يَا فُلَانَ بْنَ فُلَانٍ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ بَابُ الْمَوْلَي"
    },
    {
      "kind": "text",
      "ar": "أَدَّيْتَ عَنْهُ وَأَدَّيْتَ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "مَا خَالَفْتَهٗ وَلَا خَالَفْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "قُمْتَ خَاصًّا، وَانْصَرَفْتَ سَابِقًا"
    },
    {
      "kind": "text",
      "ar": "جِئْتُكَ عَارِفًا بِالْحَقِّ الَّذِيْ أَنْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ مَا خُنْتَ فِي التَّأْدِيَةِ وَالسَّفَارَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ مِنْ بَابٍ مَا أَوْسَعَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ سَفِيْرٍ مَا اٰمَنَكَ، وَمِنْ ثِقَةٍ مَا أَمْكَنَكَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّ اللهَ اخْتَصَّكَ بِنُوْرِهٖ حَتّٰي عَايَنْتَ الشَّخْصَ"
    },
    {
      "kind": "text",
      "ar": "فَأَدَّيْتَ عَنْهُ وَأَدَّيْتَ اِلَيْهِ۔"
    },
    {
      "kind": "text",
      "ar": "جِئْتُكَ مُخْلِصًا بِتَوْحِيْدِ اللهِ، وَمُوَالَاةِ أَوْلِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَرَائَةِ مِنْ أَعْدَائِهٖ وَمِنَ الَّذِيْنَ خَالَفُوْكَ"
    },
    {
      "kind": "text",
      "ar": "يَا حُجَّةَ الْمَوْلٰي وَبِكَ اِلَيْهِمْ تَوَجُّهِيْ"
    },
    {
      "kind": "text",
      "ar": "وَبِهِمْ اِلَي اللهِ تَوَسُّلِيْ۔"
    }
  ]
}