{
  "id": "ziarat-jamia-kabira",
  "title": "زيارت جامعه كبيره",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت جامعه كبيره",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ مُحَمَّدًا صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ عَبْدُهٗ وَرَسُوْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ يَا أَهْلَ بَيْتِ النُّبُوَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَمَوْضِعَ الرِّسَالَةِ، وَمُخْتَلَفَ الْمَلَائِكَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمَهْبِطَ الْوَحْيِ، وَمَعْدِنَ الرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَخُزَّانَ الْعِلْمِ، وَمُنْتَهَي الْحِلْمِ"
    },
    {
      "kind": "text",
      "ar": "وَأُصُوْلَ الْكَرَمِ، وَقَادَةَ الْأُمَمِ، وَأَوْلِيَاءَ النِّعَمِ"
    },
    {
      "kind": "text",
      "ar": "وَعَنَاصِرَ الْاَبْرَارِ، وَدَعَائِمَ الْاَخْيَارِ"
    },
    {
      "kind": "text",
      "ar": "وَسَاسَةَ الْعِبَادِ، وَأَرْكَانَ الْبِلَادِ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْوَابَ الْاِيْمَانِ ، وَأُمَنَاءَ الرَّحْمٰنِ"
    },
    {
      "kind": "text",
      "ar": "وَسُلَالَةَ النَّبِيِّيْنَ، وَصَفْوَةَ الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعِتْرَةَ خِيَرَةِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَئِمَّةِ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَمَصَابِيْحِ الدُّجٰي، وَأَعْلَامِ التُّقٰي"
    },
    {
      "kind": "text",
      "ar": "وَذَوِي النُّهٰي، وَأُولِي الْحِجٰي"
    },
    {
      "kind": "text",
      "ar": "وَكَهْفِ الْوَرٰي، وَوَرَثَةِ الْاَنْبِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَثَلِ الْاَعْلٰي، وَالدَّعْوَةِ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَحُجَجِ اللهِ عَلٰي أَهْلِ الدُّنْيَا وَالْاٰخِرَةِ وَالْاُوْلٰي"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَحَالِّ مَعْرِفَةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَمَسَاكِنِ بَرَكَةِ اللهِ، وَمَعَادِنِ حِكْمَةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَحَفَظَةِ سِرِّ اللهِ، وَحَمَلَةِ كِتَابِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْصِيَاءِ نَبِيِّ اللهِ، وَذُرِّيَّةِ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ، وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الدُّعَاةِ اِلَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَدِلَّاءِ عَلٰي مَرْضَاةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسْتَقِرِّيْنَ فِيْ أَمْرِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّامِّيْنَ فِيْ مَحَبَّةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُخْلِصِيْنَ فِيْ تَوْحِيْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُظْهِرِيْنَ لِاَمْرِ اللهِ وَنَهْيِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعِبَادِهِ الْمُكْرَمِيْنَ الَّذِيْنَ لَا يَسْبِقُوْنَهٗ بِالْقَوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَهُمْ بأَمْرِهٖ يَعْمَلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْاَئِمَّةِ الدُّعَاةِ، وَالْقَادَةِ الْهُدَاةِ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّادَةِ الْوُلَاةِ، وَالذَّادَةِ الْحُمَاةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْلِ الذِّكْرِ، وَأُولِي الْاَمْرِ"
    },
    {
      "kind": "text",
      "ar": "وَبَقِيَّةِ اللهِ وَخِيَرَتِهٖ وَحِزْبِهٖ وَعَيْبَةِ عِلْمِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحُجَّتِهٖ، وَصِرَاطِهٖ وَنُوْرِهٖ، وَبُرْهَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "كَمَا شَهِدَ اللهُ لِنَفْسِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَشَهِدَتْ لَهٗ مَلَائِكَتُهٗ وَأُولُو الْعِلْمِ مِنْ خَلْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا هُوَ الْعَزِيْزُ الْحَكِيْمُ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ الْمُنْتَجَبُ"
    },
    {
      "kind": "text",
      "ar": "وَرَسُوْلُهُ الْمُرْتَضٰي أَرْسَلَهٗ بِالْهُدٰي وَدِيْنِ الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "لِيُظْهِرَهٗ عَلَي الدِّيْنِ كُلِّهٖ، وَلَوْ كَرِهَ الْمُشْرِكوُنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكُمُ الْاَئِمَّةُ الرَّاشِدُوْنَ، الْمَهْدِيُّوْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمَعْصُوْمُوْنَ، الْمُكَرَّمُوْنَ، الْمُقَرَّبُوْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَّقُوْنَ، الصَّادِقُوْنَ، الْمُصْطَفُوْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمُطِيْعُوْنَ لِلّٰهِ، الْقَوَّامُوْنَ بِأَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْعَامِلونَ بِاِرَادَتِهٖ، الْفَائِزُوْنَ بِكَرَامَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اصْطَفَاكُمْ بِعِلْمِهٖ، وَارْتَضَاكُمْ لِغَيْبِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاخْتَارَكُمْ لِسِرِّهٖ، وَاجْتَبَاكُمْ بِقُدْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَعَزَّكُمْ بِهُدَاهُ، وَخَصَّكُمْ بِبُرْهَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَانْتَجَبَكُمْ لِنُوْرِهٖ، وَأَيَّدَكُمْ بِرُوْحِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَرَضِيَكُمْ خُلَفَاءَ فِيْ أَرْضِهٖ، وَحُجَجًا عَلٰي بَرِيَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْصَارًا لِدِيْنِهٖ، وَحَفَظَةً لِسِرِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَخَزَنَةً لِعِلْمِهٖ، وَمُسْتَوْدَعًا لِحِكْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتَرَاجِمَةً لِوَحْيِهٖ، وَأَرْكَانًا لِتَوْحِيْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَشُهَدَاءَ عَلٰي خَلْقِهٖ، وَأَعْلَامًا لِعِبَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمَنَارًا فِيْ بِلَادِهٖ، وَأَدِلَّاءَ عَلٰي صِرَاطِهٖ"
    },
    {
      "kind": "text",
      "ar": "عَصَمَكُمُ اللهُ مِنَ الزَّلَلِ"
    },
    {
      "kind": "text",
      "ar": "وَاٰمَنَكُمْ مِنَ الْفِتَنِ، وَطَهَّرَكُمْ مِنَ الدَّنَسِ"
    },
    {
      "kind": "text",
      "ar": "وَأَذْهَبَ عَنْكُمُ الرِّجْسَ وَطَهَّرَكُمْ تَطْهِيْرًا"
    },
    {
      "kind": "text",
      "ar": "فَعَظَّمْتُمْ جَلَالَهٗ، وَأَكْبَرْتُمْ شَأْنَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَجَّدْتُمْ كَرَمَهٗ، وَأَدَمْتُمْ ذِكْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَوَكَّدْتُمْ مِيْثَاقَهٗ، وَأَحْكَمْتُمْ عَقْدَ طَاعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَنَصَحْتُمْ لَهٗ فِي السِّرِّ وَالْعَلَانِيَةِ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَوْتُمْ اِلٰي سَبِيْلِهٖ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَبَذَلْتُمْ أَنْفُسَكُمْ فِيْ مَرْضَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتُمْ عَلٰي مَا أَصَابَكُمْ فِيْ جَنْبِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَقَمْتُمُ الصَّلَاةَ، وَاٰتَيْتُمُ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتُمْ بِالْمَعْرُوْفِ، وَنَهَيْتُمْ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتُمْ فِي اللهِ حَقَّ جِهَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَعْلَنْتُمْ دَعْوَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَبَيَّنْتُمْ فَرَائِضَهٗ، وَأَقَمْتُمْ حُدُوْدَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَنَشَرْتُمْ شَرَائِعَ أَحْكَامِهٖ، وَسَنَنْتُمْ سُنَّتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَصِرْتُمْ فِيْ ذٰلِكَ مِنْهُ اِلَي الرِّضَا"
    },
    {
      "kind": "text",
      "ar": "وَسَلَّمْتُمْ لَهُ الْقَضَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَصَدَّقْتُمْ مِنْ رُسُلِهٖ مَنْ مَضٰي"
    },
    {
      "kind": "text",
      "ar": "فَالرَّاغِبُ عَنْكُمْ مَارِقٌ، وَاللَّازِمُ لَكُمْ لَاحِقٌ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُقَصِّرُ فِيْ حَقِّكُمْ زَاهِقٌ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَقُّ مَعَكُمْ، وَفِيْكُمْ، وَمِنْكُمْ، وَاِلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتُمْ أَهْلُهٗ وَمَعْدِنُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمِيْرَاثُ النُّبُوَّةِ عِنْدَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاِيَابُ الْخَلْقِ اِلَيْكُمْ وَحِسَابُهُمْ عَلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَفَصْلُ الْخِطَابِ عِنْدَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاٰيَاتُ اللهِ لَدَيْكُمْ، وَعَزَائِمُهٗ فِيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَنُوْرُهٗ وَبُرْهَانُهٗ عِنْدَكُم، وَأَمْرُهٗ اِلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "مَنْ وَالَاكُمْ فَقَدْ وَالَي اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ عَادَاكُمْ فَقَدْ عَادَي اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ أَحَبَّكُمْ فَقَدْ أَحَبَّ اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ أَبْغَضَكُمْ فَقَدْ أَبْغَضَ اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اعْتَصَمَ بِكُمْ فَقَدِ اعْتَصَمَ بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "أَنْتُمُ الصِّرَاطُ الْاَقْوَمُ وَشُهَدَاءُ دَارِ الْفَنَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَشُفَعَاءُ دَارِ الْبَقَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّحْمَةُ الْمَوْصُوْلَةُ وَالْاٰيَةُ الْمَخْزُوْنَةُ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَمَانَةُ الْمَحْفُوْظَةُ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَابُ الْمُبْتَلٰي بِهِ النَّاسُ"
    },
    {
      "kind": "text",
      "ar": "مَنْ أَتَاكُمْ نَجَا، وَمَنْ لَمْ يَأْتِكُمْ هَلَكَ"
    },
    {
      "kind": "text",
      "ar": "اِلَي اللهِ تَدْعُوْنَ، وَعَلَيْهِ تَدُلُّوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِهٖ تُؤْمِنُوْنَ، وَلَهٗ تُسَلِّمُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِأَمْرِهٖ تَعْمَلُوْنَ، وَاِلٰي سَبِيْلِهٖ تُرْشِدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِقَوْلِهٖ تَحْكُمُوْنَ"
    },
    {
      "kind": "text",
      "ar": "سَعَدَ مَنْ وَالَاكُمْ، وَهَلَكَ مَنْ عَادَاكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَخَابَ مَنْ جَحَدَكُمْ، وَضَلَّ مَنْ فَارَقَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَفَازَ مَنْ تَمَسَّكَ بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وأَمِنَ مَنْ لَجَأَ اِلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَسَلِمَ مَنْ صَدَّقَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَهُدِيَ مَنِ اعْتَصَمَ بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مَنِ اتَّبَعَكُمْ فَالْجَنَّةُ مَأْوَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ خَالَفَكُمْ فَالنَّارُ مَثْوَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ جَحَدَكُمْ كَافِرٌ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ حَارَبَكُمْ مُشْرِكٌ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ رَدَّ عَلَيْكُمْ فِيْ أَسْفَلِ دَرَكٍ مِنَ الْجَحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّ هٰذَا سَابِقٌ لَكُمْ فِيْمَا مَضٰي"
    },
    {
      "kind": "text",
      "ar": "وَجَارٍ لَكُمْ فِيْمَا بَقِيَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ أَرْوَاحَكُمْ وَنُوْرَكُمْ وَطِيْنَتَكُمْ وَاحِدَةٌ"
    },
    {
      "kind": "text",
      "ar": "طَابَتْ وَطَهُرَتْ بَعْضُهَا مِنْ بَعْضٍ"
    },
    {
      "kind": "text",
      "ar": "خَلَقَكُمُ اللهُ أَنْوَارًا"
    },
    {
      "kind": "text",
      "ar": "فَجَعَلَكُمْ بِعَرْشِهٖ مُحْدِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي مَنَّ عَلَيْنَا بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "فَجَعَلَكُمْ فِيْ بُيُوْتٍ أَذِنَ اللهُ أَنْ تُرْفَعَ وَيُذْكَرَ فِيْهَا اسْمُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَ صَلَاتَنَا عَلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمَا خَصَّنَا بِهٖ مِنْ وِلَايَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "طِيْبًا لِخَلْقِنَا، وَطَهَارَةً لِاَنْفُسِنَا"
    },
    {
      "kind": "text",
      "ar": "وَتَزْكِيَةً لَنَا، وَكَفَّارَةً لِذُنُوْبِنَا"
    },
    {
      "kind": "text",
      "ar": "فَكُنَّا عِنْدَهٗ مُسَلِّمِيْنَ بِفَضْلِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمَعْرُوْفِيْنَ بِتَصْدِيْقِنَا اِيَّاكُمْ"
    },
    {
      "kind": "text",
      "ar": "فَبَلَغَ اللهُ بِكُمْ أَشْرَفَ مَحَلِّ الْمُكَرَّمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْلٰي مَنَازِلِ المُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْفَعَ دَرَجَاتِ الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "حَيْثُ لَا يَلْحَقُهٗ لَاحِقٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَفُوْقُهٗ فَائِقٌ، وَلَا يَسْبِقُهٗ سَابِقٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَطْمَعُ فِيْ اِدْرَاكِهٖ طَامِعٌ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا يَبْقٰي مَلَكٌ مُقَرَّبٌ وَلَا نَبِيٌّ مُرْسَلٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا صِدِّيْقٌ وَلَا شَهِيْدٌ وَلَا عَالِمٌ وَلَا جَاهِلٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا دَنِيٌّ وَلَا فَاضِلٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُؤْمِنٌ صَالِحٌ وَلَا فَاجِرٌ طَالِحٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا جَبَّارٌ عَنِيْدٌ وَلَا شَيْطَانٌ مَرِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا خَلْقٌ فِيْمَا بَيْنَ ذٰلِكَ شَهِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا عَرَّفَهُمْ جَلَالَةَ أَمْرِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَعِظَمَ خَطَرِكُمْ، وَكِبَرَ شَأْنِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَتَمَامَ نُوْرِكُمْ، وَصِدْقَ مَقَاعِدِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَثَبَاتَ مَقَامِكُمْ، وَشَرَفَ مَحَلِّكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْزِلَتِكُمْ عِنْدَهٗ، وَكرَامَتَكُمْ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَخَاصَّتَكُمْ لَدَيْهِ، وَقُرْبَ مَنْزِلَتِكُمْ مِنْهُ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتُمْ وَأُمِّيْ وَأَهْلِيْ وَمَالِيْ وَأُسْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "أُشْهِدُ اللهَ وَأُشْهِدُكُمْ"
    },
    {
      "kind": "text",
      "ar": "أَنِّيْ مُؤْمِنٌ بِكُمْ وَبِمَا اٰمَنْتُمْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "كَافِرٌ بِعَدُوِّكُمْ وَبِمَا كَفَرْتُمْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَبْصِرٌ بِشَأْنِكُمْ، وَبِضَلَالَةِ مَنْ خَالَفَكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُوَالٍ لَكُمْ وَلِاَوْلِيَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُبْغِضٌ لِاَعْدَائِكُمْ وَمُعَادٍ لَهُمْ"
    },
    {
      "kind": "text",
      "ar": "سِلْمٌ لِمَنْ سَالَمَكُمْ، وَحَرْبٌ لِمَنْ حَارَبَكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُحَقِّقٌ لِمَا حَقَّقْتُمْ، مُبْطِلٌ لِمَا أَبْطَلْتُمْ"
    },
    {
      "kind": "text",
      "ar": "مُطِيْعٌ لَكُمْ عَارِفٌ بِحَقِّكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُقِرٌّ بِفَضْلِكُمْ، مُحْتَمِلٌ لِعِلْمِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُحْتَجِبٌ بِذِمَّتِكُمْ، مُعْتَرِفٌ بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُؤْمِنٌ بِاِيَابِكُمْ، مُصَدِّقٌ بِرَجْعَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُنْتَظِرٌ لِاَمْرِكُمْ، مُرْتَقِبٌ لِدَوْلَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "اٰخِذٌ بِقَوْلِكُمْ، عَامِلٌ بِأَمْرِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَجِيْرٌ بِكُمْ، زَائِرٌ لَكُمْ"
    },
    {
      "kind": "text",
      "ar": "لَائِذٌ عَائِذٌ بِقُبُوْرِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَشْفِعٌ اِلَي اللهِ عَزَّوَجَلَّ بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمُتَقَرِّبٌ بِكُمْ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَمُقَدِّمُكُمْ أَمَامَ طَلِبَتِيْ وَحَوَائِجِيْ وَاِرَادَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فِيْ كُلِّ أَحْوَالِيْ وَأُمُوْرِيْ"
    },
    {
      "kind": "text",
      "ar": "مُؤْمِنٌ بِسِرِّكُمْ وَعَلَانِيَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَشَاهِدِكُمْ، وَغَائِبِكُمْ، وَأَوَّلِكُمْ، وَاٰخِرِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمُفَوِّضٌ فِيْ ذٰلِكَ كُلِّهٖ اِلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمُسَلِّمٌ فِيْهِ مَعَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَقَلْبِيْ لَكُمْ مُسَلِّمٌ، وَرَأْئِيْ لَكُمْ تَبَعٌ"
    },
    {
      "kind": "text",
      "ar": "وَنُصْرَتِيْ لَكُمْ مُعَدَّةٌ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي يُحْيِيَ اللهُ تَعَالٰي دِيْنَهٗ بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَيَرُدَّكُمْ فِيْ أَيَّامِهٖ، وَيُظْهِرَكُمْ لِعَدْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَيُمَكِّنَكُمْ فِيْ أَرْضِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَمَعَكُمْ مَعَكُمْ، لَا مَعَ غَيْرِكُمْ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنْتُ بِكُمْ وَتَوَلَّيْتُ اٰخِرَكُمْ بِمَا تَوَلَّيْتُ بِهٖ أَوَّلَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَبَرِئْتُ اِلَي اللهِ عَزَّوَجَلَّ مِنْ أَعْدَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الْجِبْتِ وَالطَّاغُوْتِ وَالشَّيَاطِيْنِ وَحِزْبِهِمُ"
    },
    {
      "kind": "text",
      "ar": "الظَّالِمِيْنَ لَكُمُ، الْجَاحِدِيْنَ لِحَقِّكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَارِقِيْنَ مِنْ وِلَايَتِكُمْ، وَالْغَاصِبِيْنَ لِاِرْثِكُمُ"
    },
    {
      "kind": "text",
      "ar": "الشَّاكِّيْنَ فِيْكُمُ، الْمُنْحَرِفِيْنَ عَنْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ وَلِيْجَةٍ دُوْنَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَكُلِّ مُطَاعٍ سِوَاكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الْاَئِمَّةِ الَّذِيْنَ يَدْعُوْنَ اِلَي النَّارِ"
    },
    {
      "kind": "text",
      "ar": "فَثَبَّتَنِيَ اللهُ أَبَدًا مَا حَيِيْتُ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي مُوَالَاتِكُمْ، وَمَحَبَّتِكُمْ، وَدِيْنِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَوَفَّقَنِيْ لِطَاعَتِكُمْ، وَرَزَقَنِيْ شَفَاعَتَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَنِيْ مِنْ خِيَارِ مَوَالِيْكُمُ"
    },
    {
      "kind": "text",
      "ar": "التَّابِعِيْنَ لِمَا دَعَوْتُمْ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَنِيْ مِمَّنْ يَقْتَصُّ اٰثَارَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَيَسْلُكُ سَبِيْلَكُمْ، وَيَهْتَدِيْ بِهُدَاكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَيُحْشَرُ فِيْ زُمْرَتِكُمْ، وَيَكِرُّ فِيْ رَجْعَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَيُمَلَّكُ فِيْ دَوْلَتِكُمْ، وَيُشَرَّفُ فِيْ عَافِيَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَيُمَكَّنُ فِيْ أَيَّامِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَتَقِرُّ عَيْنُهٗ غَدًا بِرُؤْيَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتُمْ وَأُمِّيْ وَنَفْسِيْ وَأَهْلِيْ وَمَالِيْ"
    },
    {
      "kind": "text",
      "ar": "مَنْ أَرَادَ اللهَ بَدَأَ بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ وَحَّدَهٗ قَبِلَ عَنْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ قَصَدَهٗ تَوَجَّهَ بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مَوَالِيَّ لَا أُحْصِيْ ثَنَائَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَبْلُغُ مِنَ الْمَدْحِ كُنْهَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ الْوَصْفِ قَدْرَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتُمْ نُوْرُ الْاَخْيَارِ وَهُدَاةُ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَحُجَجُ الْجَبَّارِ"
    },
    {
      "kind": "text",
      "ar": "بِكُمْ فَتَحَ اللهُ وَبِكُمْ يَخْتِمُ"
    },
    {
      "kind": "text",
      "ar": "وَبِكُمْ يُنَزِّلُ الْغَيْثَ"
    },
    {
      "kind": "text",
      "ar": "وَبِكُمْ يُمْسِكُ السَّمَاءَ أَنْ تَقَعَ عَلَي الْاَرْضِ اِلَّا بِاِذْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبِكُمْ يُنَفِّسُ الْهَمَّ، وَيَكْشِفُ الضُّرَّ"
    },
    {
      "kind": "text",
      "ar": "وَعِنْدَكُمْ مَا نَزَلَتْ بِهٖ رُسُلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَهَبَطَتْ بِهٖ مَلَائِكَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "[وَاِلٰي جَدِّكُمْ] بُعِثَ الرُّوْحُ الْاَمِيْنُ"
    },
    {
      "kind": "text",
      "ar": "اٰتَاكُمُ اللهُ مَا لَمْ يُؤْتِ أَحَدًا مِنَ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "طَأْطَأَ كُلُّ شَرِيْفٍ لِشَرَفِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَبَخَعَ كُلُّ مُتَكَبِّرٍ لِطَاعَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَخَضَعَ كُلُّ جَبَّارٍ لِفَضْلِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَذَلَّ كُلُّ شَيْءٍ لَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْرَقَتِ الْاَرْضُ بِنُوْرِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَفَازَ الْفَائِزُوْنَ بِوِلَايَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "بِكُمْ يُسْلَكُ اِلَي الرِّضْوَانِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَنْ جَحَدَ وِلَايَتَكُمْ غَضَبُ الرَّحْمٰنِ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتُمْ وَأُمِّيْ وَنَفْسِيْ، وَأَهْلِيْ، وَمَالِيْ"
    },
    {
      "kind": "text",
      "ar": "ذِكْرُكُمْ فِي الذَّاكِرِيْنَ، وَأَسْمَاؤُكُمْ فِي الْاَسْمَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْسَادُكُمْ فِي الْاَجْسَادِ، وَأَرْوَاحُكُمْ فِي الْاَرْوَاحِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْفُسُكُمْ فِي النُّفُوْسِ، وَاٰثَارُكُمْ فِي الْاٰثَارِ"
    },
    {
      "kind": "text",
      "ar": "وَقُبُوْرُكُمْ فِي الْقُبُوْرِ"
    },
    {
      "kind": "text",
      "ar": "فَمَا أَحْلٰي أَسْمَائَكُمْ، وَأَكْرَمَ أَنْفُسَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْظَمَ شَأْنَكُمْ، وَأَجَلَّ خَطَرَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْفٰي عَهْدَكُمْ، وَأَصْدَقَ وَعْدَكُمْ"
    },
    {
      "kind": "text",
      "ar": "كَلَامُكُمْ نُوْرٌ، وَأَمْرُكُمْ رُشْدٌ"
    },
    {
      "kind": "text",
      "ar": "وَوَصِيَّتُكُمُ التَّقْوٰي، وَفِعْلُكُمُ الْخَيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَعَادَتُكُمُ الْاِحْسَانُ، وَسَجِيَّتُكُمُ الْكَرَمُ"
    },
    {
      "kind": "text",
      "ar": "وَشَأْنُكُمُ الْحَقُّ وَالصِّدْقُ وَالرِّفْقُ"
    },
    {
      "kind": "text",
      "ar": "وَقَوْلُكُمْ حُكْمٌ وَحَتْمٌ"
    },
    {
      "kind": "text",
      "ar": "وَرَأْيُكُمْ عِلْمٌ وَحِلْمٌ وَحَزْمٌ"
    },
    {
      "kind": "text",
      "ar": "اِنْ ذُكِرَ الْخَيْرُ كُنْتُمْ أَوَّلَهٗ وَأَصْلَهٗ وَفَرْعَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَعْدِنَهٗ وَمَأْوَاهُ وَمُنْتَهَاهُ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتُمْ وَأُمِّيْ وَنَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "كَيْفَ أَصِفُ حُسْنَ ثَنَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأُحْصِيْ جَمِيْلَ بَلَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَبِكُمْ أَخْرَجَنَا اللهُ مِنَ الذُّلِّ"
    },
    {
      "kind": "text",
      "ar": "وَفَرَّجَ عَنَّا غَمَرَاتِ الْكُرُوْبِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْقَذَنَا مِنْ شَفَا جُرُفِ الْهَلَكَاتِ وَمِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتُمْ وَأُمِّيْ وَنَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "بِمُوَالَاتِكُمْ عَلَّمَنَا اللهُ مَعَالِمَ دِيْنِنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَصْلَحَ مَا كَانَ فَسَدَ مِنْ دُنْيَانَا"
    },
    {
      "kind": "text",
      "ar": "وَبِمُوَالَاتِكُمْ تَمَّتِ الْكَلِمَةُ"
    },
    {
      "kind": "text",
      "ar": "وَعَظُمَتِ النِّعْمَةُ، وَايْتَلَفَتِ الْفُرْقَةُ"
    },
    {
      "kind": "text",
      "ar": "وَبِمُوَالَاتِكُمْ تُقْبَلُ الطَّاعَةُ الْمُفْتَرَضَةُ"
    },
    {
      "kind": "text",
      "ar": "وَلَكُمُ الْمَوَدَّةُ الْوَاجِبَةُ"
    },
    {
      "kind": "text",
      "ar": "وَالدَّرَجَاتُ الرَّفِيْعَةُ، وَالْمَقَامُ الْمَحْمُوْدُ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَكَانُ الْمَعْلُوْمُ عِنْدَ اللهِ عَزَّ وَجَلَّ"
    },
    {
      "kind": "text",
      "ar": "وَالْجَاهُ الْعَظِيْمُ، وَالشَّأْنُ الْكَبِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَالشَّفَاعَةُ الْمَقْبُوْلَةُ"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا اٰمَنَّا بِمَا أَنْزَلْتَ، وَاتَّبَعْنَا الرَّسُوْلَ"
    },
    {
      "kind": "text",
      "ar": "فَاكْتُبْنَا مَعَ الشَّاهِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا لَا تُزِغْ قُلُوْبَنَا بَعْدَ اِذْ هَدَيْتَنَا"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً، اِنَّكَ أَنْتَ الْوَهَّابُ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ رَبِّنَا، اِنْ كَانَ وَعْدُ رَبِّنَا لَمَفْعُوْلًا۔"
    },
    {
      "kind": "text",
      "ar": "يَا وَلِيَّ اللهِ اِنَّ بَيْنِيْ وَبَيْنَ اللهِ عَزَّوَجَلَّ ذُنُوْبًا"
    },
    {
      "kind": "text",
      "ar": "لَا يَأْتِيْ عَلَيْهَا اِلَّا رِضَاكُمْ"
    },
    {
      "kind": "text",
      "ar": "فَبِحَقِّ مَنِ ائْتَمَنَكُمْ عَلٰي سِرِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَرْعَاكُمْ أَمْرَ خَلْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَقَرَنَ طَاعَتَكُمْ بِطَاعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "لَمَّا اسْتَوْهَبْتُمْ ذُنُوْبِيْ وَكُنْتُمْ شُفَعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ لَكُمْ مُطِيْعٌ"
    },
    {
      "kind": "text",
      "ar": "مَنْ أَطَاعَكُمْ فَقدْ أَطَاعَ اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ عَصَاكُمْ فَقَدْ عَصَي اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ أَحَبَّكُمْ فَقَدْ أَحَبَّ اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ أَبْغَضَكُمْ فَقَدْ أَبْغَضَ اللهَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ لَوْ وَجَدْتُ شُفَعَاءَ أَقْرَبَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ مُحَمَّدٍ وَأَهْلِ بَيْتِهِ الْاَخْيَارِ الْاَئِمَّةِ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "لَجَعَلْتُهُمْ شُفَعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "فَبِحَقِّهِمُ الَّذِيْ أَوْجَبْتَ لَهُم عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُدْخِلَنِيْ"
    },
    {
      "kind": "text",
      "ar": "فِيْ جُمْلَةِ الْعَارِفِيْنَ بِهِمْ وَبِحَقِّهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ زُمْرَةِ الْمَرْحُوْمِيْنَ بِشَفَاعَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَرْحَمُ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِهٖ الطَّاهِرِيْنَ وَسَلَّمَ تَسْلِيْمًا كَثِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَحَسْبُنَا اللهُ وَنِعْمَ الْوَكِيْلُ۔"
    }
  ]
}