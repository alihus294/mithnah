{
  "id": "munajat-7-mutiin",
  "title": "المناجاة السابعة — مناجاة المطيعين",
  "subtitle": "من المناجاة الخمسة عشر للإمام السجاد عليه السلام",
  "source": "مفاتيح الجنان، المناجاة الخمس عشرة",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "مناجاة المطيعين لله", "subtitle": "المناجاة السابعة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "اللَّهُمَّ أَلْهِمْنا طاعَتَكَ، وَجَنِّبْنا مَعْصِيَتَكَ" },
    { "kind": "text", "ar": "وَيَسِّرْ لَنا بُلُوغَ ما نَتَمَنَّىٰ مِنِ ابْتِغاءِ رِضْوانِكَ" },
    { "kind": "text", "ar": "وَأَحْلِلْنا بُحْبُوحَةَ جِنانِكَ" },
    { "kind": "text", "ar": "وَاقْشَعْ عَنْ بَصائِرِنا سَحابَ الاِرْتِيابِ" },
    { "kind": "text", "ar": "وَاكْشِفْ عَنْ قُلُوبِنا أَغْشِيَةَ المِرْيَةِ وَالحِجابِ" },
    { "kind": "text", "ar": "وَأَزْهِقِ الباطِلَ عَنْ ضَمائِرِنا" },
    { "kind": "text", "ar": "وَأَثْبِتِ الحَقَّ فِي سَرائِرِنا" },
    { "kind": "text", "ar": "فَإِنَّ الشُّكُوكَ وَالظُّنُونَ لَواقِحُ الفِتَنِ" },
    { "kind": "text", "ar": "وَمُكَدِّرَةٌ لِصَفْوِ المَنائِحِ وَالمِنَنِ" },
    { "kind": "text", "ar": "اللَّهُمَّ احْمِلْنا فِي سُفُنِ نَجاتِكَ" },
    { "kind": "text", "ar": "وَمَتِّعْنا بِلَذِيذِ مُناجاتِكَ" },
    { "kind": "text", "ar": "وَأَوْرِدْنا حِياضَ حُبِّكَ" },
    { "kind": "text", "ar": "وَأَذِقْنا حَلاوَةَ وُدِّكَ وَقُرْبِكَ" },
    { "kind": "text", "ar": "وَاجْعَلْ جِهادَنا فِيكَ، وَهَمَّنا فِي طاعَتِكَ" },
    { "kind": "text", "ar": "وَأَخْلِصْ نِيَّاتِنا فِي مُعامَلَتِكَ" },
    { "kind": "text", "ar": "فَإِنَّا بِكَ وَلَكَ، وَلا وَسِيلَةَ لَنا إِلَيْكَ إِلَّا أَنْتَ" },
    { "kind": "text", "ar": "إِلٰهِي اجْعَلْنِي مِنَ المُصْطَفَيْنَ الأَخْيارِ" },
    { "kind": "text", "ar": "وَأَلْحِقْنِي بِالصَّالِحِينَ الأَبْرارِ" },
    { "kind": "text", "ar": "السَّابِقِينَ إِلَىٰ المَكْرُماتِ، المُسارِعِينَ إِلَىٰ الخَيْراتِ" },
    { "kind": "text", "ar": "العامِلِينَ لِلْباقِياتِ الصَّالِحاتِ" },
    { "kind": "text", "ar": "السَّاعِينَ إِلَىٰ رَفِيعِ الدَّرَجاتِ" },
    { "kind": "text", "ar": "إِنَّكَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ، وَبِالإِجابَةِ جَدِيرٌ" },
    { "kind": "text", "ar": "بِرَحْمَتِكَ يا أَرْحَمَ الرَّاحِمِينَ" }
  ]
}
