{
  "id": "munajat-hajj",
  "title": "مناجات طلب حج",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مناجات طلب حج",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنِي الْحَجَّ الَّذِي افْتَرَضْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي مَنِ اسْتَطَاعَ اِلَيْهِ سَبِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لِيْ فِيْهِ هَادِيًا وَاِلَيْهِ دَلِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَقَرِّبْ لِيْ بُعْدَ الْمَسَالِكِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِنِّيْ عَلٰي تَأْدِيَةِ الْمَنَاسِكِ"
    },
    {
      "kind": "text",
      "ar": "وَحَرِّمْ بِاِحْرَامِيْ عَلَي النَّارِ جَسَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَزِدْ لِلسَّفَرِ قُوَّتِيْ وَجَلَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ رَبِّ الْوُقُوْفَ بَيْنَ يَدَيْكَ وَالْاِفَاضَةَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَظْفِرْنِيْ بِالنُّجْحِ بِوَافِرِ الرِّبْحِ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْدِرْنِيْ رَبِّ مِنْ مَوْقِفِ الْحَجِّ الْاَكْبَرِ اِلٰي مُزْدَلَفَةِ الْمَشْعَرِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهَا زُلْفَةً اِلٰي رَحْمَتِكَ، وَطَرِيْقًا اِلٰي جَنَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقِفْنِيْ مَوْقِفَ الْمَشْعِرَ الْحَرَامِ وَمَقَامَ وُقُوْفِ الْاِحْرَامِ"
    },
    {
      "kind": "text",
      "ar": "وَأَهِلَّنِيْ لِتَأْدِيَةِ الْمَنَاسِكَ وَنَحْرِ الْهَدْيِ التَّوَامِكِ"
    },
    {
      "kind": "text",
      "ar": "بِدَمٍ يَثُجُّ وَأَوْدَاجٍ تَمُجُّ"
    },
    {
      "kind": "text",
      "ar": "وَاِرَاقَةِ الدِّمَاءِ الْمَسْفُوْحَةِ وَالْهَدَايَا الْمَذْبُوْحَةِ"
    },
    {
      "kind": "text",
      "ar": "وَفَرْيِ أَوْدَاجِهَا عَلٰي مَا أَمَرْتَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّنَفُّلِ بِهَا كَمَا وَسَمْتَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْضِرْنِيْ اَللّٰهُمَّ صَلَاةَ الْعِيْدِ"
    },
    {
      "kind": "text",
      "ar": "رَاجِيًا لِلْوَعْدِ خَائِفًا مِنَ الْوَعِيْدِ"
    },
    {
      "kind": "text",
      "ar": "حَلِقًا شَعْرَ رَأْسِيْ وَمُقَصِّرًا وَمُجْتَهِدًا فِيْ طَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "مُشَمِّرًا رَامِيًا لِلْجِمَارِ بِسَبْعٍ بَعْدَ سَبْعٍ مِنَ الْاَحْجَارِ"
    },
    {
      "kind": "text",
      "ar": "وَأَدْخِلْنِيْ اَللّٰهُمَّ عَرْصَةَ بَيْتِكَ وَعَقْوَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَحَلَّ أَمْنِكَ وَكَعْبَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَسَاكِيْنِكَ وَسُؤّالِكَ وَمَحَاوِيْجِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجُدْ عَلَيَّ اَللّٰهُمَّ بِوَافِرِ الْاَجْرِ مِنَ الْاِنْكِفَاءِ وَالنَّفْرِ"
    },
    {
      "kind": "text",
      "ar": "وَاخْتِمِ اَللّٰهُمَّ مَنَاسِكَ حَجِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَانْقِضَاءَ عَجِّيْ بِقَبُوْلٍ مِنْكَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَرَأْفَةٍ مِنْكَ بِيْ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}