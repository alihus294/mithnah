{
  "id": "salawat-imam-sadiq",
  "title": "امام جعفر صادق پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام جعفر صادق پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّهُمَّ صَلِّ عَلٰي جَعْفَرِ بْنِ مُحَمَّدٍ الصَّادِقِ، خَازِنِ الْعِلْمِ"
    },
    {
      "kind": "text",
      "ar": "الدَّاعِيْ اِلَيْكَ بِالْحَقِّ، النُّوْرِ الْمُبِيْنِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَكَمَا جَعَلْتَهٗ مَعْدِنَ كَلَامِكَ وَوَحْيِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَازِنَ عِلْمِكَ، وَلِسَانَ تَوْحِيْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَلِيَّ أَمْرِكَ، وَمُسْتَحْفِظَ دِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِ أَفْضَلَ مَا صَلَّيْتَ عَلٰي أَحَدٍ مِنْ أَصْفِيَائِكَ وَحُجَجِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ حَمِيْدٌ مَجِيْدٌ۔"
    }
  ]
}