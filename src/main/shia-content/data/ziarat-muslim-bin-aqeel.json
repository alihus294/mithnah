{
  "id": "ziarat-muslim-bin-aqeel",
  "title": "زيارت حضرت مسلم بن عقيل",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت حضرت مسلم بن عقيل",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الْمَلِكِ الْحَقِّ الْمُبِيْنِ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَصَاغِرِ لِعَظَمَتِهٖ جَبَابِرَةُ الطَّاغِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمُعْتَرِفِ بِرُبُوْبِيَّتِهٖ جَمِيْعُ أَهْلِ السَّمٰوَاتِ وَالْاَرَضِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمُقِرِّ بِتَوْحِيْدِهٖ سَائِرُ الْخَلْقِ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي سَيِّدِ الْاَنَامِ وَأَهْلِ بَيْتِهِ الْكِرَامِ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً تَقَرُّ بِهَا أَعْيُنُهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَيَرْغَمُ بِهَا أَنْفُ شَانِئِهِمْ مِنَ الْجِنِّ وَالْاِنْسِ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "سَلَامُ اللهِ الْعَلِيِّ الْعَظِيْمِ وَسَلَامُ مَلَائِكَتِهِ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْبِيَائِهِ الْمُرْسَلِيْنَ، وَأَئِمَّتِهِ الْمُنْتَجَبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعِبَادِهِ الصَّالِحِيْنَ، وَجَمِيْعِ الشُّهَدَاءِ وَالصِّدِّيْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالزَّاكِيَاتُ الطَّيِّبَاتُ فِيْمَا تَغْتَدِيْ وَتَرُوْحُ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْكَ يَا مُسْلِمَ بْنَ عَقِيْلِ بْنِ أَبِيْ طَالِبٍ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ أَقَمْتَ الصَّلَاةَ، وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِي اللهِ حَقَّ جِهَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَقُتِلْتَ عَلٰي مِنْهَاجِ الْمُجَاهِدِيْنَ فِيْ سَبِيْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَقِيْتَ اللهَ عَزَّ وَجَلَّ وَهُوَ عَنْكَ رَاضٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ وَفَيْتَ بِعَهْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَبَذَلْتَ نَفْسَكَ فِيْ نُصْرَةِ حُجَّةِ اللهِ وَابْنِ حُجَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ لَكَ بِالتَّسْلِيْمِ وَالْوَفَاءِ وَالنَّصِيْحَةِ"
    },
    {
      "kind": "text",
      "ar": "لِخَلَفِ النَّبِيِّ الْمُرْسَلِ، وَالسِّبْطِ الْمُنْتَجَبِ"
    },
    {
      "kind": "text",
      "ar": "وَالدَّلِيْلِ الْعَالِمِ، وَالْوَصِيِّ الْمُبَلِّغِ، وَالْمَظْلُوْمِ الْمُهْتَضَمِ"
    },
    {
      "kind": "text",
      "ar": "فَجَزَاكَ اللهُ عَنْ رَسُوْلِهٖ، وَعَنْ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَنِ الْحَسَنِ وَالْحُسَيْنِ أَفْضَلَ الْجَزَاءِ"
    },
    {
      "kind": "text",
      "ar": "بِمَا صَبَرْتَ وَأَحْتَسَبْتَ وَأَعَنْتَ، فَنِعْمَ عُقْبَي الدَّارِ"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ مَنْ قَتَلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ أَمَرَ بِقَتْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ ظَلَمَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنِ افْتَرٰي عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ جَهِلَ حَقَّكَ وَاسْتَخَفَّ بِحُرْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ بَايَعَكَ وَغَشَّكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَذَلَكَ وَأَسْلَمَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ أَلَبَّ عَلَيْكَ وَلَمْ يُعِنْكَ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ جَعَلَ النَّارَ مَثْوَاهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَبِئْسَ الْوِرْدُ الْمَوْرُوْدُ۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قُتِلْتَ مَظْلُوْمًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ اللهَ مُنْجِزٌ لَكُمْ مَا وَعَدَكُمْ"
    },
    {
      "kind": "text",
      "ar": "جِئْتُكَ زَائِرًا عَارِفًا بِحَقِّكُمْ، مُسَلِّمًا لَكُمْ"
    },
    {
      "kind": "text",
      "ar": "تَابِعًا لِسُنَّتِكُمْ، وَنُصْرَتِيْ لَكُمْ مُعَدَّةٌ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي يَحْكُمَ اللهُ وَهُوَ خَيْرُ الْحَاكِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَمَعَكُمْ مَعَكُمْ، لَا مَعَ عَدُوِّكُمْ"
    },
    {
      "kind": "text",
      "ar": "صَلوَاتُ اللهِ عَلَيْكُمْ وَعَلٰي أَرْوَاحِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَجْسَادِكُمْ  وَشَاهِدِكُمْ وَغَائِبِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "قَتَلَ اللهُ أُمَّةً قَتَلَتْكُمْ بِالْاَيْدِيْ وَالْاَلْسُنِ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْعَبْدُ الصَّالِحُ"
    },
    {
      "kind": "text",
      "ar": "الْمُطِيْعُ لِلّٰهِ وَلِرَسُوْلِهٖ وَلِاَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنِ وَالْحُسَيْنِ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ وَسَلَامٌ عَلٰي عِبَادِهِ الَّذِيْنَ اصْطَفٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ وَمَغْفِرَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي رُوْحِكَ وَبَدَنِكَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ مَضَيْتَ عَلٰي مَا مَضٰي عَلَيْهِ الْبَدْرِيُّوْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمُجَاهِدُوْنَ فِيْ سَبِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "الْمُبَالِغُوْنَ فِيْ جِهَادِ أَعْدَائِهٖ وَنُصْرَةِ أَوْلِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَجَزَاكَ اللهُ أَفْضَلَ الْجَزَاءِ، وَأَكْثَرَ الْجَزَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْفَرَ جَزَاءِ أَحَدٍ مِمَّنْ وَفٰي بِبَيْعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَجَابَ لَهٗ دَعْوَتَهٗ، وَأَطَاعَ وُلَاةَ أَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ بَالَغْتَ فِي النَّصِيْحَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطَيْتَ غَايَةَ الْمَجْهُوْدِ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي بَعَثَكَ اللهُ فِي الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَ رُوْحَكَ مَعَ أَرْوَاحِ السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطَاكَ مِنْ جِنَانِهٖ أَفْسَحَهَا مَنْزِلًا، وَأَفْضَلَهَا غُرَفًا"
    },
    {
      "kind": "text",
      "ar": "وَرَفَعَ ذِكْرَكَ فِي الْعِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَحَشَرَكَ مَعَ النَّبِيِّيْنَ وَالصِّدِّيْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالشُّهَدَاءِ وَالصَّالِحِيْنَ وَحَسُنَ أُولٰئِكَ رَفِيْقًا"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ لَمْ تَهِنْ وَلَمْ تَنْكُلْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ قَدْ مَضَيْتَ عَلٰي بَصِيْرَةٍ مِنْ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "مُقْتَدِيًا بِالصَّالِحِيْنَ وَمُتَّبِعًا لِلنَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَجَمَعَ اللهُ بَيْنَنَا وَبَيْنَكَ وَبَيْنَ رَسُوْلِهٖ وَأَوْلِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "فِيْ مَنَازِلِ الْمُخْبِتِيْنَ، فَاِنَّهٗ أَرْحَمُ الرَّاحِمِيْنَ۔"
    }
  ]
}