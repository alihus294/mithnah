{
  "id": "yastashir",
  "title": "دعاء اليستشير",
  "subtitle": "علّمه رسول الله ﷺ للإمام علي عليه السلام",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "دعاء اليستشير", "subtitle": "علّمه رسول الله للإمام علي ع" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "الحَمْدُ للهِ الَّذِي لا إِلٰهَ إِلَّا هُوَ" },
    { "kind": "text", "ar": "المَلِكُ الحَقُّ المُبِينُ" },
    { "kind": "text", "ar": "المُدَبِّرُ بِلا وَزِيرٍ وَلا خَلْقٍ مِنْ عِبادِهِ يَسْتَشِيرُ" },
    { "kind": "text", "ar": "الأَوَّلُ غَيْرُ مَوْصُوفٍ" },
    { "kind": "text", "ar": "وَالباقِي بَعْدَ فَناءِ الخَلْقِ" },
    { "kind": "text", "ar": "العَظِيمُ الرُّبُوبِيَّةِ" },
    { "kind": "text", "ar": "نُورُ السَّماواتِ وَالأَرَضِينَ" },
    { "kind": "text", "ar": "وَفاطِرُهُما وَمُبْتَدِعُهُما بِغَيْرِ عَمَدٍ" },
    { "kind": "text", "ar": "خَلَقَهُما وَفَتَقَهُما فَتْقاً" },
    { "kind": "text", "ar": "فَقامَتِ السَّماواتُ طائِعاتٍ بِأَمْرِهِ" },
    { "kind": "text", "ar": "وَاسْتَقَرَّتِ الأَرَضُونَ بِأَوْتادِها فَوْقَ الماءِ" },
    { "kind": "text", "ar": "ثُمَّ عَلا رَبُّنا فِي السَّماواتِ العُلَىٰ" },
    { "kind": "text", "ar": "الرَّحْمٰنُ عَلَىٰ العَرْشِ اسْتَوَىٰ" },
    { "kind": "text", "ar": "لَهُ ما فِي السَّماواتِ وَما فِي الأَرْضِ" },
    { "kind": "text", "ar": "وَما بَيْنَهُما وَما تَحْتَ الثَّرَىٰ" },
    { "kind": "text", "ar": "فَأَنا أَشْهَدُ بِأَنَّكَ أَنْتَ اللهُ" },
    { "kind": "text", "ar": "لا رافِعَ لِما وَضَعْتَ، وَلا واضِعَ لِما رَفَعْتَ" },
    { "kind": "text", "ar": "وَلا مُعِزَّ لِمَنْ أَذْلَلْتَ، وَلا مُذِلَّ لِمَنْ أَعْزَزْتَ" },
    { "kind": "text", "ar": "وَلا مانِعَ لِما أَعْطَيْتَ، وَلا مُعْطِيَ لِما مَنَعْتَ" },
    { "kind": "text", "ar": "وَأَنْتَ اللهُ لا إِلٰهَ إِلَّا أَنْتَ" },
    { "kind": "text", "ar": "كُنْتَ إِذْ لَمْ تَكُنْ سَماءٌ مَبْنِيَّةٌ" },
    { "kind": "text", "ar": "وَلا أَرْضٌ مَدْحِيَّةٌ" },
    { "kind": "text", "ar": "وَلا شَمْسٌ مُضِيئَةٌ، وَلا لَيْلٌ مُظْلِمٌ، وَلا نَهارٌ مُضِيءٌ" },
    { "kind": "text", "ar": "وَلا بَحْرٌ لُجِّيٌّ، وَلا جَبَلٌ راسٍ" },
    { "kind": "text", "ar": "وَلا نَجْمٌ سارٍ، وَلا قَمَرٌ مُنِيرٌ" },
    { "kind": "text", "ar": "وَلا رِيحٌ تَهُبُّ، وَلا سَحابٌ يَسْكُبُ" },
    { "kind": "text", "ar": "وَلا بَرْقٌ يَلْمَعُ، وَلا رَعْدٌ يُسَبِّحُ" },
    { "kind": "text", "ar": "وَلا رُوحٌ تَنَفَّسُ، وَلا طائِرٌ يَطِيرُ" },
    { "kind": "text", "ar": "وَلا نارٌ تَتَوَقَّدُ، وَلا ماءٌ يَطَّرِدُ" },
    { "kind": "text", "ar": "كُنْتَ قَبْلَ كُلِّ شَيْءٍ، وَكَوَّنْتَ كُلَّ شَيْءٍ" },
    { "kind": "text", "ar": "وَقَدَرْتَ عَلَىٰ كُلِّ شَيْءٍ" },
    { "kind": "text", "ar": "وَابْتَدَعْتَ كُلَّ شَيْءٍ" },
    { "kind": "text", "ar": "وَأَغْنَيْتَ وَأَفْقَرْتَ، وَأَمَتَّ وَأَحْيَيْتَ" },
    { "kind": "text", "ar": "وَأَضْحَكْتَ وَأَبْكَيْتَ" },
    { "kind": "text", "ar": "وَعَلَىٰ العَرْشِ اسْتَوَيْتَ" },
    { "kind": "text", "ar": "فَتَبارَكْتَ يا اللهُ وَتَعالَيْتَ" },
    { "kind": "text", "ar": "أَنْتَ اللهُ الَّذِي لا إِلٰهَ إِلَّا أَنْتَ، الخَلَّاقُ المُعِينُ" },
    { "kind": "text", "ar": "أَمْرُكَ غالِبٌ، وَعِلْمُكَ نافِذٌ" },
    { "kind": "text", "ar": "وَكَيْدُكَ غَرِيبٌ، وَوَعْدُكَ صادِقٌ" },
    { "kind": "text", "ar": "وَقَوْلُكَ حَقٌّ، وَحُكْمُكَ عَدْلٌ" },
    { "kind": "text", "ar": "وَكَلامُكَ هُدًىٰ، وَوَحْيُكَ نُورٌ" },
    { "kind": "text", "ar": "وَرَحْمَتُكَ واسِعَةٌ، وَعَفْوُكَ عَظِيمٌ" },
    { "kind": "text", "ar": "وَفَضْلُكَ كَثِيرٌ، وَعَطاؤُكَ جَزِيلٌ" },
    { "kind": "text", "ar": "وَحَبْلُكَ مَتِينٌ، وَإِمْكانُكَ عَتِيدٌ" },
    { "kind": "text", "ar": "وَجارُكَ عَزِيزٌ، وَبَأْسُكَ شَدِيدٌ" },
    { "kind": "text", "ar": "وَمَكْرُكَ مَكِيدٌ" },
    { "kind": "text", "ar": "أَنْتَ يا رَبِّ مَوْضِعُ كُلِّ شَكْوَىٰ" },
    { "kind": "text", "ar": "حاضِرُ كُلِّ مَلَأٍ، وَشاهِدُ كُلِّ نَجْوَىٰ" },
    { "kind": "text", "ar": "مُنْتَهَىٰ كُلِّ حاجَةٍ، مُفَرِّجُ كُلِّ حُزْنٍ" },
    { "kind": "text", "ar": "غِنَىٰ كُلِّ مِسْكِينٍ، حِصْنُ كُلِّ هارِبٍ" },
    { "kind": "text", "ar": "أَمانُ كُلِّ خائِفٍ، حِرْزُ الضُّعَفاءِ" },
    { "kind": "text", "ar": "كَنْزُ الفُقَراءِ، مُفَرِّجُ الغَمَّاءِ" },
    { "kind": "text", "ar": "مُعِينُ الصَّالِحِينَ" },
    { "kind": "text", "ar": "ذٰلِكَ اللهُ رَبُّنا، لا إِلٰهَ إِلَّا هُوَ" },
    { "kind": "text", "ar": "تَكْفِي مِنْ عِبادِكَ مَنْ تَوَكَّلَ عَلَيْكَ" },
    { "kind": "text", "ar": "وَأَنْتَ جارُ مَنْ لاذَ بِكَ وَتَضَرَّعَ إِلَيْكَ" },
    { "kind": "text", "ar": "عِصْمَةُ مَنِ اعْتَصَمَ بِكَ" },
    { "kind": "text", "ar": "ناصِرُ مَنِ انْتَصَرَ بِكَ" },
    { "kind": "text", "ar": "تَغْفِرُ الذُّنُوبَ لِمَنِ اسْتَغْفَرَكَ" },
    { "kind": "text", "ar": "جَبَّارُ الجَبابِرَةِ، عَظِيمُ العُظَماءِ" },
    { "kind": "text", "ar": "كَبِيرُ الكُبَراءِ، سَيِّدُ السَّاداتِ" },
    { "kind": "text", "ar": "مَوْلَىٰ المَوالِي، صَرِيخُ المُسْتَصْرِخِينَ" },
    { "kind": "text", "ar": "مُنَفِّسٌ عَنِ المَكْرُوبِينَ، مُجِيبُ دَعْوَةِ المُضْطَرِّينَ" },
    { "kind": "text", "ar": "أَسْمَعُ السَّامِعِينَ، أَبْصَرُ النَّاظِرِينَ" },
    { "kind": "text", "ar": "أَحْكَمُ الحاكِمِينَ، أَسْرَعُ الحاسِبِينَ" },
    { "kind": "text", "ar": "أَرْحَمُ الرَّاحِمِينَ، خَيْرُ الغافِرِينَ" },
    { "kind": "text", "ar": "قاضِي حَوائِجِ المُؤْمِنِينَ، مُغِيثُ الصَّالِحِينَ" },
    { "kind": "text", "ar": "أَنْتَ اللهُ لا إِلٰهَ إِلَّا أَنْتَ رَبُّ العالَمِينَ" },
    { "kind": "text", "ar": "أَنْتَ الخالِقُ وَأَنا المَخْلُوقُ" },
    { "kind": "text", "ar": "وَأَنْتَ المالِكُ وَأَنا المَمْلُوكُ" },
    { "kind": "text", "ar": "وَأَنْتَ الرَّبُّ وَأَنا العَبْدُ" },
    { "kind": "text", "ar": "وَأَنْتَ الرَّازِقُ وَأَنا المَرْزُوقُ" },
    { "kind": "text", "ar": "وَأَنْتَ المُعْطِي وَأَنا السَّائِلُ" },
    { "kind": "text", "ar": "وَأَنْتَ الجَوادُ وَأَنا البَخِيلُ" },
    { "kind": "text", "ar": "وَأَنْتَ القَوِيُّ وَأَنا الضَّعِيفُ" },
    { "kind": "text", "ar": "وَأَنْتَ العَزِيزُ وَأَنا الذَّلِيلُ" },
    { "kind": "text", "ar": "وَأَنْتَ الغَنِيُّ وَأَنا الفَقِيرُ" },
    { "kind": "text", "ar": "وَأَنْتَ السَّيِّدُ وَأَنا العَبْدُ" },
    { "kind": "text", "ar": "وَأَنْتَ الغافِرُ وَأَنا المُسِيءُ" },
    { "kind": "text", "ar": "وَأَنْتَ العالِمُ وَأَنا الجاهِلُ" },
    { "kind": "text", "ar": "وَأَنْتَ الحَلِيمُ وَأَنا العَجُولُ" },
    { "kind": "text", "ar": "وَأَنْتَ الرَّحْمٰنُ وَأَنا المَرْحُومُ" },
    { "kind": "text", "ar": "وَأَنْتَ المُعافِي وَأَنا المُبْتَلَىٰ" },
    { "kind": "text", "ar": "وَأَنْتَ المُجِيبُ وَأَنا المُضْطَرُّ" },
    { "kind": "text", "ar": "وَأَنا أَشْهَدُ بِأَنَّكَ أَنْتَ اللهُ لا إِلٰهَ إِلَّا أَنْتَ" },
    { "kind": "text", "ar": "المُعْطِي عِبادَكَ بِلا سُؤالٍ" },
    { "kind": "text", "ar": "وَأَشْهَدُ بِأَنَّكَ أَنْتَ اللهُ الواحِدُ الأَحَدُ" },
    { "kind": "text", "ar": "المُتَفَرِّدُ الصَّمَدُ الفَرْدُ، وَإِلَيْكَ المَصِيرُ" },
    { "kind": "text", "ar": "وَصَلَّىٰ اللهُ عَلَىٰ مُحَمَّدٍ وَأَهْلِ بَيْتِهِ الطَّيِّبِينَ الطَّاهِرِينَ" },
    { "kind": "text", "ar": "وَاغْفِرْ لِي ذُنُوبِي، وَاسْتُرْ عَلَيَّ عُيُوبِي" },
    { "kind": "text", "ar": "وَافْتَحْ لِي مِنْ لَدُنْكَ رَحْمَةً وَرِزْقاً واسِعاً" },
    { "kind": "text", "ar": "يا أَرْحَمَ الرَّاحِمِينَ" },
    { "kind": "text", "ar": "وَالحَمْدُ للهِ رَبِّ العالَمِينَ" },
    { "kind": "text", "ar": "وَحَسْبُنا اللهُ وَنِعْمَ الوَكِيلُ" },
    { "kind": "text", "ar": "وَلا حَوْلَ وَلا قُوَّةَ إِلَّا بِاللهِ العَلِيِّ العَظِيمِ" }
  ]
}
