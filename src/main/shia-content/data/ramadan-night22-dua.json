{
  "id": "ramadan-night22-dua",
  "title": "بائيسويں شب كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "بائيسويں شب كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا سَالِخَ النَّهَارِ مِنَ اللَّيْلِ فَاِذَا نَحْنُ مُظْلِمُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمُجْرِيَ الشَّمْسِ لِمُسْتَقَرِّهَا بِتَقْدِيْرِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا عَزِيْزُ يَا عَلِيْمُ"
    },
    {
      "kind": "text",
      "ar": "وَمُقَدِّرَ الْقَمَرِ مَنَازِلَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي عَادَ كَالْعُرْجُوْنِ الْقَدِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا نُوْرَ كُلِّ نُوْرٍ"
    },
    {
      "kind": "text",
      "ar": "وَمُنْتَهٰي كُلِّ رَغْبَةٍ، وَوَلِيَّ كُلِّ نِعْمَةٍ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا رَحْمٰنُ، يَا اللهُ يَا قُدُّوْس"
    },
    {
      "kind": "text",
      "ar": "يَا أَحَدُ يَا وَاحِدُ يَا فَرْدُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا اللهُ يَا اللهُ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْاَسْمَاءُ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْاَمْثَالُ الْعُلْيَا وَالْكِبْرِيَاءُ وَالْاٰلَاءُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ اسْمِيْ فِيْ هٰذِهِ اللَّيْلَةِ فِي السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَرُوْحِيْ مَعَ الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاِحْسَانِيْ فِيْ عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِسَائَتِيْ مَغْفُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَهَبَ لِيْ يَقِيْنًا تُبَاشِرُ بِهٖ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِيْمَانًا يُذْهِبُ الشَّكَّ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُرْضِيَنِيْ بِمَا قَسَمْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْاٰخِرَةِ حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِنَا عَذَابَ النَّارِ الْحَرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ فِيْهَا ذِكْرَكَ وَشُكْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّغْبَةَ اِلَيْكَ، وَالْاِنَابَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّوْفِيْقَ لِمَا وَفَّقْتَ لَهٗ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْهِمُ السَّلَامُ۔"
    }
  ]
}