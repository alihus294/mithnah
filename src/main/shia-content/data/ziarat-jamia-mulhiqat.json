{
  "id": "ziarat-jamia-mulhiqat",
  "title": "زيارت جامعه ائمه معصومين",
  "subtitle": "ملحقات مفاتيح الجنان",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت جامعه ائمه معصومين",
      "subtitle": "ملحقات مفاتيح الجنان"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ سَبِيْلِ اللهِ، وَعَلٰي مِلَّةِ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْسِلْ عَنِّيْ دَرَنَ الذُّنُوْبِ، وَوَسَخَ الْعُيُوْبِ"
    },
    {
      "kind": "text",
      "ar": "وَطَهِّرْنِيْ بِمَاءِ التَّوْبَةِ، وَأَلْبِسْنِيْ رِدَاءَ الْعِصْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَيِّدْنِيْ بِلُطْفٍ مِنْكَ يُوَفِّقُنِيْ لِصَالِحِ الْاَعْمَالِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ ذُوالْفَضْلِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ وَفَّقَنِيْ لِقَصْدِ وَلِيِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَزِيَارَةِ حُجَّتِهٖ وَأَوْرَدَنِيْ حَرَمَهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَبْخَسْنِيْ حَظِّيْ مِنْ زِيَارَةِ قَبْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالنُّزُوْلِ بِعَقْوَةِ مُغَيَّبِهٖ، وَسَاحَةِ تُرْبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَمْ يَسِمْنِيْ بِحِرْمَانِ مَا أَمَّلْتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا صَرَفَ عَنِّيْ مَا رَجَوْتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا قَطَعَ رَجَائِيْ فِيْمَا تَوَقَّعْتُهٗ"
    },
    {
      "kind": "text",
      "ar": "بَلْ أَلْبَسَنِيْ عَافِيَتَهٗ، وَأَفَادَنِيْ نِعْمَتَهٗ، وَاٰتَانِيْ كَرَامَتَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَئِمَّةَ الْمُؤْمِنِيْنَ وَسَادَةَ الْمُتَّقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَكُبَرَاءَ الصِّدِّيْقِيْنَ وَأُمَرَاءَ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَقَادَةَ الْمُحْسِنِيْنَ وَأَعْلَامَ الْمُهْتَدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْوَارَ الْعَارِفِيْنَ وَوَرَثَةَ الْاَنْبِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَصَفْوَةَ الْاَوْصِيَاءِ وَشُمُوْسَ الْاَتْقِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَبُدُوْرَ الْخُلَفَاءِ وَعِبَادَ الرَّحْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَشُرَكَاءَ الْقُرْاٰنِ وَمَنْهَجَ الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَمَعَادِنَ الْحَقَايِقِ وَشُفَعَاءَ الْخَلَائِقِ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكُمْ أَبْوَابُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَمَفَاتِيْحُ رَحْمَتِهٖ وَمَقَالِيْدُ مَغْفِرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَحَائِبُ رِضْوَانِهٖ وَمَصَابِيْحُ جِنَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحَمَلَةُ فُرْقَانِهٖ وَخَزَنَةُ عِلْمِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحَفَظَةُ سِرِّهٖ وَمَهْبِطُ وَحْيِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعِنْدَكُمْ أَمَانَاتُ النُّبُوَّةِ وَوَدَائِعُ الرِّسَالَةِ"
    },
    {
      "kind": "text",
      "ar": "أَنْتُمْ أُمَنَاءُ اللهِ وَأَحِبَّاؤُهٗ وَعِبَادُهٗ وَأَصْفِيَاؤُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْصَارُ تَوْحِيْدِهٖ وَأَرْكَانُ تَمْجِيْدِهٖ وَدُعَاتُهٗ اِلٰي كُتُبِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحَرَسَةُ خَلَائِقِهٖ وَحَفَظَةُ وَدَائِعِهٖ"
    },
    {
      "kind": "text",
      "ar": "لَا يَسْبِقُكُمْ ثَنَاءُ الْمَلَائِكَةِ فِي الْاِخْلَاصِ وَالْخُشُوْعِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُضَادُّكُمْ ذُوابْتِهَالٍ وَخُضُوْعٍ"
    },
    {
      "kind": "text",
      "ar": "أَنّٰي وَلَكُمُ الْقُلُوْبُ الَّتِيْ تَوَلَّي اللهُ رِيَاضَتَهَا بِالْخَوْفِ وَالرَّجَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَهَا أَوْعِيَةً لِلشُّكْرِ وَالثَّنَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاٰمَنَهَا مِنْ عَوَارِضِ الْغَفْلَةِ وَصَفَّاهَا مِنْ سُوْءِ الْفَتْرَةِ"
    },
    {
      "kind": "text",
      "ar": "بَلْ يَتَقَرَّبُ أَهْلُ السَّمَاءِ بِحُبِّكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَبِالْبَرَائَةِ مِنْ أَعْدَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَتَوَاتُرِ الْبُكَاءِ عَلٰي مُصَابِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِسْتِغْفَارِ لِشِيْعَتِكُمْ وَمُحِبِّيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "فَأَنَا أُشْهِدُ اللهَ خَالِقِيْ وَأُشْهِدُ مَلَائِكَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْبِيَائَهٗ وَأُشْهِدُكُمْ يَا مَوَالِيَّ"
    },
    {
      "kind": "text",
      "ar": "أَنِّيْ مُؤْمِنٌ بِوِلَايَتِكُمْ مُعْتَقِدٌ لِاِمَامَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُقِرٌّ بِخِلَافَتِكُمْ عَارِفٌ بِمَنْزِلَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُوْقِنٌ بِعِصْمَتِكُمْ خَاضِعٌ لِوِلَايَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُتَقَرِّبٌ اِلَي اللهِ بِحُبِّكُمْ وَبِالْبَرَائَةِ مِنْ أَعْدَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "عَالِمٌ بِأَنَّ اللهَ قَدْ طَهَّرَكُمْ مِنَ الْفَوَاحِشِ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ رِيْبَةٍ وَنَجَاسَةٍ وَدَنِيَّةٍ وَرَجَاسَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَمَنَحَكُمْ رَايَةَ الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ مَنْ تَقَدَّمَهَا ضَلَّ، وَمَنْ تَأَخَّرَ عَنْهَا زَلَّ"
    },
    {
      "kind": "text",
      "ar": "وَفَرَضَ طَاعَتَكُمْ عَلٰي كُلِّ أَسْوَدَ وَأَبْيَضَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكُمْ قَدْ وَفَيْتُمْ بِعَهْدِ اللهِ وَذِمَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبِكُلِّ مَا اشْتَرَطَ عَلَيْكُمْ فِيْ كِتَابِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَوْتُمْ اِلٰي سَبِيْلِهٖ وَأَنْفَذْتُمْ طَاقَتَكُمْ فِيْ مَرْضَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحَمَلْتُمُ الْخَلَائِقَ عَلٰي مِنْهَاجِ النُّبُوَّةِ وَمَسَالِكِ الرِّسَالَةِ"
    },
    {
      "kind": "text",
      "ar": "وَسِرْتُمْ فِيْهِ بِسِيْرَةِ الْاَنْبِيَاءِ وَمَذَاهِبِ الْاَوْصِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "فَلَمْ يُطَعْ لَكُمْ أَمْرٌوَلَمْ تُصْغَ اِلَيْكُمْ أُذُنٌ"
    },
    {
      "kind": "text",
      "ar": "فَصَلَوَاتُ اللهِ عَلٰي أَرْوَاحِكُمْ وَأَجْسَادِكُمْ۔"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتَ وَأُمِّيْ يَاحُجَّةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "لَقَدْ أُرْضِعْتَ بِثَدْيِ الْاِيْمَانِ وَفُطِمْتَ بِنُوْرِ الْاِسْلَامِ"
    },
    {
      "kind": "text",
      "ar": "وَغُذِّيْتَ بِبَرْدِ الْيَقِيْنِ وَأُلْبِسْتَ حُلَلَ الْعِصْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاصْطُفِيْتَ وَوُرِّثْتَ عِلْمَ الْكِتَابِ"
    },
    {
      "kind": "text",
      "ar": "وَلُقِّنْتَ فَصْلَ الْخِطَابِ"
    },
    {
      "kind": "text",
      "ar": "وَأُوْضِحَ بِمَكَانِكَ مَعَارِفُ التَّنْزِيْلِ وَغَوَامِضُ التَّأْوِيْلِ"
    },
    {
      "kind": "text",
      "ar": "وَسُلِّمَتْ اِلَيْكَ رَايَةُ الْحَقِّ، وَكُلِّفْتَ هِدَايَةَ الْخَلْقِ"
    },
    {
      "kind": "text",
      "ar": "وَنُبِذَ اِلَيْكَ عَهْدُ الْاِمَامَةِ، وَأُلْزِمْتَ حِفْظَ الشَّرِيْعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ يَا مَوْلَايَ أَنَّكَ وَفَيْتَ بِشَرَائِطِ الْوَصِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَقَضَيْتَ مَا لَزِمَكَ مِنْ حَدِّ الطَّاعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَنَهَضْتَ بِأَعْبَاءِ الْاِمَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاحْتَذَيْتَ مِثَالَ النُّبُوَّةِ فِي الصَّبْرِ وَالْاِجْتِهَادِ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّصِيْحَةِ لِلْعِبَادِ وَكَظْمِ الْغَيْظِ وَالْعَفْوِ عَنِ النَّاسِ"
    },
    {
      "kind": "text",
      "ar": "وَعَزَمْتَ عَلَي الْعَدْلِ فِي الْبَرِيَّةِ وَالنَّصَفَةِ فِي الْقَضِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَوَكَّدْتَ الْحُجَجَ عَلَي الْأُمَّةِ"
    },
    {
      "kind": "text",
      "ar": "بِالدَّلَائِلِ الصَّادِقَةِ وَالشَّرِيْعَةِ النَّاطِقَةِ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَوْتَ اِلَي اللهِ بِالْحِكْمَةِ الْبَالِغَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ"
    },
    {
      "kind": "text",
      "ar": "فَمُنِعْتَ مِنْ تَقْوِيْمِ الزَّيْغِ وَسَدِّ الثُّلَمِ"
    },
    {
      "kind": "text",
      "ar": "وَاِصْلَاحِ الْفَاسِدِ وَكَسْرِ الْمُعَانِدِ"
    },
    {
      "kind": "text",
      "ar": "وَاِحْيَاءِ السُّنَنِ وَاِمَاتَةِ الْبِدَعِ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي فَارَقْتَ الدُّنْيَا وَأَنْتَ شَهِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَقِيْتَ رَسُوْلَ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ حَمِيْدٌ صَلَوَاتُ اللهِ عَلَيْكَ تَتَرَادَفُ وَتَزِيْدُ۔"
    },
    {
      "kind": "text",
      "ar": "يَا سَادَتِيْ يَا اٰلَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ بِكُمْ أَتَقَرَّبُ اِلَي اللهِ جَلَّ وَعَلَا"
    },
    {
      "kind": "text",
      "ar": "بِالْخِلَافِ عَلَي الَّذِيْنَ غَدَرُوْا بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَنَكَثُوْا بَيْعَتَكُمْ وَجَحَدُوْا وِلَايَتَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْكَرُوْا مَنْزِلَتَكُمْ وَخَلَعُوْا رِبْقَةَ طَاعَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَهَجَرُوْا أَسْبَابَ مَوَدَّتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَتَقَرَّبُوْا اِلٰي فَرَاعِنَتِهِمْ بِالْبَرَائَةِ مِنْكُمْ وَالْاِعْرَاضِ عَنْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَمَنَعُوْكُمْ مِنْ اِقَامَةِ الْحُدُوْدِ وَاسْتِيْصَالِ الْجُحُوْدِ"
    },
    {
      "kind": "text",
      "ar": "وَشَعْبِ الصَّدْعِ وَلَمِّ الشَّعَثِ وَسَدِّ الْخَلَلِ"
    },
    {
      "kind": "text",
      "ar": "وَتَثْقِيْفِ الْأَوَدِ وَاِمْضَاءِالْاَحْكَامِ"
    },
    {
      "kind": "text",
      "ar": "وَتَهْذِيْبِ الْاِسْلَامِ وَقَمْعِ الْاٰثَامِ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْهَجُوْا عَلَيْكُمْ نَقْعَ الْحُرُوْبِ وَالْفِتَنِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْحَوْا عَلَيْكُمْ سُيُوْفَ الْاَحْقَادِ"
    },
    {
      "kind": "text",
      "ar": "وَهَتَكُوْا مِنْكُمُ السُّتُوْرَ وَابْتَاعُوْا بِخُمْسِكُمُ الْخُمُوْرَ"
    },
    {
      "kind": "text",
      "ar": "وَصَرَفُوْا صَدَقَاتِ الْمَسَاكِيْنِ اِلَي الْمُضْحِكِيْنَ وَالسَّاخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَذٰلِكَ بِمَا طَرَّقَتْ لَهُمُ الْفَسَقَةُ الْغُوَاةُ وَالْحَسَدَةُ الْبُغَاةُ"
    },
    {
      "kind": "text",
      "ar": "أَهْلُ النَّكْثِ وَالْغَدْرِ وَالْخِلَافِ وَالْمَكْرِ"
    },
    {
      "kind": "text",
      "ar": "وَالْقُلُوْبِ الْمُنْتِنَةِ مِنْ قَذَرِ الشِّرْكِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَجْسَادِ الْمُشْحَنَةِ مِنْ دَرَنِ الْكُفْرِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ أَضَبُّوْا عَلَي النِّفَاقِ وَأَكَبُّوْا عَلٰي عَلَائِقِ الشِّقَاقِ"
    },
    {
      "kind": "text",
      "ar": "فَلَمَّا مَضَي الْمُصْطَفٰي صَلَوَات اللهِ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "اخْتَطَفُوا الْغِرَّةَ وَانْتَهَزُوا الْفُرْصَةَ"
    },
    {
      "kind": "text",
      "ar": "وَانْتَهَكُوا الْحُرْمَةَ وَغَادَرُوْهُ عَلٰي فِرَاشِ الْوَفَاةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْرَعُوْا لِنَقْضِ الْبَيْعَةِ وَمُخَالَفَةِ الْمَوَاثِيْقِ الْمُؤَكَّدَةِ"
    },
    {
      "kind": "text",
      "ar": "وَخِيَانَةِ الْاَمَانَةِ الْمَعْرُوْضَةِ عَلَي الْجِبَالِ الرَّاسِيَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَبَتْ أَنْ تَحْمِلَهَا وَحَمَلَهَا الْاِنْسَانُ الظَّلُوْمُ الْجَهُوْلُ"
    },
    {
      "kind": "text",
      "ar": "ذُوالشِّقَاقِ وَالْعِزَّةِ  بِالْاٰثَامِ الْمُؤْلِمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَنَفَةِ عَنِ الْاِنْقِيَادِ لِحَمِيْدِ الْعَاقِبَةِ"
    },
    {
      "kind": "text",
      "ar": "فَحُشِرَ سفْلَةُ الْاَعْرَابِ وَبَقَايَا الْاَحْزَابِ"
    },
    {
      "kind": "text",
      "ar": "اِلٰي دَارِ النُّبُوَّةِ وَالرِّسَالَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمَهْبِطِ الْوَحْيِ وَالْمَلَائِكَةِ وَمُسْتَقَرِّ سُلْطَانِ الْوِلَايَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمَعْدِنِ الْوَصِيَّةِ وَالْخِلَافَةِ وَالْاِمَامَةِ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي نَقَضُوْا عَهْدَ الْمُصْطَفَي فِيْ أَخِيْهِ"
    },
    {
      "kind": "text",
      "ar": "عَلَمِ الْهُدٰي وَالْمُبَيِّنِ طَرِيْقَ النَّجَاةِ مِنْ طُرُقِ الرَّدٰي"
    },
    {
      "kind": "text",
      "ar": "وَجَرَحُوْا كَبِدَ خَيْرِ الْوَرٰي فِيْ ظُلْمِ ابْنَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاضْطِهَادِ حَبِيْبَتِهٖ وَاهْتِضَامِ عَزِيْزَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "بَضْعَةِ لَحْمِهٖ وَفِلْذَةِ كَبِدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَخَذَلُوْا بَعْلَهَا وَصَغَّرُوْا قَدْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَحَلُّوْا مَحَارِمَهٗ وَقَطَعُوْا رَحِمَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْكَرُوْا أُخُوَّتَهٗ وَهَجَرُوْا مَوَدَّتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَنَقَضُوْا طَاعَتَهٗ وَجَحَدُوْا وِلَايَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَطْمَعُوْا الْعَبِيْدَ فِيْ خِلَافَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَقَادُوْهُ اِلٰي بَيْعَتِهِمْ مُصْلِتَةً سُيُوْفَهَا مُشْرِعَةً أَسِنَّتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ سَاخِطُ الْقَلْبِ هَائِجُ الْغَضَبِ"
    },
    {
      "kind": "text",
      "ar": "شَدِيْدُ الصَّبْرِ كَاظِمُ الْغَيْظِ"
    },
    {
      "kind": "text",
      "ar": "يَدْعُوْنَهٗ اِلٰي بَيْعَتِهِمُ الَّتِيْ عَمَّ شُؤْمُهَا الْاِسْلَامَ"
    },
    {
      "kind": "text",
      "ar": "وَزَرَعَتْ فِيْ قُلُوْبِ أَهْلِهَا الْاٰثَامَ"
    },
    {
      "kind": "text",
      "ar": "وَعَقَّتْ سَلْمَانَهَا وَطَرَدَتْ مِقْدَادَهَا"
    },
    {
      "kind": "text",
      "ar": "وَنَفَتْ جُنْدُبَهَا وَفَتَقَتْ بَطْنَ عَمَّارِهَا"
    },
    {
      "kind": "text",
      "ar": "وَحَرَّفَتِ الْقُرْاٰنَ وَبَدَّلَتِ الْاَحْكَامَ"
    },
    {
      "kind": "text",
      "ar": "وَغَيَّرَتِ الْمَقَامَ وَأَبَاحَتِ الْخُمْسَ لِلطُّلَقَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَّطَتْ أَوْلَادَ اللُّعَنَاءِ عَلَي الْفُرُوْجِ وَالدِّمَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَخَلَطَتِ الْحَلَالَ بِالْحَرَامِ، وَاسْتَخَفَّتْ بِالْاِيْمَانِ وَالْاِسْلَامِ"
    },
    {
      "kind": "text",
      "ar": "وَهَدَمَتِ الْكَعْبَةَ وَأَغَارَتْ عَلٰي دَارِ الْهِجْرَةِ يَوْمَ الْحَرَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْرَزَتْ بَنَاتِ الْمُهَاجِرِيْنَ وَالْاَنْصَارِ لِلنَّكَالِ وَالسَّوْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبَسَتْهُنَّ ثَوْبَ الْعَارِ وَالْفَضِيْحَةِ"
    },
    {
      "kind": "text",
      "ar": "وَرَخَّصَتْ لِاَهْلِ الشُّبْهَةِ فِيْ قَتْلِ أَهْلِ بَيْتِ الصَّفْوَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاِبَادَةِ نَسْلِهٖ وَاسْتِيْصَالِ شَأْفَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَبْيِ حَرَمِهٖ وَقَتْلِ أَنْصَارِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكَسْرِ مِنْبَرِهٖ وَقَلْبِ مَفْخَرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاِخْفَاءِ دِيْنِهٖ وَقَطْعِ ذِكْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوَالِيَّ فَلَوْ عَايَنَكُمُ الْمُصْطَفٰي"
    },
    {
      "kind": "text",
      "ar": "وَسِهَامُ الْأُمَّةِ مُغْرَقَةٌ فِيْ أَكْبَادِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَرِمَاحُهُمْ مُشْرَعَةٌ فِيْ نُحُوْرِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَسُيُوْفُهَا مُوْلَغَةٌ فِيْ دِمَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "يَشْفِيْ أَبْنَاءُ الْعَوَاهِرِ غَلِيْلَ الْفِسْقِ مِنْ وَرَعِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَغَيْظَ الْكُفْرِ مِنْ اِيْمَانِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتُمْ بَيْنَ صَرِيْعٍ فِي الْمِحْرَابِ قَدْ فَلَقَ السَّيْفُ هَامَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَشَهِيْدٍ فَوْقَ الْجَنَازَةِ قَدْ شُكَّتْ أَكْفَانُهٗ بِالسِّهَامِ"
    },
    {
      "kind": "text",
      "ar": "وَقَتِيْلٍ بِالْعَرَاءِ قَدْ رُفِعَ فَوْقَ الْقَنَاةِ رَأْسُهُ"
    },
    {
      "kind": "text",
      "ar": "وَمُكَبَّلٍ فِيَالسِّجْنِ قَدْ رُضَّتْ بِالْحَدِيْدِ أَعْضَاؤُهُ"
    },
    {
      "kind": "text",
      "ar": "وَمَسْمُوْمٍ قَدْ قُطِّعَتْ بِجُرَعِ السَّمِّ أَمْعَاؤُهُ"
    },
    {
      "kind": "text",
      "ar": "وَشَمْلُكُمْ عَبَادِيْدُ تُفْنِيْهِمُ الْعَبِيْدُ وَأَبْنَاءُ الْعَبِيْدِ"
    },
    {
      "kind": "text",
      "ar": "فَهَلِ الْمِحَنُ يَا سَادَتِيْ اِلَّا الَّتِيْ لَزِمَتْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَصَائِبُ اِلَّا الَّتِيْ عَمَّتْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَجَائِعُ اِلَّا الَّتِيْ خَصَّتْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْقَوَارِعُ اِلَّا الَّتِيْ طَرَقَتْكُمْ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْكُمْ وَعَلٰي أَرْوَاحِكُمْ وَأَجْسَادِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتُمْ وَأُمِّيْ يَا اٰلَ الْمُصْطَفَي"
    },
    {
      "kind": "text",
      "ar": "اِنَّا لَا نَمْلِكُ اِلَّا أَنْ نَطُوْفَ حَوْلَ مَشَاهِدِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَنُعَزِّيَ فِيْهَا أَرْوَاحَكُمْ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي هٰذِهِ الْمَصَائِبِ الْعَظِيْمَةِ الْحَالَّةِ بِفِنَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّزَايَا الْجَلِيْلَةِ النَّازِلَةِ بِسَاحَتِكُمُ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ أَثْبَتَتْ فِيْ قُلُوْبِ شِيْعَتِكُمُ الْقُرُوْحَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْرَثَتْ أَكْبَادَهُمُ الْجُرُوْحَ"
    },
    {
      "kind": "text",
      "ar": "وَزَرَعَتْ فِيْ صُدُوْرِهِمُ الْغُصَصَ"
    },
    {
      "kind": "text",
      "ar": "فَنَحْنُ نُشْهِدُ اللهَ أَنَّا قَد شَارَكْنَا أَوْلِيَائَكُمْ وَأَنْصَارَكُمُ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَقَدِّمِيْنَ فِيْ اِرَاقَةِ دِمَاءِ النَّاكِثِيْنَ وَالْقَاسِطِيْنَ وَالْمَارِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَقَتَلَةِ أَبِيْ عَبْدِ اللهِ سَيِّدِ شَبَابِ أَهْلِ الْجَنَّةِ عَلَيْهِ اَلسَّلَامُ يَوْمَ كَرْبَلَاءَ"
    },
    {
      "kind": "text",
      "ar": "بِالنِّيَّاتِ وَالْقُلُوْبِ وَالتَّأَسُّفِ عَلٰي فَوْتِ تِلْكَ الْمَوَاقِفِ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ حَضَرُوْا لِنُصْرَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكُمْ مِنَّا اَلسَّلَامُ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا ذَاالْقُدْرَةِ الَّتِيْ صَدَرَ عَنْهَا الْعَالَمُ"
    },
    {
      "kind": "text",
      "ar": "مُكَوَّنًا مَبْرُوْئًا عَلَيْهَا مَفْطُوْرًا تَحْتَ ظِلِّ الْعَظَمَةِ"
    },
    {
      "kind": "text",
      "ar": "فَنَطَقَتْ شَوَاهِدُ صُنْعِكَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "بِأَنَّكَ أَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "مُكَوِّنُهٗ وَبَارِئُهٗ وَفَاطِرُهُ ابْتَدَعْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "لَا مِنْ شَيْءٍ وَلَا عَلٰي شَيْءٍ وَلَا فِيْ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا لِوَحْشَةٍ دَخَلَتْ عَلَيْكَ اِذْ لَا غَيْرُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَاجَةٍ بَدَتْ لَكَ فِيْ تَكْوِيْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا لِاسْتِعَانَةٍ مِنْكَ عَلَي الْخَلْقِ بَعْدَهٗ"
    },
    {
      "kind": "text",
      "ar": "بَلْ أَنْشَأْتَهٗ لِيَكُوْنَ دَلِيْلًا عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "بِأَنَّكَ بَائِنٌ مِنَ الصُّنْعِ فَلَا يُطِيْقُ الْمُنْصِفُ لِعَقْلِهٖ اِنْكَارَكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَوْسُوْمُ بِصِحَّةِ الْمَعْرِفَةِ جُحُوْدَكَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِشَرَفِ الْاِخْلَاصِ فِيْ تَوْحِيْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحُرْمَةِ التَّعَلُّقِ بِكِتَابِكَ وَأَهْلِ بَيْتِ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي اٰدَمَ بَدِيْعِ فِطْرَتِكَ وَبِكْرِ حُجَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلِسَانِ قُدْرَتِكَ وَالْخَلِيْفَةِ فِيْ بَسِيْطَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مُحَمَّدٍ الْخَالِصِ مِنْ صَفْوَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَاحِصِ عَنْ مَعْرِفَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْغَائِصِ الْمَأْمُوْنِ عَلٰي مَكْنُوْنِ سَرِيْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "بِمَا أَوْلَيْتَهٗ مِنْ نِعْمَتِكَ بِمَعُوْنَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَنْ بَيْنَهُمَا مِنَ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُكَرَّمِيْنَ وَالْاَوْصِيَاءِ وَالصِّدِّيْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَهَبَنِيْ لِاِمَامِيْ هٰذَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِمَحَلِّ هٰذَا السَّيِّدِ مِنْ طَاعَتِكَ وَبِمَنْزِلَتِهٖ عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "لَا تُمِتْنِيْ فُجَائَةً وَلَا تَحْرِمْنِيْ تَوْبَةً"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِي الْوَرَعَ عَنْ مَحَارِمِكَ دِيْنًا وَدُنْيَا"
    },
    {
      "kind": "text",
      "ar": "وَاشْغَلْنِيْ بِالْاٰخِرَةِ عَنْ طَلَبِ الْأُوْلي"
    },
    {
      "kind": "text",
      "ar": "وَوَفِّقْنِيْ لِمَا تُحِبُّ وَتَرْضي"
    },
    {
      "kind": "text",
      "ar": "وَجَنِّبْنِي اتِّبَاعَ الْهَوٰي وَالْاِغْتِرَارَ بِالْاَبَاطِيْلِ وَالْمُنَي۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلِ السَّدَادَ فِيْ قَوْلِيْ وَالصَّوَابَ فِيْ فِعْلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالصِّدْقَ وَالْوَفَاءَ فِيْ ضَمَانِيْ وَوَعْدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْحِفْظَ وَالْاِيْنَاسَ مَقْرُوْنَيْنَ بِعَهْدِيْ وَوَعْدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْبِرَّ وَالْاِحْسَانَ مِنْ شَأْنِيْ وَخُلْقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلِ السَّلَامَةَ لِيْ شَامِلَةً وَالْعَافِيَةَ بِيْ مُحِيْطَةً مُلْتَفَّةً"
    },
    {
      "kind": "text",
      "ar": "وَلَطِيْفَ صُنْعِكَ وَعَوْنِكَ مَصْرُوْفًا اِلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَحُسْنَ تَوْفِيْقِكَ وَيُسْرِكَ مَوْفُوْرًا عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْيِنِيْ يَارَبِّ سَعِيْدًا وَتَوَفَّنِيْ شَهِيْدًا"
    },
    {
      "kind": "text",
      "ar": "وَطَهِّرْنِيْ لِلْمَوْتِ وَمَا بَعْدَهُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاجْعَلِ الصِّحَّةَ وَالنُّوْرَ فِيْ سَمْعِيْ وَبَصَرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْجِدَةَ وَالْخَيْرَ فِيْ طُرُقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْهُدي وَالْبَصِيْرَةَ فِيْ دِيْنِيْ وَمَذْهَبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْمِيْزَانَ أَبَدًا نَصْبَ عَيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالذِّكْرَ وَالْمَوْعِظَةَ شِعَارِيْ وَدِثَارِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْفِكْرَةَ وَالْعِبْرَةَ أُنْسِيْ وَعِمَادِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمَكِّنِ الْيَقِيْنَ فِيْ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ أَوْثَقَ الْاَشْيَاءِ فِيْ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاغْلِبْهُ عَلٰي رَأْئِيْ وَعَزْمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلِ الْاِرشَادَ فِيْ عَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّسْلِيْمَ لِاَمْرِكَ مِهَادِيْ وَسَنَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالرِّضَا بِقَضَائِكَ وَقَدَرِك أَقْصٰي عَزْمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَنِهَايَتِيْ وَأَبْعَدَ هَمِّيْ وَغَايَتِيْ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَاَ أَتَّقِيَ أَحَدًا مِنْ خَلْقِكَ بِدِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَطْلُبَ بِهٖ غَيْرَ اٰخِرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَسْتَدْعِيَ مِنْهُ اِطْرَائِيْ وَمَدْحِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ خَيْرَ الْعَوَاقِبِ عَاقِبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَخَيْرَ الْمَصَايِرِ مَصِيْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْعَمَ الْعَيْشِ عَيْشِيْ وَأَفْضَلَ الْهُدٰي هُدَايَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْفَرَ الْحُظُوْظِ حَظِّيْ وَأَجْزَلَ الْاَقْسَامِ قِسْمِيْ وَنَصِيْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَكُنْ لِيْ يَارَبِّ مِنْ كُلِّ سُوْءٍ وَلِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَاِلٰي كُلِّ خَيْرٍ دَلِيْلًا وَقَائِدًا"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كُلِّ بَاغٍ وَحَسُوْدٍ ظَهِيْرًا وَمَانِعًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِكَ اعْتِدَادِيْ وَعِصْمَتِيْ وَثِقَتِيْ وَتَوْفِيْقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَحَوْلِيْ وَقُوَّتِيْ وَلَكَ مَحْيَايَ وَمَمَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ قَبْضَتِكَ سُكُوْنِيْ وَحَرَكَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّ بِعُرْوَتِكَ الْوُثْقٰي اسْتِمْسَاكِيْ وَوُصْلَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ فِي الْأُمُوْرِ كُلِّهَا اعْتِمَادِيْ وَتَوَكُّلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ عَذَابِ جَهَنَّمَ وَمَسِّ سَقَرَ نَجَاتِيْ وَخَلَاصِيْ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ دَارِ أَمْنِكَ وَكَرَامَتِكَ مَثْوَايَ وَمُنْقَلَبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَيْدِيْ سَادَتِيْ وَمَوَالِيَّ اٰلِ الْمُصْطَفَي فَوْزِيْ وَفَرَجِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لِلْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ وَالْمُسْلِمِيْنَ وَالْمُسْلِمَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لِيْ وَلِوَالِدَيَّ وَمَا وَلَدَا وَأَهْلِ بَيْتِيْ وَجِيْرَانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلِكُلِّ مَنْ قَلَّدَنِيْ يَدًا مِنَ الْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ ذُوْفَضْلٍ عَظِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّلَامُ عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُه"
    }
  ]
}