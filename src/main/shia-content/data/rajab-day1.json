{
  "id": "rajab-day1",
  "title": "رجب كا پهلا دن",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "رجب كا پهلا دن",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا الله وَحْدَه، لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "لَهُ الْمُلكُ وَلَهُ الْحَمْدُ"
    },
    {
      "kind": "text",
      "ar": "يُحْيِيْ وَيُمِيْتُ، وَهُوَ حَيٌّ لَّا يَموتُ"
    },
    {
      "kind": "text",
      "ar": "بِيَدهِ الْخَيْرُ وَهُوَ عَلٰي كُلِّ شئٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا مَانِعَ لِمَا اَعطَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُعْطِيْ لِمَا مُنِعَتْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُنْفَعُ ذَا الْجَدِّ مِنْكَ الْجَدِّ"
    },
    {
      "kind": "text",
      "ar": "اِلَهًا وَّاحدًا اَحَدًا فَرْدًا صَمَدًا"
    },
    {
      "kind": "text",
      "ar": "لَّمْ يَتَّخِذْ صَاحِبَةً وَّ لَا وَلَدًا"
    },
    {
      "kind": "text",
      "ar": "وَصَلَي اللهُ عَلٰي مُحمَّدٍ وَاٰلِهِ الطَاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ۔"
    }
  ]
}