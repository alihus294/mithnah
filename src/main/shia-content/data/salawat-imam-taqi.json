{
  "id": "salawat-imam-taqi",
  "title": "امام محمد تقي پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام محمد تقي پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدِ بْنِ عَلِيِّ بْنِ مُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "عَلَمِ التُّقٰي، وَنُوْرِ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَمَعْدِنِ الْوَفَاءِ، وَفَرْعِ الْاَزْكِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَخَلِيْفَةِ الْاَوْصِيَاءِ، وَأَمِيْنِكَ عَلٰي وَحْيِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَكَمَا هَدَيْتَ بِهٖ مِنَ الضَّلَالَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَنْقَذْتَ بِهٖ مِنَ الْحَيْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْشَدْتَ بِهٖ مَنِ اهْتَدٰي"
    },
    {
      "kind": "text",
      "ar": "وَزَكَّيْتَ بِهٖ مَنْ تَزَكّٰي"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِ أَفْضَلَ مَا صَلَّيْتَ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي أَحَدٍ مِنْ أَوْلِيَائِكَ وَبَقِيَّةِ أَوْصِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَزِيْزٌ حَكِيْمٌ۔"
    }
  ]
}