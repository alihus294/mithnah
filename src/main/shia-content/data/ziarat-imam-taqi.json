{
  "id": "ziarat-imam-taqi",
  "title": "امام محمد تقي كي مخصوص زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام محمد تقي كي مخصوص زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نُوْرَ اللهِ فِيْ ظُلُمَاتِ الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ وَعَلٰي اٰبَائِكَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ وَعَلٰي أَبْنَائِكَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ وَعَلٰي أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ أَقَمْتَ الصَّلَاةَ، وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ، وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَتَلَوْتَ الْكِتَابَ حَقَّ تِلَاوَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِي اللهِ حَقَّ جِهَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتَ عَلَي الْاَذٰي فِيْ جَنْبِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ زَائِرًا، عَارِفًا بِحَقِّكَ"
    },
    {
      "kind": "text",
      "ar": "مُوَالِيًا لِاَوْلِيَائِكَ، مُعَادِيًا لِاَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ عِنْدَ رَبِّكَ۔"
    },
    {
      "kind": "text",
      "ar": "اِرْحَمْ مَنْ اَسَاءَ وَاقْتَرَفَ، وَاسْتَكَانَ وَاعْتَرَفَ"
    },
    {
      "kind": "text",
      "ar": "اِنْ كُنْتُ بِئْسَ الْعَبْدُ فَاَنْتَ نِعْمَ الرَّبُّ"
    },
    {
      "kind": "text",
      "ar": "عَظُمَ الذَّنْبُ مِنْ عَبْدِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلْيَحْسُنِ الْعَفْوُ مِنْ عِنْدِكَ يَاكَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "شُكْرًا شُكْرًا"
    }
  ]
}