  "slides": [
    { "kind": "title", "ar": "مناجاة أمير المؤمنين في مسجد الكوفة", "subtitle": "للإمام علي عليه السلام" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "اللَّهُمَّ إِنِّي أَسْأَلُكَ الأَمانَ" },
    { "kind": "text", "ar": "يَوْمَ لا يَنْفَعُ مالٌ وَلا بَنُونَ" },
    { "kind": "text", "ar": "إِلَّا مَنْ أَتَىٰ اللهَ بِقَلْبٍ سَلِيمٍ" },
    { "kind": "text", "ar": "وَأَسْأَلُكَ الأَمانَ يَوْمَ يَعَضُّ الظَّالِمُ عَلَىٰ يَدَيْهِ" },
    { "kind": "text", "ar": "يَقُولُ: يا لَيْتَنِي اتَّخَذْتُ مَعَ الرَّسُولِ سَبِيلاً" },
    { "kind": "text", "ar": "وَأَسْأَلُكَ الأَمانَ يَوْمَ يُعْرَفُ المُجْرِمُونَ بِسِيماهُمْ" },
    { "kind": "text", "ar": "فَيُؤْخَذُ بِالنَّواصِي وَالأَقْدامِ" },
    { "kind": "text", "ar": "وَأَسْأَلُكَ الأَمانَ يَوْمَ لا يَجْزِي والِدٌ عَنْ وَلَدِهِ" },
    { "kind": "text", "ar": "وَلا مَوْلُودٌ هُوَ جازٍ عَنْ والِدِهِ شَيْئاً" },
    { "kind": "text", "ar": "إِنَّ وَعْدَ اللهِ حَقٌّ" },
    { "kind": "text", "ar": "وَأَسْأَلُكَ الأَمانَ يَوْمَ لا يَنْفَعُ الظَّالِمِينَ مَعْذِرَتُهُمْ" },
    { "kind": "text", "ar": "وَلَهُمُ اللَّعْنَةُ وَلَهُمْ سُوءُ الدَّارِ" },
