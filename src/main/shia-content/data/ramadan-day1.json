{
  "id": "ramadan-day1",
  "title": "پهلي رمضان كادن",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "پهلي رمضان كادن",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ قَدْ حَضَرَ شَهْرُ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدِ افْتَرَضْتَ عَلَيْنَا صِيَامَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزَلْتَ فِيْهِ الْقُرْاٰنَ هُدًى لِلنّاسِ"
    },
    {
      "kind": "text",
      "ar": "وَبَيِّنَاتٍ مِنَ الْهُدٰي وَالْفُرْقَانِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعِنَّا عَلٰي صِيَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتَقَبَّلْهُ مِنّا، وَتَسَلَّمْهُ مِنّا"
    },
    {
      "kind": "text",
      "ar": "وَسَلِّمْهُ لَنَا فِيْ يُسْرٍ مِنْكَ وَعَافِيَةٍ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِاسْمِكَ الَّذِيْ دَانَ لَهٗ كُلُّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِرَحْمَتِكَ الَّتِيْ وَسِعَتْ كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِعَظَمَتِكَ الَّتِيْ تَوَاضَعَ لَهَا كُلُّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِعِزَّتِكَ الَّتِيْ قَهَرَتْ كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِقُوَّتِكَ الَّتِيْ خَضَعَ لَهَا كُلُّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِجَبَرُوْتِكَ الَّتِيْ غَلَبَتْ كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَبِعِلْمِكَ الَّذِيْ أَحَاطَ بِكُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "يَا نُوْرُ يَا قُدُّوْسُ"
    },
    {
      "kind": "text",
      "ar": "يَا أَوَّلُ قَبْلَ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَا بَاقِيًا بَعْدَ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا رَحْمٰنُ، صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تُغَيِّرُ النِّعَمَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تُنْزِلُ النِّقَمَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تَقْطَعُ الرَّجَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تُدِيْلُ الْاَعْدَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تَرُدُّ الدُّعَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ يُسْتَحَقُّ بِهَا نُزُوْلُ الْبَلَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تَحْبِسُ غَيْثَ السَّمَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تَكْشِفُ الْغِطَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تُعَجِّلُ الْفَنَاءَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تُوْرِثُ النَّدَمَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيَ الذُّنُوْبَ الَّتِيْ تَهْتِكُ الْعِصَمَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْنِيْ دِرْعَكَ الْحَصِيْنَةَ الَّتِيْ لَا تُرَامُ"
    },
    {
      "kind": "text",
      "ar": "وَعَافِنِيْ مِنْ شَرِّ مَا أُحَاذِرُ"
    },
    {
      "kind": "text",
      "ar": "بِاللَّيْلِ وَالنَّهَارِ فِيْ مُسْتَقْبَلِ سَنَتِيْ هٰذِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّ السَّمَاوَاتِ السَّبْعِ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ الْاَرَضِيْنَ السَّبْعِ وَمَا فِيْهِنَّ وَمَا بَيْنَهُنَّ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ الْعَرْشِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ السَّبْعِ الْمَثَانِيْ وَالْقُرْاٰنِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ اِسْرَافِيْلَ وَمِيْكَائِيْلَ وَجَبْرَائِيْلَ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ مُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدِ الْمُرْسَلِيْنَ وَخَاتَمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِكَ وَبِمَا سَمَّيْتَ بِهٖ نَفْسَكَ"
    },
    {
      "kind": "text",
      "ar": "يَا عَظِيْمُ أَنْتَ الَّذِيْ تَمُنُّ بِالْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَتَدْفَعُ كُلَّ مَحْذُوْرٍ، وَتُعْطِيْ كُلَّ جَزِيْلٍ"
    },
    {
      "kind": "text",
      "ar": "وَتُضَاعِفُ الْحَسَنَاتِ بِالْقَلِيْلِ وَبِالْكَثِيْرِ"
    },
    {
      "kind": "text",
      "ar": "وَتَفْعَلُ مَا تَشَاءُ يَا قَدِيْرُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا رَحْمٰنُ صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْنِيْ فِيْ مُسْتَقْبَلِ سَنَتِيْ هٰذِهٖ سِتْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَضِّرْ وَجْهِيْ بِنُوْرِكَ، وَأَحِبَّنِيْ بِمَحَبَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْنِيْ رِضْوَانَكَ، وَشَرِيْفَ كَرَامَتِكَ، وَجَسِيْمَ عَطِيَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنِيْ مِنْ خَيْرِ مَا عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ خَيْرِ مَا أَنْتَ مُعْطِيْهِ أَحَدًا مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْنِيْ مَعَ ذٰلِكَ عَافِيَتَكَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْضِعَ كُلِّ شَكْوٰي، وَيَا شَاهِدَ كُلِّ نَجْوٰي"
    },
    {
      "kind": "text",
      "ar": "وَيَا عَالِمَ كُلِّ خَفِيَّةٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَا دَافِعَ مَا تَشَاءُ مِنْ بَلِيَّةٍ"
    },
    {
      "kind": "text",
      "ar": "يَا كَرِيْمَ الْعَفْوِ، يَا حَسَنَ التَّجَاوُزِ"
    },
    {
      "kind": "text",
      "ar": "تَوَفَّنِيْ عَلٰي مِلَّةِ اِبْرَاهِيْمَ وَفِطْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي دِيْنِ مُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَسُنَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي خَيْرِ الْوَفَاةِ"
    },
    {
      "kind": "text",
      "ar": "فَتَوَفَّنِيْ مُوَالِيًا لِاَوْلِيَائِكَ، وَمُعَادِيًا لِاَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَجَنِّبْنِيْ فِيْ هٰذِهِ السَّنَةِ"
    },
    {
      "kind": "text",
      "ar": "كُلَّ عَمَلٍ أَوْ قَوْلٍ أَوْ فِعْلٍ يُبَاعِدُنِيْ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْلِبْنِيْ اِلٰي كُلِّ عَمَلٍ أَوْ قَوْلٍ أَوْ فِعْلٍ"
    },
    {
      "kind": "text",
      "ar": "يُقَرِّبُنِيْ مِنْكَ فِيْ هٰذِهِ السَّنَةَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَامْنَعْنِيْ مِنْ كُلِّ عَمَلٍ أَوْ قَوْلٍ أَوْ فِعْلٍ"
    },
    {
      "kind": "text",
      "ar": "يَكُوْنُ مِنِّيْ أَخَافُ ضَرَرَ عَاقِبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَخَافُ مَقْتَكَ اِيَّايَ عَلَيْهِ حِذَارَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَصْرِفَ وَجْهَكَ الْكَرِيْمَ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "فَأَسْتَوْجِبَ بِهٖ نَقْصًا مِنْ حَظٍّ لِيْ عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَؤُوْفُ يَا رَحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ فِيْ مُسْتَقْبَلِ سَنَتِيْ هٰذِهٖ فِيْ حِفْظِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ جِوَارِكَ وَفِيْ كَنَفِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجَلِّلْنِيْ سِتْرَ عَافِيَتِكَ، وَهَبْ لِيْ كَرَامَتَكَ"
    },
    {
      "kind": "text",
      "ar": "عَزَّ جَارُكَ وَجَلَّ ثَنَاؤُكَ، وَلَا اِلٰهَ غَيْرُكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ تَابِعًا لِصَالِحِيْ مَنْ مَضٰي مِنْ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْحِقْنِيْ بِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مُسَلِّمًا لِمَنْ قَالَ بِالصِّدْقِ عَلَيْكَ مِنْهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ اَللّٰهُمَّ أَنْ تُحِيْطَ بِيْ خَطِيْئَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَظُلْمِيْ وَاِسْرَافِيْ عَلٰي نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاتِّبَاعِيْ لِهَوَايَ وَاشْتِغَالِيْ بِشَهَوَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَيَحُوْلُ ذٰلِكَ بَيْنِيْ وَبَيْنَ رَحْمَتِكَ وَرِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَكُوْنُ مَنْسِيًّا عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "مُتَعَرِّضًا لِسَخَطِكَ وَنِقْمَتِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَفِّقْنِيْ لِكُلِّ عَمَلٍ صَالِحٍ تَرْضٰي بِهٖ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَرِّبْنِيْ اِلَيْكَ زُلْفٰي"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ كَمَا كَفَيْتَ نَبِيَّكَ مُحَمَّدًا صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ هَوْلَ عَدُوِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَفَرَّجْتَ هَمَّهٗ، وَكَشَفْتَ غَمَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَصَدَقْتَهٗ وَعْدَكَ، وَأَنْجَزْتَ لَهٗ عَهْدَكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَبِذٰلِكَ فَاكْفِنِيْ هَوْلَ هٰذِهِ السَّنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاٰفَاتِهَا وَأَسْقَامَهَا وَفِتْنَتَهَا وَشُرُوْرَهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَحْزَانَهَا  وَضِيْقَ الْمَعَاشِ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْنِيْ بِرَحْمَتِكَ كَمَالَ الْعَافِيَةِ"
    },
    {
      "kind": "text",
      "ar": "بِتَمَامِ دَوَامِ النِّعْمَةِ عِنْدِيْ اِلٰي مُنْتَهٰي أَجَلِيْ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ سُؤَالَ مَنْ أَسَاءَ وَظَلَمَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَكَانَ وَاعْتَرَفَ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُكَ أَنْ تَغْفِرَ لِيْ مَا مَضٰي مِنَ الذُّنُوْبِ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ حَصَرَتْهَا حَفَظَتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْصَتْهَا كِرَامُ مَلَائِكَتِكَ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَعْصِمَنِيْ اَللّٰهُمَّ مِنَ الذُّنُوْبِ"
    },
    {
      "kind": "text",
      "ar": "فِيْمَا بَقِيَ مِنْ عُمْرِيْ اِلٰي مُنْتَهٰي أَجَلِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا رَحْمٰنُ يَا رَحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنِيْ كُلَّ مَا سَأَلْتُكَ وَرَغِبْتُ اِلَيْكَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ أَمَرْتَنِيْ بِالدُّعَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَتَكَفَّلْتَ لِيْ بِالْاِجَابَةِ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}