  "slides": [
    {
      "kind": "title",
      "ar": "چهٹي زيارت مطلقه",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا رَسُوْلَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا صَفْوَةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَمِيْنَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنِ اصْطَفَاهُ اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَاخْتَصَّهٗ وَاخْتَارَهٗ مِنْ بَرِيَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا خَلِيْلَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "مَا دَجَي اللَّيْلُ وَغَسَقَ وَأَضَاءَ النَّهَارُ وَأَشْرَقَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ مَا صَمَتَ صَامِتٌ وَنَطَقَ نَاطِقٌ"
    },
    {
      "kind": "text",
      "ar": "وَذَرَّ شَارِقٌ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَوْلَانَا أَمِيْرِالْمُؤْمِنِيْنَ عَلِيِّ بْنِ أَبِيْ طَالِبٍ"
    },
    {
      "kind": "text",
      "ar": "صَاحِبِ السَّوَابِقِ وَالْمَنَاقِبِ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّجْدَةِ وَمُبِيْدِ الْكَتَائِبِ"
    },
    {
      "kind": "text",
      "ar": "الشَّدِيْدِ الْبَأْسِ، الْعَظِيْمِ الْمِرَاسِ، الْمَكِيْنِ الْاَسَاسِ"
    },
    {
      "kind": "text",
      "ar": "سَاقِي الْمُؤْمِنِيْنَ بِالْكَأْسِ مِنْ حَوْضِ الرَّسُوْلِ، الْمَكِيْنِ الْاَمِيْنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَاحِبِ النُّهٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْفَضْلِ وَالطَّوَائِلِ وَالْمَكْرُمَاتِ وَالنَّوَائِلِ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي فَارِسِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَيْثِ الْمُوَحِّدِيْنَ، وَقَاتِلِ الْمُشْرِكِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَوَصِيِّ رَسُوْلِ رَبِّ الْعَالَمِيْنَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ أَيَّدَهُ اللهُ بِجَبْرَائِيْلَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعَانَهٗ بِمِيْكَائِيْلَ، وَأَزْلَفَهٗ فِي الدَّارَيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَحَبَاهُ بِكُلِّ مَا تَقِرُّ بِهِ الْعَيْنُ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلَيْهِ وَعَلٰي اٰلِهِ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَوْلَادِهِ الْمُنْتَجَبِيْنَ، وَعَلَي الْاَئِمَّةِ الرَّاشِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ أَمَرُوْا بِالْمَعْرُوْفِ وَنَهَوْا عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَفَرَضُوْا عَلَيْنَا الصَّلٰوَاتِ، وَأَمَرُوْا بِاِيْتَاءِ الزَّكَاةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَرَّفُوْنَا صِيَامَ شَهْرِ رَمَضَانَ، وَقِرَائَةَ الْقُرْاٰنِ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَمِيْرَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَعْسُوْبَ الدِّيْنِ، وَقَائِدَ الْغُرِّ الْمُحَجَّلِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا بَابَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا عَيْنَ اللهِ النَّاظِرَةَ"
    },
    {
      "kind": "text",
      "ar": "وَيَدَهُ الْبَاسِطَةَ، وَأُذُنَهُ الْوَاعِيَةَ، وَحِكْمَتَهُ الْبَالِغَةَ"
    },
    {
      "kind": "text",
      "ar": "وَنِعْمَتَهُ السَّابِغَةَ، ونِقْمَتَهُ الدَّامِغَةَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي قَسِيْمِ الْجَنَّةِ وَالنَّارِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي نِعْمَةِ اللهِ عَلَي الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَنِقْمَتِهٖ عَلَي الْفُجَّارِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي سَيِّدِ الْمُتَّقِيْنَ الْاَخْيَارِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَخِيْ رَسُوْلِ اللهِ وَابْنِ عَمِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَزَوْجِ ابْنَتِهٖ، وَالْمَخْلُوْقِ مِنْ طِيْنَتِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْاَصْلِ الْقَدِيْمِ، وَالْفَرْعِ الْكَرِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الثَّمَرِ الْجَنِيِّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَبِي الْحَسَنِ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي شَجَرَةِ طُوْبٰي، وَسِدْرَةِ الْمُنْتَهٰي۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي اٰدَمَ صَفْوَةِ اللهِ، وَنُوْحٍ نَبِيِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَاِبْرَاهِيْمَ خَلِيْلِ اللهِ، وَمُوْسٰي كَلِيْمِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَعِيْسٰي رُوْحِ اللهِ، وَمُحَمَّدٍ حَبِيْبِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ بَيْنَهُمْ مِنَ النَّبِيِّيْنَ وَالصِّدِّيْقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالشُّهَدَاءِ وَالصَّالِحِيْنَ وَحَسُنَ أُولٰئِكَ رَفِيْقًا۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي نُوْرِ الْاَ نْوَارِ"
    },
    {
      "kind": "text",
      "ar": "وَسَلِيْلِ الْاَطْهَارِ، وَعَنَاصِرِ الْاَخْيَارِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي وَالِدِ الْاَئِمَّةِ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي حَبْلِ اللهِ الْمَتِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَجَنْبِهِ الْمَكِيْنِ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَمِيْنِ اللهِ فِيْ أَرْضِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَخَلِيْفَتِهٖ، وَالْحَاكِمِ بِأَمْرِهٖ، وَالْقَيِّمِ بِدِيْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّاطِقِ بِحِكْمَتِهٖ، وَالْعَامِلِ بِكِتَابِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَخِي الرَّسُوْلِ، وَزَوْجِ الْبَتُوْلِ وَسَيْفِ اللهِ الْمَسْلُوْلِ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي صَاحِبِ الدَّلَالَاتِ، وَالْاٰيَاتِ الْبَاهِرَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُعْجِزَاتِ الْقَاهِرَاتِ، وَالْمُنْجِيْ مِنَ الْهَلَكَاتِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ ذَكَرَهُ اللهُ فِيْ مُحْكَمِ الْاٰيَاتِ"
    },
    {
      "kind": "text",
      "ar": "فَقَالَ تَعَالٰي وَاِنَّهٗ فِيْ أُمِّ الْكِتَابِ لَدَيْنَا لَعَلِيٌّ حَكِيْمٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي اسْمِ اللهِ الرَّضِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَوَجْهِهِ الْمُضِيْءِ وَجَنْبِهِ الْعَلِيِّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي حُجَجِ اللهِ وَأَوْصِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَخَاصَّةِ اللهِ وَأَصْفِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَخَالِصَتِهٖ وَأُمَنَائِهٖ، وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "قَصَدْتُكَ يَا مَوْلَايَ يَا أَمِيْنَ اللهِ وَحُجَّتَهٗ"
    },
    {
      "kind": "text",
      "ar": "زَائِرًا عَارِفًا بِحَقِّكَ"
    },
    {
      "kind": "text",
      "ar": "مُوَالِيًا لِاَوْلِيَائِكَ، مُعَادِيًا لِاَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مُتَقَرِّبًا اِلَي اللهِ بِزِيَارَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ عِنْدَ اللهِ رَبِّيْ وَرَبِّكَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ خَلَاصِ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَقَضَاءِ حَوَائِجِيْ حَوَائِجِ الدُّنْيَا وَالْاٰخِرَةِ۔"
    },
    {
      "kind": "text",
      "ar": "سَلَامُ اللهِ وَسَلَامُ مَلَائِكَتِهِ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسَلَّمِيْنَ لَكَ بِقُلُوْبِهِمْ يَا أَمِيْرَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالنَّاطِقِيْنَ بِفَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالشَّاهِدِيْنَ  عَلٰي أَنَّكَ صَادِقٌ أَمِيْنٌ صِدِّيْقٌ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ طُهْرٌ طَاهِرٌ"
    },
    {
      "kind": "text",
      "ar": "مُطَهَّرٌ مِنْ طُهْرٍ، طَاهِرٍ مُطَهَّرٍ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ لَكَ يَا وَلِيَّ اللهِ وَوَلِيَّ رَسُوْلِهٖ بِالْبَلَاغِ وَالْاَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ جَنْبُ اللهِ وَبَابُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ حَبِيْبُ اللهِ وَوَجْهُهُ الَّذِيْ يُؤْتٰي مِنْهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ سَبِيْلُ اللهِ وَأَنَّكَ عَبْدُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَخُوْ رَسُوْلِهٖ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ مُتَقَرِّبًا اِلَي اللهِ عَزَّ وَجَلَّ بِزِيَارَتِكَ"
    },
    {
      "kind": "text",
      "ar": "رَاغِبًا اِلَيْكَ فِي الشَّفَاعَةِ"
    },
    {
      "kind": "text",
      "ar": "أَبْتَغِيْ بِشَفَاعَتِكَ خَلَاصَ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "مُتَعَوِّذًا بِكَ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "هَارِبًا مِنْ ذُنُوْبِيَ الَّتِي احْتَطَبْتُهَا عَلٰي ظَهْرِيْ"
    },
    {
      "kind": "text",
      "ar": "فَزِعًا اِلَيْكَ رَجَاءَ رَحْمَةِ رَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ أَسْتَشْفِعُ بِكَ يَا مَوْلَايَ  وَأَتَقَرَّبُ بِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلَي اللهِ لِيَقْضِيَ بِكَ حَوَائِجِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ يَا أَمِيْرَ الْمُؤْمِنِيْنَ اِلَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ عَبْدُ اللهِ وَمَوْلَاكَ وَزَائِرُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ عِنْدَ اللهِ الْمَقَامُ الْمَحْمُوْدُ"
    },
    {
      "kind": "text",
      "ar": "وَالْجَاهُ الْعَظِيْمُ وَالشَّأْنُ الْكَبِيْرُ وَالشَّفَاعَةُ الْمَقْبُوْلَةُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي أَمِيْرِ الْمُؤْمِنِيْنَ عَبْدِكَ الْمُرْتَضٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَمِيْنِكَ الْاَوْفٰي، وَعُرْوَتِكَ الْوُثْقٰي"
    },
    {
      "kind": "text",
      "ar": "وَيَدِكَ الْعُلْيَا، وَجَنْبِكَ الْاَعْلٰي"
    },
    {
      "kind": "text",
      "ar": "وَكَلِمَتِكَ الْحُسْنٰي، وَحُجَّتِكَ عَلَي الْوَرٰي"
    },
    {
      "kind": "text",
      "ar": "وَصِدِّيْقِكَ الْاَكْبَرِ، وَسَيِّدِ الْاَوْصِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَرُكْنِ الْاَوْلِيَاءِ، وَعِمَادِ الْاَصْفِيَاءِ"
    },
    {
      "kind": "text",
      "ar": "أَمِيْرِ الْمُؤْمِنِيْنَ، وَيَعْسُوْبِ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَقُدْوَةِ الصَّالِحِيْنَ، وَاِمَامِ الْمُخْلِصِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْمَعْصُوْمِ مِنَ الْخَلَلِ، الْمُهَذَّبِ مِنَ الزَّلَلِ"
    },
    {
      "kind": "text",
      "ar": "الْمُطَهَّرِ مِنَ الْعَيْبِ، الْمُنَزَّهِ مِنَ الرَّيْبِ"
    },
    {
      "kind": "text",
      "ar": "أَخِيْ نَبِيِّكَ، وَوَصِيِّ رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "الْبَائِتِ عَلٰي فِرَاشِهٖ، وَالْمُوَاسِيْ لَهٗ بِنَفْسِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكَاشِفِ الْكَرْبِ عَنْ وَجْهِهٖ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ جَعَلْتَهٗ سَيْفًا لِنُبُوَّتِهٖ وَاٰيَةً لِرِسَالَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَشَاهِدًا عَلٰي أُمَّتِهٖ وَدِلَالَةً عَلٰي حُجَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَحَامِلًا لِرَايَتِهٖ، وَوِقَايَةً لِمُهْجَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَهَادِيًا لِاُمَّتِهٖ، وَيَدًا لِبَأْسِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتَاجًا لِرَأْسِهٖ، وَبَابًا لِسِرِّهٖ، وَمِفْتَاحًا لِظَفَرِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي هَزَمَ جُيُوْشَ الشِّرْكِ بِاِذْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَبَادَ عَسَاكِرَ الْكُفْرِ بِأَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَذَلَ نَفْسَهٗ فِيْ مَرْضَاةِ رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَهَا وَقْفًا عَلٰي طَاعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ اَللّٰهُمَّ عَلَيْهِ صَلَاةً دَائِمَةً بَاقِيَةً۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَالشِّهَابَ الثَّاقِبَ، وَالنُّوْرَ الْعَاقِبَ"
    },
    {
      "kind": "text",
      "ar": "يَا سَلِيْلَ الْاَطَائِبِ، يَا سِرَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ بَيْنِيْ وَبَيْنَ اللهِ تَعَالٰي ذُنُوْبًا قَدْ أَثْقَلَتْ ظَهْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَأْتِيْ عَلَيْهَا اِلَّا رِضَاهُ"
    },
    {
      "kind": "text",
      "ar": "فَبِحَقِّ مَنِ ائْتَمَنَكَ عَلٰي سِرِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَرْعَاكَ أَمْرِ خَلْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "كُنْ لِيْ اِلَي اللهِ شَفِيْعًا"
    },
    {
      "kind": "text",
      "ar": "وَمِنَ النَّارِ مُجِيْرًا وَعَلَي الدَّهْرِ ظَهِيْرًا"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ عَبْدُ اللهِ وَوَلِيُّكَ وَزَائِرُكَ صَلَّي اللهُ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَمِيْرَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْكَ مِنِّيْ سَلَامُ اللهِ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "مَا بَقِيْتُ وَبَقِيَ اللَّيْلُ وَالنَّهَارُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا أَبَا عَبْدِ"
    },
    {
      "kind": "text",
      "ar": "اللهِ اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكُمَا زَائِرًا وَمُتَوَسِّلًا اِلَي اللهِ تَعَالٰي رَبِّيْ وَرَبِّكُمَا"
    },
    {
      "kind": "text",
      "ar": "وَمُتَوَجِّهًا اِلَي اللهِ بِكُمَا"
    },
    {
      "kind": "text",
      "ar": "وَمُسْتَشْفِعًا بِكُمَا اِلَي اللهِ فِيْ حَاجَتِيْ هٰذِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "يَا اَللّٰهُ يَا اَللّٰهُ يَا اَللّٰهُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُجِيْبَ دَعْوَةِ الْمُضْطَرِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَيَا كَاْشِفَ كَرْبِ الْمَكْرُوْبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاصْرِفْنِيْ بِقَضَآءِ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَكِفَايَةِ مَا اَهَمَّنِيْ هَمُّهٗ مِنْ اَمْرِ دُنْيَايَ وَاٰخِرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا اَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا اَمِيْرَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّلَامُ عَلٰي أَبِيْ عَبْدِ اللهِ الْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "مَا بَقِيْتُ وَبَقِيَ اللَّيْلُ وَالنَّهَارُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا جَعَلَهُ اللهُ اٰخِرَ الْعَهْدِ مِنِّيْ لِزِيَارَتِكُمَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا فَرَّقَ اللهُ بَيْنِيْ وَبِيْنَكُمَا۔"
    }
  ]
}