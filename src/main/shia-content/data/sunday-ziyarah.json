{
  "id": "sunday-ziyarah",
  "title": "زيارة يوم الأحد للنبي والأمير",
  "subtitle": "زيارة الرسول ﷺ والإمام علي ع يوم الأحد",
  "source": "مفاتيح الجنان، أعمال أيام الأسبوع",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "زيارة يوم الأحد", "subtitle": "للنبي ﷺ والإمام علي ع" },
    { "kind": "text", "ar": "السَّلامُ عَلَىٰ الشَّجَرَةِ النَّبَوِيَّةِ" },
    { "kind": "text", "ar": "وَالدَّوْحَةِ الهاشِمِيَّةِ" },
    { "kind": "text", "ar": "المُضِيئَةِ المُثْمِرَةِ بِالنُّبُوَّةِ" },
    { "kind": "text", "ar": "المُونِقَةِ بِالإِمامَةِ" },
    { "kind": "text", "ar": "وَعَلَىٰ ضَجِيعَيْكَ آدَمَ وَنُوحٍ عَلَيْهِمَا السَّلامُ" },
    { "kind": "text", "ar": "السَّلامُ عَلَيْكَ وَعَلَىٰ أَهْلِ بَيْتِكَ الطَّيِّبِينَ الطَّاهِرِينَ" },
    { "kind": "text", "ar": "السَّلامُ عَلَيْكَ وَعَلَىٰ المَلائِكَةِ المُحْدِقِينَ بِكَ" },
    { "kind": "text", "ar": "وَالحافِّينَ بِقَبْرِكَ" },
    { "kind": "text", "ar": "يا مَوْلايَ يا أَمِيرَ المُؤْمِنِينَ" },
    { "kind": "text", "ar": "هٰذا يَوْمُ الأَحَدِ، وَهُوَ يَوْمُكَ وَبِاسْمِكَ" },
    { "kind": "text", "ar": "وَأَنا ضَيْفُكَ فِيهِ وَجارُكَ" },
    { "kind": "text", "ar": "فَأَضِفْنِي يا مَوْلايَ وَأَجِرْنِي" },
    { "kind": "text", "ar": "فَإِنَّكَ كَرِيمٌ تُحِبُّ الضِّيافَةَ" },
    { "kind": "text", "ar": "وَمَأْمُورٌ بِالإِجارَةِ" },
    { "kind": "text", "ar": "فَافْعَلْ ما رَغِبْتُ إِلَيْكَ فِيهِ وَرَجَوْتُهُ مِنْكَ" },
    { "kind": "text", "ar": "بِمَنْزِلَتِكَ وَآلِ بَيْتِكَ عِنْدَ اللهِ" },
    { "kind": "text", "ar": "وَمَنْزِلَتِهِ عِنْدَكُمْ" },
    { "kind": "text", "ar": "وَبِحَقِّ ابْنِ عَمِّكَ رَسُولِ اللهِ ﷺ" },
    { "kind": "text", "ar": "وَعَلَيْهِمْ أَجْمَعِينَ" }
  ]
}
