{
  "id": "rajab-regular-dua",
  "title": "هر نماز كے بعد كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "هر نماز كے بعد كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ أَرْجُوْهُ لِكُلِّ خَيْرٍ"
    },
    {
      "kind": "text",
      "ar": "وَاٰمَنُ سَخَطَهٗ عِنْدَ كُلِّ شَرٍّ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يُعْطِي الْكَثِيْرَ بِالْقَلِيْلِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يُعْطِيْ مَنْ سَأَلَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يُعْطِيْ مَنْ لَمْ يَسْأَلْهُ وَمَنْ لَمْ يَعْرِفْهُ"
    },
    {
      "kind": "text",
      "ar": "تَحَنُّنًا مِنْهُ وَرَحْمَةً"
    },
    {
      "kind": "text",
      "ar": "أَعْطِنِيْ بِمَسْأَلَتِيْ اِيَّاكَ"
    },
    {
      "kind": "text",
      "ar": "جَمِيْعَ خَيْرِ الدُّنْيَا وَجَمِيْعَ خَيْرِ الْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاصْرِفْ عَنِّيْ بِمَسْأَلَتِيْ اِيَّاكَ"
    },
    {
      "kind": "text",
      "ar": "جَمِيْعَ شَرِّ الدُّنْيَا وَشَرِّ الْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ غَيْرُ مَنْقُوْصٍ مَا أَعْطَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَزِدْنِيْ مِنْ فَضْلِكَ يَا كَرِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "يَا ذَاالْجَلَالِ وَالْاِكْرَامِ"
    },
    {
      "kind": "text",
      "ar": "يَا ذَاالنَّعْمَاءِ وَالْجُوْدِ"
    },
    {
      "kind": "text",
      "ar": "يَا ذَاالْمَنِّ وَالطَّوْلِ"
    },
    {
      "kind": "text",
      "ar": "حَرِّمْ شَيْبَتِيْ عَلَي النَّارِ۔"
    }
  ]
}