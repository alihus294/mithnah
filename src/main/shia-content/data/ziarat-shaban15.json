{
  "id": "ziarat-shaban15",
  "title": "زيارتِ امام حسين پندره شعبان",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارتِ امام حسين پندره شعبان",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الْعَلِيِّ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكَ أَيُّهَا الْعَبْدُ الصَّالِحُ الزَّكِيُّ"
    },
    {
      "kind": "text",
      "ar": "أُوْدِعُكَ شَهَادَةً مِنِّيْ لَكَ"
    },
    {
      "kind": "text",
      "ar": "تُقَرِّبُنِيْ اِلَيْكَ فِيْ يَوْمِ شَفَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قُتِلْتَ وَلَمْ تَمُتْ"
    },
    {
      "kind": "text",
      "ar": "بَلْ بِرَجَاءِ حَيَاتِكَ حَيِيَتْ قُلُوْبُ شِيْعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبِضِيَاءِ نُوْرِكَ اهْتَدَي الطَّالِبُوْنَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ نُوْرُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَمْ يُطْفَأْ وَلَا يُطْفَأُ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ وَجْهُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَمْ يَهْلِكْ وَلَا يُهْلَكُ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ هٰذِهِ التُّرْبَةَ تُرْبَتُكَ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذَا الْحَرَمَ حَرَمُكَ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذَاالْمَصْرَعَ مَصْرَعُ بَدَنِكَ"
    },
    {
      "kind": "text",
      "ar": "لَا ذَلِيْلَ وَاللهِ مُعِزُّكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مَغْلُوْبَ وَاللهِ نَاصِرُكَ"
    },
    {
      "kind": "text",
      "ar": "هٰذِهِ شَهَادَةٌ لِيْ عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰي يَوْمِ قَبْضِ رُوْحِيْ بِحَضْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    }
  ]
}