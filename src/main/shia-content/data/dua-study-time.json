{
  "id": "dua-study-time",
  "title": "انيسواں امر۔ وقتِ مطالعه كي دعا",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "انيسواں امر۔ وقتِ مطالعه كي دعا",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَخْرِجْنِيْ مِنْ ظُلُمَاتِ الْوَهْمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَكرِمْنِيْ بِنُوْرِ الْفَهْمِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ افْتَحْ عَلَيْنَا أَبْوَابَ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَانْشُرْ عَلَيْنَا خَزَائِنَ عُلُوْمِكَ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}