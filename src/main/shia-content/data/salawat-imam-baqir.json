{
  "id": "salawat-imam-baqir",
  "title": "امام محمد باقر پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام محمد باقر پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدِ بْنِ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "بَاقِرِ الْعِلْمِ، وَاِمَامِ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَقَائِدِ أَهْلِ التَّقْوٰي، وَالْمُنْتَجَبِ مِنْ عِبَادِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَكَمَا جَعَلْتَهٗ عَلَمًا لِعِبَادِكَ، وَمَنَارًا لِبِلَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمُسْتَوْدَعًا لِحِكْمَتِكَ، وَمُتَرْجِمًا لِوَحْيِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِطَاعَتِهٖ، وَحَذَّرْتَ مِنْ مَعْصِيَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِ يَا رَبِّ أَفْضَلَ مَا صَلَّيْتَ عَلٰي أَحَدٍ مِنْ ذُرِّيَّةِ أَنْبِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْفِيَائِكَ وَرُسُلِكَ وَأُمَنَائِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبَّ الْعَالَمِيْنَ۔"
    }
  ]
}