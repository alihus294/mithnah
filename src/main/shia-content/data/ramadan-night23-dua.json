{
  "id": "ramadan-night23-dua",
  "title": "تئيسويں شب كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تئيسويں شب كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا رَبَّ لَيْلَةِ الْقَدْرِ وَجَاعِلَهَا خَيْرًا مِنْ أَلْفِ شَهْرٍ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَّ اللَّيْلِ وَالنَّهَارِ وَالْجِبَالِ وَالْبِحَارِ"
    },
    {
      "kind": "text",
      "ar": "وَالظُّلَمِ وَالْاَنْوَارِ وَالْاَرْضِ وَالسَّمَاءِ"
    },
    {
      "kind": "text",
      "ar": "يَا بَارِئُ يَا مُصَوِّرُ يَا حَنَّانُ يَا مَنَّانُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا رَحْمٰنُ يَا اللهُ يَا قَيُّوْمُ يَا اللهُ يَا بَدِيْعُ"
    },
    {
      "kind": "text",
      "ar": "يَا اللهُ يَا اللهُ يَا اللّهُ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْاَسْمَاءُ الْحُسْنٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْاَمْثَالُ الْعُلْيَا، وَالْكِبْرِيَاءُ وَالْاٰلَاءُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ اسْمِيْ فِيْ هٰذِهِ اللَّيْلَةِ فِي السُّعَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَرُوْحِيْ مَعَ الشُّهَدَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَاِحْسَانِيْ فِيْ عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِسَائَتِيْ مَغْفُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَهَبَ لِيْ يَقِيْنًا تُبَاشِرُ بِهٖ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِيْمَانًا يُذْهِبُ الشَّكَّ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُرْضِيَنِيْ بِمَا قَسَمْتَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا فِي الدُّنْيَا حَسَنَةً، وَفِي الْاٰخِرَةِ حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِنَا عَذَابَ النَّارِ الْحَرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ فِيْهَا ذِكْرَكَ وَشُكْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّغْبَةَ اِلَيْكَ وَالْاِنَابَةَ وَالتَّوْبَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّوْفِيْقَ لِمَا وَفَّقْتَ لَهٗ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْهِمُ السَّلَامُ۔"
    },
    {
      "kind": "text",
      "ar": "اَلَّلهُمَّ كُنْ لِّوَلِيِّكَ فلان بن فلان"
    },
    {
      "kind": "text",
      "ar": "الْحُجَّةِ بنِ الْحَسَنِ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُكَ عَلَيْهِ وَعَلٰي اٰبَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "فِيْ هٰذِهِ السَّاعَةِ وَفِي كُلِّ سَاعَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَلِيًّا وَحَافِظًا وَقَائِدًا"
    },
    {
      "kind": "text",
      "ar": "وَنَاصِرًا وَدَلِيْلًا وَعَيْنًا"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تُسْكِنَهٗ أَرْضَكَ طَوْعًا"
    },
    {
      "kind": "text",
      "ar": "وَتُمَتِّعَهٗ فِيْهَا طَوِيْلًا"
    },
    {
      "kind": "text",
      "ar": "يَا مُدَبِّرَ الْاُمُوْرِ، يَا بَاعِثَ مَنْ فِي الْقُبُوْرِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُجْرِيَ الْبُحُوْرِ، يَا مُلَيِّنَ الْحَدِيْدِ لِدَاوُوْدَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلَ مُحَمَّدٍ وَافْعَلَ بِيْ كَذَا وَكَذَا"
    },
    {
      "kind": "text",
      "ar": "اَللَّيْلَةُ اَللَّيْلَةُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُدَبِّرَ الْاُمُوْرِ"
    }
  ]
}