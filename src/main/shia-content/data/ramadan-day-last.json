{
  "id": "ramadan-day-last",
  "title": "تيسويں رمضان كا دن",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تيسويں رمضان كا دن",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اشْرَحْ بِالْقُرْاٰنِ صَدْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَعْمِلْ بِالْقُرْاٰنِ بَدَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَنَوِّرْ بِالْقُرْاٰنِ بَصَرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَطْلِقْ بِالْقُرْاٰنِ لِسَانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِنِّيْ عَلَيْهِ مَا أَبْقَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ لَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ اِخْبَاتَ الْمُخْبِتِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِخْلَاصَ الْمُوْقِنِيْنَ، وَمُرَافَقَةَ الْاَ بْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتِحْقَاقَ حَقَائِقِ الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَالْغَنِيْمَةَ مِنْ كُلِّ بِرٍّ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّلَامَةَ مِنْ كُلِّ اِثْمٍ"
    },
    {
      "kind": "text",
      "ar": "وَوُجُوْبَ رَحْمَتِكَ، وَعَزَائِمَ مَغْفِرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَوْزَ بِالْجَنَّةِ، وَالنَّجَاةَ مِنَ النّارِ"
    }
  ]
}