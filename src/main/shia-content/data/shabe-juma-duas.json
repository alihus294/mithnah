{
  "id": "shabe-juma-duas",
  "title": "شب جمعه كي دعائيں",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "شب جمعه كي دعائيں",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِوَجْهِكَ الْكَرِيْمِ، وَاسْمِكَ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَغْفِرَ لِيْ ذَنْبِيَ الْعَظِيْمَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ رَبِّيْ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "خَلَقْتَنِيْ وَأَنَا عَبْدُكَ وَابْنُ أَمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ قَبْضَتِكَ وَنَاصِيَتِيْ بِيَدِكَ"
    },
    {
      "kind": "text",
      "ar": "أَمْسَيْتُ عَلٰي عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِرِضَاكَ مِنْ شَرِّ مَا صَنَعْتُ"
    },
    {
      "kind": "text",
      "ar": "أَبُوْءُ بِنِعْمَتِكَ، وَأَبُوْءُ بِذَنْبِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاغْفِرْ لِيْ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ لَا يَغْفِرُ الذُّنُوْبَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَنْ تَعَبَّأَ وَتَهَيَّأَ وَأَعَدَّ وَاسْتَعَدَّ لِوِفَادَةٍ اِلٰي مَخْلُوْقٍ"
    },
    {
      "kind": "text",
      "ar": "رَجَاءَ رِفْدِهٖ وَطَلَبَ نَائِلِهٖ وَجَائِزَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَاِلَيْكَ يَا رَبِّ تَعْبِيَتِيْ وَاسْتِعْدَادِيْ"
    },
    {
      "kind": "text",
      "ar": "رَجَاءَ عَفْوِكَ وَطَلَبَ نَائِلِكَ وَجَائِزَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تُخَيِّبْ دُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يَخِيْبُ عَلَيْهِ سَائِلٌ، وَلَا يَنْقُصُهٗ نَائِلٌ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ لَمْ اٰتِكَ ثِقَةً بِعَمَلٍ صَالِحٍ عَمِلْتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا لِوَفَادَةِ مَخْلُوْقٍ رَجَوْتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ مُقِرًّا عَلٰي نَفْسِيْ بِالْاِسَائَةِ وَالظُّلْمِ"
    },
    {
      "kind": "text",
      "ar": "مُعْتَرِفًا بِأَنْ لَا حُجَّةَ لِيْ وَلَا عُذْرَ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ أَرْجُوْ عَظِيْمَ عَفْوِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ عَفَوْتَ بِهٖ عَنِ الْخَاطِئِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَلَمْ يَمْنَعْكَ طُوْلُ عُكُوْفِهِمْ عَلٰي عَظِيْمِ الْجُرْمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ عُدْتَ عَلَيْهِمْ بِالرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "فَيَا مَنْ رَحْمَتُهٗ وَاسِعَةٌ، وَعَفْوُهٗ عَظِيْمٌ"
    },
    {
      "kind": "text",
      "ar": "يَا عَظِيْمُ يَا عَظِيْمُ يَا عَظِيْمُ"
    },
    {
      "kind": "text",
      "ar": "لَا يَرُدُّ غَضَبَكَ اِلَّا حِلْمُكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُنْجِيْ مِنْ سَخَطِكَ اِلَّا التَّضَرُّعُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَهَبْ لِيْ يَا اِلٰهِيْ فَرَجًا بِالْقُدْرَةِ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ تُحْيِيْ بِهَا مَيْتَ الْبِلَادِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُهْلِكْنِيْ غَمًّا حَتّٰي تَستَجِيْبَ لِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُعَرِّفَنِي الْاِجَابَةَ فِيْ دُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَذِقْنِيْ طَعْمَ الْعَافِيَةِ اِلٰي مُنْتَهٰي أَجَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُشْمِتْ بِيْ عَدُوِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُسَلِّطْهُ عَلَيَّ، وَلَا تُمَكِّنْهُ مِنْ عُنُقِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنْ وَضَعْتَنِيْ فَمَنْ ذَا الَّذِيْ يَرْفَعُنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ رَفَعْتَنِيْ فَمَنْ ذَا الَّذِيْ يَضَعُنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ أَهْلَكْتَنِيْ فَمَنْ ذَا الَّذِيْ يَعْرِضُ لَكَ فِيْ عَبْدِكَ"
    },
    {
      "kind": "text",
      "ar": "أَوْ يَسْأَلُكَ عَنْ أَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ عَلِمْتُ أَنَّهٗ لَيْسَ فِيْ حُكْمِكَ ظُلْمٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا فِيْ نَقِمَتِكَ عَجَلَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّمَا يَعْجَلُ مَنْ يَخَافُ الْفَوْتَ"
    },
    {
      "kind": "text",
      "ar": "وَاِنَّمَا يَحْتَاجُ اِلَي الظُّلْمِ الضَّعِيْفُ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ تَعَالَيْتَ يَا اِلٰهِيْ عَنْ ذٰلِكَ عُلُوًّا كَبِيْرًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَعُوْذُ بِكَ فَأَعِذْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَجِيْرُ بِكَ فَأَجِرْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَرْزِقُكَ فَارْزُقْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَكَّلُ عَلَيْكَ فَاكْفِنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَنْصِرُكَ عَلٰي عَدُوِّيْ فَانْصُرْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَعِيْنُ بِكَ فَأَعِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَغْفِرُكَ يَا اِلٰهِيْ فَاغْفِرْ لِيْ"
    },
    {
      "kind": "text",
      "ar": "اٰمِيْنَ اٰمِيْنَ اٰمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا شَاهِدَ كُلِّ نَجْوٰي .... تا آخر"
    },
    {
      "kind": "text",
      "ar": "يَا دَائِمَ الْفَضْلِ عَلَي الْبَرِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "يَا بَاسِطَ الْيَدَيْنِ بِالْعَطِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "يَا صَاحِبَ الْمَوَاهِبِ السَّنِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ خَيْرِ الْوَرٰي سَجِيَّةً"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لَنَا يَا ذَا الْعُلٰي فِيْ هٰذِهِ الْعَشِيَّةِ"
    }
  ]
}