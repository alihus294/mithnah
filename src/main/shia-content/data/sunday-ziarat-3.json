{
  "id": "sunday-ziarat-3",
  "title": "دوسري زيارت حضرت فاطمه زهرا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دوسري زيارت حضرت فاطمه زهرا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا مُمْتَحَنَةُ"
    },
    {
      "kind": "text",
      "ar": "امْتَحَنَكِ الَّذِيْ خَلَقَكِ قَبْلَ أَنْ يَخْلُقَكِ"
    },
    {
      "kind": "text",
      "ar": "وَكُنْتِ لِمَا امْتَحَنَكِ بِهٖ صَابِرَةً"
    },
    {
      "kind": "text",
      "ar": "وَنَحْنُ لَكِ أَوْلِيَاءٌ مُصَدِّقُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلِكُلِّ مَا أَتٰي بِهٖ أَبُوْكِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَسَلَّمَ"
    },
    {
      "kind": "text",
      "ar": "وَأَتي بِهٖ وَصِيُّهٗ مُسَلِّمُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَنَحْنُ نَسْأَلُكَ اَللّٰهُمَّ اِذْ كُنَّا مُصَدِّقِيْنَ لَهُمْ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُلْحِقَنَا بِتَصْدِيْقِنَا بِالدَّرَجَةِ الْعَالِيَةِ"
    },
    {
      "kind": "text",
      "ar": "لِنُبَشِّرَ أَنْفُسَنَا بِأَنَّا قَدْ طَهُرْنَا بِوِلَايَتِهِمْ عَلَيْهِمُ السَّلَامُ"
    }
  ]
}