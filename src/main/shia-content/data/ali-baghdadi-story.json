    },
    {
      "kind": "text",
      "ar": "ءَأَدْخُلُ يَا اَللّٰهُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا رَسُوْلَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا اَمِيْرَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا اَبَا مُحَمَّدِ الْحَسَنَ الْعَسْكَرِيْ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ يَا صَاحِبَ الزَّمَانِ يَا بْنَ الْحَسَنِ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْكَ اَلسَّلَامُ وَرَحْمَةُ اللهِ وَبَرَكَاتُه"
    },
    {
      "kind": "text",
      "ar": "اَلسََّلَامُ عَلَيْكُمَا يَااَمِيْنَيِ اللهِ فِيْ اَرْضِهٖ وَحُجَّتَيْهِ عَلٰي عِبَادِهٖ .... الخ"
    }
  ]
}