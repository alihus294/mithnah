{
  "id": "taweez-snake-scorpion",
  "title": "سانپ و بچهو سے بچنے كا تعويذ",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سانپ و بچهو سے بچنے كا تعويذ",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّ أَسْلَمَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ وَعَجِّلْ فَرَجَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَسَلِّمْنَا مِنْ شَرِّ كُلِّ ذِيْ شَرٍّ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ رَبَّ هُوْدِ بْنِ أٰسَيَّةَ"
    },
    {
      "kind": "text",
      "ar": "اٰمِنِّيْ شَرَّ كُلِّ عَقْرَبٍ وَحَيَّةٍ۔"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ صَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَخَذْتُ الْعَقَارِبَ وَالْحَيَّاتِ كُلَّهَا"
    },
    {
      "kind": "text",
      "ar": "بِاِذْنِ اللهِ تَبَارَكَ وَتَعَالٰي"
    },
    {
      "kind": "text",
      "ar": "بِأَفْوَاهِهَا وَأَذْنَابِهَا وَأَسْمَاعِهَا وَأَبْصَارِهَا وَقُوَاهَا"
    },
    {
      "kind": "text",
      "ar": "عَنِّيْ وَعَمَّنْ أَحْبَبْتُ اِلٰي ضَحْوَةِ النَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "اِنْ شَاءَ اللهُ تَعَالٰي۔"
    },
    {
      "kind": "text",
      "ar": "سَلَامٌ عَلٰي نُوْحٍ فِي الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ مِنْ عِبَادِنَا الْمُؤمِنِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "سَلَامٌ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي نُوْحٍ فِي الْعَالَمِيْنَ۔"
    }
  ]
}