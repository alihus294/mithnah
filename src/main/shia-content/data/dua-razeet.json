{
  "id": "dua-razeet",
  "title": "دعا۔ رضيت بالله ربا",
  "subtitle": "تعقيبات الصلاة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعا۔ رضيت بالله ربا",
      "subtitle": "تعقيبات الصلاة"
    },
    {
      "kind": "text",
      "ar": "رَضِيْتُ بِاللّٰهِ رَبًّا وَبِالْاِسْلَامِ دِيْنًا"
    },
    {
      "kind": "text",
      "ar": "وَبِمُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ نَبِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَبِعَلِيٍّ اِمَامًا وَبِالْحَسَنِ وَالْحُسَيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيٍّ وَمُحَمَّدٍ وَجَعْفَرٍ وَمُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "وَعَلِيٍّ وَمُحَمَّدٍ وَعَلِيٍّ وَالْحَسَنِ"
    },
    {
      "kind": "text",
      "ar": "وَالْخَلَفِ الصَّالِحِ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "أَئِمَّةً وَسَادَةً وَقَادَةً"
    },
    {
      "kind": "text",
      "ar": "بِهِمْ أَتَوَلّٰي، وَمِنْ أَعْدَائِهِمْ أَتَبَرَّأُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُعَافَاةَ فِي الدُّنْيَا وَالْاٰخِرَةِ"
    }
  ]
}