{
  "id": "ramadan-day30-dua",
  "title": "تيسويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "تيسويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ صِيَامِيْ فِيْهِ بِالشُّكْرِ وَالْقَبُوْلِ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي مَا تَرْضَاهُ وَيَرْضَاهُ الرَّسُوْلُ"
    },
    {
      "kind": "text",
      "ar": "مُحْكَمَةً فُرُوْعُهٗ بِالْاُصُوْلِ"
    },
    {
      "kind": "text",
      "ar": "بِحَقِّ سَيِّدِنَا مُحَمَّدٍ وَاٰلِهٖ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ۔"
    }
  ]
}