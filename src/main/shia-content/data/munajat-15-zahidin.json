{
  "id": "munajat-15-zahidin",
  "title": "المناجاة الخامسة عشرة — مناجاة الزاهدين",
  "subtitle": "من المناجاة الخمسة عشر للإمام السجاد عليه السلام",
  "source": "مفاتيح الجنان، المناجاة الخمس عشرة",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "مناجاة الزاهدين", "subtitle": "المناجاة الخامسة عشرة — وآخر المناجاة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "إِلٰهِي أَسْكَنْتَنا داراً حَفَرَتْ لَنا حُفَرَ مَكْرِها" },
    { "kind": "text", "ar": "وَعَلَّقَتْنا بِأَيْدِي المَنايا فِي حَبائِلِ غَدْرِها" },
    { "kind": "text", "ar": "فَإِلَيْكَ نَلْتَجِئُ مِنْ مَكائِدِ خُدَعِها" },
    { "kind": "text", "ar": "وَبِكَ نَعْتَصِمُ مِنَ الاِغْتِرارِ بِزَخارِفِ زِينَتِها" },
    { "kind": "text", "ar": "فَإِنَّها المُهْلِكَةُ طُلَّابَها" },
    { "kind": "text", "ar": "المُتْلِفَةُ حُلَّالَها" },
    { "kind": "text", "ar": "المَحْشُوَّةُ بِالآفاتِ، المَشْحُونَةُ بِالنَّكَباتِ" },
    { "kind": "text", "ar": "إِلٰهِي فَزَهِّدْنا فِيها" },
    { "kind": "text", "ar": "وَسَلِّمْنا مِنْها بِتَوْفِيقِكَ وَعِصْمَتِكَ" },
    { "kind": "text", "ar": "وَانْزَعْ عَنَّا جَلابِيبَ مُخالَفَتِكَ" },
    { "kind": "text", "ar": "وَتَوَلَّ أُمُورَنا بِحُسْنِ كِفايَتِكَ" },
    { "kind": "text", "ar": "وَأَوْفِرْ مَزِيدَنا مِنْ سَعَةِ رَحْمَتِكَ" },
    { "kind": "text", "ar": "وَأَجْمِلْ صِلاتِنا مِنْ فَيْضِ مَواهِبِكَ" },
    { "kind": "text", "ar": "وَاغْرِسْ فِي أَفْئِدَتِنا أَشْجارَ مَحَبَّتِكَ" },
    { "kind": "text", "ar": "وَأَتْمِمْ لَنا أَنْوارَ مَعْرِفَتِكَ" },
    { "kind": "text", "ar": "وَأَذِقْنا حَلاوَةَ عَفْوِكَ وَلَذَّةَ مَغْفِرَتِكَ" },
    { "kind": "text", "ar": "وَأَقِرَّ أَعْيُنَنا يَوْمَ لِقائِكَ بِرُؤْيَتِكَ" },
    { "kind": "text", "ar": "وَأَخْرِجْ حُبَّ الدُّنْيا مِنْ قُلُوبِنا" },
    { "kind": "text", "ar": "كَما فَعَلْتَ بِالصَّالِحِينَ مِنْ صَفْوَتِكَ" },
    { "kind": "text", "ar": "وَالأَبْرارِ مِنْ خاصَّتِكَ" },
    { "kind": "text", "ar": "بِرَحْمَتِكَ يا أَرْحَمَ الرَّاحِمِينَ، وَيا أَكْرَمَ الأَكْرَمِينَ" }
  ]
}
