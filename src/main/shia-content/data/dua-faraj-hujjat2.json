{
  "id": "dua-faraj-hujjat2",
  "title": "دعاء فرج۔ اللّٰهم ارزقنا",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء فرج۔ اللّٰهم ارزقنا",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنَا تَوْفِيْقَ الطّاعَةِ، وَبُعْدَ الْمَعْصِيَةِ"
    },
    {
      "kind": "text",
      "ar": "وَصِدْقَ النِّيَّةِ، وَعِرْفَانَ الْحُرْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَكْرِمْنَا بِالْهُدٰي وَالْاِسْتِقَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَسَدِّدْ أَلْسِنَتَنَا بِالصَّوَابِ وَالْحِكْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَامْلَاْ قُلُوْبَنَا بِالْعِلْمِ وَالْمَعْرِفَةِ"
    },
    {
      "kind": "text",
      "ar": "وَطَهِّرْ بُطُوْنَنَا مِنَ الْحَرَامِ وَالشُّبْهَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفُفْ أَيْدِيَنَا عَنِ الظُّلْمِ وَالسَّرِقَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاغْضُضْ أَبْصَارَنَا عَنِ الْفُجُوْرِ وَالْخِيَانَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْدُدْ أَسْمَاعَنَا عَنِ اللَّغْوِ وَالْغِيْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَتَفَضَّلْ عَلٰي عُلَمَائِنَا بِالزُّهْدِ وَالنَّصِيْحَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْمُتَعَلِّمِيْنَ بِالْجُهْدِ وَالرَّغْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْمُسْتَمِعِيْنَ بِالْاِتِّبَاعِ وَالْمَوْعِظَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَرْضَي الْمُسْلِمِيْنَ بِالشِّفَاءِ وَالرَّاحَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَوْتَاهُمْ بِالرَّأْفَةِ وَالرَّحْمَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَشَايِخِنَا بِالْوَقَارِ وَالسَّكِيْنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الشَّبَابِ بِالْاِنَابَةِ وَالتَّوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي النِّسَاءِ بِالْحَيَاءِ وَالْعِفَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْاَغْنِيَاءِ بِالتَّوَاضُعِ وَالسَّعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْفُقَرَاءِ بِالصَّبْرِ وَالْقَنَاعَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْغُزَاةِ بِالنَّصْرِ وَالْغَلَبَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْاُسَرَاءِ بِالْخَلَاصِ وَالرَّاحَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْاُمَرَاءِ بِالْعَدْلِ وَالشَّفَقَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الرَّعِيَّةِ بِالْاِنْصَافِ وَحُسْنِ السِّيْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ لِلْحُجَّاجِ وَالزُّوَّارِ فِي الزَّادِ وَالنَّفَقَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْضِ مَا أَوْجَبْتَ عَلَيْهِمْ مِنَ الْحَجِّ وَالْعُمْرَةِ"
    },
    {
      "kind": "text",
      "ar": "بِفَضْلِكَ وَرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}