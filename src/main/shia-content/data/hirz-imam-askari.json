{
  "id": "hirz-imam-askari",
  "title": "۹۔ حرز امام حسن عسكري",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۹۔ حرز امام حسن عسكري",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا عُدَّتِيْ عِنْدَ شِدَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَيَا غَوْثِيْ عِنْدَ كُرْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مُوْنِسِيْ عِنْدَ وَحْدَتِيْ"
    },
    {
      "kind": "text",
      "ar": "اُحْرُسْنِيْ بِعَيْنِكَ الَّتِيْ لَا تَنَامُ"
    },
    {
      "kind": "text",
      "ar": "وَاكْنُفْنِيْ بِرُكْنِك الَّذِيْ لَا يُرَامُ"
    }
  ]
}