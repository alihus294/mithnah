{
  "id": "zilhajj-day10",
  "title": "روز عيد الضحيٰ",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "روز عيد الضحيٰ",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ أَكْبَرُ، اَللّٰهُ أَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ، وَاللهُ أَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ أَكْبَرُ، وَلِلّٰهِ الْحَمْدُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ أَكْبَرُ عَلٰي مَا هَدَانَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُ أَكْبَرُ عَلٰي مَا رَزَقَنَا مِنْ بَهِيْمَةِ الْاَنْعَام"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ عَلٰي مَا أَبْلَانَا"
    }
  ]
}