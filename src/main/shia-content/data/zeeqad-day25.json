{
  "id": "zeeqad-day25",
  "title": "پچيسويں ذيقعد كا دن",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "پچيسويں ذيقعد كا دن",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "لَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُقِيْلَ الْعَثَرَاتِ، أَقِلْنِيْ عَثْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا مُجِيْبَ الدَّعَوَاتِ، أَجِبْ دَعْوَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا سَامِعَ الْاَصْوَاتِ اِسْمَعْ صَوْتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْنِيْ، وَتَجَاوَزْ عَنْ سَيِّئَاتِيْ وَمَا عِنْدِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا ذَا الْجَلَالِ وَالْاِكْرَامِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ دَاحِيَ الكَعْبَةِ، وَفَالِقَ الْحَبَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَصَارِفَ اللَّزْبَةِ، وَكَاشِفَ كُلِّ كُرْبَةٍ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ فِيْ هٰذَا الْيَوْمِ مِنْ أَيَّامِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ أَعْظَمْتَ حَقَّهَا، وَأَقْدَمْتَ سَبْقَهَا"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهَا عِنْدَ الْمُؤْمِنِيْنَ وَدِيْعَةً"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ ذَرِيْعَةً، وَبِرَحْمَتِكَ الْوَسِيْعَةِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ عَبْدِكَ الْمُنْتَجَبِ"
    },
    {
      "kind": "text",
      "ar": "فِي الْمِيْثَاقِ الْقَرِيْبِ يَوْمَ التَّلَاقِ"
    },
    {
      "kind": "text",
      "ar": "فَاتِقِ كُلِّ رَتْقٍ، وَدَاعٍ اِلٰي كُلِّ حَقٍّ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَهْلِ بَيْتِهِ الْاَطْهَارِ، الْهُدَاةِ الْمَنَارِ"
    },
    {
      "kind": "text",
      "ar": "دَعَائِمِ الْجَبَّارِ، وَوُلَاةِ الْجَنَّةِ وَالنَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنَا فِيْ يَوْمِنَا هٰذَا مِنْ عَطَائِكَ الْمَخْزُوْنِ"
    },
    {
      "kind": "text",
      "ar": "غَيْرَ مَقْطُوْعٍ وَلَا مَمْنُوْعٍ"
    },
    {
      "kind": "text",
      "ar": "تَجْمَعُ لَنَا بِهِ التَّوْبَةَ وَحُسْنَ الْاَوْبَةِ"
    },
    {
      "kind": "text",
      "ar": "يَا خَيْرَ مَدْعُوٍّ، وَأَكْرَمَ مَرْجُوٍّ"
    },
    {
      "kind": "text",
      "ar": "يَا كَفِيُّ يَا وَفِيُّ، يَا مَنْ لُطْفُهٗ خَفِيٌّ"
    },
    {
      "kind": "text",
      "ar": "اُلْطُفْ لِيْ بِلُطْفِكَ، وَأَسْعِدْنِيْ بِعَفْوِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَيِّدْنِيْ بِنَصْرِكَ، وَلَا تُنْسِنِيْ كَرِيْمَ ذِكْرِكَ"
    },
    {
      "kind": "text",
      "ar": "بِوُلَاةِ أَمْرِكَ وَحَفَظَةِ سِرِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْنِيْ مِنْ شَوَايِبِ الدَّهْرِ اِلٰي يَوْمِ الْحَشْرِ وَالنَّشْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهِدْنِيْ أَوْلِيَائَكَ عِنْدَ خُرُوْجِ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَحُلُوْلِ رَمْسِيْ، وَانْقِطَاعِ عَمَلِيْ، وَانْقِضَاءِ أَجَلِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاذْكُرْنِيْ عَلٰي طُوْلِ الْبِلٰي"
    },
    {
      "kind": "text",
      "ar": "اِذَا حَلَلْتُ بَيْنَ أَطْبَاقِ الثَّرٰي"
    },
    {
      "kind": "text",
      "ar": "وَنَسِيَنِي النَّاسُوْنَ مِنَ الْوَرٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَحْلِلْنِيْ دَارَ الْمُقَامَةِ وَبَوِّئْنِيْ مَنْزِلَ الْكَرَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ مُرَافِقِيْ أَوْ لِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْلِ اجْتِبَائِكَ وَاصْطِفَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ لِيْ فِيْ لِقَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ حُسْنَ الْعَمَلِ قَبْلَ حُلُوْلِ الْاَجَلِ"
    },
    {
      "kind": "text",
      "ar": "بَرِيْئًا مِنَ الزَّلَلِ وَسُوْءِ الْخَطَلِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَوْرِدْنِيْ حَوْضَ نَبِيِّكَ مُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْقِنِيْ مِنْهُ مَشْرَبًا رَوِيًّا سَائِغًا هَنِيْئًا"
    },
    {
      "kind": "text",
      "ar": "لَا أَظْمَأُ بَعْدَهٗ، وَلَا أُحَلَّأُ وِرْدَهٗ، وَلَا عَنْهُ أُذَادُ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ لِيْ خَيْرَ زَادٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْفٰي مِيْعَادٍ يَوْمَ يَقُوْمُ الْاَشْهَادُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَالْعَنْ جَبَابِرَةَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبِحُقُوْقِ أَوْلِيَائِكَ الْمُسْتَأْثِرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاقْصِمْ دَعَائِمَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْلِكْ أَشْيَاعَهُمْ وَعَامِلَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَعَجِّلْ مَهَالِكَهُمْ، وَاسْلُبْهُمْ مَمَالِكَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَضَيِّقْ عَلَيْهِمْ مَسَالِكَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْعَنْ مُسَاهِمَهُمْ وَمُشَارِكَهُمْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَعَجِّلْ فَرَجَ أَوْ لِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَارْدُدْ عَلَيْهِمْ مَظَالِمَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَظْهِرْ بِالْحَقِّ قَائِمَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ لِدِيْنِكَ مُنْتَصِرًا"
    },
    {
      "kind": "text",
      "ar": "وَبِأَمْرِكَ فِيْ أَعْدَائِكَ مُؤْتَمِرًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ احْفُفْهُ بِمَلَائِكَةِ النَّصْرِ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَا أَلْقَيْتَ اِلَيْهِ مِنَ الْاَمْرِ فِيْ لَيْلَةِ الْقَدْرِ"
    },
    {
      "kind": "text",
      "ar": "مُنْتَقِمًا لَكَ حَتّٰي تَرْضٰي"
    },
    {
      "kind": "text",
      "ar": "وَيَعُوْدَ دِيْنُكَ بِهٖ وَعَلٰي يَدَيْهِ جَدِيْدًا غَضًّا"
    },
    {
      "kind": "text",
      "ar": "وَيَمْحَضَ الْحَقَّ مَحْضًا"
    },
    {
      "kind": "text",
      "ar": "وَيَرْفُضَ الْبَاطِلَ رَفْضًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَيْهِ وَعَلٰي جَمِيْعِ اٰبَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا مِنْ صَحْبِهٖ وَأُسْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَابْعَثْنَا فِيْ كَرَّتِهٖ، حَتّٰي نَكُوْنَ فِيْ زَمَانِهٖ مِنْ أَعْوَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَدْرِكْ بِنَا قِيَامَهٗ، وَأَشْهِدْنَا أَيَّامَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلَيْهِ، وَارْدُدْ اِلَيْنَا سَلَامَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْهِ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    }
  ]
}