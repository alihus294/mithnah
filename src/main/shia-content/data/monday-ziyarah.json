    { "kind": "text", "ar": "اَلسَّلَامُ عَلَيْكَ يَا ابْنَ رَسُولِ رَبِّ الْعَالَمِينَ" },
    { "kind": "text", "ar": "اَلسَّلَامُ عَلَيْكَ يَا ابْنَ أَمِيرِ الْمُؤْمِنِينَ" },
    { "kind": "text", "ar": "اَلسَّلَامُ عَلَيْكَ يَا ابْنَ فَاطِمَةَ الزَّهْرَاءِ" },
    { "kind": "text", "ar": "اَلسَّلَامُ عَلَيْكَ يَا حَبِيبَ اللهِ" },
