{
  "id": "munajat-murideen",
  "title": "۸۔ مناجات مريدين",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۸۔ مناجات مريدين",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَحْمٰنِ الرَحيمْ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ مَا أَضْيَقَ الطُّرُقَ عَلٰي مَنْ لَمْ تَكُنْ دَلِيْلَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَمَا أَوْضَحَ الْحَقَّ عِنْدَ مَنْ هَدَيْتَهٗ سَبِيْلَهٗ ؟"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ فَاسْلُكْ بِنَا سُبُلَ الْوُصُوْلِ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَسَيِّرْنَا فِيْ أَقْرَبِ الطُّرُقِ لِلْوُفُوْدِ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "قَرِّبْ عَلَيْنَا الْبَعِيْدَ"
    },
    {
      "kind": "text",
      "ar": "وَسَهِّلْ عَلَيْنَا الْعَسِيْرَ الشَّدِيْدَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْحِقْنَا بِعِبَادِكَ الَّذِيْنَ هُمْ بِالْبِدَارِ اِلَيْكَ يُسَارِعُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبَابَكَ عَلَي الدَّوَامِ يَطْرُقُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاِيَّاكَ فِي اللَّيْلِ وَالنَّهَارِ يَعْبُدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَهُمْ مِنْ هَيْبَتِكَ مُشْفِقُوْنَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ صَفَّيْتَ لَهُمُ الْمَشَارِبَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلَّغْتَهُمُ الرَّغَائِبَ، وَأَنْجَحْتَ لَهُمُ الْمَطَالِبَ"
    },
    {
      "kind": "text",
      "ar": "وَقَضَيْتَ لَهُمْ مِنْ فَضْلِكَ الْمَاٰرِبَ"
    },
    {
      "kind": "text",
      "ar": "وَمَلَائِتَ لَهُمْ ضَمَائِرَهُمْ مِنْ حُبِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَرَوَّيْتَهُمْ مِنْ صَافِيْ شِرْبِكَ"
    },
    {
      "kind": "text",
      "ar": "فَبِكَ اِلٰي لَذِيْذِ مُنَاجَاتِكَ وَصَلُوْا"
    },
    {
      "kind": "text",
      "ar": "وَمِنْكَ أَقْصٰي مَقَاصِدِهِمْ حَصَّلُوْا"
    },
    {
      "kind": "text",
      "ar": "فَيَا مَنْ هُوَ عَلَي الْمُقْبِلِيْنَ عَلَيْهِ مُقْبِلٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِالْعَطْفِ عَلَيْهِمْ عَائِدٌ مُفْضِلٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِالْغَافِلِيْنَ عَنْ ذِكْرِهٖ رَحِيْمٌ رَءُوْفٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِجَذْبِهِمْ اِلٰي بَابِهٖ وَدُوْدٌ عَطُوْفٌ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تَجْعَلَنِيْ مِنْ أَوْفَرِهِمْ مِنْكَ حَظًّا"
    },
    {
      "kind": "text",
      "ar": "وَأَعْلَاهُمْ عِنْدَكَ مَنْزِلًا"
    },
    {
      "kind": "text",
      "ar": "وَأَجْزَلِهِمْ مِنْ وُدِّكَ قِسْمًا"
    },
    {
      "kind": "text",
      "ar": "وَأَفْضَلِهِمْ فِيْ مَعْرِفَتِكَ نَصِيْبًا"
    },
    {
      "kind": "text",
      "ar": "فَقَدِ انْقَطَعَتْ اِلَيْكَ هِمَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَانْصَرَفَتْ نَحْوَكَ رَغْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَأَنْتَ لَا غَيْرُكَ مُرَادِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ لَا لِسِوَاكَ سَهَرِيْ وَسُهَادِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلِقَاؤُكَ قُرَّةُ عَيْنِيْ، وَوَصْلُكَ مُنٰي نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ شَوْقِيْ، وَفِيْ مَحَبَّتِكَ وَلَهِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلٰي هَوَاكَ صَبَابَتِيْ وَرِضَاكَ بُغْيَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَرُؤْيَتُكَ حَاجَتِيْ، وَجَوَارُكَ طَلَبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقُرْبُكَ غَايَةُ سُؤْلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ مُنَاجَاتِكَ رَوْحِيْ وَرَاحَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعِنْدَكَ دَوَاءُ عِلَّتِيْ، وَشِفَاءُ غُلَّتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَبَرْدُ لَوْعَتِيْ، وَكَشْفُ كُرْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "فَكُنْ أَنِيْسِيْ فِيْ وَحْشَتِيْ، وَمُقِيْلَ عَثْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَغَافِرَ زَلَّتِيْ، وَقَابِلَ تَوْبَتِيْ، وَمُجِيْبَ دَعْوَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَوَلِيَّ عِصْمَتِيْ، وَمُغْنِيَ فَاقَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَقْطَعْنِيْ عَنْكَ، وَلَا تُبْعِدْنِيْ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "يَا نَعِيْمِيْ وَجَنَّتِيْ، وَيَا دُنْيَايَ وَاٰخِرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}