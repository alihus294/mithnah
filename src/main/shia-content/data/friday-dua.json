{
  "id": "friday-dua",
  "title": "جمعه كے دن كي دعا، از ملحقاتِ صحيفۂ كامله",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "جمعه كے دن كي دعا، از ملحقاتِ صحيفۂ كامله",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْم"
    },
    {
      "kind": "text",
      "ar": "اَلْحَمْدُ لِلّٰهِ الْاَوَّلِ قَبْلَ الْاِنْشَاءِ وَالْاِحْيَاءِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاٰخِرِ بَعْدَ فَنَاءِ الْاَشْيَاءِ"
    },
    {
      "kind": "text",
      "ar": "الْعَلِيْمِ الَّذِيْ لَا يَنْسٰي مَنْ ذَكَرَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَنْقُصُ مَنْ شَكَرَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَخِيْبُ مَنْ دَعَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَقْطَعُ رَجَاءَ مَنْ رَجَاهُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أُشْهِدُكَ وَكَفٰي بِكَ شَهِيْدًا"
    },
    {
      "kind": "text",
      "ar": "وَأُشْهِدُ جَمِيْعَ مَلَائِكَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَسُكَّانَ سَمٰوَاتِكَ وَحَمَلَةِ عَرْشِكَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ بَعَثْتَ مِنْ أَنْبِيَائِكَ وَرُسُلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْشَأْتَ مِنْ أَصْنَافِ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "أَنِّيْ أَشْهَدُ أَنَّكَ أَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "وَحْدَكَ لَا شَرِيْكَ لَكَ، وَلَاعَدِيْلَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا خُلْفَ لِقَوْلِكَ وَلَا تَبْدِيْلَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مُحَمَّدًا صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ عَبْدُكَ وَرَسُوْلُكَ"
    },
    {
      "kind": "text",
      "ar": "أَدّٰي مَا حَمَّلْتَهٗ اِلَي الْعِبَادِ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدَ فِي اللهِ عَزَّوَجَلَّ حَقَّ الْجِهَادِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّهٗ بَشَّرَ بِمَا هُوَ حَقٌّ مِنَ الثَّوَابِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْذَرَ بِمَا هُوَ صِدْقٌ مِنَ الْعِقَابِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ثَبِّتْنِيْ عَلٰي دِيْنِكَ مَا أَحْيَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُزِغْ قَلْبِيْ بَعْدَ اِذْ هَدَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيْ مِنْ لَدُنْك رَحْمَةً"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الْوَهَّابُ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَعَلٰي اٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ أَتْبَاعِهٖ وَشِيْعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنِيْ فِيْ زُمْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَوَفِّقْنِيْ لِاَدَاءِ فَرْضِ الْجُمُعَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَمَا أَوْجَبْتَ عَلَيَّ فِيْهَا مِنَ الطَّاعَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَقَسَمْتَ لِاَهْلِهَا مِنَ الْعَطَاءِ فِيْ يَوْمِ الْجَزَاءِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الْعَزِيْزُ الْحَكِيْمُ"
    }
  ]
}