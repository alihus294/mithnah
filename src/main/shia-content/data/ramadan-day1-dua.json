{
  "id": "ramadan-day1-dua",
  "title": "پهلے دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "پهلے دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ صِيَامِيْ فِيْهِ صِيَامَ الصَّائِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَقِيَامِيْ فِيْهِ قِيَامَ الْقَائِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَنَبِّهْنِيْ فِيْهِ عَنْ نَوْمَةِ الْغَافِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيْ جُرْمِيْ فِيْهِ يَا اِلٰهَ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاعْفُ عَنِّيْ يَا عَافِيًا عَنِ الْمُجْرِمِيْنَ۔"
    }
  ]
}