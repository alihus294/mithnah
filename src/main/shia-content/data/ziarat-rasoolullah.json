{
  "id": "ziarat-rasoolullah",
  "title": "كيفيت زيارت حضرت رسول خدا",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "كيفيت زيارت حضرت رسول خدا",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا رَسُوْلَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نَبِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مُحَمَّدُ بْنَ عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا خَاتَمَ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ بَلَّغْتَ الرِّسَالَةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَقَمْتَ الصَّلَاةَ وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَعَبَدْتَ اللهَ مُخْلِصًا حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "فَصَلَوَاتُ اللهِ عَلَيْكَ وَرَحْمَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَهْلِ بَيْتِكَ الطَّاهِرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهٗ وَرَسُوْلُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ رَسُوْلُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ مُحَمَّدُ بْنُ عَبْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكَ قَدْ بَلَّغْتَ رِسَالَاتِ رَبِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَصَحْتَ لِاُمَّتِكَ، وَجَاهَدْتَ فِيْ سَبِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَعَبَدْتَ اللهَ حَتّي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَدَّيْتَ الَّذِيْ عَلَيْكَ مِنَ الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ قَدْ رَؤُفْتَ بِالْمُؤْمِنِيْنَ، وَغَلُظْتَ عَلَي الْكَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَبَلَّغَ اللهُ بِكَ أَفْضَلَ شَرَفِ مَحَلِّ الْمُكَرَّمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِي اسْتَنْقَذَنَا بِكَ مِنْ الشِّرْكِ وَالضَّلَالَةِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاجْعَلْ صَلَوَاتِكَ وَصَلَوَاتِ مَلَائِكَتِكَ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْبِيَائِكَ الْمُرْسَلِيْنَ وَعِبَادِكَ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْلِ السَّمٰوَاتِ وَالْاَرَضِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ سَبَّحَ لَكَ يَا رَبَّ الْعَالَمِيْنَ مِنَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي مُحَمَّدٍ عَبْدِكَ وَرَسُوْلِكَ وَنَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمِيْنِكَ وَنَجِيِّكَ وَحَبِيْبِكَ وَصَفِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَاصَّتِكَ وَصَفْوَتِكَ وَخِيَرَتِكَ مِنْ خَلْقِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعْطِهِ الدَّرَجَةَ الرَّفِيْعَةَ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِهِ الْوَسِيْلَةَ مِنَ الْجَنَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَابْعَثْهُ مَقَامًا مَحْمُوْدًا يَغْبِطُهٗ بِهِ الْاَوَّلُوْنَ وَالْاٰخِرُوْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّكَ قُلْتَ: وَلَوْ أَنَّهُمْ اِذْ ظَلَمُوْا أَنْفُسَهُمْ جَاءُوْكَ"
    },
    {
      "kind": "text",
      "ar": "فَاسْتَغْفَرُوا اللهَ وَاسْتَغْفَرَ لَهُمُ الرَّسُوْلُ"
    },
    {
      "kind": "text",
      "ar": "لَوَجَدُوا اللهَ تَوَّابًا رَحِيْمًا۔"
    },
    {
      "kind": "text",
      "ar": "وَاِنِّيْ أَتَيْتُكَ مُسْتَغْفِرًا تَائِبًا مِنْ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِنِّيْ أَتَوَجَّهُ بِكَ اِلَي اللهِ رَبِّيْ وَرَبِّكَ"
    },
    {
      "kind": "text",
      "ar": "لِيَغْفِرَ لِيْ ذُنُوْبِيْ۔"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُ اللهَ الَّذِي اجْتَبَاكَ وَاخْتَارَكَ"
    },
    {
      "kind": "text",
      "ar": "وَهَدَاكَ وَهَدٰي بِكَ أَنْ يُصَلِّيَ عَلَيْكَ۔"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ وَمَلَائِكَتَهٗ يُصَلُّوْنَ عَلَي النَّبِيِّ"
    },
    {
      "kind": "text",
      "ar": "يَا أَيُّهَا الَّذِيْنَ اٰمَنُوْا صَلُّوْا عَلَيْهِ وَسَلِّمُوْا تَسْلِيْمًا"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَيْ جَوَادُ، أَيْ كَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "أَيْ قَرِيْبُ، أَيْ بَعِيْدُ أَنْ تَرُدَّ عَلَيَّ نِعْمَتَكَ۔"
    }
  ]
}