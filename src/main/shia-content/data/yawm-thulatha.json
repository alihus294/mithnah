{
  "id": "yawm-thulatha",
  "title": "دُعاءُ يَوْمِ الثُّلاثاء",
  "subtitle": "من أدعية الأيام السبعة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "دُعاءُ يَوْمِ الثُّلاثاء", "subtitle": "من أدعية الأيام السبعة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "الحَمْدُ للهِ، وَالحَمْدُ حَقُّهُ كَما يَسْتِحِقُّهُ حَمْداً كَثِيراً" },
    { "kind": "text", "ar": "وَأَعُوذُ بِهِ مِنْ شَرِّ نَفْسِي" },
    { "kind": "text", "ar": "إِنَّ النَّفْسَ لأَمَّارَةٌ بِالسُّوءِ إِلاَّ ما رَحِمَ رَبِّي" },
    { "kind": "text", "ar": "وَأَعُوذُ بِهِ مِنْ شَرِّ الشَّيْطانِ" },
    { "kind": "text", "ar": "الَّذِي يَزِيدُنِي ذَنْباً إِلَىٰ ذَنْبِي" },
    { "kind": "text", "ar": "وَاحْتَرِزُ بِهِ مِنْ كُلِّ جَبَّارٍ فاجِرٍ" },
    { "kind": "text", "ar": "وَسُلْطانٍ جائِرٍ، وَعَدُوٍ قاهِرٍ" },
    { "kind": "text", "ar": "اللَّهُمَّ اجْعَلْنِي مِنْ جُنْدِكَ" },
    { "kind": "text", "ar": "فَإِنَّ جُنْدَكَ هُمُ الغالِبُونَ" },
    { "kind": "text", "ar": "وَاجْعَلْنِي مِنْ حِزْبِكَ" },
    { "kind": "text", "ar": "فَإِنَّ حِزْبَكَ هُمُ المُفْلِحُونَ" },
    { "kind": "text", "ar": "وَاجْعَلْنِي مِنْ أوْلِيائِكَ" },
    { "kind": "text", "ar": "فَإِنَّ أَوْلِياَءَكَ لا خَوْفٌ عَلَيْهِمْ وَلا هُمْ يَحْزَنُون" },
    { "kind": "text", "ar": "اللَّهُمَّ أَصْلِحْ لِي دِينِي، فَإِنَّهُ عِصْمَةُ أَمْرِي" },
    { "kind": "text", "ar": "وَأَصْلِحْ لِي آخِرَتِي، فَإِنَّها دارُ مَقَرِّي" },
    { "kind": "text", "ar": "وَإِلَيْها مِن مُجاوَرَةِ اللِّئامِ مَفَرِّي" },
    { "kind": "text", "ar": "وَاجْعَلْ الحَياةَ زِيادَةً لِي فِي كُلِّ خَيْرٍ" },
    { "kind": "text", "ar": "وَالوَفاةَ راحَةً لِي مِنْ كُلِّ شَرٍ" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ خاتَمِ النَّبِيِّينَ" },
    { "kind": "text", "ar": "وَتَمامِ عِدَّةِ المُرْسَلِينَ" },
    { "kind": "text", "ar": "وَعَلَىٰ آلِهِ الطَّيِّبِينَ الطَّاهِرِينَ" },
    { "kind": "text", "ar": "وَأَصْحابِهِ المُنْتَجَبِينَ" },
    { "kind": "text", "ar": "وَهَبْ لِي فِي الثُّلاثاءِ ثَلاثاً" },
    { "kind": "text", "ar": "لا تَدَعْ لِي ذَنْباً إِلاَّ غَفَرْتَهُ" },
    { "kind": "text", "ar": "وَلا غَمّاً إِلاَّ أَذْهَبْتَهُ" },
    { "kind": "text", "ar": "وَلا عَدُوّاً إِلاَّ دَفَعْتَهُ" },
    { "kind": "text", "ar": "بِبِسْمِ اللهِ خَيْرِ الأَسْماءِ" },
    { "kind": "text", "ar": "بِسْمِ اللهِ رَبِّ الأَرْضِ وَالسَّماء" },
    { "kind": "text", "ar": "أَسْتَدْفِعُ كُلَّ مَكْرُوهٍ أَوَّلُهُ سَخَطُهُ" },
    { "kind": "text", "ar": "وَأَسْتَجْلِبُ كُلَّ مَحْبُوبٍ أَوَّلُهُ رِضاهُ" },
    { "kind": "text", "ar": "فَاخْتِمْ لِي مِنْكَ بِالغُفْرانِ، يا وَلِيَّ الإِحْسانِ" }
  ]
}
