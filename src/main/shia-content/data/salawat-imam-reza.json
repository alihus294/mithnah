{
  "id": "salawat-imam-reza",
  "title": "امام علي رضا پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام علي رضا پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي عَلِيِّ بْنِ مُوْسَي"
    },
    {
      "kind": "text",
      "ar": "الَّذِي ارْتَضَيْتَهٗ وَرَضَّيْتَ بِهٖ مَنْ شِئْتَ مِنْ خَلْقِكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَكَمَا جَعَلْتَهٗ حُجَّةً عَلٰي خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَائِمًا بِأَمْرِكَ، وَنَاصِرًا لِدِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَشَاهِدًا عَلٰي عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَكَمَا نَصَحَ لَهُمْ فِي السِّرِّ وَالْعَلَانِيَةِ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَا اِلٰي سَبِيْلِكَ بِالْحِكْمَةِ وَالْمَوْعِظَةِ الْحَسَنَةِ"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِ أَفْضَلَ مَا صَلَّيْتَ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي أَحَدٍ مِنْ أَوْلِيَائِكَ وَخِيَرَتِكَ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ جَوَادٌ كَرِيْمٌ۔"
    }
  ]
}