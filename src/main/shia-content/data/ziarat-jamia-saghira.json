{
  "id": "ziarat-jamia-saghira",
  "title": "زيارت جامعه صغيره",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت جامعه صغيره",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَوْلِيَاءِ اللهِ وَأَصْفِيَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أُمَنَاءِ اللهِ وَأَحِبَّائِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَنْصَارِ اللهِ وَخُلَفَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَحَالِّ مَعْرِفَةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَسَاكِنِ ذِكْرِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُظْهِرِيْ أَمْرِ اللهِ وَنَهْيِهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الدُّعَاةِ اِلَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمُسْتَقِرِّيْنَ فِيْ مَرْضَاةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْمُخْلِصِيْنَ فِيْ طَاعَةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْاَدِلَّاءِ عَلَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الَّذِيْنَ مَنْ وَالَاهُمْ فَقَدْ وَالَي اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ عَادَاهُمْ فَقَدْ عَادَي اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ عَرَفَهُمْ فَقَدْ عَرَفَ اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ جَهِلَهُمْ فَقَدْ جَهِلَ اللهَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنِ اعْتَصَمَ بِهِمْ فَقَدِ اعْتَصَمَ بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ تَخَلّٰي مِنْهُمْ فَقَدْ تَخَلّٰي مِنَ اللهِ عَزَّوَجَلَّ"
    },
    {
      "kind": "text",
      "ar": "وَأُشْهِدُ اللهَ أَنِّيْ سِلْمٌ لِمَنْ سَالَمْتُمْ"
    },
    {
      "kind": "text",
      "ar": "وَحَرْبٌ لِمَنْ حَارَبْتُمْ"
    },
    {
      "kind": "text",
      "ar": "مُؤْمِنٌ بِسِرِّكُمْ وَعَلَانِيَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُفَوِّضٌ فِيْ ذٰلِكَ كُلِّهٖ اِلَيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ عَدُوَّ اٰلِ مُحَمَّدٍ مِنَ الْجِنِّ وَالْاِنْسِ"
    },
    {
      "kind": "text",
      "ar": "وَأَبْرَأُ اِلَي اللهِ مِنْهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِهٖ۔"
    }
  ]
}