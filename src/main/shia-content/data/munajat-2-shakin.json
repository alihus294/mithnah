{
  "id": "munajat-2-shakin",
  "title": "المناجاة الثانية — مناجاة الشاكين",
  "subtitle": "من المناجاة الخمسة عشر للإمام السجاد عليه السلام",
  "source": "مفاتيح الجنان، المناجاة الخمس عشرة",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "مناجاة الشاكين", "subtitle": "المناجاة الثانية — الإمام السجاد ع" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "إِلٰهِي إِلَيْكَ أَشْكُو نَفْساً بِالسُّوءِ أَمَّارَةً" },
    { "kind": "text", "ar": "وَإِلَىٰ الخَطِيئَةِ مُبادِرَةً" },
    { "kind": "text", "ar": "وَبِمَعاصِيكَ مُولَعَةً، وَلِسَخَطِكَ مُتَعَرِّضَةً" },
    { "kind": "text", "ar": "تَسْلُكُ بِي مَسالِكَ المَهالِكِ" },
    { "kind": "text", "ar": "وَتَجْعَلُنِي عِنْدَكَ أَهْوَنَ هالِكٍ" },
    { "kind": "text", "ar": "كَثِيرَةَ العِلَلِ، طَوِيلَةَ الأَمَلِ" },
    { "kind": "text", "ar": "إِنْ مَسَّها الشَّرُّ تَجْزَعُ، وَإِنْ مَسَّها الخَيْرُ تَمْنَعُ" },
    { "kind": "text", "ar": "مَيَّالَةً إِلَىٰ اللَّعِبِ وَاللَّهْوِ" },
    { "kind": "text", "ar": "مَمْلُوءَةً بِالغَفْلَةِ وَالسَّهْوِ" },
    { "kind": "text", "ar": "تُسْرِعُ بِي إِلَىٰ الحَوْبَةِ، وَتُسَوِّفُنِي بِالتَّوْبَةِ" },
    { "kind": "text", "ar": "إِلٰهِي أَشْكُو إِلَيْكَ عَدُوّاً يُضِلُّنِي" },
    { "kind": "text", "ar": "وَشَيْطاناً يُغْوِينِي" },
    { "kind": "text", "ar": "قَدْ مَلَأَ بِالوَسْواسِ صَدْرِي" },
    { "kind": "text", "ar": "وَأَحاطَتْ هَواجِسُهُ بِقَلْبِي" },
    { "kind": "text", "ar": "يُعاضِدُ لِيَ الهَوَىٰ، وَيُزَيِّنُ لِي حُبَّ الدُّنْيا" },
    { "kind": "text", "ar": "وَيَحُولُ بَيْنِي وَبَيْنَ الطَّاعَةِ وَالزُّلْفَىٰ" },
    { "kind": "text", "ar": "إِلٰهِي إِلَيْكَ أَشْكُو قَلْباً قاسِياً" },
    { "kind": "text", "ar": "مَعَ الوَسْواسِ مُتَقَلِّباً" },
    { "kind": "text", "ar": "وَبِالرَّيْنِ وَالطَّبْعِ مُتَلَبِّساً" },
    { "kind": "text", "ar": "وَعَيْناً عَنِ البُكاءِ مِنْ خَوْفِكَ جامِدَةً" },
    { "kind": "text", "ar": "وَإِلَىٰ ما يَسُرُّها طامِحَةً" },
    { "kind": "text", "ar": "إِلٰهِي لا حَوْلَ لِي وَلا قُوَّةَ إِلَّا بِقُدْرَتِكَ" },
    { "kind": "text", "ar": "وَلا نَجاةَ لِي مِنْ مَكارِهِ الدُّنْيا إِلَّا بِعِصْمَتِكَ" },
    { "kind": "text", "ar": "فَأَسْأَلُكَ بِبَلاغَةِ حِكْمَتِكَ، وَنَفاذِ مَشِيئَتِكَ" },
    { "kind": "text", "ar": "أَنْ لا تَجْعَلَنِي لِغَيْرِ جُودِكَ مُتَعَرِّضاً" },
    { "kind": "text", "ar": "وَلا تُصَيِّرَنِي لِلْفِتَنِ غَرَضاً" },
    { "kind": "text", "ar": "وَكُنْ لِي عَلَىٰ الأَعْداءِ ناصِراً" },
    { "kind": "text", "ar": "وَعَلَىٰ المَخازِي وَالعُيُوبِ ساتِراً" },
    { "kind": "text", "ar": "وَمِنَ البَلاءِ واقِياً" },
    { "kind": "text", "ar": "وَعَنِ المَعاصِي عاصِماً" },
    { "kind": "text", "ar": "بِرَأْفَتِكَ وَرَحْمَتِكَ يا أَرْحَمَ الرَّاحِمِينَ" }
  ]
}
