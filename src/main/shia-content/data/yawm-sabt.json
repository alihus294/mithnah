{
  "id": "yawm-sabt",
  "title": "دُعاءُ يَوْمِ السَّبْت",
  "subtitle": "من أدعية الأيام السبعة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "دُعاءُ يَوْمِ السَّبْت", "subtitle": "من أدعية الأيام السبعة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "بِسْمِ اللهِ كَلِمَةِ المُعْتَصِمِينَ" },
    { "kind": "text", "ar": "وَمَقالَةِ المُتَحَرِّزِينَ" },
    { "kind": "text", "ar": "وَأَعُوذُ بِاللهِ تَعَالَىٰ مِنْ جَوْرِ الجائِرِينَ" },
    { "kind": "text", "ar": "وَكَيْدِ الحاسِدِينَ" },
    { "kind": "text", "ar": "وَبَغْيِ الظَّالِمينَ" },
    { "kind": "text", "ar": "وَأَحْمَدُهُ فَوْقَ حَمْدِ الحامِدِينَ" },
    { "kind": "text", "ar": "اللَّهُمَّ أَنْتَ الواحِدُ بِلا شَرِيكٍ" },
    { "kind": "text", "ar": "وَالمَلِكُ بِلا تَمْلِيكٍ" },
    { "kind": "text", "ar": "لا تُضادُّ فِي حُكْمِكَ" },
    { "kind": "text", "ar": "وَلا تُنازَعُ فِي مُلْكِكَ" },
    { "kind": "text", "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلَىٰ مُحَمَّدٍ، عَبْدِكَ وَرَسُولِكَ" },
    { "kind": "text", "ar": "وَأَنْ تُوْزِعَنِي مِنْ شُكْرِ نُعْماكَ" },
    { "kind": "text", "ar": "ما تَبْلُغُ بِي غايَةَ رِضاكَ" },
    { "kind": "text", "ar": "وَأَنْ تُعِيْنَنِي عَلَىٰ طاعَتِكَ" },
    { "kind": "text", "ar": "وَلُزُومِ عِبادَتِكَ" },
    { "kind": "text", "ar": "وَاسْتِحْقاقِ مَثُوبَتِكَ" },
    { "kind": "text", "ar": "بِلُطْفِ عِنايَتِكَ" },
    { "kind": "text", "ar": "وَتَرْحَمَنِي بِصَدِّي عَنْ مَعاصِيكَ ما أَحْيَيْتَني" },
    { "kind": "text", "ar": "وَتُوَفِّقَنِي لِما يَنْفَعُني ما أَبْقَيْتَنِي" },
    { "kind": "text", "ar": "وَأَنْ تَشْرَحَ بِكِتابِكَ صَدْرِي" },
    { "kind": "text", "ar": "وَتَحُطَّ بِتَلاوَتِهِ وِزْرِي" },
    { "kind": "text", "ar": "وَتَمْنَحَنِي السَّلامَةَ فِي دِينِي وَنَفْسِي" },
    { "kind": "text", "ar": "وَلا تُوحِشَ بِي أَهْلَ أُنْسِي" },
    { "kind": "text", "ar": "وَتُتِمَّ إِحْسانَكَ فِيما بَقِيَ مِنْ عُمْرِي" },
    { "kind": "text", "ar": "كَما أَحْسَنْتَ فِيما مَضَىٰ مِنْهُ" },
    { "kind": "text", "ar": "يا أَرْحَمَ الرَّاحِمِينَ" }
  ]
}
