{
  "id": "masjid-kufa-entry",
  "title": "دخول مسجد كي دعائيں",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دخول مسجد كي دعائيں",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ، وَبِاللّٰهِ، وَفِيْ سَبِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مِلَّةِ رَسُوْلِ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْزِلْنِيْ مُنْزَلًا مُبَارَكًا وَأَنْتَ خَيْرُ الْمُنْزِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اللهُ أَكْبَرُ وَلَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ اللهِ، وَسُبْحَانَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي سَيِّدِنَا رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "مُحَمَّدِ بْنِ عَبْدِ اللهِ وَاٰلِهٖ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي أَمِيْرِ الْمُؤْمِنِيْنَ عَلِيِّ بْنِ أَبِيْ طَالِبٍ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَجَالِسِهٖ وَمَشَاهِدِهٖ وَمَقَامِ حِكْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاٰثَارِ اٰبَائِهٖ اٰدَمَ وَنُوْحٍ وَاِبْرَاهِيْمَ وَاِسْمَاعِيْلَ"
    },
    {
      "kind": "text",
      "ar": "وَتِبْيَانِ بَيِّنَاتِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَي الْاِمَامِ الْحَكِيْمِ الْعَدْلِ"
    },
    {
      "kind": "text",
      "ar": "الصِّدِّيْقِ الْاَكْبَرِ، الْفَارُوْقِ بِالْقِسْطِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ فَرَّقَ اللهُ بِهٖ بَيْنَ الْحَقِّ وَالْبَاطِلِ"
    },
    {
      "kind": "text",
      "ar": "وَالْكُفْرِ وَالْاِيْمَانِ وَالشِّرْكِ وَالتَّوْحِيْدِ"
    },
    {
      "kind": "text",
      "ar": "لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَحْيٰي مَنْ حَيَّ عَنْ بَيِّنَةٍ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ أَمِيْرُ الْمُؤمِنِيْنَ، وَخَاصَّةُ نَفْسِ الْمُنْتَجَبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَزَيْنُ الصِّدِّيْقِيْنَ، وَصَابِرُ الْمُمْتَحَنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ حَكَمُ اللهِ فِيْ أَرْضِهٖ، وَقَاضِيْ أَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبَابُ حِكْمَتِهٖ، وَعَاقِدُ عَهْدِهٖ، وَالنَّاطِقُ بِوَعْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَبْلُ الْمَوْصُوْلُ بَيْنَهٗ وَبَيْنَ عِبَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكَهْفُ النَّجَاةِ، وَمِنْهَاجُ التُّقٰي"
    },
    {
      "kind": "text",
      "ar": "وَالدَّرَجَةُ الْعُلْيَا، وَمُهَيْمِنُ الْقَاضِي الْاَعْلٰي"
    },
    {
      "kind": "text",
      "ar": "يَا أَمِيْرَ الْمُؤْمِنِيْنَ، بِكَ أَتَقَرَّبُ اِلَي اللهِ زُلْفٰي"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ وَلِيِّيْ وَسَيِّدِيْ وَوَسِيْلَتِيْ فِي الدُّنْيَا وَالْاٰخِرَةِ۔"
    },
    {
      "kind": "text",
      "ar": "اللهُ أَكْبَرُ، اللهُ أَكْبَرُ، اللهُ أَكْبَرُ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا مَقَامُ الْعَائِذِ بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "وَبِمُحَمَّدٍ حَبِيْبِ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبِوِلَايَةِ أَمِيْرِ الْمُؤْمِنِيْنَ وَالْاَئِمَّةِ الْمَهْدِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "الصَّادِقِيْنَ النَّاطِقِيْنَ الرَّاشِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ أَذْهَبَ اللهُ عَنْهُمُ الرِّجْسَ وَطَهَّرَهُمْ تَطْهِيْرًا"
    },
    {
      "kind": "text",
      "ar": "رَضِيْتُ بِهِمْ أَئِمَّةً وَهُدَاةً وَمَوَالِيَّ"
    },
    {
      "kind": "text",
      "ar": "سَلَّمْتُ لِاَمْرِ اللهِ، لَا أُشْرِكُ بِهٖ شَيْئًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَتَّخِذُ مَعَ اللهِ وَلِيًّا"
    },
    {
      "kind": "text",
      "ar": "كَذَبَ الْعَادِلُوْنَ بِاللّٰهِ، وَضَلُّوْا ضَلَالًا بَعِيْدًا"
    },
    {
      "kind": "text",
      "ar": "حَسْبِيَ اللهُ وَأَوْلِيَاءُ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهٗ وَرَسُوْلُهٗ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ عَلِيًّا وَالْاَئِمَّةَ الْمَهْدِيِّيْنَ مِنْ ذُرِّيَّتِهٖ عَلَيْهِمُ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "أَوْلِيَائِيْ وَحُجَّةُ اللهِ عَلٰي خَلْقِهٖ۔"
    }
  ]
}