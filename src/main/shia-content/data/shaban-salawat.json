{
  "id": "shaban-salawat",
  "title": "زوال كے وقت صلوات",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زوال كے وقت صلوات",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "شَجَرَةِ النُّبُوَّةِ، وَمَوضِعِ الرِّسَالَةِ"
    },
    {
      "kind": "text",
      "ar": "وَمُخْتَلَفِ الْمَلَائِكَةِ، وَمَعْدِنِ الْعِلْمِ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْلِ بَيْتِ الْوَحْيِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "الْفُلْكِ الْجَارِيَةِ فِي اللُّجَجِ الْغَامِرَةِ"
    },
    {
      "kind": "text",
      "ar": "يَأْمَنُ مَنْ رَكِبَهَا، وَيَغْرَقُ مَنْ تَرَكَهَا"
    },
    {
      "kind": "text",
      "ar": "الْمُتَقَدِّمُ لَهُمْ مَارِقٌ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُتَأَخِّرُ عَنْهُمْ زَاهِقٌ"
    },
    {
      "kind": "text",
      "ar": "وَاللَّازِمُ لَهُمْ لَاحِقٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "الْكَهْفِ الْحَصِيْنِ، وَغِيَاثِ الْمُضْطَرِّ الْمُسْتَكِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَمَلْجَأَ الْهَارِبِيْنَ، وَعِصْمَةِ الْمُعْتَصِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً كَثِيْرَةً تَكُوْنُ لَهُمْ رِضًا"
    },
    {
      "kind": "text",
      "ar": "وَلِحَقِّ مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ أَدَاءً وَقَضَاءً"
    },
    {
      "kind": "text",
      "ar": "بِحَوْلٍ مِنْكَ وَقُوَّةٍ يَا رَبَّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "الطَّيِّبِيْنَ الْاَبْرَارِ الْاَخْيَارِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ أَوْجَبْتَ حُقُوْقَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَفَرَضْتَ طَاعَتَهُمْ وَوِلَايَتَهُمْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاعْمُرْ قَلْبِيْ بِطَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخْزِنِيْ بِمَعْصِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ مُوَاسَاةَ مَنْ قَتَّرْتَ عَلَيْهِ مِنْ رِزْقِكَ"
    },
    {
      "kind": "text",
      "ar": "بِمَا وَسَّعْتَ عَلَيَّ مِنْ فَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَشَرْتَ عَلَيَّ مِنْ عَدْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْيَيْتَنِيْ تَحْتَ ظِلِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذَا شَهْرُ نَبِيِّكَ سَيِّدِ رُسُلِكَ"
    },
    {
      "kind": "text",
      "ar": "شَعْبَانُ الَّذِيْ حَفَفْتَهٗ مِنْكَ بِالرَّحْمَةِ وَالرِّضْوَانِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ كَانَ رَسُوْلُ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَسَلَّمَ"
    },
    {
      "kind": "text",
      "ar": "يَدْأَبُ فِيْ صِيَامِهٖ وَقِيَامِهٖ فِيْ لَيَالِيْهِ وَأَيَّامِهٖ"
    },
    {
      "kind": "text",
      "ar": "بُخُوْعًا لَكَ فِيْ اِكْرَامِهٖ وَاِعْظَامِهٖ اِلٰي مَحَلِّ حِمَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَأَعِنَّا عَلَي الْاِسْتِنَانِ بِسُنَّتِهٖ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَنَيْلِ الشَّفَاعَةِ لَدَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاجْعَلْهُ لِيْ شَفِيْعًا مُشَفَّعًا"
    },
    {
      "kind": "text",
      "ar": "وَطَرِيْقًا اِلَيْكَ مَهْيَعًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ لَهٗ مُتَّبِعًا"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي أَلْقَاكَ يَوْمَ الْقِيَامَةِ عَنِّيْ رَاضِيًا"
    },
    {
      "kind": "text",
      "ar": "وَعَنْ ذُنُوْبِيْ غَاضِيًا"
    },
    {
      "kind": "text",
      "ar": "قَدْ أَوْجَبْتَ لِيْ مِنْكَ الرَّحْمَةَ وَالرِّضْوَانَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزَلْتَنِيْ دَارَ الْقَرَارِ وَمَحَلَّ الْاَخْيَارِ۔"
    }
  ]
}