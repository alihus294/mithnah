{
  "id": "sura-naba",
  "title": "سورۂ نباء",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ نباء",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "عَمَّ يَتَسَآءَلُوْنَۚ۝۱"
    },
    {
      "kind": "text",
      "ar": "عَنِ النَّبَاِ الْعَظِيْمِۙ۝۲"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ هُمْ فِيْهِ مُخْتَلِفُوْنَؕ۝۳"
    },
    {
      "kind": "text",
      "ar": "كَلَّا سَيَعْلَمُوْنَۙ۝۴"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ كَلَّا سَيَعْلَمُوْنَ۝۵"
    },
    {
      "kind": "text",
      "ar": "اَلَمْ نَجْعَلِ الْاَرْضَ مِهٰدًاۙ۝۶"
    },
    {
      "kind": "text",
      "ar": "وَّالْجِبَالَ اَوْتَادًا۪ۙ۝۷"
    },
    {
      "kind": "text",
      "ar": "وَّخَلَقْنٰكُمْ اَزْوَاجًاۙ۝۸"
    },
    {
      "kind": "text",
      "ar": "وَّجَعَلْنَا نَوْمَكُمْ سُبَاتًاۙ۝۹"
    },
    {
      "kind": "text",
      "ar": "وَّجَعَلْنَا الَّيْلَ لِبَاسًاۙ۝۱۰"
    },
    {
      "kind": "text",
      "ar": "وَّجَعَلْنَا النَّهَارَ مَعَاشًا۪۝۱۱"
    },
    {
      "kind": "text",
      "ar": "وَّبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًاۙ۝۱۲"
    },
    {
      "kind": "text",
      "ar": "وَّجَعَلْنَا سِرَاجًا وَّهَّاجًا۪ۙ۝۱۳"
    },
    {
      "kind": "text",
      "ar": "وَّاَنْزَلْنَا مِنَ الْمُعْصِرٰتِ مَآءً ثَجَّاجًاۙ۝۱۴"
    },
    {
      "kind": "text",
      "ar": "لِّنُخْرِجَ بِهٖ حَبًّا وَّنَبَاتًاۙ۝۱۵"
    },
    {
      "kind": "text",
      "ar": "وَّجَنّٰتٍ اَلْفَافًاؕ۝۱۶"
    },
    {
      "kind": "text",
      "ar": "اِنَّ يَوْمَ الْفَصْلِ كَانَ مِيْقَاتًاۙ۝۱۷"
    },
    {
      "kind": "text",
      "ar": "يَّوْمَ يُنْفَخُ فِي الصُّوْرِ فَتَاْتُوْنَ اَفْوَاجًاۙ۝۱۸"
    },
    {
      "kind": "text",
      "ar": "وَّفُتِحَتِ السَّمَآءُ فَكَانَتْ اَبْوَابًاۙ۝۱۹"
    },
    {
      "kind": "text",
      "ar": "وَّسُيِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًاؕ۝۲۰"
    },
    {
      "kind": "text",
      "ar": "اِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا۪ۙ۝۲۱"
    },
    {
      "kind": "text",
      "ar": "لِّلطَّاغِيْنَ مَاٰبًاۙ۝۲۲"
    },
    {
      "kind": "text",
      "ar": "لّٰبِثِيْنَ فِيْهَاۤ اَحْقَابًاۚ۝۲۳"
    },
    {
      "kind": "text",
      "ar": "لَا يَذُوْقُوْنَ فِيْهَا بَرْدًا وَّلَا شَرَابًاۙ۝۲۴"
    },
    {
      "kind": "text",
      "ar": "اِلَّا حَمِيْمًا وَّغَسَّاقًاۙ۝۲۵"
    },
    {
      "kind": "text",
      "ar": "جَزَآءً وِّفَاقًاؕ۝۲۶"
    },
    {
      "kind": "text",
      "ar": "اِنَّهُمْ كَانُوْا لَا يَرْجُوْنَ حِسَابًاۙ۝۲۷"
    },
    {
      "kind": "text",
      "ar": "وَّكَذَّبُوْا بِاٰيٰتِنَا كِذَّابًاؕ۝۲۸"
    },
    {
      "kind": "text",
      "ar": "وَكُلَّ شَيْءٍ اَحْصَيْنٰهُ كِتٰبًاۙ۝۲۹"
    },
    {
      "kind": "text",
      "ar": "فَذُوْقُوْا فَلَنْ نَّزِيْدَكُمْ اِلَّا عَذَابًا۠۝۳۰"
    },
    {
      "kind": "text",
      "ar": "اِنَّ لِلْمُتَّقِيْنَ مَفَازًاۙ۝۳۱"
    },
    {
      "kind": "text",
      "ar": "حَدَآىِٕقَ وَاَعْنَابًاۙ۝۳۲"
    },
    {
      "kind": "text",
      "ar": "وَّكَوَاعِبَ اَتْرَابًاۙ۝۳۳"
    },
    {
      "kind": "text",
      "ar": "وَّكَاْسًا دِهَاقًاؕ۝۳۴"
    },
    {
      "kind": "text",
      "ar": "لَا يَسْمَعُوْنَ فِيْهَا لَغْوًا وَّلَا كِذّٰبًاۚ۝۳۵"
    },
    {
      "kind": "text",
      "ar": "جَزَآءً مِّنْ رَّبِّكَ عَطَآءً حِسَابًاۙ۝۳۶"
    },
    {
      "kind": "text",
      "ar": "رَّبِّ السَّمٰوٰتِ وَالْاَرْضِ وَمَا بَيْنَهُمَا الرَّحْمٰنِ"
    },
    {
      "kind": "text",
      "ar": "لَا يَمْلِكُوْنَ مِنْهُ خِطَابًاۚ۝۳۷"
    },
    {
      "kind": "text",
      "ar": "يَوْمَ يَقُوْمُ الرُّوْحُ وَالْمَلٰٓىِٕكَةُ صَفًّا١ۙۗؕ"
    },
    {
      "kind": "text",
      "ar": "لَّا يَتَكَلَّمُوْنَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَابًا۝۳۸"
    },
    {
      "kind": "text",
      "ar": "ذٰلِكَ الْيَوْمُ الْحَقُّ١ۚ فَمَنْ شَآءَ اتَّخَذَ اِلٰى رَبِّهٖ مَاٰبًا۝۳۹"
    },
    {
      "kind": "text",
      "ar": "اِنَّاۤ اَنْذَرْنٰكُمْ عَذَابًا قَرِيْبًا١ۖۚ۬"
    },
    {
      "kind": "text",
      "ar": "يَّوْمَ يَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدٰهُ"
    },
    {
      "kind": "text",
      "ar": "وَيَقُوْلُ الْكٰفِرُ يٰلَيْتَنِيْ كُنْتُ تُرٰبًا۠۝۴۰"
    }
  ]
}