{
  "id": "munajat-9-muhibbin",
  "title": "المناجاة التاسعة — مناجاة المحبّين",
  "subtitle": "من المناجاة الخمسة عشر للإمام السجاد عليه السلام",
  "source": "مفاتيح الجنان، المناجاة الخمس عشرة",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "مناجاة المحبّين", "subtitle": "المناجاة التاسعة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "إِلٰهِي مَنْ ذا الَّذِي ذاقَ حَلاوَةَ مَحَبَّتِكَ فَرامَ مِنْكَ بَدَلاً" },
    { "kind": "text", "ar": "وَمَنْ ذا الَّذِي أَنِسَ بِقُرْبِكَ فَابْتَغَىٰ عَنْكَ حِوَلاً؟" },
    { "kind": "text", "ar": "إِلٰهِي فَاجْعَلْنا مِمَّنِ اصْطَفَيْتَهُ لِقُرْبِكَ وَوِلايَتِكَ" },
    { "kind": "text", "ar": "وَأَخْلَصْتَهُ لِوُدِّكَ وَمَحَبَّتِكَ" },
    { "kind": "text", "ar": "وَشَوَّقْتَهُ إِلَىٰ لِقائِكَ" },
    { "kind": "text", "ar": "وَرَضَّيْتَهُ بِقَضائِكَ، وَمَنَحْتَهُ بِالنَّظَرِ إِلَىٰ وَجْهِكَ" },
    { "kind": "text", "ar": "وَحَبَوْتَهُ بِرِضاكَ، وَأَعَذْتَهُ مِنْ هَجْرِكَ وَقِلاكَ" },
    { "kind": "text", "ar": "وَبَوَّأْتَهُ مَقْعَدَ الصِّدْقِ فِي جِوارِكَ" },
    { "kind": "text", "ar": "وَخَصَصْتَهُ بِمَعْرِفَتِكَ، وَأَهَّلْتَهُ لِعِبادَتِكَ" },
    { "kind": "text", "ar": "وَهَيَّمْتَ قَلْبَهُ لِإِرادَتِكَ، وَاجْتَبَيْتَهُ لِمُشاهَدَتِكَ" },
    { "kind": "text", "ar": "وَأَخْلَيْتَ وَجْهَهُ لَكَ، وَفَرَّغْتَ فُؤادَهُ لِحُبِّكَ" },
    { "kind": "text", "ar": "وَرَغَّبْتَهُ فِيما عِنْدَكَ، وَأَلْهَمْتَهُ ذِكْرَكَ" },
    { "kind": "text", "ar": "وَأَوْزَعْتَهُ شُكْرَكَ، وَشَغَلْتَهُ بِطاعَتِكَ" },
    { "kind": "text", "ar": "وَصَيَّرْتَهُ مِنْ صالِحِي بَرِيَّتِكَ" },
    { "kind": "text", "ar": "وَاخْتَرْتَهُ لِمُناجاتِكَ" },
    { "kind": "text", "ar": "وَقَطَعْتَ عَنْهُ كُلَّ شَيْءٍ يَقْطَعُهُ عَنْكَ" },
    { "kind": "text", "ar": "اللَّهُمَّ اجْعَلْنا مِمَّنْ دَأْبُهُمُ الاِرْتِياحُ إِلَيْكَ وَالحَنِينُ" },
    { "kind": "text", "ar": "وَدَهْرُهُمُ الزَّفْرَةُ وَالأَنِينُ" },
    { "kind": "text", "ar": "جِباهُهُمْ ساجِدَةٌ لِعَظَمَتِكَ" },
    { "kind": "text", "ar": "وَعُيُونُهُمْ ساهِرَةٌ فِي خِدْمَتِكَ" },
    { "kind": "text", "ar": "وَدُمُوعُهُمْ سائِلَةٌ مِنْ خَشْيَتِكَ" },
    { "kind": "text", "ar": "وَقُلُوبُهُمْ مُتَعَلِّقَةٌ بِمَحَبَّتِكَ" },
    { "kind": "text", "ar": "وَأَفْئِدَتُهُمْ مُنْخَلِعَةٌ مِنْ مَهابَتِكَ" },
    { "kind": "text", "ar": "يا مَنْ أَنْوارُ قُدْسِهِ لأَبْصارِ مُحِبِّيهِ رائِقَةٌ" },
    { "kind": "text", "ar": "وَسُبُحاتُ وَجْهِهِ لِقُلُوبِ عارِفِيهِ شائِفَةٌ" },
    { "kind": "text", "ar": "يا مُنَىٰ قُلُوبِ المُشْتاقِينَ، وَيا غايَةَ آمالِ المُحِبِّينَ" },
    { "kind": "text", "ar": "أَسْأَلُكَ حُبَّكَ، وَحُبَّ مَنْ يُحِبُّكَ" },
    { "kind": "text", "ar": "وَحُبَّ كُلِّ عَمَلٍ يُوصِلُنِي إِلَىٰ قُرْبِكَ" },
    { "kind": "text", "ar": "وَأَنْ تَجْعَلَكَ أَحَبَّ إِلَيَّ مِمَّا سِواكَ" },
    { "kind": "text", "ar": "وَأَنْ تَجْعَلَ حُبِّي إِيَّاكَ قائِداً إِلَىٰ رِضْوانِكَ" },
    { "kind": "text", "ar": "وَشَوْقِي إِلَيْكَ ذائِداً عَنْ عِصْيانِكَ" },
    { "kind": "text", "ar": "وَامْنُنْ بِالنَّظَرِ إِلَيْكَ عَلَيَّ" },
    { "kind": "text", "ar": "وَانْظُرْ بِعَيْنِ الوُدِّ وَالعَطْفِ إِلَيَّ" },
    { "kind": "text", "ar": "وَلا تَصْرِفْ عَنِّي وَجْهَكَ" },
    { "kind": "text", "ar": "وَاجْعَلْنِي مِنْ أَهْلِ الإِسْعادِ وَالحَظْوَةِ عِنْدَكَ" },
    { "kind": "text", "ar": "يا مُجِيبُ، يا أَرْحَمَ الرَّاحِمِينَ" }
  ]
}
