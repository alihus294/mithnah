{
  "id": "duas-wusat-rizq",
  "title": "۵۔ وسعتِ رزق كے ليے",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۵۔ وسعتِ رزق كے ليے",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنِيْ مِنْ فَضْلِكَ الْوَاسِعِ الْحَلَالِ الطَّيِّبِ"
    },
    {
      "kind": "text",
      "ar": "رِزْقًا وَاسِعًا حَلَالًا طَيِّبًا بَلَاغًا لِلدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "صَبًّا صَبًّا هَنِيْئًا مَرِيْئًا"
    },
    {
      "kind": "text",
      "ar": "مِنْ غَيْرِ كَدٍّ وَلَا مَنٍّ مِنْ أَحَدٍ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا سَعَةً مِنْ فَضْلِكَ الْوَاسِعِ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ قُلْتَ وَاسْئَلُوا اللهَ مِنْ فَضْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَمِنْ فَضْلِكَ أَسْأَلُ، وَمِنْ عَطِيَّتِكَ أَسْأَلُ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ يَدِكَ الْمَلَأَ أَسْأَلُ"
    },
    {
      "kind": "text",
      "ar": "يَا خَيْرَ الْمَسْؤُوْلِيْنَ وَيَا خَيْرَ الْمُعْطِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اُرْزُقْنِيْ وَارْزُقْ عِيَالِيْ مِنْ فَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ ذُوالْفَضْلِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا خَيْرَ مَدْعُوٍّ، وَيَا خَيْرَ مَسْؤُوْلٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَا أَوْسَعَ مَنْ أَعْطٰي وَيَا خَيْرَ مُرْتَجًي"
    },
    {
      "kind": "text",
      "ar": "اُرْزُقْنِيْ وَأَوْسِعْ عَلَيَّ مِنْ رِزْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَسَبِّبْ لِيْ رِزْقًا مِنْ قِبَلِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "يَا رَازِقَ الْمُقِلِّيْن وَيَا رَاحِمَ الْمَسَاكِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَيَا وَلِيَّ الْمُؤْمِنِيْن وَيَا ذَا الْقُوَّةِ الْمَتِيْنِ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ وَعَافِنِيْ وَاكْفِنِيْ مَا أَهَمَّنِيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُك حُسْنَ الْمَعِيْشَةِ"
    },
    {
      "kind": "text",
      "ar": "مَعِيْشَةً أَتَقَوّٰي بِهَا عَلٰي جَمِيْعِ حَوَائِجِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَوَصَّلُ بِهَا فِي الْحَيَاةِ اِلٰي اٰخِرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "مِنْ غَيْرِ أَنْ تُتْرِفَنِيْ فِيْهَا فَأَطْغٰي"
    },
    {
      "kind": "text",
      "ar": "أَوْ تُقَتِّرَ بِهَا عَلَيَّ فَأَشْقٰي"
    },
    {
      "kind": "text",
      "ar": "أَوْسِعْ عَلَيَّ مِنْ حَلَالِ رِزْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْضِلْ عَلَيَّ مِنْ سَيْبِ فَضْلِكَ"
    },
    {
      "kind": "text",
      "ar": "نِعْمَةً مِنْكَ سَابِغَةً وَعَطَاءً غَيْرَ مَمْنُوْن"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ لَا تَشْغَلْنِيْ عَنْ شُكْرِ نِعْمَتِك بِاِكْثَارٍ مِنْهَا"
    },
    {
      "kind": "text",
      "ar": "تُلْهِيْنِيْ بَهْجَتُهٗ وَتَفْتِنُنِيْ زَهَرَاتُ زَهْوَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بِاِقْلَالٍ عَلَيَّ مِنْهَا يَقْصُرُ بِعَمَلِيْ كَدُّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَيَمْلَأُ صَدْرِيْ هَمُّهٗ"
    },
    {
      "kind": "text",
      "ar": "أَعْطِنِيْ مِنْ ذٰلِكَ يَا اِلٰهِيْ غِنًي عَنْ شِرَارِ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلَاغًا أَنَالُ بِهٖ رِضْوَانَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ يَا اِلٰهِيْ مِنْ شَرِّ الدُّنْيَا وَشَرِّ مَا فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْ عَلَيَّ الدُّنْيَا سِجْنًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا فِرَاقَهَا عَلَيَّ حُزْنًا"
    },
    {
      "kind": "text",
      "ar": "اَخْرِجْنِيْ مِنْ فِتْنَتِهَا مَرْضِيًا عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "مَقْبُوْلًا فِيْهَا عَمَلِيْ اِلٰي دَارِ الْحَيَوَانِ وَمَسَاكِنِ الْاَخْيَار"
    },
    {
      "kind": "text",
      "ar": "وَأَبْدِلْنِيْ بِالدُّنْيَا الْفَانِيَةِ نَعِيْمَ الدَّارِ الْبَاقِيَةِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَعُوْذُ بِكَ مِنْ أَزْلِهَا وَزِلْزَالِهَا"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ سَطَوَاتِ شَيَاطِيْنِهَا وَسَلَاطِيْنِهَا وَنَكَالِهَا"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ بَغْيِ مَنْ بَغٰي عَلَيَّ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَنْ كَادَنِيْ فَكِدْهُ وَمَنْ أَرَادَنِيْ فَأَرِدْهُ"
    },
    {
      "kind": "text",
      "ar": "وَفُلَّ عَنِّيْ حَدَّ مَنْ نَصَبَ لِيْ حَدَّهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَطْفِأَ عَنِّيْ نَارَ مَنْ شَبَّ لِيْ وَقُوْدَهُ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِنِيْ مَكْرَ الْمَكَرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَافْقَأْ عَنِّيْ عُيُوْن الْكَفَرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاكْفِنِيْ هَمَّ مَنْ أَدْخَلَ عَلَيَّ هَمَّهُ"
    },
    {
      "kind": "text",
      "ar": "وَادْفَعْ عَنِّيْ شَرَّ الْحَسَدَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاعْصِمْنِيْ مِنْ ذٰلِكَ بِالسَّكِيْنَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْنِيْ دِرْعَكَ الْحَصِيْنَةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْيِنِيْ فِيْ سِتْرِكَ الْوَاقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْلِحْ لِيْ حَالِيْ، وَصَدِّقْ قَوْلِيْ بِفِعَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ لِيْ فِيْ أَهْلِيْ وَمَاْلِيْ"
    }
  ]
}