{
  "id": "dua-maqatil",
  "title": "دعا براء قبوليتِ دعا",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعا براء قبوليتِ دعا",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ كَيْفَ أَدْعُوْكَ وَأَنَا أَنَا"
    },
    {
      "kind": "text",
      "ar": "وَكَيْفَ أَقْطَعُ رَجَائِيْ مِنْكَ وَأَنْتَ أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِذَا لَمْ أَسْأَلْكَ فَتُعْطِيَنِيْ"
    },
    {
      "kind": "text",
      "ar": "فَمَنْ ذَا الَّذِيْ أَسْأَلُهٗ فَيُعْطِيَنِيْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِذَا لَمْ أَدْعُوْكَ فَتَسْتَجِيْبُ لِيْ"
    },
    {
      "kind": "text",
      "ar": "فَمَنْ ذَا الَّذِيْ أَدْعُوْهُ فَيَسْتَجِيْبُ لِيْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ اِذَا لَمْ أَتَضَرَّعْ اِلَيْكَ فَتَرْحَمُنِيْ"
    },
    {
      "kind": "text",
      "ar": "فَمَنْ ذَا الَّذِيْ أَتَضَرَّعُ اِلَيْهِ فَيَرْحَمُنِيْ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ فَكَمَا فَلَقْتَ الْبَحْرَ لِمُوْسٰي وَنَجَّيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تُنَجِّيَنِيْ مِمَّا أَنَا فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَتُفَرِّجَ عَنِّيْ فَرَجًا عَاجِلًا غَيْرَ اٰجِلٍ"
    },
    {
      "kind": "text",
      "ar": "بِفَضْلِكَ وَرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    }
  ]
}