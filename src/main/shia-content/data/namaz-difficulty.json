  "title": "نماز حلِ مهمات",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز حلِ مهمات",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "حَسْبُنَا اللهُ وَنِعْمَ الْوَكِيْلُ۔"
    },
    {
      "kind": "text",
      "ar": "مَا شَاءَ اللهُ لَا قُوَّةَ اِلَّا بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "اِنْ تَرَنِ اَنَا أَقَلَّ مِنْكَ مَالًا وَوَلَدَا"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ سُبْحَانَكَ اِنِّيْ كُنْتُ مِنَ الظَّالِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "وَأُفَوِّضُ أَمْرِيْ اِلَي اللهِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ بَصِيْرٌ بِالْعِبَاد"
    }
  ]
}