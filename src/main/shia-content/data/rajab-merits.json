  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ماه رجب كي فضيلت",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَسْتَغْفِرُ اللهَ وَاَسْئَلُهُ التَّوْبَةَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْاِلٰهِ الْجَلِيْلِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَا يَنْبَغِي التَّسْبِيْحُ اِلَّا لَهٗ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ الْاَعَزِّ الْاَكْرَمِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ مَنْ لَبِسَ الْعِزَّ وَهُوَ لَهٗ أَهْلٌ"
    }
  ]
}