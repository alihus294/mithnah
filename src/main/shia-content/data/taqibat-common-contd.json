{
  "id": "taqibat-common-contd",
  "title": "مزيد تعقيبات",
  "subtitle": "تعقيبات الصلاة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مزيد تعقيبات",
      "subtitle": "تعقيبات الصلاة"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَامٌ عَلَي الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لِيْ مِنْ أَمْرِيَ فَرَجًا وَمَخْرَجًا"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ مِنْ حَيْثُ أَحْتَسِبُ وَمِنْ حَيْثُ لَا أَحْتَسِبُ"
    },
    {
      "kind": "text",
      "ar": "يَارَبَّ مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَعَجِّل فَرَجَ اٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "يَا ذَالْجَلَالِ وَالْاِكْرَامِ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْنِيْ وَأَجِرْ نِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "قُلْ هُوَ اللَّهُ أَحَدٌ ﴿١﴾ اللَّهُ الصَّمَدُ ﴿٢﴾"
    },
    {
      "kind": "text",
      "ar": "لَمْ يَلِدْ وَلَمْ يُوْلَدْ ﴿٣﴾ وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ ﴿٤﴾"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِاسْمِكَ الْمَكْنُوْنِ الْمَخْزُوْنِ"
    },
    {
      "kind": "text",
      "ar": "الطَّاهِرِ الطُّهْرِ الْمُبَارَكِ"
    },
    {
      "kind": "text",
      "ar": "وَأَسْأَلُكَ بِاسْمِكَ الْعَظِيْمِ وَسُلْطَانِكَ الْقَدِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا وَاهِبَ الْعَطَايَا، وَيَا مُطْلِقَ الْاُسَارٰي"
    },
    {
      "kind": "text",
      "ar": "وَيَا فَكَّاكَ الرِّقَابِ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تُعْتِقَ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تُخْرِجَنِيْ مِنَ الدُّنْيَا سَالِمًا"
    },
    {
      "kind": "text",
      "ar": "وَتُدْخِلَنِي الْجَنَّةَ اٰمِنًا"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ تَجْعَلَ دُعَائِيْ أَوَّلَهٗ فَلَاحًا"
    },
    {
      "kind": "text",
      "ar": "وَأَوْسَطَهٗ نَجَاحًا وَاٰخِرَهٗ صَلَاحًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ عَلَّامُ الْغُيُوْبِ"
    }
  ]
}