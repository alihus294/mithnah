{
  "id": "ziarat-fatima-binte-asad",
  "title": "زيارت جناب فاطمه بنت اسد",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت جناب فاطمه بنت اسد",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي نَبِيِّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُحَمَّدٍ سَيِّدِ الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُحَمَّدٍ سَيِّدِ الْاَوَّلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مُحَمَّدٍ سَيِّدِ الْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي مَنْ بَعَثَهُ اللهُ رَحْمَةً لِلْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلٰي فَاطِمَةَ بِنْتِ أَسَدٍ الْهَاشِمِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الصِّدِّيْقَةُ الْمَرْضِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا التَّقِيَّةُ النَّقِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ أَيَّتُهَا الْكَرِيْمَةُ الرَّضِيَّةُ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا كَافِلَةَ مُحَمَّدٍ خَاتَمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا وَالِدَةَ سَيِّدِ الْوَصِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا مَنْ ظَهَرَتْ شَفَقَتُهَا عَلٰي رَسُوْلِ اللهِ خَاتَمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا مَنْ تَرْبِيَتُهَا لِوَليِّ اللهِ الْاَمِيْنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ وَعَلٰي رُوْحِكِ وَبَدَنِكِ الطّاهِرِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ وَعَلٰي وَلَدِكِ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكِ أَحْسَنْتِ الْكِفَالَةَ، وَأَدَّيْتِ الْاَمَانَةَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْتَهَدْتِ فِيْ مَرْضَاةِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَبَالَغْتِ فِيْ حِفْظِ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "عَارِفَةً بِحَقِّهٖ، مُؤْمِنَةً بِصِدْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "مُعْتَرِفَةً بِنُبُوَّتِهٖ، مُسْتَبْصِرَةً بِنِعْمَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "كَافِلَةً بِتَرْبِيَتِهٖ، مُشْفِقَةً عَلٰي نَفْسِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاقِفَةً عَلٰي خِدْمَتِهٖ، مُخْتَارَةً رِضَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكِ مَضَيْتِ عَلَي الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَالتَّمَسُّكِ بِأَشْرَفِ الْاَدْيَانِ"
    },
    {
      "kind": "text",
      "ar": "رَاضِيَةً مَرْضِيَّةً طَاهِرَةً زَكِيَّةً تَقِيَّةً نَقِيَّةً"
    },
    {
      "kind": "text",
      "ar": "فَرَضِيَ اللهُ عَنْكِ وَأَرْضَاكِ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَ الْجَنَّةَ مَنْزِلَكِ وَمَأْوَاكِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَانْفَعْنِيْ بِزِيَارَتِهَا، وَثَبِّتْنِيْ عَلٰي مَحَبَّتِهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَحْرِمْنِيْ شَفَاعَتَهَا وَشَفَاعَةَ الْاَئِمَّةِ مِنْ ذُرِّيَّتِهَا"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ مُرَافَقَتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنِيْ مَعَهَا وَمَعَ أَوْلَادِهَا الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَاتَجْعَلْهُ اٰخِرَ الْعَهْدِ مِنْ زِيَارَتِيْ اِيَّاهَا"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِي الْعَوْدَ اِلَيْهَا أَبَدًا مَا أَبْقَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِذَا تَوَفَّيْتَنِيْ فَاحْشُرْنِيْ فِيْ زُمْرَتِهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَدْخِلنِيْ فِيْ شَفَاعَتِهَا، بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِحَقِّهَا عِنْدَكَ، وَمَنْزِلَتِهَا لَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "اغْفِرْلِيْ وَلِوَالِدَيَّ وَلِجَمِيْعِ الْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْاٰخِرَةِ حَسَنَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِنَا بِرَحْمَتِكَ عَذَابَ النَّارِ۔"
    }
  ]
}