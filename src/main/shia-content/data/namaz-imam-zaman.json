{
  "id": "namaz-imam-zaman",
  "title": "نمازِ حضرت صاحب الزّمان عجل الله تعالي فرجه",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نمازِ حضرت صاحب الزّمان عجل الله تعالي فرجه",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عَظُمَ الْبَلَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَبَرِحَ الْخَفَاءُ، وَانْكَشَفَ الْغِطَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَضَاقَتِ الْاَرْضُ بِمَا وَسَعَتِ السَّمَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ يَا رَبِّ الْمُشْتَكٰي"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ الْمُعَوَّلُ فِي الشِّدَّةِ وَالرَّخَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ أَمَرْتَنَا بِطَاعَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَعَجِّلِ اللّٰهُمَّ فَرَجَهُمْ بِقَائِمِهِم وَأَظْهِرْ اِعْزَازَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحَمَّدُ يَا عَلِيُّ، يَا عَلِيُّ يَا مُحَمَّدُ"
    },
    {
      "kind": "text",
      "ar": "اكْفِيَانِيْ فَاِنَّكُمَا كَافِيَايَ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحَمَّدُ يَا عَلِيُّ، يَا عَلِيُّ يَا مُحَمَّدُ"
    },
    {
      "kind": "text",
      "ar": "انْصُرَانِيْ فَاِنَّكُمَا نَاصِرَايَ"
    },
    {
      "kind": "text",
      "ar": "يَا مُحَمَّدُ يَا عَلِيُّ، يَا عَلِيُّ يَا مُحَمَّدُ"
    },
    {
      "kind": "text",
      "ar": "احْفظَانِيْ فَاِنَّكُمَا حَافِظَايَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ يَا صَاحِبَ الزَّمَانِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ يَا صَاحِبَ الزَّمَانِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ يَا صَاحِبَ الزَّمَانِ"
    },
    {
      "kind": "text",
      "ar": "الْغَوْثَ الْغَوْثَ الْغَوْثَ"
    },
    {
      "kind": "text",
      "ar": "أَدْرِكْنِيْ أَدْرِكْنِيْ أَدْرِكْنِيْ"
    },
    {
      "kind": "text",
      "ar": "الْاَمَانَ الْاَمَانَ الْاَمَانَ"
    }
  ]
}