{
  "id": "ziarat-journey-adaab",
  "title": "مقدمه۔ آداب سفرِ زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مقدمه۔ آداب سفرِ زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْتَوْدِعُكَ الْيَوْمَ"
    },
    {
      "kind": "text",
      "ar": "نَفْسِيْ وَأَهْلِيْ وَمَالِيْ وَوُلْدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ كَانَ مِنِّيْ بِسَبِيْلٍ الشَّاهِدَ مِنْهُمْ وَالْغَائِبَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ احْفَظْنَا بِحِفْظِ الْاِيْمَانِ، وَاحْفَظْ عَلَيْنَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنَا فِيْ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَسْلُبْنَا فَضْلَكَ، اِنَّا اِلَيْكَ رَاغِبُوْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّا نَعُوْذُ بِكَ مِنْ وَعْثَاءِ السَّفَرِ"
    },
    {
      "kind": "text",
      "ar": "وَكَاٰبَةِ الْمُنْقَلَبِ، وَسُوْءِ الْمَنْظَرِ"
    },
    {
      "kind": "text",
      "ar": "فِي الْاَهْلِ وَالْمَالِ وَالْوَلَدِ فِي الدُّنْيَا وَالْاٰخِرَةِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَتَوَجَّهُ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا التَّوَجُّهَ طَلَبًا لِمَرْضَاتِكَ وَتَقَرُّبًا اِلَيْكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَبَلِّغْنِيْ مَا أُؤَمِّلُهٗ وَأَرْجُوْهُ"
    },
    {
      "kind": "text",
      "ar": "فِيْكَ وَفِيْ أَوْلِيَائِكَ، يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِلَيْكَ وَجَّهْتُ وَجْهِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ خَلَّفْتُ أَهْلِيْ وَمَالِيْ وَمَا خَوَّلْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ وَثِقْتُ بِكَ، فَلَا تُخَيِّبْنِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يُخَيِّبُ مَنْ أَرَادَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُضَيِّعُ مَنْ حَفِظَهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْنِيْ فِيْمَا غِبْتُ عَنْهُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَكِلْنِيْ اِلٰي نَفْسِيْ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّي اشْتَرَيْتُ بِهٰذِهِ الصَّدَقَةِ"
    },
    {
      "kind": "text",
      "ar": "سَلَامَتِيْ وَسَلَامَةَ سَفَرِيْ وَمَا مَعِيْ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ احْفَظْنِيْ وَاحْفَظْ مَا مَعِيَ"
    },
    {
      "kind": "text",
      "ar": "وَسَلِّمْنِيْ وَسَلِّمْ مَا مَعِيَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْنِيْ وَبَلِّغْ مَا مَعِيَ بِبَلَاغِكَ الْحَسَنِ الْجَمِيْلِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ هٰذِهٖ طِيْنَةُ قَبْرِ الْحُسَيْنِ وَلِيِّكَ وَابْنِ وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "اتَّخَذْتُهَا حِرْزًا لِمَا أَخَافُ وَمَا لَا أَخَافُ۔"
    },
    {
      "kind": "text",
      "ar": "مَاشَآءَ اللهُ، لَا قُوَّةَ اِلَّا بِاللّٰهِ، اَسْتَغْفِرُ اللهَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ مَسِيْرِيْ عَبْرًا"
    },
    {
      "kind": "text",
      "ar": "وَصُمْتِيْ تَفَكُّرًا، وَكَلَامِيْ ذِكْرًا۔"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ، وَبِاللّٰهِ، وَمِنَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَي اللهِ، وَفِيْ سَبِيْلِ اللهِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِلَيْكَ أَسْلَمْتُ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ وَجَّهْتُ وَجْهِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ فَوَّضْتُ أَمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاحْفَظْنِيْ بِحِفْظِ الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "مِنْ بَيْنِ يَدَيَّ، وَمِنْ خَلْفِيْ، وَعَنْ يَمِيْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَنْ شِمَالِيْ، وَمِنْ فَوْقِيْ، وَمِنْ تَحْتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَادْفَعْ عَنِّيْ بِحَوْلِكَ وَقُوَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ لَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ۔"
    },
    {
      "kind": "text",
      "ar": "مِنْ شَرَفِ الْاِنْسَانِ فِي الْاَسْفَارِ، تَطْيِيْبُهُ الزَّادَ مَعَ الْاِكْثَارِ"
    },
    {
      "kind": "text",
      "ar": "وَلْيُحْسِنِ الْاِنْسَانُ فِيْ حَالِ السَّفَرِ، أَخْلَاقَةُ زِيَادَةً عَلَي الْحَضَرِ"
    },
    {
      "kind": "text",
      "ar": "وَلْيَدْعُ عِنْدَ الْوَضْعِ لِلْخِوَانِ، مَنْ كَانَ حَاضِرًا مِنَ الْاِخْوَانِ"
    },
    {
      "kind": "text",
      "ar": "وَلْيُكْثِرِ الْمَزْحَ مَعَ الصَّحْبِ اِذَا، لَمْ يُسْخِطِ اللهَ وَلَمْ يَجْلِبْ أَذٰي"
    },
    {
      "kind": "text",
      "ar": "مَنْ جَاءَ بَلْدَةً فَذَا ضَيْفٌ عَلٰي، اِخْوَانِهٖ فِيْهَا اِلٰي أَنْ يَرْحَلَا"
    },
    {
      "kind": "text",
      "ar": "يُبَرُّ لَيْلَتَيْنِ ثُمَّ ليَأْكُلِ، مِنْ أَكْلِ أَهْلِ الْبَيْتِ فِي الْمُسْتَقْبِلِ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ اللهِ وَالْحَمْدُ لِلّٰهِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا اِلٰهَ اِلَّا اللهُ وَاللهُ اَكْبَرُ"
    }
  ]
}