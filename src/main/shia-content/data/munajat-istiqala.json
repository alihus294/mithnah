{
  "id": "munajat-istiqala",
  "title": "مناجات استقاله",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "مناجات استقاله",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ الرَّجَاءَ لِسَعَةِ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "اَنْطَقَنِيْ بِاسْتِقَالَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَمَلَ لِاَنَاتِكَ وَرِفْقِكَ"
    },
    {
      "kind": "text",
      "ar": "شَجَّعَنِيْ عَلٰي طَلَبِ أَمَانِكَ وَعَفْوِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلِيْ يَا رَبِّ ذُنُوْبٌ قَدْ وَاجَهَتْهَا أَوْجُهُ الْاِنْتِقَامِ"
    },
    {
      "kind": "text",
      "ar": "وَخَطَايَا قَدْ لَاحَظَتْهَا أَعْيُنُ الْاِصْطِلَامِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَوْجَبْتُ بِهَا عَلٰي عَدْلِكَ أَلِيْمَ الْعَذَابِ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَحْقَقْتُ بِاجْتِرَاحِهَا مُبِيْرَ الْعِقَابِ"
    },
    {
      "kind": "text",
      "ar": "وَخِفْتُ تَعْوِيْقَهَا لِاِجَابَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَرَدَّهَا اِيَّايَ عَنْ قَضَاءِ حَاجَتِيْ"
    },
    {
      "kind": "text",
      "ar": "بِاِبْطَالِهَا لِطَلِبَتِيْ وَقَطْعَهَا لِأَسْبَابِ رَغْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "مِنْ أَجْلِ مَا قَدْ أَنْقَضَ ظَهْرِيْ مِنْ ثِقْلِهَا"
    },
    {
      "kind": "text",
      "ar": "وَبَهَظَنِيْ مِنَ الْاِسْتِقْلَالِ بِحَمْلِهَا"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ تَرَاجَعْتُ رَبِّ اِلٰي حِلْمِكَ عَنِ الْخَاطِيِئنَ"
    },
    {
      "kind": "text",
      "ar": "وَعَفْوِكَ عَنِ الْمُذْنِبِيْنَ وَرَحْمَتِكَ لِلْعَاصِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَأَقْبَلْتُ بِثِقَتِيْ مُتَوَكِّلًا عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "طَارِحًا نَفْسِيْ بَيْنَ يَدَيكَ"
    },
    {
      "kind": "text",
      "ar": "شَاكِيًا بَثِّيْ اِلَيْكَ سَائِلًا رَبِّ"
    },
    {
      "kind": "text",
      "ar": "مَا لَا أَسْتَوْجِبُهُ مِنْ تَفْرِيْجِ الْهَمِّ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَسْتَحِقُّهٗ مِنْ تَنْفِيْسِ الْغَمِّ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَقِيْلًا لَكَ رَبِّ"
    },
    {
      "kind": "text",
      "ar": "اِيَّايَ وَاثِقًا مَوْلَايَ بِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَامْنُنْ عَلَيَّ بِالْفَرَجِ"
    },
    {
      "kind": "text",
      "ar": "وَتَطَوَّلْ عَلَيَّ بِسُهُوْلَةِ الْمَخْرَجِ"
    },
    {
      "kind": "text",
      "ar": "وَادْلُلْنِيْ بِرَأْفَتِكَ عَلٰي سَمْتِ الْمَنْهَج"
    },
    {
      "kind": "text",
      "ar": "وَأَزْلِقْنِيْ بِقُدْرَتِكَ عَنِ الطَّرِيْقِ الْاَعْوَجِ"
    },
    {
      "kind": "text",
      "ar": "وَخَلِّصْنِيْ مِنْ سِجْنِ الْكَرْبِ بِاِقَالَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَطْلِقْ أَسْرِيْ بِرَحْمَتِك"
    },
    {
      "kind": "text",
      "ar": "وَطُلْ عَلَيَّ بِرِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجُدْ عَلَيَّ بِاِحْسَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَقِلْنِيْ رَبِّ عَثْرَتِيْ وَفَرِّجْ كُرْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْ عَبْرَتِيْ وَلَا تَحْجُبْ دَعْوَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاشْدُدْ بِالْاِقَالَةِ أَزْرِيْ وَقَوِّ بِهَا ظَهْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْلِحْ بِهَا أَمْرِيْ، وَأَطِلْ بِهَا عُمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْنِيْ يَوْمَ حَشْرِيْ وَوَقْتَ نَشْرِيْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ جَوَادٌ كَرِيْمٌ غَفُوْرٌ رَحِيْمٌ"
    }
  ]
}