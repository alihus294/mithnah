{
  "id": "sunday-ziarat-2",
  "title": "زيارت حضرت فاطمه زهرا روز اتوار",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت حضرت فاطمه زهرا روز اتوار",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكِ يَا مُمْتَحَنَةُ"
    },
    {
      "kind": "text",
      "ar": "امْتَحَنَكِ الَّذِيْ خَلَقَكِ"
    },
    {
      "kind": "text",
      "ar": "فَوَجَدَكِ لِمَا امْتَحَنَكِ صَابِرَةً"
    },
    {
      "kind": "text",
      "ar": "أَنَا لَكِ مُصَدِّقٌ"
    },
    {
      "kind": "text",
      "ar": "صَابِرٌ عَلٰي مَا أَتٰي بِهٖ أَبُوْكِ وَوَصِيُّهٗ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْهِمَا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا أَسْأَلُكِ اِنْ كُنْتُ صَدَّقْتُكِ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا أَلْحَقْتِنِيْ بِتَصْدِيْقِيْ لَهُمَا لِتُسَرَّ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاشْهَدِيْ أَنِّيْ طَاهِرٌ بِوَلَايَتِكِ وَوَلَايَةِ اٰلِ بَيْتِكِ"
    },
    {
      "kind": "text",
      "ar": "صَلَوَاتُ اللهِ عَلَيْهِم اجْمَعِيْنَ"
    }
  ]
}