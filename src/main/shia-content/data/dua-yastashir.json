{
  "id": "dua-yastashir",
  "title": "دعاء يستشير",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء يستشير",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ لَا اِلٰهَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "الْمَلِكُ الْحَقُّ الْمُبِيْنُ"
    },
    {
      "kind": "text",
      "ar": "الْمُدَبِّرُ بِلَا وَزِيْرٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا خَلْقٍ مِنْ عِبَادِهٖ يَسْتَشِيْرُ"
    },
    {
      "kind": "text",
      "ar": "الْاَوَّلُ غَيْرُ مَوْصُوْفٍ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَاقِيْ بَعْدَ فَنَاءِ الْخَلْقِ"
    },
    {
      "kind": "text",
      "ar": "الْعَظِيْمُ الرُّبُوْبِيَّةِ، نُوْرُ السَّمَاوَاتِ وَالْأَرَضِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَفَاطِرُهُمَا وَمُبْتَدِعُهُمَا بِغَيْرِ عَمَدٍ"
    },
    {
      "kind": "text",
      "ar": "خَلَقَهُمَا وَفَتَقَهُمَا فَتْقًا"
    },
    {
      "kind": "text",
      "ar": "فَقَامَتِ السَّمَاوَاتُ طَائِعَاتٍ بِأَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَقَرَّتِ الْأَرَضُوْنَ بِأَوْتَادِهَا فَوْقَ الْمَاءِ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ عَلَا رَبُّنَا فِي السَّمَاوَاتِ الْعُلٰي"
    },
    {
      "kind": "text",
      "ar": "الرَّحْمٰنُ علَي الْعَرْشِ اسْتَوٰي"
    },
    {
      "kind": "text",
      "ar": "لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "وَمَا بَيْنَهُمَا وَمَا تَحْتَ الثَّرٰي"
    },
    {
      "kind": "text",
      "ar": "فَأَنَا أَشْهَدُ بِأَنَّكَ أَنْتَ اللهُ"
    },
    {
      "kind": "text",
      "ar": "لَا رَافِعَ لِمَا وَضَعْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا وَاضِعَ لِمَا رَفَعْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُعِزَّ لِمَنْ أَذْلَلْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُذِلَّ لِمَنْ أَعْزَزْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مَانِعَ لِمَا أَعْطَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مُعْطِيَ لِمَا مَنَعْتَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "كُنْتَ اِذْ لَمْ تَكُنْ سَمَاءٌ مَبْنِيَّةٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَرْضٌ مَدْحِيَّةٌ، وَلَا شَمْسٌ مُضِيْئَةٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا لَيْلٌ مُظْلِمٌ، وَلَا نَهَارٌ مُضِيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بَحْرٌ لُجِّيٌّ، وَلَا جَبَلٌ رَاسٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا نَجْمٌ سَارٍ، وَلَا قَمَرٌ مُنِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَلَا رِيْحٌ تَهُبُّ، وَلَا سَحَابٌ يَسْكُبُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بَرْقٌ يَلْمَعُ، وَلَا رَعْدٌ يُسَبِّحُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا رُوْحٌ تَنَفَّسُ، وَلَا طَائِرٌ يَطِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا نَارٌ تَتَوَقَّدُ، وَلَا مَاءٌ يَطَّرِدُ"
    },
    {
      "kind": "text",
      "ar": "كُنْتَ قَبْلَ كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَكَوَّنْتَ كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَقَدَرْتَ عَلٰي كُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَابْتَدَعْتَ كُلَّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَغْنَيْتَ وَأَفْقَرْتَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَتَّ وَأَحْيَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَأَضْحَكْتَ وَأَبْكَيْتَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي الْعَرْشِ اسْتَوَيْتَ"
    },
    {
      "kind": "text",
      "ar": "فَتَبَارَكْتَ يَا اللهُ وَتَعَالَيْتَ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ اللهُ الَّذِيْ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "الْخَلَّاقُ الْمُعِيْنُ"
    },
    {
      "kind": "text",
      "ar": "أَمْرُكَ غَالِبٌ، وَعِلْمُكَ نَافِذٌ"
    },
    {
      "kind": "text",
      "ar": "وَكَيْدُكَ غَرِيْبٌ، وَوَعْدُكَ صَادِقٌ"
    },
    {
      "kind": "text",
      "ar": "وَقَوْلُكَ حَقٌّ، وَحُكْمُكَ عَدْلٌ"
    },
    {
      "kind": "text",
      "ar": "وَكَلَامُكَ هُدًى، وَوَحْيُكَ نُوْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَتُكَ وَاسِعَةٌ، وَعَفْوُكَ عَظِيْمٌ"
    },
    {
      "kind": "text",
      "ar": "وَفَضْلُكَ كَثِيْرٌ، وَعَطَاؤُكَ جَزِيْلٌ"
    },
    {
      "kind": "text",
      "ar": "وَحَبْلُكَ مَتِيْنٌ، وَاِمْكَانُكَ عَتِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "وَجَارُكَ عَزِيْزٌ، وَبَأسُكَ شَدِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "وَمَكْرُكَ مَكِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ يَا رَبِّ مَوْضِعُ كُلِّ شَكْوٰي"
    },
    {
      "kind": "text",
      "ar": "حَاضِرُ كُلِّ مَلَاءٍ"
    },
    {
      "kind": "text",
      "ar": "وَشَاهِدُ كُلِّ نَجْوٰي"
    },
    {
      "kind": "text",
      "ar": "مُنْتَهٰي كُلِّ حَاجَةٍ"
    },
    {
      "kind": "text",
      "ar": "مُفَرِّجُ كُلِّ حُزْنٍ"
    },
    {
      "kind": "text",
      "ar": "غِنٰي كُلِّ مِسْكِيْنٍ"
    },
    {
      "kind": "text",
      "ar": "حِصْنُ كُلِّ هَارِبٍ"
    },
    {
      "kind": "text",
      "ar": "أَمَانُ كُلِّ خَائِفٍ"
    },
    {
      "kind": "text",
      "ar": "حِرْزُ الضُّعَفَاءِ، كَنْزُ الْفُقَرَاءِ"
    },
    {
      "kind": "text",
      "ar": "مُفَرِّجُ الْغَمَّاءِ، مُعِيْنُ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "ذٰلِكَ اللهُ رَبُّنَا لَا اِلٰهَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "تَكْفِيْ مِنْ عِبَادِكَ مَنْ تَوَكَّلَ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ جَارُ مَنْ لَاذَ بِكَ وَتَضَرَّعَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "عِصْمَةُ مَنِ اعْتَصَمَ بِكَ"
    },
    {
      "kind": "text",
      "ar": "نَاصِرُ مَنِ انْتَصَرَ بِكَ"
    },
    {
      "kind": "text",
      "ar": "تَغْفِرُ الذُّنُوْبَ لِمَنِ اسْتَغْفَرَكَ"
    },
    {
      "kind": "text",
      "ar": "جَبَّارُ الْجَبَابِرَةِ"
    },
    {
      "kind": "text",
      "ar": "عَظِيْمُ الْعُظَمَاءِ، كَبِيْرُ الْكُبَرَاءِ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدُ السَّادَاتِ، مَوْلَي الْمَوَالِيْ"
    },
    {
      "kind": "text",
      "ar": "صَرِيْخُ المُسْتَصْرِخِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مُنَفِّسٌ عَنِ الْمَكْرُوْبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مُجِيْبُ دَعْوَةِ الْمُضْطَرِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَسْمَعُ السَّامِعِيْنَ، أَبْصَرُ النَّاظِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَحْكَمُ الْحَاكِمِيْنَ، أَسْرَعُ الْحَاسِبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَرْحَمُ الرَّاحِمِيْنَ، خَيْرُ الْغَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "قَاضِيْ حَوَائِجِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "مُغِيْثُ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ رَبُّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَنْتَ الْخَالِقُ وَأَنَا الْمَخْلُوْقُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمَالِكُ وَأَنَا الْمَمْلُوْكُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الرَّبُّ وَأَنَا الْعَبْدُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الرَّازِقُ وَأَنَا الْمَرْزُوْقُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُعْطِيْ وَأَنَا السَّآئِلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْجَوَادُ وَأَنَا الْبَخِيْلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْقَوِيُّ وَأَنَا الضَّعِيْفُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْعَزِيْزُ وَأَنَا الذَّلِيْلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْغَنِيُّ و أَنَا الْفَقِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ السَّيِّدُ وَأَنَا الْعَبْدُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْغَافِرُ وَأَنَا الْمُسِيْءُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْعَالِمُ وَأَنَا الْجَاهِلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْحَلِيْمُ وَأَنَا الْعَجُوْلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الرَّحْمٰنُ وَأَنَا الْمَرْحُوْمُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُعَافِيْ وَأَنَا الْمُبْتَلٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُجِيْبُ وَأَنَا الْمُضْطَرُّ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَا أَشْهَدُ بِأَنَّكَ أَنْتَ اللهُ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "الْمُعْطِيْ عِبَادَكَ بِلَا سُؤَالٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ بِأَنَّكَ أَنْتَ اللهُ الْوَاحِدُ الْاَحَدُ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَفَرِّدُ الصَّمَدُ الْفَرْدُ، وَاِلَيْكَ الْمَصِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْلِ بَيْتِهِ الطَّيِّبِيْنَ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْلِيْ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتُرْ عَلَيَّ عُيُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَافْتَحْ لِيْ مِنْ لَدُنْكَ رَحْمَةً وَرِزْقًا وَاسِعًا"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَحَسْبُنَا اللّٰهُ وَنِعْمَ الْوَكِيْلُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ۔"
    }
  ]
}