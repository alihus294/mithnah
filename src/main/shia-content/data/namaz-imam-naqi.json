{
  "id": "namaz-imam-naqi",
  "title": "نماز حضرت امام علي نقي",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز حضرت امام علي نقي",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "يَا بَارُّ، يَا وَصُوْلُ، يَا شَاهِدَ كُلِّ غَائِبٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَا قَرِيْبُ غَيْرَ بَعِيْدٍ، وَيَا غَالِبُ غَيْرَ مَغْلُوْبٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَا مَنْ لَا يَعْلَمُ كَيْفَ هُوَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا تُبْلَغُ قُدْرَتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ اَللّٰهُمَّ بِاسْمِكَ الْمَكْنُوْنِ الْمَخْزُوْنِ"
    },
    {
      "kind": "text",
      "ar": "الْمَكْتُوْمِ عَمَّنْ شِئْتَ"
    },
    {
      "kind": "text",
      "ar": "الطَّاهِرِ الْمُطَهَّرِ الْمُقَدَّسِ النُّوْرِ التَّامِّ الْحَيِّ الْقَيُّوْمِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "نُوْرِ السَّمَاوَاتِ وَنُوْرِ الْاَرَضِيْنَ"
    },
    {
      "kind": "text",
      "ar": "عَالِمِ الْغَيْبِ وَالشَّهَادَةِ الْكَبِيْرِ الْمُتَعَالِ الْعَظِيْمِ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    }
  ]
}