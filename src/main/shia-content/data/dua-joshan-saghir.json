{
  "id": "dua-joshan-saghir",
  "title": "دعاء جوشن صغير",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء جوشن صغير",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ كَمْ مِنْ عَدُوٍّ انْتَضٰي عَلَيَّ سَيْفَ عَدَاوَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَشَحَذَ لِيْ ظُبَةَ مِدْيَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْهَفَ لِيْ شَبَا حَدِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَدَافَ لِيْ قَوَاتِلَ سُمُوْمِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَدَّدَ اِلَيَّ صَوَائِبَ سِهَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ تَنَمْ عَنِّيْ عَيْنُ حِرَاسَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَضْمَرَ أَنْ يَسُوْمَنِي الْمَكْرُوْهَ"
    },
    {
      "kind": "text",
      "ar": "وَيُجَرِّعَنِيْ ذُعَافَ مَرَارَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "نَظَرْتَ اِلٰي ضَعْفِيْ عَنِ احْتِمَالِ الْفَوَادِحِ"
    },
    {
      "kind": "text",
      "ar": "وَعَجْزِيْ عَنِ الْاِنْتِصَارِ مِمَّنْ قَصَدَنِيْ بِمُحَارَبَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَوَحْدَتِيْ فِيْ كَثِيْرٍ مِمَّنْ نَاوَانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَرْصَدَ لِيْ فِيْمَا لَمْ أُعْمِلْ فِكْرِيْ فِي الْاِرْصَادِ لَهُمْ بِمِثْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَأَيَّدْتَنِيْ بِقُوَّتِكَ، وَشَدَدْتَ أَزْرِيْ بِنُصْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفَلَلْتَ لِيْ حَدَّهٗ وَخَذَلْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "بَعْدَ جَمْعِ عَدِيْدِهٖ وَحَشْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْلَيْتَ كَعْبِيْ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَوَجَّهْتَ مَا سَدَّدَ اِلَيَّ مِنْ مَكَائِدِهٖ اِلَيْه وَرَدَدْتَهٗ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَشْفِ غَلِيْلَهٗ، وَلَمْ تَبْرُدْ حَزَازَاتُ غَيْظِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ عَضَّ عَلَيَّ أَنَامِلَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَدْبَرَ مُوَلِّيًا قَدْ أَخْفَقَتْ سَرَايَاهُ"
    },
    {
      "kind": "text",
      "ar": "فَلَكَ الْحَمْدُ يَا رَبِّ"
    },
    {
      "kind": "text",
      "ar": "مِنْ مُقْتَدِرٍ لَا يُغْلَبُ، وَذِيْ أَنَاةٍ لَا يَعْجَل"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ لِنَعْمَائِكَ مِن الشَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلِاٰلَائِكَ مِنَ الذَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ وَكَمْ مِنْ بَاغٍ بَغَانِيْ بِمَكَائِدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَنَصَبَ لِيْ أَشْرَاكَ مَصَائِدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَوَكَّلَ بِيْ تَفَقُّدَ رِعَايَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَضْبَأَ اِلَيَّ اِضْبَاءَ السَّبُعِ لِطَرِيْدَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "انْتِظَارًا لِاِنْتِهَازِ فُرْصَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ يُظْهِرُ بَشَاشَةَ الْمَلَقِ"
    },
    {
      "kind": "text",
      "ar": "وَيَبْسُطُ وَجْهًا غَيْرَ طَلِقٍ"
    },
    {
      "kind": "text",
      "ar": "فَلَمّا رَأَيْتَ دَغَلَ سَرِيْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَقُبْحَ مَا انْطَوٰي عَلَيْهِ لِشَرِيْكِهٖ فِيْ مِلَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَصْبَحَ مُجْلِبًا لِيْ فِيْ بَغْيِهٖ أَرْكَسْتَهٗ لِاُمِّ رَأْسِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَتَيْتَ بُنْيَانَهٗ مِنْ أَسَاسِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَصَرَعْتَهٗ فِيْ زُبْيَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَرَدَّيْتَهٗ فِيْ مَهْوٰي حُفْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَ خَدَّهٗ طَبَقًا لِتُرَابِ رِجْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَشَغَلْتَهٗ فِيْ بَدَنِهٖ وَرِزْقِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَرَمَيْتَهٗ بِحَجَرِهٖ، وَخَنَقْتَهٗ بِوَتَرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَذَكَّيْتَهٗ بِمَشَاقِصِهٖ، وَكَبَبْتَهٗ لِمَنْخِرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَرَدَدْتَ كَيْدَهٗ فِيْ نَحْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَرَبَقْتَهٗ بِنَدَامَتِهٖ، وَفَسَأْتَهٗ بِحَسْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَاسْتَخْذَأَ وَتَضَائَلَ بَعْدَ نَخْوَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَانْقَمَعَ بَعْدَ اسْتِطَالَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "ذَلِيْلًا مَأْسُوْرًا فِيْ رِبْقِ حِبَالَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ كَانَ يُؤَمِّلُ أَنْ يَرَانِيْ فِيْهَا يَوْمَ سَطْوَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ كِدْتُ يَا رَبِّ لَوْ لَا رَحْمَتُكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ يَحُلَّ بِيْ مَا حَلَّ بِسَاحَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَلَكَ الْحَمْدُ يَا رَبِّ"
    },
    {
      "kind": "text",
      "ar": "مِنْ مُقْتَدِرٍ لَا يُغْلَبُ، وَذِيْ أَنَاةٍ لَا يَعْجَلُ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ لِنَعْمَائِكَ مِنَ الشَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلِاٰلَائِكَ مِنَ الذَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ وَكَمْ مِنْ حَاسِدٍ شَرِقَ بِحَسْرَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَدُوٍّ شَجِيَ بِغَيْظِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَقَنِيْ بِحَدِّ لِسَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَوَخَزَنِيْ بِمُوْقِ عَيْنِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَنِيْ غَرَضًا لِمَرَامِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَقَلَّدَنِيْ خِلَالًا لَمْ تَزَلْ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "نَادَيْتُكَ يَا رَبِّ مُسْتَجِيْرًا بِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاثِقًا بِسُرْعَةِ اِجَابَتِكَ"
    },
    {
      "kind": "text",
      "ar": "مُتَوَكِّلًا عَلٰي مَا لَمْ أَزَلْ أَتَعَرَّفُهٗ مِنْ حُسْنِ دِفَاعِكَ"
    },
    {
      "kind": "text",
      "ar": "عَالِمًا أَنَّهٗ لَا يُضْطَهَدُ مَنْ أَوٰي اِلٰي ظِلِّ كَنَفِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَنْ تَقْرَعَ الْحَوَادِثُ مَنْ لَجَأَ اِلٰي مَعْقِلِ الْاِنْتِصَارِ بِكَ"
    },
    {
      "kind": "text",
      "ar": "فَحَصَّنْتَنِيْ مِنْ بَأْسِهٖ بِقُدْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَكَ الْحَمْدُ يَا رَبِّ"
    },
    {
      "kind": "text",
      "ar": "مِنْ مُقْتَدِرٍ لَا يُغْلَبُ، وَذِيْ أَنَاةٍ لَا يَعْجَلُ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ لِنَعْمَائِكَ مِنَ الشَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلِاٰلَائِكَ مِنَ الذَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ وَكَمْ مِنْ سَحَائِبِ مَكْرُوْهٍ جَلَّيْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَسَمَاءِ نِعْمَةٍ مَطَرْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَجَدَاوِلِ كَرَامَةٍ أَجْرَيْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَعْيُنِ أَحْدَاثٍ طَمَسْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَنَاشِيَةِ رَحْمَةٍ نَشَرْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَجُنَّةِ عَافِيَةٍ أَلْبَسْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَغَوَامِرِ كُرُبَاتٍ كَشَفْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَأُمُوْرٍ جَارِيَةٍ قَدَّرْتَهَا"
    },
    {
      "kind": "text",
      "ar": "لَمْ تُعْجِزْكَ اِذْ طَلَبْتَهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ تَمْتَنِعْ مِنْكَ اِذْ أَرَدْتَهَا"
    },
    {
      "kind": "text",
      "ar": "فَلَكَ الْحَمْدُ يَا رَبِّ"
    },
    {
      "kind": "text",
      "ar": "مِنْ مُقْتَدِرٍ لَا يُغْلَبُ، وَذِيْ أَنَاةٍ لَا يَعْجَلُ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ لِنَعْمَائِكَ مِنَ الشَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلِاٰلَائِكَ مِنَ الذَّاكِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهِيْ وَكَمْ مِنْ ظَنٍّ حَسَنٍ حَقَّقْتَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ كَسْرِ اِمْلَاقٍ جَبَرْتَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ مَسْكَنَةٍ فَادِحَةٍ حَوَّلْتَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ صَرْعَةٍ مُهْلِكَةٍ نَعَشْتَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ مَشَقَّةٍ أَرَحْتَ"
    },
    {
      "kind": "text",
      "ar": "لَا تُسْأَلُ عَمَّا تَفْعَلُ وَهُمْ يُسْأَلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَنْقُصُكَ مَا أَنْفَقْتَ"
    },
    {
      "kind": "text",
      "ar": "وَلَقَدْ سُئِلْتَ فَأَعْطَيْتَ، وَلَمْ تُسْأَلْ فَابْتَدَأْتَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتُمِيْحَ بَابُ فَضْلِكَ فَمَا أَكْدَيْتَ أَبَيْتَ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا اِنْعَامًا وَامْتِنَانًا وَاِلَّا تَطَوُّلًا يَا رَبِّ وَاِحْسَانًا"
    },
    {
      "kind": "text",
      "ar": "وَأَبَيْتُ اِلَّا انْتِهَاكًا لِحُرُمَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْتِرَاءً عَلٰي مَعَاصِيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَعَدِيًّا لِحُدُوْدِكَ، وَغَفْلَةً عَنْ وَعِيْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَطَاعَةً لِعَدُوِّيْ وَعَدُوِّكَ"
    },
    {
      "kind": "text",
      "ar": "لَمْ يَمْنَعْكَ يَا اِلٰهِيْ وَنَاصِرِيْ"
    },
    {
      "kind": "text",
      "ar": "اِخْلَالِيْ بِالشُّكْرِ  عَنْ اِتْمَامِ اِحْسَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَجَزَنِيْ ذٰلِكَ عَنِ ارْتِكَابِ مَسَاخِطِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَهٰذَا مَقَامُ عَبْدٍ ذَلِيْلٍ اعْتَرَفَ لَكَ بِالتَّوْحِيْدِ"
    },
    {
      "kind": "text",
      "ar": "وَأَقَرَّ عَلٰي نَفْسِهٖ بِالتَّقْصِيْرِ فِيْ أَدَاءِ حَقِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَشَهِدَ لَكَ بِسُبُوْغِ نِعْمَتِكَ عَلَيْهِ"
    },
    {
      "kind": "text",
