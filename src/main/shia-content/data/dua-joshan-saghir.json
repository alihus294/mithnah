    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ عُدْ عَلٰي جَهْلِيْ بِحِلْمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي فَقْرِيْ بِغِنَاكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي ذُلِّيْ بِعِزِّكَ وَسُلْطَانِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي ضَعْفِيْ بِقُوَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي خَوْفِيْ بِأَمْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي ذُنُوْبِيْ وَخَطَايَايَ بِعَفْوِكَ وَرَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَحْمٰنُ يَا رَحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَدْرَأُ بِكَ فِيْ نَحْرِ فُلَانِ بْنِ فُلَان"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذُ بِكَ مِنْ شَرِّهٖ"
    },
    {
      "kind": "text",
      "ar": "فَاكْفِنِيْهِ بِمَا كَفَيْتَ بِهٖ أَنْبِيَائَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْ لِيَائَكَ مِنْ خَلْقِكَ، وَصَالِحِيْ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ فَرَاعِنَةِ خَلْقِكَ، وَطُغَاةِ عُدَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَشَرِّ جَمِيْعِ خَلْقِكَ، بِرَحْمَتِكَ يَا أَرْحَمَ الرّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَحَسْبُنَا اللهُ وَنِعْمَ الْوَكِيْلُ"
    }
  ]
}