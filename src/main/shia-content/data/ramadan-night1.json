{
  "id": "ramadan-night1",
  "title": "يكم رمضان كي رات",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "يكم رمضان كي رات",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ يَا مَنْ يَمْلِكُ التَّدْبِيْرَ"
    },
    {
      "kind": "text",
      "ar": "وَهُوَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ يَعْلَمُ خَائِنَةَ الْاَعْيُنِ وَمَا تُخْفِي الصُّدُوْرُ"
    },
    {
      "kind": "text",
      "ar": "وَتُجِنُّ الضَّمِيْرُ وَهُوَ اللَّطِيْفُ الْخَبِيْرُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنَا مِمَّنْ نَوٰي فَعَمِلَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْنَا مِمَّنْ شَقِيَ فَكَسِلَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا مِمَّنْ هُوَ عَلٰي غَيْرِ عَمَلٍ يَتَّكِلُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَحِّحْ أَبْدَانَنَا مِنَ الْعِلَلِ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِنّا عَلٰي مَا افْتَرَضْتَ عَلَيْنَا مِنَ الْعَمَلِ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي يَنْقَضِيَ عَنَّا شَهْرُكَ هٰذَا"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ أَدَّيْنَا مَفْرُوْضَكَ فِيْهِ عَلَيْنَا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعِنّا عَلٰي صِيَامِهٖ، وَوَفِّقْنَا لِقِيَامِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَنَشِّطْنَا فِيْهِ لِلصَّلَاةِ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَحْجُبْنَا مِنَ الْقِرَائَةِ"
    },
    {
      "kind": "text",
      "ar": "وَسَهِّلْ لَنَا فِيْهِ اِيْتَاءَ الزَّكَاةِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تُسَلِّطْ عَلَيْنَا وَصَبًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَعَبًا وَلَا سَقَمًا وَلَا عَطَبًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنَا الْاِفْطَارَ مِنْ رِزْقِكَ الْحَلَالِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ سَهِّلْ لَنَا فِيْهِ مَا قَسَمْتَهٗ مِنْ رِزْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَيَسِّرْ مَا قَدَّرْتَهٗ مِنْ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ حَلَالًا طَيِّبًا نَقِيًّا مِنَ الْاٰثَامِ"
    },
    {
      "kind": "text",
      "ar": "خَالِصًا مِنَ الْاٰصَارِ وَالْاَجْرَامِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تُطْعِمْنَا اِلَّا طَيِّبًا غَيْرَ خَبِيْثٍ وَلَا حَرَامٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ رِزْقَكَ لَنَا حَلَالًا"
    },
    {
      "kind": "text",
      "ar": "لَا يَشُوْبُهٗ دَنَسٌ وَلَا أَسْقَامٌ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ عِلْمُهٗ بِالسِّرِّ كَعِلْمِهٖ بِالْاِعْلَانِ"
    },
    {
      "kind": "text",
      "ar": "يَا مُتَفَضِّلًا عَلٰي عِبَادِهٖ بِالْاِحْسَانِ"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ هُوَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِكُلِّ شَيْءٍ عَلِيْمٌ خَبِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "أَلْهِمْنَا ذِكْرَكَ، وَجَنِّبْنَا عُسْرَكَ، وَأَنِلْنَا يُسْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاهْدِنَا لِلرَّشَادِ، وَوَفِّقْنَا لِلسَّدَادِ"
    },
    {
      "kind": "text",
      "ar": "وَاعْصِمْنَا مِنَ الْبَلَايَا"
    },
    {
      "kind": "text",
      "ar": "وَصُنَّا مِنَ الْاَوْزَارِ وَالْخَطَايَا"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ لَا يَغْفِرُ عَظِيْمَ الذُّنُوْبِ غَيْرُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَكْشِفُ السُّوْءَ اِلَّا هُوَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرّاحِمِيْنَ وَأَكْرَمَ الْاَكْرَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهِ الطَّيِّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ صِيَامَنَا مَقْبُوْلًا"
    },
    {
      "kind": "text",
      "ar": "وَبِالْبِرِّ وَالتَّقْوٰي مَوْصُوْلًا"
    },
    {
      "kind": "text",
      "ar": "وَكَذٰلِكَ فَاجْعَلْ سَعْيَنَا مَشْكُوْرًا، وَقِيَامَنَا مَبْرُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَقُرْاٰنَنَا مَرْفُوْعًا، وَدُعَائَنَا مَسْمُوْعًا"
    },
    {
      "kind": "text",
      "ar": "وَاهْدِنَا لِلْحُسْنٰي، وَجَنِّبْنَا الْعُسْرٰي، وَيَسِّرْنَا لِلْيُسْرٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَعْلِ لَنَا الدَّرَجَاتِ، وَضَاعِفْ لَنَا الْحَسَنَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْبَلْ مِنَّا الصَّوْمَ وَالصَّلَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْمَعْ مِنَّا الدَّعَوَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِرْ لَنَا الْخَطِيْئَاتِ، وَتَجَاوَزْ عَنَّا السَّيِّئَاتِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا مِنَ الْعَامِلِيْنَ الْفَائِزِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْنَا مِنَ الْمَغْضُوْبِ عَلَيْهِمْ وَلَا الضَّالِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي يَنْقَضِيَ شَهْرُ رَمَضَانَ عَنَّا"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ قَبِلْتَ فِيْهِ صِيَامَنَا وَقِيَامَنَا"
    },
    {
      "kind": "text",
      "ar": "وَزَكَّيْتَ فِيْهِ أَعْمَالَنَا، وَغَفَرْتَ فِيْهِ ذُنُوْبَنَا"
    },
    {
      "kind": "text",
      "ar": "وَأَجْزَلْتَ فِيْهِ مِنْ كُلِّ خَيْرٍ نَصِيْبَنَا"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ الْاِلٰهُ الْمُجِيْبُ، وَالرَّبُّ الْقَرِيْبُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ بِكُلِّ شَيْءٍ مُحِيْطٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّ شَهْرِ رَمَضَانَ، مُنَزِّلَ الْقُرْاٰنِ"
    },
    {
      "kind": "text",
      "ar": "هٰذَا شَهْرُ رَمَضَانَ الَّذِيْ أَنْزَلْتَ فِيْهِ الْقُرْاٰنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزَلْتَ فِيْهِ اٰيَاتٍ بَيِّنَاتٍ مِنَ الْهُدٰي وَالْفُرْقَانِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنَا صِيَامَهٗ وَأَعِنَّا عَلٰي قِيَامِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ سَلِّمْهُ لَنَا، وَسَلِّمْنَا فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَتَسَلَّمْهُ مِنَّا فِيْ يُسْرٍ مِنْكَ وَمُعَافَاةٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ فِيْمَا تَقْضِيْ وَتُقَدِّرُ مِنَ الْاَمْرِ الْمَحْتُوْمِ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْمَا تَفْرُقُ مِنَ الْاَمْرِ الْحَكِيْمِ فِيْ لَيْلَةِ الْقَدْرِ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الْقَضَاءِ الَّذِيْ لَا يُرَدُّ وَلَا يُبَدَّلُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَكْتُبَنِيْ مِنْ حُجَّاجِ بَيْتِكَ الْحَرَامِ"
    },
    {
      "kind": "text",
      "ar": "الْمَبْرُوْرِ حَجُّهُمُ الْمَشْكُوْرِ سَعْيُهُمُ"
    },
    {
      "kind": "text",
      "ar": "الْمَغْفُوْرِ ذُنُوْبُهُمُ الْمُكَفَّرِ عَنْهُمْ سَيِّئَاتُهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ فِيْمَا تَقْضِيْ وَتُقَدِّرُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُطِيْلَ لِيْ فِيْ عُمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُوَسِّعَ عَلَيَّ مِنَ الرِّزْقِ الْحَلَالِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّهٗ قَدْ دَخَلَ شَهْرُ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّ شَهْرِ رَمَضَانَ الَّذِيْ أَنْزَلْتَ فِيْهِ الْقُرْاٰنَ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهٗ بَيِّنَاتٍ مِنَ الْهُدٰي وَالْفُرْقَانِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَبَارِكْ لَنَا فِيْ شَهْرِ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِنَّا عَلٰي صِيَامِهٖ وَصَلَوَاتِهٖ، وَتَقَبَّلْهُ مِنَّا"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ أَكْرَمَنَا بِكَ أَيُّهَا الشَّهْرُ الْمُبَارَكُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَقَوِّنَا عَلٰي صِيَامِنَا وَقِيَامِنَا"
    },
    {
      "kind": "text",
      "ar": "وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَي الْقَوْمِ الْكَافِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الْوَاحِدُ فَلَا وَلَدَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الصَّمَدُ فَلَا شِبْهَ لَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْعَزِيْزُ فَلَا يُعِزُّكَ شَيْءٌ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْغَنِيُّ وَأَنَا الْفَقِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمَوْلٰي وَأَنَا الْعَبْدُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْغَفُوْرُ وَأَنَا الْمُذْنِبُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الرَّحِيْمُ وَأَنَا الْمُخْطِئُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْخَالِقُ وَأَنَا الْمَخْلُوْقُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْحَيُّ وَأَنَا الْمَيِّتُ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِرَحْمَتِكَ أَنْ تَغْفِرَ لِيْ وَتَرْحَمَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَتَجَاوَزَ عَنِّيْ، اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَشْهَدُ أَنَّ هٰذَا كِتَابُكَ"
    },
    {
      "kind": "text",
      "ar": "الْمُنْزَلُ مِنْ عِنْدِكَ عَلٰي رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "مُحَمَّدِ بْنِ عَبْدِ اللهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَكَلَامُكَ النَّاطِقُ عَلٰي لِسَانِ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "جَعَلْتَهٗ هَادِيًا مِنْكَ اِلٰي خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَبْلًا مُتَّصِلًا فِيْمَا بَيْنَكَ وَبَيْنَ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ نَشَرْتُ عَهْدَكَ وَكِتَابَكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاجْعَلْ نَظَرِيْ فِيْهِ عِبَادَةً"
    },
    {
      "kind": "text",
      "ar": "وَقِرَائَتِيْ فِيْهِ فِكْرًا، وَفِكْرِيْ فِيْهِ اعْتِبَارًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِمَّنْ اتَّعَظَ بِبَيَانِ مَوَاعِظِكَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْتَنَبَ مَعَاصِيَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَطْبَعْ عِنْدَ قِرَائَتِيْ عَلٰي سَمْعِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْ عَلٰي بَصَرِيْ غِشَاوَةً"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْ قِرَائَتِيْ قِرَائَةً لَا تَدَبُّرَ فِيْهَا"
    },
    {
      "kind": "text",
      "ar": "بَلِ اجْعَلْنِيْ أَتَدَبَّرُ اٰيَاتِهٖ وَأَحْكَامَهٗ"
    },
    {
      "kind": "text",
      "ar": "اٰخِذًا بِشَرَائِعِ دِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْ نَظَرِيْ فِيْهِ غَفْلَةً وَلَا قِرَائَتِيْ هَذَرًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ أَنْتَ الرَّؤُوْفُ الرَّحِيْمُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ قَدْ قَرَأْتُ مَا قَضَيْتَ مِنْ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ أَنْزَلْتَهٗ عَلٰي نَبِيِّكَ الصَّادِقِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَلَكَ الْحَمْدُ رَبَّنَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْنِيْ مِمَّنْ يُحِلُّ حَلَالَهٗ وَيُحَرِّمُ حَرَامَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَيُؤْمِنُ بِمُحْكَمِهٖ وَمُتَشَابِهِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ لِيْ أُنْسًا فِيْ قَبْرِيْ وَأُنْسًا فِيْ حَشْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِمَّنْ تُرَقِّيْهِ بِكُلِّ اٰيَةٍ قَرَأَهَا دَرَجَةً فِيْ أَعْلٰي عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اٰمِيْنَ رَبَّ الْعَالَمِيْنَ"
    }
  ]
