{
  "id": "dua-hujjat-imam-reza",
  "title": "امام العصر كيلء دعا",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام العصر كيلء دعا",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ادْفَعْ عَنْ وَلِيِّكَ وَخَلِيْفَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَحُجَّتِكَ عَلٰي خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلِسَانِكَ الْمُعَبِّرِ عَنْكَ النَّاطِقِ بِحِكْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَيْنِكَ النَّاظِرَةِ بِاِذْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَشَاهِدِكَ عَلٰي عِبَادِكَ، الْجَحْجَاحِ الْمُجَاهِدِ"
    },
    {
      "kind": "text",
      "ar": "الْعَائِذِ بِكَ، الْعَابِدِ عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِذْهُ مِنْ شَرِّ جَمِيْعِ مَا خَلَقْتَ"
    },
    {
      "kind": "text",
      "ar": "وَبَرَأْتَ وَأَنْشَأْتَ وَصَوَّرْتَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْهُ مِنْ بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَنْ يَمِيْنِهٖ وَعَنْ شِمَالِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ فَوْقِهٖ وَمِنْ تَحْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "بِحِفْظِكَ الَّذِيْ لَا يَضِيْعُ مَنْ حَفِظْتَهٗ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْ فِيْهِ رَسُوْلَكَ وَاٰبَائَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَئِمَّتَكَ وَدَعَائِمَ دِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ فِيْ وَدِيْعَتِكَ الَّتِيْ لَا تَضِيْعُ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ جِوَارِكَ الَّذِيْ لَا يُخْفَرُ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ مَنْعِكَ وَعِزِّكَ الَّذِيْ لَا يُقْهَرُ"
    },
    {
      "kind": "text",
      "ar": "وَاٰمِنْهُ بِأَمَانِكَ الْوَثِيْقِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَا يُخْذَلُ مَنْ اٰمَنْتَهٗ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْهُ فِيْ كَنَفِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَا يُرَامُ مَنْ كَانَ فِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْهُ بِنَصْرِكَ الْعَزِيْز"
    },
    {
      "kind": "text",
      "ar": "وَأَيِّدْهُ بِجُنْدِكَ الْغَالِبِ"
    },
    {
      "kind": "text",
      "ar": "وَقَوِّهٖ بِقُوَّتِكَ، وَأَرْدِفْهُ بِمَلَائِكَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَالِ مَنْ وَالَاهُ، وَعَادِ مَنْ عَادَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْبِسْهُ دِرْعَكَ الْحَصِيْنَةَ"
    },
    {
      "kind": "text",
      "ar": "وَحُفَّهٗ بِالْمَلَائِكَةِ حَفًّا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اشْعَبْ بِهِ الصَّدْعَ"
    },
    {
      "kind": "text",
      "ar": "وَارْتُقْ بِهِ الْفَتْقَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمِتْ بِهِ الْجَوْرَ، وَأَظْهِرْ بِهِ الْعَدْلَ"
    },
    {
      "kind": "text",
      "ar": "وَزَيِّنْ بِطُوْلِ بَقَائِهِ الْاَرْضَ"
    },
    {
      "kind": "text",
      "ar": "وَأَيِّدْهُ بِالنَّصْرِ، وَانْصُرْهُ بِالرُّعْبِ"
    },
    {
      "kind": "text",
      "ar": "وَقَوِّ نَاصِرِيْهِ، وَاخْذُلْ خَاذِلِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَدَمْدِمْ مَنْ نَصَبَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَدَمِّرْ مَنْ غَشَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاقْتُلْ بِهٖ جَبَابِرَةَ الْكُفْرِ وَعُمُدَهٗ وَدَعَائِمَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاقْصِمْ بِهٖ رُؤُوْسَ الضَّلَالَةِ وَشَارِعَةَ الْبِدَعِ"
    },
    {
      "kind": "text",
      "ar": "وَمُمِيْتَةَ السُّنَّةِ وَمُقَوِّيَةَ الْبَاطِلِ"
    },
    {
      "kind": "text",
      "ar": "وَذَلِّلْ بِهِ الْجَبَّارِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَبِرْ بِهِ الْكَافِرِيْنَ وَجَمِيْعَ الْمُلْحِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ مَشَارِقِ الْاَرْضِ وَمَغَارِبِهَا"
    },
    {
      "kind": "text",
      "ar": "وَبَرِّهَا وَبَحْرِهَا وَسَهْلِهَا وَجَبَلِهَا"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا تَدَعَ مِنْهُمْ دَيَّارًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُبْقِيَ لَهُمْ اٰثَارًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ طَهِّرْ مِنْهُمْ بِلَادَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاشْفِ مِنْهُمْ عِبَادَكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِزَّ بِهِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحْيِ بِهٖ سُنَنَ الْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَدَارِسَ حُكْمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَجَدِّدْ بِهٖ مَا امْتَحٰي مِنْ دِيْنِكَ وَبُدِّلَ مِنْ حُكْمِكَ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تُعِيْدَ دِيْنَكَ بِهٖ وَعَلٰي يَدَيْهِ"
    },
    {
      "kind": "text",
      "ar": "جَدِيْدًا غَضًّا مَحْضًا صَحِيْحًا"
    },
    {
      "kind": "text",
      "ar": "لَا عِوَجَ فِيْهِ وَلَا بِدْعَةَ مَعَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَحَتّٰي تُنِيْرَ بِعَدْلِهٖ ظُلَمَ الْجَوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَتُطْفِئَ بِهٖ نِيْرَانَ الْكُفْرِ"
    },
    {
      "kind": "text",
      "ar": "وَتُوْضِحَ بِهٖ مَعَاقِدَ الْحَقِّ وَمَجْهُوْلَ الْعَدْلِ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ عَبْدُكَ الَّذِي اسْتَخْلَصْتَهٗ لِنَفْسِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاصْطَفَيْتَهٗ عَلٰي غَيْبِكَ"
    },
    {
      "kind": "text",
      "ar": "وَعَصَمْتَهٗ مِنَ الذُّنُوْبِ"
    },
    {
      "kind": "text",
      "ar": "وَبَرَّأْتَهٗ مِنَ الْعُيُوْبِ"
    },
    {
      "kind": "text",
      "ar": "وَطَهَّرْتَهٗ مِنَ الرِّجْسِ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَّمْتَهٗ مِنَ الدَّنَسِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاِنَّا نَشْهَدُ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "يَوْمَ الْقِيَامَةِ وَيَوْمَ حُلُوْلِ الطَّامَّةِ"
    },
    {
      "kind": "text",
      "ar": "أَنَّهٗ لَمْ يُذْنِبْ ذَنْبًا، وَلَا أَتٰي حُوْبًا"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَرْتَكِبْ مَعْصِيَةً"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يُضَيِّعْ لَكَ طَاعَةً"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَهْتِكْ لَكَ حُرْمَةً"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يُبَدِّلْ لَكَ فَرِيْضَةً"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يُغَيِّرْ لَكَ شَرِيْعَةً"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّهُ الْهَادِي الْمُهْتَدِي الطَّاهِرُ"
    },
    {
      "kind": "text",
      "ar": "التَّقِيُّ النَّقِيُّ الرَّضِيُّ الزَّكِيُّ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعْطِهٖ فِيْ نَفْسِهٖ وَأَهْلِهٖ وَوَلَدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَذُرِّيَّتِهٖ وَأُمَّتِهٖ وَجَمِيْعِ رَعِيَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "مَا تُقِرُّ بِهٖ عَيْنَهٗ وَتَسُرُّ بِهٖ نَفْسَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْمَعُ لَهٗ مُلْكَ الْمُمْلَكَاتِ كُلِّهَا"
    },
    {
      "kind": "text",
      "ar": "قَرِيْبِهَا وَبَعِيْدِهَا وَعَزِيْزِهَا وَذَلِيْلِهَا"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تُجْرِيَ حُكْمَهٗ عَلٰي كُلِّ حُكْمٍ"
    },
    {
      "kind": "text",
      "ar": "وَتَغْلِبَ بِحَقِّهٖ كُلَّ بَاطِلٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اسْلُكْ بِنَا عَلٰي يَدَيْهِ مِنْهَاجَ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "وَالْمَحَجَّةَ الْعُظْمٰي وَالطَّرِيْقَةَ الْوُسْطٰي"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ يَرْجِعُ اِلَيْهَا الْغَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَيَلْحَقُ بِهَا التَّالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَوِّنَا عَلٰي طَاعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَثَبِّتْنَا عَلٰي مُشَايَعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَامْنُنْ عَلَيْنَا بِمُتَابَعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا فِيْ حِزْبِهِ الْقَوَّامِيْنَ بِأَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "الصَّابِرِيْنَ مَعَهٗ"
    },
    {
      "kind": "text",
      "ar": "الطَّالِبِيْنَ رِضَاكَ بِمُنَاصَحَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تَحْشُرَنَا يَوْمَ الْقِيَامَةِ فِيْ أَنْصَارِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْوَانِهٖ وَمُقَوِّيَةِ سُلْطَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَاجْعَلْ ذٰلِكَ لَنَا خَالِصًا"
    },
    {
      "kind": "text",
      "ar": "مِنْ كُلِّ شَكٍّ وَشُبْهَةٍ وَرِيَاءٍ وَسُمْعَةٍ"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي لَا نَعْتَمِدَ بِهٖ غَيْرَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا نَطْلُبَ بِهٖ اِلَّا وَجْهَكَ"
    },
    {
      "kind": "text",
      "ar": "وَحَتّٰي تُحِلَّنَا مَحَلَّهٗ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلَنَا فِي الْجَنَّةِ مَعَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِذْنَا مِنَ السَّأْمَةِ وَالْكَسَلِ وَالْفَتْرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا مِمَّنْ تَنْتَصِرُ بِهٖ لِدِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتُعِزُّ بِهٖ نَصْرَ وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَسْتَبْدِلْ بِنَا غَيْرَنَا"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ اسْتِبْدَالَكَ بِنَا غَيْرَنَا"
    },
    {
      "kind": "text",
      "ar": "عَلَيْكَ يَسِيْرٌ وَهُوَ عَلَيْنَا كَثِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اللّٰهُمَّ صَلِّ عَلٰي وُلَاةِ عَهْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْاَئِمَّةِ مِنْ بَعْدِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْهُمْ اٰمَالَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَزِدْ فِيْ اٰجَالِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِزَّ نَصْرَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَتَمِّمْ لَهُمْ مَا أَسْنَدْتَ اِلَيْهِمْ مِنْ أَمْرِكَ لَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَثَبِّتْ دَعَائِمَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا لَهُمْ أَعْوَانًا وَعَلٰي دِيْنِكَ أَنْصَارًا"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهُمْ مَعَادِنُ كَلِمَاتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخُزَّانُ عِلْمِكَ، وَأَرْكَانُ تَوْحِيْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَائِمُ دِيْنِكَ، وَوُلَاةُ أَمْرِكَ"
    },
    {
