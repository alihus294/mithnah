{
  "id": "dua-noor",
  "title": "بخار سے شفايابي كي دعا",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "بخار سے شفايابي كي دعا",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ النُّوْرِ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ نُوْرِ النُّوْرِ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ نُوْرٌ عَلٰي نُوْرٍ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الَّذِيْ هُوَ مُدَبِّرُ الْاُمُوْرِ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الَّذِيْ خَلَقَ النُّوْرَ مِنَ النُّوْرِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ خَلَقَ النُّوْرَ مِنَ النُّوْرِ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْزَلَ النُّوْرَ عَلَي الطُّوْرِ"
    },
    {
      "kind": "text",
      "ar": "فِيْ كِتَابٍ مَسْطُوْرٍ، فِيْ رَقٍّ مَنْشُوْرٍ"
    },
    {
      "kind": "text",
      "ar": "بِقَدَرٍ مَقْدُوْرٍ، عَلٰي نَبِيٍّ مَحْبُوْرٍ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ الَّذِيْ هُوَ بِالْعِزِّ مَذْكُوْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَبِالْفَخْرِ مَشْهُوْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَي السَّرَّاءِ وَالضَّرَّاءِ مَشْكُوْرٌ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي سَيِّدِنَا مُحَمَّدٍ وَاٰلِهِ الطَّاهِرِيْنَ"
    }
  ]
}