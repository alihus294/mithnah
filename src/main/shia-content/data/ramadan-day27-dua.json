{
  "id": "ramadan-day27-dua",
  "title": "ستائيسويں دن كي دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ستائيسويں دن كي دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْزُقْنِيْ فِيْهِ فَضْلَ لَيْلَةِ الْقَدْرِ"
    },
    {
      "kind": "text",
      "ar": "وَصَيِّرْ أُمُوْرِيْ فِيْهِ مِنَ الْعُسْرِ اِلَي الْيُسْرِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْبَلْ مَعَاذِيْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَحُطَّ عَنِّي الذَّنْبَ وَالْوِزْرَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَؤُوْفًا بِعِبَادِهِ الصَّالِحِيْنَ"
    }
  ]
}