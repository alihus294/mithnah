    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ الصَّادِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنِيْ سُؤْلِيْ، وَاجْمَعْ شَمْلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلُمَّ شَعَثِيْ، وَزَكِّ عَمَلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُزِغْ قَلْبِيْ بَعْدَ اِذْ هَدَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُزِلْ قَدَمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَكِلْنِيْ اِلٰي نَفْسِيْ طَرْفَةَ عَيْنٍ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخَيِّبْ طَمَعِيْ، وَلَا تُبْدِ عَوْرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَهْتِكْ سِتْرِيْ، وَلَا تُوْحِشْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُؤْيِسْنِيْ، وَكُنْ بِيْ رَؤُوْفًا رَحِيْمًا"
    },
    {
      "kind": "text",
      "ar": "وَاهْدِنِيْ وَزَكِّنِيْ وَطَهِّرْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَصَفِّنِيْ وَاصْطَفِنِيْ وَخَلِّصْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَخْلِصْنِيْ وَاصْنَعْنِيْ وَاصْطَنِعْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَرِّبْنِيْ اِلَيْكَ، وَلَا تُبَاعِدْنِيْ مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْطُفْ بِيْ وَلَا تَجْفُنِيْ، وَأَكْرِمْنِيْ وَلَا تُهِنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَمَا أَسْأَلُكَ فَلَا تَحْرِمْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمَا لَاأَسْأَلُكَ فَاجْمَعْهُ لِيْ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وأَسْأَلُكَ بِحُرْمَةِ وَجْهِكَ الْكَرِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَبِحُرْمَةِ نَبِيِّكَ مُحَمَّدٍ صَلَوَاتُكَ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَبِحُرْمَةِ أَهْلِ بَيْتِ رَسُوْلِكَ أَمِيْرِ الْمُؤْمِنِيْنَ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "وَالْحَسَنِ وَالْحُسَيْنِ وَعَلِيٍّ وَمُحَمَّدٍ وَجَعْفَرٍ"
    },
    {
      "kind": "text",
      "ar": "وَمُوْسٰي وَعَلِيٍّ وَمُحَمَّدٍ وَعَلِيٍّ وَالْحَسَنِ"
    },
    {
      "kind": "text",
      "ar": "وَالْخَلَفِ الْبَاقِيْ صَلَوَاتُكَ وَبَرَكَاتُكَ عَلَيْهِمْ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلَيْهِمْ أَجْمَعِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَتُعَجِّلَ فَرَجَ قَائِمِهِمْ بِأَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَنْصُرَهٗ وَتَنْتَصِرَ بِهٖ لِدِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلَنِيْ فِيْ جُمْلَةِ النَّاجِيْنَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُخْلِصِيْنَ فِيْ طَاعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وأَسْأَلُكَ بِحَقِّهِمْ لَمَّا اسْتَجَبْتَ لِيْ دَعْوَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَضَيْتَ لِيْ حَاجَتِيْ، وَأَعْطَيْتَنِيْ سُؤْلِيْ"
    },
    {
      "kind": "text",
      "ar": "وَكَفَيْتَنِيْ مَا أَهَمَّنِيْ مِنْ أَمْرِ دُنْيَايَ وَاٰخِرَتِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ، يَا نُوْرُ يَا بُرْهَانُ"
    },
    {
      "kind": "text",
      "ar": "يَا مُنِيْرُ يَا مُبِيْنُ يَارَبِّ"
    },
    {
      "kind": "text",
      "ar": "اكْفِنِيْ شَرَّ الشُّرُوْرِ، وَاٰفَاتِ الدُّهُوْرِ"
    },
    {
      "kind": "text",
      "ar": "وأَسْأَلُكَ النَّجَاةَ يَوْمَ يُنْفَخُ فِي الصُّوْرِ"
    },
    {
      "kind": "text",
      "ar": "يَا عُدَّتِيْ عِنْدَ الْعُدَدِ"
    },
    {
      "kind": "text",
      "ar": "وَيَا رَجَائِيْ وَالْمُعْتَمَدَ، وَيَا كَهْفِيْ وَالسَّنَدَ"
    },
    {
      "kind": "text",
      "ar": "يَا وَاحِدُ يَا أَحَدُ، وَيَا قُلْ هُوَ اللهُ أَحَدٌ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ اَللّٰهُمَّ بِحَقِّ مَنْ خَلَقْتَ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ تَجْعَلْ فِيْ خَلْقِكَ مِثْلَهُمْ أَحَدًا"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي جَمَاعَتِهِمْ، وَافْعَلْ بِيْ كَذَا وَكَذَا"
    }
  ]
}