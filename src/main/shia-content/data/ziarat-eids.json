      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ اٰمَنْتَ بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "وَنَصَرْتَ ابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَدَعَوْتَ اِلٰي سَبِيْلِ اللهِ، وَوَاسَيْتَ بِنَفْسِكَ"
    },
    {
      "kind": "text",
      "ar": "فَعَلَيْكَ مِنَ اللهِ أَفْضَلُ التَّحِيَّةِ وَالسَّلَامِ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتَ وَأُمِّيْ يَا نَاصِرَ دِيْنِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نَاصِرَ الْحُسَيْنِ الصِّدِّيْقِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نَاصِرَ الْحُسَيْنِ الشَّهِيْدِ"
    },
    {
      "kind": "text",
      "ar": "عَلَيْكَ مِنِّي السَّلَامُ مَا بَقِيْتُ وَبَقِيَ اللَّيْلُ وَالنَّهَارُ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ سَلَامَ مُوَدِّعٍ لَا قَالٍ وَلَا سَئِمٍ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ أَنْصَرِفْ فَلَا عَنْ مَلَالَةٍ"
