    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَارِثَ اِبْرَاهِيْمَ خَلِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَارِثَ مُوْسٰي كَلِيْمِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَارِثَ عِيْسٰي رُوْحِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَارِثَ مُحَمَّدٍ حَبِيْبِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَارِثَ عَلِيٍّ حُجَّةِ اللهِ"
