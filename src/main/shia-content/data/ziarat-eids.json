    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ الْفَرْدِ الصَّمَدِ، الْمَاجِدِ الْاَحَدِ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَفَضِّلِ الْمَنَّانِ، الْمُتَطَوِّلِ الْحَنَّانِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ مِنْ تَطَوُّلِهٖ سَهَّلَ لِيْ زِيَارَةَ مَوْلَايَ بِاِحْسَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَجْعَلْنِيْ عَنْ زِيَارَتِهٖ مَمْنُوْعًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا عَنْ ذِمَّتِهٖ مَدْفُوْعًا، بَلْ تَطَوَّلَ وَمَنَحَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَارِثَ اٰدَمَ صَفْوَةِ اللهِ"
