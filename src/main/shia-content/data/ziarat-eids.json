    {
      "kind": "text",
      "ar": "اٰمِيْنَ رَبَّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا بَابَ الْمَقَامِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا شَرِيْكَ الْقُرْاٰنِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ الْخِصَامِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا سَفِيْنَةَ النَّجَاةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ يَا مَلَائِكَةَ رَبِّي الْمُقِيْمِيْنَ فِيْ هٰذَا الْحَرَمِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَبَدًا مَا بَقِيْتُ وَبَقِيَ اللَّيْلُ وَالنَّهَارُ"
    },
    {
      "kind": "text",
      "ar": "اِنَّا لِلّٰهِ وَاِنَّا اِلَيْهِ رَاجِعُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ الْعَلِيِّ الْعَظِيْمِ۔"
    }
  ]
