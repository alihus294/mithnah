      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "يَا مَوْلَايَ يَا أَبَا عَبْدِ اللهِ، يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "عَبْدُكَ وَابْنُ أَمَتِكَ، الذَّلِيْلُ بَيْنَ يَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُصَغَّرُ فِيْ عُلُوِّ قَدْرِكَ، وَالْمُعْتَرِفُ بِحَقِّكَ"
    },
    {
      "kind": "text",
      "ar": "جَاءَ كَ مُسْتَجِيْرًا بِكَ، قَاصِدًا اِلٰي حَرَمِكَ"
    },
    {
      "kind": "text",
      "ar": "مُتَوَجِّهًا اِلٰي مَقَامِكَ"
    },
    {
      "kind": "text",
      "ar": "مُتَوَسِّلًا اِلَي اللهِ تَعَالٰي بِكَ"
    },
    {
      "kind": "text",
      "ar": "ءَأَدْخُلُ يَا مَوْلَايَ، ءَأَدْخُلُ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "ءَأَدْخُلُ يَا مَلَائِكَةَ اللهِ الْمُحْدِقِيْنَ بِهٰذَا الْحَرَمِ"
    },
    {
      "kind": "text",
      "ar": "الْمُقِيْمِيْنَ فِيْ هٰذَا الْمَشْهَدِ۔"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ وَفِيْ سَبِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مِلَّةِ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْزِلْنِيْ مُنْزَلًا مُبَارَكًا وَأَنْتَ خَيْرُ الْمُنْزِلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اللهُ أَكْبَرُ كَبِيْرًا وَالْحَمْدُ لِلّٰهِ كَثِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ بُكْرَةً وَأَصِيْلًا"
