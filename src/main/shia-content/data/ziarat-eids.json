    {
      "kind": "text",
      "ar": "حَتّٰي سُفِكَ فِيْ طَاعَتِكَ دَمُهٗ وَاسْتُبِيْحَ حَرِيْمُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ الْعَنْهُمْ لَعْنًا وَبِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَعَذِّبْهُمْ عَذَابًا أَلِيْمًا"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ خَاتَمِ النَّبِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ فَاطِمَةَ سَيِّدَةِ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْمَظْلُوْمُ الشَّهِيْدُ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتَ وَأُمِّيْ"
    },
    {
      "kind": "text",
      "ar": "عِشْتَ سَعِيْدًا، وَقُتِلْتَ مَظْلُوْمًا شَهِيْدًا"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَيُّهَا الذَّابُّوْنَ عَنْ تَوْحِيْدِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ بِمَا صَبَرْتُمْ فَنِعْمَ عُقْبَي الدَّارِ"
    },
    {
      "kind": "text",
      "ar": "بِأَبِيْ أَنْتُمْ وَأُمِّيْ، فُزْتُمْ فَوْزًا عَظِيْمًا۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْعَبْدُ الصَّالِحُ"
