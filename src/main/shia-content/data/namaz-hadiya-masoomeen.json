{
  "id": "namaz-hadiya-masoomeen",
  "title": "نماز هديۂ معصومين",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز هديۂ معصومين",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ اَلسَّلَامُ وَمِنْكَ اَلسَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ يَعُوْدُ اَلسَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "حَيِّنَا رَبَّنَا مِنْكَ بِالسَّلَامِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنَّ هٰذِهِ الرَّكَعَاتِ هَدِيَّةٌ مِنَّا اِلٰي وَلِيِّكَ (فُلَان)"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلٰي مُحَمَّدٍ وَاٰلِهٖ وَبَلِّغْهُ اِيَّاهَا"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنِيْ أَفْضَلَ أَمَلِيْ وَرَجَائِيْ"
    },
    {
      "kind": "text",
      "ar": "فِيْكَ وَفِيْ رَسُوْلِكَ صَلَوَاتُكَ عَلَيْهِ وَاٰلِهٖ۔"
    }
  ]
}