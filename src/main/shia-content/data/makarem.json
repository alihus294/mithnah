{
  "id": "makarem",
  "title": "دعاء مكارم الأخلاق",
  "subtitle": "للإمام زين العابدين علي بن الحسين عليه السلام",
  "source": "الصحيفة السجادية، الدعاء العشرون",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "دعاء مكارم الأخلاق", "subtitle": "من الصحيفة السجادية" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ" },
    { "kind": "text", "ar": "وَبَلِّغْ بِإِيمانِي أَكْمَلَ الإِيمانِ" },
    { "kind": "text", "ar": "وَاجْعَلْ يَقِينِي أَفْضَلَ اليَقِينِ" },
    { "kind": "text", "ar": "وَانْتَهِ بِنِيَّتِي إِلَىٰ أَحْسَنِ النِّيَّاتِ" },
    { "kind": "text", "ar": "وَبِعَمَلِي إِلَىٰ أَحْسَنِ الأَعْمالِ" },
    { "kind": "text", "ar": "اللَّهُمَّ وَفِّرْ بِلُطْفِكَ نِيَّتِي" },
    { "kind": "text", "ar": "وَصَحِّحْ بِما عِنْدَكَ يَقِينِي" },
    { "kind": "text", "ar": "وَاسْتَصْلِحْ بِقُدْرَتِكَ ما فَسَدَ مِنِّي" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ" },
    { "kind": "text", "ar": "وَاكْفِنِي ما يَشْغَلُنِي الاِهْتِمامُ بِهِ" },
    { "kind": "text", "ar": "وَاسْتَعْمِلْنِي بِما تَسْأَلُنِي غَداً عَنْهُ" },
    { "kind": "text", "ar": "وَاسْتَفْرِغْ أَيَّامِي فِيما خَلَقْتَنِي لَهُ" },
    { "kind": "text", "ar": "وَأَغْنِنِي وَأَوْسِعْ عَلَيَّ فِي رِزْقِكَ" },
    { "kind": "text", "ar": "وَلا تَفْتِنِّي بِالنَّظَرِ، وَأَعِزَّنِي" },
    { "kind": "text", "ar": "وَلا تَبْتَلِيَنِّي بِالكِبْرِ، وَعَبِّدْنِي لَكَ" },
    { "kind": "text", "ar": "وَلا تُفْسِدْ عِبادَتِي بِالعُجْبِ" },
    { "kind": "text", "ar": "وَأَجْرِ لِلنَّاسِ عَلَىٰ يَدَيَّ الخَيْرَ" },
    { "kind": "text", "ar": "وَلا تَمْحَقْهُ بِالمَنِّ" },
    { "kind": "text", "ar": "وَهَبْ لِي مَعالِيَ الأَخْلاقِ" },
    { "kind": "text", "ar": "وَاعْصِمْنِي مِنَ الفَخْرِ" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ" },
    { "kind": "text", "ar": "وَلا تَرْفَعْنِي فِي النَّاسِ دَرَجَةً" },
    { "kind": "text", "ar": "إِلَّا حَطَطْتَنِي عِنْدَ نَفْسِي مِثْلَها" },
    { "kind": "text", "ar": "وَلا تُحْدِثْ لِي عِزّاً ظاهِراً" },
    { "kind": "text", "ar": "إِلَّا أَحْدَثْتَ لِي ذِلَّةً باطِنَةً عِنْدَ نَفْسِي بِقَدَرِها" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ" },
    { "kind": "text", "ar": "وَمَتِّعْنِي بِهُدًى صالِحٍ لا أَسْتَبْدِلُ بِهِ" },
    { "kind": "text", "ar": "وَطَرِيقَةِ حَقٍّ لا أَزِيغُ عَنْها" },
    { "kind": "text", "ar": "وَنِيَّةِ رُشْدٍ لا أَشُكُّ فِيها" },
    { "kind": "text", "ar": "وَعَمِّرْنِي ما كانَ عُمْرِي بِذْلَةً فِي طاعَتِكَ" },
    { "kind": "text", "ar": "فَإِذا كانَ عُمْرِي مَرْتَعاً لِلشَّيْطانِ" },
    { "kind": "text", "ar": "فَاقْبِضْنِي إِلَيْكَ قَبْلَ أَنْ يَسْبِقَ مَقْتُكَ إِلَيَّ" },
    { "kind": "text", "ar": "أَوْ يَسْتَحْكِمَ غَضَبُكَ عَلَيَّ" },
    { "kind": "text", "ar": "اللَّهُمَّ لا تَدَعْ خَصْلَةً تُعابُ مِنِّي إِلَّا أَصْلَحْتَها" },
    { "kind": "text", "ar": "وَلا عايِبَةً أُؤَنَّبُ بِها إِلَّا حَسَّنْتَها" },
    { "kind": "text", "ar": "وَلا أُكْرُومَةً فِيَّ ناقِصَةً إِلَّا أَتْمَمْتَها" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِ مُحَمَّدٍ" },
    { "kind": "text", "ar": "وَأَبْدِلْنِي مِنْ بُغْضَةِ أَهْلِ الشَّنَآنِ المَحَبَّةَ" },
    { "kind": "text", "ar": "وَمِنْ حَسَدِ أَهْلِ البَغْيِ المَوَدَّةَ" },
    { "kind": "text", "ar": "وَمِنْ ظِنَّةِ أَهْلِ الصَّلاحِ الثِّقَةَ" },
    { "kind": "text", "ar": "وَمِنْ عَداوَةِ الأَدْنَيْنَ الوَلايَةَ" },
    { "kind": "text", "ar": "وَمِنْ عُقُوقِ ذَوِي الأَرْحامِ المَبَرَّةَ" },
    { "kind": "text", "ar": "وَمِنْ خِذْلانِ الأَقْرَبِينَ النُّصْرَةَ" },
    { "kind": "text", "ar": "وَمِنْ حُبِّ المُدارِينَ تَصْحِيحَ المِقَةِ" },
    { "kind": "text", "ar": "وَمِنْ رَدِّ المُلابِسِينَ كَرَمَ العِشْرَةِ" },
    { "kind": "text", "ar": "وَمِنْ مَرارَةِ خَوْفِ الظَّالِمِينَ حَلاوَةَ الأَمَنَةِ" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ" },
    { "kind": "text", "ar": "وَسَدِّدْنِي لأَنْ أُعارِضَ مَنْ غَشَّنِي بِالنُّصْحِ" },
    { "kind": "text", "ar": "وَأَجْزِيَ مَنْ هَجَرَنِي بِالبِرِّ" },
    { "kind": "text", "ar": "وَأُثِيبَ مَنْ حَرَمَنِي بِالبَذْلِ" },
    { "kind": "text", "ar": "وَأُكافِئَ مَنْ قَطَعَنِي بِالصِّلَةِ" },
    { "kind": "text", "ar": "وَأُخالِفَ مَنِ اغْتابَنِي إِلَىٰ حُسْنِ الذِّكْرِ" },
    { "kind": "text", "ar": "وَأَنْ أَشْكُرَ الحَسَنَةَ، وَأُغْضِيَ عَنِ السَّيِّئَةِ" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ" },
    { "kind": "text", "ar": "وَحَلِّنِي بِحِلْيَةِ الصَّالِحِينَ" },
    { "kind": "text", "ar": "وَأَلْبِسْنِي زِينَةَ المُتَّقِينَ" },
    { "kind": "text", "ar": "فِي بَسْطِ العَدْلِ، وَكَظْمِ الغَيْظِ" },
    { "kind": "text", "ar": "وَإِطْفاءِ النَّائِرَةِ، وَضَمِّ أَهْلِ الفُرْقَةِ" },
    { "kind": "text", "ar": "وَإِصْلاحِ ذاتِ البَيْنِ، وَإِفْشاءِ العارِفَةِ" },
    { "kind": "text", "ar": "وَسَتْرِ العائِبَةِ، وَلِينِ العَرِيكَةِ" },
    { "kind": "text", "ar": "وَخَفْضِ الجَناحِ، وَحُسْنِ السِّيرَةِ" },
    { "kind": "text", "ar": "وَسُكُونِ الرِّيحِ، وَطِيبِ المُخالَقَةِ" },
    { "kind": "text", "ar": "وَالسَّبْقِ إِلَىٰ الفَضِيلَةِ، وَإِيثارِ التَّفَضُّلِ" },
    { "kind": "text", "ar": "وَتَرْكِ التَّعْيِيرِ، وَالإِفْضالِ عَلَىٰ غَيْرِ المُسْتَحِقِّ" },
    { "kind": "text", "ar": "وَالقَوْلِ بِالحَقِّ وَإِنْ عَزَّ" },
    { "kind": "text", "ar": "وَاسْتِقْلالِ الخَيْرِ وَإِنْ كَثُرَ مِنْ قَوْلِي وَفِعْلِي" },
    { "kind": "text", "ar": "وَأَكْمِلْ ذٰلِكَ لِي بِدَوامِ الطَّاعَةِ وَلُزُومِ الجَماعَةِ" },
    { "kind": "text", "ar": "وَرَفْضِ أَهْلِ البِدَعِ وَمُسْتَعْمِلِي الرَّأْيِ المُخْتَرَعِ" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ" },
    { "kind": "text", "ar": "وَاجْعَلْ أَوْسَعَ رِزْقِكَ عَلَيَّ إِذا كَبِرْتُ" },
    { "kind": "text", "ar": "وَأَقْوَىٰ قُوَّتِكَ فِيَّ إِذا نَصِبْتُ" },
    { "kind": "text", "ar": "وَلا تَبْتَلِيَنِّي بِالكَسَلِ عَنْ عِبادَتِكَ" },
    { "kind": "text", "ar": "وَلا العَمَىٰ عَنْ سَبِيلِكَ" },
    { "kind": "text", "ar": "وَلا بِالتَّعَرُّضِ لِخِلافِ مَحَبَّتِكَ" },
    { "kind": "text", "ar": "وَلا مُجامَعَةِ مَنْ تَفَرَّقَ عَنْكَ" },
    { "kind": "text", "ar": "وَلا مُفارَقَةِ مَنِ اجْتَمَعَ إِلَيْكَ" },
    { "kind": "text", "ar": "اللَّهُمَّ اجْعَلْنِي أَصُولُ بِكَ عِنْدَ الضَّرُورَةِ" },
    { "kind": "text", "ar": "وَأَسْأَلُكَ عِنْدَ الحاجَةِ" },
    { "kind": "text", "ar": "وَأَتَضَرَّعُ إِلَيْكَ عِنْدَ المَسْكَنَةِ" },
    { "kind": "text", "ar": "وَلا تَفْتِنِّي بِالاِسْتِعانَةِ بِغَيْرِكَ إِذا اضْطُرِرْتُ" },
    { "kind": "text", "ar": "وَلا بِالخُضُوعِ بِسُؤالِ غَيْرِكَ إِذا افْتَقَرْتُ" },
    { "kind": "text", "ar": "وَلا بِالتَّضَرُّعِ إِلَىٰ مَنْ دُونَكَ إِذا رَهِبْتُ" },
    { "kind": "text", "ar": "فَأَسْتَحِقَّ بِذٰلِكَ خِذْلانَكَ" },
    { "kind": "text", "ar": "وَمَنْعَكَ وَإِعْراضَكَ، يا أَرْحَمَ الرَّاحِمِينَ" },
    { "kind": "text", "ar": "اللَّهُمَّ اجْعَلْ ما يُلْقِي الشَّيْطانُ فِي رُوعِي" },
    { "kind": "text", "ar": "مِنَ التَّمَنِّي وَالتَّظَنِّي وَالحَسَدِ" },
    { "kind": "text", "ar": "ذِكْراً لِعَظَمَتِكَ، وَتَفَكُّراً فِي قُدْرَتِكَ" },
    { "kind": "text", "ar": "وَتَدْبِيراً عَلَىٰ عَدُوِّكَ" },
    { "kind": "text", "ar": "وَما أَجْرَىٰ عَلَىٰ لِسانِي مِنْ لَفْظَةِ فُحْشٍ" },
    { "kind": "text", "ar": "أَوْ هَجْرٍ أَوْ شَتْمِ عِرْضٍ أَوْ شَهادَةِ باطِلٍ" },
    { "kind": "text", "ar": "أَوِ اغْتِيابِ مُؤْمِنٍ غائِبٍ أَوْ سَبِّ حاضِرٍ" },
    { "kind": "text", "ar": "وَما أَشْبَهَ ذٰلِكَ نُطْقاً بِالحَمْدِ لَكَ" },
    { "kind": "text", "ar": "وَإِغْراقاً فِي الثَّناءِ عَلَيْكَ" },
    { "kind": "text", "ar": "وَذَهاباً فِي تَمْجِيدِكَ، وَشُكْراً لِنِعْمَتِكَ" },
    { "kind": "text", "ar": "وَاعْتِرافاً بِإِحْسانِكَ، وَإِحْصاءً لِمِنَنِكَ" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ" },
    { "kind": "text", "ar": "وَلا أُظْلَمَنَّ وَأَنْتَ مُطِيقٌ لِلدَّفْعِ عَنِّي" },
    { "kind": "text", "ar": "وَلا أَظْلِمَنَّ وَأَنْتَ القادِرُ عَلَىٰ القَبْضِ مِنِّي" },
    { "kind": "text", "ar": "وَلا أَضِلَّنَّ وَقَدْ أَمْكَنَتْكَ هِدايَتِي" },
    { "kind": "text", "ar": "وَلا أَفْتَقِرَنَّ وَمِنْ عِنْدِكَ وُسْعِي" },
    { "kind": "text", "ar": "وَلا أَطْغَيَنَّ وَمِنْ عِنْدِكَ وُجْدِي" },
    { "kind": "text", "ar": "اللَّهُمَّ إِلَىٰ مَغْفِرَتِكَ وَفَدْتُ" },
    { "kind": "text", "ar": "وَإِلَىٰ عَفْوِكَ قَصَدْتُ" },
    { "kind": "text", "ar": "وَإِلَىٰ تَجاوُزِكَ اشْتَقْتُ" },
    { "kind": "text", "ar": "وَبِفَضْلِكَ وَثِقْتُ" },
    { "kind": "text", "ar": "وَلَيْسَ عِنْدِي ما يُوجِبُ لِي مَغْفِرَتَكَ" },
    { "kind": "text", "ar": "وَلا فِي عَمَلِي ما أَسْتَحِقُّ بِهِ عَفْوَكَ" },
    { "kind": "text", "ar": "وَما لِي بَعْدَ أَنْ حَكَمْتُ عَلَىٰ نَفْسِي إِلَّا فَضْلُكَ" },
    { "kind": "text", "ar": "فَصَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ، وَتَفَضَّلْ عَلَيَّ" },
    { "kind": "text", "ar": "اللَّهُمَّ وَأَنْطِقْنِي بِالهُدَىٰ" },
    { "kind": "text", "ar": "وَأَلْهِمْنِي التَّقْوَىٰ" },
    { "kind": "text", "ar": "وَوَفِّقْنِي لِلَّتِي هِيَ أَزْكَىٰ" },
    { "kind": "text", "ar": "وَاسْتَعْمِلْنِي بِما هُوَ أَرْضَىٰ" },
    { "kind": "text", "ar": "اللَّهُمَّ اسْلُكْ بِيَ الطَّرِيقَةَ المُثْلَىٰ" },
    { "kind": "text", "ar": "وَاجْعَلْنِي عَلَىٰ مِلَّتِكَ أَمُوتُ وَأَحْيَا" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ" },
    { "kind": "text", "ar": "وَمَتِّعْنِي بِالاِقْتِصادِ" },
    { "kind": "text", "ar": "وَاجْعَلْنِي مِنْ أَهْلِ السَّدادِ" },
    { "kind": "text", "ar": "وَمِنْ أَدِلَّةِ الرَّشادِ، وَمِنْ صالِحِي العِبادِ" },
    { "kind": "text", "ar": "وَارْزُقْنِي فَوْزَ المَعادِ، وَسَلامَةَ المِرْصادِ" },
    { "kind": "text", "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَآلِهِ" },
    { "kind": "text", "ar": "كَأَفْضَلِ ما صَلَّيْتَ عَلَىٰ أَحَدٍ مِنْ خَلْقِكَ قَبْلَهُ" },
    { "kind": "text", "ar": "وَأَنْتَ مُصَلٍّ عَلَىٰ أَحَدٍ بَعْدَهُ" },
    { "kind": "text", "ar": "وَآتِنا فِي الدُّنْيا حَسَنَةً، وَفِي الآخِرَةِ حَسَنَةً" },
    { "kind": "text", "ar": "وَقِنِي بِرَحْمَتِكَ عَذابَ النَّارِ" }
  ]
}
