{
  "id": "ziarat-qadr",
  "title": "ليالي القدر ميں زيارت امام حسين",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ليالي القدر ميں زيارت امام حسين",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ الصِّدِّيْقَةِ الطَّاهِرَةِ فَاطِمَةَ"
    },
    {
      "kind": "text",
      "ar": "سَيِّدَةِ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ يَا أَبَا عَبْدِ الله وَرَحْمَةُ الله وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ أَقَمْتَ الصَّلَاةَ، وَاٰتَيْتَ الزَّكَاةَ"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتَ بِالْمَعْرُوْفِ وَنَهَيْتَ عَنِ الْمُنْكَرِ"
    },
    {
      "kind": "text",
      "ar": "وَتَلَوْتَ الْكِتَابَ حَقَّ تِلَاوَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَاهَدْتَ فِي اللهِ حَقَّ جِهَادِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتَ عَلَي الْاَذٰي فِيْ جَنْبِهٖ"
    },
    {
      "kind": "text",
      "ar": "مُحْتَسِبًا حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّ الَّذِيْنَ خَالَفُوْكَ وَحَارَبُوْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالَّذِيْنَ خَذَلُوْكَ وَالَّذِيْنَ قَتَلُوْكَ"
    },
    {
      "kind": "text",
      "ar": "مَلْعُوْنُوْنَ عَلٰي لِسَانِ النَّبِيِّ الْأُمِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ خَابَ مَنِ افْتَرٰي"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ الظَّالِمِيْنَ لَكُمْ مِنَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَضَاعَفَ عَلَيْهِمُ الْعَذَابَ الْاَلِيْمَ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ يَا مَوْلَايَ يَابْنَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "زَائِرًا  عَارِفًا بِحَقِّكَ"
    },
    {
      "kind": "text",
      "ar": "مُوَالِيًا لِاَوْلِيَائِكَ، مُعَادِيًا لِاَعْدَائِكَ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَبْصِرًا بِالْهُدَي الَّذِيْ أَنْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "عَارِفًا بِضَلَالَةِ مَنْ خَالَفَكَ"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ عِنْدَ رَبِّكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ فِيْ أَرْضِهٖ وَسَمَائِهٖ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلٰي رُوْحِكَ الطَّيِّبِ، وَجَسَدِكَ الطَّاهِرِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْكَ السَّلَامُ يَا مَوْلَايَ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ وَابْنَ مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ مَنْ ظَلَمَكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَعَنَ اللهُ مَنْ قَتَلَكَ"
    },
    {
      "kind": "text",
      "ar": "وَضَاعَفَ عَلَيْهِمُ الْعَذَابَ الْاَلِيْمَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَيُّهَا الصِّدِيْقُوْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَيُّهَا الشُّهَدَاءُ الصَّابِرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكُمْ جَاهَدْتُمْ فِيْ سَبِيْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتُمْ عَلَي الْاَذٰي فِيْ جَنْبِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَنَصَحْتُمْ لِلّٰهِ وَلِرَسُوْلِهٖ حَتّٰي أَتَاكُمُ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكُمْ أَحْيَاءٌ عِنْدَ رَبِّكُمْ تُرْزَقُوْنَ"
    },
    {
      "kind": "text",
      "ar": "فَجَزَاكُمُ اللهُ عَنِ الْاَسْلَامِ وَأَهْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَفْضَلَ جَزَاءِ الْمُحْسِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَجَمَعَ بَيْنَنَا وَبَيْنَكُمْ فِيْ مَحَلِّ النَّعِيْمِ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَابْنَ أَمِيْرِ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ أَيُّهَا الْعَبْدُ الصَّالِحُ"
    },
    {
      "kind": "text",
      "ar": "الْمُطِيْعُ لِلّٰهِ وَلِرَسُوْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكَ قَدْ جَاهَدْتَ وَنَصَحْتَ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتَ حَتّٰي أَتَاكَ الْيَقِيْنُ"
    },
    {
      "kind": "text",
      "ar": "لَعَنَ اللهُ الظَّالِمِيْنَ لَكُمْ مِنَ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَلْحَقَهُمْ بِدَرْكِ الْجَحِيْمِ۔"
    }
  ]
}