{
  "id": "salawat-imam-askari",
  "title": "امام حسن عسكري پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام حسن عسكري پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَي الْحَسَنِ بْنِ عَلِيِّ بْنِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "الْبَرِّ التَّقِيِّ، الصَّادِقِ الْوَفِيِّ"
    },
    {
      "kind": "text",
      "ar": "النُّوْرِ الْمُضِيْءِ، خَازِنِ عِلْمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُذَكِّرِ بِتَوْحِيْدِكَ، وَوَلِيِّ أَمْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخَلَفِ أَئِمَّةِ الدِّيْنِ الْهُدَاةِ الرَّاشِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْحُجَّةِ عَلٰي أَهْلِ الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "فَصَلِّ عَلَيْهِ يَا رَبِّ أَفْضَلَ مَا صَلَّيْتَ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي أَحَدٍ مِنْ أَصْفِيَائِكَ وَحُجَجِكَ وَأَوْلَادِ رُسُلِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا اِلٰهَ الْعَالَمِيْنَ۔"
    }
  ]
}