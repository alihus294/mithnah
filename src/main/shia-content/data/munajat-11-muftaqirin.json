{
  "id": "munajat-11-muftaqirin",
  "title": "المناجاة الحادية عشرة — مناجاة المفتقرين",
  "subtitle": "من المناجاة الخمسة عشر للإمام السجاد عليه السلام",
  "source": "مفاتيح الجنان، المناجاة الخمس عشرة",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "مناجاة المفتقرين", "subtitle": "المناجاة الحادية عشرة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "إِلٰهِي كَسْرِي لا يَجْبُرُهُ إِلَّا لُطْفُكَ وَحَنانُكَ" },
    { "kind": "text", "ar": "وَفَقْرِي لا يُغْنِيهِ إِلَّا عَطْفُكَ وَإِحْسانُكَ" },
    { "kind": "text", "ar": "وَرَوْعَتِي لا يُسَكِّنُها إِلَّا أَمانُكَ" },
    { "kind": "text", "ar": "وَذِلَّتِي لا يُعِزُّها إِلَّا سُلْطانُكَ" },
    { "kind": "text", "ar": "وَأُمْنِيَّتِي لا يُبَلِّغُنِيها إِلَّا فَضْلُكَ" },
    { "kind": "text", "ar": "وَخَلَّتِي لا يَسُدُّها إِلَّا طَوْلُكَ" },
    { "kind": "text", "ar": "وَحاجَتِي لا يَقْضِيها غَيْرُكَ" },
    { "kind": "text", "ar": "وَكَرْبِي لا يُفَرِّجُهُ سِوَىٰ رَحْمَتِكَ" },
    { "kind": "text", "ar": "وَضُرِّي لا يَكْشِفُهُ غَيْرُ رَأْفَتِكَ" },
    { "kind": "text", "ar": "وَغُلَّتِي لا يُبَرِّدُها إِلَّا وَصْلُكَ" },
    { "kind": "text", "ar": "وَلَوْعَتِي لا يُطْفِيها إِلَّا لِقاؤُكَ" },
    { "kind": "text", "ar": "وَشَوْقِي إِلَيْكَ لا يَبُلُّهُ إِلَّا النَّظَرُ إِلَىٰ وَجْهِكَ" },
    { "kind": "text", "ar": "وَقَرارِي لا يَقِرُّ دُونَ دُنُوِّي مِنْكَ" },
    { "kind": "text", "ar": "وَلَهْفَتِي لا يَرُدُّها إِلَّا رَوْحُكَ" },
    { "kind": "text", "ar": "وَسُقْمِي لا يَشْفِيهِ إِلَّا طِبُّكَ" },
    { "kind": "text", "ar": "وَغَمِّي لا يُزِيلُهُ إِلَّا قُرْبُكَ" },
    { "kind": "text", "ar": "وَجُرْحِي لا يُبْرِئُهُ إِلَّا صَفْحُكَ" },
    { "kind": "text", "ar": "وَرَيْنُ قَلْبِي لا يَجْلُوهُ إِلَّا عَفْوُكَ" },
    { "kind": "text", "ar": "وَوَسْواسُ صَدْرِي لا يُزِيحُهُ إِلَّا أَمْرُكَ" },
    { "kind": "text", "ar": "فَيا مُنْتَهَىٰ أَمَلِ الآمِلِينَ، وَيا غايَةَ سُؤْلِ السَّائِلِينَ" },
    { "kind": "text", "ar": "وَيا أَقْصَىٰ طَلِبَةِ الطَّالِبِينَ، وَيا أَعْلَىٰ رَغْبَةِ الرَّاغِبِينَ" },
    { "kind": "text", "ar": "وَيا وَلِيَّ الصَّالِحِينَ، وَيا أَمانَ الخائِفِينَ" },
    { "kind": "text", "ar": "وَيا مُجِيبَ دَعْوَةِ المُضْطَرِّينَ، وَيا ذُخْرَ المُعْدِمِينَ" },
    { "kind": "text", "ar": "وَيا كَنْزَ البائِسِينَ، وَيا غِياثَ المُسْتَغِيثِينَ" },
    { "kind": "text", "ar": "وَيا قاضِيَ حَوائِجِ الفُقَراءِ وَالمَساكِينَ" },
    { "kind": "text", "ar": "وَيا أَكْرَمَ الأَكْرَمِينَ، وَيا أَرْحَمَ الرَّاحِمِينَ" },
    { "kind": "text", "ar": "لَكَ تَخَضُّعِي وَسُؤالِي" },
    { "kind": "text", "ar": "وَإِلَيْكَ تَضَرُّعِي وَابْتِهالِي" },
    { "kind": "text", "ar": "أَسْأَلُكَ أَنْ تُنِيلَنِي مِنْ رَوْحِ رِضْوانِكَ" },
    { "kind": "text", "ar": "وَتُدِيمَ عَلَيَّ نِعَمَ امْتِنانِكَ" },
    { "kind": "text", "ar": "وَها أَنا بِبابِ كَرَمِكَ واقِفٌ" },
    { "kind": "text", "ar": "وَلِنَفَحاتِ بِرِّكَ مُتَعَرِّضٌ" },
    { "kind": "text", "ar": "وَبِحَبْلِكَ الشَّدِيدِ مُعْتَصِمٌ" },
    { "kind": "text", "ar": "وَبِعُرْوَتِكَ الوُثْقَىٰ مُتَمَسِّكٌ" },
    { "kind": "text", "ar": "إِلٰهِي ارْحَمْ عَبْدَكَ الذَّلِيلَ ذا اللِّسانِ الكَلِيلِ وَالعَمَلِ القَلِيلِ" },
    { "kind": "text", "ar": "وَامْنُنْ عَلَيْهِ بِطَوْلِكَ الجَزِيلِ" },
    { "kind": "text", "ar": "وَاكْنُفْهُ تَحْتَ ظِلِّكَ الظَّلِيلِ" },
    { "kind": "text", "ar": "يا كَرِيمُ يا جَمِيلُ، يا أَرْحَمَ الرَّاحِمِينَ" }
  ]
}
