{
  "id": "ramadan-night19",
  "title": "انيسويں رمضان كي رات",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "انيسويں رمضان كي رات",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَسْتَغْفِرُ اللهَ رَبِّيْ وَاَتُوْبُ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ الْعَنْ قَتَلَةَ اَمِيْرِ الْمُوْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ فِيْمَا تَقْضِيْ وَتُقَدِّرُ مِنَ الْاَمْرِ الْمَحْتُوْمِ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْمَا تَفْرُقُ مِنَ الْاَمْرِ الْحَكِيْمِ فِيْ لَيْلَةِ الْقَدْرِ"
    },
    {
      "kind": "text",
      "ar": "وَفِي الْقَضَاءِ الَّذِيْ لَا يُرَدُّ وَلَا يُبَدَّلُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تَكْتُبَنِيْ مِنْ حُجَّاجِ بَيْتِكَ الْحَرَامِ"
    },
    {
      "kind": "text",
      "ar": "الْمَبْرُوْرِ حَجُّهُمُ، الْمَشْكُوْرِ سَعْيُهُمُ"
    },
    {
      "kind": "text",
      "ar": "الْمَغْفُوْرِ ذُنُوْبُهُمُ، الْمُكَفَّرِ عَنْهُمْ سَيِّئَاتُهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ فِيْمَا تَقْضِيْ وَتُقَدِّرُ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُطِيْلَ عُمْرِيْ، وَتُوَسِّعَ عَلَيَّ فِيْ رِزْقِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَفْعَلَ بِيْ كَذَا وَكَذَا"
    }
  ]
}