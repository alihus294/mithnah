{
  "id": "salawat-imam-asr",
  "title": "امام العصر پر صلوات",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام العصر پر صلوات",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي وَلِيِّكَ وَابْنِ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ فَرَضْتَ طَاعَتَهُمْ، وَأَوْجَبْتَ حَقَّهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَذْهَبْتَ عَنْهُمُ الرِّجْسَ وَطَهَّرْتَهُمْ تَطْهِيْرًا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ انْصُرْهُ، وَانْتَصِرْ بِهٖ لِدِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْ بِهٖ أَوْلِيَائَكَ وَأَوْلِيَائَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَشِيْعَتَهٗ وَأَنْصَارَهٗ، وَاجْعَلْنَا مِنْهُمْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعِذْهُ مِنْ شَرِّ كُلِّ بَاغٍ وَطَاغٍ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ جَمِيْعِ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْهُ مِنْ بَيْنِ يَدَيْهِ، وَمِنْ خَلْفِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَنْ يَمِيْنِهٖ، وَعَنْ شِمَالِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاحْرُسْهُ وَامْنَعْهُ أَنْ يُوْصَلَ اِلَيْهِ بِسُوْءٍ"
    },
    {
      "kind": "text",
      "ar": "وَاحْفَظْ فِيْهِ رَسُوْلَكَ وَاٰلَ رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَظْهِرْ بِهِ الْعَدْلَ، وَأَيِّدْهُ بِالنَّصْرِ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْ نَاصِرِيْهِ، وَاخْذُل خَاذِلِيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْصِمْ بِهٖ جَبَابِرَةَ الْكُفْرِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْتُلْ بِهِ الْكُفَّارَ وَالْمُنَافِقِيْنَ، وَجَمِيْعَ الْمُلْحِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "حَيْثُ كَانُوْا مِنْ مَشَارِقِ الْاَرْضِ وَمَغَارِبِهَا وَبَرِّهَا وَبَحْرِهَا"
    },
    {
      "kind": "text",
      "ar": "وَامْلَأْ بِهِ الْاَرْضَ عَدْلًا"
    },
    {
      "kind": "text",
      "ar": "وَأَظْهِرْ بِهٖ دِيْنَ نَبِيِّكَ عَلَيْهِ وَاٰلِهِ السَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ اَللّٰهُمَّ مِنْ أَنْصَارِهٖ وَأَعْوَانِهٖ، وَأَتْبَاعِهٖ، وَشِيْعَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَأَرِنِيْ فِيْ اٰلِ مُحَمَّدٍ مَا يَأْمُلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَفِيْ عَدُوِّهِمْ مَا يَحْذَرُوْنَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهَ الْحَقِّ اٰمِيْنَ۔"
    }
  ]
}