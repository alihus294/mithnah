{
  "id": "dua-nudba",
  "title": "دعاء ندبه",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "دعاء ندبه",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي سَيِّدِنَا مُحَمَّدٍ نَبِيِّهٖ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَّمَ تَسْلِيْمًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَكَ الْحَمْدُ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي مَا جَرٰي بِهٖ قَضَاؤُكَ فِيْ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْنَ اسْتَخْلَصْتَهُمْ لِنَفْسِكَ وَدِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "اِذِ اخْتَرْتَ لَهُمْ جَزِيْلَ مَا عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "مِنَ النَّعِيْمِ الْمُقِيْمِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ لَا زَوَالَ لَهٗ وَلَا اضْمِحْلَالَ"
    },
    {
      "kind": "text",
      "ar": "بَعْدَ أَنْ شَرَطْتَ عَلَيْهِمُ الزُّهْدَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ دَرَجَاتِ هٰذِهِ الدُّنْيَا الدَّنِيَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَزُخْرُفِهَا وَزِبْرِجِهَا"
    },
    {
      "kind": "text",
      "ar": "فَشَرَطُوْا لَكَ ذٰلِكَ وَعَلِمْتَ مِنْهُمُ الْوَفَاءَ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَقَبِلْتَهُمْ وَقَرَّبْتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَقَدَّمْتَ لَهُمُ الذِّكْرَ الْعَلِيَّ وَالثَّنَاءَ الْجَلِيَّ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْبَطْتَ عَلَيْهِمْ مَلَائِكَتَكَ"
    },
    {
      "kind": "text",
      "ar": "وَكَرَّمْتَهُمْ بِوَحْيِكَ، وَرَفَدْتَهُمْ بِعِلْمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهُمُ الذَّرِيْعَةَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْوَسِيْلَةَ اِلٰي رِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "فَبَعْضٌ أَسْكَنْتَهٗ جَنَّتَكَ اِلٰي أَنْ أَخْرَجْتَهٗ مِنْهَا"
    },
    {
      "kind": "text",
      "ar": "وَبَعْضٌ حَمَلْتَهٗ فِيْ فُلْكِكَ"
    },
    {
      "kind": "text",
      "ar": "وَنَجَّيْتَهٗ وَمَنْ اٰمَنَ مَعَهٗ مِنَ الْهَلَكَةِ بِرَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَعْضٌ اتَّخَذْتَهٗ لِنَفْسِكَ خَلِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَسَأَلَكَ لِسَانَ صِدْقٍ فِي الْاٰخِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَأَجَبْتَهٗ وَجَعَلْتَ ذٰلِكَ عَلِيًّا"
    },
    {
      "kind": "text",
      "ar": "وَبَعْضٌ كَلَّمْتَهٗ مِنْ شَجَرَةٍ تَكْلِيْمًا"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَ لَهٗ مِنْ أَخِيْهِ رِدْئًا وَوَزِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَبَعْضٌ أَوْلَدْتَهٗ مِنْ غَيْرِ أَبٍ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتَيْتَهٗ الْبَيِّنَاتِ وَأَيَّدْتَهٗ بِرُوْحِ الْقُدُسِ"
    },
    {
      "kind": "text",
      "ar": "وَكُلٌّ شَرَعْتَ لَهٗ شَرِيْعَةً وَنَهَجْتَ لَهٗ مِنْهَاجًا"
    },
    {
      "kind": "text",
      "ar": "وَتَخَيَّرْتَ لَهٗ أَوْصِيَاءَ"
    },
    {
      "kind": "text",
      "ar": "مُسْتَحْفِظًا بَعْدَ مُسْتَحْفِظٍ مِنْ مُدَّةٍ اِلٰي مُدَّةٍ"
    },
    {
      "kind": "text",
      "ar": "اِقَامَةً لِدِيْنِكَ وَحُجَّةً عَلٰي عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَلِئَلَّا يَزُوْلَ الْحَقُّ عَنْ مَقَرِّهِ"
    },
    {
      "kind": "text",
      "ar": "وَيَغْلِبَ الْبَاطِلُ عَلٰي أَهْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَقُوْلَ أَحَدٌ لَوْ لَا أَرْسَلْتَ اِلَيْنَا رَسُوْلًا مُنْذِرًا"
    },
    {
      "kind": "text",
      "ar": "وَأَقَمْتَ لَنَا عَلَمًا هَادِيًا"
    },
    {
      "kind": "text",
      "ar": "فَنَتَّبِعَ اٰيَاتِكَ مِنْ قَبْلِ أَنْ نَذِلَّ وَنَخْزٰي"
    },
    {
      "kind": "text",
      "ar": "اِلٰي أَنِ انْتَهَيْتَ بِالْاَمْرِ اِلٰي حَبِيْبِكَ وَنَجِيْبِكَ"
    },
    {
      "kind": "text",
      "ar": "مُحَمَّدٍ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَكَانَ كَمَا انْتَجَبْتَهٗ سَيِّدَ مَنْ خَلَقْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَصَفْوَةَ مَنِ اصْطَفَيْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَفْضَلَ مَنِ اجْتَبَيْتَهٗ وَأَكْرَمَ مَنِ اعْتَمَدْتَهٗ"
    },
    {
      "kind": "text",
      "ar": "قَدَّمْتَهٗ عَلٰي أَنْبِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَعَثْتَهٗ اِلَي الثَّقَلَيْنِ مِنْ عِبَادِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْطَأْتَهٗ مَشَارِقَكَ وَمَغَارِبَكَ"
    },
    {
      "kind": "text",
      "ar": "وَسَخَّرْتَ لَهُ الْبُرَاقَ"
    },
    {
      "kind": "text",
      "ar": "وَعَرَجْتَ بِرُوْحِهِ اِلٰي سَمَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَوْدَعْتَهٗ عِلْمَ مَا كَانَ وَمَا يَكُوْنُ"
    },
    {
      "kind": "text",
      "ar": "اِلَي انْقِضَاءِ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ نَصَرْتَهٗ بِالرُّعْبِ وَحَفَفْتَهٗ بِجَبْرَائِيْلَ وَمِيْكَائِيْلَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُسَوِّمِيْنَ مِنْ مَلَائِكَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَعَدْتَهٗ أَنْ تُظْهِرَ دِيْنَهٗ عَلَي الدِّيْنِ كُلِّهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَوْ كَرِهَ الْمُشْرِكُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَذٰلِكَ بَعْدَ أَنْ بَوَّأْتَهٗ مُبَوَّأَ صِدْقٍ مِنْ أَهْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَ لَهٗ وَلَهُمْ أَوَّلَ بَيْتٍ"
    },
    {
      "kind": "text",
      "ar": "وُضِعَ لِلنَّاسِ لَلَّذِيْ بِبَكَّةَ مُبَارَكًا وَهُدًى لِلْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فِيْهِ اٰيَاتٌ بَيِّنَاتٌ مَقَامُ اِبْرَاهِيْمَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ دَخَلَهٗ كَانَ اٰمِنًا"
    },
    {
      "kind": "text",
      "ar": "وَقُلْتَ اِنَّمَا يُرِيْدُ اللهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ"
    },
    {
      "kind": "text",
      "ar": "وَيُطَهِّرَكُمْ تَطْهِيْرًا"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ جَعَلْتَ أَجْرَ مُحَمَّدٍ صَلَوَاتُكَ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "مَوَدَّتَهُمْ فِيْ كِتَابِكَ"
    },
    {
      "kind": "text",
      "ar": "فَقُلْتَ قُلْ لَا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا اِلَّا الْمَوَدَّ ةَ فِي الْقُرْبٰي"
    },
    {
      "kind": "text",
      "ar": "وَقُلْتَ مَا سَأَلْتُكُمْ مِنْ أَجْرٍ فَهُوَ لَكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَقُلْتَ مَا أَسْأَلُكُمْ عَلَيْهِ مِنْ أَجْرٍ"
    },
    {
      "kind": "text",
      "ar": "اِلَّا مَنْ شَاءَ أَنْ يَتَّخِذَ اِلٰي رَبِّهٖ سَبِيْلًا"
    },
    {
      "kind": "text",
      "ar": "فَكَانُوْا هُمُ السَّبِيْلَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَسْلَكَ اِلٰي رِضْوَانِكَ"
    },
    {
      "kind": "text",
      "ar": "فَلَمَّا انْقَضَتْ أَيَّامُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَقَامَ وَلِيَّهُ عَلِيَّ بْنَ أَبِيْ طَالِبٍ صَلَوَاتُكَ عَلَيْهِمَا وَاٰلِهِمَا"
    },
    {
      "kind": "text",
      "ar": "هَادِيًا اِذْ كَانَ هُوَ الْمُنْذِرَ وَلِكُلِّ قَوْمٍ هَادٍ"
    },
    {
      "kind": "text",
      "ar": "فَقَالَ وَالْمَلَاُ أَمَامَهٗ مَنْ كُنْتُ مَوْلَاهُ فَعَلِيٌّ مَوْلَاهُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَالِ مَنْ وَالَاهُ وَعَادِ مَنْ عَادَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَانْصُرْ مَنْ نَصَرَهٗ وَاخْذُلْ مَنْ خَذَلَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَقَالَ مَنْ كُنْتُ أَنَا نَبِيَّهٗ فَعَلِيٌّ أَمِيْرُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَقَالَ أَنَا وَعَلِيٌّ مِنْ شَجَرَةٍ وَاحِدَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَسَائِرُ النَّاسِ مِنْ شَجَرٍ شَتّٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَحَلَّهٗ مَحَلَّ هَارُوْنَ مِنْ مُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "فَقَالَ لَهٗ أَنْتَ مِنِّيْ بِمَنْزِلَةِ هَارُوْنَ مِنْ مُوْسٰي"
    },
    {
      "kind": "text",
      "ar": "اِلَّا أَنَّهٗ لَا نَبِيَّ بَعْدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَزَوَّجَهُ ابْنَتَهٗ سَيِّدَةَ نِسَاءِ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَحَلَّ لَهٗ مِنْ مَسْجِدِهٖ مَا حَلَّ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَسَدَّ الْاَبْوَابَ اِلَّا بَابَهٗ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ أَوْدَعَهٗ عِلْمَهٗ وَحِكْمَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "فَقَالَ أَنَا مَدِيْنَةُ الْعِلْمِ وَعَلِيٌّ بَابُهَا"
    },
    {
      "kind": "text",
      "ar": "فَمَنْ أَرَادَ الْمَدِيْنَةَ وَالْحِكْمَةَ فَلْيَأْتِهَا مِنْ بَابِهَا"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ قَالَ أَنْتَ أَخِيْ وَوَصِيِّيْ وَوَارِثِيْ"
    },
    {
      "kind": "text",
      "ar": "لَحْمُكَ مِنْ لَحْمِيْ وَدَمُكَ مِنْ دَمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَسِلْمُكَ سِلْمِيْ وَحَرْبُكَ حَرْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِيْمَانُ مُخَالِطٌ لَحْمَكَ وَدَمَكَ"
    },
    {
      "kind": "text",
      "ar": "كَمَا خَالَطَ لَحْمِيْ وَدَمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ غَدًا عَلَي الْحَوْضِ خَلِيْفَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ تَقْضِيْ دَيْنِيْ وَتُنْجِزُ عِدَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَشِيْعَتُكَ عَلٰي مَنَابِرَ مِنْ نُوْرٍ مُبْيَضَّةً وُجُوْهُهُمْ"
    },
    {
      "kind": "text",
      "ar": "حَوْلِيْ فِي الْجَنَّةِ وَهُمْ جِيْرَانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَوْ لَا أَنْتَ يَا عَلِيُّ لَمْ يُعْرَفِ الْمُؤْمِنُوْنَ بَعْدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَكَانَ بَعْدَهٗ هُدًى مِنَ الضَّلَالِ وَنُوْرًا مِنَ الْعَمٰي"
    },
    {
      "kind": "text",
      "ar": "وَحَبْلَ اللهِ الْمَتِيْنَ وَصِرَاطَهُ الْمُسْتَقِيْمَ"
    },
    {
      "kind": "text",
      "ar": "لَا يُسْبَقُ بِقَرَابَةٍ فِيْ رَحِمٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا بِسَابِقَةٍ فِيْ دِيْنٍ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يُلْحَقُ فِيْ مَنْقَبَةٍ مِنْ مَنَاقِبِهٖ"
    },
    {
      "kind": "text",
      "ar": "يَحْذُوْ حَذْوَ الرَّسُوْلِ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِمَا وَاٰلِهِمَا"
    },
    {
      "kind": "text",
