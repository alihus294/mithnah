      "ar": "بِنَفْسِيْ أَنْتَ مِنْ نَازِحٍ مَا نَزَحَ عَنَّا"
    },
    {
      "kind": "text",
      "ar": "بِنَفْسِيْ أَنْتَ أُمْنِيَّةُ شَائِقٍ يَتَمَنّٰي"
    },
    {
      "kind": "text",
      "ar": "مِنْ مُؤْمِنٍ وَمُؤْمِنَةٍ ذَكَرَا فَحَنَّا"
    },
    {
      "kind": "text",
      "ar": "بِنَفْسِيْ أَنْتَ مِنْ عَقِيْدِ عِزٍّ لَا يُسَامٰي"
    },
    {
      "kind": "text",
      "ar": "بِنَفْسِيْ أَنْتَ مِنْ أَثِيْلِ مَجْدٍ لَا يُجَارٰي"
    },
    {
      "kind": "text",
      "ar": "بِنَفْسِيْ أَنْتَ مِنْ تِلَادِ نِعَمٍ لَا تُضَاهٰي"
    },
    {
      "kind": "text",
      "ar": "بِنَفْسِيْ أَنْتَ مِنْ نَصِيْفِ شَرَفٍ لَا يُسَاوٰي"
    },
    {
      "kind": "text",
      "ar": "اِلٰي مَتٰي أَحَارُ فِيْكَ يَا مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "وَاِلٰي مَتٰي وَأَيَّ خِطَابٍ أَصِفُ فِيْكَ وَأَيَّ نَجْوٰي"
    },
    {
      "kind": "text",
      "ar": "عَزِيْزٌ عَلَيَّ أَنْ أُجَابَ دُوْنَكَ وَأُنَاغٰي"
    },
    {
      "kind": "text",
      "ar": "عَزِيْزٌ عَلَيَّ أَنْ أَبْكِيَكَ وَيَخْذُلَكَ الْوَرٰي"
    },
    {
      "kind": "text",
      "ar": "عَزِيْزٌ عَلَيَّ أَنْ يَجْرِيَ عَلَيْكَ دُوْنَهُمْ مَا جَرٰي"
    },
    {
      "kind": "text",
      "ar": "هَلْ مِنْ مُعِيْنٍ فَأُطِيْلَ مَعَهُ الْعَوِيْلَ وَالْبُكَاءَ"
    },
    {
      "kind": "text",
      "ar": "هَلْ مِنْ جَزُوْعٍ فَأُسَاعِدَ جَزَعَهُ اِذَا خَلَا"
    },
    {
      "kind": "text",
      "ar": "هَلْ قَذِيَتْ عَيْنٌ فَسَاعَدَتْهَا عَيْنِيْ عَلَي الْقَذٰي"
    },
    {
      "kind": "text",
      "ar": "هَلْ اِلَيْكَ يَابْنَ أَحْمَدَ سَبِيْلٌ فَتُلْقٰي"
    },
    {
      "kind": "text",
      "ar": "هَلْ يَتَّصِلُ يَوْمُنَا مِنْكَ بِعِدَةٍ فَنَحْظٰي"
    },
    {
      "kind": "text",
      "ar": "مَتٰي نَرِدُ مَنَاهِلَكَ الرَّوِيَّةَ فَنَرْوٰي"
    },
    {
      "kind": "text",
      "ar": "مَتٰي نَنْتَقِعُ مِنْ عَذْبِ مَائِكَ فَقَدْ طَالَ الصَّدٰي"
    },
    {
      "kind": "text",
      "ar": "مَتٰي نُغَادِيْكَ وَنُرَاوِحُكَ فَنُقِرَّ عَيْنًا"
    },
    {
      "kind": "text",
      "ar": "مَتٰي تَرَانَا وَنَرَاكَ وَقَدْ نَشَرْتَ لِوَاءَ النَّصْرِ تُرٰي"
    },
    {
      "kind": "text",
      "ar": "أَتَرَانَا نَحُفُّ بِكَ وَأَنْتَ تَؤُمُّ الْمَلَأ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ مَلَأْتَ الْاَرْضَ عَدْلًا"
    },
    {
      "kind": "text",
      "ar": "وَأَذَقْتَ أَعْدَائَكَ هَوَانًا وَعِقَابًا"
    },
    {
      "kind": "text",
      "ar": "وَأَبَرْتَ الْعُتَاةَ وَجَحَدَةَ الْحَقِّ"
    },
    {
      "kind": "text",
      "ar": "وَقَطَعْتَ دَابِرَ الْمُتَكَبِّرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْتَثَثْتَ أُصُوْلَ الظَّالِمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَنَحْنُ نَقُوْلُ الْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ كَشَّافُ الْكُرَبِ وَالْبَلْوٰي"
    },
    {
      "kind": "text",
      "ar": "وَاِلَيْكَ أَسْتَعْدٰي فَعِنْدَكَ الْعَدْوٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ رَبُّ الْاٰخِرَةِ وَالدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "فَأَغِثْ يَا غِيَاثَ الْمُسْتَغِيْثِيْنَ عُبَيْدَكَ الْمُبْتَلٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَرِهٖ سَيِّدَهٗ يَا شَدِيْدَ الْقُوٰي"
    },
    {
      "kind": "text",
      "ar": "وَأَزِلْ عَنْهُ بِهِ الْاَسٰي وَالْجَوٰي"
    },
    {
      "kind": "text",
      "ar": "وَبَرِّدْ غَلِيْلَهٗ يَا مَنْ عَلَي الْعَرْشِ اسْتَوٰي"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ اِلَيْهِ الرُّجْعٰي وَالْمُنْتَهٰي۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَنَحْنُ عَبِيْدُكَ التَّائِقُوْنَ اِلٰي وَلِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "الْمُذَكِّرِ بِكَ وَبِنَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "خَلَقْتَهٗ لَنَا عِصْمَةً وَمَلَاذًا"
    },
    {
      "kind": "text",
      "ar": "وَأَقَمْتَهٗ لَنَا قِوَامًا وَمَعَاذًا"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلْتَهٗ لِلْمُؤْمِنِيْنَ مِنَّا اِمَامًا"
    },
    {
      "kind": "text",
      "ar": "فَبَلِّغْهُ مِنَّا تَحِيَّةً وَسَلَامًا"
    },
    {
      "kind": "text",
      "ar": "وَزِدْنَا بِذٰلِكَ يَارَبِّ اِكْرَامًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ مُسْتَقَرَّهُ لَنَا مُسْتَقَرًّا وَمُقَامًا"
    },
    {
      "kind": "text",
      "ar": "وَأَتْمِمْ نِعْمَتَكَ بِتَقْدِيْمِكَ اِيَّاهُ أَمَامَنَا"
    },
    {
      "kind": "text",
      "ar": "حَتّٰي تُوْرِدَنَا جِنَانَكَ وَمُرَافَقَةَ الشُّهَدَاءِ مِنْ خُلَصَائِكَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي مُحَمَّدٍ جَدِّهِ وَرَسُوْلِكَ السَّيِّدِ الْاَكْبَرِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي أَبِيْهِ السَّيِّدِ الْاَصْغَرِ"
    },
    {
      "kind": "text",
      "ar": "وَجَدَّتِهِ الصِّدِّيْقَةِ الْكُبْرٰي فَاطِمَةَ بِنْتِ مُحَمَّدٍ صلَّي الله عَليْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَعَلٰي مَنِ اصْطَفَيْتَ مِنْ اٰبَائِهِ الْبَرَرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَعَلَيْهِ أَفْضَلَ وَأَكْمَلَ وَأَتَمَّ وَأَدْوَمَ"
    },
    {
      "kind": "text",
      "ar": "وَأَكْثَرَ وَأَوْفَرَ مَا صَلَّيْتَ عَلٰي أَحَدٍ مِنْ أَصْفِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخِيَرَتِكَ مِنْ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلَيْهِ صَلَاةً لَا غَايَةَ لِعَدَدِهَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا نِهَايَةَ لِمَدَدِهَا وَلَا نَفَادَ لِاَمَدِهَا"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَقِمْ بِهِ الْحَقَّ وَأَدْحِضْ بِهِ الْبَاطِلَ"
    },
    {
      "kind": "text",
      "ar": "وَأَدِلْ بِهٖ أَوْلِيَائَكَ وَأَذْلِلْ بِهٖ أَعْدَائَكَ"
    },
    {
      "kind": "text",
      "ar": "وَصِلِ اللّٰهُمَّ بَيْنَنَا وَبَيْنَهٗ"
    },
    {
      "kind": "text",
      "ar": "وُصْلَةً تُؤَدِّيْ اِلٰي مُرَافَقَةِ سَلَفِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنَا مِمَّنْ يَأْخُذُ بِحُجْزَتِهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَيَمْكُثُ فِيْ ظِلِّهِمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِنَّا عَلٰي تَأْدِيَةِ حُقُوْقِهٖ اِلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "وَالْاِجْتِهَادِ فِيْ طَاعَتِهٖ وَاجْتِنَابِ مَعْصِيَتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَامْنُنْ عَلَيْنَا بِرِضَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لَنَا رَأْفَتَهٗ وَرَحْمَتَهٗ وَدُعَائَهٗ وَخَيْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "مَا نَنَالُ بِهٖ سَعَةً مِنْ رَحْمَتِكَ وَفَوْزًا عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ صَلَا تَنَا بِهٖ مَقبُوْلَةً، وَذُنُوْبَنَا بِهٖ مَغْفُوْرَةً"
    },
    {
      "kind": "text",
      "ar": "وَدُعَائَنَا بِهٖ مُسْتَجَابًا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ أَرْزَاقَنَا بِهٖ مَبْسُوْطَةً"
    },
    {
      "kind": "text",
      "ar": "وَهُمُوْمَنَا بِهٖ مَكْفِيَّةً، وَحَوَائِجَنَا بِهٖ مَقْضِيَّةً"
    },
    {
      "kind": "text",
      "ar": "وَأَقْبِلْ اِلَيْنَا بِوَجْهِكَ الْكَرِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَاقْبَلْ تَقَرُّبَنَا اِلَيْكَ وَانْظُرْ اِلَيْنَا نَظْرَةً رَحِيْمَةً"
    },
    {
      "kind": "text",
      "ar": "نَسْتَكْمِلُ بِهَا الْكَرَامَةَ عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ لَا تَصْرِفْهَا عَنَّا بِجُوْدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْقِنَا مِنْ حَوْضِ جَدِّهِ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "بِكَأْسِهٖ وَبِيَدِهٖ رَيًّا رَوِيًّا هَنِيْئًا سَائِغًا"
    },
    {
      "kind": "text",
      "ar": "لَا ظَمَأَ بَعْدَهٗ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}