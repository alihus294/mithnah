{
  "id": "namaz-ziarat-imam9",
  "title": "نماز زيارت امام محمد تقي  كے بعد كي دعا",
  "subtitle": "ملحقات مفاتيح الجنان",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز زيارت امام محمد تقي  كے بعد كي دعا",
      "subtitle": "ملحقات مفاتيح الجنان"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الرَّبُّ وَأَنَا الْمَرْبُوْبُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْخَالِقُ وَأَنَا الْمَخْلُوْقُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمَالِكُ وَأَنَا الْمَمْلُوْكُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُعْطِيْ وَأَنَا السَّائِلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الرَّازِقُ وَأَنَا الْمَرْزُوْقُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْقَادِرُ وَأَنَا الْعَاجِزُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْقَوِيُّ وَأَنَا الضَّعِيْفُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُغِيْثُ وَأَنَا الْمُسْتَغِيْثُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الدَّائِمُ وَأَنَا الزَّائِلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْكَبِيْرُ وَأَنَا الْحَقِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْعَظِيْمُ وَأَنَا الصَّغِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمَوْلٰي وَأَنَا الْعَبْدُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْعَزِيْزُ وَأَنَا الذَّلِيْلُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الرَّفِيْعُ وَأَنَا الْوَضِيْعُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْمُدَبِّرُ وَأَنَا الْمُدَبَّرُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْبَاقِيْ وَأَنَا الْفَانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الدَّيَّانُ وَأَنَا الْمُدَانُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْبَاعِثُ وَأَنَا المَبْعُوْثُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْغَنِيُّ وَأَنَا الْفَقِيْرُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ الْحَيُّ وَأَنَا الْمَيِّتُ"
    },
    {
      "kind": "text",
      "ar": "تَجِدُ مَنْ تُعَذِّبُ يَا رَبِّ غَيْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَجِدُ مَنْ يَرْحَمُنِيْ غَيْرَكَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ وَقَرِّبْ فَرَجَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْ ذُلِّيْ بَيْنَ يَدَيْكَ، وَتَضَرُّعِيْ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَوَحْشَتِيْ مِنَ النَّاسِ، وَأُنْسِيْ بِكَ يَا كَرِيْمُ"
    },
    {
      "kind": "text",
      "ar": "تَصَدَّقْ عَلَيَّ فِيْ هٰذِهِ السَّاعَةِ بِرَحْمَةٍ مِنْ عِنْدِكَ"
    },
    {
      "kind": "text",
      "ar": "تَهْدِيْ بِهَا قَلْبِيْ، وَتَجْمَعُ بِهَا أَمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَلُمُّ بِهَا شَعَثِيْ، وَتُبَيِّضُ بِهَا وَجْهِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتُكْرِمُ بِهَا مَقَامِيْ، وَتَحُطُّ بِهَا عَنِّيْ وِزْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَغْفِرُ بِهَا مَا مَضٰي مِنْ ذُنُوْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَعْصِمُنِيْ فِيْمَا بَقِيَ مِنْ عُمْرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَسْتَعْمِلُنِيْ فِيْ ذٰلِكَ كُلِّهٖ بِطَاعَتِكَ وَمَا يُرْضِيْكَ عَنِّيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَخْتِمُ عَمَلِيْ بِأَحْسَنِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَتَجْعَلُ لِيْ ثَوَابَهُ الْجَنَّةَ"
    },
    {
      "kind": "text",
      "ar": "وَتَسْلُكُ بِيْ سَبِيْلَ الصَّالِحِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَتُعِيْنُنِيْ عَلٰي صَالِحِ مَا أَعْطَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "كَمَا أَعَنْتَ الصَّالِحِيْنَ عَلٰي صَالِحِ مَا أَعْطَيْتَهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَنْزِعْ مِنِّيْ صَالِحًا أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَرُدَّنِيْ فِيْ سُوْءٍ اسْتَنْقَذْتَنِيْ مِنْهُ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُشْمِتْ بِيْ عَدُوًّا وَلَا حَاسِدًا أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَكِلْنِيْ اِلٰي نَفْسِيْ طَرْفَةَ عَيْنٍ أَبَدًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَقَلَّ مِنْ ذٰلِكَ وَلَا أَكْثَرَ، يَا رَبَّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَرِنِي الْحَقَّ حَقًّا فَأَتَّبِعَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَالْبَاطِلَ بَاطِلًا فَأَجْتَنِبَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَجْعَلْهُ عَلَيَّ مُتَشَابِهًا"
    },
    {
      "kind": "text",
      "ar": "فَأَتَّبِعَ هَوَايَ بِغَيْرِ هُدًى مِنْكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ هَوَايَ تَبَعًا لِطَاعَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَخُذْ رِضَا نَفْسِكَ مِنْ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاهْدِنِيْ لِمَا اخْتُلِفَ فِيْهِ مِنَ الْحَقِّ بِاِذْنِكَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ تَهْدِيْ مَنْ تَشَاءُ اِلٰي صِرَاطٍ مُسْتَقِيْمٍ۔"
    }
  ]
}