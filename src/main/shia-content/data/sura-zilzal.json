{
  "id": "sura-zilzal",
  "title": "سورۂ زلزال",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ زلزال",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَاۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَاۙ۝۲"
    },
    {
      "kind": "text",
      "ar": "وَقَالَ الْاِنْسَانُ مَا لَهَاۚ۝۳"
    },
    {
      "kind": "text",
      "ar": "يَوْمَىِٕذٍ تُحَدِّثُ اَخْبَارَهَاۙ۝۴"
    },
    {
      "kind": "text",
      "ar": "بِاَنَّ رَبَّكَ اَوْحٰى لَهَاؕ۝۵"
    },
    {
      "kind": "text",
      "ar": "يَوْمَىِٕذٍ يَّصْدُرُ النَّاسُ اَشْتَاتًا١ۙ۬ لِّيُرَوْا اَعْمَالَهُمْؕ۝۶"
    },
    {
      "kind": "text",
      "ar": "فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَّرَهٗؕ۝۷"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَّرَهٗ۠۝۸"
    }
  ]
}