{
  "id": "thursday-ziyarah",
  "title": "زيارة يوم الخميس للإمام الحسن العسكري ع",
  "subtitle": "زيارة الإمام الحسن العسكري عليه السلام يوم الخميس",
  "source": "مفاتيح الجنان، أعمال أيام الأسبوع",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "زيارة يوم الخميس", "subtitle": "للإمام الحسن العسكري عليه السلام" },
    { "kind": "text", "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ" },
    { "kind": "text", "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ وَخَالِصَتَهُ" },
    { "kind": "text", "ar": "اَلسَّلَامُ عَلَيْكَ يَا إِمَامَ الْمُؤْمِنِينَ" },
    { "kind": "text", "ar": "وَوَارِثَ الْمُرْسَلِينَ وَحُجَّةَ رَبِّ الْعَالَمِينَ" },
    { "kind": "text", "ar": "صَلَّى اللهُ عَلَيْكَ وَعَلَى آلِ بَيْتِكَ الطَّيِّبِينَ الطَّاهِرِينَ" },
    { "kind": "text", "ar": "يَا مَوْلَايَ يَا أَبَا مُحَمَّدٍ الْحَسَنَ بْنَ عَلِيٍّ" },
    { "kind": "text", "ar": "أَنَا مَوْلىً لَكَ وَلِآلِ بَيْتِكَ" },
    { "kind": "text", "ar": "وَهَذَا يَوْمُكَ وَهُوَ يَوْمُ الْخَمِيسِ" },
    { "kind": "text", "ar": "وَأَنَا ضَيْفُكَ فِيهِ وَمُسْتَجِيرٌ بِكَ فِيهِ" },
    { "kind": "text", "ar": "فَأَحْسِنْ ضِيَافَتِي وَإِجَارَتِي" },
    { "kind": "text", "ar": "بِحَقِّ آلِ بَيْتِكَ الطَّيِّبِينَ الطَّاهِرِينَ" }
  ]
}
