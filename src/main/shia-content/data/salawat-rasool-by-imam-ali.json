{
  "id": "salawat-rasool-by-imam-ali",
  "title": "صلواة بر رسولِ خدا بزبان حضرت علي",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "صلواة بر رسولِ خدا بزبان حضرت علي",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ وَمَلَائِكَتَهٗ يُصَلُّوْنَ عَلَي النَّبِيِّ"
    },
    {
      "kind": "text",
      "ar": "يَا أَيُّهَا الَّذِيْنَ اٰمَنُوْا صَلُّوْا عَلَيْهِ وَسَلِّمُوْا تَسْلِيْمًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَبَارِكْ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَتَحَنَّنْ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَسَلِّمْ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "كَأَفْضَلِ مَا صَلَّيْتَ وَبَارَكْتَ وَتَرَحَّمْتَ وَتَحَنَّنْتَ وَسَلَّمْتَ"
    },
    {
      "kind": "text",
      "ar": "عَلٰي اِبْرَاهِيْمَ وَاٰلِ اِبْرَاهِيْمَ، اِنَّكَ حَمِيْدٌ مَجِيْدٌ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعْطِ مُحَمَّدًا الْوَسِيْلَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالشَّرَفَ وَالْفَضِيْلَةَ وَالْمَنْزِلَةَ الْكَرِيْمَةَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ مُحَمَّدًا وَاٰلَ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "أَعْظَمَ الْخَلَائِقِ كُلِّهِمْ شَرَفًا يَوْمَ الْقِيَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَأَقْرَبَهُمْ مِنْكَ مَقْعَدًا"
    },
    {
      "kind": "text",
      "ar": "وَأَوْجَهَهُمْ عِنْدَكَ يَوْمَ الْقِيَامَةِ جَاهًا"
    },
    {
      "kind": "text",
      "ar": "وَأَفْضَلَهُمْ عِنْدَكَ مَنْزِلَةً وَنَصِيْبًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَعْطِ مُحَمَّدًا أَشْرَفَ الْمَقَامِ"
    },
    {
      "kind": "text",
      "ar": "وَحِبَاءَ السَّلَامِ، وَشَفَاعَةَ الْاِسْلَامِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ وَأَلْحِقْنَا بِهٖ غَيْرَ خَزَايَا"
    },
    {
      "kind": "text",
      "ar": "وَلَا نَاكِثِيْنَ وَلَا نَادِمِيْنَ وَلَا مُبَدِّلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِلٰهَ الْحَقِّ اٰمِيْنَ۔"
    }
  ]
}