{
  "id": "ziarat-imam-taqi-3",
  "title": "امام محمد تقي  كي ايك اور مخصوص زيارت",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "امام محمد تقي  كي ايك اور مخصوص زيارت",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدِ ابْنِ عَلِيٍّ"
    },
    {
      "kind": "text",
      "ar": "الْاِمَامِ التَّقِيِّ النَّقِيِّ الرَّضِيِّ الْمَرْضِيِّ"
    },
    {
      "kind": "text",
      "ar": "وَحُجَّتِكَ عَلٰي مَنْ فَوْقَ الْاَرْضِ وَمَنْ تَحْتَ الثَّرٰي"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً كَثِيْرَةً نَامِيَةً زَاكِيَةً مُبَارَكَةً"
    },
    {
      "kind": "text",
      "ar": "مُتَوَاصِلَةً مُتَرَادِفَةً مُتَوَاتِرَةً"
    },
    {
      "kind": "text",
      "ar": "كَأَفْضَلِ مَا صَلَّيْتَ عَلٰي أَحَدٍ مِنْ أَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نُوْرَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا اِمَامَ الْمُؤْمِنِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَوَارِثَ عِلْمِ النَّبِيِّيْنَ، وَسُلَالَةَ الْوَصِيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا نُوْرَ اللهِ فِيْ ظُلُمَاتِ الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "أَتَيْتُكَ زَائِرًا، عَارِفًا بِحَقِّكَ"
    },
    {
      "kind": "text",
      "ar": "مُعَادِيًا لِاَعْدَائِكَ، مُوَالِيًا لِاَوْلِيَائِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاشْفَعْ لِيْ عِنْدَ رَبِّكَ۔"
    }
  ]
}