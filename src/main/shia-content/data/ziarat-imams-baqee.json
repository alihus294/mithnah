{
  "id": "ziarat-imams-baqee",
  "title": "زيارات آئمه بقيع",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارات آئمه بقيع",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "يَا مَوَالِيَّ يَا أَبْنَاءَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "عَبْدُكُمْ وَابْنُ أَمَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "الذَّلِيْلُ بَيْنَ أَيْدِيْكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُضْعِفُ فِيْ عُلُوِّ قَدْرِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْمُعْتَرِفُ بِحَقِّكُمْ، جَائَكُمْ مُسْتَجِيْرًا بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "قَاصِدًا اِلٰي حَرَمِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُتَقَرِّبًا اِلٰي مَقَامِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُتَوَسِّلًا اِلَي اللهِ تَعَالٰي بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "أَأَدْخُلُ يَا مَوَالِيَّ، أَأَدْخُلُ يَا أَوْلِيَاءَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَأَدْخُلُ يَا مَلَائِكَةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "الْمُحْدِقِيْنَ بِهٰذَا الْحَرَمِ الْمُقِيْمِيْنَ بِهٰذَا الْمَشْهَدِ۔"
    },
    {
      "kind": "text",
      "ar": "اللهُ أَكْبَرُ كَبِيْرًا، وَالْحَمدُ لِلّٰهِ كَثِيْرًا"
    },
    {
      "kind": "text",
      "ar": "وَسُبْحَانَ اللهِ بُكْرَةً وَأَصِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمدُ لِلّٰهِ الْفَرْدِ الصَّمَدِ الْمَاجِدِ الْاَحَدِ"
    },
    {
      "kind": "text",
      "ar": "الْمُتَفَضِّلِ الْمَنّانِ الْمُتَطَوِّلِ الْحَنّانِ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ مَنَّ بِطَوْلِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَسَهَّلَ زِيَارَةَ سَادَاتِيْ بِاِحْسَانِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يَجْعَلْنِيْ عَنْ زِيَارَتِهِمْ مَمْنُوْعًا"
    },
    {
      "kind": "text",
      "ar": "بَلْ تَطَوَّلَ وَمَنَحَ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَئِمَّةَ الْهُدٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَهْلَ التَّقْوٰي"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَيُّهَا الْحُجَجُ عَلٰي أَهْلِ الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَيُّهَا الْقُوَّامُ فِي الْبَرِيَّةِ بِالْقِسْطِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَهْلَ الصَّفْوَةِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ اٰلَ رَسُوْلِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَهْلَ النَّجْوٰي"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنَّكُمْ قَدْ بَلَّغْتُمْ وَنَصَحْتُمْ"
    },
    {
      "kind": "text",
      "ar": "وَصَبَرْتُمْ فِيْ ذَاتِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "وَكُذِّبْتُمْ وَأُسِيْءَ اِلَيْكُمْ فَغَفَرْتُمْ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّكُمُ الْاَئِمَّةُ الرَّاشِدُوْنَ الْمُهْتَدُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ طَاعَتَكُمْ مَفْرُوْضَةٌ، وَأَنَّ قَوْلَكُمُ الصِّدْقُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكُمْ دَعَوْتُمْ فَلَمْ تُجَابُوْا"
    },
    {
      "kind": "text",
      "ar": "وَأَمَرْتُمْ فَلَمْ تُطَاعُوْا"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكُمْ دَعَائِمُ الدِّيْنِ وَأَرْكَانُ الْاَرْضِ"
    },
    {
      "kind": "text",
      "ar": "لَمْ تَزَالُوْا بِعَيْنِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "يَنْسَخُكُمْ مِنْ أَصْلَابِ كُلِّ مُطَهَّرٍ"
    },
    {
      "kind": "text",
      "ar": "وَيَنْقُلُكُمْ مِنْ أَرْحَامِ الْمُطَهَّرَاتِ"
    },
    {
      "kind": "text",
      "ar": "لَمْ تُدَنِّسْكُمُ الْجَاهِلِيَّةُ الْجَهْلَاءُ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ تَشْرَكْ فِيْكُمْ فِتَنُ الْاَهْوَاءِ"
    },
    {
      "kind": "text",
      "ar": "طِبْتُمْ وَطَابَ مَنْبَتُكُمْ"
    },
    {
      "kind": "text",
      "ar": "مَنَّ بِكُمْ عَلَيْنَا دَيَّانُ الدِّيْنِ"
    },
    {
      "kind": "text",
      "ar": "فَجَعَلَكُمْ فِيْ بُيُوْتٍ أَذِنَ اللهُ أَنْ تُرْفَعَ وَيُذْكَرَ فِيْهَا اسْمُهٗ"
    },
    {
      "kind": "text",
      "ar": "وَجَعَلَ صَلَاتَنَا عَلَيْكُمْ رَحْمَةً لَنَا وَكَفَّارَةً لِذُنُوْبِنَا"
    },
    {
      "kind": "text",
      "ar": "اِذِ اخْتَارَكُمُ اللهُ لَنَا"
    },
    {
      "kind": "text",
      "ar": "وَطَيَّبَ خَلْقَنَا بِمَا مَنَّ عَلَيْنَا مِنْ وِلَايَتِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَكُنَّا عِنْدَهٗ مُسَمِّيْنَ بِعِلْمِكُمْ"
    },
    {
      "kind": "text",
      "ar": "مُعْتَرِفِيْنَ بِتَصْدِيْقِنَا اِيَّاكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَهٰذَا مَقَامُ مَنْ أَسْرَفَ وَأَخْطَأَ وَاسْتَكَانَ"
    },
    {
      "kind": "text",
      "ar": "وَأَقَرَّ بِمَا جَنٰي، وَرَجَا بِمَقَامِهِ الْخَلَاصَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ يَسْتَنْقِذَهٗ بِكُمْ مُسْتَنْقِذُ الْهَلْكٰي مِنَ الرَّدٰي"
    },
    {
      "kind": "text",
      "ar": "فَكُوْنُوْا لِيْ شُفَعَاءَ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ وَفَدْتُ اِلَيْكُمْ اِذْ رَغِبَ عَنْكُمْ أَهْلُ الدُّنْيَا"
    },
    {
      "kind": "text",
      "ar": "وَاتَّخَذُوْا اٰيَاتِ اللهِ هُزُوًا وَاسْتَكْبَرُوْا عَنْهَا"
    },
    {
      "kind": "text",
      "ar": "يَا مَنْ هُوَ قَائِمٌ لَا يَسْهُوْ، وَدَائِمٌ لَا يَلْهُوْ"
    },
    {
      "kind": "text",
      "ar": "وَمُحِيْطٌ بِكُلِّ شَيْءٍ"
    },
    {
      "kind": "text",
      "ar": "لَكَ الْمَنُّ بِمَا وَفَّقْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَرَّفْتَنِيْ بِمَا أَقَمْتَنِيْ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اِذْ صَدَّ عَنْهُ عِبَادُكَ، وَجَهِلُوْا مَعْرِفَتَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَخَفُّوْا بِحَقِّهٖ، وَمَالُوْا اِلٰي سِوَاهُ"
    },
    {
      "kind": "text",
      "ar": "فَكَانَتِ الْمِنَّةُ مِنْكَ عَلَيَّ"
    },
    {
      "kind": "text",
      "ar": "مَعَ أَقْوَامٍ خَصَصْتَهُمْ بِمَا خَصَصْتَنِيْ بِهٖ"
    },
    {
      "kind": "text",
      "ar": "فَلَكَ الْحَمدُ اِذْ كُنْتُ عِنْدَكَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ مَقَامِيْ هٰذَا مَذْكُوْرًا مَكْتُوْبًا"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَحْرِمْنِيْ مَا رَجَوْتُ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُخَيِّبْنِيْ فِيْمَا دَعَوْتُ"
    },
    {
      "kind": "text",
      "ar": "بِحُرْمَةِ مُحَمَّدٍ وَاٰلِهٖ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمْ أَئِمَّةَ الْهُدٰي وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْدِعُكُمُ اللهَ، وَأَقْرَأُ عَلَيْكُمُ السَّلَامَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنَّا بِاللّٰهِ وَبِالرَّسُوْلِ وَبِمَا جِئْتُمْ بِهٖ وَدَلَلْتُمْ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاكْتُبْنَا مَعَ الشَّاهِدِيْنَ۔"
    }
  ]
}