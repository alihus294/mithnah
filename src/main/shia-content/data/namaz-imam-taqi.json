{
  "id": "namaz-imam-taqi",
  "title": "نماز حضرت امام محمد تقي",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "نماز حضرت امام محمد تقي",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّ الْاَرْوَاحِ الْفَانِيَةِ، وَالْاَجْسَادِ الْبَالِيَةِ"
    },
    {
      "kind": "text",
      "ar": "أَسْأَلُكَ بِطَاعَةِ الْاَرْوَاحِ الرَّاجِعَةِ اِلٰي أَجْسَادِهَا"
    },
    {
      "kind": "text",
      "ar": "وَبِطَاعَةِ الْاَجْسَادِ الْمُلْتَئِمَةِ بِعُرُوْقِهَا"
    },
    {
      "kind": "text",
      "ar": "وَبِكَلِمَتِكَ النَّافِذَةِ بَيْنَهُمْ وَأَخْذِكَ الْحَقَّ مِنْهُمْ"
    },
    {
      "kind": "text",
      "ar": "وَالْخَلَائِقُ بَيْنَ يَدَيْكَ يَنْتَظِرُوْنَ فَصْلَ قَضَائِكَ"
    },
    {
      "kind": "text",
      "ar": "وَيَرْجُوْنَ رَحْمَتَكَ وَيَخَافُوْنَ عِقَابَكَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلِ النُّوْرَ فِيْ بَصَرِيْ، وَالْيَقِيْنَ فِيْ قَلْبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَذِكْرَكَ بِاللَّيْلِ وَالنَّهَارِ عَلٰي لِسَانِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَمَلًا صَالِحًا فَارْزُقْنِيْ"
    }
  ]
}