{
  "id": "sura-falaq",
  "title": "سورۂ فلق",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ فلق",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "قُلْ اَعُوْذُ بِرَبِّ الْفَلَقِۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "مِنْ شَرِّ مَا خَلَقَۙ۝۲"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ۝۳"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ النَّفّٰثٰتِ فِي الْعُقَدِۙ۝۴"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ۠۝۵"
    }
  ]
}