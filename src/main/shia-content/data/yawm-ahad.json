{
  "id": "yawm-ahad",
  "title": "دُعاءُ يَوْمِ الأَحَد",
  "subtitle": "من أدعية الأيام السبعة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    { "kind": "title", "ar": "دُعاءُ يَوْمِ الأَحَد", "subtitle": "من أدعية الأيام السبعة" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الرَّحْمنِ الرَّحِيمِ" },
    { "kind": "text", "ar": "بِسْمِ اللهِ الَّذِي لا أَرْجو إِلاَّ فَضْلَهُ" },
    { "kind": "text", "ar": "وَلا أَخْشَىٰ إِلاَّ عَدْلَهُ" },
    { "kind": "text", "ar": "وَلا أَعْتَمِدُ إِلاَّ قَوْلَهُ" },
    { "kind": "text", "ar": "وَلا أُمْسِكُ إِلاَّ بِحَبْلِهِ" },
    { "kind": "text", "ar": "بِكَ أَسْتَجِيرُ يا ذا العَفْوِ وَالرِّضْوانِ" },
    { "kind": "text", "ar": "مِنْ الظُّلْمِ وَالعُدْوانِ" },
    { "kind": "text", "ar": "وَمِنْ غِيَرِ الزَّمانِ، وَتواتُرِ الأَحْزانِ" },
    { "kind": "text", "ar": "وَطوارِقِ الحَدَثانِ" },
    { "kind": "text", "ar": "وَمِنْ انْقضاءِ المُدَّةِ قَبْلَ التَّأَهُّبِ وَالعُدَّةِ" },
    { "kind": "text", "ar": "وَإِياكَ أَسْتَرْشِدُ لِما فِيهِ الصَّلاحُ وَالإِصْلاحُ" },
    { "kind": "text", "ar": "وَبِكَ أَسْتَعِينُ فِيما يَقْتَرِنُ بِهِ النَّجاحُ وَالإِنْجاحُ" },
    { "kind": "text", "ar": "وَإِيَّاكَ أَرْغَبُ فِي لِباسِ العافِيَةِ وَتَمَامِها" },
    { "kind": "text", "ar": "وَشُمُولِ السَّلامَةِ وَدَوَامِها" },
    { "kind": "text", "ar": "وأَعُوذُ بِكَ يا رَبِّ مِنْ هَمَزاتِ الشَّياطِينِ" },
    { "kind": "text", "ar": "وَأَحْتَرِزُ بِسُلْطانِكَ مِنْ جَوْرِ السَّلاطِينِ" },
    { "kind": "text", "ar": "فَتَقَبَّلْ ما كانَ مِنْ صَلاتِي وَصَوْمِي" },
    { "kind": "text", "ar": "وَاجْعَلْ غَدِي وَما بَعْدَهُ أَفْضَلَ مِنْ ساعَتِي وَيَوْمِي" },
    { "kind": "text", "ar": "وَأَعِزَّنِي فِي عَشِيرَتِي وَقَوْمِي" },
    { "kind": "text", "ar": "وَاحْفَظْنِي فِي يَقْظَتِي وَنَوْمِي" },
    { "kind": "text", "ar": "فَأَنْتَ اللهُ خَيْرٌ حافِظاً وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ" },
    { "kind": "text", "ar": "اللَّهُمَّ إِنِّي أَبْرَأُ إِلَيكَ فِي يَوْمِي هذا وَما بَعْدَهُ مِنَ الآحادِ" },
    { "kind": "text", "ar": "مِنَ الشِّرْكِ وَالإِلْحادِ" },
    { "kind": "text", "ar": "وَأُخْلِصُ لَكَ دُعائِي تَعَرُّضاً لِلإِجابَةِ" },
    { "kind": "text", "ar": "وَأُقِيمُ عَلَىٰ طاعَتِكَ رَجاءً لِلإِثابَةِ" },
    { "kind": "text", "ar": "فَصَلِّ عَلَىٰ مُحَمَّدٍ خَيْرِ خَلْقِكَ، الدَّاعِي إِلَىٰ حَقِّكَ" },
    { "kind": "text", "ar": "وَأَعِزَّنِي بِعِزِّكَ الَّذِي لا يُضامُ" },
    { "kind": "text", "ar": "وَاحْفَظْنِي بِعَيْنِكَ الَّتِي لا تَنامُ" },
    { "kind": "text", "ar": "وَاخْتِمْ بِالاِنْقِطاعِ إِلَيْكَ أَمْرِي" },
    { "kind": "text", "ar": "وَبِالمَغْفِرَةِ عُمْرِي" },
    { "kind": "text", "ar": "إِنَّكَ أَنْتَ الغَفُورُ الرَّحِيمُ" }
  ]
}
