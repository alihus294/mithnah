{
  "id": "ziarat-madina-wida",
  "title": "زيارت وداع رسول خدا",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت وداع رسول خدا",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا رَسُوْلَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَوْدِعُكَ اللهَ وَأَسْتَرْعِيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَأَقْرَأُ عَلَيْكَ السَّلَامَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنْتُ بِاللّٰهِ وَبِمَا جِئْتَ بِهٖ وَدَلَلْتَ عَلَيْهِ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَجْعَلْهُ اٰخِرَ الْعَهْدِ مِنِّيْ لِزِيَارَةِ قَبْرِ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ تَوَفَّيْتَنِيْ قَبْلَ ذٰلِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ أَشْهَدُ فِيْ مَمَاتِيْ عَلٰي مَا شَهِدْتُ عَلَيْهِ فِيْ حَيَاتِيْ"
    },
    {
      "kind": "text",
      "ar": "أَنْ لَا اِلٰهَ اِلَّا أَنْتَ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مُحَمَّدًا عَبْدُكَ وَرَسُوْلُكَ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ۔"
    },
    {
      "kind": "text",
      "ar": "صَلَي اللهُ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ لَا جَعَلَهُ اللهُ اٰخِرَ تَسْلِيْمِيْ عَلَيْكَ۔"
    }
  ]
}