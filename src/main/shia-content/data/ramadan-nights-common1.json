{
  "id": "ramadan-nights-common1",
  "title": "هر رات كي سورتيں اور دعا",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "هر رات كي سورتيں اور دعا",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ رَبَّ شَهْرِ رَمَضَانَ"
    },
    {
      "kind": "text",
      "ar": "الَّذِيْ أَنْزَلْتَ فِيْهِ الْقُرْاٰنَ"
    },
    {
      "kind": "text",
      "ar": "وَافْتَرَضْتَ عَلٰي عِبَادِكَ فِيْهِ الصِّيَامَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِيْ حَجَّ بَيْتِكَ الْحَرَامِ"
    },
    {
      "kind": "text",
      "ar": "فِيْ عَامِيْ هٰذَا وَفِيْ كُلِّ عَامٍ"
    },
    {
      "kind": "text",
      "ar": "وَاغْفِر لِيْ تِلْكَ الذُّنُوْبَ الْعِظَامَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّهٗ لَا يَغْفِرُهَا غَيْرُكَ يَا رَحْمٰنُ يَا عَلَّامُ"
    }
  ]
}