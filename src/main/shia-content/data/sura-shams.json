{
  "id": "sura-shams",
  "title": "سورۂ شمس",
  "subtitle": "السور القرآنية المخصوصة",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "سورۂ شمس",
      "subtitle": "السور القرآنية المخصوصة"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "وَالشَّمْسِ وَضُحٰىهَا۪ۙ۝۱"
    },
    {
      "kind": "text",
      "ar": "وَالْقَمَرِ اِذَا تَلٰىهَا۪ۙ۝۲"
    },
    {
      "kind": "text",
      "ar": "وَالنَّهَارِ اِذَا جَلّٰىهَا۪ۙ۝۳"
    },
    {
      "kind": "text",
      "ar": "وَالَّيْلِ اِذَا يَغْشٰىهَا۪ۙ۝۴"
    },
    {
      "kind": "text",
      "ar": "وَالسَّمَآءِ وَمَا بَنٰىهَا۪ۙ۝۵"
    },
    {
      "kind": "text",
      "ar": "وَالْاَرْضِ وَمَا طَحٰىهَا۪ۙ۝۶"
    },
    {
      "kind": "text",
      "ar": "وَنَفْسٍ وَّمَا سَوّٰىهَا۪ۙ۝۷"
    },
    {
      "kind": "text",
      "ar": "فَاَلْهَمَهَا فُجُوْرَهَا وَتَقْوٰىهَا۪ۙ۝۸"
    },
    {
      "kind": "text",
      "ar": "قَدْ اَفْلَحَ مَنْ زَكّٰىهَا۪ۙ۝۹"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ خَابَ مَنْ دَسّٰىهَاؕ۝۱۰"
    },
    {
      "kind": "text",
      "ar": "كَذَّبَتْ ثَمُوْدُ بِطَغْوٰىهَا۪ۤۙ۝۱۱"
    },
    {
      "kind": "text",
      "ar": "اِذِ انْۢبَعَثَ اَشْقٰىهَا۪ۙ۝۱۲"
    },
    {
      "kind": "text",
      "ar": "فَقَالَ لَهُمْ رَسُوْلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقْيٰهَاؕ۝۱۳"
    },
    {
      "kind": "text",
      "ar": "فَكَذَّبُوْهُ فَعَقَرُوْهَا١۪ۙ۬"
    },
    {
      "kind": "text",
      "ar": "فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْۢبِهِمْ فَسَوّٰىهَا۪ۙ۝۱۴"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَخَافُ عُقْبٰهَا۠۝۱۵"
    }
  ]
}