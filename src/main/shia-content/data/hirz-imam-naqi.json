{
  "id": "hirz-imam-naqi",
  "title": "۸۔ حرز امام علي نقي",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "۸۔ حرز امام علي نقي",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "يَا عَزِيْزَ الْعِزِّ فِيْ عِزِّهٖ"
    },
    {
      "kind": "text",
      "ar": "مَا أَعَزَّ عَزِيْزَ الْعِزِّ فِيْ عِزِّهٖ"
    },
    {
      "kind": "text",
      "ar": "يَا عَزِيْزُ أَعِزَّنِيْ بِعِزِّكَ وَأَيِّدْنِيْ بِنَصْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَادْفَعْ عَنِّيْ هَمَزَاتِ الشَّيَاطِيْنِ"
    },
    {
      "kind": "text",
      "ar": "وَادْفَعْ عَنِّيْ بِدَفْعِكَ"
    },
    {
      "kind": "text",
      "ar": "وَامْنَعْ عَنِّيْ بِصُنْعِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ خِيَارِ خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "يَا وَاحِدُ يَا أَحَدُ يَا فَرْدُ يَا صَمَدُ"
    }
  ]
}