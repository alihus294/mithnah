{
  "id": "karbala-haram-amaal",
  "title": "حرم امام حسين كے اعمال",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "حرم امام حسين كے اعمال",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ قَدْ تَرٰي مَكَانِيْ، وَتَسْمَعُ كَلَامِيْ"
    },
    {
      "kind": "text",
      "ar": "وَتَرٰي مَقَامِيْ وَتَضَرُّعِيْ وَمَلَاذِيْ"
    },
    {
      "kind": "text",
      "ar": "بِقَبْرِ حُجَّتِكَ وَابْنِ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ عَلِمْتَ يَا سَيِّدِيْ حَوَائِجِيْ"
    },
    {
      "kind": "text",
      "ar": "وَلَا يَخْفٰي عَلَيْكَ حَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ تَوَجَّهْتُ اِلَيْكَ بِابْنِ رَسُوْلِكَ وَحُجَّتِكَ وَأَمِيْنِكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ أَتَيْتُكَ مُتَقَرِّبًا بِهٖ اِلَيْكَ وَاِلٰي رَسُوْلِكَ"
    },
    {
      "kind": "text",
      "ar": "فَاجْعَلْنِيْ بِهٖ عِنْدَكَ وَجِيْهًا"
    },
    {
      "kind": "text",
      "ar": "فِي الدُّنْيَا وَالْاٰخِرَةِ وَمِنَ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعْطِنِيْ بِزِيَارَتِيْ أَمَلِيْ، وَهَبْ لِيْ مُنَايَ"
    },
    {
      "kind": "text",
      "ar": "وَتَفَضَّلْ عَلَيَّ بِشَهْوَتِيْ وَرَغْبَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاقْضِ لِيْ حَوَآئِجِيْ، وَلَا تَرُدَّنِيْ خَائِبًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَقْطَعْ رَجَائِيْ، وَلَا تُخَيِّبْ دُعَائِيْ"
    },
    {
      "kind": "text",
      "ar": "وَعَرِّفْنِي الْاِجَابَةَ فِيْ جَمِيْعِ مَا دَعَوْتُكَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ أَمْرِ الدِّيْنِ وَالدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْنِيْ مِنْ عِبَادِكَ الَّذِيْنَ صَرَفْتَ عَنْهُمُ"
    },
    {
      "kind": "text",
      "ar": "الْبَلَايَا وَالْاَمْرَاضَ وَالْفِتَنَ وَالْاَعْرَاضَ"
    },
    {
      "kind": "text",
      "ar": "مِنَ الَّذِيْنَ تُحْيِيْهِمْ فِيْ عَافِيَةٍ، وَتُمِيْتُهمْ فِيْ عَافِيَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَتُدْخِلُهُمُ الْجَنَّةَ فِيْ عَافِيَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَتُجِيْرُهُمْ مِنَ النَّارِ فِيْ عَافِيَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَوَفِّقْ لِيْ بِمَنٍّ مِنْكَ صَلَاحَ مَا أُؤَمِّلُ فِيْ نَفْسِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَهْلِيْ وَوُلْدِيْ وَاِخْوَانِيْ وَمَالِيْ"
    },
    {
      "kind": "text",
      "ar": "وَجَمِيْعِ مَا أَنْعَمْتَ بِهٖ عَلَيَّ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلَي الْحُسَيْنِ الْمَظْلُوْمِ الشَّهِيْدِ"
    },
    {
      "kind": "text",
      "ar": "قَتِيْل الْعَبَرَاتِ وَأَسِيْرِ الْكُرُبَاتِ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً نَامِيَةً زَاكِيَةً مُبَارَكَةً"
    },
    {
      "kind": "text",
      "ar": "يَصْعَدُ أَوَّلُهَا وَلَا يَنْفَدُ اٰخِرُهَا"
    },
    {
      "kind": "text",
      "ar": "أَفْضَلَ مَا صَلَّيْتَ عَلٰي أَحَدٍ مِنْ أَوْلَادِ الْاَنْبِيَاءِ وَالْمُرْسَلِيْنَ"
    },
    {
      "kind": "text",
      "ar": "يَا رَبَّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلَي الْاِمَامِ الشَّهِيْدِ"
    },
    {
      "kind": "text",
      "ar": "الْمَقْتُوْلِ الْمَظْلُوْمِ الْمَخْذُوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَالسَّيِّدِ الْقَائِدِ وَالْعَابِدِ الزَّاهِدِ"
    },
    {
      "kind": "text",
      "ar": "وَالْوَصِيِّ الْخَلِيْفَةِ الْاِمَامِ الصِّدِّيْقِ"
    },
    {
      "kind": "text",
      "ar": "الطُّهْرِ الطَّاهِرِ الطَّيِّبِ الْمُبَارَكِ"
    },
    {
      "kind": "text",
      "ar": "وَالرَّضِيِّ الْمَرْضِيِّ، وَالتَّقِيِّ الْهَادِي الْمَهْدِيِّ"
    },
    {
      "kind": "text",
      "ar": "الزَّاهِدِ الذَّائِدِ الْمُجَاهِدِ الْعَالِمِ"
    },
    {
      "kind": "text",
      "ar": "اِمَامِ الْهُدٰي، سِبْطِ الرَّسُوْلِ وَقُرَّةِ عَيْنِ الْبَتُوْلِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي سَيِّدِيْ وَمَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "كَمَا عَمِلَ بِطَاعَتِكَ، وَنَهٰي عَنْ مَعْصِيَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَبَالَغَ فِيْ رِضْوَانِكَ، وَأَقْبَلَ عَلٰي اِيْمَانِكَ"
    },
    {
      "kind": "text",
      "ar": "غَيْرَ قَابِلٍ فِيْكَ عُذْرًا سِرًّا وَعَلَانِيَةً"
    },
    {
      "kind": "text",
      "ar": "يَدْعُوْ الْعِبَادَ اِلَيْكَ، وَيَدُلُّهُمْ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَقَامَ بَيْنَ يَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "يَهْدِمُ الْجَوْرَ بِالصَّوَابِ"
    },
    {
      "kind": "text",
      "ar": "وَيُحْيِي السُّنَّةَ بِالْكِتَابِ"
    },
    {
      "kind": "text",
      "ar": "فَعَاشَ فِيْ رِضْوَانِكَ مَكْدُوْدًا"
    },
    {
      "kind": "text",
      "ar": "وَمَضٰي عَلٰي طَاعَتِكَ وَفِيْ أَوْلِيَائِكَ مَكْدُوْحًا"
    },
    {
      "kind": "text",
      "ar": "وَقَضٰي اِلَيْكَ مَفْقُوْدًا"
    },
    {
      "kind": "text",
      "ar": "لَمْ يَعْصِكَ فِيْ لَيْلٍ وَلَا نَهَارٍ"
    },
    {
      "kind": "text",
      "ar": "بَلْ جَاهَدَ فِيْكَ الْمُنَافِقِيْنَ وَالْكُفَّارَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاجْزِهٖ خَيْرَ جَزَاءِ الصَّادِقِيْنَ الْاَبْرَارِ"
    },
    {
      "kind": "text",
      "ar": "وَضَاعِفْ عَلَيْهِمُ الْعَذَابَ وَلِقَاتِلِيْهِ الْعِقَابَ"
    },
    {
      "kind": "text",
      "ar": "فَقَدْ قَاتَلَ كَرِيْمًا، وَقُتِلَ مَظْلُوْمًا، وَمَضٰي مَرْحُوْمًا"
    },
    {
      "kind": "text",
      "ar": "يَقُوْلُ أَنَا ابْنُ رَسُوْلِ اللهِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَابْنُ مَنْ زَكّٰي وَعَبَدَ"
    },
    {
      "kind": "text",
      "ar": "فَقَتَلُوْهُ بِالْعَمْدِ الْمُعْتَمَدِ"
    },
    {
      "kind": "text",
      "ar": "قَتَلُوْهُ عَلَي الْاِيْمَانِ"
    },
    {
      "kind": "text",
      "ar": "وَأَطَاعُوْا فِيْ قَتْلِهِ الشَّيْطَانَ"
    },
    {
      "kind": "text",
      "ar": "وَلَمْ يُرَاقِبُوْا فِيْهِ الرَّحْمٰنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَصَلِّ عَلٰي سَيِّدِيْ وَمَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "صَلَاةً تَرْفَعُ بِهَا ذِكْرَهٗ وَتُظْهِرُ بِهَا أَمْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَتُعَجِّلُ بِهَا نَصْرَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَاخْصُصْهُ بِأَفْضَلِ قِسَمِ الْفَضَائِلِ يَوْمَ الْقِيَامَةِ"
    },
    {
      "kind": "text",
      "ar": "وَزِدْهُ شَرَفًا فِيْ أَعْلٰي عِلِّيِّيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْهُ أَعْلٰي شَرَفِ الْمُكَرَّمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَارْفَعْهُ مِنْ شَرَفِ رَحْمَتِكَ"
    },
    {
      "kind": "text",
      "ar": "فِيْ شَرَفِ الْمُقَرَّبِيْنَ فِي الرَّفِيْعِ الْاَعْلٰي"
    },
    {
      "kind": "text",
      "ar": "وَبَلِّغْهُ الْوَسِيْلَةَ، وَالْمَنْزِلَةَ الْجَلِيْلَةَ"
    },
    {
      "kind": "text",
      "ar": "وَالْفَضْلَ وَالْفَضِيْلَةَ، وَالْكَرَامَةَ الْجَزِيْلَةَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ فَاجْزِهٖ عَنَّا أَفْضَلَ مَا جَازَيْتَ اِمَامًا عَنْ رَعِيَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلٰي سَيِّدِيْ وَمَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "كُلَّمَا ذُكِرَ وَكُلَّمَا لَمْ يُذْكَرْ"
    },
    {
      "kind": "text",
      "ar": "يَا سَيِّدِيْ وَمَوْلَايَ، أَدْخِلْنِيْ فِيْ حِزْبِكَ وَزُمْرَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاسْتَوْهِبْنِيْ مِنْ رَبِّكَ وَرَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّ لَكَ عِنْدَ اللهِ جَاهًا وَقَدْرًا وَمَنْزِلَةً رَفِيْعَةً"
    },
    {
      "kind": "text",
      "ar": "اِنْ سَأَلْتَ أُعْطِيْتَ، وَاِنْ شَفَعْتَ شُفِّعْتَ"
    },
    {
      "kind": "text",
      "ar": "اللهَ اللهَ فِيْ عَبْدِكَ وَمَوْلَاكَ"
    },
    {
      "kind": "text",
      "ar": "لَا تُخَلِّنِيْ عِنْدَ الشَّدَائِدِ وَالْاَهْوَالِ"
    },
    {
      "kind": "text",
      "ar": "لِسُوْءِ عَمَلِيْ، وَقَبِيْحِ فِعْلِيْ، وَعَظِيْمِ جُرْمِيْ"
    },
    {
      "kind": "text",
      "ar": "فَاِنَّكَ أَمَلِيْ وَرَجَائِيْ وَثِقَتِيْ وَمُعْتَمَدِيْ"
    },
    {
      "kind": "text",
      "ar": "وَوَسِيْلَتِيْ اِلَي اللهِ رَبِّيْ وَرَبِّكَ"
    },
    {
      "kind": "text",
      "ar": "لَمْ يَتَوَسَّلِ الْمُتَوَسِّلُوْنَ اِلَي اللهِ بِوَسِيْلَةٍ"
    },
    {
      "kind": "text",
      "ar": "هِيَ أَعْظَمُ حَقًّا، وَلَا أَوْجَبُ حُرْمَةً"
    },
    {
      "kind": "text",
      "ar": "وَلَا أَجَلُّ قَدْرًا عِنْدَهٗ مِنْكُمْ أَهْلَ الْبَيْتِ"
    },
    {
      "kind": "text",
      "ar": "لَا خَلَّفَنِيَ اللهُ عَنْكُمْ بِذُنوُبِيْ"
    },
    {
      "kind": "text",
      "ar": "وَجَمَعَنِيْ وَاِيَّاكُمْ فِيْ جَنَّةِ عَدْنٍ"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ أَعَدَّهَا لَكُمْ وَلِاَوْلِيَائِكُمْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ خَيْرُ الْغَافِرِيْنَ وَأَرْحَمُ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَبْلِغْ سَيِّدِيْ وَمَوْلَايَ تَحِيَّةً كَثِيْرَةً وَسَلَامًا"
    },
    {
      "kind": "text",
      "ar": "وَارْدُدْ عَلَيْنَا مِنْهُ السَّلَامَ، اِنَّكَ جَوَادٌ كَرِيْمٌ"
    },
    {
      "kind": "text",
      "ar": "وَصَلِّ عَلَيْهِ كُلَّمَا ذُكِرَ اَلسَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "وَكُلَّمَا لَمْ يُذْكَرْ يَا رَبَّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَعْتَزُّ بِدِيْنِكَ، وَأكْرُمُ بِهِدَايَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَفُلَانٌ يُذِلُّنِيْ بِشَرِّهٖ، وَيُهِيْنُنِيْ بِأَذِيَّتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَيُعِيْبُنِيْ بِوَلَاءِ أَوْلِيَائِكَ، وَيَبْهَتُنِيْ بِدَعْوَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَقَدْ جِئْتُ اِلٰي مَوْضِعِ الدُّعَاءِ وَضَمَانِكَ الْاِجَابَةَ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَعِدْنِيْ عَلَيْهِ، السَّاعَةَ السَّاعَةَ"
    },
    {
      "kind": "text",
      "ar": "مَوْلَايَ اِمَامِيْ مَظْلُوْمٌ"
    },
    {
      "kind": "text",
      "ar": "اسْتَعْدٰي عَلٰي ظَالِمِهٖ، النَّصْرَ النَّصْرَ"
    },
    {
      "kind": "text",
      "ar": "يَا أَبَا عَبْدِ اللهِ، أَشْهَدُ أَنَّكَ"
    },
    {
      "kind": "text",
      "ar": "تَشْهَدُ مَقَامِيْ، وَتَسْمَعُ كَلَامِيْ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّكَ حَيٌّ عِنْدَ رَبِّكَ تُرْزَقُ"
    },
    {
      "kind": "text",
      "ar": "فَاسْأَلْ رَبَّكَ وَرَبِّيْ فِيْ قَضَاءِ حَوَائِجِيْ۔"
    },
    {
      "kind": "text",
      "ar": "وَالْحَمْدُ لِلّٰهِ وَلَا اِلٰهَ اِلَّا اللهُ وَسُبْحَانَ اللهِ۔"
    },
    {
      "kind": "text",
      "ar": "اَسْتَخِيْرُ اللهَ بِرَحْمَتِهٖ خِيَرَةً فِيْ عَافِيَةٍ۔"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا مَوْلَايَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا حُجَّةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا صَفْوَةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا خَالِصَةَ اللهِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا قَتِيْلَ الظَّمَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا غَرِيْبَ الْغُرَبَاءِ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ سَلَامَ مُوَدِّعٍ لَا سَئِمٍ وَلَا قَالٍ"
    },
    {
      "kind": "text",
      "ar": "فَاِنْ أَمْضِ فَلَا عَنْ مَلَالَةٍ"
    },
    {
      "kind": "text",
      "ar": "وَاِنْ أُقِمْ فَلَا عَنْ سُوْءِ ظَنٍّ بِمَا وَعَدَ اللهُ الصَّابِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "لَا جَعَلَهُ اللهُ اٰخِرَ الْعَهْدِ مِنِّيْ لِزِيَارَتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَرَزَقَنِيَ اللهُ الْعَوْدَ اِلٰي مَشْهَدِكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَقَامَ بِفِنَائِكَ، وَالْقِيَامَ فِيْ حَرَمِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاِيَّاهُ أَسْأَلُ أَنْ يُسْعِدَنِيْ بِكُمْ"
    },
    {
      "kind": "text",
      "ar": "وَيَجْعَلَنِيْ مَعَكُمْ فِي الدُّنْيَا وَالْاٰخِرَةِ۔"
    }
  ]
}