{
  "id": "ziarat-wida-imam-reza",
  "title": "زيارت وداع امام رضا",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارت وداع امام رضا",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "لَا جَعَلَهُ اللهُ اٰخِرَ تَسْلِيْمِيْ عَلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكَ يَا وَلِيَّ اللهِ وَرَحْمَةُ اللهِ وَبَرَكَاتُهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَجْعَلْهُ اٰخِرَ الْعَهْدِ"
    },
    {
      "kind": "text",
      "ar": "مِنْ زِيَارَتِي ابْنَ نَبِيِّكَ وَحُجَّتِكَ عَلٰي خَلْقِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْمَعْنِيْ وَاِيَّاهُ فِيْ جَنَّتِكَ"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنِيْ مَعَهٗ وَفِيْ حِزْبِهٖ"
    },
    {
      "kind": "text",
      "ar": "مَعَ الشُّهَدَاءِ وَالصَّالِحِيْنَ، وَحَسُنَ أُولٰئِكَ رَفِيْقًا"
    },
    {
      "kind": "text",
      "ar": "وَأَسْتَوْدِعُكَ اللهَ وَأَسْتَرْعِيْكَ، وَأَقْرَأُ عَلَيْكَ السَّلَامَ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنَّا بِاللّٰهِ وَبِالرَّسُوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَا جِئْتَ بِهٖ وَدَلَلْتَ عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "فَاكْتُبْنَا مَعَ الشَّاهِدِيْنَ۔"
    }
  ]
}