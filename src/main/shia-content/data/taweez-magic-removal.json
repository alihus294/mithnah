{
  "id": "taweez-magic-removal",
  "title": "جادو كے توڑ كا تعويذ",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "جادو كے توڑ كا تعويذ",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ بِسْمِ اللهِ وَمَا شَاءَ اللهُ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَلَا حَوْلَ وَلَا قُوَّةَ اِلَّا بِاللّٰهِ۔"
    },
    {
      "kind": "text",
      "ar": "قَالَ مُوْسٰي مَا جِئْتُمْ بِهِ السِّحْرُ اِنَّ اللهَ سَيُبْطِلُهٗ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ لَا يُصْلِحُ عَمَلَ الْمُفْسِدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "فَوَقَعَ الْحَقُّ وَبَطَلَ مَا كَانُوْا يَعْمَلُوْنَ"
    },
    {
      "kind": "text",
      "ar": "فَغُلِبُوْا هُنَالِك وَانْقَلَبُوْا صَاغِرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اِنَّ رَبَّكُمُ اللهُ الَّذِيْ خَلَقَ السَّمٰوَاتِ وَالْاَرْضَ فِيْ سِتَّةِ أَيَّامٍ"
    },
    {
      "kind": "text",
      "ar": "ثُمَّ اسْتَوَي عَلَي الْعَرْشِ"
    },
    {
      "kind": "text",
      "ar": "يُغْشِي اللَّيْلَ النَّهَارَ يَطْلُبُهٗ حَثِيْثًا"
    },
    {
      "kind": "text",
      "ar": "وَالشَّمْسَ وَالْقَمَرَ وَالنُّجُوْمَ مَسَخَّرَاتٍ بِأَمْرِهٖ"
    },
    {
      "kind": "text",
      "ar": "أَلَا لَهُ الْخَلْقُ وَالْاَمْرُ تَبَارَكَ اللهُ رَبُّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أُدْعُوْا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ لَا يُحِبُّ الْمُعْتَدِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُفْسِدُوْا فِي الْاَرْضِ بَعْدَ اِصْلَاحِهَا"
    },
    {
      "kind": "text",
      "ar": "وَادْعُوْهُ خَوْفًا وَطَمَعًا"
    },
    {
      "kind": "text",
      "ar": "اِنَّ رَحْمَةَ اللهِ قَرِيْبٌ مِنَ الْمُحْسِنِيْنَ۔"
    }
  ]
}