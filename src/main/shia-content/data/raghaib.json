  "title": "ليلة الرغائب كے اعمال",
  "subtitle": "الأعمال",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "ليلة الرغائب كے اعمال",
      "subtitle": "الأعمال"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ النَبِيِّ الْاُمِّيِ وَعَلٰي اٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "سُبُّوْحٌ قُدُّوْسٌ رَبُّ الْمَلَائِكَةِ وَالرُّوْح"
    },
    {
      "kind": "text",
      "ar": "رَبِّ اغْفَرْ وَارْحَمْ وَتَجَاوَزْ عَمَّا تَعْلَمُ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ اَنْتَ الْعَلِيُّ الْاَعْظَمُ"
    },
    {
      "kind": "text",
      "ar": "سُبُّوْحٌ قُدُّوْسٌ رَبُّ الْمَلَائِكَةِ وَالرُّوْحِ"
    }
  ]
}