{
  "id": "ziarat-samara-wida",
  "title": "زيارتِ وداعِ سامره",
  "subtitle": "زيارات المعصومين",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "زيارتِ وداعِ سامره",
      "subtitle": "زيارات المعصومين"
    },
    {
      "kind": "text",
      "ar": "اَلسَّلَامُ عَلَيْكُمَا يَا وَلِيَّيِ اللهِ"
    },
    {
      "kind": "text",
      "ar": "أسْتَوْدِعُكُمَا الله وَأقْرَأُ عَلَيْكُمَا اَلسَّلَامُ"
    },
    {
      "kind": "text",
      "ar": "اٰمَنَّا بِاللّٰهِ وَبِالرَّسُوْلِ"
    },
    {
      "kind": "text",
      "ar": "وَبِمَا جِيْتُمَا بِهٖ وَدَلَلْتُمَا عَلَيْهِ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اكْتُبْنَا مَعَ الشَّاهِدِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَا تَجْعَلْهُ اٰخِرَ الْعَهْدِ مِنْ زِيَارَتِيْ اِيَّاهُمَا"
    },
    {
      "kind": "text",
      "ar": "وَارْزُقْنِي الْعَوْدَ اِلَيْهِمَا"
    },
    {
      "kind": "text",
      "ar": "وَاحْشُرْنِيْ مَعَهُمَا وَمَعَ اٰبَائِهِمَا الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَالْقَائِمِ الْحُجَّةِ مِنْ ذُرِّيَتِهِمَا"
    },
    {
      "kind": "text",
      "ar": "يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    }
  ]
}