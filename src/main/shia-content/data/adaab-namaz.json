{
  "id": "adaab-namaz",
  "title": "آداب نماز",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "آداب نماز",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أُقَدِّمُ اِلَيْك مُحَمَّدًا صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ"
    },
    {
      "kind": "text",
      "ar": "بَيْنَ يَدَيْ حَاجَتِيْ وَأَتَوَجَّهُ بِهٖ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "فَاجْعَلْنِيْ بِهٖ وَجِيْهًا عِنْدَكَ فِي الدُّنْيَا وَالْاٰخِرَةِ وَمِنَ الْمُقَرَّبِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ صَلَاتِيْ بِهٖ مَقْبُوْلَةً، وَذَنْبِيْ بِهٖ مَغْفُوْرًا"
    },
    {
      "kind": "text",
      "ar": "وَدُعَائِيْ بِهٖ مُسْتَجَابًا، اِنَّكَ أَنْت الْغَفُوْرُ الرَّحِيْمُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اجْعَلْ قَلْبِيْ بَارًّا وَعَيْشِيْ قَارًّا وَرِزْقِيْ دَارًّا"
    },
    {
      "kind": "text",
      "ar": "وَاجْعَلْ لِيْ عِنْدَ قَبْرِ رَسُوْلِكَ صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ مُسْتَقَرًّا وَقَرَارًا۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِلَيْكَ تَوَجَّهْتُ، وَمَرْضَاتَك طَلَبْتُ"
    },
    {
      "kind": "text",
      "ar": "وَثَوَابَكَ ابْتَغَيْتُ، وَبِكَ اٰمَنْتُ، وَعَلَيْك تَوَكَّلْتُ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَافْتَحْ مَسَامِعَ قَلْبِيْ لِذِكْرِكَ"
    },
    {
      "kind": "text",
      "ar": "وَثَبِّتْنِيْ عَلٰي دِيْنِكَ وَدِيْنِ نَبِيِّكَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُزِغْ قَلْبِيْ بَعْدَ اِذْ هَدَيْتَنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَهَبْ لِيْ مِنْ لَدُنْكَ رَحْمَةً اِنَّكَ أَنْتَ الْوَهَّابُ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ أَنْتَ الْمَلِكُ الْحَقُّ الْمُبينُ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا أَنْتَ سُبْحَانَك"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ ظَلَمْتُ نَفْسِيْ فَاغْفِر لِيْ ذَنْبِيْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّهٗ لَا يَغْفِرُ الذُّنُوْبَ اِلَّا أَنْتَ۔"
    },
    {
      "kind": "text",
      "ar": "لَبَّيْكَ وَسَعْدَيْكَ، وَالْخَيْرُ فِيْ يَدَيْكَ وَالشَّرُّ لَيْسَ اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "وَالْمَهْدِيُّ مَنْ هَدَيْتَ"
    },
    {
      "kind": "text",
      "ar": "عَبْدُكَ وَابْنُ عَبْدَيْكَ ذَلِيْلٌ بَيْنَ يَدَيْكَ"
    },
    {
      "kind": "text",
      "ar": "مِنْكَ وَبِكَ وَلَكَ وَاِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "لَا مَلْجَأَ وَلَا مَنْجٰي وَلَا مَفَرَّ مِنْكَ اِلَّا اِلَيْكَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ وَحَنَانَيْكَ تبَارَكْتَ وَتَعَالَيْتَ"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَكَ رَبَّ الْبَيْتِ الْحَرَامِ"
    },
    {
      "kind": "text",
      "ar": "وَجَّهْتُ وَجْهِيْ لِلَّذِيْ فَطَرَ السَّمٰوَاتِ وَالْاَرْضَ"
    },
    {
      "kind": "text",
      "ar": "عَالِمِ الْغَيْبِ وَالشَّهَادَةِ حَنِيْفًا مُسْلِمًا وَمَا أَنَا مِن الْمُشْرِكِيْنَ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ صَلٰوتِيْ وَنُسُكِيْ وَمَحْيَايَ وَمَمَاتِيْ لِلّٰهِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "لَا شَرِيْكَ لَهٗ وَبِذٰلِكَ أُمِرْتُ وَأَنَا مِنَ الْمُسْلِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "سُبْحَانَ رَبِّيَ الْعَظِيْمِ وَبِحَمْدِه"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَكَ رَكَعْتُ وَلَكَ أَسْلَمْتُ"
    },
    {
      "kind": "text",
      "ar": "وَبِكَ اٰمَنْتُ وَعَلَيْكَ تَوَكَّلْتُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ رَبِّيْ خَشَعَ لَكَ سَمْعِيْ وَبَصَرِيْ"
    },
    {
      "kind": "text",
      "ar": "وَشَعْرِيْ وَبَشَرِيْ وَلَحْمِيْ وَدَمِيْ"
    },
    {
      "kind": "text",
      "ar": "وَمُخِّيْ وَعَصَبِيْ وَعِظَامِيْ وَمَا أَقَلَّتْهُ قَدَمَايَ"
    },
    {
      "kind": "text",
      "ar": "غَيْرَ مُسْتَنْكِفٍ وَلَا مُسْتَكْبِرٍ وَلَا مُسْتَحْسِرٍ۔"
    },
    {
      "kind": "text",
      "ar": "سَمِعَ اللهُ لِمَنْ حَمِدَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ لَكَ سَجَدْتُ وَبِكَ اٰمَنْتُ"
    },
    {
      "kind": "text",
      "ar": "وَلَكَ أَسْلَمْتُ، وَعَلَيْكَ تَوَكَّلْتُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْتَ رَبِّيْ سَجَدَ وَجْهِيْ لِلَّذِيْ خَلَقَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَشَقَّ سَمْعَهٗ وَبَصَرَهٗ"
    },
    {
      "kind": "text",
      "ar": "اَلْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِيْنَ"
    },
    {
      "kind": "text",
      "ar": "تَبَارَكَ اللهُ أَحْسَنُ الْخَالِقِيْنَ"
    },
    {
      "kind": "text",
      "ar": "أَسْتَغْفِرُ اللهَ رَبِّيْ وَأَتُوْبُ اِلَيْه"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْلِيْ وَارْحَمْنِيْ"
    },
    {
      "kind": "text",
      "ar": "وَاجْبُرْنِيْ وَادْفَعْ عَنِّيْ وَعَافِنِيْ"
    },
    {
      "kind": "text",
      "ar": "اِنِّيْ لِمَا أَنْزَلْتَ اِلَيَّ مِنْ خَيْرٍ فَقِيْرٌ"
    },
    {
      "kind": "text",
      "ar": "تَبَارَكَ اللهُ رَبُّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "بِحَوْلِ الله وَقُوَّتِهٖ أَقُوْمُ وَأَقْعُدُ"
    },
    {
      "kind": "text",
      "ar": "كَذٰلِكَ اللهُ رَبِّيْ"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اغْفِرْ لَنَا وَارْحَمْنَا"
    },
    {
      "kind": "text",
      "ar": "وَعَافِنَا وَاعْفُ عَنَّا فِي الدُّنْيَا وَالْاٰخِرَةِ"
    },
    {
      "kind": "text",
      "ar": "اِنَّكَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ مَنْ كَانَ أَصْبَحَ وَلَهٗ ثِقَةٌ أَوْ رَجَاءٌ غَيْرُكَ"
    },
    {
      "kind": "text",
      "ar": "فَأَنْتَ ثِقَتِيْ وَرَجَائِيْ"
    },
    {
      "kind": "text",
      "ar": "يَا أَجْوَدَ مَنْ سُئِلَ، وَيَا أَرْحَمَ مَنِ اسْتُرْحِمَ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْ ضَعْفِيْ وَمَسْكَنَتِيْ وَقِلَّةَحِيْلَتِيْ"
    },
    {
      "kind": "text",
      "ar": "وَامْنُنْ عَلَيَّ بِالْجَنَّةِ طَوْلًا مِنْك"
    },
    {
      "kind": "text",
      "ar": "وَفُكَّ رَقَبَتِيْ مِنَ النَّارِ"
    },
    {
      "kind": "text",
      "ar": "وعَاَفِنِيْ نَفْسِيْ وَفِيْ جَمِيْع اُمُوْرِيْ"
    },
    {
      "kind": "text",
      "ar": "بِرَحْمَتِكَ يَا أَرْحَمَ الرَّاحِمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ وَالْحَمْدُ اللهِ، وَخَيْرُ الْاَسْمَاءِ لِلّٰهِ"
    },
    {
      "kind": "text",
      "ar": "أَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ ..... تا آخر"
    }
  ]
}