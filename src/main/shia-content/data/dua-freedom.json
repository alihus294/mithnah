{
  "id": "dua-freedom",
  "title": "قيد سے رهائي كي دعا",
  "subtitle": "الأدعية والمناجات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "قيد سے رهائي كي دعا",
      "subtitle": "الأدعية والمناجات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ بِحَقِّ الْعَرْشِ وَمَنْ عَلَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَقِّ الْوَحْيِ وَمَنْ أَوْحَاهُ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَقِّ النَّبِيِّ وَمَنْ نَبَّاهُ"
    },
    {
      "kind": "text",
      "ar": "وَبِحَقِّ الْبَيْتِ وَمَنْ بَنَاهُ"
    },
    {
      "kind": "text",
      "ar": "يَا سَامِعَ كُلِّ صَوْتٍ، يَا جَامِعَ كُلِّ فَوْتٍ"
    },
    {
      "kind": "text",
      "ar": "يَا بَارِئَ النُّفُوْسِ بَعْدَ الْمَوْتِ"
    },
    {
      "kind": "text",
      "ar": "صَلِّ عَلٰي مُحَمَّدٍ وَأَهْلِ بَيْتِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَاٰتِنَا وَجَمِيْعَ الْمُؤْمِنِيْنَ وَالْمُؤْمِنَاتِ فِيْ مَشَارِقِ الْاَرْضِ وَمَغَارِبِهَا"
    },
    {
      "kind": "text",
      "ar": "فَرَجًا مِنْ عِنْدِكَ عَاجِلًا"
    },
    {
      "kind": "text",
      "ar": "بِشَهَادَةِ أَنْ لَا اِلٰهَ اِلَّا اللهُ"
    },
    {
      "kind": "text",
      "ar": "وَأَنَّ مُحَمَّدًا عَبْدُكَ وَرَسُوْلُكَ"
    },
    {
      "kind": "text",
      "ar": "صَلَّي اللهُ عَلَيْهِ وَاٰلِهٖ وَعَلٰي ذُرِّيَّتِهِ الطَّيِّبِيْنَ الطَّاهِرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "وَسَلَّمَ تَسْلِيْمًا كَثِيْرًا"
    }
  ]
}