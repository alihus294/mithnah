{
  "id": "taweez-fever",
  "title": "بخار كا تعويذ",
  "subtitle": "باقيات الصالحات",
  "source": "مفاتيح الجنان",
  "fiqh": "shia",
  "slides": [
    {
      "kind": "title",
      "ar": "بخار كا تعويذ",
      "subtitle": "باقيات الصالحات"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ ارْحَمْ جِلْدِيَ الرَّقِيْق وَعَظْمِيَ الدَّقِيْقَ"
    },
    {
      "kind": "text",
      "ar": "وَأَعُوْذبِكَ مِنْ فَوْرَةِ الْحَرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "يَا أُمَّ مِلْدَمٍ اِنْ كُنْتِ اٰمَنْتِ بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "فَلَا تَأْكُلِي اللَّحْم وَلَا تَشْرَبِي الدَّمَ"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَفُوْرِيْ مِنَ الْفَمِ"
    },
    {
      "kind": "text",
      "ar": "وَانْتَقِلِيْ اِلٰي مَنْ يَزْعَمُ أَنَّ مَعَ الله اِلٰهًا اٰخَرَ"
    },
    {
      "kind": "text",
      "ar": "فَاِنِّيْ أَشْهَدُ أَنْ لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهٗ وَرَسُوْلُهٗ۔"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "لَا تَخَفْ اِنَّكَ أَنْتَ الْاَعْلٰي۔"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "لَا تَخَفْ نَجَوْتَ مِنَ الْقَوْمِ الظَّالِمِيْن"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "أَلَا لَهُ الْخَلْقُ وَالْاَمْرُ"
    },
    {
      "kind": "text",
      "ar": "تَبَارَكَ اللهُ رَبُّ الْعَالَمِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "اَللّٰهُمَّ اِنِّيْ أَسْأَلُكَ بِعِزَّتِكَ وَقُدْرَتِك"
    },
    {
      "kind": "text",
      "ar": "وَسُلْطَانِك وَمَا أَحَاطَ بِهٖ عِلْمُكَ"
    },
    {
      "kind": "text",
      "ar": "أَنْ تُصَلِّيَ عَلٰي مُحَمَّدٍ وَاٰلِ مُحَمَّدٍ"
    },
    {
      "kind": "text",
      "ar": "وَأَنْ لَا تُسَلِّطَ عَلٰي فُلَان ابْنِ فُلَان"
    },
    {
      "kind": "text",
      "ar": "شَيْئًا مِمَّا خَلَقْتَ بِسُوْء"
    },
    {
      "kind": "text",
      "ar": "وَارْحَمْ جِلْدَهُ الرَّقِيْقَ وَعَظْمَهُ الدَّقِيْقَ"
    },
    {
      "kind": "text",
      "ar": "مِنْ فَوْرَةِ الْحَرِيْقِ"
    },
    {
      "kind": "text",
      "ar": "اخْرُجِيْ يَا أُمَّ مِلْدَمٍ يَا اٰكِلَةَ اللَّحْمِ وَشَارِبَةَ الدَّمِ"
    },
    {
      "kind": "text",
      "ar": "حَرُّهَا وَبَرْدُهَا مِنْ جَهَنَّم"
    },
    {
      "kind": "text",
      "ar": "اِنْ كُنْتِ اٰمَنْتِ بِاللّٰهِ الْاَعْظَمِ"
    },
    {
      "kind": "text",
      "ar": "أَنْ لَا تَأْكُلِيْ لِفُلَان بْن فُلَان لَحْمًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تَمُصِّيْ لَهٗ دَمًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُنْهِكِيْ لَهٗ عَظْمًا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُثَوِّرِيْ عَلَيْهِ غَمًّا"
    },
    {
      "kind": "text",
      "ar": "وَلَا تُهَيِّجِيْ عَلَيْهِ صُدَاعًا"
    },
    {
      "kind": "text",
      "ar": "وَانْتَقِلِيْ عَنْ شَعْرِهٖ وَبَشَرِهٖ وَلَحْمِهٖ وَدَمِهٖ"
    },
    {
      "kind": "text",
      "ar": "اِلٰي مَنْ زَعَمَ اَنَّ مَعَ الله اِلٰهًا اٰخَرَ"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا هُوَ سُبْحَانَهٗ وَتَعَالٰي عَمَّا يُشْرِكُوْنَ"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ"
    },
    {
      "kind": "text",
      "ar": "الْحَمْدُ لِلّٰهِ رَبِّ الْعَالَمِيْنَ ..... تا آخر سوره"
    },
    {
      "kind": "text",
      "ar": "بِسْمِ اللهِ وَبِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "أَعُوْذُ بِكَلِمَاتِ اللهِ التَّامّاتِ كُلِّهَا"
    },
    {
      "kind": "text",
      "ar": "الَّتِيْ لَا يُجَاوِزُهُنَّ بَرٌّ وَلَا فَاجِرٌ"
    },
    {
      "kind": "text",
      "ar": "مِنْ شَرِّ مَا خَلَقَ وَذَرَأَ وَبَرَأَ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ الْهَامَّةِ وَالسَّامَّةِ وَالْعَامَّةِ وَاللَّامَّةِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ طَوَارِقِ اللَّيْلِ وَالنَّهَارِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ فُسَّاقِ الْعَرَبِ وَالْعَجَمِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ فَسَقَةِ الْجِنِّ وَالْاِنْسِ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ الشَّيْطَانِ وَشِرْكِهٖ"
    },
    {
      "kind": "text",
      "ar": "وَمِنْ شَرِّ كُلِّ ذِيْ شَرٍّ وَمِنْ شَرِّ كُلِّ دَابَّةٍ"
    },
    {
      "kind": "text",
      "ar": "هُوَ اٰخِذٌ بِنَاصِيَتِهَا اِنَّ رَبِّيْ عَلٰي صِرَاطٍ مُسْتَقِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا عَلَيْكَ تَوَكَّلْنَا وَاِلَيْكَ أَنَبْنَا وَاِلَيْكَ الْمَصِيْرُ"
    },
    {
      "kind": "text",
      "ar": "يَا نَارُ كُوْنِيْ بَرْدًا وَسَلَامًا عَلٰي اِبْرَاهِيْمَ"
    },
    {
      "kind": "text",
      "ar": "وَأَرَادُوْا بِهٖ كَيْدًا فَجَعَلْنَاهُمُ الْاَخْسَرِيْنَ"
    },
    {
      "kind": "text",
      "ar": "بَرْدًا وَسَلَامًا عَلٰي فُلَانِ بْن فُلَانَة"
    },
    {
      "kind": "text",
      "ar": "رَبَّنَا لَا تُؤَاخِذْنَا اِنْ نَسِيْنَا أَوْ أَخْطَأْنَا ..... تا آخر سوره بقره"
    },
    {
      "kind": "text",
      "ar": "حَسبِيَ اللهُ لَا اِلٰهَ اِلَّا هُوَ فَاتَّخِذْهُ وَكِيْلًا"
    },
    {
      "kind": "text",
      "ar": "وَتَوَكَّلْ عَلَي الْحَيِّ الَّذِيْ لَا يَمُوْتُ وَسَبِّحْ بِحَمْدِهِ"
    },
    {
      "kind": "text",
      "ar": "وَكَفٰي بِهٖ بِذُنُوْبِ عِبَادِهٖ خَبِيْرًا بَصِيْرًا"
    },
    {
      "kind": "text",
      "ar": "لَا اِلٰهَ اِلَّا اللهُ وَحْدَهٗ لَا شَرِيْكَ لَهٗ"
    },
    {
      "kind": "text",
      "ar": "صَدَقَ وَعْدَهٗ وَنَصَرَ عَبْدَهُ"
    },
    {
      "kind": "text",
      "ar": "وَهَزَمَ الْاَحْزَابَ وَحْدهُ"
    },
    {
      "kind": "text",
      "ar": "مَا شَاءَ اللهُ لَا قُوَّةَ اِلَّا بِاللّٰهِ"
    },
    {
      "kind": "text",
      "ar": "كَتَبَ اللهُ لَاَغْلِبَنَّ أَنَا وَرُسُلِيْ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ اللهَ قَوِيٌّ عَزِيْزٌ"
    },
    {
      "kind": "text",
      "ar": "اِنَّ حِزْبَ اللهِ هُمُ الْغَالِبُوْنَ"
    },
    {
      "kind": "text",
      "ar": "وَمَنْ يَعْتَصِمْ بِاللّٰهِ فَقَدْ هُدِيَ اِلٰي صِرَاطٍ مُسْتَقِيْمٍ"
    },
    {
      "kind": "text",
      "ar": "وَصَلَّي اللهُ عَلٰي مُحَمَّدٍ وَاٰلِهٖ الطَّيِّبِيْنَ الطَّاهِرِيْنَ۔"
    },
    {
      "kind": "text",
      "ar": "عَقَدْتُ بِاِذْنِ اللهِ۔"
    },
    {
      "kind": "text",
      "ar": "شَدَدْتُ بِاِذْنِ اللهِ۔"
    },
    {
      "kind": "text",
      "ar": "سَكَنْتُ بِاِذْنِ اللهِ۔"
    }
  ]
}